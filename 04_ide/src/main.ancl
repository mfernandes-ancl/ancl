rn_newname:  str = "renamed_probe.ancl";
rn_sepname:  str = "..\\escape.ancl";          # path-escape attempt -> must be rejected
rn_res_pfx:  str = "happy=";
rn_res_sep:  str = " sep_rejected=";
rn_res_path: str = " newpath=";
rn_res_file: str = "\\rename_test.txt";
st_selftest: str = "[selftest] opened template by path + repopulated tree.";

# ---- dark menu strip (File / Build / Help) -> owner-drawn popups ----
gui_mb_file:  buf = 8;          # the menu-strip GlowButtons
gui_mb_edit:  buf = 8;
