# =====================================================================
#  Aether Studio  -  a native Win32 IDE for ANCL, written in ANCL.
#  Compiled by bin\anclc.exe to a CRT-free PE32+ (zero runtime/VM/CRT).
#
#  v1 + polish: fully dark UI.
#    - DWM immersive dark title bar (DwmSetWindowAttribute).
#    - Owner-drawn dark toolbar buttons (BS_OWNERDRAW + WM_DRAWITEM).
#    - Consolas editor + output font (CreateFontA).
#    - Bottom status bar.
#  Layout: [toolbar] / [tree | editor] / [output] / [status].
#  V6 file order: top imports -> @DATA -> @CODE.  (No 'let' keyword.)
# =====================================================================
import "../../../core_lib/win32_api.ancl";
import "UI_controls.ancl";
import "lexer.ancl";
import "ai_bridge.ancl";
import "transport.ancl";
import "settings.ancl";
import "agent.ancl";
import "theme.ancl";
import "../../../ai_core/brain_complete.ancl";   # Phase 1: local-brain ANCL autocomplete (docs/brain_roadmap.md)
import "../../../ai_core/tok_infer.ancl";        # Phase 1.x: TOKEN-brain autocomplete (preferred when ancl.avoc + ancl_token.dna are deployed)

extern "gdi32.dll"  CreateFontA -> ptr;       # HFONT CreateFontA(...14 args...) - Consolas
extern "user32.dll" PostMessageA;             # BOOL PostMessageA(hwnd, msg, wParam, lParam)
extern "user32.dll" DrawTextA;                # int DrawTextA(hdc, str, cch, &RECT, format)
extern "user32.dll" FrameRect;                # int FrameRect(hdc, &RECT, hbr)
extern "dwmapi.dll" DwmSetWindowAttribute;    # HRESULT DwmSetWindowAttribute(hwnd, attr, &val, cb)
extern "comdlg32.dll" GetOpenFileNameA;       # BOOL GetOpenFileNameA(&OPENFILENAMEA)  -- Open File dialog
extern "comdlg32.dll" GetSaveFileNameA;       # BOOL GetSaveFileNameA(&OPENFILENAMEA)  -- Save As dialog
extern "shell32.dll"  SHBrowseForFolderA -> i64;   # LPITEMIDLIST (folder picker; 0 = cancelled)
extern "shell32.dll"  SHGetPathFromIDListA;   # BOOL SHGetPathFromIDListA(pidl, &path)
extern "ole32.dll"    OleInitialize;          # COM STA for the UI thread -> SHBrowseForFolder's "Make New Folder" button
# ---- clipboard-paste image (Ctrl+V) for vision ----
extern "user32.dll"   OpenClipboard;          # BOOL OpenClipboard(hwnd)
extern "user32.dll"   GetClipboardData -> ptr;# HANDLE GetClipboardData(format) (clipboard-owned; keep 64-bit)
extern "user32.dll"   CloseClipboard;         # BOOL CloseClipboard()
extern "user32.dll"   IsClipboardFormatAvailable;  # BOOL IsClipboardFormatAvailable(format)
extern "user32.dll"   GetDC -> ptr;           # HDC GetDC(hwnd)  (DIB->HBITMAP fallback)
extern "user32.dll"   ReleaseDC;              # int ReleaseDC(hwnd, hdc)
extern "kernel32.dll" GlobalLock -> ptr;      # LPVOID GlobalLock(hMem)
extern "kernel32.dll" GlobalUnlock;           # BOOL GlobalUnlock(hMem)
extern "kernel32.dll" MultiByteToWideChar;    # int (cp, flags, mb, cb, wide, cchWide)
extern "kernel32.dll" MoveFileExA;            # BOOL MoveFileExA(src, dst, flags) -- relocate the .asm listing next to the source
extern "gdi32.dll"    CreateDIBitmap -> ptr;  # HBITMAP CreateDIBitmap(hdc, &BIH, fInit, bits, &BI, usage)
extern "gdiplus.dll"  GdiplusStartup;         # Status (&token, &input, &output)
extern "gdiplus.dll"  GdiplusShutdown;        # void (token)
extern "gdiplus.dll"  GdipCreateBitmapFromHBITMAP;  # Status (HBITMAP, HPALETTE, GpBitmap** out)
extern "gdiplus.dll"  GdipSaveImageToFile;    # Status (GpImage*, const WCHAR*, const CLSID*, const EncoderParameters*)
extern "gdiplus.dll"  GdipDisposeImage;       # Status (GpImage*)
# ---- custom title bar ----
extern "user32.dll"   GetSystemMetrics;       # int GetSystemMetrics(idx) -- SM_CXFRAME=32, SM_CXPADDEDBORDER=92
extern "user32.dll"   IsZoomed;               # BOOL IsZoomed(hwnd) -- maximized?
extern "user32.dll"   SetWindowPos;           # BOOL SetWindowPos(hwnd, after, x,y,cx,cy, flags) -- FRAMECHANGED kick
extern "user32.dll"   LoadIconA -> ptr;       # HICON LoadIconA(hinst, MAKEINTRESOURCE(1)) -> embedded code-bot icon
extern "user32.dll"   CreatePopupMenu -> ptr; # a dropdown menu
extern "user32.dll"   AppendMenuA;            # BOOL AppendMenuA(hMenu, flags, idOrSubmenu, data)
extern "user32.dll"   SetMenuInfo;            # BOOL SetMenuInfo(hMenu, &MENUINFO) - dark bg
extern "user32.dll"   TrackPopupMenu;         # BOOL TrackPopupMenu(hMenu, flags, x, y, 0, hwnd, 0)
extern "user32.dll"   GetWindowRect;          # screen rect of a menu-strip button (popup anchor)
extern "user32.dll"   DestroyWindow;          # File>Exit
extern "kernel32.dll" TerminateProcess;       # Stop-Run: kill the launched program / compiler child
extern "kernel32.dll" MoveFileA;              # BOOL MoveFileA(existing, new) -- rename a file in the tree
extern "user32.dll"   GetMenuItemCount;       # Open Recent: rebuild the submenu each time it opens
extern "user32.dll"   RemoveMenu;
extern "user32.dll"   SetForegroundWindow;    # command palette popup focus
extern "user32.dll"   SetFocus;               # palette open/close focus handoff
extern "user32.dll"   GetCaretPos;            # BOOL GetCaretPos(&POINT) -- editor caret in client coords (completion popup anchor)
extern "user32.dll"   ClientToScreen;         # BOOL ClientToScreen(hwnd, &POINT) -- client -> screen for the popup position

