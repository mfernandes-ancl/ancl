@CODE
func btn_label(id: i64) -> i64 {
    if id == 2301 { return lbl_new; }
    if id == 2302 { return lbl_save; }
    if id == 2304 { return lbl_compile; }
    if id == 2315 { return lbl_fix; }
    if id == 2306 { return lbl_ai; }
    if id == 2308 { return lbl_settings; }
    if id == 2310 { return lbl_explain; }
    if id == 2603 { return lbl_send; }
    return gui_empty;
}

func set_status(s: i64) -> i64 {
    st = load64(gui_status);
    if st != 0 { SetWindowTextA(st, s); }
    return 0;
}

# Right status segment: the caret's 1-based line:column, from EM_EXGETSEL.
func update_lincol() -> i64 {
    ed = load64(gui_editor);
    lc = load64(gui_lincol);
    if ed == 0 { return 0; }
    if lc == 0 { return 0; }
    SendMessageA(ed, 0x434, 0, g_lc_cr);             # EM_EXGETSEL -> CHARRANGE {cpMin@0, cpMax@4}
    caret = load32(g_lc_cr + 4);                     # active end of the selection = caret
    line  = SendMessageA(ed, 0x436, 0, caret);       # EM_EXLINEFROMCHAR (0-based)
    lstart = SendMessageA(ed, 0xBB, line, 0);        # EM_LINEINDEX (line -> first char offset)
    col = caret - lstart;
    e = str_copy(g_lincol, lc_ln);
    int_to_str(g_lincol_n, line + 1); e = str_copy(e, g_lincol_n);
    e = str_copy(e, lc_col);
    int_to_str(g_lincol_n, col + 1);  str_copy(e, g_lincol_n);
    SetWindowTextA(lc, g_lincol);
    return 0;
}

# Stop-Run: kill the program (or compiler) currently launched by ide_run_capture.
func do_stop_run() -> i64 {
    p = load64(cap_proc);
    if p != 0 { TerminateProcess(p, 1); set_status(st_stoprun); }
    return 0;
}

# Build>View ASM: load the compiler's .asm listing (emitted beside _ide_build.exe) into the output pane.
# Save the Output pane's text to <workspace>\aether_output.log (a build/run-session record).
func do_save_log() -> i64 {
    n = SendMessageA(load64(gui_output), 13, 1048575, ide_rich_raw);   # WM_GETTEXT -> ide_rich_raw (returns char count)
    ui_join(g_logpath, g_workspace, s_logname);                        # <workspace>\aether_output.log
    if ui_write_file(g_logpath, ide_rich_raw, n) == 0 { set_status(st_logfail); return 0; }
    set_status(st_logsaved);
    return 0;
}
# Empty the Output pane.
func do_clear_log() -> i64 {
    SendMessageA(load64(gui_output), 12, 0, gui_empty);                # WM_SETTEXT ""
    set_status(st_logclear);
    return 0;
}
func do_view_asm() -> i64 {
    ui_exedir(g_compiler_dir);
    ui_join(g_asm_p, g_compiler_dir, s_ideasm);
    if ui_load_file_to_edit(g_asm_p, load64(gui_output)) == 0 { set_status(st_noasm); return 0; }
    set_status(st_asmview);
    return 0;
}

# ================= multi-file tabs =================
func tab_basename(idx: i64) -> i64 {
    p = g_tab_path + idx * 272;
    bs = uic_last_bs(p);
    if bs >= 0 { return p + bs + 1; }
    return p;
}
func tab_find(path: i64) -> i64 {
    n = load64(g_tab_n); i = 0;
    while i < n { if path_eq(g_tab_path + i * 272, path) == 1 { return i; } i = i + 1; }
    return 0 - 1;
}
# Stash the LIVE editor text into the current tab's buffer (call before swapping tabs/files).
func tab_stash_current() -> i64 {
    cur = load64(g_tab_cur);
    if cur < 0 { return 0; }
    SendMessageA(load64(gui_editor), 13, 262143, load64(g_tab_buf + cur * 8));   # WM_GETTEXT -> buf[cur]
    return 0;
}
# Load tab idx from its stash into the editor + make it current (no disk read).
func tab_load(idx: i64) -> i64 {
    wd = load64(g_tab_dirty + idx * 8);
    SendMessageA(load64(gui_editor), 12, 0, load64(g_tab_buf + idx * 8));        # WM_SETTEXT <- buf[idx] (clears modify)
    SendMessageA(load64(gui_editor), 185, 0, wd);                               # EM_SETMODIFY <- this tab's real dirty state
    store64(g_tab_dirty + idx * 8, wd);                                         # restore (WM_SETTEXT's EN_CHANGE may have cleared it)
    ide_recolor();
    ide_set_current(g_tab_path + idx * 272);
    update_lincol();
    return 0;
}
# Drop slot s: shift paths/contents/dirty down over it, fix g_tab_cur.
func tab_remove_slot(s: i64) -> i64 {
    n = load64(g_tab_n);
    i = s;
    while i < n - 1 {
        str_copy(g_tab_path + i * 272, g_tab_path + (i + 1) * 272);
        str_copy(load64(g_tab_buf + i * 8), load64(g_tab_buf + (i + 1) * 8));    # buffers are fixed per slot; copy CONTENTS
        store64(g_tab_dirty + i * 8, load64(g_tab_dirty + (i + 1) * 8));
        i = i + 1;
    }
    store64(g_tab_n, n - 1);
    cur = load64(g_tab_cur);
    if s < cur { cur = cur - 1; }
    if cur >= load64(g_tab_n) { cur = load64(g_tab_n) - 1; }
    if cur < 0 { cur = 0; }
    store64(g_tab_cur, cur);
    return 0;
}
# Register the CURRENT editor content as a new active tab (caller stashed the outgoing tab first).
func tab_register(path: i64) -> i64 {
    n = load64(g_tab_n);
    if n >= 8 { tab_remove_slot(0); n = load64(g_tab_n); }       # full -> drop the oldest
    str_copy(g_tab_path + n * 272, path);
    store64(g_tab_dirty + n * 8, 0);
    store64(g_tab_cur, n);
    store64(g_tab_n, n + 1);
    SendMessageA(load64(gui_editor), 13, 262143, load64(g_tab_buf + n * 8));     # stash the just-loaded editor -> buf[n]
    InvalidateRect(load64(gui_hwnd), g_tab_rc, 0);
    return 0;
}
func tab_switch(idx: i64) -> i64 {
    if idx == load64(g_tab_cur) { return 0; }
    store64(g_loading, 1);
    tab_stash_current();
    store64(g_tab_cur, idx);
    tab_load(idx);
    InvalidateRect(load64(gui_hwnd), g_tab_rc, 0);
    PostMessageA(load64(gui_hwnd), 0x8006, 0, 0);      # clear g_loading after the load's EN_CHANGE drains
    return 0;
}
func tab_close(idx: i64) -> i64 {
    if load64(g_tab_n) == 0 { return 0; }
    store64(g_loading, 1);
    if idx != load64(g_tab_cur) { tab_stash_current(); }         # preserve the live tab's edits across the shift
    tab_remove_slot(idx);
    if load64(g_tab_n) == 0 {
        SendMessageA(load64(gui_editor), 12, 0, gui_empty);      # WM_SETTEXT ""  (no tabs left)
        store8(g_curpath, 0);
        store64(g_tab_cur, 0 - 1);
        ide_recolor();
        set_status(st_ready);
    } else {
        tab_load(load64(g_tab_cur));
    }
    InvalidateRect(load64(gui_hwnd), g_tab_rc, 0);
    PostMessageA(load64(gui_hwnd), 0x8006, 0, 0);      # clear g_loading after the reload's EN_CHANGE drains
    return 0;
}
# Mark the active tab dirty (on edit) / clean (on save), and repaint the strip.
func tab_mark_dirty(d: i64) -> i64 {
    cur = load64(g_tab_cur);
    if cur < 0 { return 0; }
    if load64(g_tab_dirty + cur * 8) != d {
        store64(g_tab_dirty + cur * 8, d);
        InvalidateRect(load64(gui_hwnd), g_tab_rc, 0);
    }
    return 0;
}
# Paint the tab strip (from the main WM_PAINT). g_tab_rc is the strip rect (client coords).
func paint_tabs(hdc: i64) -> i64 {
    FillRect(hdc, g_tab_rc, load64(thm_b_panel));
    n = load64(g_tab_n);
    if n == 0 { return 0; }
    sx = load32(g_tab_rc + 0);
    sy = load32(g_tab_rc + 4);
    sr = load32(g_tab_rc + 8);
    cur = load64(g_tab_cur);
    SelectObject(hdc, load64(thm_f_ui));
    SetBkMode(hdc, 1);
    i = 0;
    while i < n {
        tx = sx + i * TAB_W;
        if tx + TAB_W <= sr {                                    # only fully-visible tabs
            store32(g_tab_txt + 0, tx);              store32(g_tab_txt + 4,  sy);
            store32(g_tab_txt + 8, tx + TAB_W - 2);  store32(g_tab_txt + 12, sy + TAB_H);
            bg = load64(thm_b_panel);
            if i == cur { bg = load64(thm_b_deep); }             # active tab = editor tone
            FillRect(hdc, g_tab_txt, bg);
            if i == cur { thm_neon_line(hdc, tx, sy + TAB_H - 2, tx + TAB_W - 2); }   # purple underline
            tc = TH_TEXT_DIM; if i == cur { tc = TH_TEXT_BRT; }
            SetTextColor(hdc, tc);
            lx = tx + 10;
            if load64(g_tab_dirty + i * 8) == 1 {                # dirty marker
                store32(g_tab_txt + 0, tx + 2); store32(g_tab_txt + 8, tx + 11);
                DrawTextA(hdc, tab_star, 0 - 1, g_tab_txt, 0x24);
                lx = tx + 12;
            }
            store32(g_tab_txt + 0, lx);  store32(g_tab_txt + 4, sy);
            store32(g_tab_txt + 8, tx + TAB_W - 22); store32(g_tab_txt + 12, sy + TAB_H);
            DrawTextA(hdc, tab_basename(i), 0 - 1, g_tab_txt, 0x8024);   # VCENTER|SINGLELINE|END_ELLIPSIS
            SetTextColor(hdc, TH_TEXT_DIM);                      # close 'x'
            store32(g_tab_txt + 0, tx + TAB_W - 20); store32(g_tab_txt + 8, tx + TAB_W - 4);
            DrawTextA(hdc, tab_x, 0 - 1, g_tab_txt, 0x25);
        }
        i = i + 1;
    }
    return 0;
}
# Hit-test a client click in the tab strip: switch tabs, or close on the 'x'.
func tabs_click(mx: i64, my: i64) -> i64 {
    sx = load32(g_tab_rc + 0); sy = load32(g_tab_rc + 4); sr = load32(g_tab_rc + 8);
    if my < sy { return 0; }
    if my >= sy + TAB_H { return 0; }
    if mx < sx { return 0; }
    if mx >= sr { return 0; }
    ti = (mx - sx) / TAB_W;
    if ti >= load64(g_tab_n) { return 0; }
    tx = sx + ti * TAB_W;
    if mx >= tx + TAB_W - 22 { tab_close(ti); return 1; }        # the close 'x' region
    tab_switch(ti);
    return 1;
}

# Cute industrial bot icon + "Aether Agent" label + status dot (green idle / purple working),
# drawn with GDI (no image assets). Sits as a header atop the chat panel.
func AgentBadgeProc(hwnd: i64, msg: i64, wParam: i64, lParam: i64) -> i64 {
    if msg == 15 {                                          # WM_PAINT
        hdc = BeginPaint(hwnd, badge_ps);
        GetClientRect(hwnd, badge_rc);
        w = load32(badge_rc + 8);
        h = load32(badge_rc + 12);
        FillRect(hdc, badge_rc, load64(thm_b_panel));
        ix = 8;
        iy = (h - 18) / 2;
        op = SelectObject(hdc, load64(thm_p_neon));         # antenna stalk
        MoveToEx(hdc, ix + 11, iy - 5, 0);
        LineTo(hdc, ix + 11, iy);
        ob = SelectObject(hdc, load64(thm_b_neon));         # antenna dot
        Ellipse(hdc, ix + 8, iy - 9, ix + 14, iy - 3);
        SelectObject(hdc, load64(thm_b_card));              # head: card fill + accent outline
        RoundRect(hdc, ix, iy, ix + 22, iy + 18, 6, 6);
        SelectObject(hdc, load64(thm_b_neon));              # eyes
        Ellipse(hdc, ix + 5, iy + 5, ix + 10, iy + 11);
        Ellipse(hdc, ix + 12, iy + 5, ix + 17, iy + 11);
        SetBkMode(hdc, 1);                                  # label
        SetTextColor(hdc, TH_TEXT);
        SelectObject(hdc, load64(thm_f_hdr));
        store32(badge_rc + 0, ix + 34); store32(badge_rc + 4, 0);
        store32(badge_rc + 8, w - 24);   store32(badge_rc + 12, h);
        DrawTextA(hdc, lbl_agent, 0 - 1, badge_rc, 0x24);   # DT_VCENTER|DT_SINGLELINE
        sd = load64(thm_b_green);                           # status dot
        if load64(g_agent_busy) == 1 { sd = load64(thm_b_neon); }
        SelectObject(hdc, sd);
        dy = (h - 8) / 2;
        Ellipse(hdc, w - 18, dy, w - 10, dy + 8);
        SelectObject(hdc, op);
        SelectObject(hdc, ob);
        EndPaint(hwnd, badge_ps);
        return 0;
    }
    return DefWindowProcA(hwnd, msg, wParam, lParam);
}
func register_agent_badge(hinst: i64) -> i64 {
    if load64(g_badge_reg) == 1 { return 0; }
    cursor = LoadCursorA(0, 32512);
    store32(g_badge_wc + 0,  80);
    store32(g_badge_wc + 4,  3);
    store64(g_badge_wc + 8,  &AgentBadgeProc);
    store32(g_badge_wc + 16, 0);
    store32(g_badge_wc + 20, 0);
    store64(g_badge_wc + 24, hinst);
    store64(g_badge_wc + 32, 0);
    store64(g_badge_wc + 40, cursor);
    store64(g_badge_wc + 48, load64(thm_b_panel));
    store64(g_badge_wc + 56, 0);
    store64(g_badge_wc + 64, cls_badge);
    store64(g_badge_wc + 72, 0);
    RegisterClassExA(g_badge_wc);
    store64(g_badge_reg, 1);
    return 0;
}

# Reflow: [toolbar 34] / [tree 260 | editor] / [output 150] / [status 22].
# ================= activity / icon rail =================
# Icon i's band top within the rail (h = client height). 0..2 top-docked, 3 (Settings) bottom-docked.
func rail_icon_top(i: i64, h: i64) -> i64 {
    if i == 3 {                                          # Settings, bottom-docked but never above the AI band
        b = h - RAIL_STEP;
        mn = RAIL_IY0 + 3 * RAIL_STEP;
        if b < mn { b = mn; }
        return b;
    }
    return RAIL_IY0 + i * RAIL_STEP;
}
func rail_hit(my: i64, h: i64) -> i64 {
    i = 0;
    while i < RAIL_N {
        t = rail_icon_top(i, h);
        if my >= t { if my < t + RAIL_STEP { return i; } }
        i = i + 1;
    }
    return 0 - 1;
}
func rail_action(i: i64) -> i64 {
    store64(g_rail_sel, i);
    InvalidateRect(load64(gui_rail), 0, 1);
    if i == 0 { do_open_folder(); return 0; }                              # Explorer -> browse for a project folder
    if i == 1 { find_toggle(1); SetFocus(load64(gui_find_in)); return 0; }  # Search
    if i == 2 { SetFocus(load64(gui_chat_in)); return 0; }                  # AI / Agent
    if i == 3 { SendMessageA(load64(gui_hwnd), 273, 2308, 0); return 0; }   # Settings -> WM_COMMAND 2308
    return 0;
}
# Draw one 24x24 glyph centered in icon band i. Outlined shapes use the panel-tone
# brush as an "invisible" fill (so no NULL_BRUSH / Rectangle externs are needed).
func rail_draw_icon(hdc: i64, i: i64, h: i64, w: i64) -> i64 {
    t = rail_icon_top(i, h);
    cx = (w - 24) / 2;
    cy = t + (RAIL_STEP - 24) / 2;
    hot = 0; if load64(g_rail_hot) == i { hot = 1; }
    sel = 0; if load64(g_rail_sel) == i { sel = 1; }
    if hot == 1 {                                       # hover/active background pill (own scratch; rail_rc stays the client rect)
        store32(rail_pill + 0, 4); store32(rail_pill + 4, t + 4);
        store32(rail_pill + 8, w - 4); store32(rail_pill + 12, t + RAIL_STEP - 4);
        bg = load64(thm_b_card); if sel == 1 { bg = load64(thm_b_hover); }
        FillRect(hdc, rail_pill, bg);
    }
    if sel == 1 {                                       # active = neon accent bar on the left
        op0 = SelectObject(hdc, load64(thm_p_neon2));
        MoveToEx(hdc, 2, t + 8, 0); LineTo(hdc, 2, t + RAIL_STEP - 8);
        SelectObject(hdc, op0);
    }
    pen = load64(g_rail_pdim);
    if hot == 1 { pen = load64(g_rail_pbrt); }
    if sel == 1 { pen = load64(g_rail_pbrt); }
    op = SelectObject(hdc, pen);
    ob = SelectObject(hdc, load64(thm_b_panel));        # "hollow" fill = rail bg tone
    if i == 0 {                                         # Explorer: a folder
        RoundRect(hdc, cx + 1, cy + 8, cx + 22, cy + 21, 3, 3);
        MoveToEx(hdc, cx + 2, cy + 8, 0); LineTo(hdc, cx + 5, cy + 4);
        LineTo(hdc, cx + 11, cy + 4); LineTo(hdc, cx + 13, cy + 8);
    }
    if i == 1 {                                         # Search: a magnifier
        Ellipse(hdc, cx + 4, cy + 4, cx + 16, cy + 16);
        MoveToEx(hdc, cx + 15, cy + 15, 0); LineTo(hdc, cx + 21, cy + 21);
    }
    if i == 2 {                                         # AI: a bot head + antenna + eyes
        RoundRect(hdc, cx + 3, cy + 7, cx + 21, cy + 21, 5, 5);
        MoveToEx(hdc, cx + 12, cy + 7, 0); LineTo(hdc, cx + 12, cy + 3);
        oe = SelectObject(hdc, load64(thm_b_neon));     # filled neon eyes
        Ellipse(hdc, cx + 7, cy + 11, cx + 11, cy + 15);
        Ellipse(hdc, cx + 13, cy + 11, cx + 17, cy + 15);
        SelectObject(hdc, oe);
    }
    if i == 3 {                                         # Settings: a gear (body + hub + 4 spokes)
        Ellipse(hdc, cx + 5, cy + 5, cx + 19, cy + 19);
        Ellipse(hdc, cx + 9, cy + 9, cx + 15, cy + 15);
        MoveToEx(hdc, cx + 12, cy + 2, 0);  LineTo(hdc, cx + 12, cy + 5);
        MoveToEx(hdc, cx + 12, cy + 19, 0); LineTo(hdc, cx + 12, cy + 22);
        MoveToEx(hdc, cx + 2,  cy + 12, 0); LineTo(hdc, cx + 5,  cy + 12);
        MoveToEx(hdc, cx + 19, cy + 12, 0); LineTo(hdc, cx + 22, cy + 12);
    }
    SelectObject(hdc, ob);
    SelectObject(hdc, op);
    return 0;
}
func RailProc(hwnd: i64, msg: i64, wParam: i64, lParam: i64) -> i64 {
    if msg == 15 {                                      # WM_PAINT
        hdc = BeginPaint(hwnd, rail_ps);
        GetClientRect(hwnd, rail_rc);
        w = load32(rail_rc + 8);
        h = load32(rail_rc + 12);
        FillRect(hdc, rail_rc, load64(thm_b_panel));
        SetBkMode(hdc, 1);
        i = 0;
        while i < RAIL_N { rail_draw_icon(hdc, i, h, w); i = i + 1; }
        EndPaint(hwnd, rail_ps);
        return 0;
    }
    if msg == 512 {                                     # WM_MOUSEMOVE
        GetClientRect(hwnd, rail_rc);
        hit = rail_hit(band(shr(lParam, 16), 65535), load32(rail_rc + 12));
        if hit != load64(g_rail_hot) { store64(g_rail_hot, hit); InvalidateRect(hwnd, 0, 1); }
        store32(rail_track + 0, 24); store32(rail_track + 4, 2);
        store64(rail_track + 8, hwnd); store64(rail_track + 16, 0);
        TrackMouseEvent(rail_track);
        return 0;
    }
    if msg == 675 {                                     # WM_MOUSELEAVE
        if load64(g_rail_hot) != (0 - 1) { store64(g_rail_hot, 0 - 1); InvalidateRect(hwnd, 0, 1); }
        return 0;
    }
    if msg == 513 {                                     # WM_LBUTTONDOWN
        GetClientRect(hwnd, rail_rc);
        hit = rail_hit(band(shr(lParam, 16), 65535), load32(rail_rc + 12));
        if hit >= 0 { rail_action(hit); }
        return 0;
    }
    return DefWindowProcA(hwnd, msg, wParam, lParam);
}
func register_rail(hinst: i64) -> i64 {
    if load64(g_rail_reg) == 1 { return 0; }
    cursor = LoadCursorA(0, 32512);
    store32(g_rail_wc + 0,  80);
    store32(g_rail_wc + 4,  3);
    store64(g_rail_wc + 8,  &RailProc);
    store32(g_rail_wc + 16, 0);
    store32(g_rail_wc + 20, 0);
    store64(g_rail_wc + 24, hinst);
    store64(g_rail_wc + 32, 0);
    store64(g_rail_wc + 40, cursor);
    store64(g_rail_wc + 48, load64(thm_b_panel));
    store64(g_rail_wc + 56, 0);
    store64(g_rail_wc + 64, cls_rail);
    store64(g_rail_wc + 72, 0);
    RegisterClassExA(g_rail_wc);
    store64(g_rail_pdim, CreatePen(0, 2, TH_TEXT_DIM));
    store64(g_rail_pbrt, CreatePen(0, 2, TH_TEXT_BRT));
    store64(g_rail_hot, 0 - 1);
    store64(g_rail_sel, 0);
    store64(g_rail_reg, 1);
    return 0;
}

# ================= custom title bar =================
# Top inset applied to all content when MAXIMIZED (the WS_THICKFRAME overhang).
func cap_top_inset() -> i64 {
    if IsZoomed(load64(gui_hwnd)) == 0 { return 0; }
    mi = GetSystemMetrics(32) + GetSystemMetrics(92);       # SM_CXFRAME + SM_CXPADDEDBORDER (recomputed -> DPI-safe)
    if mi == 0 { mi = 8; }
    return mi;
}
# x of caption button n (0=min,1=max,2=close), right-aligned, 46px each.
func cap_btn_x(n: i64, cw: i64, inset: i64) -> i64 { return (cw - inset) - (3 - n) * 46; }
func cap_btn_rect(n: i64, cw: i64, inset: i64) -> i64 {
    bx = cap_btn_x(n, cw, inset);
    store32(g_cap_btn + 0, bx);        store32(g_cap_btn + 4,  inset);
    store32(g_cap_btn + 8, bx + 46);   store32(g_cap_btn + 12, inset + CAP_H);
    return bx;
}
# Which caption button (1..3) is under client (mx,my), or 0.
func caption_hot_at(mx: i64, my: i64) -> i64 {
    GetClientRect(load64(gui_hwnd), g_cap_rc);
    cw = load32(g_cap_rc + 8);
    inset = cap_top_inset();
    if my < inset { return 0; }
    if my >= inset + CAP_H { return 0; }
    n = 0;
    while n < 3 {
        bx = cap_btn_x(n, cw, inset);
        if mx >= bx { if mx < bx + 46 { return n + 1; } }
        n = n + 1;
    }
    return 0;
}
# Run caption button h's action (1 min / 2 max-restore / 3 close). 1 = handled.
func caption_do(h: i64) -> i64 {
    if h == 1 { SendMessageA(load64(gui_hwnd), 274, 0xF020, 0); return 1; }   # SC_MINIMIZE
    if h == 2 {
        sc = 0xF030; if IsZoomed(load64(gui_hwnd)) != 0 { sc = 0xF120; }      # SC_MAXIMIZE / SC_RESTORE
        SendMessageA(load64(gui_hwnd), 274, sc, 0); return 1;
    }
    if h == 3 { SendMessageA(load64(gui_hwnd), 274, 0xF060, 0); return 1; }   # SC_CLOSE
    return 0;
}
# Paint the caption strip (from WM_PAINT): app mark + title + min/max/close, with hover.
func paint_caption(hdc: i64) -> i64 {
    GetClientRect(load64(gui_hwnd), g_cap_rc);
    cw = load32(g_cap_rc + 8);
    inset = cap_top_inset();
    store32(g_cap_rc + 0, inset);      store32(g_cap_rc + 4,  inset);
    store32(g_cap_rc + 8, cw - inset); store32(g_cap_rc + 12, inset + CAP_H);
    FillRect(hdc, g_cap_rc, load64(thm_b_panel));
    iy = inset + (CAP_H - 14) / 2;                       # small neon app mark
    op0 = SelectObject(hdc, load64(thm_p_neon));
    ob0 = SelectObject(hdc, load64(thm_b_neon));
    RoundRect(hdc, inset + 10, iy, inset + 24, iy + 14, 4, 4);
    SelectObject(hdc, ob0); SelectObject(hdc, op0);
    SetBkMode(hdc, 1);                                   # title
    SetTextColor(hdc, TH_TEXT);
    ofnt = SelectObject(hdc, load64(thm_f_hdr));
    store32(g_cap_rc + 0, inset + 34); store32(g_cap_rc + 4, inset);
    store32(g_cap_rc + 8, cw - inset - 150); store32(g_cap_rc + 12, inset + CAP_H);
    DrawTextA(hdc, cap_title, 0 - 1, g_cap_rc, 0x24);    # DT_VCENTER|DT_SINGLELINE
    hot = load64(g_cap_hot);
    zoomed = IsZoomed(load64(gui_hwnd));
    n = 0;
    while n < 3 {
        cap_btn_rect(n, cw, inset);
        if hot == n + 1 {
            if n == 2 { rb = CreateSolidBrush(TH_RED); FillRect(hdc, g_cap_btn, rb); DeleteObject(rb); }   # close = red
            else { FillRect(hdc, g_cap_btn, load64(thm_b_hover)); }
        }
        gx = load32(g_cap_btn + 0) + 23;
        gy = inset + CAP_H / 2;
        gc = TH_TEXT; if hot == n + 1 { gc = TH_TEXT_BRT; }
        pen = CreatePen(0, 1, gc);
        op = SelectObject(hdc, pen);
        if n == 0 { MoveToEx(hdc, gx - 5, gy + 4, 0); LineTo(hdc, gx + 6, gy + 4); }   # minimize bar
        if n == 1 {                                                                     # max / restore
            if zoomed == 0 {
                MoveToEx(hdc, gx - 5, gy - 5, 0); LineTo(hdc, gx + 5, gy - 5);
                LineTo(hdc, gx + 5, gy + 5); LineTo(hdc, gx - 5, gy + 5); LineTo(hdc, gx - 5, gy - 5);
            } else {
                MoveToEx(hdc, gx - 5, gy - 3, 0); LineTo(hdc, gx + 3, gy - 3);
                LineTo(hdc, gx + 3, gy + 5); LineTo(hdc, gx - 5, gy + 5); LineTo(hdc, gx - 5, gy - 3);
                MoveToEx(hdc, gx - 3, gy - 3, 0); LineTo(hdc, gx - 3, gy - 5);
                LineTo(hdc, gx + 5, gy - 5); LineTo(hdc, gx + 5, gy + 3); LineTo(hdc, gx + 3, gy + 3);
            }
        }
        if n == 2 {                                                                     # close X
            MoveToEx(hdc, gx - 5, gy - 5, 0); LineTo(hdc, gx + 6, gy + 6);
            MoveToEx(hdc, gx + 5, gy - 5, 0); LineTo(hdc, gx - 6, gy + 6);
        }
        SelectObject(hdc, op);
        DeleteObject(pen);
        n = n + 1;
    }
    thm_sep_line(hdc, inset, inset + CAP_H - 1, cw - inset);
    SelectObject(hdc, ofnt);                             # restore the DC's original font
    return 0;
}

func layout_controls(cw: i64, ch: i64) -> i64 {
    toolH = 34;
    outH = 150;
    statusH = 22;
    m = 10;                                  # outer margin
    g = 10;                                   # gap between panes
    tw = 240;
    railW = 330;                              # chat rail width (right)
    actW = 48;                                # activity rail width (far left)
    rad = 12;                                 # card corner radius
    capH = cap_top_inset() + CAP_H;           # caption band (CAP_H + the maximized frame overhang)
    top = capH + toolH + m;
    statusY = ch - statusH - cap_top_inset();
    tby = capH + 4;                           # toolbar/menu-strip buttons sit just below the caption
    ti = 0;
    while ti < 10 {                              # the 10 menu/action buttons (Save Log/Clear Log dock by the Output pane)
        tbh = load64(g_tb + ti * 8);
        if tbh != 0 { MoveWindow(tbh, load64(g_tbx + ti * 8), tby, load64(g_tbw + ti * 8), 26, 1); }
        ti = ti + 1;
    }
    outBottom = statusY - m;
    outTop = outBottom - outH;
    midH = outTop - g - top;
    if midH < 90 { midH = 90; }
    tx0 = m + actW + g;                       # tree/editor/output left edge (right of the activity rail)
    ew = cw - tx0 - tw - g - g - railW - m;
    if ew < 160 { ew = 160; }
    edX = tx0 + tw + g;
    rx = edX + ew + g;                        # chat rail x
    ow = cw - tx0 - m;
    rl = load64(gui_rail);                    # activity rail: spans the left edge below the toolbar
    if rl != 0 { MoveWindow(rl, m, top, actW, outBottom - top, 1); }
    tr = load64(g_tree_hwnd);
    if tr == 0 { return 0; }
    MoveWindow(tr, tx0, top, tw, midH, 1);                  thm_round(tr, tw, midH, rad);
    edTop = top + TAB_H;                                    # editor sits below the tab strip
    edH = midH - TAB_H;
    if edH < 60 { edH = 60; }
    store32(g_tab_rc + 0, edX);      store32(g_tab_rc + 4,  top);              # tab strip spans the editor column
    store32(g_tab_rc + 8, edX + ew); store32(g_tab_rc + 12, top + TAB_H);
    gutW = 46;                                              # line-number gutter width (strip left of editor)
    ed = load64(gui_editor);
    if ed != 0 { MoveWindow(ed, edX + gutW, edTop, ew - gutW, edH, 1);    thm_round(ed, ew - gutW, edH, rad); }
    store32(g_gut_rc + 0, edX);          store32(g_gut_rc + 4,  edTop);
    store32(g_gut_rc + 8, edX + gutW);   store32(g_gut_rc + 12, edTop + edH);
    # Find/Replace bar -- in the TOOLBAR ROW, just right of the Settings button (hidden unless
    # toggled), so it aligns with the buttons bar instead of floating over the editor.
    fbx = load64(g_tbx + 72) + load64(g_tbw + 72) + 12;    # past Fix (toolbar button index 9)
    fby = tby;
    if load64(gui_find_in)  != 0 { MoveWindow(load64(gui_find_in),  fbx,       fby, 150, 26, 1); }
    if load64(gui_find_btn) != 0 { MoveWindow(load64(gui_find_btn), fbx + 154, fby, 48,  26, 1); }
    if load64(gui_repl_in)  != 0 { MoveWindow(load64(gui_repl_in),  fbx + 208, fby, 150, 26, 1); }
    if load64(gui_repl_btn) != 0 { MoveWindow(load64(gui_repl_btn), fbx + 362, fby, 56,  26, 1); }
    if load64(gui_find_close) != 0 { MoveWindow(load64(gui_find_close), fbx + 420, fby, 26, 26, 1); }
    ho = load64(gui_output);
    if ho != 0 { MoveWindow(ho, tx0, outTop, ow, outH, 1); thm_round(ho, ow, outH, rad); }
    # Bottom row, right side:  [Ln, Col] [Save Log] [Clear Log]  (the log buttons dock under the panel).
    logbw = 76; logbh = 22;
    clearx = cw - 10 - logbw;                              # Clear Log at the far bottom-right
    savex  = clearx - 6 - logbw;                           # Save Log to its left
    if load64(g_tb + 88) != 0 { MoveWindow(load64(g_tb + 88), clearx, statusY, logbw, logbh, 1); }   # Clear Log
    if load64(g_tb + 80) != 0 { MoveWindow(load64(g_tb + 80), savex,  statusY, logbw, logbh, 1); }   # Save Log
    lcw = 110;
    lcx = savex - 8 - lcw;                                 # Ln/Col to the LEFT of the buttons
    st = load64(gui_status);
    if st != 0 { MoveWindow(st, 6, statusY, lcx - 12, statusH, 1); }    # status text fills the remaining left span
    lc = load64(gui_lincol);
    if lc != 0 { MoveWindow(lc, lcx, statusY, lcw, statusH, 1); }
    bdg = load64(gui_badge);
    if bdg != 0 { MoveWindow(bdg, rx, top, railW, 28, 1); }
    coh = midH - 98; if coh < 40 { coh = 40; }            # floor the transcript height at small window sizes
    co = load64(gui_chat_out);
    if co != 0 { MoveWindow(co, rx, top + 34, railW, coh, 1);  thm_round(co, railW, coh, rad); }
    ci = load64(gui_chat_in);
    if ci != 0 { MoveWindow(ci, rx, top + midH - 60, railW, 30, 1); thm_round(ci, railW, 30, 6); }
    ib = load64(gui_chat_img);
    if ib != 0 { MoveWindow(ib, rx, top + midH - 28, 46, 26, 1); }                          # [Img]
    sb = load64(gui_chat_send);
    if sb != 0 { MoveWindow(sb, rx + 50, top + midH - 28, railW - 50 - 92, 26, 1); }         # Send
    stb = load64(gui_chat_stop);
    if stb != 0 { MoveWindow(stb, rx + railW - 88, top + midH - 28, 88, 26, 1); }            # Stop
    InvalidateRect(load64(gui_hwnd), g_gut_rc, 0);          # repaint the line-number gutter after a resize
    InvalidateRect(load64(gui_hwnd), g_tab_rc, 0);          # + the tab strip
    return 0;
}

# Paint the line-number gutter (the strip left of the editor), in the main WM_PAINT.
# Each visible line's Y comes from EM_POSFROMCHAR so numbers stay aligned through
# smooth scrolling. No-op until layout has populated g_gut_rc.
func paint_gutter(hdc: i64) -> i64 {
    ed = load64(gui_editor);
    if ed == 0 { return 0; }
    gx = load32(g_gut_rc + 0);
    gy = load32(g_gut_rc + 4);
    gh = load32(g_gut_rc + 12) - gy;
    if gh <= 0 { return 0; }
    FillRect(hdc, g_gut_rc, load64(thm_b_panel));
    SelectObject(hdc, load64(g_font));
    SetBkMode(hdc, 1);                                       # TRANSPARENT
    SetTextColor(hdc, TH_TEXT_DIM);
    first = SendMessageA(ed, 0xCE, 0, 0);                    # EM_GETFIRSTVISIBLELINE
    lc    = SendMessageA(ed, 0xBA, 0, 0);                    # EM_GETLINECOUNT
    i = first;
    going = 1;
    while going == 1 {
        if i >= lc { going = 0; }
        if going == 1 {
            ci = SendMessageA(ed, 0xBB, i, 0);               # EM_LINEINDEX (line -> first char offset)
            if ci < 0 { going = 0; }
            if going == 1 {
                SendMessageA(ed, 0xD6, g_gut_pt, ci);        # EM_POSFROMCHAR -> g_gut_pt (x@0, y@4)
                y = load32(g_gut_pt + 4);
                if y >= 0x80000000 { y = y - 0x100000000; }  # sign-extend (line may be partly scrolled above)
                if y > gh { going = 0; }
                if going == 1 {
                    if y >= 0 {                              # only draw rows actually in view
                        int_to_str(g_gut_num, i + 1);
                        TextOutA(hdc, gx + 8, gy + y, g_gut_num, strlen(g_gut_num));
                    }
                    i = i + 1;
                }
            }
        }
    }
    return 0;
}

func create_controls(hwnd: i64) -> i64 {
    settings_load();                         # load config + point the Ollama transport
    agent_init(hwnd);                        # post target + bundled compiler path
    hinst = load64(gui_hinst);

    # Consolas font for the editor + output (16px).
    fnt = CreateFontA(0 - 16, 0, 0, 0, 400, 0, 0, 0, 0, 0, 0, 0, 0x31, face_mono);
    store64(g_font, fnt);

    ide_build_menu(hwnd);                        # build the dark File / Build / Help popups
    build_filter();
    build_imgfilter();
    recent_load();                               # load the Open Recent MRU list
    store64(g_tab_cur, 0 - 1);                    # no tabs yet
    tab_i = 0;
    while tab_i < 8 { store64(g_tab_buf + tab_i * 8, alloc(262144)); tab_i = tab_i + 1; }   # per-tab content buffers (heap)
    # Dark menu strip (open owner-drawn popups) + quick-action GlowButtons.
    # toolbar/menu-strip buttons (created at y=CAP_H+4; layout_controls repositions them per the caption inset)
    store64(g_tbx + 0,  6);   store64(g_tbw + 0,  46);  store64(g_tb + 0,  CreateWindowExA(0, thm_cls_glow, mtop_file,   0x50000000, 6,   38, 46,  26, hwnd, 2320, hinst, 0));
    store64(g_tbx + 8,  56);  store64(g_tbw + 8,  46);  store64(g_tb + 8,  CreateWindowExA(0, thm_cls_glow, mtop_edit,   0x50000000, 56,  38, 46,  26, hwnd, 2323, hinst, 0));
    store64(g_tbx + 16, 106); store64(g_tbw + 16, 54);  store64(g_tb + 16, CreateWindowExA(0, thm_cls_glow, mtop_build,  0x50000000, 106, 38, 54,  26, hwnd, 2321, hinst, 0));
    store64(g_tbx + 24, 164); store64(g_tbw + 24, 48);  store64(g_tb + 24, CreateWindowExA(0, thm_cls_glow, mtop_help,   0x50000000, 164, 38, 48,  26, hwnd, 2322, hinst, 0));
    store64(g_tbx + 32, 224); store64(g_tbw + 32, 58);  store64(g_tb + 32, CreateWindowExA(0, thm_cls_glow, lbl_open,    0x50000000, 224, 38, 58,  26, hwnd, 2303, hinst, 0));
    store64(g_tbx + 40, 286); store64(g_tbw + 40, 56);  store64(g_tb + 40, CreateWindowExA(0, thm_cls_glow, lbl_save,    0x50000000, 286, 38, 56,  26, hwnd, 2302, hinst, 0));
    store64(g_tbx + 48, 346); store64(g_tbw + 48, 126); store64(g_tb + 48, CreateWindowExA(0, thm_cls_glow, lbl_compile, 0x50000000, 346, 38, 126, 26, hwnd, 2304, hinst, 0));
    store64(g_tbx + 56, 476); store64(g_tbw + 56, 50);  store64(g_tb + 56, CreateWindowExA(0, thm_cls_glow, lbl_run,     0x50000000, 476, 38, 50,  26, hwnd, 2307, hinst, 0));
    store64(g_tbx + 64, 530); store64(g_tbw + 64, 84);  store64(g_tb + 64, CreateWindowExA(0, thm_cls_glow, lbl_settings,0x50000000, 530, 38, 84,  26, hwnd, 2308, hinst, 0));
    store64(g_tbx + 72, 624); store64(g_tbw + 72, 50);  store64(g_tb + 72, CreateWindowExA(0, thm_cls_glow, lbl_fix,     0x50000000, 624, 38, 50,  26, hwnd, 2315, hinst, 0));   # Smart-compiler auto-fix
    store64(g_tbx + 80, 684); store64(g_tbw + 80, 80);  store64(g_tb + 80, CreateWindowExA(0, thm_cls_glow, lbl_savelog,  0x50000000, 684, 38, 80, 26, hwnd, 2360, hinst, 0));  # Save the Output log
    store64(g_tbx + 88, 770); store64(g_tbw + 88, 80);  store64(g_tb + 88, CreateWindowExA(0, thm_cls_glow, lbl_clearlog, 0x50000000, 770, 38, 80, 26, hwnd, 2361, hinst, 0));  # Clear the Output log
    store64(gui_mb_file,  load64(g_tb + 0));            # menu-strip HWNDs (for menu_drop anchoring)
    store64(gui_mb_edit,  load64(g_tb + 8));
    store64(gui_mb_build, load64(g_tb + 16));
    store64(gui_mb_help,  load64(g_tb + 24));

    tv_init_common();
    tree = tv_create(hwnd, hinst, 2201);
    store64(gui_tree, tree);
    SendMessageA(tree, 0x111D, 0, TH_BG_DEEP);    # TVM_SETBKCOLOR -> card tone
    SendMessageA(tree, 0x111E, 0, TH_TEXT);       # TVM_SETTEXTCOLOR
    thm_dark_scroll(tree);                        # dark scrollbar

    LoadLibraryA(s_msftedit);                # register the RICHEDIT50W class
    ed = CreateWindowExA(0, cls_rich, gui_empty, 0x543011C4, 0, 0, 400, 300, hwnd, 2101, hinst, 0);  # borderless (+ES_NOHIDESEL: keep the jumped error-line selection visible)
    store64(gui_editor, ed);
    thm_dark_scroll(ed);                     # dark scrollbar
    SendMessageA(ed, 0x443, 0, TH_BG_DEEP);  # EM_SETBKGNDCOLOR -> card tone
    SendMessageA(ed, 48, fnt, 1);            # WM_SETFONT -> Consolas default
    memset(ide_cf, 0, 60);                   # default char format = primary text
    store32(ide_cf + 0, 60); store32(ide_cf + 4, 0x40000000); store32(ide_cf + 20, TH_TEXT);
    SendMessageA(ed, 0x444, 4, ide_cf);      # EM_SETCHARFORMAT SCF_ALL
    SendMessageA(ed, 0x445, 0, 0x80000005);  # EM_SETEVENTMASK ENM_CHANGE|ENM_SCROLL|ENM_SELCHANGE (gutter + line:col)
    SendMessageA(ed, 12, 0, ed_seed);        # WM_SETTEXT seed
    ide_recolor();

    # Output pane: read-only multiline EDIT (= 0x50A00804).
    ho = CreateWindowExA(0, cls_rich, gui_empty, 0x50200844, 0, 0, 400, 100, hwnd, 2401, hinst, 0);  # RichEdit (rounds + clean scroll), borderless, read-only
    store64(gui_output, ho);
    thm_dark_scroll(ho);                     # dark scrollbar
    SendMessageA(ho, 0x443, 0, TH_BG_DEEP);  # EM_SETBKGNDCOLOR -> card tone
    SendMessageA(ho, 48, fnt, 1);            # Consolas
    SendMessageA(ho, 0x435, 0, 1048576);     # EM_EXLIMITTEXT -> 1 MB
    memset(ide_cf, 0, 60); store32(ide_cf + 0, 60); store32(ide_cf + 4, 0x40000000); store32(ide_cf + 20, TH_TEXT);
    SendMessageA(ho, 0x444, 4, ide_cf);      # EM_SETCHARFORMAT SCF_ALL -> light default text

    # Status bar (STATIC, dark via WM_CTLCOLORSTATIC).
    stt = CreateWindowExA(0, cls_static, st_ready, 0x50000000, 0, 0, 400, 20, hwnd, 2501, hinst, 0);
    store64(gui_status, stt);
    SendMessageA(stt, 48, load64(thm_f_ui), 1);   # Segoe UI for chrome
    lcs = CreateWindowExA(0, cls_static, gui_empty, 0x50000002, 0, 0, 150, 20, hwnd, 2502, hinst, 0);  # SS_RIGHT line:col
    store64(gui_lincol, lcs);
    SendMessageA(lcs, 48, load64(thm_f_ui), 1);
    store32(g_stex + 0, 0); store32(g_stex + 4, 65001);   # SETTEXTEX: ST_DEFAULT + CP_UTF8 (chat transcript)

    # Chat / agent rail: transcript (read-only), input box, Send button.
    co = CreateWindowExA(0, cls_rich, gui_empty, 0x50200844, 0, 0, 300, 200, hwnd, 2601, hinst, 0);  # RichEdit, borderless
    store64(gui_chat_out, co);
    thm_dark_scroll(co);                      # dark scrollbar
    SendMessageA(co, 0x443, 0, TH_BG_DEEP);   # EM_SETBKGNDCOLOR -> card tone
    SendMessageA(co, 48, fnt, 1);            # WM_SETFONT -> Consolas
    SendMessageA(co, 0x435, 0, 1048576);     # EM_EXLIMITTEXT -> 1 MB
    ci = CreateWindowExA(0, cls_edit, gui_empty, 0x50200044, 0, 0, 300, 30, hwnd, 2602, hinst, 0);  # borderless
    store64(gui_chat_in, ci);
    thm_dark_scroll(ci);                     # dark scrollbar
    SendMessageA(ci, 48, fnt, 1);
    imgbtn = CreateWindowExA(0, thm_cls_glow, lbl_img, 0x50000000, 0, 0, 46, 26, hwnd, 2606, hinst, 0);
    store64(gui_chat_img, imgbtn);            # attach an image for vision
    sbtn = CreateWindowExA(0, thm_cls_glow, lbl_send, 0x50000000, 0, 0, 80, 26, hwnd, 2603, hinst, 0);
    store64(gui_chat_send, sbtn);
    store64(thm_accent_id, 2603);             # Send = the primary (purple-filled) button
    stopbtn = CreateWindowExA(0, thm_cls_glow, lbl_stop, 0x50000000, 0, 0, 80, 26, hwnd, 2604, hinst, 0);
    store64(gui_chat_stop, stopbtn);
    register_agent_badge(hinst);
    bdg = CreateWindowExA(0, cls_badge, gui_empty, 0x50000000, 0, 0, 200, 28, hwnd, 2605, hinst, 0);
    store64(gui_badge, bdg);
    register_rail(hinst);                     # far-left activity/icon rail
    store64(gui_rail, CreateWindowExA(0, cls_rail, gui_empty, 0x50000000, 0, 0, 48, 400, hwnd, 2350, hinst, 0));

    # Find/Replace bar -- created hidden (no WS_VISIBLE); toggled by Ctrl+F.
    fin = CreateWindowExA(0, cls_edit, gui_empty, 0x44000080, 0, 0, 150, 24, hwnd, 2701, hinst, 0);  # single-line
    store64(gui_find_in, fin); SendMessageA(fin, 48, fnt, 1);
    store64(gui_find_btn, CreateWindowExA(0, thm_cls_glow, lbl_find, 0x44000000, 0, 0, 48, 24, hwnd, 2702, hinst, 0));
    rin = CreateWindowExA(0, cls_edit, gui_empty, 0x44000080, 0, 0, 150, 24, hwnd, 2703, hinst, 0);
    store64(gui_repl_in, rin); SendMessageA(rin, 48, fnt, 1);
    store64(gui_repl_btn, CreateWindowExA(0, thm_cls_glow, lbl_repl, 0x44000000, 0, 0, 56, 24, hwnd, 2704, hinst, 0));
    store64(gui_find_close, CreateWindowExA(0, thm_cls_glow, lbl_findx, 0x44000000, 0, 0, 26, 24, hwnd, 2705, hinst, 0));   # close the bar

    ui_exedir(g_app_root);                    # ...\aether_studio_dist\bin
    bs = uic_last_bs(g_app_root);
    if bs > 0 { store8(g_app_root + bs, 0); } # g_app_root = ...\aether_studio_dist (bundled templates + compiler)
    ide_init_workspace();                     # g_workspace = a clean projects folder, NOT the IDE's own install dir
    tv_reset();
    tv_populate(tree, g_workspace, 0 - 0x10000, 0);

    GetClientRect(hwnd, g_rect);
    layout_controls(load32(g_rect + 8), load32(g_rect + 12));
    update_lincol();                         # show "Ln 1, Col 1" before any interaction
    if GetEnvironmentVariableA(env_self, g_envbuf, 8) > 0 { ide_selftest(); }
    if GetEnvironmentVariableA(env_pal, g_envbuf, 8) > 0 { SetTimer(hwnd, 9, 350, 0); }   # test hook: open the palette once the window is up
    if GetEnvironmentVariableA(env_paste, g_envbuf, 8) > 0 { SetTimer(hwnd, 10, 400, 0); } # test hook: clipboard paste-image
    if GetEnvironmentVariableA(env_vimg, g_vimgpath, 590) > 0 { attach_image_path(g_vimgpath); }   # vision test hook
    if GetEnvironmentVariableA(env_bench, g_benchpath, 590) > 0 { ide_bench(); }   # perf probe (opens file, times recolor, exits)
    if GetEnvironmentVariableA(env_rntest, g_benchpath, 590) > 0 { ide_rename_selftest(); }   # rename-logic probe (exits)
    if GetEnvironmentVariableA(env_outtest, g_benchpath, 590) > 0 { ide_out_selftest(); }      # output-path probe (exits)
    if GetEnvironmentVariableA(env_fixtest, g_envbuf, 8) > 0 { ide_fix_selftest(); }           # smart-compiler auto-fix probe (exits)
    if GetEnvironmentVariableA(env_repairtest, g_envbuf, 8) > 0 { ide_repair_selftest(); }      # smart-compiler AI-repair prep probe (exits)
    if GetEnvironmentVariableA(env_openf, g_benchpath, 590) > 0 { ide_open_path(g_benchpath); }   # open a file at startup (visual test)
    return 0;
}

func ide_append_out(s: i64) -> i64 {
    ho = load64(gui_output);
    if ho == 0 { return 0; }
    ui_lf_to_crlf(ide_crlf, s);
    len = SendMessageA(ho, 14, 0, 0);                  # WM_GETTEXTLENGTH
    if len > 28000 {
        SendMessageA(ho, 177, 0, len - 16000);         # EM_SETSEL [0, len-16000)
        SendMessageA(ho, 194, 0, gui_empty);           # EM_REPLACESEL "" -> drop oldest
    }
    SendMessageA(ho, 177, 0x7FFFFFFF, 0x7FFFFFFF);     # EM_SETSEL -> caret to end
    SendMessageA(ho, 194, 0, ide_crlf);                # EM_REPLACESEL -> append
    SendMessageA(ho, 183, 0, 0);                        # EM_SCROLLCARET -> follow to the new end (auto-scroll)
    return 0;
}

# Append `s` to the output pane in RED (the theme error color) -- used for the
# non-modal "a fix is available" hint so it grabs the eye without blocking.
func ide_append_out_red(s: i64) -> i64 {
    ho = load64(gui_output);
    if ho == 0 { return 0; }
    ui_lf_to_crlf(ide_crlf, s);
    len = SendMessageA(ho, 14, 0, 0);                  # WM_GETTEXTLENGTH (same trim guard as ide_append_out)
    if len > 28000 {
        SendMessageA(ho, 177, 0, len - 16000);
        SendMessageA(ho, 194, 0, gui_empty);
    }
    SendMessageA(ho, 177, 0x7FFFFFFF, 0x7FFFFFFF);     # EM_SETSEL -> caret to end
    SendMessageA(ho, 0x434, 0, g_out_sel);             # EM_EXGETSEL -> cpMax = start of the new run
    rstart = load32(g_out_sel + 4);
    SendMessageA(ho, 194, 0, ide_crlf);                # EM_REPLACESEL -> append the hint
    SendMessageA(ho, 177, 0x7FFFFFFF, 0x7FFFFFFF);     # EM_SETSEL -> end
    SendMessageA(ho, 0x434, 0, g_out_sel);             # EM_EXGETSEL -> cpMax = end of the new run
    rend = load32(g_out_sel + 4);
    SendMessageA(ho, 177, rstart, rend);               # EM_SETSEL [start, end) -> select the appended run
    memset(ide_cf, 0, 60);
    store32(ide_cf + 0, 60); store32(ide_cf + 4, 0x40000000); store32(ide_cf + 20, TH_RED);   # CFM_COLOR = red
    SendMessageA(ho, 0x444, 1, ide_cf);                # EM_SETCHARFORMAT SCF_SELECTION -> red run
    SendMessageA(ho, 177, 0x7FFFFFFF, 0x7FFFFFFF);     # caret to end (deselect)
    memset(ide_cf, 0, 60);
    store32(ide_cf + 0, 60); store32(ide_cf + 4, 0x40000000); store32(ide_cf + 20, TH_TEXT);  # reset caret -> default
    SendMessageA(ho, 0x444, 1, ide_cf);                # so the NEXT plain append isn't red (no color bleed)
    SendMessageA(ho, 183, 0, 0);                       # EM_SCROLLCARET -> keep it visible
    return 0;
}

# dst = src with '\n' removed (keep '\r'): a \r-only view whose char indices
# match the RichEdit document, so EM_EXSETSEL token ranges land correctly.
func strip_lf(dst: i64, src: i64) -> i64 {
    i = 0;
    j = 0;
    while 1 {
        c = load8(src + i);
        if c == 0 { store8(dst + j, 0); return j; }
        if c == 10 { } else { store8(dst + j, c); j = j + 1; }
        i = i + 1;
    }
    return j;
}

# Headless perf probe (AETHER_IDE_BENCH=<file>): open the file, time 5 recolors,
# write bin\recolor_bench.txt, and exit. Used to validate the scroll-lag fix.
func ide_bench() -> i64 {
    ide_open_path(g_benchpath);                  # load the file (+ one recolor)
    t0 = GetTickCount();
    ide_recolor(); ide_recolor(); ide_recolor(); ide_recolor(); ide_recolor();
    t1 = GetTickCount();
    p = str_copy(g_benchout, bench_pfx);
    int_to_str(g_benchnum, t1 - t0);
    p = str_copy(p, g_benchnum);
    str_copy(p, bench_sfx);
    ui_exedir(g_compiler_dir);
    ui_join(g_benchfpath, g_compiler_dir, g_benchfile);
    ui_write_file(g_benchfpath, g_benchout, strlen(g_benchout));
    ExitProcess(0);
    return 0;
}

# Headless rename-logic probe (AETHER_IDE_RENAMETEST=<existing file>): wire the
# file in as node 0, fabricate an ENDLABELEDIT renaming it to renamed_probe.ancl,
# run rename_end, write bin\rename_test.txt with the verdict + new path, and exit.
func ide_rename_selftest() -> i64 {
    str_copy(tv_node_path(0), g_benchpath);      # node 0 = the test file
    store8(g_node_isdir + 0, 0);
    store64(g_edit_node, 0);
    memset(g_rn_fake, 0, 96);
    store64(g_rn_fake + 48, rn_newname);         # NMTVDISPINFO.item.pszText = the new name
    rA = rename_end(g_rn_fake);                  # happy path -> should rename + return 1
    memset(g_rn_fake, 0, 96);
    store64(g_rn_fake + 48, rn_sepname);         # path-escape attempt (node 0 is now the renamed file)
    rB = rename_end(g_rn_fake);                  # must be rejected -> 0, file stays put
    p = str_copy(g_benchout, rn_res_pfx);
    int_to_str(g_benchnum, rA); p = str_copy(p, g_benchnum);
    p = str_copy(p, rn_res_sep);
    int_to_str(g_benchnum, rB); p = str_copy(p, g_benchnum);
    p = str_copy(p, rn_res_path);
    p = str_copy(p, tv_node_path(0));            # should still be <dir>\renamed_probe.ancl
    str_copy(p, bench_sfx);
    ui_exedir(g_compiler_dir);
    ui_join(g_benchfpath, g_compiler_dir, rn_res_file);
    ui_write_file(g_benchfpath, g_benchout, strlen(g_benchout));
    ExitProcess(0);
    return 0;
}

# Headless output-path probe (AETHER_IDE_OUTTEST=<a source path>): run ide_out_path
# on it and write <exedir>\out_test.txt with the computed g_bindir + g_out_p, then exit.
func ide_out_selftest() -> i64 {
    str_copy(g_curpath, g_benchpath);        # the sample source path from the env var
    ide_out_path();                           # compute g_out_p + create <dir>\bin
    ui_write_file(g_asm_bin, ot_dummy, strlen(ot_dummy));   # drop a dummy listing in bin...
    ide_move_asm();                           # ...and exercise the relocation next to the source
    p = str_copy(g_benchout, ot_bindir);
    p = str_copy(p, g_bindir);
    p = str_copy(p, ot_outp);
    p = str_copy(p, g_out_p);
    p = str_copy(p, ot_asmb);
    p = str_copy(p, g_asm_bin);
    p = str_copy(p, ot_asms);
    p = str_copy(p, g_asm_src);
    str_copy(p, bench_sfx);
    ui_exedir(g_compiler_dir);
    ui_join(g_benchfpath, g_compiler_dir, ot_res_file);
    ui_write_file(g_benchfpath, g_benchout, strlen(g_benchout));
    ExitProcess(0);
    return 0;
}

# Headless auto-fix probe (AETHER_IDE_FIXTEST=1): seed a broken file, open it,
# run do_fix_current (which auto-confirms under this hook), then write the
# RELOADED editor text to bin\fix_test.txt so the driver can assert it healed.
func ide_fix_selftest() -> i64 {
    ui_join(g_ft_path, g_workspace, ft_name);                 # <workspace>\_aether_fixtest.ancl
    ui_write_file(g_ft_path, ft_broken, strlen(ft_broken));   # seed the broken source ('//' + missing ';')
    ide_open_path(g_ft_path);                                 # -> current file + into the editor
    do_fix_current();                                         # auto-confirm (env) -> heal on disk + reload editor
    memset(g_ft_edit, 0, 4096);
    SendMessageA(load64(gui_editor), 13, 4095, g_ft_edit);    # WM_GETTEXT -> the reloaded (healed) editor text
    p = str_copy(g_ft_res, ft_res_pfx);
    p = str_copy(p, g_ft_edit);
    str_copy(p, bench_sfx);
    ui_exedir(g_compiler_dir);
    ui_join(g_benchfpath, g_compiler_dir, ft_res_file);       # bin\fix_test.txt
    ui_write_file(g_benchfpath, g_ft_res, strlen(g_ft_res));
    ExitProcess(0);
    return 0;
}

# Headless AI-repair probe (AETHER_IDE_REPAIRTEST=1): seed a broken file, run
# repair_prepare (compile -> detect failure -> assemble the agent turn), and
# write bin\repair_test.txt with the detection flag + assembled prompt so the
# driver can assert the new SC2 logic (the agent/LLM half is proven separately).
func ide_repair_selftest() -> i64 {
    ui_join(g_ft_path, g_workspace, rt_name);                 # <workspace>\_aether_repairtest.ancl
    ui_write_file(g_ft_path, ft_broken, strlen(ft_broken));   # broken source on disk
    ide_set_current(g_ft_path);                               # set g_curpath (repair_prepare reads from disk)
    rv = repair_prepare();                                    # 1 = failed to compile + prompt assembled
    p = str_copy(g_ft_res, rt_res_pfx);
    int_to_str(g_fix_num, rv); p = str_copy(p, g_fix_num);
    p = str_copy(p, rt_res_sep);
    p = str_copy(p, g_agent_input);                           # the assembled repair prompt
    str_copy(p, bench_sfx);
    ui_exedir(g_compiler_dir);
    ui_join(g_benchfpath, g_compiler_dir, rt_res_file);       # bin\repair_test.txt
    ui_write_file(g_benchfpath, g_ft_res, strlen(g_ft_res));
    ExitProcess(0);
    return 0;
}

# Re-tokenize the editor and recolor every run via the lexer palette.
# Redraw is locked + the caret/selection saved+restored to avoid flicker.
# Recolor the token runs in the char range [cstart, cend) of the editor (the shared
# core).  ANCL has no multi-line tokens, so a line start (cstart from EM_LINEINDEX) is
# always a safe place to begin tokenizing.  WM_SETREDRAW + saved sel/scroll = flicker-free,
# no view jump; EM_GETMODIFY save/restore keeps formatting from marking the doc dirty.
func ide_recolor_chars(cstart: i64, cend: i64) -> i64 {
    he = load64(gui_editor);
    if he == 0 { return 0; }
    if load64(g_in_recolor) == 1 { return 0; }         # re-entrancy guard (EM_SETSCROLLPOS can re-fire EN_VSCROLL -> recolor)
    store64(g_in_recolor, 1);
    svm = SendMessageA(he, 184, 0, 0);                 # EM_GETMODIFY
    SendMessageA(he, 13, 1048575, ide_rich_raw);       # WM_GETTEXT
    strip_lf(ide_doc, ide_rich_raw);                   # \r-only (matches EM_EXSETSEL indices)
    if cstart < 0 { cstart = 0; }
    dl = strlen(ide_doc);
    if cend < 0 { cend = dl; }
    if cend > dl { cend = dl; }
    SendMessageA(he, 0x434, 0, ide_sel);               # EM_EXGETSEL -> save selection
    SendMessageA(he, 0x4DD, 0, ide_scroll);            # EM_GETSCROLLPOS -> save scroll
    SendMessageA(he, 11, 0, 0);                        # WM_SETREDRAW FALSE
    # Color CONSECUTIVE same-colour tokens in ONE EM_SETCHARFORMAT. Most code is long runs of
    # default-coloured identifiers / punctuation / numbers / whitespace (all kind 0), so this cuts
    # a ~96-line band from ~768 round-trips to ~150-250 -> scroll/paste recolor is much snappier.
    pos = cstart;
    run_start = cstart;
    run_color = 0 - 1;                                 # sentinel: no run open yet
    while 1 {
        L = lex_next(ide_doc, pos);
        if L == 0 { break; }
        if pos >= cend { break; }                      # past the range -> stop
        c = lex_color(load64(g_tok_kind));
        if c != run_color {                            # colour changed -> flush the run [run_start, pos)
            if pos > run_start {
                memset(ide_cf, 0, 60); store32(ide_cf + 0, 60); store32(ide_cf + 4, 0x40000000);
                store32(ide_cf + 20, run_color);
                store32(ide_crange + 0, run_start); store32(ide_crange + 4, pos);
                SendMessageA(he, 0x437, 0, ide_crange);    # EM_EXSETSEL
                SendMessageA(he, 0x444, 1, ide_cf);        # EM_SETCHARFORMAT SCF_SELECTION
            }
            run_start = pos; run_color = c;
        }
        pos = pos + L;
    }
    if pos > run_start {                               # flush the final run
        memset(ide_cf, 0, 60); store32(ide_cf + 0, 60); store32(ide_cf + 4, 0x40000000);
        store32(ide_cf + 20, run_color);
        store32(ide_crange + 0, run_start); store32(ide_crange + 4, pos);
        SendMessageA(he, 0x437, 0, ide_crange);
        SendMessageA(he, 0x444, 1, ide_cf);
    }
    SendMessageA(he, 0x437, 0, ide_sel);               # restore selection
    SendMessageA(he, 0x4DE, 0, ide_scroll);            # EM_SETSCROLLPOS -> restore the exact scroll position
    SendMessageA(he, 11, 1, 0);                        # WM_SETREDRAW TRUE
    SendMessageA(he, 185, 0, svm);                     # EM_SETMODIFY restore
    InvalidateRect(he, 0, 1);
    store64(g_in_recolor, 0);
    return 0;
}

# Recolor the band around the VIEWPORT (used after a load and on scroll). A whole-document
# recolor of a 1000+ line file is ~12k EM_SETCHARFORMAT round-trips (~2s UI freeze); the band
# keeps it to the ~45 visible lines + margin. Off-screen text keeps the default colour until
# it scrolls into view (recolored then, debounced, by the EN_VSCROLL timer).
func ide_recolor() -> i64 {
    he = load64(gui_editor);
    if he == 0 { return 0; }
    store64(g_prev_len, SendMessageA(he, 14, 0, 0));   # WM_GETTEXTLENGTH -> keep the EN_CHANGE delta baseline current
    first = SendMessageA(he, 0xCE, 0, 0);              # EM_GETFIRSTVISIBLELINE
    lc    = SendMessageA(he, 0xBA, 0, 0);              # EM_GETLINECOUNT
    top = first - 12; if top < 0 { top = 0; }          # small margin above the viewport
    bot = first + 84; if bot > lc { bot = lc; }        # viewport (~45 lines) + margin below
    cstart = SendMessageA(he, 0xBB, top, 0);           # EM_LINEINDEX(top)
    cend = 0 - 1;                                       # -1 = to end of doc
    if bot < lc { ci = SendMessageA(he, 0xBB, bot, 0); if ci >= 0 { cend = ci; } }
    ide_recolor_chars(cstart, cend);
    # record the contiguous coloured LINE range so scrolling only paints newly-revealed lines.
    hb = first + 84; if hb > lc - 1 { hb = lc - 1; }
    store64(g_color_lo, top); store64(g_color_hi, hb);
    return 0;
}

# Colour an inclusive LINE range [la, lb] (used by the incremental scroll recolor).
func ide_color_lines(la: i64, lb: i64) -> i64 {
    he = load64(gui_editor);
    if he == 0 { return 0; }
    lc = SendMessageA(he, 0xBA, 0, 0);                  # EM_GETLINECOUNT
    if la < 0 { la = 0; }
    if lb > lc - 1 { lb = lc - 1; }
    if lb < la { return 0; }
    cstart = SendMessageA(he, 0xBB, la, 0);             # EM_LINEINDEX(la)
    cend = 0 - 1;
    if lb + 1 < lc { ci = SendMessageA(he, 0xBB, lb + 1, 0); if ci >= 0 { cend = ci; } }
    ide_recolor_chars(cstart, cend);
    return 0;
}

# Incremental recolor on SCROLL: only paint lines that are newly visible, tracked by the
# [g_color_lo, g_color_hi] watermark. Scrolling down through a file colours each line ONCE
# (instead of re-colouring the whole ~96-line band on every scroll tick) -> no scroll lag.
func ide_recolor_scroll() -> i64 {
    he = load64(gui_editor);
    if he == 0 { return 0; }
    first = SendMessageA(he, 0xCE, 0, 0);              # EM_GETFIRSTVISIBLELINE
    lc    = SendMessageA(he, 0xBA, 0, 0);              # EM_GETLINECOUNT
    top = first - 12; if top < 0 { top = 0; }
    bot = first + 84; if bot > lc - 1 { bot = lc - 1; }
    if bot < top { return 0; }
    lo = load64(g_color_lo); hi = load64(g_color_hi);
    if hi < lo {                                        # empty watermark -> colour the whole band
        ide_color_lines(top, bot); store64(g_color_lo, top); store64(g_color_hi, bot); return 0;
    }
    if top > hi {                                       # viewport jumped BELOW the coloured range
        ide_color_lines(top, bot); store64(g_color_lo, top); store64(g_color_hi, bot); return 0;
    }
    if bot < lo {                                       # viewport jumped ABOVE the coloured range
        ide_color_lines(top, bot); store64(g_color_lo, top); store64(g_color_hi, bot); return 0;
    }
    # overlap -> extend only the newly-revealed edge(s)
    if bot > hi { ide_color_lines(hi + 1, bot); store64(g_color_hi, bot); }
    if top < lo { ide_color_lines(top, lo - 1); store64(g_color_lo, top); }
    return 0;
}

# Fast recolor for LIVE TYPING: only the caret's line +- 1 (handles Enter splitting/joining
# a line). ~3 lines instead of the ~96-line viewport band, so a keystroke settles in a few ms
# instead of a ~0.3s hitch -- safe because ANCL has no multi-line tokens. (EN_CHANGE timer.)
func ide_recolor_typing() -> i64 {
    he = load64(gui_editor);
    if he == 0 { return 0; }
    SendMessageA(he, 0x434, 0, ide_sel);               # EM_EXGETSEL -> caret at cpMax
    caret = load32(ide_sel + 4);
    cl = SendMessageA(he, 0x436, 0, caret);            # EM_EXLINEFROMCHAR (0-based)
    lc = SendMessageA(he, 0xBA, 0, 0);                 # EM_GETLINECOUNT
    top = cl - 1; if top < 0 { top = 0; }
    bot = cl + 2; if bot > lc { bot = lc; }
    cstart = SendMessageA(he, 0xBB, top, 0);           # EM_LINEINDEX(top)
    cend = 0 - 1;
    if bot < lc { ci = SendMessageA(he, 0xBB, bot, 0); if ci >= 0 { cend = ci; } }
    ide_recolor_chars(cstart, cend);
    return 0;
}

func compile_worker(param: i64) -> i64 {
    n = ide_run_capture(g_cmd, g_capbuf, 262144);
    store64(g_caplen, n);
    ide_move_asm();                                    # .asm listing -> next to the source
    PostMessageA(load64(gui_hwnd), 0x8001, 0, 0);      # WM_APP+1: output ready
    return 0;
}

# Build & Run worker: compile the current file, and if it built, run it and
# capture its stdout + exit code.  Posts WM_APP+5 with the results.
func run_worker(param: i64) -> i64 {
    ide_run_capture(g_cmd, g_capbuf, 262144);          # compiler stdout (the build result/errors)
    store64(g_build_exit, load32(cap_exit));
    ide_move_asm();                                    # .asm listing -> next to the source
    if load64(g_build_exit) == 0 {                     # anclc exits 0 only on success
        ide_run_capture(g_runcmd, g_runout, 131072);   # the program's stdout/stderr
        store64(g_prog_exit, load32(cap_exit));
        store64(g_run_ok, 1);
    } else { store64(g_run_ok, 0); }
    PostMessageA(load64(gui_hwnd), 0x8005, 0, 0);      # WM_APP+5: run done
    return 0;
}
# Build & Run (F5 / Build>Run / toolbar): save -> compile -> run, on a worker.
func do_run() -> i64 {
    if load8(g_curpath) == 0 { ide_append_out(m_nofile); return 0; }
    if load64(g_compile_busy) == 1 { return 0; }
    do_save();
    ui_exedir(g_compiler_dir);
    ui_join(g_compiler_p, g_compiler_dir, s_compiler);
    ide_out_path();   # VS-style: output to <source-dir>\bin\<name>.exe (was: the Studio's own bin)
    c = str_copy(g_cmd, q); c = str_copy(c, g_compiler_p); c = str_copy(c, qspq);
    c = str_copy(c, g_curpath); c = str_copy(c, qspq); c = str_copy(c, g_out_p); str_copy(c, q);
    c2 = str_copy(g_runcmd, q); c2 = str_copy(c2, g_out_p); str_copy(c2, q);   # "<out>.exe"
    store64(g_compile_busy, 1);
    set_status(st_running);
    ide_append_out(m_run_build);
    CreateThread(0, 0, &run_worker, 0, 0, g_thr_id);
    return 0;
}

# VS-style output path: compile <dir>\foo.ancl into <dir>\bin\foo.exe (a `bin`
# folder NEXT TO the source, created on demand) -- NOT the Studio's own install dir.
# anclc writes the .asm listing next to the output, so foo.asm lands in bin\ too.
# Sets g_out_p to the full output path; g_bindir to <dir>\bin (created here).
func ide_out_path() -> i64 {
    # locate the last '\' in g_curpath -> end of the directory part
    last = 0 - 1; i = 0;
    while load8(g_curpath + i) != 0 {
        if load8(g_curpath + i) == 92 { last = i; }     # '\'
        i = i + 1;
    }
    srclen = i;
    if last == 0 - 1 {                         # no directory part (defensive) -> fall back to the IDE bin
        ui_exedir(g_compiler_dir);
        ui_join(g_out_p, g_compiler_dir, s_ideout);
        return 0;
    }
    # g_bindir = <dir>\bin   (dir = g_curpath[0..last); '\' at `last` is the separator)
    j = 0;
    while j < last { store8(g_bindir + j, load8(g_curpath + j)); j = j + 1; }
    store8(g_bindir + j, 92);  j = j + 1;     # '\'
    store8(g_bindir + j, 98);  j = j + 1;     # 'b'
    store8(g_bindir + j, 105); j = j + 1;     # 'i'
    store8(g_bindir + j, 110); j = j + 1;     # 'n'
    store8(g_bindir + j, 0);
    CreateDirectoryA(g_bindir, 0);            # create it (harmless no-op if it already exists)
    # g_out_p = <dir>\bin\<basename-without-ext>.exe
    k = 0;
    while load8(g_bindir + k) != 0 { store8(g_out_p + k, load8(g_bindir + k)); k = k + 1; }
    store8(g_out_p + k, 92); k = k + 1;       # '\'
    bstart = last + 1;
    # find the last '.' in the basename (strip the extension; keep a leading-dot name intact)
    dotpos = 0 - 1; m = bstart;
    while m < srclen { if load8(g_curpath + m) == 46 { dotpos = m; } m = m + 1; }   # '.'
    bend = srclen;
    if dotpos != 0 - 1 { if dotpos > bstart { bend = dotpos; } }
    m = bstart;
    while m < bend { store8(g_out_p + k, load8(g_curpath + m)); k = k + 1; m = m + 1; }
    store8(g_out_p + k, 46);  k = k + 1;      # '.'
    store8(g_out_p + k, 101); k = k + 1;      # 'e'
    store8(g_out_p + k, 120); k = k + 1;      # 'x'
    store8(g_out_p + k, 101); k = k + 1;      # 'e'
    store8(g_out_p + k, 0);
    # .asm paths for the post-compile relocation: anclc writes <bindir>\<name>.asm
    # (next to the .exe); we move it to <source-dir>\<name>.asm (next to the .ancl).
    n = 0; while n < k { store8(g_asm_bin + n, load8(g_out_p + n)); n = n + 1; }     # copy "<bindir>\<name>.exe"
    store8(g_asm_bin + k - 3, 97); store8(g_asm_bin + k - 2, 115); store8(g_asm_bin + k - 1, 109);   # "exe" -> "asm"
    store8(g_asm_bin + k, 0);
    a = 0;
    while a < last { store8(g_asm_src + a, load8(g_curpath + a)); a = a + 1; }        # <source-dir>
    store8(g_asm_src + a, 92); a = a + 1;     # '\'
    m2 = bstart;
    while m2 < bend { store8(g_asm_src + a, load8(g_curpath + m2)); a = a + 1; m2 = m2 + 1; }   # <name>
    store8(g_asm_src + a, 46);  a = a + 1;    # '.'
    store8(g_asm_src + a, 97);  a = a + 1;    # 'a'
    store8(g_asm_src + a, 115); a = a + 1;    # 's'
    store8(g_asm_src + a, 109); a = a + 1;    # 'm'
    store8(g_asm_src + a, 0);
    return 0;
}

# After a compile, move the .asm listing out of bin to sit next to the source
# (.exe stays in bin, .asm beside the .ancl). Harmless no-op if anclc wrote none.
func ide_move_asm() -> i64 {
    MoveFileExA(g_asm_bin, g_asm_src, 1);     # MOVEFILE_REPLACE_EXISTING: overwrite any stale listing
    return 0;
}

func ide_compile_current() -> i64 {
    if load8(g_curpath) == 0 { ide_append_out(m_nofile); return 0; }
    if load64(g_compile_busy) == 1 { return 0; }
    do_save();
    ui_exedir(g_compiler_dir);
    ui_join(g_compiler_p, g_compiler_dir, s_compiler);
    ide_out_path();   # VS-style: output to <source-dir>\bin\<name>.exe (was: the Studio's own bin)
    c = str_copy(g_cmd, q);
    c = str_copy(c, g_compiler_p);
    c = str_copy(c, qspq);
    c = str_copy(c, g_curpath);
    c = str_copy(c, qspq);
    c = str_copy(c, g_out_p);
    str_copy(c, q);
    store64(g_compile_busy, 1);
    set_status(st_compiling);
    ide_append_out(m_compiling);
    CreateThread(0, 0, &compile_worker, 0, 0, g_thr_id);
    return 0;
}

# M5b slice 2: turn the up-to-caret prefix in `b` (in place) into a PARSEABLE program so the
# op-seq ENDS at the caret's context (not end-of-file). Steps: normalize CR->LF; drop a half-typed
# trailing token by truncating to the last statement boundary (; { }); then auto-balance the open
# braces/parens. Per OPSEQ_SPEC, closing braces emit NO ops (blocks are COUNT-prefixed), so the
# appended closes do not pollute the op-prefix -- it stops exactly at the last complete statement.
# String literals and '#' comments are skipped so their braces/parens never miscount. Returns the
# new length (NUL-terminated), or 0 if there is nothing usable.
func ide_ctx_prepare(b: i64) -> i64 {
    i = 0;
    while load8(b + i) != 0 { if load8(b + i) == 13 { store8(b + i, 10); } i = i + 1; }
    total = i;
    # pass 1: find the index AFTER the last real statement boundary
    i = 0; lastb = 0 - 1; instr = 0;
    while i < total {
        c = load8(b + i);
        if instr != 0 {
            if c == 92 { i = i + 2; continue; }                 # backslash -> skip escaped char
            if c == 34 { instr = 0; }
            i = i + 1; continue;
        }
        if c == 34 { instr = 1; i = i + 1; continue; }          # "
        if c == 35 { while i < total { if load8(b + i) == 10 { break; } i = i + 1; } continue; }   # # comment
        if c == 123 { lastb = i + 1; }                          # {
        if c == 125 { lastb = i + 1; }                          # }
        if c == 59  { lastb = i + 1; }                          # ;
        i = i + 1;
    }
    if lastb < 0 { lastb = total; }
    end = lastb;
    # pass 2: count unmatched braces/parens up to `end` (same string/comment skipping)
    i = 0; brace = 0; paren = 0; instr = 0;
    while i < end {
        c = load8(b + i);
        if instr != 0 {
            if c == 92 { i = i + 2; continue; }
            if c == 34 { instr = 0; }
            i = i + 1; continue;
        }
        if c == 34 { instr = 1; i = i + 1; continue; }
        if c == 35 { while i < end { if load8(b + i) == 10 { break; } i = i + 1; } continue; }
        if c == 123 { brace = brace + 1; }
        if c == 125 { brace = brace - 1; }
        if c == 40  { paren = paren + 1; }
        if c == 41  { paren = paren - 1; }
        i = i + 1;
    }
    j = end;
    store8(b + j, 10); j = j + 1;                               # newline before the closes
    while paren > 0 { store8(b + j, 41); j = j + 1; paren = paren - 1; }    # )
    while brace > 0 { store8(b + j, 125); j = j + 1; brace = brace - 1; }   # }
    store8(b + j, 10); j = j + 1;
    store8(b + j, 0);
    return j;
}

# M5b slice 2: dump the op-seq for the editor text UP TO THE CARET into g_sug_ops, so completion is
# contextual to the caret rather than end-of-file. EM_GETTEXTRANGE copies [0,caret) WITHOUT touching
# the user's selection. Returns 1 if a caret-context .ops was written, 0 to signal whole-file fallback
# (no caret, too little context, write failed, or the balanced prefix did not parse).
func ide_caret_dump() -> i64 {
    he = load64(gui_editor);
    if he == 0 { return 0; }
    SendMessageA(he, 0x434, 0, g_sug_cr);                       # EM_EXGETSEL -> cpMax@4 = caret (RichEdit CHAR index)
    caret = load32(g_sug_cr + 4);
    if caret < 8 { return 0; }                                  # too little context -> whole file
    # WM_GETTEXT gives ANSI text (the proven path; EM_GETTEXTRANGE returns UTF-16 on this wide control).
    SendMessageA(he, 13, 1048575, g_ctxbuf);
    # map the caret char-index to a BYTE offset: RichEdit counts a line break as 1 char, but the
    # WM_GETTEXT buffer may hold it as \r\n (2 bytes). Walk both gracefully.
    bi = 0; ci = 0;
    while ci < caret {
        ch = load8(g_ctxbuf + bi);
        if ch == 0 { break; }
        if ch == 13 {
            bi = bi + 1;
            if load8(g_ctxbuf + bi) == 10 { bi = bi + 1; }
            ci = ci + 1;
        } else {
            bi = bi + 1; ci = ci + 1;
        }
    }
    store8(g_ctxbuf + bi, 0);                                   # truncate at the caret
    m = ide_ctx_prepare(g_ctxbuf);
    if m <= 0 { return 0; }
    ui_join(g_ctxpath, g_compiler_dir, s_ctxname);              # <bin>\_suggest_ctx.ancl
    if ui_write_file(g_ctxpath, g_ctxbuf, m) == 0 { return 0; }
    ui_write_file(g_sug_ops, g_ctxpath, 0);                     # pre-truncate the .ops -> a clean fallback signal
    c = str_copy(g_cmd, q);
    c = str_copy(c, g_compiler_p); c = str_copy(c, qspq);
    c = str_copy(c, g_ctxpath);    c = str_copy(c, qspq);
    c = str_copy(c, g_sug_ops);    c = str_copy(c, q);
    str_copy(c, s_dumpops);
    ide_run_capture(g_cmd, g_capbuf, 262144);
    nck = ui_read_file(g_sug_ops, g_capbuf, 262144);            # a real dump writes a multi-line .ops;
    if nck < 40 { return 0; }                                   # ...a parse failure leaves it empty -> fallback
    return 1;
}

# M5b: AI-native completion (Ctrl+Space). Build an op-seq for the editor (caret-scoped if possible,
# else the whole file) via the compiler's --dump-ops, then run complete.exe (the op-brain) to predict
# + materialize the next structure into ANCL suggestions, shown in the Output pane. Shells out
# (Studio's existing pattern) so the brain stays out of the IDE process. Scaling = M4 (K17).
func ide_suggest() -> i64 {
    if load8(g_curpath) == 0 { ide_append_out(m_nofile); return 0; }
    do_save();                                            # the file on disk == the editor
    ui_exedir(g_compiler_dir);
    ui_join(g_compiler_p, g_compiler_dir, s_compiler);    # ancl_compiler.exe
    ui_join(g_sug_exe, g_compiler_dir, s_completeexe);    # complete.exe
    ui_join(g_sug_ops, g_compiler_dir, s_opsname);        # <bin>\_suggest.ops
    # op-brain ROUTING: protocol code (sockets/byte-packing) -> the protocol specialist op-brain,
    # which beats the general coding brain on this domain (builtin TOP-1 5.7->52.8). Signal = a
    # ws2_32 socket extern anywhere in the buffer.
    proto = 0;
    he = load64(gui_editor);
    if he != 0 {
        SendMessageA(he, 13, 1048575, ide_rich_raw);       # WM_GETTEXT -> ide_rich_raw
        if ancl_strstr_ci(ide_rich_raw, s_ws2marker, 0) >= 0 { proto = 1; }
    }
    # 1) op-seq: prefer the up-to-caret context; fall back to the whole file.
    if ide_caret_dump() == 0 {
        c = str_copy(g_cmd, q);
        c = str_copy(c, g_compiler_p); c = str_copy(c, qspq);
        c = str_copy(c, g_curpath);    c = str_copy(c, qspq);
        c = str_copy(c, g_sug_ops);    c = str_copy(c, q);
        str_copy(c, s_dumpops);
        ide_run_capture(g_cmd, g_capbuf, 262144);         # .ops written (stdout = the dump line, ignored)
    }
    # 2) "complete.exe" "ops" ["model.dna"]  -> materialized suggestions
    c = str_copy(g_cmd, q);
    c = str_copy(c, g_sug_exe); c = str_copy(c, qspq);
    c = str_copy(c, g_sug_ops);
    if proto == 1 { c = str_copy(c, qspq); c = str_copy(c, s_protomodel); }   # argv[2] = protocol brain
    str_copy(c, q);
    ide_run_capture(g_cmd, g_capbuf, 262144);
    ide_append_out(m_sug_hdr);
    if proto == 1 { ide_append_out(m_brain_proto); } else { ide_append_out(m_brain_code); }
    ide_append_out(g_capbuf);                             # "suggest: ..." lines (or "complete: load failed")
    comp_open(g_capbuf);                                  # M5b: float the suggestions in a popup at the caret
    set_status(st_suggest);
    return 0;
}

# IF2: find the "# @INTENT / # goal:" line in `src` -> copy the goal text into `out` (NUL-term).
# Returns the length, or 0 if not found / empty / still the "(describe..." placeholder.
func find_goal(src: i64, out: i64) -> i64 {
    i = 0;
    while load8(src + i) != 0 {
        if load8(src + i) == 35 { if load8(src + i + 1) == 32 {
          if load8(src + i + 2) == 103 { if load8(src + i + 3) == 111 { if load8(src + i + 4) == 97 {
          if load8(src + i + 5) == 108 { if load8(src + i + 6) == 58 {          # "# goal:"
            p = i + 7;
            while load8(src + p) == 32 { p = p + 1; }                            # skip spaces
            qn = 0;
            while load8(src + p) != 0 {
                c = load8(src + p);
                if c == 13 { break; } if c == 10 { break; }
                store8(out + qn, c); qn = qn + 1; p = p + 1;
            }
            store8(out + qn, 0);
            if qn == 0 { return 0; }
            if load8(out) == 40 { return 0; }                                    # '(' = placeholder, treat as empty
            return qn;
          } } } } } } }
        i = i + 1;
    }
    return 0;
}

# Load the proven starter (g_starter_p, already built) into a NEW TAB named "<proto>_client.ancl"
# in the workspace -- used when the editor already has code, so we deliver the starter WITHOUT
# clobbering the user's file. The new tab is workspace-pathed (NOT the canonical starter), so a
# later Save never overwrites core_lib/starters. Returns 1 on success.
func ide_starter_newtab() -> i64 {
    nm = str_copy(g_starter_nm, s_bs1);                        # leading "\" (ui_join concatenates verbatim)
    nm = str_copy(nm, g_protoname);
    str_copy(nm, s_client_suf);                                # "\<proto>_client.ancl"
    store64(g_loading, 1);
    tab_stash_current();                                       # preserve the user's current tab
    if ui_load_file_to_edit(g_starter_p, load64(gui_editor)) == 0 { store64(g_loading, 0); return 0; }
    ide_recolor();
    ui_join(g_curpath, g_workspace, g_starter_nm);             # fresh workspace file, not the canonical starter
    ide_set_current(g_curpath);
    update_lincol();
    tab_register(g_curpath);                                   # register as a new active tab
    PostMessageA(load64(gui_hwnd), 0x8006, 0, 0);              # clear g_loading after the load's EN_CHANGE drains
    set_status(st_starter);
    return 1;
}

# IF2: "Plan from Intent" (Ctrl+Shift+I) -- read the @INTENT goal from the editor, run the
# router (intent_plan.exe) and show the plan (route + suggested template + @INTENT block) in Output.
# Shared: after a tool (intent_plan.exe / frame_id.exe) has written its output
# into g_capbuf, look for "protocol=<p>" and load starters/<p>_client.ancl --
# in place on an empty-ish editor, or in a NEW TAB when the editor already has
# real code (never clobbers). Returns 1 if a starter was loaded, else 0.
func ide_load_starter_from_capbuf() -> i64 {
    ppos = ancl_strstr_ci(g_capbuf, s_protoeq, 0);
    if ppos < 0 { return 0; }
    j = ppos + strlen(s_protoeq);                          # parse the protocol name from "protocol=<p>"
    k = 0;
    while load8(g_capbuf + j) != 0 {
        cc = load8(g_capbuf + j);
        if cc == 13 { break; }
        if cc == 10 { break; }
        store8(g_protoname + k, cc); k = k + 1; j = j + 1;
    }
    store8(g_protoname + k, 0);
    if k == 0 { return 0; }
    e = str_copy(g_starter_p, g_app_root);                 # <app_root>\starters\<proto>_client.ancl
    e = str_copy(e, s_starters);
    e = str_copy(e, g_protoname);
    str_copy(e, s_client_suf);
    hascode = 0;
    if contains_ci(ide_rich_raw, s_func_kw) == 1 { hascode = 1; }
    if contains_ci(ide_rich_raw, s_atcode_kw) == 1 { hascode = 1; }
    if hascode == 0 {                                      # empty editor -> load in place (stays untitled, no clobber)
        if ui_load_file_to_edit(g_starter_p, load64(gui_editor)) == 1 {
            ide_recolor();
            update_lincol();
            set_status(st_starter);
            return 1;
        }
    } else {                                               # editor has code -> open the starter in a NEW TAB
        if ide_starter_newtab() == 1 { return 1; }
    }
    return 0;
}

# FRAME-ID (Ctrl+Shift+F): take the captured-frame HEX bytes the user pasted
# into the editor, run the learned frame->protocol brain (frame_id.exe), show
# the verdict in Output, and load the matching starter client -- "I sniffed
# this traffic, what is it? -> here's a compile-ready tester." Reuses the exact
# starter-load path as Plan-from-Intent, so the brain and the keyword router
# feed one machinery.
func ide_frame_id() -> i64 {
    he = load64(gui_editor);
    if he == 0 { return 0; }
    SendMessageA(he, 13, 1048575, ide_rich_raw);          # WM_GETTEXT editor -> ide_rich_raw (the hex)
    # first line / up to 500 chars as the hex arg (quotes -> spaces so the quoted arg stays intact)
    si = 0; di = 0;
    while load8(ide_rich_raw + si) != 0 {
        c = load8(ide_rich_raw + si);
        if c == 13 { break; }
        if c == 10 { break; }
        if di >= 500 { break; }
        if c == 34 { c = 32; }
        store8(g_hexarg + di, c); di = di + 1;
        si = si + 1;
    }
    store8(g_hexarg + di, 0);
    if di == 0 { set_status(st_frame_none); return 0; }
    ui_exedir(g_compiler_dir);
    ui_join(g_frameid_p, g_compiler_dir, s_frameidexe);   # <bin>\frame_id.exe
    c = str_copy(g_cmd, q);
    c = str_copy(c, g_frameid_p); c = str_copy(c, qspq);
    c = str_copy(c, g_hexarg);    str_copy(c, q);
    ide_run_capture(g_cmd, g_capbuf, 262144);
    ide_append_out(m_frameid_hdr);
    ide_append_out(g_capbuf);                             # "protocol=<p>" + the "# frame-id: <NAME> @NN%" line
    if ide_load_starter_from_capbuf() == 1 { return 0; }
    set_status(st_frame_none);
    return 0;
}

# ANOMALY-CHECK (Ctrl+Shift+A): run the edge-IDS anomaly brain (anomaly_check.exe)
# on the captured-frame HEX the user pasted -> "normal / ANOMALY + why" in Output.
# The Studio counterpart to the Workbench's live per-frame monitor.
func ide_anomaly_check() -> i64 {
    he = load64(gui_editor);
    if he == 0 { return 0; }
    SendMessageA(he, 13, 1048575, ide_rich_raw);          # WM_GETTEXT editor -> ide_rich_raw (the hex)
    si = 0; di = 0;
    while load8(ide_rich_raw + si) != 0 {
        c = load8(ide_rich_raw + si);
        if c == 13 { break; }
        if c == 10 { break; }
        if di >= 500 { break; }
        if c == 34 { c = 32; }
        store8(g_hexarg + di, c); di = di + 1;
        si = si + 1;
    }
    store8(g_hexarg + di, 0);
    if di == 0 { set_status(st_frame_none); return 0; }
    ui_exedir(g_compiler_dir);
    ui_join(g_anom_p, g_compiler_dir, s_anomexe);         # <bin>\anomaly_check.exe
    c = str_copy(g_cmd, q);
    c = str_copy(c, g_anom_p); c = str_copy(c, qspq);
    c = str_copy(c, g_hexarg); str_copy(c, q);
    ide_run_capture(g_cmd, g_capbuf, 262144);
    ide_append_out(m_anom_hdr);
    ide_append_out(g_capbuf);                             # "normal/ANOMALY @NN% [why] proto=.. op=.. addr=.."
    return 0;
}

func ide_intent_plan() -> i64 {
    he = load64(gui_editor);
    if he == 0 { return 0; }
    SendMessageA(he, 13, 1048575, ide_rich_raw);          # WM_GETTEXT -> ide_rich_raw
    g = find_goal(ide_rich_raw, g_goalbuf);
    if g == 0 { set_status(st_nogoal); return 0; }
    ui_exedir(g_compiler_dir);
    ui_join(g_intent_p, g_compiler_dir, s_intentexe);     # intent_plan.exe
    c = str_copy(g_cmd, q);
    c = str_copy(c, g_intent_p); c = str_copy(c, qspq);
    c = str_copy(c, g_goalbuf);  str_copy(c, q);
    ide_run_capture(g_cmd, g_capbuf, 262144);
    ide_append_out(m_plan_hdr);
    ide_append_out(g_capbuf);                             # template=... + the @INTENT block
    # IF3b: a PROTOCOL intent on an EMPTY-ish editor -> load the proven per-protocol starter
    # client (deterministic, zero-dep, offline) instead of the LLM path.
    if ide_load_starter_from_capbuf() == 1 { return 0; }   # starter loaded -> done, skip the LLM preload
    # IF3: pre-load the Aether Agent with a generation prompt from the goal (one-click Send -> LLM
    # implements, compiler-verified). Turns the plan into a concrete next action.
    ap = str_copy(g_agentprompt, s_agent_pre);
    str_copy(ap, g_goalbuf);
    SetWindowTextA(load64(gui_chat_in), g_agentprompt);
    ide_append_out(m_plan_next);
    set_status(st_planned);
    return 0;
}

# Parse the leading count from the smart compiler's report line
# "anclc --fix: N fix(es) ..." -> N (0 if no count / no report).
func fix_count(buf: i64) -> i64 {
    i = 0;
    while load8(buf + i) != 0 {
        if load8(buf + i) == 58 {                     # ':'
            if load8(buf + i + 1) == 32 {             # followed by a space
                p = i + 2; num = 0; got = 0; going = 1;
                while going == 1 {
                    ch = load8(buf + p);
                    if ch < 48 { going = 0; }
                    if ch > 57 { going = 0; }
                    if going == 1 { num = num * 10 + (ch - 48); p = p + 1; got = 1; }
                }
                if got == 1 { return num; }            # first "<digits>" after a ": " = the count
            }
        }
        i = i + 1;
    }
    return 0;
}

# #2: append one (broken -> error -> fix) triple to <workspace>\errfix_log.txt. `label` is the
# error/report buffer (NUL-term); broken_path/fix_path are read from disk. Big content streams
# straight from the read buffer (g_ctxbuf) so no giant record buffer is assembled. Best-effort: a
# missing file or write failure is silently skipped (logging must never disrupt the editor).
func ide_log_errfix(kind: i64, label: i64, broken_path: i64, fix_path: i64) -> i64 {
    ui_join(g_logpath, g_workspace, s_logname);            # <workspace>\errfix_log.txt
    p = str_copy(g_logrec, lr_hdr);
    p = str_copy(p, kind);
    p = str_copy(p, lr_src);
    p = str_copy(p, fix_path);
    p = str_copy(p, lr_err);
    ui_append_file(g_logpath, g_logrec, p - g_logrec);
    ln = 0;
    while load8(label + ln) != 0 { ln = ln + 1; }
    ui_append_file(g_logpath, label, ln);
    p = str_copy(g_logrec, lr_broken);
    ui_append_file(g_logpath, g_logrec, p - g_logrec);
    nb = ui_read_file(broken_path, g_ctxbuf, 1048576);
    if nb > 0 { ui_append_file(g_logpath, g_ctxbuf, nb); }
    p = str_copy(g_logrec, lr_fix);
    ui_append_file(g_logpath, g_logrec, p - g_logrec);
    nf = ui_read_file(fix_path, g_ctxbuf, 1048576);
    if nf > 0 { ui_append_file(g_logpath, g_ctxbuf, nf); }
    p = str_copy(g_logrec, lr_end);
    ui_append_file(g_logpath, g_logrec, p - g_logrec);
    return 0;
}

# Apply the smart compiler's fixes to the current file (`--fix --write`, which
# keeps a <file>.bak) and reload the healed source into the editor.
func fix_apply_now() -> i64 {
    ui_exedir(g_compiler_dir);
    ui_join(g_compiler_p, g_compiler_dir, s_compiler);
    c2 = str_copy(g_cmd, q); c2 = str_copy(c2, g_compiler_p);
    c2 = str_copy(c2, s_fix_apply); c2 = str_copy(c2, g_curpath); str_copy(c2, q);
    ide_run_capture(g_cmd, g_capbuf, 262144);
    ide_append_out(g_capbuf);                          # "N fix(es) APPLIED; original saved as <file>.bak"
    bp = str_copy(g_repair_bak, g_curpath); str_copy(bp, s_bak_ext);   # the .bak --fix --write just wrote
    ide_log_errfix(k_autofix, g_capbuf, g_repair_bak, g_curpath);      # #2: log the mechanical triple
    store64(g_loading, 1);                             # programmatic reload -> don't mark the tab dirty
    ui_load_file_to_edit(g_curpath, load64(gui_editor));
    ide_recolor();
    PostMessageA(load64(gui_hwnd), 0x8006, 0, 0);      # clear g_loading once the reload's EN_CHANGE drains
    set_status(st_fixed);
    return 0;
}
# ---- SC1: mechanical auto-fix via the self-correcting compiler ----------
# Save the editor, run `ancl_compiler.exe --fix` (dry run) to show the proposed
# fixes, and on confirmation apply them (`--fix --write`, keeping a .bak) and
# reload the healed source.  Deterministic + offline -- no AI involved.
func do_fix_current() -> i64 {
    if load8(g_curpath) == 0 { ide_append_out(m_nofile); return 0; }
    if load64(g_compile_busy) == 1 { return 0; }
    store64(g_compile_busy, 1);                        # guard re-entrancy across the modal confirm
    do_save();                                         # flush the editor to disk first
    ui_exedir(g_compiler_dir);
    ui_join(g_compiler_p, g_compiler_dir, s_compiler);
    # "<compiler>" --fix "<src>"   (dry run -- reports, writes nothing)
    c = str_copy(g_cmd, q);
    c = str_copy(c, g_compiler_p);
    c = str_copy(c, s_fix_dry);
    c = str_copy(c, g_curpath);
    str_copy(c, q);
    set_status(st_fixing);
    ide_append_out(m_fixing);
    ide_run_capture(g_cmd, g_capbuf, 262144);
    ide_append_out(g_capbuf);                          # the dry-run report (count + per-line fixes)
    cnt = fix_count(g_capbuf);
    if cnt <= 0 {
        ide_append_out(m_fix_none);
        set_status(st_fixnone);
        store64(g_compile_busy, 0);
        return 0;
    }
    # Confirm (with the count) before touching the file -- auto-yes under the test hook.
    proceed = 0;
    if GetEnvironmentVariableA(env_fixtest, g_envbuf, 8) > 0 {
        proceed = 1;
    } else {
        e = str_copy(g_fix_msg, fix_q_a);
        int_to_str(g_fix_num, cnt); e = str_copy(e, g_fix_num);
        str_copy(e, fix_q_b);
        if MessageBoxA(load64(gui_hwnd), g_fix_msg, fix_q_title, 0x24) == 6 { proceed = 1; }   # MB_YESNO|MB_ICONQUESTION, IDYES==6
    }
    if proceed == 0 {
        ide_append_out(m_fix_cancel);
        set_status(st_done);
        store64(g_compile_busy, 0);
        return 0;
    }
    fix_apply_now();                                   # --fix --write (keeps .bak) + reload the healed source
    store64(g_compile_busy, 0);
    return 0;
}

# ---- SC2: AI repair -- hand the live compiler errors to the agent ---------
# Compile g_curpath; if it FAILS, assemble the model-facing repair turn
# (path + bounded errors + instruction) into g_agent_input and return 1.
# Returns 0 if the file already compiles.  (Split out so the headless probe
# can assert the new logic without spinning the LLM.)
func repair_prepare() -> i64 {
    ui_exedir(g_compiler_dir);
    ui_join(g_compiler_p, g_compiler_dir, s_compiler);
    ide_out_path();   # VS-style: output to <source-dir>\bin\<name>.exe (was: the Studio's own bin)
    c = str_copy(g_cmd, q); c = str_copy(c, g_compiler_p); c = str_copy(c, qspq);
    c = str_copy(c, g_curpath); c = str_copy(c, qspq); c = str_copy(c, g_out_p); str_copy(c, q);
    ide_run_capture(g_cmd, g_capbuf, 262144);          # capture the compiler errors
    if load32(cap_exit) == 0 { return 0; }             # builds clean -> nothing to repair
    e = str_copy(g_agent_input, rep_pre);
    e = str_copy(e, g_curpath);
    e = str_copy(e, rep_mid);
    e = expl_append(e, g_capbuf, 16000);               # bounded error text
    str_copy(e, rep_post);
    return 1;
}
# Compile the current file; if it fails, run the agentic loop on the assembled
# repair turn -- the agent read_file -> fixes -> write_file, which lands in the
# existing preview/apply path (WM_APP+4 -> type 'apply').
func do_ai_repair() -> i64 {
    if load64(g_agent_busy) == 1 { return 0; }
    if load64(g_compile_busy) == 1 { return 0; }
    if load8(g_curpath) == 0 { ide_append_out(m_nofile); return 0; }
    do_save();
    if repair_prepare() == 0 {                         # already builds clean -> nothing to repair
        ide_append_out(m_rep_clean);
        set_status(st_done);
        return 0;
    }
    # Back up the source before the agent rewrites it -- a bad model patch must not lose your code.
    e = str_copy(g_repair_bak, g_curpath); str_copy(e, s_bak_ext);   # <file>.bak
    CopyFileA(g_curpath, g_repair_bak, 0);             # 0 = overwrite any stale .bak
    ide_append_out(m_rep_bak); ide_append_out(g_repair_bak); ide_append_out(nl_crlf);
    re = expl_append(g_repair_err, g_capbuf, 16000); store8(re, 0);   # #2: stash the live compiler errors
    store64(g_repair_pending, 1);                                     # ...log the full triple when applied
    ide_append_out(m_rep_start);
    ag_echo_user(rep_echo);                            # transcript shows the intent
    store64(g_agent_busy, 1);
    store64(g_agent_done, 0);
    store64(g_suppress_tools, 0);                      # repair NEEDS read_file / write_file
    store64(g_chat_mode, 0);                           # repair is a coding op -> full agent, overrides the toggle
    InvalidateRect(load64(gui_badge), 0, 1);
    set_status(st_repair);
    chat_refresh();
    if load64(set_backend) == 2 {                      # Anthropic single-shot: no tool loop -> explains the fix
        str_copy(g_user_msg, g_agent_input);
        CreateThread(0, 0, &agent_single_thread, 0, 0, g_agent_thr);
    } else {
        CreateThread(0, 0, &agent_thread, 0, 0, g_agent_thr);
    }
    return 0;
}

# Build failed -> show a NON-MODAL red hint in the output pane (never blocks the
# editor). If the smart compiler can mechanically heal it, the hint says how many
# fixes are a click away; otherwise it points at AI Repair. The user applies via
# the Fix button / Build>Auto-Fix / typing 'fix' -- this only flags the option.
func offer_autofix() -> i64 {
    if load8(g_curpath) == 0 { return 0; }
    ui_exedir(g_compiler_dir);
    ui_join(g_compiler_p, g_compiler_dir, s_compiler);
    c = str_copy(g_cmd, q); c = str_copy(c, g_compiler_p);
    c = str_copy(c, s_fix_dry); c = str_copy(c, g_curpath); str_copy(c, q);
    ide_run_capture(g_cmd, g_capbuf, 262144);          # silent dry run (the error output was already shown)
    cnt = fix_count(g_capbuf);
    if cnt <= 0 { ide_append_out_red(m_autofix_hint); return 0; }   # not mechanical -> red AI-repair pointer
    e = str_copy(g_fix_msg, autofix_h_a); int_to_str(g_fix_num, cnt); e = str_copy(e, g_fix_num); str_copy(e, autofix_h_b);
    ide_append_out_red(g_fix_msg);                     # red, attention-grabbing, non-blocking
    return 0;
}

# Scan compiler output for "line N" and select + scroll to that line in the editor.
# No-op when there's no "line N" (e.g. a successful build). Line numbers are 1-based.
func ide_jump_error(buf: i64) -> i64 {
    i = 0; n1 = 0; scanning = 1;
    while scanning == 1 {
        c0 = load8(buf + i);
        if c0 == 0 { scanning = 0; }
        if scanning == 1 {
            if c0 == 108 { if load8(buf+i+1) == 105 { if load8(buf+i+2) == 110 { if load8(buf+i+3) == 101 { if load8(buf+i+4) == 32 {
                p = i + 5; num = 0; got = 0; going = 1;          # parse the digits after "line "
                while going == 1 {
                    ch = load8(buf + p);
                    if ch < 48 { going = 0; }
                    if ch > 57 { going = 0; }
                    if going == 1 { num = num * 10 + (ch - 48); p = p + 1; got = 1; }
                }
                if got == 1 { n1 = num; scanning = 0; }
            } } } } }
            i = i + 1;
        }
    }
    if n1 <= 0 { return 0; }
    ed = load64(gui_editor);
    if ed == 0 { return 0; }
    start = SendMessageA(ed, 0xBB, n1 - 1, 0);          # EM_LINEINDEX (0-based line -> char offset)
    if start < 0 { return 0; }
    len = SendMessageA(ed, 0xC1, start, 0);             # EM_LINELENGTH
    SendMessageA(ed, 0xB1, start, start + len);         # EM_SETSEL -> select the whole error line
    SendMessageA(ed, 0xB7, 0, 0);                       # EM_SCROLLCARET -> bring it into view
    return 0;
}

# Worker thread: blocking HTTPS round-trip to Claude, then hand back to UI.
func ai_worker(param: i64) -> i64 {
    ai_request(g_ai_prompt, g_ai_out);
    PostMessageA(load64(gui_hwnd), 0x8002, 0, 0);          # WM_APP+2: AI reply ready
    return 0;
}

# Ask AI: read the key from the environment, send the editor as context.
func do_ask_ai() -> i64 {
    if load64(g_ai_busy) == 1 { return 0; }
    k = GetEnvironmentVariableA(env_apikey, ai_key, 512);   # ai_key lives in ai_bridge.ancl
    if k == 0 { set_status(st_nokey); return 0; }
    SendMessageA(load64(gui_editor), 13, 65535, g_ai_editbuf);   # WM_GETTEXT (capped context)
    e = str_copy(g_ai_prompt, ai_instr);
    str_copy(e, g_ai_editbuf);
    store64(g_ai_busy, 1);
    set_status(st_asking);
    CreateThread(0, 0, &ai_worker, 0, 0, g_ai_thr);
    return 0;
}

# ---- Phase 1: Local Brain (ANCL) autocomplete backend (offline) ----------
# Lazy-load a self-describing (ABRN) brain file placed beside the IDE exe.
func ide_brain_load() -> i64 {
    if load64(g_brain_loaded) == 1 { return 1; }
    ui_exedir(g_brain_dir);
    ui_join(g_brain_path, g_brain_dir, brain_file);
    if bc_init(g_brain_path) == 0 { return 0; }
    store64(g_brain_loaded, 1);
    return 1;
}

# Lazy-load the TOKEN brain (vocab + TBRN) placed beside the IDE exe.
# Returns 1 if the token brain is available, else 0 (caller falls back to the byte brain).
# A "2" sentinel means "probed once, absent" so we don't hit the disk every keystroke.
func ide_tok_load() -> i64 {
    if load64(g_tok_loaded) == 1 { return 1; }
    if load64(g_tok_loaded) == 2 { return 0; }
    ui_exedir(g_brain_dir);
    ui_join(g_tok_vocab_path, g_brain_dir, tok_vocab_file);
    ui_join(g_tok_brain_path, g_brain_dir, tok_brain_file);
    if tok_infer_load(g_tok_vocab_path, g_tok_brain_path) == 0 { store64(g_tok_loaded, 2); return 0; }
    store64(g_tok_loaded, 1);
    return 1;
}

# Complete the open file from the caret with the local brain; show it in chat.
# Prefers the TOKEN brain (ancl.avoc + ancl_token.dna) when deployed; otherwise
# falls back to the byte brain (aether_brain.dna). Pure in-memory f64 inference.
func ide_brain_complete_chat() -> i64 {
    use_tok = ide_tok_load();
    if use_tok == 0 {
        if ide_brain_load() == 0 { ag_assistant(brain_noload); chat_refresh(); return 0; }
    }
    SendMessageA(load64(gui_editor), 13, 65535, g_ai_editbuf);    # WM_GETTEXT (<=64KB context)
    SendMessageA(load64(gui_editor), 0x434, 0, g_lc_cr);          # EM_EXGETSEL -> CHARRANGE (cpMin@0)
    caret = load32(g_lc_cr);
    elen = strlen(g_ai_editbuf);
    if caret < 0 { caret = elen; }
    if caret > elen { caret = elen; }
    store8(g_ai_editbuf + caret, 0);                             # context = editor text up to the caret
    n = 0;
    if use_tok == 1 { n = tok_infer_complete(g_ai_editbuf, caret, g_brain_out, 2048, 40); }                 # token brain: 40 tokens
    if use_tok == 0 { n = bc_complete(g_ai_editbuf, caret, g_brain_out, 2048, 80, 800, GetTickCount()); }    # byte brain: 80 bytes, temp 0.8
    if n == 0 { ag_assistant(brain_empty); chat_refresh(); return 0; }
    ag_assistant(g_brain_out);
    chat_refresh();
    return 0;
}

# Windows-path equality: case-insensitive, / and \ interchangeable.
func path_eq(a: i64, b: i64) -> i64 {
    i = 0;
    while 1 {
        ca = load8(a + i);
        cb = load8(b + i);
        if ca == 47 { ca = 92; }
        if cb == 47 { cb = 92; }
        if ca >= 65 { if ca <= 90 { ca = ca + 32; } }
        if cb >= 65 { if cb <= 90 { cb = cb + 32; } }
        if ca != cb { return 0; }
        if ca == 0 { return 1; }
        i = i + 1;
    }
    return 0;
}

# --- Agent chat (M2): worker threads + send ------------------------
func chat_refresh() -> i64 {
    ui_lf_to_crlf(gui_chat_crlf, g_chat_log);            # RichEdit renders line breaks on CRLF
    so = load64(gui_chat_out);
    SendMessageA(so, 0x461, g_stex, gui_chat_crlf);      # EM_SETTEXTEX (CP_UTF8) -> correct high-byte/UTF-8 model output (no ANSI mojibake)
    memset(ide_cf, 0, 60);                               # color the whole transcript light
    store32(ide_cf + 0, 60); store32(ide_cf + 4, 0x40000000); store32(ide_cf + 20, TH_TEXT);
    SendMessageA(so, 177, 0, 0 - 1);                     # EM_SETSEL all
    SendMessageA(so, 0x444, 1, ide_cf);                  # EM_SETCHARFORMAT SCF_SELECTION
    SendMessageA(so, 177, 0x7FFFFFFF, 0x7FFFFFFF);       # EM_SETSEL -> end
    SendMessageA(so, 183, 0, 0);                         # EM_SCROLLCARET
    SendMessageA(so, 0x115, 7, 0);                       # WM_VSCROLL SB_BOTTOM -> force the newest reply into view
    return 0;
}
func agent_thread(param: i64) -> i64 {
    agent_run_gui(g_agent_input);                        # context-injected turn (open file path + contents)
    return 0;
}
func agent_single_thread(param: i64) -> i64 {
    if GetEnvironmentVariableA(env_apikey, ai_key, 512) == 0 {
        ag_assistant(st_nokey);
    } else {
        if load64(g_has_image) == 1 {                # attach the image to the Anthropic request
            store64(ai_img_b64, g_img_b64);
            store64(ai_img_mime, g_img_mime);
            store64(g_has_image, 0);                 # one-shot (matches the Ollama/OpenAI path)
        }
        e = str_copy(g_agent_input, sys_prompt);     # teach Claude/Anthropic the ANCL language (the agentic
        e = str_copy(e, sys_notools);                # backends already get this primer; single-shot has no tools
        e = str_copy(e, sys_sep);
        str_copy(e, g_user_msg);
        ai_request(g_agent_input, g_ai_out);
        ag_assistant(g_ai_out);
    }
    return 0;
}
func do_stop_agent() -> i64 {
    if load64(g_agent_busy) == 0 { return 0; }
    store64(g_agent_cancel, 1);
    ol_abort();                                          # abort the blocked WinHttp call
    set_status(st_stopping);
    return 0;
}
func is_ws(c: i64) -> i64 {                  # space / tab / LF / CR
    if c == 32 { return 1; }
    if c == 9  { return 1; }
    if c == 10 { return 1; }
    if c == 13 { return 1; }
    return 0;
}
# case-insensitive equality of `s` to NUL-term `lit`, ignoring leading/trailing whitespace.
# (the chat input is a multiline EDIT -> pressing Enter yields "apply\r\n"; tolerate that.)
func cmd_is(s: i64, lit: i64) -> i64 {
    while is_ws(load8(s)) == 1 { s = s + 1; }
    j = 0;
    while load8(lit + j) != 0 {
        c = load8(s + j); if c >= 65 { if c <= 90 { c = c + 32; } }   # tolower
        if c != load8(lit + j) { return 0; }
        j = j + 1;
    }
    t = s + j;
    while is_ws(load8(t)) == 1 { t = t + 1; }                          # tolerate trailing ws incl. CR/LF
    if load8(t) == 0 { return 1; }
    return 0;
}

# Help > User Guide: open the bundled guide.html in the default browser.
func do_open_guide() -> i64 {
    ui_join(g_guide_p, g_app_root, s_guide);                  # ...\aether_studio_dist\guide.html
    rv = ShellExecuteA(load64(gui_hwnd), op_open, g_guide_p, 0, 0, 5);   # SW_SHOWNORMAL; >32 = success
    if rv <= 32 { ide_append_out(m_noguide); }
    return 0;
}
func find_toggle(show: i64) -> i64 {
    store64(g_find_shown, show);
    sw = 0; if show == 1 { sw = 5; }                       # SW_HIDE / SW_SHOW
    ShowWindow(load64(gui_find_in),  sw);
    ShowWindow(load64(gui_find_btn), sw);
    ShowWindow(load64(gui_repl_in),  sw);
    ShowWindow(load64(gui_repl_btn), sw);
    ShowWindow(load64(gui_find_close), sw);
    return 0;
}
# Case-insensitive byte lowercasing (A-Z only -- enough for code identifiers).
func find_lc(c: i64) -> i64 {
    if c >= 65 { if c <= 90 { return c + 32; } }
    return c;
}
# Case-insensitive substring search of `needle` in `hay`, starting at byte `from`.
# Returns the match index, or -1. NOTE: RichEdit's EM_FINDTEXTEX/W proved unreliable on
# this RICHEDIT50W control (returned -1 even for text at offset 0), so find is done in
# ANCL over the document text directly -- guaranteed correct + no A/W/version surprises.
func ancl_strstr_ci(hay: i64, needle: i64, from: i64) -> i64 {
    nlen = strlen(needle);
    if nlen == 0 { return 0 - 1; }
    hlen = strlen(hay);
    i = from; if i < 0 { i = 0; }
    while i + nlen <= hlen {
        j = 0;
        while j < nlen {
            if find_lc(load8(hay + i + j)) != find_lc(load8(needle + j)) { break; }
            j = j + 1;
        }
        if j == nlen { return i; }
        i = i + 1;
    }
    return 0 - 1;
}
# Find the next match of the search box, from the current selection, wrapping once.
func do_find_next() -> i64 {
    ed = load64(gui_editor);
    GetWindowTextA(load64(gui_find_in), g_find_txt, 500);
    if load8(g_find_txt) == 0 { return 0; }
    SendMessageA(ed, 13, 1048575, ide_rich_raw);          # WM_GETTEXT (whole doc)
    strip_lf(ide_doc, ide_rich_raw);                      # \r-only text -> indices match EM_EXSETSEL
    SendMessageA(ed, 0x434, 0, g_find_sel);               # EM_EXGETSEL (cpMin@0, cpMax@4)
    pos = ancl_strstr_ci(ide_doc, g_find_txt, load32(g_find_sel + 4));   # search after the current selection
    if pos < 0 { pos = ancl_strstr_ci(ide_doc, g_find_txt, 0); }         # wrap to the top
    if pos >= 0 {
        store32(g_ftex + 0, pos);                          # CHARRANGE.cpMin
        store32(g_ftex + 4, pos + strlen(g_find_txt));     # CHARRANGE.cpMax
        SendMessageA(ed, 0x437, 0, g_ftex);                # EM_EXSETSEL the match
        SendMessageA(ed, 0xB7, 0, 0);                      # EM_SCROLLCARET
        update_lincol();                                   # programmatic selection doesn't fire EN_SELCHANGE
    }
    return 0;
}
# Replace the current selection with the replace text, then advance to the next match.
func do_replace() -> i64 {
    ed = load64(gui_editor);
    GetWindowTextA(load64(gui_repl_in), g_repl_txt, 500);
    SendMessageA(ed, 0xC2, 1, g_repl_txt);                 # EM_REPLACESEL (undoable)
    do_find_next();
    return 0;
}

func do_send_agent() -> i64 {
    GetWindowTextA(load64(gui_chat_in), g_user_msg, 8000);
    if load8(g_user_msg) == 0 { return 0; }
    # apply/reject FIRST -- a local editor op; must work even while the agent loop is still busy
    # (a slow LLM keeps g_agent_busy=1 after proposing an edit; the busy guard moved BELOW).
    if load64(g_pending_apply) == 1 {                                  # a proposed agent edit is awaiting review
        if cmd_is(g_user_msg, cmd_apply) == 1 {
            ui_load_file_to_edit(g_pending_path, load64(gui_editor));  # ACCEPT -> load it into the editor
            ide_recolor();
            if load64(g_repair_pending) == 1 {                        # #2: this proposal was an AI repair ->
                ide_log_errfix(k_airepair, g_repair_err, g_repair_bak, g_pending_path);   # log broken->error->fix
                store64(g_repair_pending, 0);
            }
            store64(g_pending_apply, 0);
            set_status(st_applied);
            SetWindowTextA(load64(gui_chat_in), gui_empty);
            return 0;
        }
        if cmd_is(g_user_msg, cmd_reject) == 1 {
            store64(g_pending_apply, 0);                               # REJECT -> leave the editor as-is
            store64(g_repair_pending, 0);                             # #2: rejected -> no triple
            set_status(st_rejected);
            SetWindowTextA(load64(gui_chat_in), gui_empty);
            return 0;
        }
    }
    if load64(g_agent_busy) == 1 { return 0; }                   # busy guard: blocks only NEW requests (apply/reject above run anytime)
    if cmd_is(g_user_msg, cmd_fix) == 1 {                         # chat "fix" -> mechanical smart-compiler fix
        ag_echo_user(g_user_msg);                                 # (report lands in the OUTPUT pane + a confirm dialog)
        SetWindowTextA(load64(gui_chat_in), gui_empty);
        do_fix_current();
        return 0;
    }
    if cmd_is(g_user_msg, cmd_repair) == 1 {                      # chat "repair" -> AI repair of the compile errors
        SetWindowTextA(load64(gui_chat_in), gui_empty);
        do_ai_repair();                                          # echoes its own intent + runs the agent loop
        return 0;
    }
    ag_echo_user(g_user_msg);
    if load64(set_backend) == 4 {                                 # Local Brain (ANCL): offline autocomplete
        ide_brain_complete_chat();
        SetWindowTextA(load64(gui_chat_in), gui_empty);
        return 0;
    }
    # Build the model-facing turn: inject the open file (path + live editor text)
    # so "the open file" resolves; the chat echo above still shows only the raw prompt.
    if load8(g_curpath) == 0 {
        str_copy(g_agent_input, g_user_msg);
    } else {
        c = str_copy(g_agent_input, ctx_open_a);
        c = str_copy(c, g_curpath);
        c = str_copy(c, ctx_open_b);
        GetWindowTextA(load64(gui_editor), c, 200000);   # live editor contents (incl. unsaved)
        c = c + strlen(c);
        c = str_copy(c, ctx_open_c);
        str_copy(c, g_user_msg);
    }
    store64(g_agent_busy, 1);
    store64(g_agent_done, 0);
    store64(g_suppress_tools, 0);                                 # full agent loop = tools on
    store64(g_chat_mode, 0);
    if load64(set_backend) == 5 {                                 # local engine: default to FAST chat
        if load64(set_eng_tools) == 0 { store64(g_chat_mode, 1); store64(g_suppress_tools, 1); }
    }
    InvalidateRect(load64(gui_badge), 0, 1);                      # badge status -> working
    set_status(st_agent);
    chat_refresh();
    SetWindowTextA(load64(gui_chat_in), gui_empty);
    store64(g_repair_pending, 0);                                 # #2: a normal request -> its proposal isn't a repair
    if load64(set_backend) == 2 {
        CreateThread(0, 0, &agent_single_thread, 0, 0, g_agent_thr);
    } else {
        CreateThread(0, 0, &agent_thread, 0, 0, g_agent_thr);
    }
    return 0;
}

# bounded append of NUL-term src onto dst; returns the new end pointer.
func expl_append(dst: i64, src: i64, maxn: i64) -> i64 {
    i = 0;
    while i < maxn {
        c = load8(src + i);
        if c == 0 { break; }
        store8(dst + i, c);
        i = i + 1;
    }
    store8(dst + i, 0);
    return dst + i;
}

# M4: hand the last compile output + current source to the AI, show the answer in chat.
func do_explain_error() -> i64 {
    if load64(g_agent_busy) == 1 { return 0; }
    if load8(g_capbuf) == 0 { set_status(st_nocompile); return 0; }
    e = str_copy(g_user_msg, expl_pfx);
    e = expl_append(e, g_capbuf, 16000);                          # bounded compiler output
    e = str_copy(e, expl_src);
    SendMessageA(load64(gui_editor), 13, 65535, g_ai_editbuf);    # WM_GETTEXT editor (<=64KB)
    expl_append(e, g_ai_editbuf, 90000);
    ag_trim();                                                    # keep the running transcript (accumulate)
    if strlen(g_chat_log) > 0 { ag_log(nl); }
    ag_log(expl_echo);
    store64(g_agent_busy, 1);
    store64(g_agent_done, 0);
    store64(g_suppress_tools, 1);                                 # explain = focused, no tools
    store64(g_chat_mode, 0);                                      # keep the ANCL primer for accurate error help
    set_status(st_agent);
    chat_refresh();
    if load64(set_backend) == 2 {
        CreateThread(0, 0, &agent_single_thread, 0, 0, g_agent_thr);
    } else {
        CreateThread(0, 0, &agent_thread, 0, 0, g_agent_thr);
    }
    return 0;
}

# Set g_curpath + window title + status to `path` (no editor reload).
func ide_set_current(path: i64) -> i64 {
    str_copy(g_curpath, path);
    e = str_copy(titlebuf, title_pfx); str_copy(e, path);
    SetWindowTextA(load64(gui_hwnd), titlebuf);
    e2 = str_copy(statusbuf, st_pfx_edit); str_copy(e2, path);
    set_status(statusbuf);
    return 0;
}
# Load `path` into the editor, recolor, and make it the current file.
func ide_open_path(path: i64) -> i64 {
    k = tab_find(path);
    if k >= 0 { tab_switch(k); recent_push(path); return 0; }   # already open -> switch to that tab
    store64(g_loading, 1);
    tab_stash_current();                                        # save the outgoing tab first
    ui_load_file_to_edit(path, load64(gui_editor));
    ide_recolor();
    ide_set_current(path);
    update_lincol();
    tab_register(path);                                         # register the loaded file as a new tab
    recent_push(path);
    PostMessageA(load64(gui_hwnd), 0x8006, 0, 0);               # clear g_loading after the load's EN_CHANGE drains
    return 0;
}
# Build the double-NUL-terminated comdlg32 filter once.
func build_filter() -> i64 {
    p = str_copy(g_filter, flt_a);
    p = str_copy(p + 1, flt_b);
    p = str_copy(p + 1, flt_c);
    p = str_copy(p + 1, flt_d);
    store8(p + 1, 0);                         # extra NUL -> double-NUL terminator
    return 0;
}

func do_new() -> i64 {
    store64(g_loading, 1);
    tab_stash_current();
    ui_join(g_tmpl_p, g_app_root, s_tmpl_console);
    if ui_load_file_to_edit(g_tmpl_p, load64(gui_editor)) == 0 {
        SendMessageA(load64(gui_editor), 12, 0, gui_empty);
    }
    SendMessageA(load64(gui_editor), 177, 0, 0);           # EM_SETSEL(0,0): caret to top
    SendMessageA(load64(gui_editor), 194, 0, s_intent_ph); # EM_REPLACESEL: seed the @INTENT block (match New Project)
    ide_recolor();
    ui_join(g_curpath, g_workspace, s_untitled);
    ide_set_current(g_curpath);
    update_lincol();
    tab_register(g_curpath);
    PostMessageA(load64(gui_hwnd), 0x8006, 0, 0);
    return 0;
}

# Treat known binary extensions as non-openable, so a click never loads raw bytes
# into the editor as a garbage tab (this is what made aether_studio.ico "open a window").
func ide_is_binary(path: i64) -> i64 {
    if ends_with_ci(path, ext_ico)  == 1 { return 1; }
    if ends_with_ci(path, ext_exe)  == 1 { return 1; }
    if ends_with_ci(path, ext_dll)  == 1 { return 1; }
    if ends_with_ci(path, ext_lib)  == 1 { return 1; }
    if ends_with_ci(path, ext_obj)  == 1 { return 1; }
    if ends_with_ci(path, ext_png)  == 1 { return 1; }
    if ends_with_ci(path, ext_jpg)  == 1 { return 1; }
    if ends_with_ci(path, ext_jpeg) == 1 { return 1; }
    if ends_with_ci(path, ext_gif)  == 1 { return 1; }
    if ends_with_ci(path, ext_webp) == 1 { return 1; }
    if ends_with_ci(path, ext_bmp)  == 1 { return 1; }
    if ends_with_ci(path, ext_dna)  == 1 { return 1; }
    if ends_with_ci(path, ext_agym) == 1 { return 1; }
    if ends_with_ci(path, ext_zip)  == 1 { return 1; }
    if ends_with_ci(path, ext_pdf)  == 1 { return 1; }
    return 0;
}
func on_tree_select(idx: i64) -> i64 {
    p = tv_node_path(idx);
    if tv_node_isdir(idx) == 1 { return 0; }
    if ide_is_binary(p) == 1 { set_status(st_binary); return 0; }   # skip binaries -> no garbage tab
    ide_open_path(p);
    return 0;
}

# ----- in-place file rename (TreeView label edit: F2 / slow-click / double-click) -----
# Byte-exact string equality (unlike path_eq, which case-folds) -> case-only renames proceed.
func str_same(a: i64, b: i64) -> i64 {
    i = 0;
    while 1 {
        ca = load8(a + i); cb = load8(b + i);
        if ca != cb { return 0; }
        if ca == 0 { return 1; }
        i = i + 1;
    }
    return 0;
}

# After a rename: repoint any open tab + the current file + the recents at newp.
func rename_update_refs(oldp: i64, newp: i64) -> i64 {
    n = load64(g_tab_n); i = 0;
    while i < n {
        if path_eq(g_tab_path + i * 272, oldp) == 1 { str_copy(g_tab_path + i * 272, newp); }
        i = i + 1;
    }
    if path_eq(g_curpath, oldp) == 1 { ide_set_current(newp); }   # title + status + g_curpath
    rn = load64(g_recent_n); j = 0;
    while j < rn { if path_eq(g_recent + j * 272, oldp) == 1 { str_copy(g_recent + j * 272, newp); } j = j + 1; }
    recent_save();
    InvalidateRect(load64(gui_hwnd), g_tab_rc, 0);      # the tab basename changed
    return 0;
}

# Capture the node being label-edited; cancel the edit for folders (renaming a
# folder would leave its children's cached paths stale). Read back in rename_end.
func rename_begin(lpnm: i64) -> i64 {
    hItem = load64(lpnm + 32);                          # NMTVDISPINFO.item.hItem (hdr 24 + 8)
    memset(g_tvq, 0, 56);
    store32(g_tvq + 0, 4);                              # mask = TVIF_PARAM
    store64(g_tvq + 8, hItem);                          # hItem
    SendMessageA(load64(gui_tree), 0x110C, 0, g_tvq);   # TVM_GETITEMA -> fills lParam (the node index)
    idx = load64(g_tvq + 48);                           # item.lParam
    store64(g_edit_node, idx);
    if tv_node_isdir(idx) == 1 { return 1; }            # folder -> cancel the edit
    hed = SendMessageA(load64(gui_tree), 0x110F, 0, 0); # TVM_GETEDITCONTROL
    if hed != 0 { SendMessageA(hed, 0xC5, 240, 0); }    # EM_LIMITTEXT -> cap the typed name length
    return 0;                                           # file -> allow it
}

# The user finished editing -> MoveFileA + fix the open tab / current / recents.
# Return 1 to accept the new label, 0 to reject (the tree reverts it).
func rename_end(lpnm: i64) -> i64 {
    newtext = load64(lpnm + 48);                        # NMTVDISPINFO.item.pszText (NULL = cancelled)
    if newtext == 0 { return 0; }
    if load8(newtext) == 0 { return 0; }                # empty name -> reject
    si = 0;                                             # reject path separators / drive colon (no moving the file out of its folder)
    while 1 {
        sc = load8(newtext + si);
        if sc == 0 { break; }
        if sc == 92 { return 0; }                       # '\'
        if sc == 47 { return 0; }                       # '/'
        if sc == 58 { return 0; }                       # ':'
        si = si + 1;
    }
    idx = load64(g_edit_node);
    if idx < 0 { return 0; }
    str_copy(g_oldpath, tv_node_path(idx));             # save the old path before overwriting the node table
    bs = uic_last_bs(g_oldpath);
    nl = strlen(newtext);
    if bs + 1 + nl > 270 { return 0; }                  # keep the new full path inside a 272-byte node/tab/recent slot
    if bs >= 0 {
        memcpy(g_renamebuf, g_oldpath, bs + 1);         # dir + the trailing '\'
        str_copy(g_renamebuf + bs + 1, newtext);
    } else {
        str_copy(g_renamebuf, newtext);
    }
    if str_same(g_oldpath, g_renamebuf) == 1 { return 0; }  # byte-exact no-op (case-only renames DO proceed)
    if MoveFileA(g_oldpath, g_renamebuf) == 0 { return 0; } # target exists / file locked -> reject
    str_copy(tv_node_path(idx), g_renamebuf);           # node table -> new path
    rename_update_refs(g_oldpath, g_renamebuf);
    return 1;
}

# Double-click a FILE node -> start in-place rename (folders keep expand/collapse).
func rename_dblclick() -> i64 {
    t = load64(gui_tree);
    hsel = SendMessageA(t, 0x110A, 9, 0);               # TVM_GETNEXTITEM TVGN_CARET -> selected hItem
    if hsel == 0 { return 0; }
    memset(g_tvq, 0, 56);
    store32(g_tvq + 0, 4); store64(g_tvq + 8, hsel);
    SendMessageA(t, 0x110C, 0, g_tvq);                  # TVM_GETITEMA -> lParam (node index)
    if tv_node_isdir(load64(g_tvq + 48)) == 1 { return 0; }   # folder: let the default double-click expand it
    SendMessageA(t, 0x110E, 0, hsel);                   # TVM_EDITLABEL -> begin the in-place edit
    return 1;
}

func do_save() -> i64 {
    if load8(g_curpath) == 0 { return 0; }
    ui_save_edit_to_file(g_curpath, load64(gui_editor));
    SendMessageA(load64(gui_editor), 185, 0, 0); # EM_SETMODIFY FALSE
    tab_stash_current();                         # keep the tab buffer in sync with disk
    tab_mark_dirty(0);                           # clean
    return 0;
}

# ---- Open File (comdlg32) ----
func do_open_file() -> i64 {
    memset(g_ofn, 0, 152);
    store32(g_ofn + 0, 152);                       # lStructSize
    store64(g_ofn + 8, load64(gui_hwnd));          # hwndOwner
    store64(g_ofn + 24, g_filter);                 # lpstrFilter
    store32(g_ofn + 44, 1);                        # nFilterIndex
    store64(g_ofn + 48, g_ofn_file);               # lpstrFile
    store32(g_ofn + 56, 1024);                     # nMaxFile
    store64(g_ofn + 80, g_workspace);              # lpstrInitialDir
    store64(g_ofn + 88, open_title);               # lpstrTitle
    store32(g_ofn + 96, 0x1804);                   # FILEMUSTEXIST|PATHMUSTEXIST|HIDEREADONLY
    store8(g_ofn_file, 0);
    if GetOpenFileNameA(g_ofn) == 0 { return 0; }  # cancelled
    ide_open_path(g_ofn_file);
    return 0;
}

# ---- Save As (comdlg32) ----
func do_save_as() -> i64 {
    memset(g_ofn, 0, 152);
    store32(g_ofn + 0, 152);
    store64(g_ofn + 8, load64(gui_hwnd));
    store64(g_ofn + 24, g_filter);
    store32(g_ofn + 44, 1);
    store64(g_ofn + 48, g_ofn_file);
    store32(g_ofn + 56, 1024);
    store64(g_ofn + 80, g_workspace);
    store64(g_ofn + 88, saveas_title);
    store32(g_ofn + 96, 0x806);                    # PATHMUSTEXIST|HIDEREADONLY|OVERWRITEPROMPT
    store64(g_ofn + 104, defext_ancl);             # lpstrDefExt
    if load8(g_curpath) != 0 { str_copy(g_ofn_file, g_curpath); } else { store8(g_ofn_file, 0); }
    if GetSaveFileNameA(g_ofn) == 0 { return 0; }
    ui_save_edit_to_file(g_ofn_file, load64(gui_editor));
    ide_set_current(g_ofn_file);
    cur = load64(g_tab_cur);                     # rename the current tab + mark clean
    if cur >= 0 {
        str_copy(g_tab_path + cur * 272, g_ofn_file);
        store64(g_tab_dirty + cur * 8, 0);
        InvalidateRect(load64(gui_hwnd), g_tab_rc, 0);
    }
    recent_push(g_ofn_file);
    return 0;
}

# ---- folder picker (classic SHBrowseForFolder, COM-free) -> g_newdir; 1 ok ----
func ide_pick_folder(titl: i64) -> i64 {
    memset(g_bi, 0, 64);
    store64(g_bi + 0, load64(gui_hwnd));           # hwndOwner
    store64(g_bi + 16, g_bi_disp);                 # pszDisplayName
    store64(g_bi + 24, titl);                      # lpszTitle
    store32(g_bi + 32, 0x41);                      # BIF_RETURNONLYFSDIRS|BIF_NEWDIALOGSTYLE -> shows "Make New Folder" (needs OleInitialize, done in main)
    pidl = SHBrowseForFolderA(g_bi);
    if pidl == 0 { return 0; }                     # cancelled (PIDL leaks - rare action, negligible)
    if SHGetPathFromIDListA(pidl, g_newdir) == 0 { return 0; }
    return 1;
}

# ---- Open Folder -> set workspace + repopulate the tree ----
func ide_refresh_tree() -> i64 {
    SendMessageA(load64(gui_tree), 0x1101, 0, 0);  # TVM_DELETEALLITEMS
    tv_reset();
    tv_populate(load64(gui_tree), g_workspace, 0 - 0x10000, 0);
    return 0;
}
func do_open_folder() -> i64 {
    if ide_pick_folder(browse_title) == 0 { return 0; }
    str_copy(g_workspace, g_newdir);
    ide_refresh_tree();
    e2 = str_copy(statusbuf, st_pfx_open); str_copy(e2, g_workspace);
    set_status(statusbuf);
    return 0;
}

# ---- First-run workspace: a clean projects folder under the user profile, so the IDE's
#      own install files (src/bin/core_lib/.ico) are never shown in the tree and end users
#      can't accidentally break the IDE. g_app_root still anchors templates + the compiler. ----
func ide_seed_starter() -> i64 {
    ui_join(g_tmpl_p,    g_app_root,  s_tmpl_hello);     # the welcome seed (shows the AI features)
    ui_join(g_seed_path, g_workspace, s_hello);          # <projects>\hello.ancl
    CopyFileA(g_tmpl_p, g_seed_path, 1);                 # bFailIfExists=1 -> NEVER clobbers a user's file
    return 0;
}
func ide_init_workspace() -> i64 {
    n = GetEnvironmentVariableA(env_userprofile, g_workspace, 500);
    if n == 0 { str_copy(g_workspace, g_app_root); return 0; }   # fallback: the install dir
    p = g_workspace + n;                          # at the NUL after the profile path
    p = str_copy(p, s_documents);                 # <profile>\Documents
    CreateDirectoryA(g_workspace, 0);             # ensure it (harmless if it already exists)
    p = str_copy(p, s_projects);                  # <profile>\Documents\Aether Projects
    CreateDirectoryA(g_workspace, 0);             # ensure the projects folder
    ide_seed_starter();                           # drop a hello.ancl in if absent
    return 0;
}

# ---- Open Recent: an MRU list persisted to bin\aether_recent.txt -------------
func recent_pathfile() -> i64 {
    ui_exedir(g_compiler_dir);
    ui_join(g_recent_path, g_compiler_dir, s_recentfile);
    return 0;
}
func recent_load() -> i64 {
    recent_pathfile();
    store64(g_recent_n, 0);
    n = ui_read_file(g_recent_path, g_recent_buf, 4095);
    if n <= 0 { return 0; }
    i = 0;
    while i < n {
        j = i;
        scanning = 1;
        while scanning == 1 {
            if j >= n { scanning = 0; }
            else { if load8(g_recent_buf + j) == 10 { scanning = 0; } else { j = j + 1; } }
        }
        e = j;
        if e > i { if load8(g_recent_buf + e - 1) == 13 { e = e - 1; } }   # strip a trailing \r
        ln = e - i;
        if ln > 0 { if ln < 270 {
            slot = load64(g_recent_n);
            if slot < 8 {
                memcpy(g_recent + slot * 272, g_recent_buf + i, ln);
                store8(g_recent + slot * 272 + ln, 0);
                store64(g_recent_n, slot + 1);
            }
        } }
        i = j + 1;
    }
    return 0;
}
func recent_save() -> i64 {
    n = load64(g_recent_n);
    p = g_recent_buf;
    i = 0;
    while i < n {
        s = g_recent + i * 272;
        ln = strlen(s);
        memcpy(p, s, ln); p = p + ln;
        store8(p, 10); p = p + 1;
        i = i + 1;
    }
    recent_pathfile();
    ui_write_file(g_recent_path, g_recent_buf, p - g_recent_buf);
    return 0;
}
# Move `path` to the front of the MRU list (dedup), cap at 8, persist.
func recent_push(path: i64) -> i64 {
    if load8(path) == 0 { return 0; }
    n = load64(g_recent_n);
    k = 0 - 1; i = 0;
    while i < n { if path_eq(g_recent + i * 272, path) == 1 { k = i; } i = i + 1; }
    if k >= 0 {                                       # remove the existing copy (shift up over it)
        i = k;
        while i < n - 1 { str_copy(g_recent + i * 272, g_recent + (i + 1) * 272); i = i + 1; }
        n = n - 1;
    }
    if n >= 8 { n = 7; }                              # full -> the oldest falls off the shift below
    i = n;
    while i > 0 { str_copy(g_recent + i * 272, g_recent + (i - 1) * 272); i = i - 1; }
    str_copy(g_recent + 0, path);
    store64(g_recent_n, n + 1);
    recent_save();
    return 0;
}
# Rebuild the Open Recent submenu's items from the current MRU list (called as it opens).
func recent_menu_rebuild() -> i64 {
    m = load64(g_menu_recent);
    if m == 0 { return 0; }
    c = GetMenuItemCount(m);
    while c > 0 { RemoveMenu(m, 0, 0x400); c = c - 1; }   # MF_BYPOSITION -> drop item 0 repeatedly
    n = load64(g_recent_n);
    if n == 0 { AppendMenuA(m, 0x100, 2339, mi_recent_none); menu_dark(m); return 0; }   # owner-draw "(none)"
    i = 0;
    while i < n { menu_item(m, 2330 + i, g_recent + i * 272); i = i + 1; }   # ids 2330..2337
    menu_dark(m);
    return 0;
}

# ---- command palette (Ctrl+Shift+P): filter edit + listbox of commands ----
# case-insensitive substring: does `hay` contain `needle`?
func contains_ci(hay: i64, needle: i64) -> i64 {
    if load8(needle) == 0 { return 1; }
    i = 0;
    while load8(hay + i) != 0 {
        j = 0; ok = 1; matching = 1;
        while matching == 1 {
            cn = load8(needle + j);
            if cn == 0 { matching = 0; }
            else {
                ch = load8(hay + i + j);
                if ch == 0 { ok = 0; matching = 0; }
                else {
                    a = ch; b = cn;
                    if a >= 65 { if a <= 90 { a = a + 32; } }
                    if b >= 65 { if b <= 90 { b = b + 32; } }
                    if a != b { ok = 0; matching = 0; } else { j = j + 1; }
                }
            }
        }
        if ok == 1 { return 1; }
        i = i + 1;
    }
    return 0;
}
func cmd_count() -> i64 { return 16; }
func cmd_label(i: i64) -> i64 {
    if i == 0 { return pc0; } if i == 1 { return pc1; } if i == 2 { return pc2; }
    if i == 3 { return pc3; } if i == 4 { return pc4; } if i == 5 { return pc5; }
    if i == 6 { return pc6; } if i == 7 { return pc7; } if i == 8 { return pc8; }
    if i == 9 { return pc9; } if i == 10 { return pc10; } if i == 11 { return pc11; }
    if i == 12 { return pc12; } if i == 13 { return pc13; } if i == 14 { return pc14; }
    if i == 15 { return pc15; }
    return gui_empty;
}
func cmd_id(i: i64) -> i64 {
    if i == 0 { return 2301; } if i == 1 { return 2311; } if i == 2 { return 2303; }
    if i == 3 { return 2305; } if i == 4 { return 2302; } if i == 5 { return 2309; }
    if i == 6 { return 2304; } if i == 7 { return 2307; } if i == 8 { return 2312; }
    if i == 9 { return 2313; } if i == 10 { return 2314; } if i == 11 { return 2308; }
    if i == 12 { return 2398; } if i == 13 { return 2315; } if i == 14 { return 2316; }
    if i == 15 { return 2397; }
    return 0;
}
# Repopulate the listbox with the commands matching the filter box.
func pal_refilter() -> i64 {
    lb = load64(g_pal_list);
    if lb == 0 { return 0; }
    GetWindowTextA(load64(g_pal_edit), g_pal_filter, 150);
    SendMessageA(lb, 388, 0, 0);                       # LB_RESETCONTENT
    n = cmd_count(); i = 0;
    while i < n {
        if contains_ci(cmd_label(i), g_pal_filter) == 1 {
            idx = SendMessageA(lb, 384, 0, cmd_label(i));   # LB_ADDSTRING -> index
            SendMessageA(lb, 410, idx, cmd_id(i));          # LB_SETITEMDATA -> the command id
        }
        i = i + 1;
    }
    SendMessageA(lb, 390, 0, 0);                       # LB_SETCURSEL 0
    return 0;
}
func pal_close() -> i64 {
    store64(g_pal_open, 0);
    if load64(g_pal_hwnd) != 0 { ShowWindow(load64(g_pal_hwnd), 0); }   # SW_HIDE
    SetFocus(load64(gui_editor));
    return 0;
}
func pal_run_selected() -> i64 {
    lb = load64(g_pal_list);
    sel = SendMessageA(lb, 392, 0, 0);                 # LB_GETCURSEL
    if sel < 0 { pal_close(); return 0; }
    cid = SendMessageA(lb, 409, sel, 0);               # LB_GETITEMDATA -> command id
    pal_close();
    SendMessageA(load64(gui_hwnd), 273, cid, 0);       # dispatch as a WM_COMMAND on the main window
    return 0;
}
func pal_move(d: i64) -> i64 {
    lb = load64(g_pal_list);
    cnt = SendMessageA(lb, 395, 0, 0);                 # LB_GETCOUNT
    if cnt <= 0 { return 0; }
    sel = SendMessageA(lb, 392, 0, 0) + d;             # LB_GETCURSEL + delta
    if sel < 0 { sel = 0; }
    if sel >= cnt { sel = cnt - 1; }
    SendMessageA(lb, 390, sel, 0);                     # LB_SETCURSEL
    return 0;
}
func PaletteProc(hwnd: i64, msg: i64, wParam: i64, lParam: i64) -> i64 {
    if msg == 1 {                                      # WM_CREATE
        hinst = load64(gui_hinst);
        ed = CreateWindowExA(0, cls_edit, gui_empty, 0x50000080, 8, 8, 504, 28, hwnd, 1, hinst, 0);  # ES_AUTOHSCROLL
        store64(g_pal_edit, ed);
        SendMessageA(ed, 48, load64(thm_f_ui), 1);
        thm_dark_scroll(ed);
        lb = CreateWindowExA(0, lb_class, gui_empty, 0x50200041, 8, 44, 504, 248, hwnd, 2, hinst, 0);  # WS_VSCROLL|LBS_NOTIFY|LBS_HASSTRINGS
        store64(g_pal_list, lb);
        SendMessageA(lb, 48, load64(thm_f_ui), 1);
        thm_dark_scroll(lb);
        pal_refilter();
        return 0;
    }
    if msg == 273 {                                    # WM_COMMAND from the filter/listbox
        cid2 = band(wParam, 65535);
        code = band(shr(wParam, 16), 65535);
        if cid2 == 1 { if code == 768 { pal_refilter(); } }   # EN_CHANGE -> refilter
        if cid2 == 2 { if code == 2 { pal_run_selected(); } } # LBN_DBLCLK -> run
        return 0;
    }
    if msg == 307 { SetBkMode(wParam, 2); SetTextColor(wParam, TH_TEXT); SetBkColor(wParam, TH_BG_INPUT); return load64(thm_b_input); }  # WM_CTLCOLOREDIT
    if msg == 308 { SetTextColor(wParam, TH_TEXT); SetBkColor(wParam, TH_BG_DEEP); SetBkMode(wParam, 1); return load64(thm_b_deep); }    # WM_CTLCOLORLISTBOX
    return DefWindowProcA(hwnd, msg, wParam, lParam);
}
func pal_register(hinst: i64) -> i64 {
    if load64(g_pal_reg) == 1 { return 0; }
    cursor = LoadCursorA(0, 32512);
    store32(g_pal_wc + 0, 80); store32(g_pal_wc + 4, 0);
    store64(g_pal_wc + 8, &PaletteProc);
    store32(g_pal_wc + 16, 0); store32(g_pal_wc + 20, 0);
    store64(g_pal_wc + 24, hinst);
    store64(g_pal_wc + 32, 0);
    store64(g_pal_wc + 40, cursor);
    store64(g_pal_wc + 48, load64(thm_b_panel));
    store64(g_pal_wc + 56, 0);
    store64(g_pal_wc + 64, cls_palette);
    store64(g_pal_wc + 72, 0);
    RegisterClassExA(g_pal_wc);
    store64(g_pal_reg, 1);
    return 0;
}
func pal_open() -> i64 {
    hinst = load64(gui_hinst);
    pal_register(hinst);
    if load64(g_pal_hwnd) == 0 {
        GetWindowRect(load64(gui_hwnd), g_pal_rc);                  # center 520x300 over the main window
        mx = load32(g_pal_rc + 0); my = load32(g_pal_rc + 4);
        mw = load32(g_pal_rc + 8) - mx; mh = load32(g_pal_rc + 12) - my;
        px = mx + (mw - 520) / 2; py = my + (mh - 300) / 3;
        store64(g_pal_hwnd, CreateWindowExA(0x80, cls_palette, gui_empty, 0x80800000, px, py, 520, 300, load64(gui_hwnd), 0, hinst, 0));
    }
    SetWindowTextA(load64(g_pal_edit), gui_empty);
    pal_refilter();
    ShowWindow(load64(g_pal_hwnd), 5);
    SetForegroundWindow(load64(g_pal_hwnd));
    SetFocus(load64(g_pal_edit));
    store64(g_pal_open, 1);
    return 0;
}

# ---- M5b ghost-text completion popup ------------------------------------------------
# A dark popup listbox anchored at the caret. Unlike the palette it does NOT steal focus
# (the editor keeps the caret); nav keys (Up/Down/Enter/Tab/Esc) are routed by the message
# loop while g_comp_open==1. Accept inserts the selected snippet at the caret.
func sug_prefix_at(s: i64, pfx: i64) -> i64 {
    j = 0;
    while load8(pfx + j) != 0 { if load8(s + j) != load8(pfx + j) { return 0; } j = j + 1; }
    return 1;
}
func CompProc(hwnd: i64, msg: i64, wParam: i64, lParam: i64) -> i64 {
    if msg == 1 {                                          # WM_CREATE -> the suggestion listbox
        hinst = load64(gui_hinst);
        lb = CreateWindowExA(0, lb_class, gui_empty, 0x50200041, 1, 1, 316, 86, hwnd, 2, hinst, 0);
        store64(g_comp_list, lb);
        SendMessageA(lb, 48, load64(thm_f_ui), 1);         # WM_SETFONT
        thm_dark_scroll(lb);
        return 0;
    }
    if msg == 308 { SetTextColor(wParam, TH_TEXT); SetBkColor(wParam, TH_BG_DEEP); SetBkMode(wParam, 1); return load64(thm_b_deep); }   # WM_CTLCOLORLISTBOX
    return DefWindowProcA(hwnd, msg, wParam, lParam);
}
func comp_register(hinst: i64) -> i64 {
    if load64(g_comp_reg) == 1 { return 0; }
    cursor = LoadCursorA(0, 32512);
    store32(g_comp_wc + 0, 80); store32(g_comp_wc + 4, 0);
    store64(g_comp_wc + 8, &CompProc);
    store32(g_comp_wc + 16, 0); store32(g_comp_wc + 20, 0);
    store64(g_comp_wc + 24, hinst);
    store64(g_comp_wc + 32, 0);
    store64(g_comp_wc + 40, cursor);
    store64(g_comp_wc + 48, load64(thm_b_panel));
    store64(g_comp_wc + 56, 0);
    store64(g_comp_wc + 64, cls_comp);
    store64(g_comp_wc + 72, 0);
    RegisterClassExA(g_comp_wc);
    store64(g_comp_reg, 1);
    return 0;
}
func comp_close() -> i64 {
    store64(g_comp_open, 0);
    if load64(g_comp_hwnd) != 0 { ShowWindow(load64(g_comp_hwnd), 0); }   # SW_HIDE (editor keeps focus)
    return 0;
}
# parse complete.exe's "suggest: <text>" lines from `buf` into the listbox. Returns the count.
func comp_populate(buf: i64) -> i64 {
    lb = load64(g_comp_list);
    SendMessageA(lb, 388, 0, 0);                           # LB_RESETCONTENT
    n = 0; i = 0;
    while load8(buf + i) != 0 {
        if sug_prefix_at(buf + i, m_sug_pfx) == 1 {
            p = i + 9; q = 0;                              # 9 = len("suggest: ")
            while load8(buf + p) != 0 {
                c = load8(buf + p);
                if c == 10 { break; } if c == 13 { break; }
                store8(g_comp_item + q, c); q = q + 1; p = p + 1;
            }
            store8(g_comp_item + q, 0);
            if q > 0 { SendMessageA(lb, 384, 0, g_comp_item); n = n + 1; }   # LB_ADDSTRING
            i = p;
        } else {
            i = i + 1;
        }
    }
    return n;
}
func comp_move(d: i64) -> i64 {
    lb = load64(g_comp_list);
    cnt = SendMessageA(lb, 395, 0, 0);                     # LB_GETCOUNT
    if cnt <= 0 { return 0; }
    sel = SendMessageA(lb, 392, 0, 0) + d;                 # LB_GETCURSEL + delta
    if sel < 0 { sel = 0; }
    if sel >= cnt { sel = cnt - 1; }
    SendMessageA(lb, 390, sel, 0);                         # LB_SETCURSEL
    return 0;
}
func comp_accept() -> i64 {
    lb = load64(g_comp_list);
    sel = SendMessageA(lb, 392, 0, 0);                     # LB_GETCURSEL
    if sel < 0 { comp_close(); return 0; }
    SendMessageA(lb, 393, sel, g_comp_item);               # LB_GETTEXT -> g_comp_item
    comp_close();
    SetFocus(load64(gui_editor));
    SendMessageA(load64(gui_editor), 194, 1, g_comp_item); # EM_REPLACESEL(TRUE) -> insert at caret
    ide_recolor();
    return 0;
}
# show the popup at the caret with the suggestions parsed from `buf` (complete.exe output).
func comp_open(buf: i64) -> i64 {
    hinst = load64(gui_hinst);
    comp_register(hinst);
    if load64(g_comp_hwnd) == 0 {
        store64(g_comp_hwnd, CreateWindowExA(0x8000080, cls_comp, gui_empty, 0x80800000, 0, 0, 320, 90, load64(gui_hwnd), 0, hinst, 0));
    }
    if comp_populate(buf) <= 0 { comp_close(); return 0; }  # nothing to suggest (e.g. load failed)
    SendMessageA(load64(g_comp_list), 390, 0, 0);           # LB_SETCURSEL 0
    GetCaretPos(g_comp_pt);                                 # caret in editor-client coords
    ClientToScreen(load64(gui_editor), g_comp_pt);          # -> screen
    cx = load32(g_comp_pt + 0); cy = load32(g_comp_pt + 4);
    SetWindowPos(load64(g_comp_hwnd), 0 - 1, cx, cy + 18, 320, 90, 0x10);   # HWND_TOPMOST, SWP_NOACTIVATE
    ShowWindow(load64(g_comp_hwnd), 4);                     # SW_SHOWNOACTIVATE -> show without stealing focus
    store64(g_comp_open, 1);
    return 0;
}

# Apply a dark background brush to a popup menu (items are owner-drawn dark too).
func menu_dark(h: i64) -> i64 {
    memset(g_menu_info, 0, 40);
    store32(g_menu_info + 0, 40);                  # cbSize
    store32(g_menu_info + 4, 0x2);                 # fMask = MIM_BACKGROUND
    store64(g_menu_info + 16, load64(thm_b_card)); # hbrBack = card-tone brush
    SetMenuInfo(h, g_menu_info);
    return 0;
}
# Add one owner-drawn item (MF_OWNERDRAW=0x100; itemData = the label ptr).
func menu_item(h: i64, id: i64, label: i64) -> i64 { AppendMenuA(h, 0x100, id, label); return 0; }
func menu_sep(h: i64) -> i64 { AppendMenuA(h, 0x800, 0, 0); return 0; }   # MF_SEPARATOR

# Build the three popup menus once (File / Build / Help).  Items post WM_COMMAND
# with the same ids as before, reusing the dispatch.  Drawn dark via WM_DRAWITEM.
func ide_build_menu(hwnd: i64) -> i64 {
    mf = CreatePopupMenu();                        # ---- File ----
    menu_item(mf, 2301, mi_new); menu_item(mf, 2311, mi_newproj); menu_sep(mf);
    menu_item(mf, 2303, mi_open); menu_item(mf, 2305, mi_openf);
    mr = CreatePopupMenu(); store64(g_menu_recent, mr);   # Open Recent submenu (items rebuilt on open)
    AppendMenuA(mf, 0x110, mr, mi_recent);                # MF_POPUP|MF_OWNERDRAW: itemData=label, submenu=mr
    menu_sep(mf);
    menu_item(mf, 2302, mi_save); menu_item(mf, 2309, mi_saveas); menu_sep(mf);
    menu_item(mf, 2399, mi_exit);
    menu_dark(mf); store64(g_menu_file, mf);
    me = CreatePopupMenu();                        # ---- Edit ----
    menu_item(me, 2340, mi_undo); menu_item(me, 2341, mi_redo); menu_sep(me);
    menu_item(me, 2342, mi_cut); menu_item(me, 2343, mi_copy); menu_item(me, 2344, mi_paste); menu_sep(me);
    menu_item(me, 2345, mi_selall); menu_sep(me);
    menu_item(me, 2346, mi_efind); menu_item(me, 2347, mi_erepl);
    menu_dark(me); store64(g_menu_edit, me);
    mb = CreatePopupMenu();                        # ---- Build ----
    menu_item(mb, 2304, mi_compile);
    menu_item(mb, 2307, mi_run);                   # Run (F5)
    menu_sep(mb);
    menu_item(mb, 2315, mi_fix);                   # Smart compiler: mechanical auto-fix
    menu_item(mb, 2316, mi_airepair);              # Smart compiler: AI repair of compile errors
    menu_sep(mb);
    menu_item(mb, 2312, mi_stoprun);               # kill a running program
    menu_item(mb, 2313, mi_viewasm);               # show the .asm listing
    menu_dark(mb); store64(g_menu_build, mb);
    mh = CreatePopupMenu();                        # ---- Help ----
    menu_item(mh, 2397, mi_guide);                 # open the HTML user guide
    menu_sep(mh);
    menu_item(mh, 2398, mi_about);
    menu_dark(mh); store64(g_menu_help, mh);
    return 0;
}
# Open `menu` as a dropdown anchored under the menu-strip button `btn`.
func menu_drop(btn: i64, menu: i64) -> i64 {
    GetWindowRect(btn, g_win_rc);
    TrackPopupMenu(menu, 0, load32(g_win_rc + 0), load32(g_win_rc + 12), 0, load64(gui_hwnd), 0);  # TPM_LEFTALIGN, at (left,bottom)
    return 0;
}

# Env-gated self-test of the open-by-path + tree-repopulate logic (the modal
# dialogs just feed a user-picked path into these same functions; the dialogs
# themselves are struct-verified + can't be driven headless past the OS
# foreground lock).  Set AETHER_IDE_SELFTEST=1.
func ide_selftest() -> i64 {
    ui_join(g_tmpl_p, g_app_root, s_tmpl_console);
    ide_open_path(g_tmpl_p);                        # the Open-File path funnels here (tab 1)
    ui_join(g_tmpl_p, g_app_root, s_tmpl_min);
    ide_open_path(g_tmpl_p);                        # tab 2
    ui_join(g_tmpl_p, g_app_root, s_src_lexer);
    ide_open_path(g_tmpl_p);                        # tab 3 (now 3 tabs open)
    str_copy(g_workspace, g_app_root);
    ide_refresh_tree();                             # the Open-Folder core
    set_status(st_selftest);
    return 0;
}

# ---- Vision: attach an image for the AI to look at (Phase D) ----
func build_imgfilter() -> i64 {
    p = str_copy(g_imgfilter, imf_a);
    p = str_copy(p + 1, imf_b);
    p = str_copy(p + 1, imf_c);
    p = str_copy(p + 1, imf_d);
    store8(p + 1, 0);
    return 0;
}
# case-insensitive "does s end with suf?"
func ends_with_ci(s: i64, suf: i64) -> i64 {
    ls = strlen(s); lf = strlen(suf);
    if lf > ls { return 0; }
    i = 0;
    while i < lf {
        a = load8(s + ls - lf + i); b = load8(suf + i);
        if a >= 65 { if a <= 90 { a = a + 32; } }
        if b >= 65 { if b <= 90 { b = b + 32; } }
        if a != b { return 0; }
        i = i + 1;
    }
    return 1;
}
func set_img_mime(path: i64) -> i64 {
    str_copy(g_img_mime, mime_png);                    # default
    if ends_with_ci(path, ext_jpg) == 1 { str_copy(g_img_mime, mime_jpeg); }
    if ends_with_ci(path, ext_jpeg) == 1 { str_copy(g_img_mime, mime_jpeg); }
    if ends_with_ci(path, ext_gif) == 1 { str_copy(g_img_mime, mime_gif); }
    if ends_with_ci(path, ext_webp) == 1 { str_copy(g_img_mime, mime_webp); }
    return 0;
}
# append a line to the chat transcript + refresh
func ide_chat_note(s: i64) -> i64 {
    d = strlen(g_chat_log);
    str_copy(g_chat_log + d, s);
    chat_refresh();
    return 0;
}
# Read `path`, base64-encode into g_img_b64, set the mime + g_has_image so the
# next Send includes it (Ollama images[] / OpenAI image_url).  1 = attached.
func attach_image_path(path: i64) -> i64 {
    h = CreateFileA(path, 0x80000000, 1, 0, 3, 0x80, 0);   # GENERIC_READ, OPEN_EXISTING
    if h == 0 - 1 { store64(g_has_image, 0); return 0; }
    total = 0; going = 1;                                  # loop the read (a single ReadFile may short-read)
    while going == 1 {
        toread = 65536;
        if total + toread > 2097152 { toread = 2097152 - total; }
        if toread <= 0 { going = 0; }
        else {
            r = ReadFile(h, g_img_raw + total, toread, g_img_nread, 0);
            if r == 0 { going = 0; }
            else { k = load32(g_img_nread); if k == 0 { going = 0; } else { total = total + k; } }
        }
    }
    CloseHandle(h);
    n = total;
    if n <= 0 { store64(g_has_image, 0); return 0; }
    if n >= 2097152 { store64(g_has_image, 0); ide_chat_note(m_imgbig); return 0; }   # too large -> would truncate
    b64_encode(g_img_raw, n, g_img_b64);
    set_img_mime(path);
    store64(g_has_image, 1);
    base = path;                                       # basename for the note
    bs = uic_last_bs(path);
    if bs > 0 { base = path + bs + 1; }
    e = str_copy(g_img_note, m_imgn1); e = str_copy(e, base);
    e = str_copy(e, m_imgn2); int_to_str(g_img_kb, n / 1024); e = str_copy(e, g_img_kb);
    str_copy(e, m_imgn3);
    ide_chat_note(g_img_note);
    return 1;
}
# File-pick a png/jpg, then attach it for the next Send.
func do_attach_image() -> i64 {
    if load64(g_agent_busy) == 1 { return 0; }
    memset(g_ofn, 0, 152);
    store32(g_ofn + 0, 152);
    store64(g_ofn + 8, load64(gui_hwnd));
    store64(g_ofn + 24, g_imgfilter);
    store32(g_ofn + 44, 1);
    store64(g_ofn + 48, g_ofn_file);
    store32(g_ofn + 56, 1024);
    store64(g_ofn + 80, g_workspace);
    store64(g_ofn + 88, img_open_title);
    store32(g_ofn + 96, 0x1804);
    store8(g_ofn_file, 0);
    if GetOpenFileNameA(g_ofn) == 0 { return 0; }      # cancelled
    attach_image_path(g_ofn_file);
    return 1;
}

# ---- Ctrl+V clipboard image -> PNG (GDI+) -> the existing attach path ----
func gdip_ensure() -> i64 {
    if load64(g_gdip_tok) != 0 { return 1; }           # already up
    store32(g_gdip_in + 0, 1);                          # GdiplusVersion = 1
    store32(g_gdip_in + 4, 0);
    store64(g_gdip_in + 8, 0);                          # DebugEventCallback
    store64(g_gdip_in + 16, 0);                         # SuppressBackgroundThread + SuppressExternalCodecs
    if GdiplusStartup(g_gdip_tok, g_gdip_in, 0) != 0 { store64(g_gdip_tok, 0); return 0; }
    if load64(g_gdip_tok) == 0 { return 0; }
    return 1;
}
func gdip_png_clsid() -> i64 {                          # {557CF406-1A04-11D3-9A73-0000F81EF32E}
    store32(g_png_clsid + 0,  0x557CF406);
    store32(g_png_clsid + 4,  0x11D31A04);
    store32(g_png_clsid + 8,  0x0000739A);
    store32(g_png_clsid + 12, 0x2EF31EF8);
    return 0;
}
# HBITMAP -> temp PNG file at `apath` (ANSI). 1 = success.
func gdip_hbitmap_to_png(hbm: i64, apath: i64) -> i64 {
    if gdip_ensure() == 0 { return 0; }
    store64(g_gp_bm, 0);
    if GdipCreateBitmapFromHBITMAP(hbm, 0, g_gp_bm) != 0 { return 0; }
    bm = load64(g_gp_bm);
    if bm == 0 { return 0; }
    gdip_png_clsid();
    if MultiByteToWideChar(0, 0, apath, 0 - 1, g_clip_wpath, 520) == 0 { return 0; }   # ANSI -> UTF-16LE (520 wchars = 1040 bytes)
    st = GdipSaveImageToFile(bm, g_clip_wpath, g_png_clsid, 0);
    GdipDisposeImage(bm);
    if st != 0 { return 0; }
    return 1;
}
# Fallback: CF_DIB hglobal -> a DDB HBITMAP (we own it). 0 = fail.
func gdip_dib_to_hbitmap(hdib: i64) -> i64 {
    lp = GlobalLock(hdib);
    if lp == 0 { return 0; }
    bisize  = load32(lp + 0);                           # biSize (40 = V3, 124 = V5)
    clrused = load32(lp + 32);                          # biClrUsed
    comp    = load32(lp + 16);                          # biCompression
    masks = 0;
    if comp == 3 { if bisize == 40 { masks = 12; } }    # BI_BITFIELDS (V3) -> 3 DWORD color masks before the pixels
    bits = lp + bisize + clrused * 4 + masks;           # pixels follow header + masks + color table
    hdc = GetDC(0);
    hbm = CreateDIBitmap(hdc, lp, 4, bits, lp, 0);      # CBM_INIT=4, DIB_RGB_COLORS=0
    ReleaseDC(0, hdc);
    GlobalUnlock(hdib);
    return hbm;
}
# Ctrl+V. 1 = an image was attached (caller swallows the key); 0 = no image (let text paste happen).
func do_paste_image() -> i64 {
    if load64(g_agent_busy) == 1 { return 0; }
    if IsClipboardFormatAvailable(2) == 0 {             # CF_BITMAP
        if IsClipboardFormatAvailable(8) == 0 { return 0; }   # nor CF_DIB -> not an image
    }
    if OpenClipboard(load64(gui_hwnd)) == 0 { return 0; }
    own_hbm = 0;
    hbm = GetClipboardData(2);                           # CF_BITMAP (clipboard-owned HBITMAP)
    if hbm == 0 {
        hdib = GetClipboardData(8);                     # CF_DIB fallback
        if hdib != 0 { hbm = gdip_dib_to_hbitmap(hdib); own_hbm = 1; }
    }
    if hbm == 0 { CloseClipboard(); return 0; }
    ui_exedir(g_clip_dir);
    ui_join(g_clip_png, g_clip_dir, s_ideclip);
    ok = gdip_hbitmap_to_png(hbm, g_clip_png);          # copies pixels -> safe to release after
    if own_hbm == 1 { DeleteObject(hbm); }              # only free the HBITMAP WE made (never the clipboard's)
    CloseClipboard();
    if ok == 0 { store64(g_has_image, 0); ide_chat_note(m_clipfail); return 1; }   # don't leave a stale prior attachment
    attach_image_path(g_clip_png);                      # reuse the file path: b64 + g_has_image + mime + note
    return 1;
}

# ---- New Project -> pick folder, scaffold main.ancl from the template, open it ----
func do_new_project() -> i64 {
    if ide_pick_folder(newproj_title) == 0 { return 0; }
    store64(g_loading, 1);
    str_copy(g_workspace, g_newdir);
    ui_join(g_proj_main, g_workspace, s_main);     # <dir>\main.ancl
    ui_join(g_tmpl_p, g_app_root, s_tmpl_console); # the bundled template
    tab_stash_current();                           # save the outgoing tab before swapping in the template
    ui_load_file_to_edit(g_tmpl_p, load64(gui_editor));   # template -> editor
    SendMessageA(load64(gui_editor), 177, 0, 0);          # EM_SETSEL(0,0): caret to top
    SendMessageA(load64(gui_editor), 194, 0, s_intent_ph);# EM_REPLACESEL: seed the @INTENT block (intent lives in source)
    ide_recolor();
    ui_save_edit_to_file(g_proj_main, load64(gui_editor)); # write it as main.ancl
    ide_refresh_tree();                            # show the new file
    ide_set_current(g_proj_main);
    update_lincol();
    tab_register(g_proj_main);                     # open it as a tab
    PostMessageA(load64(gui_hwnd), 0x8006, 0, 0);
    set_status(st_newproj);
    return 0;
}

func WndProc(hwnd: i64, msg: i64, wParam: i64, lParam: i64) -> i64 {
    if msg == 1 { create_controls(hwnd); return 0; }            # WM_CREATE

    if msg == 3 {                                              # WM_MOVE -> dismiss the completion popup (it's screen-anchored)
        if load64(g_comp_open) == 1 { comp_close(); }
        return 0;
    }
    if msg == 5 {                                              # WM_SIZE -> reflow
        if load64(g_comp_open) == 1 { comp_close(); }          # ...also dismiss on resize
        layout_controls(band(lParam, 65535), band(shr(lParam, 16), 65535));
        return 0;
    }

    if msg == 131 {                                          # WM_NCCALCSIZE: eat the frame -> client = whole window
        if wParam != 0 { return 0; }
        return DefWindowProcA(hwnd, msg, wParam, lParam);
    }
    if msg == 132 {                                          # WM_NCHITTEST: resize ring + caption buttons + drag
        hx = band(lParam, 65535);          if hx >= 32768 { hx = hx - 65536; }
        hy = band(shr(lParam, 16), 65535); if hy >= 32768 { hy = hy - 65536; }
        GetWindowRect(hwnd, g_wr);
        lx = hx - load32(g_wr + 0);  ly = hy - load32(g_wr + 4);
        ww = load32(g_wr + 8) - load32(g_wr + 0);
        wh = load32(g_wr + 12) - load32(g_wr + 4);
        inset = cap_top_inset();
        if ly >= inset { if ly < inset + CAP_H { if caption_hot_at(lx, ly) != 0 { return 1; } } }   # over a button -> HTCLIENT
        if IsZoomed(hwnd) == 0 {                             # resize ring (not when maximized)
            etop = 0; ebot = 0; elft = 0; ergt = 0;
            if ly < RSZ_B { etop = 1; }
            if ly >= wh - RSZ_B { ebot = 1; }
            if lx < RSZ_B { elft = 1; }
            if lx >= ww - RSZ_B { ergt = 1; }
            if etop == 1 { if elft == 1 { return 13; } if ergt == 1 { return 14; } return 12; }
            if ebot == 1 { if elft == 1 { return 16; } if ergt == 1 { return 17; } return 15; }
            if elft == 1 { return 10; }
            if ergt == 1 { return 11; }
        }
        if ly >= inset { if ly < inset + CAP_H { return 2; } }   # caption -> HTCAPTION (drag / dbl-click max / snap)
        return 1;                                                # HTCLIENT
    }
    if msg == 134 { return DefWindowProcA(hwnd, 134, wParam, 0 - 1); }   # WM_NCACTIVATE: suppress the deactivate line

    if msg == 512 {                                          # WM_MOUSEMOVE -> caption button hover
        mvx = band(lParam, 65535);          if mvx >= 32768 { mvx = mvx - 65536; }
        mvy = band(shr(lParam, 16), 65535); if mvy >= 32768 { mvy = mvy - 65536; }
        nh = caption_hot_at(mvx, mvy);
        if nh != load64(g_cap_hot) {
            store64(g_cap_hot, nh);
            GetClientRect(hwnd, g_cap_rc);
            store32(g_cap_rc + 0, 0); store32(g_cap_rc + 4, 0); store32(g_cap_rc + 12, cap_top_inset() + CAP_H);
            InvalidateRect(hwnd, g_cap_rc, 0);
            store32(g_cap_track + 0, 24); store32(g_cap_track + 4, 2);     # cbSize, TME_LEAVE
            store64(g_cap_track + 8, hwnd); store64(g_cap_track + 16, 0);
            TrackMouseEvent(g_cap_track);
        }
        return 0;
    }
    if msg == 160 {                                          # WM_NCMOUSEMOVE -> clear caption hover (cursor on the drag area)
        if load64(g_cap_hot) != 0 {
            store64(g_cap_hot, 0);
            GetClientRect(hwnd, g_cap_rc);
            store32(g_cap_rc + 0, 0); store32(g_cap_rc + 4, 0); store32(g_cap_rc + 12, cap_top_inset() + CAP_H);
            InvalidateRect(hwnd, g_cap_rc, 0);
        }
        return DefWindowProcA(hwnd, msg, wParam, lParam);
    }
    if msg == 675 {                                          # WM_MOUSELEAVE -> clear caption hover
        if load64(g_cap_hot) != 0 {
            store64(g_cap_hot, 0);
            GetClientRect(hwnd, g_cap_rc);
            store32(g_cap_rc + 0, 0); store32(g_cap_rc + 4, 0); store32(g_cap_rc + 12, cap_top_inset() + CAP_H);
            InvalidateRect(hwnd, g_cap_rc, 0);
        }
        return 0;
    }

    if msg == 44 {                                            # WM_MEASUREITEM (size owner-drawn menu items)
        mis = lParam;
        if load32(mis + 0) == 1 {                             # CtlType == ODT_MENU
            lbl = load64(mis + 24);                           # itemData = our label ptr
            store32(mis + 12, strlen(lbl) * 7 + 38);          # itemWidth (gutter + text + pad)
            store32(mis + 16, 24);                            # itemHeight
        }
        return 1;
    }

    if msg == 43 {                                            # WM_DRAWITEM
        lp = lParam;
        if load32(lp + 0) == 1 {                              # CtlType == ODT_MENU -> dark menu item
            mhdc = load64(lp + 32); mrc = lp + 40;
            sel = band(load32(lp + 16), 1);                   # ODS_SELECTED
            mbg = load64(thm_b_card); if sel != 0 { mbg = load64(thm_b_hover); }
            FillRect(mhdc, mrc, mbg);
            SetBkMode(mhdc, 1);
            mtc = TH_TEXT; if sel != 0 { mtc = TH_TEXT_BRT; }
            SetTextColor(mhdc, mtc);
            SelectObject(mhdc, load64(thm_f_ui));
            store32(g_menu_rc + 0, load32(mrc + 0) + 26); store32(g_menu_rc + 4, load32(mrc + 4));
            store32(g_menu_rc + 8, load32(mrc + 8) - 14);  store32(g_menu_rc + 12, load32(mrc + 12));
            mlbl = load64(lp + 56);
            mtab = 0 - 1; mk = 0;                             # split label at \t (accelerator)
            while load8(mlbl + mk) != 0 { if load8(mlbl + mk) == 9 { mtab = mk; break; } mk = mk + 1; }
            if mtab < 0 {
                DrawTextA(mhdc, mlbl, 0 - 1, g_menu_rc, 0x24);              # whole label, left
            } else {
                DrawTextA(mhdc, mlbl, mtab, g_menu_rc, 0x24);              # name, left
                if sel == 0 { SetTextColor(mhdc, TH_TEXT_DIM); }           # accel dimmer when not hovered
                DrawTextA(mhdc, mlbl + mtab + 1, 0 - 1, g_menu_rc, 0x26);  # accelerator, right (DT_RIGHT)
            }
            return 1;
        }
        istate = load32(lp + 16);
        st = 0;
        if band(istate, 1) != 0 { st = bor(st, 1); }          # ODS_SELECTED -> pressed
        if band(istate, 0x40) != 0 { st = bor(st, 2); }       # ODS_HOTLIGHT -> hover
        thm_draw_button(load64(lp + 32), lp + 40, btn_label(load32(lp + 4)), st);
        return 1;
    }

    if msg == 513 {                                          # WM_LBUTTONDOWN -> caption buttons (act on UP), then tabs
        lbx = band(lParam, 65535); lby = band(shr(lParam, 16), 65535);
        ch = caption_hot_at(lbx, lby);
        if ch != 0 { store64(g_cap_pressed, ch); SetCapture(hwnd); return 0; }   # commit on release, not on press
        if tabs_click(lbx, lby) == 1 { return 0; }
        return DefWindowProcA(hwnd, msg, wParam, lParam);
    }
    if msg == 514 {                                          # WM_LBUTTONUP -> fire the caption button if released over it
        cp = load64(g_cap_pressed);
        if cp != 0 {
            store64(g_cap_pressed, 0);
            ReleaseCapture();
            if caption_hot_at(band(lParam, 65535), band(shr(lParam, 16), 65535)) == cp { caption_do(cp); }
            return 0;
        }
        return DefWindowProcA(hwnd, msg, wParam, lParam);
    }

    if msg == 78 {                                            # WM_NOTIFY (0x4E)
        lpnm = lParam;
        ncd = load32(lpnm + 16);
        if ncd == 0xFFFFFE6E { on_tree_select(load64(lpnm + 136)); return 0; }       # TVN_SELCHANGEDA
        if ncd == 0x702 {                                                            # EN_SELCHANGE (RichEdit) -> line:col
            if load64(g_comp_open) == 1 { comp_close(); }                            # caret moved (e.g. mouse click) -> dismiss the completion popup
            update_lincol(); return 0;
        }
        if ncd == 0xFFFFFE66 { return rename_begin(lpnm); }                          # TVN_BEGINLABELEDITA
        if ncd == 0xFFFFFE65 { return rename_end(lpnm); }                            # TVN_ENDLABELEDITA
        if ncd == 0xFFFFFFFD { if load64(lpnm + 8) == 2201 { return rename_dblclick(); } }   # NM_DBLCLK on the tree -> rename a file
        return 0;
    }

    if msg == 273 {                                           # WM_COMMAND
        id = band(wParam, 65535);
        if id == 2301 { do_new(); }
        if id == 2302 { do_save(); }
        if id == 2303 { do_open_file(); }
        if id == 2305 { do_open_folder(); }
        if id == 2309 { do_save_as(); }
        if id == 2311 { do_new_project(); }
        if id == 2304 { ide_compile_current(); }
        if id == 2315 { do_fix_current(); }                                  # Build>Auto-Fix (mechanical)
        if id == 2360 { do_save_log(); }                                     # Save Log -> <workspace>\aether_output.log
        if id == 2361 { do_clear_log(); }                                    # Clear Log -> empty the Output pane
        if id == 2316 { do_ai_repair(); }                                    # Build>AI Repair (SC2)
        if id == 2307 { do_run(); }
        if id == 2312 { do_stop_run(); }                                     # Build>Stop Run
        if id == 2313 { do_view_asm(); }                                     # Build>View ASM
        if id == 2308 { settings_open(hwnd); }
        if id == 2397 { do_open_guide(); }                                   # Help>User Guide (HTML)
        if id == 2398 { MessageBoxA(hwnd, about_text, about_title, 0x40); }   # Help>About
        if id == 2705 { find_toggle(0); SetFocus(load64(gui_editor)); }       # Find bar: close (X)
        if id == 2399 { DestroyWindow(hwnd); }                               # File>Exit
        if id == 2320 { recent_menu_rebuild(); menu_drop(load64(gui_mb_file), load64(g_menu_file)); }   # File menu (refresh recents first)
        if id == 2321 { menu_drop(load64(gui_mb_build), load64(g_menu_build)); }   # Build menu
        if id == 2322 { menu_drop(load64(gui_mb_help),  load64(g_menu_help)); }    # Help menu
        if id == 2323 { menu_drop(load64(gui_mb_edit),  load64(g_menu_edit)); }    # Edit menu
        if id == 2340 { SendMessageA(load64(gui_editor), 0x0304, 0, 0); }          # Edit>Undo (WM_UNDO)
        if id == 2341 { SendMessageA(load64(gui_editor), 0x0454, 0, 0); }          # Edit>Redo (EM_REDO)
        if id == 2342 { SendMessageA(load64(gui_editor), 0x0300, 0, 0); }          # Edit>Cut
        if id == 2343 { SendMessageA(load64(gui_editor), 0x0301, 0, 0); }          # Edit>Copy
        if id == 2344 { SendMessageA(load64(gui_editor), 0x0302, 0, 0); }          # Edit>Paste
        if id == 2345 { SendMessageA(load64(gui_editor), 0xB1, 0, 0 - 1); }        # Edit>Select All (EM_SETSEL 0,-1)
        if id == 2346 { find_toggle(1); SetFocus(load64(gui_find_in)); }           # Edit>Find
        if id == 2347 { find_toggle(1); SetFocus(load64(gui_repl_in)); }           # Edit>Replace
        if id == 2314 { find_toggle(1); }                                          # command palette: Find / Replace
        if id >= 2330 { if id <= 2337 {                                            # Open Recent items
            ri = id - 2330;
            if ri < load64(g_recent_n) { ide_open_path(g_recent + ri * 272); }
        } }
        if id == 2603 { do_send_agent(); }
        if id == 2604 { do_stop_agent(); do_stop_run(); }                    # Stop = halt the agent AND any running program
        if id == 2606 { do_attach_image(); }                                 # vision: attach an image
        if id == 2702 { do_find_next(); }                                    # Find bar: Find
        if id == 2704 { do_replace(); }                                      # Find bar: Replace
        if id == 2101 {                                                                          # editor notifications
            ncode = band(shr(wParam, 16), 65535);
            if ncode == 768  {                                                                  # EN_CHANGE
                SetTimer(hwnd, 7, 250, 0); InvalidateRect(hwnd, g_gut_rc, 0);                     # recolor + gutter
                if load64(g_loading) == 0 { tab_mark_dirty(1); }                                  # a real edit (not a programmatic load) -> dirty
            }
            if ncode == 1538 {                                                                    # EN_VSCROLL
                InvalidateRect(hwnd, g_gut_rc, 0);                                                 # gutter follows the scroll
                # arm ONCE (don't reset each event) so the timer fires on a ~40ms cadence DURING the
                # scroll, incrementally painting newly-revealed lines (watermark) instead of waiting
                # for the scroll to settle -> no uncoloured-while-scrolling lag.
                if load64(g_in_recolor) == 0 { if load64(g_scroll_pend) == 0 { store64(g_scroll_pend, 1); SetTimer(hwnd, 8, 40, 0); } }
            }
        }
        return 0;
    }

    if msg == 275 {                                          # WM_TIMER
        if wParam == 7 {                                           # recolor after typing settles
            KillTimer(hwnd, 7);
            he7 = load64(gui_editor);
            cl7 = SendMessageA(he7, 14, 0, 0);                      # WM_GETTEXTLENGTH
            dl7 = cl7 - load64(g_prev_len);                         # length change since the last recolor
            if dl7 < 0 { dl7 = 0 - dl7; }
            store64(g_prev_len, cl7);                               # advance the baseline (both paths)
            if dl7 > 200 { ide_recolor(); }                         # big change (paste / large delete) -> full band recolor
            else { ide_recolor_typing(); }                          # normal typing -> FAST single-line recolor
        }
        if wParam == 8 { KillTimer(hwnd, 8); store64(g_scroll_pend, 0); ide_recolor_scroll(); }   # incremental: paint only newly-revealed lines (watermark) -> no scroll lag
        if wParam == 9 { KillTimer(hwnd, 9); pal_open(); }      # test hook: open the command palette
        if wParam == 10 { KillTimer(hwnd, 10); do_paste_image(); }   # test hook: clipboard paste-image
        return 0;
    }

    if msg == 32774 { store64(g_loading, 0); return 0; }     # WM_APP+6: programmatic load finished -> re-enable dirty tracking

    if msg == 32773 {                                         # WM_APP+5: build-and-run done
        ide_append_out(g_capbuf);                             # the build result / compiler errors
        if load64(g_run_ok) == 1 {
            ide_append_out(m_run_out);
            if load8(g_runout) != 0 { ide_append_out(g_runout); } else { ide_append_out(m_run_nout); }
            int_to_str(g_run_num, load64(g_prog_exit));
            ide_append_out(nl_crlf); ide_append_out(m_run_exit); ide_append_out(g_run_num); ide_append_out(nl_crlf);
            set_status(st_runok);
        } else {
            ide_append_out(m_run_fail);
            set_status(st_runfail);
            ide_jump_error(g_capbuf);                         # select + scroll to the failing line
            offer_autofix();                                  # build failed -> offer the smart-compiler fix
        }
        store64(g_compile_busy, 0);
        return 0;
    }

    if msg == 32769 {                                         # WM_APP+1: captured output ready
        ide_append_out(g_capbuf);
        ide_jump_error(g_capbuf);                             # select + scroll to the error line (no-op on success)
        ide_append_out(m_done);
        set_status(st_done);
        if load32(cap_exit) != 0 { offer_autofix(); }         # build failed -> offer the smart-compiler fix (busy still held)
        store64(g_compile_busy, 0);
        return 0;
    }

    if msg == 32770 {                                         # WM_APP+2: AI reply ready
        he2 = load64(gui_editor);
        SendMessageA(he2, 177, 0x7FFFFFFF, 0x7FFFFFFF);       # EM_SETSEL -> end
        SendMessageA(he2, 194, 0, ai_marker);                # EM_REPLACESEL -> suggestion marker
        SendMessageA(he2, 194, 0, g_ai_out);                 # EM_REPLACESEL -> the reply
        ide_recolor();
        set_status(st_aireply);
        store64(g_ai_busy, 0);
        return 0;
    }

    if msg == 32771 {                                        # WM_APP+3: agent transcript ready
        chat_refresh();
        if load64(g_agent_done) == 1 {
            store64(g_agent_busy, 0);
            if load64(g_pending_apply) == 1 { set_status(st_proposed); }   # keep the review prompt visible
            else { set_status(st_agentdone); }
            InvalidateRect(load64(gui_badge), 0, 1);             # badge status -> idle
        }
        return 0;
    }

    if msg == 32772 {                                        # WM_APP+4: agent wrote the OPEN file ->
        if load8(g_curpath) != 0 {                           #   PREVIEW it + await an explicit 'apply'
            if path_eq(g_wpath, g_curpath) == 1 {            #   (don't silently overwrite the user's view)
                str_copy(g_pending_path, g_wpath);
                store64(g_pending_apply, 1);
                ui_load_file_to_edit(g_wpath, load64(gui_output));   # show the proposed content in OUTPUT
                ide_append_out(prev_hdr);                            # + a footer telling the user how to apply
                SendMessageA(load64(gui_output), 277, 7, 0);         # WM_VSCROLL SB_BOTTOM -> force the view to the footer (WM_SETTEXT above reset it to top; EM_SCROLLCARET under-scrolls a freshly-set big text)
                set_status(st_proposed);
            }
        }
        return 0;
    }

    if msg == 312 { SetTextColor(wParam, TH_TEXT); SetBkColor(wParam, TH_BG_PANEL); SetBkMode(wParam, 1); return load64(thm_b_panel); }   # WM_CTLCOLORSTATIC (status bar)
    if msg == 307 {                                          # WM_CTLCOLOREDIT (OPAQUE; tone-zoned)
        SetBkMode(wParam, 2); SetTextColor(wParam, TH_TEXT);
        if lParam == load64(gui_output)  { SetBkColor(wParam, TH_BG_DEEP);  return load64(thm_b_deep); }
        if lParam == load64(gui_chat_in) { SetBkColor(wParam, TH_BG_INPUT); return load64(thm_b_input); }
        SetBkColor(wParam, TH_BG_DEEP); return load64(thm_b_deep);
    }
    if msg == 308 { SetTextColor(wParam, TH_TEXT); SetBkColor(wParam, TH_BG_DEEP);  SetBkMode(wParam, 1); return load64(thm_b_deep); }    # WM_CTLCOLORLISTBOX

    if msg == 20 { return 1; }                                # WM_ERASEBKGND

    if msg == 15 {                                            # WM_PAINT
        hdc = BeginPaint(hwnd, gui_ps);
        GetClientRect(hwnd, g_rect);
        cw = load32(g_rect + 8);
        ch = load32(g_rect + 12);
        store32(g_full_rect + 0, 0); store32(g_full_rect + 4, 0);                # uniform dark canvas (cards float on it)
        store32(g_full_rect + 8, cw); store32(g_full_rect + 12, ch);
        FillRect(hdc, g_full_rect, load64(thm_b_panel));
        paint_caption(hdc);                                  # custom title bar (frameless)
        paint_gutter(hdc);                                   # line-number gutter (left of editor)
        paint_tabs(hdc);                                     # multi-file tab strip (above the editor)
        EndPaint(hwnd, gui_ps);
        return 0;
    }

    if msg == 2 {                                            # WM_DESTROY
        eng_stop();                                          # kill the Aether Engine server WE spawned (owned only)
        DeleteObject(load64(g_font));                        # theme GDI objects are freed on process exit
        PostQuitMessage(0);
        return 0;
    }

    return DefWindowProcA(hwnd, msg, wParam, lParam);
}

func main() -> i32 {
    hinst = GetModuleHandleA(0);
    store64(gui_hinst, hinst);
    OleInitialize(0);                                        # COM STA -> the folder picker's "Make New Folder" button
    cursor = LoadCursorA(0, 32512);
    theme_init();                                            # palette: brushes/pens/fonts
    thm_register_glowbtn(hinst);                             # custom GlowButton class
    thm_enable_dark_app();                                   # native dark scrollbars/combos
    store64(gui_brush_bg, load64(thm_b_panel));              # window canvas = darkest tone

    store32(gui_wndclass + 0,  80);
    store32(gui_wndclass + 4,  3);
    store64(gui_wndclass + 8,  &WndProc);
    store32(gui_wndclass + 16, 0);
    store32(gui_wndclass + 20, 0);
    store64(gui_wndclass + 24, hinst);
    store64(gui_wndclass + 32, 0);
    store64(gui_wndclass + 40, cursor);
    store64(gui_wndclass + 48, load64(gui_brush_bg));
    store64(gui_wndclass + 56, 0);
    store64(gui_wndclass + 64, clsname);
    store64(gui_wndclass + 72, 0);
    RegisterClassExA(gui_wndclass);

    hwnd = CreateWindowExA(0, clsname, title, 0x12CF0000, 60, 30, 1100, 720, 0, 0, hinst, 0);
    store64(gui_hwnd, hwnd);
    SetWindowPos(hwnd, 0, 0, 0, 0, 0, 0x27);                 # SWP_NOSIZE|NOMOVE|NOZORDER|FRAMECHANGED -> run WM_NCCALCSIZE
    store32(dwm_one, 1);
    DwmSetWindowAttribute(hwnd, 20, dwm_one, 4);             # DWMWA_USE_IMMERSIVE_DARK_MODE (harmless w/ no OS caption)
    hicon = LoadIconA(hinst, 1);                             # RT_GROUP_ICON id 1 (embedded code-bot)
    if hicon != 0 {
        SendMessageA(hwnd, 0x80, 0, hicon);                 # WM_SETICON ICON_SMALL (title bar)
        SendMessageA(hwnd, 0x80, 1, hicon);                 # WM_SETICON ICON_BIG (taskbar / alt-tab)
    }
    ShowWindow(hwnd, 1);
    UpdateWindow(hwnd);

    while 1 {
        r = GetMessageA(gui_msg, 0, 0, 0);
        if r == 0 { return 0; }
        skip = 0;
        if load32(gui_msg + 8) == 256 {                      # WM_KEYDOWN
            vk = load64(gui_msg + 16);
            ctrl = band(GetKeyState(0x11), 0x8000);
            shft = band(GetKeyState(0x10), 0x8000);
            if load64(g_pal_open) == 1 {                     # palette open: nav keys here, typing falls through to the filter
                if vk == 27 { pal_close(); skip = 1; }                                                    # Esc -> close
                if vk == 13 { pal_run_selected(); skip = 1; }                                             # Enter -> run selection
                if vk == 38 { pal_move(0 - 1); skip = 1; }                                                # Up
                if vk == 40 { pal_move(1); skip = 1; }                                                    # Down
            } else {
                if load64(g_comp_open) == 1 {                  # completion popup up: route nav keys, dismiss on anything else
                    cnav = 0;
                    if vk == 27 { comp_close();    skip = 1; cnav = 1; }       # Esc -> dismiss
                    if vk == 13 { comp_accept();   skip = 1; cnav = 1; }       # Enter -> insert selected
                    if vk == 9  { comp_accept();   skip = 1; cnav = 1; }       # Tab -> insert selected
                    if vk == 38 { comp_move(0 - 1); skip = 1; cnav = 1; }      # Up
                    if vk == 40 { comp_move(1);    skip = 1; cnav = 1; }       # Down
                    if cnav == 0 { comp_close(); }                            # any other key dismisses, then falls through
                }
                if vk == 83 { if ctrl != 0 {                                                                  # Ctrl+S / Ctrl+Shift+S
                    if shft != 0 { do_save_as(); } else { do_save(); } skip = 1; } }
                if vk == 66 { if ctrl != 0 { ide_compile_current(); skip = 1; } }                             # Ctrl+B
                if vk == 32 { if ctrl != 0 { ide_suggest(); skip = 1; } }                                      # Ctrl+Space = AI-native op-brain suggest
                if vk == 73 { if ctrl != 0 { if shft != 0 { ide_intent_plan(); skip = 1; } } }                  # Ctrl+Shift+I = Plan from Intent (router)
                if vk == 79 { if ctrl != 0 { do_open_file(); skip = 1; } }                                    # Ctrl+O
                if vk == 0x74 { do_run(); skip = 1; }                                                         # F5 = Build & Run
                if vk == 0x70 { do_open_guide(); skip = 1; }                                                   # F1 = open the user guide
                if vk == 80 { if ctrl != 0 { if shft != 0 { pal_open(); skip = 1; } } }                       # Ctrl+Shift+P = command palette
                if vk == 86 { if ctrl != 0 { if GetFocus() == load64(gui_chat_in) { if do_paste_image() == 1 { skip = 1; } } } }   # Ctrl+V in chat = paste image for vision; elsewhere = normal text paste
                if vk == 13 { if shft == 0 { if GetFocus() == load64(gui_chat_in) { do_send_agent(); skip = 1; } } }  # Enter in chat = Send (Shift+Enter = newline)
                if vk == 13 { if GetFocus() == load64(gui_find_in) { do_find_next(); skip = 1; } }                  # Enter in find box = Find Next
                if vk == 70 { if ctrl != 0 { if shft != 0 { ide_frame_id(); } else { find_toggle(1); } skip = 1; } }   # Ctrl+F = find bar; Ctrl+Shift+F = identify captured frame (learned brain)
                if vk == 65 { if ctrl != 0 { if shft != 0 { ide_anomaly_check(); skip = 1; } } }                      # Ctrl+Shift+A = anomaly-check the pasted frame (edge-IDS brain)
                if vk == 27 { if load64(g_find_shown) == 1 { find_toggle(0); skip = 1; } }                          # Esc = close find bar
            }
        }
        if skip == 0 {
            TranslateMessage(gui_msg);
            DispatchMessageA(gui_msg);
        }
    }
    return 0;
}
