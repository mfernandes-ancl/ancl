s_intent_ph:   str = "# @INTENT\r\n# goal: (describe what to build, then press Ctrl+Shift+I)\r\n# skills: \r\n\r\n";
m_plan_hdr:    str = "\n[AI] intent plan (router):\n";
m_plan_next:   str = "\nNEXT: (1) Ctrl+B builds the skeleton.  (2) The Aether Agent (right) is pre-loaded with your goal -- review & press Send to generate it (the compiler verifies each step).\n";
s_agent_pre:   str = "Implement this as a native ANCL program (CRT-free, kernel32/core_lib only). Goal: ";
st_nogoal:     str = "Add a '# goal:' line under # @INTENT, then Ctrl+Shift+I";
st_planned:    str = "Intent routed -- Agent pre-loaded; press Send (or Ctrl+B to build)";
m_compiling: str = "[compile] running ancl_compiler.exe ...\n";
m_nofile:   str = "[compile] no file open - select one in the tree first.\n";
m_done:     str = "[compile] done.\n";

# ---- Smart compiler: mechanical auto-fix (SC1) + AI repair (SC2) ----------
s_fix_dry:    str = "\" --fix \"";          # ->  "<compiler>" --fix "<src>"
s_fix_apply:  str = "\" --fix --write \"";  # ->  "<compiler>" --fix --write "<src>"
m_fixing:     str = "[fix] checking with the self-correcting compiler ...\r\n";
m_fix_none:   str = "[fix] no mechanical fixes found - the source is clean (or needs AI repair).\r\n";
m_fix_cancel: str = "[fix] cancelled - no changes written.\r\n";
fix_q_a:      str = "Apply ";
fix_q_b:      str = " proposed fix(es)?\r\n\r\nThe details are in the output pane.  Your original is kept as a .bak file.";
fix_q_title:  str = "Aether Auto-Fix";
g_fix_msg:    buf = 320;          # MessageBox confirm text (built with the count)
g_fix_num:    buf = 16;           # int_to_str scratch
# SC2 (AI repair) -- a templated agent turn built from the live compiler errors.
m_rep_clean:  str = "[ai-repair] the current file already compiles - nothing to repair.\r\n";
m_rep_start:  str = "[ai-repair] handing the compiler errors to the AI agent ...\r\n";
rep_echo:     str = "Fix the compile errors in the current file.";
rep_pre:      str = "The ANCL source file at this path fails to compile:\r\nPath: ";
rep_mid:      str = "\r\n\r\nThe native compiler reports:\r\n";
rep_post:     str = "\r\n\r\nRead that file with read_file, fix ONLY what is needed to make it compile, and write the corrected source back to the SAME path with write_file. Keep the program's intent. Then briefly say what you changed.";
s_bak_ext:    str = ".bak";        # AI-repair backup suffix appended to the full path
g_repair_bak: buf = 720;
# #2 "learn from errors": log accepted (broken -> compiler-error -> fix) triples from real editor
# use into <workspace>\errfix_log.txt. Delimiter-block format (no JSON escaping) -> easy to convert
# to JSONL later; feeds the SAME fuel loop as the synthetic generator (the compiler is a free labeler).
s_logname:    str = "\\errfix_log.txt";
lr_hdr:       str = "\n===ERRFIX kind=";
lr_src:       str = "\nsrc=";
lr_err:       str = "\n---ERROR---\n";
lr_broken:    str = "\n---BROKEN---\n";
lr_fix:       str = "\n---FIX---\n";
lr_end:       str = "\n---END---\n";
k_autofix:    str = "autofix";
k_airepair:   str = "airepair";
g_logpath:    buf = 720;           # <workspace>\errfix_log.txt
g_logrec:     buf = 2048;          # small header/separator scratch (built then appended)
g_repair_pending: buf = 8;         # 1 = the pending agent proposal is an AI-repair (log on apply)
g_repair_err: buf = 16384;         # stashed bounded compiler errors for the pending repair triple
m_rep_bak:    str = "[ai-repair] your original was backed up as ";
# auto-offer-fix when a build fails -- a non-modal RED hint in the output pane (never blocks)
m_autofix_hint: str = "[fix] No mechanical fix found - try Build > AI Repair, or type 'repair' in chat.\r\n";
autofix_h_a:  str = "[fix] ";
autofix_h_b:  str = " mechanical fix(es) available - click Fix or type 'fix' to auto-heal.\r\n";
g_out_sel:    buf = 8;             # CHARRANGE scratch (EM_EXGETSEL) for coloring an output run
# Anthropic single-shot: prepend the ANCL primer so Claude knows the language
sys_sep:      str = "\r\n\r\n--- USER REQUEST ---\r\n\r\n";

# ---- File/Project dialogs (Phase A) -------------------------------------
lbl_open:    str = "Open";
