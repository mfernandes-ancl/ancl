s_tmpl_min:     str = "\\templates\\minimal_window.ancl";
s_src_lexer:    str = "\\src\\lexer.ancl";
s_untitled:     str = "\\untitled.ancl";
s_bs1:          str = "\\";                       # path separator (ui_join is a plain concat: suffix carries the sep)
q:          str = "\"";
qspq:       str = "\" \"";
s_completeexe: str = "\\complete.exe";        # AI-native op-brain completer (next to ancl_compiler.exe)
s_protomodel:  str = "ancl_ops_proto.dna";    # the protocol-specialist op-brain (staged in the bin); argv[2] to complete.exe
s_ws2marker:   str = "ws2_32";                # protocol/socket signal in the buffer -> route Ctrl+Space to the protocol brain
s_opsname:     str = "\\_suggest.ops";        # temp op-seq for a completion request
s_ctxname:     str = "\\_suggest_ctx.ancl";   # M5b slice 2: up-to-caret context source (auto-balanced)
s_err_needle:  str = "error:";                # dump-ops parse-fail marker -> caret fallback
s_dumpops:     str = " --dump-ops";
m_sug_hdr:     str = "\n[AI] next-structure suggestions (op-brain):\n";
m_brain_proto: str = "[AI] brain: PROTOCOL specialist (ws2_32 detected)\n";
m_brain_code:  str = "[AI] brain: ANCL coding\n";
st_suggest:    str = "AI suggestions ready (Ctrl+Space)";
s_intentexe:   str = "\\intent_plan.exe";       # IF1 intent planner (next to complete.exe)
s_protoeq:     str = "protocol=";               # intent_plan emits this when a protocol is named
s_func_kw:     str = "func ";                   # editor "has real code" probes (don't clobber)
s_atcode_kw:   str = "@CODE";
s_starters:    str = "\\starters\\";            # bundled per-protocol starter clients (under app root)
s_client_suf:  str = "_client.ancl";
st_starter:    str = "Protocol starter loaded - edit the CONFIG block, COMPILE, RUN. Ctrl+Space to extend.";
s_frameidexe:  str = "\\frame_id.exe";          # learned frame->protocol-ID tool (next to intent_plan.exe)
s_anomexe:     str = "\\anomaly_check.exe";     # edge-IDS anomaly brain: paste a frame -> normal/anomaly + why
m_anom_hdr:    str = "[ANOMALY-CHECK]\r\n";
m_frameid_hdr: str = "\n[FRAME-ID] ";           # Output-pane header for a frame identification
st_frame_none: str = "No protocol identified - paste a captured frame's hex bytes into the editor, then Ctrl+Shift+F.";
st_logsaved:   str = "Output log saved to the workspace (aether_output.log).";
st_logclear:   str = "Output log cleared.";
st_logfail:    str = "Could not write the log file.";
