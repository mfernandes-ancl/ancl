ed_seed:    str = "# Welcome to Aether Studio - a native ANCL IDE, written in ANCL.\r\n#\r\n#   - Click a file in the tree on the left to open it.\r\n#   - Ctrl+S saves.  Ctrl+B (or the Compile button) builds the current file.\r\n#   - Ctrl+Space  = AI autocomplete (local op-brain; suggestions in Output).\r\n#   - Ctrl+Shift+I = Plan from Intent (describe a goal in an # @INTENT block\r\n#                    -> the router classifies it + pre-loads the Aether Agent).\r\n#   - New starts a fresh console app from a template.\r\n#\r\n# The compiler's stdout/stderr stream into the output pane below.\r\n";

s_compiler:     str = "\\ancl_compiler.exe";
s_ideout:       str = "\\_ide_build.exe";
