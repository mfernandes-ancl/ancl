bench_pfx:   str = "recolor x5 total = ";
bench_sfx:   str = " ms\r\n";
env_openf:   str = "AETHER_IDE_OPENFILE";     # test hook: open this file in the editor at startup
env_rntest:  str = "AETHER_IDE_RENAMETEST";   # test hook: run the rename logic on this file, write rename_test.txt
env_outtest: str = "AETHER_IDE_OUTTEST";      # test hook: ide_out_path(<this path>) -> write bin\out_test.txt + exit
ot_bindir:   str = "bindir=";
ot_outp:     str = "\noutp=";
ot_asmb:     str = "\nasm_bin=";
ot_asms:     str = "\nasm_src=";
ot_dummy:    str = "; dummy listing for the move test\n";
ot_res_file: str = "\\out_test.txt";
