# =====================================================================
#  settings.ancl  -  Aether Studio "LLM Settings" panel + config store.
#
#  Owns:
#    - the LLM settings STATE (backend choice + per-backend url/model)
#    - a tiny key=value config file next to the exe (NON-SECRET only;
#      API keys are read from env vars at request time, never stored)
#    - the dark "LLM Settings" popup window (own class + WndProc), with a
#      backend dropdown, base-URL field, an editable model combo, and a
#      "Refresh models" button that lists installed Ollama models
#      (transport.ancl::ollama_tags -> GET /api/tags).
#
#  Backend codes: 0 Ollama (local) / 1 OpenAI-compatible / 2 Anthropic /
#  3 ANCL agent (the local agentic loop) / 4 Local Brain (ANCL) /
#  5 Aether Engine (local) -- the pure-ANCL LLM engine, Ollama-compatible
#    wire, server lifecycle owned by engine_host.ancl.
# =====================================================================
import "../../../core_lib/win32_api.ancl";
import "UI_controls.ancl";
import "transport.ancl";
import "engine_host.ancl";
import "theme.ancl";

extern "gdi32.dll"  CreateFontA -> ptr;        # merges with main.ancl's identical decl
extern "dwmapi.dll" DwmSetWindowAttribute;     # immersive dark title bar
extern "user32.dll" CreatePopupMenu -> ptr;    # Lens-style grouped options menu (merges w/ main)
extern "user32.dll" AppendMenuA;
extern "user32.dll" TrackPopupMenu;
extern "user32.dll" DestroyMenu;
extern "user32.dll" GetCursorPos;
extern "user32.dll" GetWindowRect;             # center the dialog on the Studio window (merges w/ main)
extern "user32.dll" SetWindowPos;

