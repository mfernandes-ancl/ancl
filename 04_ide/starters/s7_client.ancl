# s7_client.ancl - Siemens S7comm DB read/write/poll STARTER. 100% CRT-free, zero-dep.
# A complete, compilable client: edit the CONFIG block, COMPILE, RUN. Then extend it -
# Ctrl+Space (the op-brain) knows the ANCL idioms. Defaults to READ (CFG_OP=0);
# set CFG_OP=1 to write g_wq[0] into DBx.DBWy. Loaded by Aether Studio for S7 intent.
extern "ws2_32.dll" connect;
extern "ws2_32.dll" setsockopt;
extern "kernel32.dll" Sleep;

@DATA
mInfo: str = "[s7] Siemens S7 client (ANCL starter)";
mErr:  str = "[s7] connect failed - check IP / port / cable.";
mNo:   str = "[s7] no / short reply.";
mHs1:  str = "[s7] COTP connection confirmed.";
mHs2:  str = "[s7] S7 communication setup OK.";
mHf:   str = "[s7] handshake failed - not an S7 endpoint?";
mReg:  str = "[s7] DB";
mDot:  str = ".DBW";
mEq:   str = " = ";
mWr:   str = "[s7] write confirmed - DB";
mWr2:  str = " byte offset ";
mRc:   str = "[s7] device item/error code = ";
nl:    str = "\r\n";
# ==== CONFIG - edit these ====
CFG_IP0:  i64 = 127;    # target IP, octet 1
CFG_IP1:  i64 = 0;      #   octet 2
CFG_IP2:  i64 = 0;      #   octet 3
CFG_IP3:  i64 = 1;      #   octet 4   (127.0.0.1 = localhost)
CFG_PORT: i64 = 102;    # S7 / ISO-on-TCP port (standard 102)
CFG_TDST: i64 = 258;    # COTP destination TSAP (rack/slot; 0x0102 = rack0 slot2)
CFG_DB:   i64 = 1;      # data block number
CFG_ADDR: i64 = 0;      # byte offset within the DB
CFG_COUNT: i64 = 1;     # how many DBW words to read
CFG_OP:   i64 = 0;      # 0 = read, 1 = write g_wq[0]
CFG_NV:   i64 = 1;      # number of words to write (when CFG_OP=1)
CFG_MS:   i64 = 0;      # poll interval ms (0 = one-shot)
# =============================
g_wsa: buf = 512;
g_addr: buf = 16;
g_tmo: buf = 8;
g_req: buf = 300;
g_buf: buf = 600;
g_wq: buf = 128;

@CODE
func recv_n(s: i64, dst: i64, n: i64) -> i64 {
    got = 0;
    while got < n {
        r = recv(s, dst + got, n - got, 0);
        if r <= 0 { return 0 - 1; }
        got = got + r;
    }
    return n;
}
func recv_tpkt(s: i64) -> i64 {
    if recv_n(s, g_buf, 4) < 0 { return 0 - 1; }
    tl = load8(g_buf + 2) * 256 + load8(g_buf + 3);
    if tl < 7 { return 0 - 1; }
    if tl > 590 { tl = 590; }
    if recv_n(s, g_buf + 4, tl - 4) < 0 { return 0 - 1; }
    return tl;
}
func s7_hello(s: i64) -> i64 {
    store8(g_req+0,0x03); store8(g_req+1,0x00); store8(g_req+2,0x00); store8(g_req+3,0x16);
    store8(g_req+4,0x11); store8(g_req+5,0xE0); store8(g_req+6,0x00); store8(g_req+7,0x00);
    store8(g_req+8,0x00); store8(g_req+9,0x01); store8(g_req+10,0x00); store8(g_req+11,0xC0);
    store8(g_req+12,0x01); store8(g_req+13,0x0A); store8(g_req+14,0xC1); store8(g_req+15,0x02);
    store8(g_req+16,0x01); store8(g_req+17,0x00); store8(g_req+18,0xC2); store8(g_req+19,0x02);
    store8(g_req+20, band(shr(CFG_TDST,8),255)); store8(g_req+21, band(CFG_TDST,255));
    if send(s, g_req, 22, 0) <= 0 { return 0; }
    if recv_tpkt(s) < 0 { return 0; }
    if load8(g_buf + 5) != 0xD0 { return 0; }
    syscall 1, mHs1, nl;
    store8(g_req+0,0x03); store8(g_req+1,0x00); store8(g_req+2,0x00); store8(g_req+3,0x19);
    store8(g_req+4,0x02); store8(g_req+5,0xF0); store8(g_req+6,0x80); store8(g_req+7,0x32);
    store8(g_req+8,0x01); store8(g_req+9,0x00); store8(g_req+10,0x00); store8(g_req+11,0x04);
    store8(g_req+12,0x00); store8(g_req+13,0x00); store8(g_req+14,0x08); store8(g_req+15,0x00);
    store8(g_req+16,0x00); store8(g_req+17,0xF0); store8(g_req+18,0x00); store8(g_req+19,0x00);
    store8(g_req+20,0x01); store8(g_req+21,0x00); store8(g_req+22,0x01); store8(g_req+23,0x03);
    store8(g_req+24,0xC0);
    if send(s, g_req, 25, 0) <= 0 { return 0; }
    if recv_tpkt(s) < 0 { return 0; }
    if load8(g_buf + 8) != 0x03 { return 0; }
    syscall 1, mHs2, nl;
    return 1;
}
func txn(s: i64) -> i64 {
    ba = CFG_ADDR * 8;
    if CFG_OP == 0 {
        bc = CFG_COUNT * 2;
        store8(g_req+0,0x03); store8(g_req+1,0); store8(g_req+2,0); store8(g_req+3,31);
        store8(g_req+4,0x02); store8(g_req+5,0xF0); store8(g_req+6,0x80);
        store8(g_req+7,0x32); store8(g_req+8,0x01); store8(g_req+9,0); store8(g_req+10,0);
        store8(g_req+11,0); store8(g_req+12,0x05); store8(g_req+13,0); store8(g_req+14,0x0E);
        store8(g_req+15,0); store8(g_req+16,0);
        store8(g_req+17,0x04); store8(g_req+18,0x01);
        store8(g_req+19,0x12); store8(g_req+20,0x0A); store8(g_req+21,0x10); store8(g_req+22,0x02);
        store8(g_req+23, band(shr(bc,8),255)); store8(g_req+24, band(bc,255));
        store8(g_req+25, band(shr(CFG_DB,8),255)); store8(g_req+26, band(CFG_DB,255));
        store8(g_req+27,0x84);
        store8(g_req+28, band(shr(ba,16),255)); store8(g_req+29, band(shr(ba,8),255)); store8(g_req+30, band(ba,255));
        if send(s, g_req, 31, 0) <= 0 { return 0 - 1; }
    }
    if CFG_OP == 1 {
        nb = CFG_NV * 2;
        tl = 35 + nb;
        dl = 4 + nb;
        store8(g_req+0,0x03); store8(g_req+1,0); store8(g_req+2, band(shr(tl,8),255)); store8(g_req+3, band(tl,255));
        store8(g_req+4,0x02); store8(g_req+5,0xF0); store8(g_req+6,0x80);
        store8(g_req+7,0x32); store8(g_req+8,0x01); store8(g_req+9,0); store8(g_req+10,0);
        store8(g_req+11,0); store8(g_req+12,0x06); store8(g_req+13,0); store8(g_req+14,0x0E);
        store8(g_req+15, band(shr(dl,8),255)); store8(g_req+16, band(dl,255));
        store8(g_req+17,0x05); store8(g_req+18,0x01);
        store8(g_req+19,0x12); store8(g_req+20,0x0A); store8(g_req+21,0x10); store8(g_req+22,0x02);
        store8(g_req+23, band(shr(nb,8),255)); store8(g_req+24, band(nb,255));
        store8(g_req+25, band(shr(CFG_DB,8),255)); store8(g_req+26, band(CFG_DB,255));
        store8(g_req+27,0x84);
        store8(g_req+28, band(shr(ba,16),255)); store8(g_req+29, band(shr(ba,8),255)); store8(g_req+30, band(ba,255));
        store8(g_req+31,0); store8(g_req+32,0x04);
        bl = nb * 8;
        store8(g_req+33, band(shr(bl,8),255)); store8(g_req+34, band(bl,255));
        i = 0;
        while i < CFG_NV {
            v = load64(g_wq + i*8);
            store8(g_req+35+i*2, band(shr(v,8),255)); store8(g_req+36+i*2, band(v,255));
            i = i + 1;
        }
        if send(s, g_req, tl, 0) <= 0 { return 0 - 1; }
    }
    if recv_tpkt(s) < 0 { syscall 1, mNo, nl; return 0 - 1; }
    er = load8(g_buf + 17) * 256 + load8(g_buf + 18);
    if er != 0 { syscall 1, mRc, er, nl; return 0; }
    rc = load8(g_buf + 21);
    if rc != 255 { syscall 1, mRc, rc, nl; return 0; }
    if CFG_OP == 0 {
        i = 0;
        while i < CFG_COUNT {
            v = load8(g_buf + 25 + i*2) * 256 + load8(g_buf + 26 + i*2);
            ww = CFG_ADDR + i*2;
            syscall 1, mReg, CFG_DB, mDot, ww, mEq, v, nl;
            i = i + 1;
        }
    } else {
        syscall 1, mWr, CFG_DB, mWr2, CFG_ADDR, nl;
    }
    return 0;
}
func main() -> i32 {
    syscall 1, mInfo, nl;
    WSAStartup(514, g_wsa);
    s = socket(2, 1, 6);
    store16(g_addr + 0, 2);
    store16(g_addr + 2, htons(CFG_PORT));
    store32(g_addr + 4, CFG_IP0 + shl(CFG_IP1,8) + shl(CFG_IP2,16) + shl(CFG_IP3,24));
    store64(g_addr + 8, 0);
    if connect(s, g_addr, 16) != 0 { syscall 1, mErr, nl; closesocket(s); return 1; }
    store32(g_tmo, 3000);
    setsockopt(s, 65535, 4102, g_tmo, 4);
    if s7_hello(s) == 0 { syscall 1, mHf, nl; closesocket(s); return 1; }
    store64(g_wq + 0, 777);
    while 1 {
        if txn(s) < 0 { break; }
        if CFG_MS == 0 { break; }
        Sleep(CFG_MS);
    }
    closesocket(s);
    return 0;
}
