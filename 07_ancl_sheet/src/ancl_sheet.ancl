@CODE

func app_last_bs(s: i64) -> i64 {
    i = 0; last = 0 - 1;
    while 1 {
        c = load8(s + i);
        if c == 0 { return last; }
        if c == 92 { last = i; }
        i = i + 1;
    }
    return last;
}

func app_exedir(dst: i64) -> i64 {
    GetModuleFileNameA(0, g_exedir, 600);
    bs = app_last_bs(g_exedir);
    if bs < 0 { store8(dst, 0); return 0; }
    memcpy(dst, g_exedir, bs);
    store8(dst + bs, 0);
    return bs;
}

func app_join(dst: i64, base: i64, suffix: i64) -> i64 {
    p = str_copy(dst, base);
    str_copy(p, suffix);
    return 0;
}

func app_parse_int(s: i64) -> i64 {
    p = s;
    while load8(p) == 32 || load8(p) == 9 { p = p + 1; }
    v = 0;
    while load8(p) >= 48 && load8(p) <= 57 {
        v = v * 10 + load8(p) - 48;
        p = p + 1;
    }
    return v;
}

func app_u64_text(v: i64, dst: i64) -> i64 {
    p = nf_u64dec(v, dst);
    store8(p, 0);
    return p;
}

func app_i64_text(v: i64, dst: i64) -> i64 {
    p = dst;
    if v < 0 {
        store8(p, 45);
        p = p + 1;
        v = 0 - v;
    }
    p = nf_u64dec(v, p);
    store8(p, 0);
    return p;
}

func app_tolower(c: i64) -> i64 {
    if c >= 65 { if c <= 90 { return c + 32; } }
    return c;
}

func app_strcmp_i(a: i64, b: i64) -> i64 {
    i = 0;
    while 1 {
        ca = app_tolower(load8(a + i));
        cb = app_tolower(load8(b + i));
        if ca < cb { return 0 - 1; }
        if ca > cb { return 1; }
        if ca == 0 { return 0; }
        i = i + 1;
    }
    return 0;
}

func app_contains_i(hay: i64, needle: i64) -> i64 {
    if load8(needle) == 0 { return 1; }
    i = 0;
    while load8(hay + i) != 0 {
        j = 0;
        ok = 1;
        while load8(needle + j) != 0 {
            hc = app_tolower(load8(hay + i + j));
            nc = app_tolower(load8(needle + j));
            if hc == 0 { ok = 0; break; }
            if hc != nc { ok = 0; break; }
            j = j + 1;
        }
        if ok == 1 { return 1; }
        i = i + 1;
    }
    return 0;
}

func app_starts_i(s: i64, prefix: i64) -> i64 {
    i = 0;
    while load8(prefix + i) != 0 {
        if app_tolower(load8(s + i)) != app_tolower(load8(prefix + i)) { return 0; }
        i = i + 1;
    }
    return 1;
}

func app_ends_i(s: i64, suffix: i64) -> i64 {
    a = 0; while load8(s + a) != 0 { a = a + 1; }
    b = 0; while load8(suffix + b) != 0 { b = b + 1; }
    if b > a { return 0; }
    i = 0;
    while i < b { if app_tolower(load8(s + a - b + i)) != app_tolower(load8(suffix + i)) { return 0; } i = i + 1; }
    return 1;
}

func app_is_number(s: i64) -> i64 {
    p = s;
    while load8(p) == 32 || load8(p) == 9 { p = p + 1; }
    if load8(p) == 43 || load8(p) == 45 { p = p + 1; }
    digits = 0;
    while load8(p) >= 48 && load8(p) <= 57 { digits = digits + 1; p = p + 1; }
    if load8(p) == 46 {
        p = p + 1;
        while load8(p) >= 48 && load8(p) <= 57 { digits = digits + 1; p = p + 1; }
    }
    while load8(p) == 32 || load8(p) == 9 { p = p + 1; }
    if digits == 0 { return 0; }
    if load8(p) != 0 { return 0; }
    return 1;
}

func app_parse_number(s: i64) -> f64 {
    p = s;
    while load8(p) == 32 || load8(p) == 9 { p = p + 1; }
    sign = 1.0;
    if load8(p) == 45 { sign = 0.0 - 1.0; p = p + 1; }
    else if load8(p) == 43 { p = p + 1; }
    val = 0.0;
    while load8(p) >= 48 && load8(p) <= 57 { val = val * 10.0 + itof(load8(p) - 48); p = p + 1; }
    if load8(p) == 46 {
        p = p + 1; divisor = 10.0;
        while load8(p) >= 48 && load8(p) <= 57 { val = val + itof(load8(p) - 48) / divisor; divisor = divisor * 10.0; p = p + 1; }
    }
    return val * sign;
}

func app_cell_compare(a: i64, b: i64) -> i64 {
    if app_is_number(a) == 1 { if app_is_number(b) == 1 {
        av = app_parse_number(a); bv = app_parse_number(b);
        if av < bv { return 0 - 1; }
        if av > bv { return 1; }
        return 0;
    } }
    return app_strcmp_i(a, b);
}

func app_has_char(s: i64, ch: i64) -> i64 {
    i = 0;
    while load8(s + i) != 0 {
        if load8(s + i) == ch { return 1; }
        i = i + 1;
    }
    return 0;
}

func app_col_name(col: i64, dst: i64) -> i64 {
    store8(dst + 0, 65 + col);
    store8(dst + 1, 0);
    return dst;
}

func build_filter() -> i64 {
    p = gui_file_filter_first(g_filter, flt_a, flt_b);
    p = gui_file_filter_add(p, flt_c, flt_d);
    p = gui_file_filter_add(p, flt_e, flt_f);
    p = gui_file_filter_add(p, flt_g, flt_h);
    gui_file_filter_done(p);
    p = gui_file_filter_first(g_csv_filter, flt_c, flt_d);
    p = gui_file_filter_add(p, flt_g, flt_h);
    gui_file_filter_done(p);
    return 0;
}

func recent_slot(i: i64) -> i64 {
    return g_recent_paths + i * 700;
}

func recent_pathfile() -> i64 {
    app_exedir(g_recent_file);
    str_copy(g_recent_file + strlen(g_recent_file), recent_suffix);
    return g_recent_file;
}

func recent_load() -> i64 {
    store64(g_recent_count, 0);
    memset(g_recent_paths, 0, 2100);
    recent_pathfile();
    n = sheet_read_file(g_recent_file, g_recent_buf, 2200);
    if n < 0 { return 0; }
    p = g_recent_buf; count = 0;
    while load8(p) != 0 { if count >= 3 { break; }
        start = p;
        while load8(p) != 0 { if load8(p) == 13 || load8(p) == 10 { break; } p = p + 1; }
        len = p - start;
        if len > 0 { if len > 699 { len = 699; } memcpy(recent_slot(count), start, len); store8(recent_slot(count) + len, 0); count = count + 1; }
        if load8(p) == 13 { p = p + 1; }
        if load8(p) == 10 { p = p + 1; }
    }
    store64(g_recent_count, count);
    return count;
}

func recent_save() -> i64 {
    p = g_recent_buf; i = 0; count = load64(g_recent_count);
    while i < count {
        p = str_copy(p, recent_slot(i));
        store8(p, 13); p = p + 1; store8(p, 10); p = p + 1;
        i = i + 1;
    }
    store8(p, 0);
    recent_pathfile();
    return sheet_write_file(g_recent_file, g_recent_buf, p - g_recent_buf);
}

func recent_push(path: i64) -> i64 {
    if load8(path) == 0 { return 0; }
    count = load64(g_recent_count); found = 0 - 1; i = 0;
    while i < count { if app_strcmp_i(recent_slot(i), path) == 0 { found = i; break; } i = i + 1; }
    if found == 0 { return 1; }
    if found < 0 {
        if count < 3 { count = count + 1; }
        found = count - 1;
    }
    i = found;
    while i > 0 { cstr_copy_n(recent_slot(i), recent_slot(i - 1), 700); i = i - 1; }
    cstr_copy_n(recent_slot(0), path, 700);
    store64(g_recent_count, count);
    recent_save();
    return 1;
}

func recent_label(i: i64) -> i64 {
    dst = g_recent_labels + i * 720;
    store8(dst, 49 + i); store8(dst + 1, 46); store8(dst + 2, 32);
    cstr_copy_n(dst + 3, recent_slot(i), 717);
    return dst;
}

func sheet_build_file_menu() -> i64 {
    old = load64(g_menu_file);
    if old != 0 { DestroyMenu(old); }
    mf = gui_menu_create();
    gui_menu_item(mf, ID_NEW, mi_new);
    gui_menu_item(mf, ID_OPEN, mi_open);
    gui_menu_sep(mf);
    gui_menu_item(mf, ID_SAVE, mi_save);
    gui_menu_item(mf, ID_SAVEAS, mi_saveas);
    gui_menu_sep(mf);
    gui_menu_item(mf, ID_RECENT_NONE, mi_recent);
    gui_menu_enable(mf, ID_RECENT_NONE, 0);
    count = load64(g_recent_count); i = 0;
    while i < count { gui_menu_item(mf, ID_RECENT_1 + i, recent_label(i)); i = i + 1; }
    if count == 0 { gui_menu_item(mf, ID_RECENT_1, mi_recent_none); gui_menu_enable(mf, ID_RECENT_1, 0); }
    gui_menu_sep(mf);
    gui_menu_item(mf, ID_SAMPLE, mi_sample);
    gui_menu_item(mf, ID_CLOSE, mi_close);
    gui_menu_sep(mf);
    gui_menu_item(mf, ID_EXIT, mi_exit);
    store64(g_menu_file, mf);
    return mf;
}

func sheet_build_menus() -> i64 {
    sheet_build_file_menu();

    me = gui_menu_create();
    gui_menu_item(me, ID_UNDO, mi_undo);
    gui_menu_item(me, ID_REDO, mi_redo);
    gui_menu_sep(me);
    gui_menu_item(me, ID_COPY, mi_copy);
    gui_menu_item(me, ID_PASTE, mi_paste);
    gui_menu_item(me, ID_DELETE, mi_delete);
    gui_menu_item(me, ID_SELECTALL, mi_all);
    gui_menu_sep(me);
    gui_menu_item(me, ID_FIND, mi_find);
    gui_menu_item(me, ID_FINDNEXT, mi_next);
    gui_menu_item(me, ID_GOTO, mi_goto);
    store64(g_menu_edit, me);

    md = gui_menu_create();
    gui_menu_item(md, ID_READ, mi_read);
    gui_menu_item(md, ID_APPLY, mi_apply);
    gui_menu_sep(md);
    gui_menu_item(md, ID_FILTER, mi_filter);
    gui_menu_item(md, ID_CLEARFLT, mi_clearflt);
    gui_menu_sep(md);
    gui_menu_item(md, ID_INSROW, mi_insrow);
    gui_menu_item(md, ID_DELROW, mi_delrow);
    gui_menu_item(md, ID_INSCOL, mi_inscol);
    gui_menu_item(md, ID_DELCOL, mi_delcol);
    gui_menu_sep(md);
    gui_menu_item(md, ID_SORTA, mi_sorta);
    gui_menu_item(md, ID_SORTD, mi_sortd);
