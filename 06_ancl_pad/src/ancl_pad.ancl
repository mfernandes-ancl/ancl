@CODE

func pad_last_bs(s: i64) -> i64 {
    i = 0; last = 0 - 1;
    while 1 {
        c = load8(s + i);
        if c == 0 { return last; }
        if c == 92 { last = i; }
        i = i + 1;
    }
    return last;
}

func pad_exedir(dst: i64) -> i64 {
    GetModuleFileNameA(0, g_exe, 700);
    bs = pad_last_bs(g_exe);
    if bs < 0 { store8(dst, 0); return 0; }
    memcpy(dst, g_exe, bs);
    store8(dst + bs, 0);
    return bs;
}

func pad_join(dst: i64, base: i64, suffix: i64) -> i64 {
    p = str_copy(dst, base);
    str_copy(p, suffix);
    return 0;
}

func pad_parent(dst: i64, src: i64) -> i64 {
    bs = pad_last_bs(src);
    if bs < 0 { store8(dst, 0); return 0; }
    memcpy(dst, src, bs);
    store8(dst + bs, 0);
    return bs;
}

func pad_is_bin_dir(path: i64) -> i64 {
    n = strlen(path);
    if n < 3 { return 0; }
    if load8(path + n - 3) != 98 { return 0; }
    if load8(path + n - 2) != 105 { return 0; }
    if load8(path + n - 1) != 110 { return 0; }
    return 1;
}

func pad_lower_ascii(c: i64) -> i64 {
    if c >= 65 { if c <= 90 { return c + 32; } }
    return c;
}

func pad_ends_with_ci(path: i64, ext: i64) -> i64 {
    pn = strlen(path);
    en = strlen(ext);
    if en <= 0 { return 0; }
    if pn < en { return 0; }
    i = 0;
    while i < en {
        pc = pad_lower_ascii(load8(path + pn - en + i));
        ec = pad_lower_ascii(load8(ext + i));
        if pc != ec { return 0; }
        i = i + 1;
    }
    return 1;
}

func pad_is_ancl_path(path: i64) -> i64 {
    return pad_ends_with_ci(path, ext_ancl);
}

func pad_detect_lang(path: i64) -> i64 {
    if pad_ends_with_ci(path, ext_ancl) != 0 { return SYN_MODE_ANCL; }
    if pad_ends_with_ci(path, ext_py) != 0 { return SYN_MODE_PYTHON; }
    if pad_ends_with_ci(path, ext_cs) != 0 { return SYN_MODE_CSHARP; }
    if pad_ends_with_ci(path, ext_log) != 0 { return SYN_MODE_LOG; }
    if pad_ends_with_ci(path, ext_txt) != 0 { return SYN_MODE_TEXT; }
    if pad_ends_with_ci(path, ext_json) != 0 { return SYN_MODE_JSON; }
    if pad_ends_with_ci(path, ext_xml) != 0 { return SYN_MODE_XML; }
    if pad_ends_with_ci(path, ext_html) != 0 { return SYN_MODE_HTML; }
    if pad_ends_with_ci(path, ext_htm) != 0 { return SYN_MODE_HTML; }
    if pad_ends_with_ci(path, ext_sql) != 0 { return SYN_MODE_SQL; }
    if pad_ends_with_ci(path, ext_md) != 0 { return SYN_MODE_MARKDOWN; }
    if pad_ends_with_ci(path, ext_markdown) != 0 { return SYN_MODE_MARKDOWN; }
    if pad_ends_with_ci(path, ext_ini) != 0 { return SYN_MODE_INI; }
    if pad_ends_with_ci(path, ext_cfg) != 0 { return SYN_MODE_INI; }
    if pad_ends_with_ci(path, ext_ps1) != 0 { return SYN_MODE_POWERSHELL; }
    return SYN_MODE_TEXT;
}

func pad_effective_lang() -> i64 {
    mode = load64(g_lang_mode);
    if mode != SYN_MODE_AUTO { return mode; }
    return pad_detect_lang(g_curpath);
}

func pad_lang_label() -> i64 {
    mode = pad_effective_lang();
    if mode == SYN_MODE_ANCL { return st_lang_ancl; }
    if mode == SYN_MODE_PYTHON { return st_lang_py; }
    if mode == SYN_MODE_CSHARP { return st_lang_cs; }
    if mode == SYN_MODE_LOG { return st_lang_log; }
    if mode == SYN_MODE_JSON { return st_lang_json; }
    if mode == SYN_MODE_XML { return st_lang_xml; }
    if mode == SYN_MODE_HTML { return st_lang_html; }
    if mode == SYN_MODE_SQL { return st_lang_sql; }
    if mode == SYN_MODE_MARKDOWN { return st_lang_md; }
    if mode == SYN_MODE_INI { return st_lang_ini; }
    if mode == SYN_MODE_POWERSHELL { return st_lang_ps; }
    return st_lang_txt;
}

func pad_set_lang(mode: i64) -> i64 {
    store64(g_lang_mode, mode);
    i = load64(g_tab_current); if i >= 0 { store64(g_tab_lang + i * 8, mode); }
    pad_recolor_chars(0, 0 - 1);
    pad_update_status();
    SetFocus(load64(g_editor));
    return 0;
}

func pad_update_build_menu() -> i64 {
    mbu = load64(g_menu_build);
    if mbu == 0 { return 0; }
    en = pad_is_ancl_path(g_curpath);
    gui_menu_enable(mbu, ID_BUILD_COMPILE, en);
    gui_menu_enable(mbu, ID_BUILD_RUN, en);
    gui_menu_enable(mbu, ID_BUILD_FIX, en);
    if load64(g_hwnd) != 0 { DrawMenuBar(load64(g_hwnd)); }
    return 0;
}

func pad_init_paths() -> i64 {
    pad_exedir(g_exedir);
    if pad_is_bin_dir(g_exedir) == 1 {
        pad_parent(g_rootdir, g_exedir);
    } else {
        str_copy(g_rootdir, g_exedir);
    }
    pad_join(g_sample, g_rootdir, sample_suffix);
    pad_join(g_compiler, g_rootdir, s_compiler);
    pad_join(g_bindir, g_rootdir, s_bindir);
    CreateDirectoryA(g_bindir, 0);
    return 0;
}

func pad_read_file(path: i64, dst: i64, cap: i64) -> i64 {
    h = CreateFileA(path, 0x80000000, 1, 0, 3, 0x80, 0);
    if h == 0 - 1 { return 0 - 1; }
    ReadFile(h, dst, cap - 1, g_io, 0);
    CloseHandle(h);
    n = load32(g_io);
    store8(dst + n, 0);
    return n;
}

func pad_write_file(path: i64, src: i64, n: i64) -> i64 {
    h = CreateFileA(path, 0x40000000, 0, 0, 2, 0x80, 0);
    if h == 0 - 1 { return 0; }
    WriteFile(h, src, n, g_io, 0);
    CloseHandle(h);
    return 1;
}

func pad_rich_set_utf8(ed: i64, src: i64) -> i64 {
    store32(g_stex, 0); store32(g_stex + 4, TEXT_CP_UTF8);
    return SendMessageA(ed, 0x461, g_stex, src);
}

func pad_rich_get_utf8(ed: i64, dst: i64, cap: i64) -> i64 {
    if cap <= 0 { return 0 - 1; }
    memset(g_gtex, 0, 32); store32(g_gtex, cap); store32(g_gtex + 4, 0); store32(g_gtex + 8, TEXT_CP_UTF8);
    SendMessageA(ed, 0x45E, g_gtex, dst); store8(dst + cap - 1, 0); return strlen(dst);
}

func pad_read_document(path: i64, dst: i64, cap: i64) -> i64 {
    raw = load64(g_filebuf_p); n = pad_read_file(path, raw, PAD_FILE_CAP);
    if n < 0 { return 0 - 1; }
    enc = text_detect_encoding(raw, n); store64(g_detect_encoding, enc);
    count = text_decode_to_utf8(raw, n, enc, dst, cap, load64(g_wide_p), PAD_TAB_CAP);
    if count < 0 { return 0 - 1; }
    store64(g_detect_eol, text_detect_eol(dst)); return count;
}

func pad_encoding_label() -> i64 {
    enc = load64(g_encoding_mode);
    if enc == TEXT_ENC_ANSI { return st_enc_ansi; }
    if enc == TEXT_ENC_UTF8_BOM { return st_enc_utf8_bom; }
    if enc == TEXT_ENC_UTF16_LE { return st_enc_utf16; }
    return st_enc_utf8;
}

func pad_eol_label() -> i64 {
    eol = load64(g_eol_mode);
    if eol == TEXT_EOL_LF { return st_eol_lf; }
    if eol == TEXT_EOL_CR { return st_eol_cr; }
    return st_eol_crlf;
}

func pad_update_format_menu() -> i64 {
    me = load64(g_menu_encoding); ml = load64(g_menu_eol);
    if me != 0 {
        CheckMenuItem(me, ID_ENC_ANSI, 0); CheckMenuItem(me, ID_ENC_UTF8, 0); CheckMenuItem(me, ID_ENC_UTF8_BOM, 0); CheckMenuItem(me, ID_ENC_UTF16, 0);
        enc = load64(g_encoding_mode); id = ID_ENC_UTF8;
        if enc == TEXT_ENC_ANSI { id = ID_ENC_ANSI; }
        if enc == TEXT_ENC_UTF8_BOM { id = ID_ENC_UTF8_BOM; }
        if enc == TEXT_ENC_UTF16_LE { id = ID_ENC_UTF16; }
        CheckMenuItem(me, id, 8);
    }
    if ml != 0 {
        CheckMenuItem(ml, ID_EOL_CRLF, 0); CheckMenuItem(ml, ID_EOL_LF, 0); CheckMenuItem(ml, ID_EOL_CR, 0);
        eol = load64(g_eol_mode); id2 = ID_EOL_CRLF;
        if eol == TEXT_EOL_LF { id2 = ID_EOL_LF; }
        if eol == TEXT_EOL_CR { id2 = ID_EOL_CR; }
        CheckMenuItem(ml, id2, 8);
    }
    return 0;
}

func pad_mark_format_modified() -> i64 {
    i = load64(g_tab_current);
    if i >= 0 {
        store64(g_tab_encoding + i * 8, load64(g_encoding_mode)); store64(g_tab_eol + i * 8, load64(g_eol_mode));
        store64(g_tab_dirty + i * 8, 1);
    }
    rich_set_modified(load64(g_editor), 1); pad_tabs_refresh(); pad_update_format_menu(); pad_update_status(); pad_set_status(st_format_changed); SetFocus(load64(g_editor)); return 1;
}

func pad_set_encoding(enc: i64) -> i64 {
    if enc == load64(g_encoding_mode) { SetFocus(load64(g_editor)); return 0; }
    store64(g_encoding_mode, enc); return pad_mark_format_modified();
}

func pad_set_eol(eol: i64) -> i64 {
    if eol == load64(g_eol_mode) { SetFocus(load64(g_editor)); return 0; }
    store64(g_eol_mode, eol); return pad_mark_format_modified();
}

func pad_recent_slot(i: i64) -> i64 { return g_recent_paths + i * 700; }

func pad_recent_pathfile() -> i64 {
    n = pad_exedir(g_recent_file); str_copy(g_recent_file + n, recent_suffix); return g_recent_file;
}

func pad_recent_load() -> i64 {
    store64(g_recent_count, 0); memset(g_recent_paths, 0, 2100); pad_recent_pathfile();
    n = pad_read_file(g_recent_file, g_recent_buf, 2200); if n < 0 { return 0; }
    p = g_recent_buf; count = 0;
    while load8(p) != 0 { if count >= 3 { break; } start = p;
        while load8(p) != 0 { if load8(p) == 13 || load8(p) == 10 { break; } p = p + 1; }
        len = p - start; if len > 0 { if len > 699 { len = 699; } memcpy(pad_recent_slot(count), start, len); store8(pad_recent_slot(count) + len, 0); count = count + 1; }
        if load8(p) == 13 { p = p + 1; } if load8(p) == 10 { p = p + 1; }
    }
    store64(g_recent_count, count); return count;
}

func pad_recent_save() -> i64 {
    p = g_recent_buf; i = 0;
    while i < load64(g_recent_count) { p = str_copy(p, pad_recent_slot(i)); store8(p, 13); p = p + 1; store8(p, 10); p = p + 1; i = i + 1; }
    store8(p, 0); pad_recent_pathfile(); return pad_write_file(g_recent_file, g_recent_buf, p - g_recent_buf);
}

func pad_recent_push(path: i64) -> i64 {
    if load8(path) == 0 { return 0; } if strcmp(path, untitled) == 0 { return 0; } if strcmp(path, g_sample) == 0 { return 0; }
    count = load64(g_recent_count); found = 0 - 1; i = 0;
    while i < count { if strcmp(pad_recent_slot(i), path) == 0 { found = i; break; } i = i + 1; }
    if found == 0 { return 1; }
    if found < 0 { if count < 3 { count = count + 1; } found = count - 1; }
    i = found; while i > 0 { cstr_copy_n(pad_recent_slot(i), pad_recent_slot(i - 1), 700); i = i - 1; }
    cstr_copy_n(pad_recent_slot(0), path, 700); store64(g_recent_count, count); pad_recent_save(); return 1;
}

func pad_recent_label(i: i64) -> i64 {
    dst = g_recent_labels + i * 720; store8(dst, 49 + i); store8(dst + 1, 46); store8(dst + 2, 32);
    cstr_copy_n(dst + 3, pad_recent_slot(i), 717); return dst;
}

func pad_tab_path(i: i64) -> i64 { return g_tab_paths + i * 700; }
func pad_tab_text(i: i64) -> i64 { return load64(g_tab_texts + i * 8); }
func pad_tab_label(i: i64) -> i64 { return g_tab_labels + i * 180; }
func pad_bookmark_base(i: i64) -> i64 { return g_tab_bookmark_lines + i * PAD_BOOKMARK_CAP * 8; }

func pad_bookmarks_reset(i: i64) -> i64 {
    store64(g_tab_bookmark_count + i * 8, 0);
    return 0;
}

func pad_bookmarks_copy(dst: i64, src: i64) -> i64 {
    count = load64(g_tab_bookmark_count + src * 8);
    store64(g_tab_bookmark_count + dst * 8, count);
    d = pad_bookmark_base(dst); s = pad_bookmark_base(src); i = 0;
    while i < count { store64(d + i * 8, load64(s + i * 8)); i = i + 1; }
    return count;
}

func pad_tab_make_label(i: i64) -> i64 {
    dst = pad_tab_label(i); src = pad_tab_path(i); last = pad_last_bs(src); if last >= 0 { src = src + last + 1; }
    cstr_copy_n(dst, src, 176); p = dst + strlen(dst);
    if load64(g_tab_dirty + i * 8) != 0 { store8(p, 32); store8(p + 1, 42); store8(p + 2, 0); }
    return dst;
}

func pad_tabs_refresh() -> i64 {
    i = 0; count = load64(g_tab_count);
    while i < PAD_MAX_TABS {
        h = load64(g_tab_buttons + i * 8);
        hc = load64(g_tab_close_buttons + i * 8);
        if h != 0 {
            if i < count { SetWindowTextA(h, pad_tab_make_label(i)); ShowWindow(h, 1); InvalidateRect(h, 0, 1); if hc != 0 { ShowWindow(hc, 1); InvalidateRect(hc, 0, 1); } } else { ShowWindow(h, 0); if hc != 0 { ShowWindow(hc, 0); } }
        }
        i = i + 1;
    }
    if load64(g_hwnd) != 0 { GetClientRect(load64(g_hwnd), g_rect); pad_reflow(load32(g_rect + 8), load32(g_rect + 12)); InvalidateRect(load64(g_hwnd), 0, 0); }
    return 0;
}

func pad_tab_init(i: i64, path: i64, src: i64, dirty: i64, enc: i64, eol: i64) -> i64 {
    cstr_copy_n(pad_tab_path(i), path, 700); cstr_copy_n(pad_tab_text(i), src, PAD_TAB_CAP);
    store64(g_tab_dirty + i * 8, dirty); store64(g_tab_lang + i * 8, SYN_MODE_AUTO);
    store64(g_tab_encoding + i * 8, enc); store64(g_tab_eol + i * 8, eol);
    store64(g_tab_sel_a + i * 8, 0); store64(g_tab_sel_b + i * 8, 0);
    store64(g_tab_scroll_x + i * 8, 0); store64(g_tab_scroll_y + i * 8, 0); pad_bookmarks_reset(i); return 1;
}

func pad_tab_save_current() -> i64 {
    i = load64(g_tab_current); if i < 0 { return 0; } if i >= load64(g_tab_count) { return 0; }
    ed = load64(g_editor); if ed == 0 { return 0; }
    pad_rich_get_utf8(ed, pad_tab_text(i), PAD_TAB_CAP); cstr_copy_n(pad_tab_path(i), g_curpath, 700);
    store64(g_tab_dirty + i * 8, rich_get_modified(ed)); store64(g_tab_lang + i * 8, load64(g_lang_mode));
    store64(g_tab_encoding + i * 8, load64(g_encoding_mode)); store64(g_tab_eol + i * 8, load64(g_eol_mode));
    rich_get_sel(ed, g_sel); store64(g_tab_sel_a + i * 8, load32(g_sel)); store64(g_tab_sel_b + i * 8, load32(g_sel + 4));
    rich_get_scroll_pos(ed, g_scroll); store64(g_tab_scroll_x + i * 8, load32(g_scroll)); store64(g_tab_scroll_y + i * 8, load32(g_scroll + 4));
    return 1;
}

func pad_tab_load(i: i64) -> i64 {
    if i < 0 { return 0; } if i >= load64(g_tab_count) { return 0; }
    store64(g_tab_switching, 1); store64(g_tab_current, i); store64(g_lang_mode, load64(g_tab_lang + i * 8));
    store64(g_encoding_mode, load64(g_tab_encoding + i * 8)); store64(g_eol_mode, load64(g_tab_eol + i * 8));
    pad_set_path(pad_tab_path(i)); pad_set_text(pad_tab_text(i)); rich_set_modified(load64(g_editor), load64(g_tab_dirty + i * 8));
    store32(g_sel, load64(g_tab_sel_a + i * 8)); store32(g_sel + 4, load64(g_tab_sel_b + i * 8)); rich_exset_sel(load64(g_editor), g_sel);
    store32(g_scroll, load64(g_tab_scroll_x + i * 8)); store32(g_scroll + 4, load64(g_tab_scroll_y + i * 8)); rich_set_scroll_pos(load64(g_editor), g_scroll);
    store64(g_tab_switching, 0); pad_tabs_refresh(); pad_update_format_menu(); pad_update_status(); SetFocus(load64(g_editor)); return 1;
}

func pad_tab_activate(i: i64) -> i64 {
    if i == load64(g_tab_current) { SetFocus(load64(g_editor)); return 1; }
    pad_tab_save_current(); return pad_tab_load(i);
}

func pad_tab_find(path: i64) -> i64 {
    i = 0; while i < load64(g_tab_count) { if strcmp(pad_tab_path(i), path) == 0 { return i; } i = i + 1; } return 0 - 1;
}

func pad_tab_reuse_blank() -> i64 {
    if load64(g_tab_count) != 1 { return 0; } if load64(g_tab_current) != 0 { return 0; }
    if strcmp(g_curpath, untitled) != 0 { return 0; } if rich_get_modified(load64(g_editor)) != 0 { return 0; }
    if rich_get_text_length(load64(g_editor)) != 0 { return 0; } return 1;
}

func pad_tab_add(path: i64, src: i64, dirty: i64, enc: i64, eol: i64) -> i64 {
    pad_tab_save_current(); count = load64(g_tab_count); idx = count;
    if pad_tab_reuse_blank() != 0 { idx = 0; } else { if count >= PAD_MAX_TABS { pad_set_status(st_tab_limit); return 0; } store64(g_tab_count, count + 1); }
    pad_tab_init(idx, path, src, dirty, enc, eol); return pad_tab_load(idx);
}

func pad_tab_reload_current() -> i64 {
    i = load64(g_tab_current); if i < 0 { return 0; } n = pad_read_document(g_curpath, pad_tab_text(i), PAD_TAB_CAP); if n < 0 { return 0; }
    store64(g_tab_dirty + i * 8, 0); store64(g_tab_encoding + i * 8, load64(g_detect_encoding)); store64(g_tab_eol + i * 8, load64(g_detect_eol)); return pad_tab_load(i);
}

func pad_session_pathfile() -> i64 { n = pad_exedir(g_session_file); str_copy(g_session_file + n, session_suffix); return g_session_file; }

func pad_session_save() -> i64 {
    pad_tab_save_current(); p = g_session_buf; p = str_copy(p, "active:"); i = load64(g_tab_current);
    if i >= 0 { if strcmp(pad_tab_path(i), untitled) != 0 { p = str_copy(p, pad_tab_path(i)); } }
    store8(p, 13); store8(p + 1, 10); p = p + 2; i = 0;
    while i < load64(g_tab_count) { path = pad_tab_path(i); if strcmp(path, untitled) != 0 { p = str_copy(p, path); store8(p, 13); store8(p + 1, 10); p = p + 2; } i = i + 1; }
    store8(p, 0); pad_session_pathfile(); return pad_write_file(g_session_file, g_session_buf, p - g_session_buf);
}

func pad_session_restore() -> i64 {
    pad_session_pathfile(); n = pad_read_file(g_session_file, g_session_buf, 6400); if n <= 0 { return 0; }
    p = g_session_buf; active = g_load_path; store8(active, 0);
    if load8(p) == 97 { if load8(p + 6) == 58 { q = p + 7; e = q; while load8(e) != 0 { if load8(e) == 13 || load8(e) == 10 { break; } e = e + 1; } len = e - q; if len > 699 { len = 699; } memcpy(active, q, len); store8(active + len, 0); p = e; } }
    if load8(p) == 13 { p = p + 1; } if load8(p) == 10 { p = p + 1; }
    count = 0; chosen = 0;
    while load8(p) != 0 { if count >= PAD_MAX_TABS { break; } q = p; while load8(p) != 0 { if load8(p) == 13 || load8(p) == 10 { break; } p = p + 1; }
        len = p - q; if len > 0 { if len > 699 { len = 699; } memcpy(g_dialog, q, len); store8(g_dialog + len, 0);
            if pad_read_document(g_dialog, pad_tab_text(count), PAD_TAB_CAP) >= 0 { cstr_copy_n(pad_tab_path(count), g_dialog, 700); store64(g_tab_dirty + count * 8, 0); store64(g_tab_lang + count * 8, SYN_MODE_AUTO); store64(g_tab_encoding + count * 8, load64(g_detect_encoding)); store64(g_tab_eol + count * 8, load64(g_detect_eol)); if strcmp(g_dialog, active) == 0 { chosen = count; } count = count + 1; }
        }
        if load8(p) == 13 { p = p + 1; } if load8(p) == 10 { p = p + 1; }
    }
    if count == 0 { return 0; } store64(g_tab_count, count); store64(g_tab_current, 0 - 1); pad_tab_load(chosen); pad_set_status(st_session); return count;
}

func pad_recovery_manifest_path() -> i64 {
    n = pad_exedir(g_recovery_file); str_copy(g_recovery_file + n, recovery_suffix); return g_recovery_file;
}

func pad_recovery_new_path() -> i64 {
    n = pad_exedir(g_recovery_new); str_copy(g_recovery_new + n, recovery_new_suffix); return g_recovery_new;
}

func pad_recovery_snapshot_path(i: i64) -> i64 {
    n = pad_exedir(g_recovery_snap); p = str_copy(g_recovery_snap + n, recovery_snap_prefix);
    store8(p, 49 + i); p = p + 1; str_copy(p, recovery_snap_suffix); return g_recovery_snap;
}

func pad_recovery_clear() -> i64 {
    pad_recovery_manifest_path(); DeleteFileA(g_recovery_file); pad_recovery_new_path(); DeleteFileA(g_recovery_new);
    i = 0; while i < PAD_MAX_TABS { pad_recovery_snapshot_path(i); DeleteFileA(g_recovery_snap); i = i + 1; }
    store64(g_recovery_active, 0); return 1;
}

func pad_recovery_dirty_count() -> i64 {
    count = 0; i = 0; while i < load64(g_tab_count) { if load64(g_tab_dirty + i * 8) != 0 { count = count + 1; } i = i + 1; }
    return count;
}

func pad_recovery_save() -> i64 {
    if load64(g_editor) == 0 { return 0; }
    pad_tab_save_current(); if pad_recovery_dirty_count() == 0 { return pad_recovery_clear(); }
    p = str_copy(g_session_buf, recovery_magic); store8(p, 13); store8(p + 1, 10); p = p + 2;
    p = str_copy(p, "active:"); active = load64(g_tab_current); if active < 0 { active = 0; } p = nf_u64dec(active, p); store8(p, 13); store8(p + 1, 10); p = p + 2;
    i = 0; count = load64(g_tab_count);
    while i < count {
        pad_recovery_snapshot_path(i); text = pad_tab_text(i); if pad_write_file(g_recovery_snap, text, strlen(text)) == 0 { return 0; }
        dirty = load64(g_tab_dirty + i * 8); if dirty != 0 { store8(p, 49); } else { store8(p, 48); } store8(p + 1, 124);
        store8(p + 2, 48 + load64(g_tab_encoding + i * 8)); store8(p + 3, 124); store8(p + 4, 48 + load64(g_tab_eol + i * 8)); store8(p + 5, 124); p = p + 6;
        p = str_copy(p, pad_tab_path(i)); store8(p, 13); store8(p + 1, 10); p = p + 2; i = i + 1;
    }
    store8(p, 0); pad_recovery_new_path(); if pad_write_file(g_recovery_new, g_session_buf, p - g_session_buf) == 0 { return 0; }
    pad_recovery_manifest_path(); if MoveFileExA(g_recovery_new, g_recovery_file, 1) == 0 { return 0; }
    store64(g_recovery_active, 1); return 1;
}

func pad_recovery_magic_ok(p: i64) -> i64 {
    i = 0; while i < 8 { if load8(p + i) != load8(recovery_magic + i) { return 0; } i = i + 1; } return 1;
}

func pad_recovery_next_line(p: i64) -> i64 {
    while load8(p) != 0 { if load8(p) == 13 || load8(p) == 10 { break; } p = p + 1; }
    if load8(p) == 13 { p = p + 1; } if load8(p) == 10 { p = p + 1; } return p;
}

func pad_recovery_restore() -> i64 {
    pad_recovery_manifest_path(); n = pad_read_file(g_recovery_file, g_session_buf, 6400); if n <= 0 { return 0; }
    if pad_recovery_magic_ok(g_session_buf) == 0 { pad_recovery_clear(); return 0; }
    if MessageBoxA(load64(g_hwnd), recovery_prompt, recovery_title, 0x24) != 6 { pad_recovery_clear(); return 0; }
    p = pad_recovery_next_line(g_session_buf); active = 0;
    if load8(p) == 97 { if load8(p + 6) == 58 { active = str_to_int(p + 7); } }
    p = pad_recovery_next_line(p); count = 0;
    while load8(p) != 0 {
        if count >= PAD_MAX_TABS { break; }
        dirty = 0; if load8(p) == 49 { dirty = 1; }
        if load8(p + 1) != 124 { break; } if load8(p + 3) != 124 { break; } if load8(p + 5) != 124 { break; }
        enc = load8(p + 2) - 48; eol = load8(p + 4) - 48; if enc < 0 { enc = TEXT_ENC_UTF8; } if enc > TEXT_ENC_UTF16_LE { enc = TEXT_ENC_UTF8; } if eol < 0 { eol = TEXT_EOL_CRLF; } if eol > TEXT_EOL_CR { eol = TEXT_EOL_CRLF; }
        q = p + 6; e = q; while load8(e) != 0 { if load8(e) == 13 || load8(e) == 10 { break; } e = e + 1; }
        len = e - q; if len > 699 { len = 699; } memcpy(g_dialog, q, len); store8(g_dialog + len, 0);
        pad_recovery_snapshot_path(count); if pad_read_file(g_recovery_snap, pad_tab_text(count), PAD_TAB_CAP) >= 0 {
            cstr_copy_n(pad_tab_path(count), g_dialog, 700); store64(g_tab_dirty + count * 8, dirty); store64(g_tab_lang + count * 8, SYN_MODE_AUTO); store64(g_tab_encoding + count * 8, enc); store64(g_tab_eol + count * 8, eol);
            store64(g_tab_sel_a + count * 8, 0); store64(g_tab_sel_b + count * 8, 0); store64(g_tab_scroll_x + count * 8, 0); store64(g_tab_scroll_y + count * 8, 0); pad_bookmarks_reset(count); count = count + 1;
        }
        p = pad_recovery_next_line(p);
    }
    if count == 0 { pad_recovery_clear(); return 0; } if active < 0 { active = 0; } if active >= count { active = count - 1; }
    store64(g_tab_count, count); store64(g_tab_current, 0 - 1); store64(g_recovery_active, 1); pad_tab_load(active); pad_set_status(st_recovered); return count;
}

func pad_build_filter() -> i64 {
    p = gui_file_filter_first(g_filter, flt_ancl, pat_ancl);
    p = gui_file_filter_add(p, flt_py, pat_py);
    p = gui_file_filter_add(p, flt_cs, pat_cs);
    p = gui_file_filter_add(p, flt_logs, pat_logs);
    p = gui_file_filter_add(p, flt_data, pat_data);
    p = gui_file_filter_add(p, flt_all, pat_all);
    gui_file_filter_done(p);
    return 0;
}

func pad_set_path(path: i64) -> i64 {
    cstr_copy_n(g_curpath, path, 700);
    if load64(g_path_ed) != 0 { SetWindowTextA(load64(g_path_ed), g_curpath); }
    pad_update_build_menu();
    pad_update_status();
    return 0;
}

func pad_set_status(text: i64) -> i64 {
    if load64(g_status) == 0 { return 0; }
    if strcmp(g_status_last, text) == 0 { return 0; }
    str_copy(g_status_last, text);
    SetWindowTextA(load64(g_status), text);
    return 1;
}

func calc_is_sep(c: i64) -> i64 {
    if c == 32 { return 1; }
    if c == 9 { return 1; }
    if c == 95 { return 1; }
    if c == 44 { return 1; }
    return 0;
}

func calc_hex_digit(c: i64) -> i64 {
    if c >= 48 { if c <= 57 { return c - 48; } }
    if c >= 65 { if c <= 70 { return 10 + c - 65; } }
    if c >= 97 { if c <= 102 { return 10 + c - 97; } }
    return 0 - 1;
}

func calc_hex_char(v: i64) -> i64 {
    if v < 10 { return 48 + v; }
    return 65 + v - 10;
}

func calc_prior_binary(src: i64, start: i64, endpos: i64) -> i64 {
    i = start;
    got = 0;
    while i < endpos {
        c = load8(src + i);
        if calc_is_sep(c) == 0 {
            if c != 48 {
                if c != 49 { return 0; }
            }
            got = 1;
        }
        i = i + 1;
    }
    return got;
}

func calc_detect_base(src: i64, start: i64) -> i64 {
    store64(g_calc_suffix_pos, 0 - 1);
    c = load8(src + start);
    if c == 48 {
        nx = load8(src + start + 1);
        if nx == 120 { return 16; }
        if nx == 88 { return 16; }
        if nx == 98 { return 2; }
        if nx == 66 { return 2; }
    }
    if c == 36 { return 16; }
    if c == 37 { return 2; }

    lastpos = 0 - 1;
    last = 0;
    hashex = 0;
    j = start;
    while load8(src + j) != 0 {
        ch = load8(src + j);
        if calc_is_sep(ch) == 0 {
            lastpos = j;
            last = ch;
            d = calc_hex_digit(ch);
            if d >= 10 { hashex = 1; }
        }
        j = j + 1;
    }
    if last == 104 { store64(g_calc_suffix_pos, lastpos); return 16; }
    if last == 72 { store64(g_calc_suffix_pos, lastpos); return 16; }
    if last == 98 {
        if calc_prior_binary(src, start, lastpos) != 0 { store64(g_calc_suffix_pos, lastpos); return 2; }
    }
    if last == 66 {
        if calc_prior_binary(src, start, lastpos) != 0 { store64(g_calc_suffix_pos, lastpos); return 2; }
    }
    if hashex != 0 { return 16; }
    return 10;
}

func calc_parse_value(src: i64) -> i64 {
    store64(g_calc_ok, 0);
    i = 0;
    while calc_is_sep(load8(src + i)) != 0 { i = i + 1; }
    if load8(src + i) == 43 { i = i + 1; }
    if load8(src + i) == 45 { return 0; }

    base = calc_detect_base(src, i);
    if load8(src + i) == 48 {
        nx = load8(src + i + 1);
        if nx == 120 { i = i + 2; }
        else if nx == 88 { i = i + 2; }
        else if nx == 98 { i = i + 2; }
        else if nx == 66 { i = i + 2; }
    }
    if load8(src + i) == 36 { i = i + 1; }
    if load8(src + i) == 37 { i = i + 1; }

    v = 0;
    digits = 0;
    suffix = load64(g_calc_suffix_pos);
    while 1 {
        c = load8(src + i);
        if c == 0 { break; }
        if i == suffix { break; }
        if calc_is_sep(c) != 0 {
            i = i + 1;
        } else {
            d = calc_hex_digit(c);
            if d < 0 { return 0; }
            if d >= base { return 0; }
            v = v * base + d;
            digits = digits + 1;
            i = i + 1;
        }
    }
    if digits <= 0 { return 0; }
    store64(g_calc_ok, 1);
    store64(g_calc_value, v);
    return v;
}

func calc_parse_base(src: i64, base: i64) -> i64 {
    store64(g_calc_ok, 0);
    i = 0;
    while calc_is_sep(load8(src + i)) != 0 { i = i + 1; }
    if load8(src + i) == 43 { i = i + 1; }
    if load8(src + i) == 45 { return 0; }

    if base == 16 {
        if load8(src + i) == 36 { i = i + 1; }
        if load8(src + i) == 48 {
            nx = load8(src + i + 1);
            if nx == 120 { i = i + 2; }
            else if nx == 88 { i = i + 2; }
        }
    }
    if base == 2 {
        if load8(src + i) == 37 { i = i + 1; }
        if load8(src + i) == 48 {
            nx2 = load8(src + i + 1);
            if nx2 == 98 { i = i + 2; }
            else if nx2 == 66 { i = i + 2; }
        }
    }

    v = 0;
    digits = 0;
    while 1 {
        c = load8(src + i);
        if c == 0 { break; }
        if base == 16 {
            if c == 104 { break; }
            if c == 72 { break; }
        }
        if base == 2 {
            if c == 98 { break; }
            if c == 66 { break; }
        }
        if calc_is_sep(c) != 0 {
            i = i + 1;
        } else {
            d = calc_hex_digit(c);
            if d < 0 { return 0; }
            if d >= base { return 0; }
            v = v * base + d;
            digits = digits + 1;
            i = i + 1;
        }
    }
    if digits <= 0 { return 0; }
    store64(g_calc_ok, 1);
    store64(g_calc_value, v);
    return v;
}

func calc_parse_bcd(src: i64) -> i64 {
    store64(g_calc_ok, 0);
    i = 0;
    while calc_is_sep(load8(src + i)) != 0 { i = i + 1; }
    if load8(src + i) == 43 { i = i + 1; }
    if load8(src + i) == 45 { return 0; }
    if load8(src + i) == 36 { i = i + 1; }
    if load8(src + i) == 48 {
        nx = load8(src + i + 1);
        if nx == 120 { i = i + 2; }
        else if nx == 88 { i = i + 2; }
    }
    v = 0;
    digits = 0;
    while 1 {
        c = load8(src + i);
        if c == 0 { break; }
        if c == 104 { break; }
        if c == 72 { break; }
        if calc_is_sep(c) != 0 {
            i = i + 1;
        } else {
            d = calc_hex_digit(c);
            if d < 0 { return 0; }
            if d > 9 { return 0; }
            v = v * 10 + d;
            digits = digits + 1;
            i = i + 1;
        }
    }
    if digits <= 0 { return 0; }
    store64(g_calc_ok, 1);
    store64(g_calc_value, v);
    return v;
}

func calc_format_hex(val: i64, dst: i64) -> i64 {
    p = str_copy(dst, calc_0x);
    if val == 0 {
        store8(p, 48);
        store8(p + 1, 0);
        return 0;
    }
    n = 0;
    v = val;
    while v > 0 {
        store8(g_calc_tmp + n, calc_hex_char(band(v, 15)));
        v = shr(v, 4);
        n = n + 1;
    }
    i = 0;
    while i < n {
        store8(p + i, load8(g_calc_tmp + n - 1 - i));
        i = i + 1;
    }
    store8(p + n, 0);
    return 0;
}

func calc_format_bin(val: i64, dst: i64) -> i64 {
    p = str_copy(dst, calc_0b);
    if val == 0 {
        store8(p, 48);
        store8(p + 1, 0);
        return 0;
    }
    n = 0;
    v = val;
    while v > 0 {
        if band(v, 1) == 0 { store8(g_calc_tmp + n, 48); } else { store8(g_calc_tmp + n, 49); }
        v = shr(v, 1);
        n = n + 1;
    }
    i = 0;
    out = 0;
    while i < n {
        if i > 0 {
            rem = n - i;
            if rem % 4 == 0 {
                store8(p + out, 32);
                out = out + 1;
            }
        }
        store8(p + out, load8(g_calc_tmp + n - 1 - i));
        out = out + 1;
        i = i + 1;
    }
    store8(p + out, 0);
    return 0;
}

func calc_format_bcd(decstr: i64, dst: i64) -> i64 {
    p = str_copy(dst, calc_0x);
    n = strlen(decstr);
    if n % 2 == 1 {
        store8(p, 48);
        p = p + 1;
    }
    i = 0;
    while i < n {
        store8(p, load8(decstr + i));
        p = p + 1;
        i = i + 1;
    }
    store8(p, 0);
    return 0;
}

func calc_build_all() -> i64 {
    p = str_copy(g_calc_all, calc_dec_hdr);
    p = str_copy(p, g_calc_decbuf);
    p = str_copy(p, calc_crlf);
    p = str_copy(p, calc_hex_hdr);
    p = str_copy(p, g_calc_hexbuf);
    p = str_copy(p, calc_crlf);
    p = str_copy(p, calc_bin_hdr);
    p = str_copy(p, g_calc_binbuf);
    p = str_copy(p, calc_crlf);
    p = str_copy(p, calc_bcd_hdr);
    p = str_copy(p, g_calc_bcdbuf);
    p = str_copy(p, calc_crlf);
    store8(p, 0);
    return 0;
}

func pad_calc_clear_from(source_id: i64) -> i64 {
    store64(g_calc_updating, 1);
    if source_id != ID_CALC_DEC { SetWindowTextA(load64(g_calc_dec_ed), rich_empty); }
    if source_id != ID_CALC_HEX { SetWindowTextA(load64(g_calc_hex_ed), rich_empty); }
    if source_id != ID_CALC_BIN { SetWindowTextA(load64(g_calc_bin_ed), rich_empty); }
    if source_id != ID_CALC_BCD { SetWindowTextA(load64(g_calc_bcd_ed), rich_empty); }
    SetWindowTextA(load64(g_calc_msg_lbl), st_calc_bad);
    store64(g_calc_updating, 0);
    return 0;
}

func pad_calc_apply_value(v: i64, source_id: i64) -> i64 {
    store64(g_calc_value, v);
    store64(g_calc_ok, 1);
    p = nf_u64dec(v, g_calc_decbuf);
    store8(p, 0);
    calc_format_hex(v, g_calc_hexbuf);
    calc_format_bin(v, g_calc_binbuf);
    calc_format_bcd(g_calc_decbuf, g_calc_bcdbuf);
    calc_build_all();

    store64(g_calc_updating, 1);
    if source_id != ID_CALC_DEC { SetWindowTextA(load64(g_calc_dec_ed), g_calc_decbuf); }
    if source_id != ID_CALC_HEX { SetWindowTextA(load64(g_calc_hex_ed), g_calc_hexbuf); }
    if source_id != ID_CALC_BIN { SetWindowTextA(load64(g_calc_bin_ed), g_calc_binbuf); }
    if source_id != ID_CALC_BCD { SetWindowTextA(load64(g_calc_bcd_ed), g_calc_bcdbuf); }
    SetWindowTextA(load64(g_calc_msg_lbl), st_calc_done);
    store64(g_calc_updating, 0);
    pad_set_status(st_calc_done);
    return 1;
}

func pad_calc_from_field(source_id: i64) -> i64 {
    if load64(g_calc_updating) != 0 { return 0; }
    if source_id == ID_CALC_DEC {
        gui_get_text(load64(g_calc_dec_ed), g_calcbuf, 256);
        v = calc_parse_base(g_calcbuf, 10);
    } else if source_id == ID_CALC_HEX {
        gui_get_text(load64(g_calc_hex_ed), g_calcbuf, 256);
        v = calc_parse_base(g_calcbuf, 16);
    } else if source_id == ID_CALC_BIN {
        gui_get_text(load64(g_calc_bin_ed), g_calcbuf, 256);
        v = calc_parse_base(g_calcbuf, 2);
    } else if source_id == ID_CALC_BCD {
        gui_get_text(load64(g_calc_bcd_ed), g_calcbuf, 256);
        v = calc_parse_bcd(g_calcbuf);
    } else {
        return 0;
    }
    if load64(g_calc_ok) == 0 {
        pad_calc_clear_from(source_id);
        pad_set_status(st_calc_bad);
        return 0;
    }
    return pad_calc_apply_value(v, source_id);
}

func pad_calc_convert() -> i64 {
    f = GetFocus();
    if f == load64(g_calc_dec_ed) { return pad_calc_from_field(ID_CALC_DEC); }
    if f == load64(g_calc_hex_ed) { return pad_calc_from_field(ID_CALC_HEX); }
    if f == load64(g_calc_bin_ed) { return pad_calc_from_field(ID_CALC_BIN); }
    if f == load64(g_calc_bcd_ed) { return pad_calc_from_field(ID_CALC_BCD); }
    return pad_calc_from_field(ID_CALC_DEC);
}

func pad_calc_copy() -> i64 {
    if load64(g_calc_ok) == 0 {
        if pad_calc_convert() == 0 { return 0; }
    }
    calc_build_all();
    gui_clip_write_text(load64(g_hwnd), g_calc_all, strlen(g_calc_all));
    SetWindowTextA(load64(g_calc_msg_lbl), st_calc_copied);
    pad_set_status(st_calc_copied);
    return 1;
}

func pad_calc_seed_selection() -> i64 {
    ed = load64(g_editor);
    if ed == 0 { return 0; }
    rich_get_sel(ed, g_sel);
    a = load32(g_sel + 0);
    b = load32(g_sel + 4);
    if b < a { t = a; a = b; b = t; }
    n = b - a;
    if n <= 0 { return 0; }
    if n > 120 { return 0; }
    pad_read_doc();
    doc = load64(g_doc_p);
    i = 0;
    while i < n {
        c = load8(doc + a + i);
        if c == 13 { c = 32; }
        store8(g_calcbuf + i, c);
        i = i + 1;
    }
    store8(g_calcbuf + n, 0);
    return 1;
}

func pad_show_output(show: i64) -> i64 {
    store64(g_output_visible, show);
    if load64(g_output) != 0 { ShowWindow(load64(g_output), show); }
    GetClientRect(load64(g_hwnd), g_rect);
    pad_reflow(load32(g_rect + 8), load32(g_rect + 12));
    return 0;
}

func pad_color_output() -> i64 {
    out = load64(g_output);
    if out == 0 { return 0; }
    raw = load64(g_raw_p);
    doc = load64(g_doc_p);
    SendMessageA(out, 13, 1048575, raw);
    editor_strip_lf(doc, raw);
    dl = strlen(doc);

    rich_get_sel(out, g_sel);
    rich_get_scroll_pos(out, g_scroll);
    rich_set_redraw(out, 0);
    rich_cf_color(g_cf, COLOR_DEFAULT);
    rich_set_charformat(out, SCF_ALL, g_cf);

    pos = 0;
    run_start = 0;
    run_color = 0 - 1;
    while 1 {
        L = syn_mode_next(SYN_MODE_LOG, doc, pos);
        if L == 0 { break; }
        c = syn_mode_color(SYN_MODE_LOG, load64(syn_ancl_tok_kind));
        if c != run_color {
            if pos > run_start { editor_color_range(out, g_crange, g_cf, run_start, pos, run_color); }
            run_start = pos;
            run_color = c;
        }
        pos = pos + L;
        if pos >= dl { break; }
    }
    if pos > run_start { editor_color_range(out, g_crange, g_cf, run_start, pos, run_color); }

    rich_exset_sel(out, g_sel);
    rich_set_scroll_pos(out, g_scroll);
    rich_set_redraw(out, 1);
    InvalidateRect(out, 0, 1);
    return 0;
}

func pad_set_output(text: i64) -> i64 {
    out = load64(g_output);
    if out == 0 { return 0; }
    store64(g_output_loading, 1);
    SendMessageA(out, 0xCF, 0, 0); # EM_SETREADONLY false
    SendMessageA(out, 12, 0, text);
    pad_color_output();
    SendMessageA(out, 0xCF, 1, 0); # EM_SETREADONLY true
    store64(g_output_loading, 0);
    return 0;
}

func pad_update_status() -> i64 {
    ed = load64(g_editor);
    if ed == 0 { return 0; }
    if load64(g_in_recolor) == 1 { return 0; }
    rich_get_sel(ed, g_sel);
    caret = load32(g_sel + 0);
    other = load32(g_sel + 4);
    if other < caret { caret = other; }
    line = rich_line_from_char(ed, caret);
    start = rich_line_index(ed, line);
    col = caret - start;
    if col < 0 { col = 0; }
    p = str_copy(g_statusbuf, st_ln);
    p = nf_u64dec(line + 1, p);
    p = str_copy(p, st_col);
    p = nf_u64dec(col + 1, p);
    p = str_copy(p, pad_lang_label());
    p = str_copy(p, pad_encoding_label());
    p = str_copy(p, pad_eol_label());
    if rich_get_modified(ed) != 0 { p = str_copy(p, st_dirty); } else { p = str_copy(p, st_clean); }
    store8(p, 0);
    return pad_set_status(g_statusbuf);
}

func pad_mark_clean() -> i64 {
    rich_set_modified(load64(g_editor), 0);
    pad_update_status();
    return 0;
}

func pad_read_doc() -> i64 {
    ed = load64(g_editor);
    raw = load64(g_raw_p);
    doc = load64(g_doc_p);
    SendMessageA(ed, 13, 1048575, raw);
    return editor_strip_lf(doc, raw);
}

func pad_match_at(src: i64, pos: i64, needle: i64) -> i64 {
    if src == 0 || needle == 0 { return 0; }
    if pos < 0 { return 0; }
    j = 0;
    while 1 {
        c = load8(needle + j);
        if c == 0 { return 1; }
        sc = load8(src + pos + j);
        if sc == 0 { return 0; }
        if sc != c { return 0; }
        j = j + 1;
    }
    return 0;
}

func pad_find_from(src: i64, needle: i64, start: i64) -> i64 {
    if src == 0 || needle == 0 { return 0 - 1; }
    nlen = strlen(needle);
    if nlen <= 0 { return 0 - 1; }
    len = strlen(src);
    if nlen > len { return 0 - 1; }
    if start < 0 { start = 0; }
    if start > len { start = len; }
    i = start;
    while i <= len - nlen {
        if pad_match_at(src, i, needle) == 1 { return i; }
        i = i + 1;
    }
    return 0 - 1;
}

func pad_select_range(first: i64, last: i64) -> i64 {
    ed = load64(g_editor);
    editor_set_crange(g_crange, first, last);
    rich_exset_sel(ed, g_crange);
    SendMessageA(ed, 0xB7, 0, 0); # EM_SCROLLCARET
    SetFocus(ed);
    pad_update_status();
    return 1;
}

func pad_find_next() -> i64 {
    gui_get_text(load64(g_find_ed), g_findbuf, 256);
    if strlen(g_findbuf) <= 0 { pad_set_status(st_find_empty); return 0; }
    pad_read_doc();
    rich_get_sel(load64(g_editor), g_sel);
    start = load32(g_sel + 4);
    idx = pad_find_from(load64(g_doc_p), g_findbuf, start);
    if idx < 0 { idx = pad_find_from(load64(g_doc_p), g_findbuf, 0); }
    if idx < 0 { pad_set_status(st_not_found); return 0; }
    return pad_select_range(idx, idx + strlen(g_findbuf));
}

func pad_current_selection_matches() -> i64 {
    rich_get_sel(load64(g_editor), g_sel);
    a = load32(g_sel + 0);
    b = load32(g_sel + 4);
    if b < a { t = a; a = b; b = t; }
    if b - a != strlen(g_findbuf) { return 0; }
    pad_read_doc();
    return pad_match_at(load64(g_doc_p), a, g_findbuf);
}

func pad_replace_one() -> i64 {
    gui_get_text(load64(g_find_ed), g_findbuf, 256);
    gui_get_text(load64(g_repl_ed), g_replbuf, 256);
    if strlen(g_findbuf) <= 0 { pad_set_status(st_find_empty); return 0; }
    if pad_current_selection_matches() == 0 { return pad_find_next(); }
    SendMessageA(load64(g_editor), 0xC2, 1, g_replbuf); # EM_REPLACESEL, undoable
    rich_set_modified(load64(g_editor), 1);
    pad_recolor();
    pad_find_next();
    return 1;
}

func pad_replace_status(count: i64) -> i64 {
    p = str_copy(g_statusbuf, st_replaced);
    p = nf_u64dec(count, p);
    p = str_copy(p, st_matches);
    store8(p, 0);
    pad_set_status(g_statusbuf);
    return 0;
}

func pad_replace_all() -> i64 {
    gui_get_text(load64(g_find_ed), g_findbuf, 256);
    gui_get_text(load64(g_repl_ed), g_replbuf, 256);
    nlen = strlen(g_findbuf);
    if nlen <= 0 { pad_set_status(st_find_empty); return 0; }

    raw = load64(g_raw_p);
    dst = load64(g_filebuf_p);
    SendMessageA(load64(g_editor), 13, 1048575, raw);
    i = 0;
    j = 0;
    count = 0;
    while load8(raw + i) != 0 {
        if pad_match_at(raw, i, g_findbuf) == 1 {
            k = 0;
            while load8(g_replbuf + k) != 0 {
                if j < 1048574 { store8(dst + j, load8(g_replbuf + k)); j = j + 1; }
                k = k + 1;
            }
            i = i + nlen;
            count = count + 1;
        } else {
            if j < 1048574 { store8(dst + j, load8(raw + i)); j = j + 1; }
            i = i + 1;
        }
    }
    store8(dst + j, 0);
    if count <= 0 { pad_set_status(st_not_found); return 0; }
    pad_set_text(dst);
    rich_set_modified(load64(g_editor), 1);
    pad_replace_status(count);
    SetFocus(load64(g_editor));
    return 1;
}

func pad_select_line_num(line: i64) -> i64 {
    if line < 1 { line = 1; }
    lc = rich_line_count(load64(g_editor));
    if line > lc { pad_set_status(st_bad_line); return 0; }
    idx = rich_line_index(load64(g_editor), line - 1);
    if idx < 0 { pad_set_status(st_bad_line); return 0; }
    end = 0;
    if line < lc {
        end = rich_line_index(load64(g_editor), line);
        if end < idx { end = idx; }
    } else {
        pad_read_doc();
        end = strlen(load64(g_doc_p));
    }
    return pad_select_range(idx, end);
}

func pad_goto_line() -> i64 {
    gui_get_text(load64(g_line_ed), g_linebuf, 32);
    return pad_select_line_num(str_to_int(g_linebuf));
}

func pad_bookmark_current_line() -> i64 {
    ed = load64(g_editor); rich_get_sel(ed, g_sel); caret = load32(g_sel);
    return rich_line_from_char(ed, caret);
}

func pad_bookmark_find(tab: i64, line: i64) -> i64 {
    count = load64(g_tab_bookmark_count + tab * 8); base = pad_bookmark_base(tab); i = 0;
    while i < count { if load64(base + i * 8) == line { return i; } i = i + 1; }
    return 0 - 1;
}

func pad_bookmark_line_status(prefix: i64, line: i64) -> i64 {
    p = str_copy(g_statusbuf, prefix); p = nf_u64dec(line + 1, p); store8(p, 0);
    return pad_set_status(g_statusbuf);
}

func pad_bookmark_toggle() -> i64 {
    tab = load64(g_tab_current); if tab < 0 { return 0; }
    line = pad_bookmark_current_line(); count = load64(g_tab_bookmark_count + tab * 8); base = pad_bookmark_base(tab); found = pad_bookmark_find(tab, line);
    if found >= 0 {
        i = found; while i < count - 1 { store64(base + i * 8, load64(base + (i + 1) * 8)); i = i + 1; }
        store64(g_tab_bookmark_count + tab * 8, count - 1); pad_bookmark_line_status(st_bookmark_removed, line);
    } else {
        if count >= PAD_BOOKMARK_CAP { pad_set_status(st_bookmark_full); return 0; }
        store64(base + count * 8, line); store64(g_tab_bookmark_count + tab * 8, count + 1); pad_bookmark_line_status(st_bookmark_added, line);
    }
    InvalidateRect(load64(g_hwnd), g_gutter, 0); return 1;
}

func pad_bookmark_jump(direction: i64) -> i64 {
    tab = load64(g_tab_current); if tab < 0 { return 0; }
    count = load64(g_tab_bookmark_count + tab * 8); if count <= 0 { pad_set_status(st_bookmark_none); return 0; }
    current = pad_bookmark_current_line(); lc = rich_line_count(load64(g_editor)); base = pad_bookmark_base(tab); best = 0 - 1; wrap = 0 - 1; i = 0;
    while i < count {
        line = load64(base + i * 8);
        if line >= 0 { if line < lc {
            if direction > 0 {
                if wrap < 0 || line < wrap { wrap = line; }
                if line > current { if best < 0 || line < best { best = line; } }
            } else {
                if wrap < 0 || line > wrap { wrap = line; }
                if line < current { if best < 0 || line > best { best = line; } }
            }
        } }
        i = i + 1;
    }
    if best < 0 { best = wrap; } if best < 0 { pad_set_status(st_bookmark_none); return 0; }
    idx = rich_line_index(load64(g_editor), best); if idx < 0 { pad_set_status(st_bookmark_none); return 0; }
    pad_select_range(idx, idx); pad_bookmark_line_status(st_bookmark_jump, best); return 1;
}

func pad_bookmark_clear() -> i64 {
    tab = load64(g_tab_current); if tab < 0 { return 0; }
    if load64(g_tab_bookmark_count + tab * 8) <= 0 { pad_set_status(st_bookmark_none); return 0; }
    pad_bookmarks_reset(tab); InvalidateRect(load64(g_hwnd), g_gutter, 0); pad_set_status(st_bookmark_cleared); return 1;
}

func pad_draw_bookmarks(hdc: i64) -> i64 {
    tab = load64(g_tab_current); if tab < 0 { return 0; }
    count = load64(g_tab_bookmark_count + tab * 8); if count <= 0 { return 0; }
    ed = load64(g_editor); lc = rich_line_count(ed); base = pad_bookmark_base(tab); gy = load32(g_gutter + 4); bottom = load32(g_gutter + 12); i = 0;
    while i < count {
        line = load64(base + i * 8);
        if line >= 0 { if line < lc {
            ci = rich_line_index(ed, line);
            if ci >= 0 { rich_pos_from_char(ed, g_pt, ci); y = editor_sign32(load32(g_pt + 4)); y = gy + y; if y >= gy { if y + 13 < bottom { gdi_fill_xy(hdc, 20, y + 3, 24, y + 13, load64(g_br_accent)); } } }
        } }
        i = i + 1;
    }
    return count;
}

func pad_jump_error(buf: i64) -> i64 {
    i = 0;
    n1 = 0;
    scanning = 1;
    while scanning == 1 {
        c0 = load8(buf + i);
        if c0 == 0 { scanning = 0; }
        if scanning == 1 {
            if c0 == 108 { if load8(buf + i + 1) == 105 { if load8(buf + i + 2) == 110 { if load8(buf + i + 3) == 101 { if load8(buf + i + 4) == 32 {
                p = i + 5;
                num = 0;
                got = 0;
                going = 1;
                while going == 1 {
                    ch = load8(buf + p);
                    if ch < 48 { going = 0; }
                    if ch > 57 { going = 0; }
                    if going == 1 {
                        num = num * 10 + (ch - 48);
                        p = p + 1;
                        got = 1;
                    }
                }
                if got == 1 { n1 = num; scanning = 0; }
            } } } } }
            i = i + 1;
        }
    }
    if n1 <= 0 { return 0; }
    return pad_select_line_num(n1);
}

func pad_output_jump() -> i64 {
    if load64(g_output_loading) != 0 { return 0; }
    out = load64(g_output); if out == 0 { return 0; }
    rich_get_sel(out, g_crange); ch = load32(g_crange); line = rich_line_from_char(out, ch);
    start = rich_line_index(out, line); if start < 0 { return 0; }
    next = rich_line_index(out, line + 1);
    raw = load64(g_raw_p); doc = load64(g_doc_p); SendMessageA(out, 13, 1048575, raw); editor_strip_lf(doc, raw);
    if next < 0 { next = strlen(doc); }
    n = next - start; if n > 511 { n = 511; } if n <= 0 { return 0; }
    memcpy(g_fixmsg, doc + start, n); store8(g_fixmsg + n, 0);
    if pad_files_jump(g_fixmsg) != 0 { return 1; }
    if pad_jump_error(g_fixmsg) != 0 { pad_set_status(st_diag_jump); SetFocus(load64(g_editor)); return 1; }
    return 0;
}

func pad_files_jump(linebuf: i64) -> i64 {
    p = linebuf; sep = 0 - 1; i = 0; while load8(p + i) != 0 { if load8(p + i) == 124 { sep = i; break; } i = i + 1; }
    if sep <= 0 { return 0; } if load8(p + sep + 1) != 108 { return 0; } if load8(p + sep + 5) != 32 { return 0; }
    if sep > 699 { return 0; } memcpy(g_dialog, p, sep); store8(g_dialog + sep, 0);
    q = sep + 6; line = 0; got = 0; while load8(p + q) >= 48 { if load8(p + q) > 57 { break; } line = line * 10 + load8(p + q) - 48; q = q + 1; got = 1; }
    if got == 0 { return 0; } if pad_load_path(g_dialog) == 0 { return 0; }
    pad_select_line_num(line); pad_set_status(st_diag_jump); SetFocus(load64(g_editor)); return 1;
}

func pad_files_supported(path: i64) -> i64 {
    if pad_ends_with_ci(path, ext_ancl) != 0 { return 1; } if pad_ends_with_ci(path, ext_py) != 0 { return 1; }
    if pad_ends_with_ci(path, ext_cs) != 0 { return 1; } if pad_ends_with_ci(path, ext_log) != 0 { return 1; }
    if pad_ends_with_ci(path, ext_txt) != 0 { return 1; } if pad_ends_with_ci(path, ext_json) != 0 { return 1; }
    if pad_ends_with_ci(path, ext_xml) != 0 { return 1; } if pad_ends_with_ci(path, ext_html) != 0 { return 1; } if pad_ends_with_ci(path, ext_htm) != 0 { return 1; } if pad_ends_with_ci(path, ext_sql) != 0 { return 1; }
    if pad_ends_with_ci(path, ext_md) != 0 { return 1; } if pad_ends_with_ci(path, ext_markdown) != 0 { return 1; }
    if pad_ends_with_ci(path, ext_ini) != 0 { return 1; } if pad_ends_with_ci(path, ext_cfg) != 0 { return 1; }
    if pad_ends_with_ci(path, ext_ps1) != 0 { return 1; }
    if pad_ends_with_ci(path, ".c") != 0 { return 1; } if pad_ends_with_ci(path, ".h") != 0 { return 1; }
    if pad_ends_with_ci(path, ".cpp") != 0 { return 1; } if pad_ends_with_ci(path, ".hpp") != 0 { return 1; }
    if pad_ends_with_ci(path, ".js") != 0 { return 1; } if pad_ends_with_ci(path, ".ts") != 0 { return 1; }
    if pad_ends_with_ci(path, ".tsx") != 0 { return 1; } if pad_ends_with_ci(path, ".jsx") != 0 { return 1; }
    if pad_ends_with_ci(path, ".html") != 0 { return 1; } if pad_ends_with_ci(path, ".css") != 0 { return 1; }
    if pad_ends_with_ci(path, ".yml") != 0 { return 1; } if pad_ends_with_ci(path, ".yaml") != 0 { return 1; }
    if pad_ends_with_ci(path, ".toml") != 0 { return 1; } if pad_ends_with_ci(path, ".bat") != 0 { return 1; }
    if pad_ends_with_ci(path, ".cmd") != 0 { return 1; } if pad_ends_with_ci(path, ".psm1") != 0 { return 1; }
    return 0;
}

func pad_files_skip_dir(name: i64) -> i64 {
    if strcmp(name, ".") == 0 { return 1; } if strcmp(name, "..") == 0 { return 1; }
    if strcmp(name, ".git") == 0 { return 1; } if strcmp(name, "node_modules") == 0 { return 1; }
    if strcmp(name, ".venv") == 0 { return 1; } if strcmp(name, "__pycache__") == 0 { return 1; } return 0;
}

func pad_files_append(src: i64) -> i64 {
    out = load64(g_files_output_p); used = load64(g_files_out_len); cap = 262143; i = 0;
    while load8(src + i) != 0 { if used >= cap { store64(g_files_truncated, 1); break; } store8(out + used, load8(src + i)); used = used + 1; i = i + 1; }
    store8(out + used, 0); store64(g_files_out_len, used); return i;
}

func pad_files_match_at(src: i64, pos: i64, needle: i64) -> i64 {
    j = 0; while load8(needle + j) != 0 { a = pad_lower_ascii(load8(src + pos + j)); b = pad_lower_ascii(load8(needle + j)); if a != b { return 0; } j = j + 1; } return 1;
}

func pad_files_add_result(path: i64, line: i64, src: i64, start: i64, end: i64) -> i64 {
    pad_files_append(path); pad_files_append("|line "); np = nf_u64dec(line, g_num); store8(np, 0); pad_files_append(g_num); pad_files_append("| ");
    n = end - start; if n > 180 { n = 180; } i = 0; while i < n { c = load8(src + start + i); if c == 13 || c == 10 { break; } store8(g_fixmsg + i, c); i = i + 1; } store8(g_fixmsg + i, 0);
    pad_files_append(g_fixmsg); pad_files_append("\r\n"); store64(g_files_count, load64(g_files_count) + 1); return 1;
}

func pad_files_search_file(path: i64) -> i64 {
    if load64(g_files_count) >= 500 { store64(g_files_truncated, 1); return 0; }
    src = load64(g_filebuf_p); n = pad_read_file(path, src, 1048576); if n <= 0 { return 0; }
    i = 0; while i < n { if load8(src + i) == 0 { return 0; } i = i + 1; }
    pos = 0; line = 1; while pos < n { start = pos; while pos < n { c = load8(src + pos); if c == 13 || c == 10 { break; } pos = pos + 1; } end = pos;
        hit = 0; q = start; while q < end { if pad_files_match_at(src, q, g_files_query) != 0 { hit = 1; break; } q = q + 1; }
        if hit != 0 { pad_files_add_result(path, line, src, start, end); if load64(g_files_count) >= 500 { store64(g_files_truncated, 1); return 1; } }
        if pos < n { if load8(src + pos) == 13 { pos = pos + 1; } if load8(src + pos) == 10 { pos = pos + 1; } } line = line + 1;
    }
    return 1;
}

func pad_files_scan_dir(dir: i64, depth: i64) -> i64 {
    if depth >= 12 { return 0; } if load64(g_files_truncated) != 0 { return 0; } if load64(g_files_scanned) >= 5000 { store64(g_files_truncated, 1); return 0; }
    fd = g_files_find_data + depth * 320; glob = g_files_globs + depth * 700; child = g_files_paths + depth * 700;
    p = str_copy(glob, dir); if p > glob { if load8(p - 1) != 92 { store8(p, 92); p = p + 1; } } str_copy(p, "*.*");
    h = FindFirstFileA(glob, fd); if h == 0 - 1 { return 0; }
    while 1 {
        name = fd + 44; attr = load32(fd);
        if band(attr, 16) != 0 {
            if band(attr, 1024) == 0 { if pad_files_skip_dir(name) == 0 { p = str_copy(child, dir); if load8(p - 1) != 92 { store8(p, 92); p = p + 1; } str_copy(p, name); pad_files_scan_dir(child, depth + 1); } }
        } else {
            p = str_copy(child, dir); if load8(p - 1) != 92 { store8(p, 92); p = p + 1; } str_copy(p, name);
            if pad_files_supported(child) != 0 { store64(g_files_scanned, load64(g_files_scanned) + 1); pad_files_search_file(child); }
        }
        if load64(g_files_truncated) != 0 { break; } if FindNextFileA(h, fd) == 0 { break; }
    }
    FindClose(h); return 1;
}

func pad_files_browse() -> i64 {
    memset(g_files_browse_info, 0, 64); store64(g_files_browse_info, load64(g_hwnd)); store64(g_files_browse_info + 16, g_files_display); store64(g_files_browse_info + 24, folder_title); store32(g_files_browse_info + 32, 0x41);
    pidl = SHBrowseForFolderA(g_files_browse_info); if pidl == 0 { return 0; } ok = SHGetPathFromIDListA(pidl, g_files_folder); CoTaskMemFree(pidl); if ok == 0 { return 0; }
    SetWindowTextA(load64(g_files_folder_ed), g_files_folder); return 1;
}

func pad_files_run() -> i64 {
    gui_get_text(load64(g_files_find_ed), g_files_query, 256); if load8(g_files_query) == 0 { pad_set_status(st_files_empty); return 0; }
    gui_get_text(load64(g_files_folder_ed), g_files_folder, 700); if load8(g_files_folder) == 0 { pad_set_status(st_files_folder); return 0; }
    out = load64(g_files_output_p); store8(out, 0); store64(g_files_count, 0); store64(g_files_scanned, 0); store64(g_files_truncated, 0); store64(g_files_out_len, 0); pad_set_status(st_files_searching);
    ok = pad_files_scan_dir(g_files_folder, 0); if ok == 0 { if load64(g_files_scanned) == 0 { pad_files_append(st_files_folder); pad_files_append("\r\n"); pad_set_output(out); pad_show_output(1); pad_set_status(st_files_folder); return 0; } } count = load64(g_files_count);
    if count == 0 { pad_files_append(st_files_none); pad_files_append("\r\n"); } if load64(g_files_truncated) != 0 { pad_files_append("\r\n"); pad_files_append(st_files_limit); pad_files_append("\r\n"); }
    pad_set_output(out); pad_show_output(1); p = str_copy(g_statusbuf, st_files_done_a); p = nf_u64dec(count, p); store8(p, 0); str_copy(p, st_files_done_b); pad_set_status(g_statusbuf); return count;
}

