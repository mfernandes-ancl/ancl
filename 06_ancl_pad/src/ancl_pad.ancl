func pad_compare_make_label() -> i64 {
    src = g_compare_path; last = pad_last_bs(src); if last >= 0 { src = src + last + 1; }
    p = str_copy(g_compare_labelbuf, txt_compare); cstr_copy_n(p, src, 680); return g_compare_labelbuf;
}

func pad_compare_show_controls(show: i64) -> i64 {
    ShowWindow(load64(g_compare), show); ShowWindow(load64(g_compare_label), show); ShowWindow(load64(g_compare_close), show); return 0;
}

func pad_compare_recolor() -> i64 {
    ed = load64(g_compare); if ed == 0 { return 0; }
    store64(g_in_recolor, 1); SendMessageA(ed, 0xCF, 0, 0);
    raw = load64(g_raw_p); doc = load64(g_doc_p); SendMessageA(ed, 13, 1048575, raw); editor_strip_lf(doc, raw); dl = strlen(doc);
    rich_get_sel(ed, g_compare_sel); rich_get_scroll_pos(ed, g_compare_scroll); rich_set_redraw(ed, 0);
    rich_cf_color(g_cf, COLOR_DEFAULT); rich_set_charformat(ed, SCF_ALL, g_cf);
    mode = pad_detect_lang(g_compare_path); pos = 0; run_start = 0; run_color = 0 - 1;
    while 1 {
        L = syn_mode_next(mode, doc, pos); if L == 0 { break; }
        c = syn_mode_color(mode, load64(syn_ancl_tok_kind));
        if c != run_color { if pos > run_start { editor_color_range(ed, g_crange, g_cf, run_start, pos, run_color); } run_start = pos; run_color = c; }
        pos = pos + L; if pos >= dl { break; }
    }
    if pos > run_start { editor_color_range(ed, g_crange, g_cf, run_start, pos, run_color); }
    rich_exset_sel(ed, g_compare_sel); rich_set_scroll_pos(ed, g_compare_scroll); rich_set_redraw(ed, 1); rich_set_modified(ed, 0); SendMessageA(ed, 0xCF, 1, 0);
    InvalidateRect(ed, 0, 1); store64(g_in_recolor, 0); return 1;
}

func pad_compare_open() -> i64 {
    memset(g_dialog, 0, 700);
    if gui_open_file_dialog(g_ofn, load64(g_hwnd), g_filter, g_dialog, 700, 0, compare_title, 0x1804) == 0 { return 0; }
    fb = load64(g_raw_p); if pad_read_document(g_dialog, fb, PAD_TAB_CAP) < 0 { pad_set_status(st_loadfail); return 0; }
    cstr_copy_n(g_compare_path, g_dialog, 700); SendMessageA(load64(g_compare), 0xCF, 0, 0); pad_rich_set_utf8(load64(g_compare), fb); pad_compare_recolor();
    SetWindowTextA(load64(g_compare_label), pad_compare_make_label()); store64(g_compare_visible, 1); pad_compare_show_controls(1);
    GetClientRect(load64(g_hwnd), g_rect); pad_reflow(load32(g_rect + 8), load32(g_rect + 12)); pad_set_status(st_compare_loaded); SetFocus(load64(g_editor)); return 1;
}

func pad_compare_hide() -> i64 {
