    store64(g_compare_visible, 0); pad_compare_show_controls(0); GetClientRect(load64(g_hwnd), g_rect); pad_reflow(load32(g_rect + 8), load32(g_rect + 12));
    pad_set_status(st_compare_closed); SetFocus(load64(g_editor)); return 1;
}

func pad_out_path() -> i64 {
    last = pad_last_bs(g_curpath);
    if last < 0 { return 0; }
    srclen = strlen(g_curpath);

    pad_join(g_bindir, g_rootdir, s_bindir);
    CreateDirectoryA(g_bindir, 0);

    k = str_copy(g_outpath, g_bindir);
    store8(k, 92);
    k = k + 1;
    bstart = last + 1;
    dotpos = 0 - 1;
    m = bstart;
    while m < srclen {
        if load8(g_curpath + m) == 46 { dotpos = m; }
        m = m + 1;
    }
    bend = srclen;
    if dotpos != 0 - 1 { if dotpos > bstart { bend = dotpos; } }
    m = bstart;
    while m < bend {
        store8(k, load8(g_curpath + m));
        k = k + 1;
        m = m + 1;
    }
    str_copy(k, s_exe_ext);
    return 1;
}

func pad_compile_cmd() -> i64 {
    c = str_copy(g_cmd, q);
    c = str_copy(c, g_compiler);
    c = str_copy(c, qspq);
    c = str_copy(c, g_curpath);
    c = str_copy(c, qspq);
    c = str_copy(c, g_outpath);
    str_copy(c, q);
    return 0;
}

func pad_run_cmd() -> i64 {
    c = str_copy(g_runcmd, q);
    c = str_copy(c, g_outpath);
    str_copy(c, q);
    return 0;
}

func pad_fix_cmd(write_mode: i64) -> i64 {
    c = str_copy(g_cmd, q);
    c = str_copy(c, g_compiler);
    c = str_copy(c, "\" --fix");
    if write_mode != 0 { c = str_copy(c, " --write"); }
    c = str_copy(c, " \"");
    c = str_copy(c, g_curpath);
    str_copy(c, q);
    return 0;
}

func pad_fix_count(buf: i64) -> i64 {
    i = 0;
    while load8(buf + i) != 0 {
        if load8(buf + i) == 58 {
            if load8(buf + i + 1) == 32 {
                p = i + 2;
                num = 0;
                got = 0;
                going = 1;
                while going == 1 {
                    ch = load8(buf + p);
                    if ch < 48 { going = 0; }
                    if ch > 57 { going = 0; }
                    if going == 1 {
                        num = num * 10 + (ch - 48);
                        p = p + 1;
                        got = 1;
                    }
                }
                if got == 1 { return num; }
            }
        }
        i = i + 1;
    }
    return 0;
}

func pad_append_exit(dst: i64, code: i64) -> i64 {
    p = dst + strlen(dst);
    p = str_copy(p, out_exit);
    p = nf_u64dec(code, p);
    str_copy(p, out_close);
    return 0;
}

func pad_require_ancl() -> i64 {
    if pad_is_ancl_path(g_curpath) != 0 { return 1; }
    pad_set_status(st_ancl_only);
    pad_show_output(1);
    pad_set_output(st_ancl_only);
    return 0;
}

func pad_fix_current() -> i64 {
    if pad_require_ancl() == 0 { return 0; }
    if load8(g_curpath) == 0 { if pad_save_as_dialog() == 0 { pad_set_status(st_no_file); return 0; } }
    if strcmp(g_curpath, untitled) == 0 { if pad_save_as_dialog() == 0 { pad_set_status(st_no_file); return 0; } }
    if pad_save() == 0 { return 0; }

    out = load64(g_filebuf_p);
    pad_show_output(1);
    if GetFileAttributesA(g_compiler) == 0xFFFFFFFF {
        p = str_copy(out, out_no_compiler);
        p = str_copy(p, g_compiler);
        str_copy(p, out_bundle_hint);
        pad_set_output(out);
        pad_set_status(st_launch_fail);
        return 0;
    }

    pad_set_status(st_fixing);
    pad_fix_cmd(0);
    n = pcap_run_capture(g_cmd, out, 262144);
    if n < 0 {
        pad_set_status(st_launch_fail);
        pad_set_output(st_launch_fail);
        return 0;
    }
    pad_set_output(out);
    cnt = pad_fix_count(out);
    if cnt <= 0 {
        str_copy(out + strlen(out), out_fix_none);
        pad_set_output(out);
        pad_set_status(st_fix_none);
        return 0;
    }

    p = str_copy(g_fixmsg, fix_q_a);
    p = nf_u64dec(cnt, p);
    str_copy(p, fix_q_b);
    if MessageBoxA(load64(g_hwnd), g_fixmsg, fix_title, 0x24) != 6 {
        str_copy(out + strlen(out), out_fix_cancel);
        pad_set_output(out);
        pad_set_status(st_fix_cancel);
        return 0;
    }

    pad_fix_cmd(1);
    n2 = pcap_run_capture(g_cmd, out, 262144);
    if n2 < 0 {
        pad_set_status(st_launch_fail);
        pad_set_output(st_launch_fail);
        return 0;
    }
    pad_set_output(out);
    pad_tab_reload_current();
    pad_set_status(st_fixed);
    pad_recolor_chars(0, 0 - 1);
    return 1;
}

func pad_compile_current(run_after: i64) -> i64 {
    if pad_require_ancl() == 0 { return 0; }
    if load8(g_curpath) == 0 { if pad_save_as_dialog() == 0 { pad_set_status(st_no_file); return 0; } }
    if strcmp(g_curpath, untitled) == 0 { if pad_save_as_dialog() == 0 { pad_set_status(st_no_file); return 0; } }
    if pad_save() == 0 { return 0; }
    if pad_out_path() == 0 { pad_set_status(st_no_file); return 0; }
    pad_compile_cmd();

    out = load64(g_filebuf_p);
    runout = out + 262144;
    pad_show_output(1);
    if GetFileAttributesA(g_compiler) == 0xFFFFFFFF {
        p = str_copy(out, out_no_compiler);
        p = str_copy(p, g_compiler);
        str_copy(p, out_bundle_hint);
        pad_set_output(out);
        pad_set_status(st_launch_fail);
        return 0;
    }
    pad_set_status(st_compiling);
    str_copy(out, out_compile);
    pad_set_output(out);

    n = pcap_run_capture(g_cmd, out, 262144);
    if n < 0 {
        pad_set_status(st_launch_fail);
        pad_set_output(st_launch_fail);
        return 0;
    }
    pad_set_output(out);
    if pcap_last_exit() != 0 {
        pad_set_status(st_compile_fail);
        pad_jump_error(out);
        return 0;
    }
    pad_set_status(st_compile_ok);

    if run_after == 0 { return 1; }
    pad_run_cmd();
    p = out + strlen(out);
    p = str_copy(p, out_run);
    store8(p, 0);
    pad_set_output(out);
    pad_set_status(st_running);
    n2 = pcap_run_capture(g_runcmd, runout, 262144);
    if n2 < 0 {
        p = str_copy(out + strlen(out), st_launch_fail);
        store8(p, 0);
        pad_set_output(out);
        pad_set_status(st_launch_fail);
        return 0;
    }
    p = str_copy(out + strlen(out), runout);
    store8(p, 0);
    pad_append_exit(out, pcap_last_exit());
    pad_set_output(out);
    pad_set_status(st_run_done);
    return 1;
}

func pad_recolor_chars(cstart: i64, cend: i64) -> i64 {
    ed = load64(g_editor);
    if ed == 0 { return 0; }
    if load64(g_in_recolor) == 1 { return 0; }
    store64(g_in_recolor, 1);

    svm = rich_get_modified(ed);
    doc = load64(g_doc_p);
    pad_read_doc();
    dl = strlen(doc);
    if cstart < 0 { cstart = 0; }
    if cend < 0 { cend = dl; }
    if cend > dl { cend = dl; }

    rich_get_sel(ed, g_sel);
    rich_get_scroll_pos(ed, g_scroll);
    rich_set_redraw(ed, 0);

    mode = pad_effective_lang();
    pos = cstart;
    run_start = cstart;
    run_color = 0 - 1;
    while 1 {
        L = syn_mode_next(mode, doc, pos);
        if L == 0 { break; }
        if pos >= cend { break; }
        c = syn_mode_color(mode, load64(syn_ancl_tok_kind));
        if c != run_color {
            if pos > run_start { editor_color_range(ed, g_crange, g_cf, run_start, pos, run_color); }
            run_start = pos;
            run_color = c;
        }
        pos = pos + L;
    }
    if pos > run_start { editor_color_range(ed, g_crange, g_cf, run_start, pos, run_color); }

    rich_exset_sel(ed, g_sel);
    rich_set_scroll_pos(ed, g_scroll);
    rich_set_redraw(ed, 1);
    rich_set_modified(ed, svm);
    InvalidateRect(ed, 0, 1);
    InvalidateRect(load64(g_hwnd), g_gutter, 0);
    store64(g_in_recolor, 0);
    return 0;
}

func pad_recolor() -> i64 {
    ed = load64(g_editor);
    if ed == 0 { return 0; }
    first = rich_get_first_visible_line(ed);
    lc = rich_line_count(ed);
    top = first - 12;
    if top < 0 { top = 0; }
    bot = first + 96;
    if bot > lc { bot = lc; }
    cstart = rich_line_index(ed, top);
    if cstart < 0 { cstart = 0; }
    cend = 0 - 1;
    if bot < lc {
        ci = rich_line_index(ed, bot);
        if ci >= 0 { cend = ci; }
    }
    pad_recolor_chars(cstart, cend);
    pad_update_status();
    return 0;
}

func pad_recolor_line_at(pos: i64) -> i64 {
    if pos < 0 { return 0; } ed = load64(g_editor); line = rich_line_from_char(ed, pos);
    start = rich_line_index(ed, line); if start < 0 { return 0; }
    end = rich_line_index(ed, line + 1); if end < 0 { pad_read_doc(); end = strlen(load64(g_doc_p)); }
    return pad_recolor_chars(start, end);
}

func pad_bracket_pair(ch: i64) -> i64 {
    if ch == 40 { return 41; } if ch == 91 { return 93; } if ch == 123 { return 125; }
    if ch == 41 { return 40; } if ch == 93 { return 91; } if ch == 125 { return 123; }
    return 0;
}

func pad_bracket_update() -> i64 {
    if load64(g_loading) != 0 { return 0; } if load64(g_in_recolor) != 0 { return 0; } if load64(g_in_bracket) != 0 { return 0; }
    olda = load64(g_bracket_a); oldb = load64(g_bracket_b); store64(g_bracket_a, 0 - 1); store64(g_bracket_b, 0 - 1);
    if olda >= 0 { pad_recolor_line_at(olda); } if oldb >= 0 { pad_recolor_line_at(oldb); }
    ed = load64(g_editor); rich_get_sel(ed, g_sel); if load32(g_sel) != load32(g_sel + 4) { return 0; } caret = load32(g_sel); doc = load64(g_doc_p); pad_read_doc(); dl = strlen(doc);
    pos = caret; ch = 0; if pos < dl { ch = load8(doc + pos); }
    if pad_bracket_pair(ch) == 0 { pos = caret - 1; if pos >= 0 { ch = load8(doc + pos); } }
    pair = pad_bracket_pair(ch); if pair == 0 { return 0; }
    direction = 1; if ch == 41 || ch == 93 || ch == 125 { direction = 0 - 1; }
    depth = 1; i = pos + direction; match = 0 - 1;
    while i >= 0 { if i >= dl { break; } c = load8(doc + i); if c == ch { depth = depth + 1; } if c == pair { depth = depth - 1; if depth == 0 { match = i; break; } } i = i + direction; }
    if match < 0 { return 0; }
    store64(g_in_bracket, 1);
    store64(g_bracket_a, pos); store64(g_bracket_b, match); rich_get_sel(ed, g_bracket_sel); rich_get_scroll_pos(ed, g_bracket_scroll); rich_set_redraw(ed, 0);
    editor_color_range(ed, g_crange, g_cf, pos, pos + 1, COLOR_ACCENT); editor_color_range(ed, g_crange, g_cf, match, match + 1, COLOR_ACCENT);
    rich_exset_sel(ed, g_bracket_sel); rich_set_scroll_pos(ed, g_bracket_scroll); rich_set_redraw(ed, 1); InvalidateRect(ed, 0, 1); store64(g_in_bracket, 0); return 1;
}

func pad_set_text(src: i64) -> i64 {
    store64(g_loading, 1);
    pad_rich_set_utf8(load64(g_editor), src);
    rich_cf_color(g_cf, COLOR_DEFAULT);
    rich_set_charformat(load64(g_editor), SCF_ALL, g_cf);
    pad_recolor_chars(0, 0 - 1);
    store64(g_bracket_a, 0 - 1); store64(g_bracket_b, 0 - 1);
    store64(g_loading, 0);
    return 0;
}

func pad_new() -> i64 {
    if pad_tab_add(untitled, rich_empty, 0, TEXT_ENC_UTF8, TEXT_EOL_CRLF) == 0 { return 0; }
    pad_set_status(st_new);
    SetFocus(load64(g_editor));
    return 1;
}

func pad_close_document() -> i64 {
    if rich_get_modified(load64(g_editor)) != 0 {
        if MessageBoxA(load64(g_hwnd), close_modified, close_title, 0x34) != 6 { return 0; }
    }
    idx = load64(g_tab_current); count = load64(g_tab_count); if idx < 0 { return 0; }
    removed = pad_tab_text(idx); i = idx;
    while i < count - 1 {
        cstr_copy_n(pad_tab_path(i), pad_tab_path(i + 1), 700); store64(g_tab_texts + i * 8, pad_tab_text(i + 1));
        store64(g_tab_dirty + i * 8, load64(g_tab_dirty + (i + 1) * 8)); store64(g_tab_lang + i * 8, load64(g_tab_lang + (i + 1) * 8));
        store64(g_tab_encoding + i * 8, load64(g_tab_encoding + (i + 1) * 8)); store64(g_tab_eol + i * 8, load64(g_tab_eol + (i + 1) * 8));
        store64(g_tab_sel_a + i * 8, load64(g_tab_sel_a + (i + 1) * 8)); store64(g_tab_sel_b + i * 8, load64(g_tab_sel_b + (i + 1) * 8));
        store64(g_tab_scroll_x + i * 8, load64(g_tab_scroll_x + (i + 1) * 8)); store64(g_tab_scroll_y + i * 8, load64(g_tab_scroll_y + (i + 1) * 8)); pad_bookmarks_copy(i, i + 1); i = i + 1;
    }
    store64(g_tab_texts + (count - 1) * 8, removed); store8(removed, 0); store8(pad_tab_path(count - 1), 0); pad_bookmarks_reset(count - 1); count = count - 1; store64(g_tab_count, count);
    if count == 0 { store64(g_tab_count, 1); pad_tab_init(0, untitled, rich_empty, 0, TEXT_ENC_UTF8, TEXT_EOL_CRLF); idx = 0; } else { if idx >= count { idx = count - 1; } }
    store64(g_tab_current, 0 - 1); pad_tab_load(idx);
    pad_set_output(rich_empty);
    pad_show_output(0);
    pad_hide_find();
    pad_hide_calc();
    pad_set_status(st_closed);
    SetFocus(load64(g_editor));
    pad_recovery_save();
    return 1;
}

func pad_load_starter(name: i64) -> i64 {
    p = str_copy(g_starter, g_rootdir);
    p = str_copy(p, s_starters);
    str_copy(p, name);

    fb = load64(g_raw_p);
    n = pad_read_document(g_starter, fb, PAD_TAB_CAP);
    if n < 0 { pad_set_status(st_loadfail); return 0; }

    if pad_tab_add(untitled, fb, 1, load64(g_detect_encoding), load64(g_detect_eol)) == 0 { return 0; }
    pad_set_status(st_starter);
    SetFocus(load64(g_editor));
    return 1;
}

func pad_insert_import(snippet: i64) -> i64 {
    ed = load64(g_editor);
    if ed == 0 { return 0; }
    editor_set_crange(g_crange, 0, 0);
    rich_exset_sel(ed, g_crange);
    SendMessageA(ed, 0xC2, 1, snippet); # EM_REPLACESEL, undoable
    rich_set_modified(ed, 1);
    pad_recolor_chars(0, 0 - 1);
    pad_set_status(st_imported);
    SetFocus(ed);
    return 1;
}

func pad_load_path(path: i64) -> i64 {
    cstr_copy_n(g_load_path, path, 700);
    existing = pad_tab_find(g_load_path); if existing >= 0 { pad_tab_activate(existing); return 1; }
    fb = load64(g_raw_p);
    n = pad_read_document(g_load_path, fb, PAD_TAB_CAP);
    if n < 0 { pad_set_status(st_loadfail); return 0; }
    if pad_tab_add(g_load_path, fb, 0, load64(g_detect_encoding), load64(g_detect_eol)) == 0 { return 0; }
    pad_set_status(st_loaded);
    pad_recent_push(g_load_path);
    SetFocus(load64(g_editor));
    return 1;
}

func pad_load_sample() -> i64 {
    if pad_load_path(g_sample) != 0 {
        pad_set_status(st_sample);
        return 1;
    }
    pad_tab_add(untitled, seed_src, 0, TEXT_ENC_UTF8, TEXT_EOL_CRLF);
    pad_set_status(st_sample);
    SetFocus(load64(g_editor));
    return 1;
}

func pad_save_path(path: i64) -> i64 {
    raw = load64(g_raw_p); len = pad_rich_get_utf8(load64(g_editor), raw, PAD_TAB_CAP); if len < 0 { pad_set_status(st_savefail); return 0; }
    doc = load64(g_doc_p); norm = text_normalize_eol(raw, doc, PAD_TAB_CAP, load64(g_eol_mode)); if norm < 0 { pad_set_status(st_savefail); return 0; }
    fb = load64(g_filebuf_p); bytes = text_encode_from_utf8(doc, norm, load64(g_encoding_mode), fb, PAD_FILE_CAP, load64(g_wide_p), PAD_TAB_CAP);
    if bytes < 0 { pad_set_status(st_savefail); return 0; }
    ok = pad_write_file(path, fb, bytes);
    if ok == 0 { pad_set_status(st_savefail); return 0; }
    pad_set_path(path);
    i = load64(g_tab_current); if i >= 0 { cstr_copy_n(pad_tab_path(i), path, 700); store64(g_tab_dirty + i * 8, 0); }
    pad_recolor_chars(0, 0 - 1);
    pad_mark_clean();
    pad_set_status(st_saved);
    pad_recent_push(path);
    pad_tabs_refresh(); pad_session_save(); pad_recovery_save();
    return 1;
}

func pad_open_dialog() -> i64 {
    memset(g_dialog, 0, 700);
    if gui_open_file_dialog(g_ofn, load64(g_hwnd), g_filter, g_dialog, 700, 0, title_app, 0x1804) == 0 { return 0; }
    return pad_load_path(g_dialog);
}

func pad_save_as_dialog() -> i64 {
    str_copy(g_dialog, g_curpath);
    if strcmp(g_dialog, untitled) == 0 { store8(g_dialog, 0); }
    if gui_save_file_dialog(g_ofn, load64(g_hwnd), g_filter, g_dialog, 700, 0, title_app, defext_ancl, 0x806) == 0 { return 0; }
    return pad_save_path(g_dialog);
}

func pad_save() -> i64 {
    if load8(g_curpath) == 0 { return pad_save_as_dialog(); }
    if strcmp(g_curpath, untitled) == 0 { return pad_save_as_dialog(); }
    return pad_save_path(g_curpath);
}

func pad_make_button(hwnd: i64, id: i64, text: i64, x: i64, y: i64, w: i64) -> i64 {
    h = CreateWindowExA(0, gui_button, text, 0x5000000B, x, y, w, 25, hwnd, id, load64(g_hinst), 0);
    gui_set_font(h, load64(g_font_ui));
    return h;
}

func pad_button_label(id: i64) -> i64 {
    if id >= ID_TAB_1 { if id <= ID_TAB_8 { return pad_tab_label(id - ID_TAB_1); } }
    if id >= ID_TAB_CLOSE_1 { if id <= ID_TAB_CLOSE_8 { return txt_tab_close; } }
    if id == ID_MENU_FILE { return mtop_file; }
    if id == ID_MENU_EDIT { return mtop_edit; }
    if id == ID_MENU_BUILD { return mtop_build; }
    if id == ID_MENU_VIEW { return mtop_view; }
    if id == ID_MENU_HELP { return mtop_help; }
    if id == ID_FIND_NEXT { return txt_next; }
    if id == ID_REPL_ONE { return txt_repl; }
    if id == ID_REPL_ALL { return txt_all; }
    if id == ID_GO_LINE { return txt_go; }
    if id == ID_FIND_HIDE { return txt_close; }
    if id == ID_CALC_CONVERT { return txt_convert; }
    if id == ID_CALC_COPY { return txt_copy; }
    if id == ID_CALC_HIDE { return txt_close; }
    if id == ID_FIND_FILES_BROWSE { return txt_browse; }
    if id == ID_FIND_FILES_SEARCH { return txt_search; }
    if id == ID_FIND_FILES_HIDE { return txt_close; }
    if id == ID_COMPARE_HIDE { return txt_close; }
    return rich_empty;
}

func pad_draw_button(lp: i64) -> i64 {
    id = load32(lp + 4); state = load32(lp + 16); hdc = load64(lp + 32); rc = lp + 40;
    if id >= ID_TAB_1 { if id <= ID_TAB_8 {
        br = load64(g_br_button); if id - ID_TAB_1 == load64(g_tab_current) { br = load64(g_br_panel); } else { if band(state, 1) != 0 { br = load64(g_br_hover); } }
        FillRect(hdc, rc, br); op = SelectObject(hdc, load64(g_pen_line));
        gdi_line(hdc, load32(rc), load32(rc + 12) - 1, load32(rc + 8), load32(rc + 12) - 1, load64(g_pen_line));
        if id - ID_TAB_1 == load64(g_tab_current) { gdi_line(hdc, load32(rc), load32(rc + 12) - 2, load32(rc + 8), load32(rc + 12) - 2, load64(g_pen_acc)); }
        SelectObject(hdc, op); of = SelectObject(hdc, load64(g_font_ui)); SetBkMode(hdc, 1); SetTextColor(hdc, COLOR_TEXT); DrawTextA(hdc, pad_button_label(id), 0 - 1, rc, 0x8025); SelectObject(hdc, of); return 1;
    } }
    if id >= ID_TAB_CLOSE_1 { if id <= ID_TAB_CLOSE_8 {
        idx = id - ID_TAB_CLOSE_1; br = load64(g_br_button); if idx == load64(g_tab_current) { br = load64(g_br_panel); } if band(state, 1) != 0 { br = load64(g_br_hover); }
        FillRect(hdc, rc, br); gdi_line(hdc, load32(rc), load32(rc + 12) - 1, load32(rc + 8), load32(rc + 12) - 1, load64(g_pen_line));
        if idx == load64(g_tab_current) { gdi_line(hdc, load32(rc), load32(rc + 12) - 2, load32(rc + 8), load32(rc + 12) - 2, load64(g_pen_acc)); }
        of = SelectObject(hdc, load64(g_font_ui)); SetBkMode(hdc, 1); SetTextColor(hdc, COLOR_DIM); DrawTextA(hdc, txt_tab_close, 0 - 1, rc, 0x25); SelectObject(hdc, of); return 1;
    } }
    br = load64(g_br_button); if band(state, 1) != 0 { br = load64(g_br_hover); }
    FillRect(hdc, rc, load64(g_br_panel));
    ob = SelectObject(hdc, br); op = SelectObject(hdc, load64(g_pen_line));
    RoundRect(hdc, load32(rc), load32(rc + 4), load32(rc + 8), load32(rc + 12), 6, 6);
    SelectObject(hdc, op); SelectObject(hdc, ob);
    of = SelectObject(hdc, load64(g_font_ui)); SetBkMode(hdc, 1); SetTextColor(hdc, COLOR_TEXT);
    DrawTextA(hdc, pad_button_label(id), 0 - 1, rc, 0x25); SelectObject(hdc, of); return 1;
}

func pad_menu_drop(button: i64, menu: i64) -> i64 {
    gui_menu_drop(load64(g_hwnd), button, menu, g_rect); return 0;
}

func pad_open_guide() -> i64 {
    n = pad_exedir(g_guide_path); str_copy(g_guide_path + n, guide_suffix);
    rv = ShellExecuteA(load64(g_hwnd), op_open, g_guide_path, 0, 0, 5);
    if rv <= 32 { pad_set_status(st_noguide); MessageBoxA(load64(g_hwnd), st_noguide, about_title, 0x30); }
    return 0;
}

func pad_build_file_menu() -> i64 {
    old = load64(g_menu_file); if old != 0 { DestroyMenu(old); }
    mf = gui_menu_create();
    gui_menu_item(mf, ID_NEW, mi_new); gui_menu_popup(mf, load64(g_menu_starter), mi_new_starter); gui_menu_item(mf, ID_OPEN, mi_open); gui_menu_item(mf, ID_CLOSE, mi_close);
    gui_menu_sep(mf); gui_menu_item(mf, ID_SAVE, mi_save); gui_menu_item(mf, ID_SAVEAS, mi_saveas);
    gui_menu_sep(mf); gui_menu_item(mf, ID_RECENT_NONE, mi_recent); gui_menu_enable(mf, ID_RECENT_NONE, 0);
    count = load64(g_recent_count); i = 0;
    while i < count { gui_menu_item(mf, ID_RECENT_1 + i, pad_recent_label(i)); i = i + 1; }
    if count == 0 { gui_menu_item(mf, ID_RECENT_1, mi_recent_none); gui_menu_enable(mf, ID_RECENT_1, 0); }
    gui_menu_sep(mf); gui_menu_item(mf, ID_SAMPLE, mi_sample); gui_menu_sep(mf); gui_menu_item(mf, ID_EXIT, mi_exit);
    store64(g_menu_file, mf); return mf;
}

func pad_build_menus() -> i64 {
    ms = gui_menu_create();
    gui_menu_item(ms, ID_ST_MODBUS, mi_st_modbus);
    gui_menu_item(ms, ID_ST_MQTT, mi_st_mqtt);
    gui_menu_item(ms, ID_ST_SQLITE, mi_st_sqlite);
    gui_menu_sep(ms);
    gui_menu_item(ms, ID_ST_BACNET, mi_st_bacnet);
    gui_menu_item(ms, ID_ST_DNP3, mi_st_dnp3);
    gui_menu_item(ms, ID_ST_EIP, mi_st_eip);
    gui_menu_item(ms, ID_ST_FINS, mi_st_fins);
    gui_menu_item(ms, ID_ST_IEC104, mi_st_iec104);
    gui_menu_item(ms, ID_ST_OPCUA, mi_st_opcua);
    gui_menu_item(ms, ID_ST_S7, mi_st_s7);
    store64(g_menu_starter, ms);

    pad_build_file_menu();

    mi = gui_menu_create();
    gui_menu_item(mi, ID_IMP_CSTRING, mi_imp_cstring);
    gui_menu_item(mi, ID_IMP_NUMFMT, mi_imp_numfmt);
    gui_menu_item(mi, ID_IMP_PROCESS, mi_imp_process);
    gui_menu_item(mi, ID_IMP_CAPTURE, mi_imp_capture);
    gui_menu_sep(mi);
    gui_menu_item(mi, ID_IMP_SQLITE, mi_imp_sqlite);
    gui_menu_item(mi, ID_IMP_MQTT, mi_imp_mqtt);
    gui_menu_sep(mi);
    gui_menu_item(mi, ID_IMP_GUI, mi_imp_gui);
    gui_menu_item(mi, ID_IMP_GDI, mi_imp_gdi);
    gui_menu_item(mi, ID_IMP_RICH, mi_imp_rich);
    gui_menu_item(mi, ID_IMP_SYNTAX, mi_imp_syntax);
    store64(g_menu_import, mi);

    me = gui_menu_create();
    gui_menu_item(me, ID_UNDO, mi_undo);
    gui_menu_item(me, ID_REDO, mi_redo);
    gui_menu_sep(me);
    gui_menu_item(me, ID_CUT, mi_cut);
    gui_menu_item(me, ID_COPY, mi_copy);
    gui_menu_item(me, ID_PASTE, mi_paste);
    gui_menu_item(me, ID_SELECTALL, mi_all);
    gui_menu_sep(me);
    gui_menu_popup(me, mi, mi_insert_import);
    gui_menu_sep(me);
    gui_menu_item(me, ID_FIND_SHOW, mi_find);
    gui_menu_item(me, ID_FIND_NEXT, mi_findnext);
    gui_menu_item(me, ID_REPL_SHOW, mi_replace);
    gui_menu_item(me, ID_GOTO_SHOW, mi_goto);
    gui_menu_item(me, ID_FIND_FILES_SHOW, mi_findfiles);
    gui_menu_sep(me);
    gui_menu_item(me, ID_BOOKMARK_TOGGLE, mi_bookmark_toggle);
    gui_menu_item(me, ID_BOOKMARK_NEXT, mi_bookmark_next);
    gui_menu_item(me, ID_BOOKMARK_PREV, mi_bookmark_prev);
    gui_menu_item(me, ID_BOOKMARK_CLEAR, mi_bookmark_clear);
    store64(g_menu_edit, me);

    mbu = gui_menu_create();
    gui_menu_item(mbu, ID_BUILD_COMPILE, mi_compile);
    gui_menu_item(mbu, ID_BUILD_RUN, mi_run);
    gui_menu_item(mbu, ID_BUILD_FIX, mi_fix);
    gui_menu_sep(mbu);
    gui_menu_item(mbu, ID_OUTPUT_SHOW, mi_showout);
    gui_menu_item(mbu, ID_OUTPUT_HIDE, mi_hideout);
    store64(g_menu_build, mbu);
    pad_update_build_menu();

    menc = gui_menu_create();
    gui_menu_item(menc, ID_ENC_ANSI, mi_enc_ansi);
    gui_menu_item(menc, ID_ENC_UTF8, mi_enc_utf8);
    gui_menu_item(menc, ID_ENC_UTF8_BOM, mi_enc_utf8_bom);
    gui_menu_item(menc, ID_ENC_UTF16, mi_enc_utf16);
    store64(g_menu_encoding, menc);

    meol = gui_menu_create();
    gui_menu_item(meol, ID_EOL_CRLF, mi_eol_crlf);
    gui_menu_item(meol, ID_EOL_LF, mi_eol_lf);
    gui_menu_item(meol, ID_EOL_CR, mi_eol_cr);
    store64(g_menu_eol, meol);

    mv = gui_menu_create();
    gui_menu_item(mv, ID_CALC_SHOW, mi_calc);
    gui_menu_item(mv, ID_COMPARE_SHOW, mi_compare);
    gui_menu_item(mv, ID_COMPARE_HIDE, mi_compare_close);
    gui_menu_sep(mv);
    gui_menu_popup(mv, menc, mi_encoding);
    gui_menu_popup(mv, meol, mi_line_endings);
    gui_menu_sep(mv);
    gui_menu_item(mv, ID_LANG_AUTO, mi_lang_auto);
    gui_menu_item(mv, ID_LANG_ANCL, mi_lang_ancl);
    gui_menu_item(mv, ID_LANG_PY, mi_lang_py);
    gui_menu_item(mv, ID_LANG_CS, mi_lang_cs);
    gui_menu_item(mv, ID_LANG_LOG, mi_lang_log);
    gui_menu_item(mv, ID_LANG_TXT, mi_lang_txt);
    gui_menu_sep(mv);
    gui_menu_item(mv, ID_LANG_JSON, mi_lang_json);
    gui_menu_item(mv, ID_LANG_XML, mi_lang_xml);
    gui_menu_item(mv, ID_LANG_HTML, mi_lang_html);
    gui_menu_item(mv, ID_LANG_SQL, mi_lang_sql);
    gui_menu_item(mv, ID_LANG_MD, mi_lang_md);
    gui_menu_item(mv, ID_LANG_INI, mi_lang_ini);
    gui_menu_item(mv, ID_LANG_PS, mi_lang_ps);
    gui_menu_sep(mv);
    gui_menu_item(mv, ID_RECOLOR, mi_recolor);
    gui_menu_item(mv, ID_GUTTER, mi_gutter);
    store64(g_menu_view, mv);
    pad_update_format_menu();

    mh = gui_menu_create();
    gui_menu_item(mh, ID_GUIDE, mi_guide);
    gui_menu_item(mh, ID_HELP_KEYS, mi_shortcuts);
    gui_menu_item(mh, ID_BUNDLE, mi_bundle);
    gui_menu_sep(mh);
    gui_menu_item(mh, ID_ABOUT, mi_about);
    store64(g_menu_help, mh);

    return 0;
}

func pad_command(id: i64) -> i64 {
    if id == ID_MENU_FILE { pad_build_file_menu(); pad_menu_drop(load64(g_mb_file), load64(g_menu_file)); return 0; }
    if id == ID_MENU_EDIT { pad_menu_drop(load64(g_mb_edit), load64(g_menu_edit)); return 0; }
    if id == ID_MENU_BUILD { pad_menu_drop(load64(g_mb_build), load64(g_menu_build)); return 0; }
    if id == ID_MENU_VIEW { pad_update_format_menu(); pad_menu_drop(load64(g_mb_view), load64(g_menu_view)); return 0; }
    if id == ID_MENU_HELP { pad_menu_drop(load64(g_mb_help), load64(g_menu_help)); return 0; }
    if id >= ID_TAB_1 { if id <= ID_TAB_8 { pad_tab_activate(id - ID_TAB_1); return 0; } }
    if id >= ID_TAB_CLOSE_1 { if id <= ID_TAB_CLOSE_8 { idx = id - ID_TAB_CLOSE_1; if idx < load64(g_tab_count) { pad_tab_activate(idx); pad_close_document(); } return 0; } }
    if id == ID_NEW { pad_new(); return 0; }
    if id == ID_OPEN { pad_open_dialog(); return 0; }
    if id == ID_CLOSE { pad_close_document(); return 0; }
    if id >= ID_RECENT_1 { if id <= ID_RECENT_3 { idx = id - ID_RECENT_1; if idx < load64(g_recent_count) { cstr_copy_n(g_dialog, g_recent_paths + idx * 700, 700); pad_load_path(g_dialog); } return 0; } }
    if id == ID_SAVE { pad_save(); return 0; }
    if id == ID_SAVEAS { pad_save_as_dialog(); return 0; }
    if id == ID_SAMPLE { pad_load_sample(); return 0; }
    if id == ID_ST_MODBUS { pad_load_starter(fn_modbus); return 0; }
    if id == ID_ST_MQTT { pad_load_starter(fn_mqtt); return 0; }
    if id == ID_ST_SQLITE { pad_load_starter(fn_sqlite); return 0; }
    if id == ID_ST_BACNET { pad_load_starter(fn_bacnet); return 0; }
    if id == ID_ST_DNP3 { pad_load_starter(fn_dnp3); return 0; }
    if id == ID_ST_EIP { pad_load_starter(fn_eip); return 0; }
    if id == ID_ST_FINS { pad_load_starter(fn_fins); return 0; }
    if id == ID_ST_IEC104 { pad_load_starter(fn_iec104); return 0; }
    if id == ID_ST_OPCUA { pad_load_starter(fn_opcua); return 0; }
    if id == ID_ST_S7 { pad_load_starter(fn_s7); return 0; }
    if id == ID_EXIT { SendMessageA(load64(g_hwnd), 16, 0, 0); return 0; }
    if id == ID_UNDO { rich_undo(load64(g_editor)); pad_update_status(); return 0; }
    if id == ID_REDO { rich_redo(load64(g_editor)); pad_update_status(); return 0; }
    if id == ID_CUT { rich_cut(load64(g_editor)); return 0; }
    if id == ID_COPY { rich_copy(load64(g_editor)); return 0; }
    if id == ID_PASTE { rich_paste(load64(g_editor)); return 0; }
    if id == ID_SELECTALL { rich_select_all(load64(g_editor)); return 0; }
    if id == ID_IMP_CSTRING { pad_insert_import(imp_cstring); return 0; }
    if id == ID_IMP_NUMFMT { pad_insert_import(imp_numfmt); return 0; }
    if id == ID_IMP_PROCESS { pad_insert_import(imp_process); return 0; }
    if id == ID_IMP_CAPTURE { pad_insert_import(imp_capture); return 0; }
    if id == ID_IMP_SQLITE { pad_insert_import(imp_sqlite); return 0; }
    if id == ID_IMP_MQTT { pad_insert_import(imp_mqtt); return 0; }
    if id == ID_IMP_GUI { pad_insert_import(imp_gui); return 0; }
    if id == ID_IMP_GDI { pad_insert_import(imp_gdi); return 0; }
    if id == ID_IMP_RICH { pad_insert_import(imp_rich); return 0; }
    if id == ID_IMP_SYNTAX { pad_insert_import(imp_syntax); return 0; }
    if id == ID_FIND_SHOW { pad_show_find(1); return 0; }
    if id == ID_FIND_NEXT { pad_find_next(); return 0; }
    if id == ID_REPL_SHOW { pad_show_find(2); return 0; }
    if id == ID_REPL_ONE { pad_replace_one(); return 0; }
    if id == ID_REPL_ALL { pad_replace_all(); return 0; }
    if id == ID_GOTO_SHOW { pad_show_find(3); return 0; }
    if id == ID_GO_LINE { pad_goto_line(); return 0; }
    if id == ID_FIND_HIDE { pad_hide_find(); return 0; }
    if id == ID_FIND_FILES_SHOW { pad_show_files(); return 0; }
    if id == ID_FIND_FILES_SEARCH { pad_files_run(); return 0; }
    if id == ID_FIND_FILES_BROWSE { pad_files_browse(); return 0; }
    if id == ID_FIND_FILES_HIDE { pad_hide_files(); return 0; }
    if id == ID_BOOKMARK_TOGGLE { pad_bookmark_toggle(); return 0; }
    if id == ID_BOOKMARK_NEXT { pad_bookmark_jump(1); return 0; }
    if id == ID_BOOKMARK_PREV { pad_bookmark_jump(0 - 1); return 0; }
    if id == ID_BOOKMARK_CLEAR { pad_bookmark_clear(); return 0; }
    if id == ID_BUILD_COMPILE { pad_compile_current(0); return 0; }
    if id == ID_BUILD_RUN { pad_compile_current(1); return 0; }
    if id == ID_BUILD_FIX { pad_fix_current(); return 0; }
    if id == ID_OUTPUT_SHOW { pad_show_output(1); return 0; }
    if id == ID_OUTPUT_HIDE { pad_show_output(0); return 0; }
    if id == ID_CALC_SHOW { pad_show_calc(); return 0; }
    if id == ID_CALC_CONVERT { pad_calc_convert(); return 0; }
    if id == ID_CALC_COPY { pad_calc_copy(); return 0; }
    if id == ID_CALC_HIDE { pad_hide_calc(); return 0; }
    if id == ID_COMPARE_SHOW { pad_compare_open(); return 0; }
    if id == ID_COMPARE_HIDE { pad_compare_hide(); return 0; }
    if id == ID_ENC_ANSI { pad_set_encoding(TEXT_ENC_ANSI); return 0; }
    if id == ID_ENC_UTF8 { pad_set_encoding(TEXT_ENC_UTF8); return 0; }
    if id == ID_ENC_UTF8_BOM { pad_set_encoding(TEXT_ENC_UTF8_BOM); return 0; }
    if id == ID_ENC_UTF16 { pad_set_encoding(TEXT_ENC_UTF16_LE); return 0; }
    if id == ID_EOL_CRLF { pad_set_eol(TEXT_EOL_CRLF); return 0; }
    if id == ID_EOL_LF { pad_set_eol(TEXT_EOL_LF); return 0; }
    if id == ID_EOL_CR { pad_set_eol(TEXT_EOL_CR); return 0; }
    if id == ID_LANG_AUTO { pad_set_lang(SYN_MODE_AUTO); return 0; }
    if id == ID_LANG_ANCL { pad_set_lang(SYN_MODE_ANCL); return 0; }
    if id == ID_LANG_PY { pad_set_lang(SYN_MODE_PYTHON); return 0; }
    if id == ID_LANG_CS { pad_set_lang(SYN_MODE_CSHARP); return 0; }
    if id == ID_LANG_LOG { pad_set_lang(SYN_MODE_LOG); return 0; }
    if id == ID_LANG_TXT { pad_set_lang(SYN_MODE_TEXT); return 0; }
    if id == ID_LANG_JSON { pad_set_lang(SYN_MODE_JSON); return 0; }
    if id == ID_LANG_XML { pad_set_lang(SYN_MODE_XML); return 0; }
    if id == ID_LANG_HTML { pad_set_lang(SYN_MODE_HTML); return 0; }
    if id == ID_LANG_SQL { pad_set_lang(SYN_MODE_SQL); return 0; }
    if id == ID_LANG_MD { pad_set_lang(SYN_MODE_MARKDOWN); return 0; }
    if id == ID_LANG_INI { pad_set_lang(SYN_MODE_INI); return 0; }
    if id == ID_LANG_PS { pad_set_lang(SYN_MODE_POWERSHELL); return 0; }
    if id == ID_RECOLOR { pad_recolor_chars(0, 0 - 1); pad_update_status(); return 0; }
    if id == ID_GUTTER { InvalidateRect(load64(g_hwnd), g_gutter, 0); return 0; }
    if id == ID_GUIDE { pad_open_guide(); return 0; }
    if id == ID_HELP_KEYS { MessageBoxA(load64(g_hwnd), shortcuts_text, about_title, 0x40); return 0; }
    if id == ID_BUNDLE { MessageBoxA(load64(g_hwnd), bundle_text, bundle_title, 0x40); return 0; }
    if id == ID_ABOUT { MessageBoxA(load64(g_hwnd), about_text, about_title, 0x40); return 0; }
    return 0;
}

func pad_handle_key(vk: i64, ctrl: i64, shft: i64) -> i64 {
    if vk == 0x70 { pad_command(ID_GUIDE); return 1; }
    if vk == 0x71 { if ctrl != 0 { pad_command(ID_BOOKMARK_TOGGLE); } else { if shft != 0 { pad_command(ID_BOOKMARK_PREV); } else { pad_command(ID_BOOKMARK_NEXT); } } return 1; }
    if vk == 0x72 { pad_command(ID_FIND_NEXT); return 1; }
    if vk == 0x74 { pad_command(ID_BUILD_RUN); return 1; }
    if vk == 0x1B {
        if load64(g_find_visible) != 0 { pad_command(ID_FIND_HIDE); return 1; }
        if load64(g_calc_visible) != 0 { pad_command(ID_CALC_HIDE); return 1; }
        if load64(g_files_visible) != 0 { pad_command(ID_FIND_FILES_HIDE); return 1; }
    }
    if vk == 13 {
        f = GetFocus();
        if f == load64(g_find_ed) { pad_command(ID_FIND_NEXT); return 1; }
        if f == load64(g_repl_ed) { pad_command(ID_REPL_ONE); return 1; }
        if f == load64(g_line_ed) { pad_command(ID_GO_LINE); return 1; }
        if f == load64(g_calc_dec_ed) { pad_calc_from_field(ID_CALC_DEC); return 1; }
        if f == load64(g_calc_hex_ed) { pad_calc_from_field(ID_CALC_HEX); return 1; }
        if f == load64(g_calc_bin_ed) { pad_calc_from_field(ID_CALC_BIN); return 1; }
        if f == load64(g_calc_bcd_ed) { pad_calc_from_field(ID_CALC_BCD); return 1; }
        if f == load64(g_files_find_ed) { pad_files_run(); return 1; }
        if f == load64(g_files_folder_ed) { pad_files_run(); return 1; }
    }
    if ctrl == 0 { return 0; }
    if vk == 9 {
        count = load64(g_tab_count); if count > 1 { next = load64(g_tab_current) + 1; if shft != 0 { next = load64(g_tab_current) - 1; } if next >= count { next = 0; } if next < 0 { next = count - 1; } pad_tab_activate(next); }
        return 1;
    }
    if vk == 78 { pad_command(ID_NEW); return 1; }
    if vk == 79 { pad_command(ID_OPEN); return 1; }
    if vk == 87 { pad_command(ID_CLOSE); return 1; }
    if vk == 83 {
        if shft != 0 { pad_command(ID_SAVEAS); } else { pad_command(ID_SAVE); }
        return 1;
    }
    if vk == 66 {
        if shft != 0 { pad_command(ID_BUILD_FIX); } else { pad_command(ID_BUILD_COMPILE); }
        return 1;
    }
    if vk == 90 { pad_command(ID_UNDO); return 1; }
    if vk == 89 { pad_command(ID_REDO); return 1; }
    if vk == 88 { pad_command(ID_CUT); return 1; }
    if vk == 67 { pad_command(ID_COPY); return 1; }
    if vk == 86 { pad_command(ID_PASTE); return 1; }
    if vk == 65 { pad_command(ID_SELECTALL); return 1; }
    if vk == 70 { if shft != 0 { pad_command(ID_FIND_FILES_SHOW); } else { pad_command(ID_FIND_SHOW); } return 1; }
    if vk == 72 { pad_command(ID_REPL_SHOW); return 1; }
    if vk == 71 { pad_command(ID_GOTO_SHOW); return 1; }
    if vk == 75 {
        if shft != 0 { pad_command(ID_CALC_SHOW); return 1; }
    }
    return 0;
}

func pad_message_loop() -> i64 {
    while 1 {
        r = GetMessageA(g_msg, 0, 0, 0);
        if r == 0 { return 0; }
        skip = 0;
        if gui_msg_is_keydown(g_msg) != 0 {
            skip = pad_handle_key(gui_msg_vk(g_msg), gui_key_down(0x11), gui_key_down(0x10));
        }
        if skip == 0 {
            TranslateMessage(g_msg);
            DispatchMessageA(g_msg);
        }
    }
    return 0;
}

func pad_reflow(w: i64, h: i64) -> i64 {
    if w < 920 { w = 920; }
    if h < 480 { h = 480; }
    tab_y = 118; top = 148;
    if load64(g_find_visible) != 0 { tab_y = 152; top = 182; }
    if load64(g_calc_visible) != 0 { tab_y = 152; top = 182; }
    if load64(g_files_visible) != 0 { tab_y = 152; top = 182; }
    bottom = h - 54;
    out_top = bottom;
    if load64(g_output_visible) != 0 {
        out_top = bottom - 140;
        bottom = out_top - 10;
    }
    left_right = w - 18; right_left = w;
    if load64(g_compare_visible) != 0 { half = (w - 46) / 2; left_right = 18 + half; right_left = left_right + 10; gdi_rect_set(g_compare_gutter, right_left, top, right_left + 42, bottom); }
    gdi_rect_set(g_gutter, 18, top, 60, bottom);
    if load64(g_path_ed) != 0 { MoveWindow(load64(g_path_ed), 82, 81, w - 98, 24, 1); }
    if load64(g_find_lbl) != 0 { MoveWindow(load64(g_find_lbl), 18, 121, 36, 20, 1); }
    if load64(g_find_ed) != 0 { MoveWindow(load64(g_find_ed), 56, 117, 180, 24, 1); }
    if load64(g_find_btn) != 0 { MoveWindow(load64(g_find_btn), 240, 116, 54, 25, 1); }
    if load64(g_repl_lbl) != 0 { MoveWindow(load64(g_repl_lbl), 304, 121, 54, 20, 1); }
    if load64(g_repl_ed) != 0 { MoveWindow(load64(g_repl_ed), 362, 117, 180, 24, 1); }
    if load64(g_repl_btn) != 0 { MoveWindow(load64(g_repl_btn), 546, 116, 68, 25, 1); }
    if load64(g_all_btn) != 0 { MoveWindow(load64(g_all_btn), 618, 116, 42, 25, 1); }
    if load64(g_line_lbl) != 0 { MoveWindow(load64(g_line_lbl), 674, 121, 32, 20, 1); }
    if load64(g_line_ed) != 0 { MoveWindow(load64(g_line_ed), 710, 117, 54, 24, 1); }
    if load64(g_go_btn) != 0 { MoveWindow(load64(g_go_btn), 768, 116, 42, 25, 1); }
    if load64(g_hide_btn) != 0 { MoveWindow(load64(g_hide_btn), w - 50, 116, 34, 25, 1); }
    if load64(g_calc_lbl) != 0 { MoveWindow(load64(g_calc_lbl), 18, 121, 42, 20, 1); }
    if load64(g_calc_in) != 0 { MoveWindow(load64(g_calc_in), 64, 117, 180, 24, 1); }
    if load64(g_calc_btn) != 0 { MoveWindow(load64(g_calc_btn), 250, 116, 68, 25, 1); }
    if load64(g_calc_copy_btn) != 0 { MoveWindow(load64(g_calc_copy_btn), w - 124, 116, 60, 25, 1); }
    if load64(g_calc_msg_lbl) != 0 { MoveWindow(load64(g_calc_msg_lbl), 390, 121, w - 458, 20, 1); }
    if load64(g_calc_hide_btn) != 0 { MoveWindow(load64(g_calc_hide_btn), w - 58, 116, 34, 25, 1); }
    if load64(g_calc_dec_lbl) != 0 { MoveWindow(load64(g_calc_dec_lbl), 18, 121, 28, 20, 1); }
    if load64(g_calc_dec_ed) != 0 { MoveWindow(load64(g_calc_dec_ed), 50, 117, 128, 24, 1); }
    if load64(g_calc_hex_lbl) != 0 { MoveWindow(load64(g_calc_hex_lbl), 186, 121, 28, 20, 1); }
    if load64(g_calc_hex_ed) != 0 { MoveWindow(load64(g_calc_hex_ed), 218, 117, 128, 24, 1); }
    if load64(g_calc_bin_lbl) != 0 { MoveWindow(load64(g_calc_bin_lbl), 354, 121, 24, 20, 1); }
    if load64(g_calc_bin_ed) != 0 { MoveWindow(load64(g_calc_bin_ed), 382, 117, 220, 24, 1); }
    if load64(g_calc_bcd_lbl) != 0 { MoveWindow(load64(g_calc_bcd_lbl), 610, 121, 32, 20, 1); }
    if load64(g_calc_bcd_ed) != 0 { MoveWindow(load64(g_calc_bcd_ed), 646, 117, w - 784, 24, 1); }
    if load64(g_files_find_lbl) != 0 { MoveWindow(load64(g_files_find_lbl), 18, 121, 30, 20, 1); }
    if load64(g_files_find_ed) != 0 { MoveWindow(load64(g_files_find_ed), 52, 117, 180, 24, 1); }
    if load64(g_files_folder_lbl) != 0 { MoveWindow(load64(g_files_folder_lbl), 244, 121, 44, 20, 1); }
    if load64(g_files_folder_ed) != 0 { MoveWindow(load64(g_files_folder_ed), 292, 117, w - 496, 24, 1); }
    if load64(g_files_browse_btn) != 0 { MoveWindow(load64(g_files_browse_btn), w - 196, 116, 66, 25, 1); }
    if load64(g_files_search_btn) != 0 { MoveWindow(load64(g_files_search_btn), w - 124, 116, 68, 25, 1); }
    if load64(g_files_hide_btn) != 0 { MoveWindow(load64(g_files_hide_btn), w - 50, 116, 34, 25, 1); }
    count = load64(g_tab_count); tw = 180; avail = w - 36; min_tw = 90; if load64(g_compare_visible) != 0 { avail = left_right - 18; min_tw = 50; }
    if count > 0 { if tw * count > avail { tw = avail / count; } } if tw < min_tw { tw = min_tw; }
    i = 0; while i < PAD_MAX_TABS {
        htab = load64(g_tab_buttons + i * 8); hclose = load64(g_tab_close_buttons + i * 8);
        if htab != 0 { MoveWindow(htab, 18 + i * tw, tab_y, tw - 26, 26, 1); }
        if hclose != 0 { MoveWindow(hclose, 18 + (i + 1) * tw - 26, tab_y, 26, 26, 1); }
        i = i + 1;
    }
    if load64(g_editor) != 0 { MoveWindow(load64(g_editor), 60, top, left_right - 60, bottom - top, 1); }
    if load64(g_compare_visible) != 0 {
        if load64(g_compare_label) != 0 { MoveWindow(load64(g_compare_label), right_left + 8, tab_y + 4, w - right_left - 62, 20, 1); }
        if load64(g_compare_close) != 0 { MoveWindow(load64(g_compare_close), w - 50, tab_y, 34, 26, 1); }
        if load64(g_compare) != 0 { MoveWindow(load64(g_compare), right_left + 42, top, w - right_left - 60, bottom - top, 1); }
    }
    if load64(g_output) != 0 { MoveWindow(load64(g_output), 16, out_top, w - 32, 140, 1); }
    if load64(g_status) != 0 { MoveWindow(load64(g_status), 18, h - 34, w - 36, 22, 1); }
    InvalidateRect(load64(g_hwnd), 0, 1);
    return 0;
}

func create_controls(hwnd: i64) -> i64 {
    store64(g_hwnd, hwnd);
    hinst = load64(g_hinst);
    f = load64(g_font_ui);

    h = pad_make_button(hwnd, ID_MENU_FILE, mtop_file, 18, 49, 52); store64(g_mb_file, h);
    h = pad_make_button(hwnd, ID_MENU_EDIT, mtop_edit, 74, 49, 52); store64(g_mb_edit, h);
    h = pad_make_button(hwnd, ID_MENU_BUILD, mtop_build, 130, 49, 58); store64(g_mb_build, h);
    h = pad_make_button(hwnd, ID_MENU_VIEW, mtop_view, 192, 49, 54); store64(g_mb_view, h);
    h = pad_make_button(hwnd, ID_MENU_HELP, mtop_help, 250, 49, 56); store64(g_mb_help, h);

    gui_set_font(gui_static_text(hwnd, hinst, txt_path, 18, 85, 42, 20), f);
    h = gui_edit_text(hwnd, hinst, ID_PATH, untitled, 82, 81, 900, 24);
    store64(g_path_ed, h);
    gui_set_font(h, f);

    i = 0; while i < PAD_MAX_TABS {
        h = pad_make_button(hwnd, ID_TAB_1 + i, rich_empty, 18 + i * 120, 118, 94); store64(g_tab_buttons + i * 8, h); ShowWindow(h, 0);
        h = pad_make_button(hwnd, ID_TAB_CLOSE_1 + i, txt_tab_close, 112 + i * 120, 118, 26); store64(g_tab_close_buttons + i * 8, h); ShowWindow(h, 0); i = i + 1;
    }
    h = gui_static_text(hwnd, hinst, txt_compare, 560, 122, 420, 20); store64(g_compare_label, h); gui_set_font(h, f); ShowWindow(h, 0);
    h = pad_make_button(hwnd, ID_COMPARE_HIDE, txt_close, 946, 118, 34); store64(g_compare_close, h); ShowWindow(h, 0);

    h = gui_static_text(hwnd, hinst, txt_find, 18, 121, 30, 20); store64(g_files_find_lbl, h); gui_set_font(h, f);
    h = gui_edit_text(hwnd, hinst, 306, rich_empty, 52, 117, 180, 24); store64(g_files_find_ed, h); gui_set_font(h, f);
    h = gui_static_text(hwnd, hinst, txt_folder, 244, 121, 44, 20); store64(g_files_folder_lbl, h); gui_set_font(h, f);
    h = gui_edit_text(hwnd, hinst, 307, rich_empty, 292, 117, 500, 24); store64(g_files_folder_ed, h); gui_set_font(h, f);
    h = pad_make_button(hwnd, ID_FIND_FILES_BROWSE, txt_browse, 800, 116, 66); store64(g_files_browse_btn, h);
    h = pad_make_button(hwnd, ID_FIND_FILES_SEARCH, txt_search, 872, 116, 68); store64(g_files_search_btn, h);
    h = pad_make_button(hwnd, ID_FIND_FILES_HIDE, txt_close, 946, 116, 34); store64(g_files_hide_btn, h); pad_show_files_controls(0);

    h = gui_static_text(hwnd, hinst, txt_find, 18, 51, 36, 20);
    store64(g_find_lbl, h); gui_set_font(h, f);
    h = gui_edit_text(hwnd, hinst, 301, rich_empty, 56, 47, 180, 24);
    store64(g_find_ed, h); gui_set_font(h, f);
    h = pad_make_button(hwnd, ID_FIND_NEXT, txt_next, 240, 116, 54);
    store64(g_find_btn, h); gui_set_font(h, f);
    h = gui_static_text(hwnd, hinst, txt_replace, 304, 51, 54, 20);
    store64(g_repl_lbl, h); gui_set_font(h, f);
    h = gui_edit_text(hwnd, hinst, 302, rich_empty, 362, 47, 180, 24);
    store64(g_repl_ed, h); gui_set_font(h, f);
    h = pad_make_button(hwnd, ID_REPL_ONE, txt_repl, 546, 116, 68);
    store64(g_repl_btn, h); gui_set_font(h, f);
    h = pad_make_button(hwnd, ID_REPL_ALL, txt_all, 618, 116, 42);
    store64(g_all_btn, h); gui_set_font(h, f);
    h = gui_static_text(hwnd, hinst, txt_line, 674, 51, 32, 20);
    store64(g_line_lbl, h); gui_set_font(h, f);
    h = gui_edit_text(hwnd, hinst, 303, rich_empty, 710, 47, 54, 24);
    store64(g_line_ed, h); gui_set_font(h, f);
    h = pad_make_button(hwnd, ID_GO_LINE, txt_go, 768, 116, 42);
    store64(g_go_btn, h); gui_set_font(h, f);
    h = pad_make_button(hwnd, ID_FIND_HIDE, txt_close, 820, 116, 34);
    store64(g_hide_btn, h); gui_set_font(h, f);
    pad_show_find_controls(0);

    h = gui_static_text(hwnd, hinst, txt_value, 18, 51, 42, 20);
    store64(g_calc_lbl, h); gui_set_font(h, f);
    h = gui_edit_text(hwnd, hinst, 305, calc_zero, 64, 47, 180, 24);
    store64(g_calc_in, h); gui_set_font(h, f);
    h = pad_make_button(hwnd, ID_CALC_CONVERT, txt_convert, 250, 116, 68);
    store64(g_calc_btn, h); gui_set_font(h, f);
    h = pad_make_button(hwnd, ID_CALC_COPY, txt_copy, 324, 116, 54);
    store64(g_calc_copy_btn, h); gui_set_font(h, f);
    h = gui_static_text(hwnd, hinst, st_calc_ready, 390, 51, 440, 20);
    store64(g_calc_msg_lbl, h); gui_set_font(h, f);
    h = pad_make_button(hwnd, ID_CALC_HIDE, txt_close, 820, 116, 34);
    store64(g_calc_hide_btn, h); gui_set_font(h, f);
    h = gui_static_text(hwnd, hinst, txt_dec, 18, 82, 28, 20);
    store64(g_calc_dec_lbl, h); gui_set_font(h, f);
    h = gui_edit_text(hwnd, hinst, ID_CALC_DEC, rich_empty, 50, 78, 128, 24);
    store64(g_calc_dec_ed, h); gui_set_font(h, f);
    h = gui_static_text(hwnd, hinst, txt_hex, 186, 82, 28, 20);
    store64(g_calc_hex_lbl, h); gui_set_font(h, f);
    h = gui_edit_text(hwnd, hinst, ID_CALC_HEX, rich_empty, 218, 78, 128, 24);
    store64(g_calc_hex_ed, h); gui_set_font(h, f);
    h = gui_static_text(hwnd, hinst, txt_bin, 354, 82, 24, 20);
    store64(g_calc_bin_lbl, h); gui_set_font(h, f);
    h = gui_edit_text(hwnd, hinst, ID_CALC_BIN, rich_empty, 382, 78, 220, 24);
    store64(g_calc_bin_ed, h); gui_set_font(h, f);
    h = gui_static_text(hwnd, hinst, txt_bcd, 610, 82, 32, 20);
    store64(g_calc_bcd_lbl, h); gui_set_font(h, f);
    h = gui_edit_text(hwnd, hinst, ID_CALC_BCD, rich_empty, 646, 78, 240, 24);
    store64(g_calc_bcd_ed, h); gui_set_font(h, f);
    pad_show_calc_controls(0);

    ed = rich_create(hwnd, hinst, ID_EDITOR, 60, 48, 900, 600);
    store64(g_editor, ed);
    gui_set_font(ed, load64(g_font_code));
    rich_limit_text(ed, 1048576);
    rich_set_bg(ed, COLOR_EDITOR);
    rich_set_event_mask(ed, 0x00080005);
    rich_cf_color(g_cf, COLOR_DEFAULT);
    rich_set_charformat(ed, SCF_ALL, g_cf);

    cmp = rich_create(hwnd, hinst, ID_COMPARE_EDITOR, 560, 148, 420, 500);
    store64(g_compare, cmp); gui_set_font(cmp, load64(g_font_code)); rich_limit_text(cmp, 1048576); rich_set_bg(cmp, COLOR_EDITOR); rich_set_event_mask(cmp, 0x00080005); SendMessageA(cmp, 0xCF, 1, 0); ShowWindow(cmp, 0);

    out = rich_create(hwnd, hinst, 304, 16, 590, 900, 120);
    store64(g_output, out);
    gui_set_font(out, load64(g_font_code));
    rich_set_bg(out, COLOR_EDITOR);
    rich_set_event_mask(out, 0x00080005);
    SendMessageA(out, 0xCF, 1, 0);
    ShowWindow(out, 0);

    h = gui_static_text(hwnd, hinst, st_ready, 16, 670, 900, 22);
    store64(g_status, h);
    gui_set_font(h, f);

    GetClientRect(hwnd, g_rect);
    pad_reflow(load32(g_rect + 8), load32(g_rect + 12));
    if pad_recovery_restore() == 0 { if pad_session_restore() == 0 { pad_load_sample(); } }
    i = load64(g_tab_current); if i >= 0 { cstr_copy_n(g_curpath, pad_tab_path(i), 700); SetWindowTextA(load64(g_path_ed), g_curpath); pad_update_build_menu(); pad_update_status(); }
    SetTimer(hwnd, 10, 15000, 0);
    return 0;
}

func MainWndProc(hwnd: i64, msg: i64, wp: i64, lp: i64) -> i64 {
    if msg == 1 { create_controls(hwnd); return 0; }

    if msg == 43 { return pad_draw_button(lp); }

    if msg == 5 {
        pad_reflow(gui_loword(lp), gui_hiword(lp));
        return 0;
    }

    if msg == 273 {
        id = gui_loword(wp);
        if id == ID_EDITOR {
            if load64(g_in_recolor) == 1 { return 0; }
            ncode = gui_hiword(wp);
            if ncode == 768 {
                if load64(g_loading) == 0 { SetTimer(hwnd, 7, 120, 0); }
                if load64(g_loading) == 0 { i = load64(g_tab_current); if i >= 0 { dirty = rich_get_modified(load64(g_editor)); if dirty != load64(g_tab_dirty + i * 8) { store64(g_tab_dirty + i * 8, dirty); pad_tabs_refresh(); } } }
                InvalidateRect(hwnd, g_gutter, 0);
                pad_update_status();
            }
            if ncode == 1538 {
                InvalidateRect(hwnd, g_gutter, 0);
                if load64(g_in_recolor) == 0 {
                    if load64(g_scroll_pend) == 0 {
                        store64(g_scroll_pend, 1);
                        SetTimer(hwnd, 8, 40, 0);
                    }
                }
            }
            return 0;
        }
        if id == ID_COMPARE_EDITOR { if gui_hiword(wp) == 1538 { InvalidateRect(hwnd, g_compare_gutter, 0); } return 0; }
        ncode2 = gui_hiword(wp);
        if load64(g_calc_visible) != 0 {
            if ncode2 == 768 {
                if id == ID_CALC_DEC { pad_calc_from_field(ID_CALC_DEC); return 0; }
                if id == ID_CALC_HEX { pad_calc_from_field(ID_CALC_HEX); return 0; }
                if id == ID_CALC_BIN { pad_calc_from_field(ID_CALC_BIN); return 0; }
                if id == ID_CALC_BCD { pad_calc_from_field(ID_CALC_BCD); return 0; }
            }
        }
        pad_command(id);
        return 0;
    }

    if msg == 78 {
        if load64(lp + 0) == load64(g_editor) {
            if load64(g_in_recolor) == 1 || load64(g_in_bracket) == 1 { return 0; }
            if load32(lp + 16) == 0x702 { pad_update_status(); pad_bracket_update(); return 0; }
        }
        if load64(lp + 0) == load64(g_output) { if load32(lp + 16) == 0x702 { pad_output_jump(); return 0; } }
        return 0;
    }

    if msg == 275 {
        if wp == 7 {
            KillTimer(hwnd, 7);
            pad_recolor();
        }
        if wp == 8 {
            KillTimer(hwnd, 8);
            store64(g_scroll_pend, 0);
            pad_recolor();
        }
        if wp == 10 { pad_recovery_save(); }
        return 0;
    }

    if msg == 307 {
        if lp == load64(g_editor) {
            SetTextColor(wp, COLOR_DEFAULT);
            SetBkColor(wp, COLOR_EDITOR);
            return load64(g_br_editor);
        }
        if lp == load64(g_path_ed) {
            SetTextColor(wp, COLOR_DEFAULT);
            SetBkColor(wp, COLOR_EDITOR);
            return load64(g_br_editor);
        }
        if lp == load64(g_find_ed) {
            SetTextColor(wp, COLOR_DEFAULT);
            SetBkColor(wp, COLOR_EDITOR);
            return load64(g_br_editor);
        }
        if lp == load64(g_repl_ed) {
            SetTextColor(wp, COLOR_DEFAULT);
            SetBkColor(wp, COLOR_EDITOR);
            return load64(g_br_editor);
        }
        if lp == load64(g_line_ed) {
            SetTextColor(wp, COLOR_DEFAULT);
            SetBkColor(wp, COLOR_EDITOR);
            return load64(g_br_editor);
        }
        if lp == load64(g_calc_in) {
            SetTextColor(wp, COLOR_DEFAULT);
            SetBkColor(wp, COLOR_EDITOR);
            return load64(g_br_editor);
        }
        if lp == load64(g_calc_dec_ed) {
            SetTextColor(wp, COLOR_DEFAULT);
            SetBkColor(wp, COLOR_EDITOR);
            return load64(g_br_editor);
        }
        if lp == load64(g_calc_hex_ed) {
            SetTextColor(wp, COLOR_DEFAULT);
            SetBkColor(wp, COLOR_EDITOR);
            return load64(g_br_editor);
        }
        if lp == load64(g_calc_bin_ed) {
            SetTextColor(wp, COLOR_DEFAULT);
            SetBkColor(wp, COLOR_EDITOR);
            return load64(g_br_editor);
        }
        if lp == load64(g_calc_bcd_ed) {
            SetTextColor(wp, COLOR_DEFAULT);
            SetBkColor(wp, COLOR_EDITOR);
            return load64(g_br_editor);
        }
        if lp == load64(g_files_find_ed) {
            SetTextColor(wp, COLOR_DEFAULT); SetBkColor(wp, COLOR_EDITOR); return load64(g_br_editor);
        }
        if lp == load64(g_files_folder_ed) {
            SetTextColor(wp, COLOR_DEFAULT); SetBkColor(wp, COLOR_EDITOR); return load64(g_br_editor);
        }
        SetTextColor(wp, COLOR_TEXT);
        SetBkColor(wp, COLOR_PANEL);
        return load64(g_br_panel);
    }

    if msg == 312 {
        SetTextColor(wp, COLOR_TEXT);
        SetBkColor(wp, COLOR_PANEL);
        return load64(g_br_panel);
    }

    if msg == 15 {
        hdc = BeginPaint(hwnd, g_ps);
        GetClientRect(hwnd, g_rect);
        w = load32(g_rect + 8);
        h = load32(g_rect + 12);
        etop = 118; pbot = 110;
        if load64(g_find_visible) != 0 { etop = 152; pbot = 144; }
        if load64(g_calc_visible) != 0 { etop = 152; pbot = 144; }
        if load64(g_files_visible) != 0 { etop = 152; pbot = 144; }
        ebot = h - 54; out_top = ebot;
        if load64(g_output_visible) != 0 { out_top = ebot - 140; ebot = out_top - 10; }
        gdi_fill_xy(hdc, 0, 0, w, h, load64(g_br_bg));
        gdi_fill_xy(hdc, 0, 0, w, 38, load64(g_br_panel));
        gdi_line(hdc, 0, 38, w, 38, load64(g_pen_acc));
        gdi_text_out(hdc, 18, 8, title_app, COLOR_TEXT, load64(g_font_bold));
        gdi_text_out(hdc, 112, 11, title_sub, COLOR_DIM, load64(g_font_ui));
        gdi_fill_frame_rect(hdc, 12, 42, w - 16, pbot, load64(g_br_panel), load64(g_pen_line));
        gdi_fill_frame_rect(hdc, 12, etop - 6, w - 16, ebot + 6, load64(g_br_panel), load64(g_pen_line));
        if load64(g_output_visible) != 0 { gdi_fill_frame_rect(hdc, 12, out_top - 6, w - 16, out_top + 146, load64(g_br_panel), load64(g_pen_line)); }
        gdi_fill_frame_rect(hdc, 12, h - 42, w - 16, h - 6, load64(g_br_panel), load64(g_pen_line));
        editor_draw_line_numbers(hdc, load64(g_editor), g_gutter, g_pt, g_num, load64(g_font_code), load64(g_br_gutter), COLOR_DIM);
        pad_draw_bookmarks(hdc);
        if load64(g_compare_visible) != 0 {
            xsplit = load32(g_compare_gutter) - 5; gdi_line(hdc, xsplit, load32(g_compare_gutter + 4), xsplit, load32(g_compare_gutter + 12), load64(g_pen_line));
            editor_draw_line_numbers(hdc, load64(g_compare), g_compare_gutter, g_pt, g_num, load64(g_font_code), load64(g_br_gutter), COLOR_DIM);
        }
        EndPaint(hwnd, g_ps);
        return 0;
    }

    if msg == 16 {
        pad_tab_save_current(); dirty_count = 0; i = 0; while i < load64(g_tab_count) { if load64(g_tab_dirty + i * 8) != 0 { dirty_count = dirty_count + 1; } i = i + 1; }
        if dirty_count > 0 { if MessageBoxA(hwnd, exit_modified, exit_title, 0x34) != 6 { return 0; } }
        pad_session_save(); pad_recovery_clear(); DestroyWindow(hwnd); return 0;
    }
    if msg == 20 { return 1; }
    if msg == 2 { PostQuitMessage(0); return 0; }
    return DefWindowProcA(hwnd, msg, wp, lp);
}

func main() -> i32 {
    store64(g_encoding_mode, TEXT_ENC_UTF8); store64(g_eol_mode, TEXT_EOL_CRLF);
    pad_build_filter();
    pad_init_paths();
    pad_recent_load();
    store64(g_raw_p, alloc(1048576));
    store64(g_doc_p, alloc(1048576));
    store64(g_filebuf_p, alloc(PAD_FILE_CAP));
    store64(g_wide_p, alloc(PAD_FILE_CAP));
    store64(g_files_output_p, alloc(262144));
    if load64(g_raw_p) == 0 { return 1; }
    if load64(g_doc_p) == 0 { return 1; }
    if load64(g_filebuf_p) == 0 { return 1; }
    if load64(g_wide_p) == 0 { return 1; }
    if load64(g_files_output_p) == 0 { return 1; }
    store64(g_tab_current, 0 - 1); i = 0; while i < PAD_MAX_TABS { p = alloc(PAD_TAB_CAP); if p == 0 { return 1; } store64(g_tab_texts + i * 8, p); store8(p, 0); i = i + 1; }
    store64(g_bracket_a, 0 - 1); store64(g_bracket_b, 0 - 1);

    store64(g_br_bg, CreateSolidBrush(COLOR_BG));
    store64(g_br_panel, CreateSolidBrush(COLOR_PANEL));
    store64(g_br_editor, CreateSolidBrush(COLOR_EDITOR));
    store64(g_br_gutter, CreateSolidBrush(COLOR_PANEL));
    store64(g_br_button, CreateSolidBrush(COLOR_BUTTON));
    store64(g_br_hover, CreateSolidBrush(COLOR_HOVER));
    store64(g_br_accent, CreateSolidBrush(COLOR_ACCENT));
    store64(g_pen_line, CreatePen(0, 1, COLOR_LINE));
    store64(g_pen_acc, CreatePen(0, 2, COLOR_ACCENT));
    store64(g_font_ui, gdi_make_font(0 - 14, 400, face_ui));
    store64(g_font_bold, gdi_make_font(0 - 16, 700, face_ui));
    store64(g_font_code, gdi_make_font(0 - 16, 400, face_code));

    hinst = GetModuleHandleA(0);
    store64(g_hinst, hinst);
    cursor = LoadCursorA(0, 32512);
    gui_init_common_controls(1);
    gui_register_class(g_wc, cls_main, &MainWndProc, hinst, cursor, load64(g_br_bg));
    pad_build_menus();

    hwnd = CreateWindowExA(0, cls_main, title_app, 0x16CF0000, 120, 80, 1080, 760, 0, 0, hinst, 0);
    store64(g_hwnd, hwnd);
    if hwnd == 0 { return 1; }

    ShowWindow(hwnd, 1);
    UpdateWindow(hwnd);
    pad_message_loop();

    gdi_delete(load64(g_font_ui));
    gdi_delete(load64(g_font_bold));
    gdi_delete(load64(g_font_code));
    gdi_delete(load64(g_br_bg));
    gdi_delete(load64(g_br_panel));
    gdi_delete(load64(g_br_editor));
    gdi_delete(load64(g_br_gutter));
    gdi_delete(load64(g_br_button));
    gdi_delete(load64(g_br_hover));
    gdi_delete(load64(g_br_accent));
    gdi_delete(load64(g_pen_line));
    gdi_delete(load64(g_pen_acc));
    free(load64(g_raw_p));
    free(load64(g_doc_p));
    free(load64(g_filebuf_p));
    free(load64(g_wide_p));
    free(load64(g_files_output_p));
    i = 0; while i < PAD_MAX_TABS { free(load64(g_tab_texts + i * 8)); i = i + 1; }
    return 0;
}
