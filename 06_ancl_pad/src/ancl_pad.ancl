about_title: str = "About ANCL Pad";
about_text:  str = "ANCL Pad\r\n\r\nA native multi-language editor and ANCL build workspace.\r\n\r\nANCL and multi-language coloring, tabs, recovery, side-by-side comparison, encoding and line-ending conversion, line numbers, find/replace, bookmarks, starters, import helpers, value conversion, captured output, ANCL Compile/Run/Fix, synchronized core libraries, and an offline user guide.";
shortcuts_text: str = "Keyboard shortcuts\r\n\r\nF1 User Guide\r\nCtrl+N New\r\nCtrl+O Open\r\nCtrl+W Close document\r\nCtrl+Tab / Ctrl+Shift+Tab Next / previous tab\r\nCtrl+S Save\r\nCtrl+Shift+S Save As\r\nCtrl+Z Undo\r\nCtrl+Y Redo\r\nCtrl+X/C/V Cut Copy Paste\r\nCtrl+A Select All\r\nCtrl+F Find\r\nCtrl+Shift+F Find in Files\r\nF3 Find Next\r\nCtrl+H Replace\r\nCtrl+G Go To Line\r\nCtrl+F2 Toggle bookmark\r\nF2 / Shift+F2 Next / previous bookmark\r\nCtrl+Shift+K Value Converter\r\nCtrl+B Compile\r\nCtrl+Shift+B Fix\r\nF5 Compile and Run\r\nEsc Hide active bar";
bundle_title: str = "ANCL Pad Bundle Guide";
bundle_text: str = "Portable bundle layout\r\n\r\nancl_pad\\\r\n  bin\\ancl_pad.exe\r\n  bin\\guide.html\r\n  compiler\\anclc.exe\r\n  core_lib\\   current reusable ANCL libraries and starters\r\n  programs\\   compiled .exe and .asm files\r\n  sample.ancl\r\n  README.md\r\n\r\nShare the whole ancl_pad folder. Build > Compile/Run/Fix uses compiler\\anclc.exe and writes outputs to programs\\.\r\n\r\nPrograms in this folder can import bundled libraries with paths like:\r\n  import \"core_lib/cstring.ancl\";\r\n  import \"core_lib/gui_v2.ancl\";\r\n\r\nUse File > New From Starter for protocol templates and Edit > Insert Import for library imports. Build actions are enabled for .ancl files only; other languages are editor/highlighting modes.";
fix_title: str = "Apply ANCL Fixes?";
fix_q_a:   str = "Apply ";
fix_q_b:   str = " mechanical fix(es)?\r\n\r\nThe compiler report is in the output pane. Your original file will be kept as .bak.";
seed_src: str = "# ANCL Pad sample\r\n\r\n@DATA\r\nmsg: str = \"Hello from ANCL Pad\";\r\n\r\n@CODE\r\nfunc main() -> i32 {\r\n    syscall 1, msg, \"\\n\";\r\n    return 0;\r\n}\r\n";

