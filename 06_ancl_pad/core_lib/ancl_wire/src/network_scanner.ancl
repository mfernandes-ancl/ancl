# =====================================================================
#  network_scanner.ancl  -  Industrial Asset Discovery  (ANCL module)
#  Format: Bare-metal ANCL, ZERO-CRT, zero external dependencies.
#
#  Native, dependency-free asset discovery + vendor/host profiling:
#
#    1. MAC capture  -  the 48-bit physical address of every active host on
#       the local subnet.  PLATFORM REALITY: Windows Winsock raw sockets are
#       L3-only; hand-rolling raw Layer-2 ARP frames (EtherType 0x0806)
#       requires an out-of-band packet driver (Npcap/NDIS) which would break
#       the zero-dependency rule.  The native ANCL-only path is the OS ARP
#       resolver: GetIpNetTable returns the ARP cache - the MAC that came
#       back in each host's ARP reply - in MIB_IPNETROW.bPhysAddr.  That is
#       genuine captured ARP-reply data, just harvested via the OS instead
#       of a forbidden raw L2 socket.
#
#    2. OUI vendor lookup  -  matches the first 3 MAC bytes to a compact,
#       inline industrial-vendor matrix (trivially extensible).
#
#    3. Hostname scrape  -  active NetBIOS node-status (NBSTAT) query over a
#       CONNECTED UDP socket to host:137 (no bind, so it never collides with
#       the system NetBIOS/mDNS services that already own 137/5353), then
#       parses the reply for the device name.  nbns_extract_name() also works
#       on passively-captured port-137 payloads (feed it from the elevated
#       raw sniffer).  mDNS (5353) decode is a documented follow-up.
#
#  GetIpNetTable via core_lib/win32_api.ancl; socket/connect(extern)/send/
#  recv/ioctlsocket/htons/GetTickCount/Sleep are built-in.  WSAStartup is
#  the caller's responsibility (the dashboard / test does it once).
# =====================================================================
import "../../win32_api.ancl";          # GetIpNetTable
extern "ws2_32.dll" connect;            # connected-UDP NBSTAT (not in the built-in table)
extern "ws2_32.dll" sendto;             # unconnected UDP multicast send (mDNS query)
extern "ws2_32.dll" recvfrom;           # unconnected UDP recv + source addr (mDNS reply)
extern "ws2_32.dll" setsockopt;         # SO_REUSEADDR + IP_ADD_MEMBERSHIP (passive mDNS listener)

@DATA
# ---- asset table (up to 64 hosts) ----
ns_count:   buf = 8;
ns_ip:      buf = 512;     # i64[64] host-order IPv4
ns_mac:     buf = 512;     # i64[64] - 6 MAC bytes packed per slot
ns_vendor:  buf = 512;     # i64[64] -> vendor string pointer

# ---- scratch / Winsock ----
ns_arptab:     buf = 65536;  # MIB_IPNETTABLE
ns_arptab_len: buf = 8;
ns_sa:    buf = 16;          # sockaddr_in
ns_q:     buf = 64;          # NBSTAT query
ns_r:     buf = 512;         # NBSTAT reply
ns_one:   buf = 8;           # FIONBIO flag

# ---- mDNS (Phase 6.8) ----
s_inaddr: str = "in-addr";
s_arpa:   str = "arpa";
md_q:      buf = 128;        # mDNS query packet
md_r:      buf = 512;        # mDNS response packet
md_from:   buf = 16;         # recvfrom source sockaddr_in
md_fromlen:buf = 8;
md_bind:   buf = 16;         # ephemeral bind sockaddr (0.0.0.0:0)
md_dst:    buf = 16;         # 224.0.0.251:5353
md_one:    buf = 8;          # FIONBIO / SO_REUSEADDR flag
md_oct:    buf = 16;         # int_to_str scratch for octet labels
md_mreq:   buf = 8;          # ip_mreq { imr_multiaddr; imr_interface } for group join

# ---- vendor strings (OUI matrix; extend the if-chain in oui_lookup) ----
v_omron:   str = "Omron";
v_phoenix: str = "Phoenix Contact";
v_moxa:    str = "Moxa";
v_unknown: str = "Unknown";
# curated common NIC + industrial OUIs (not exhaustive - the full IEEE list is huge)
v_realtek: str = "Realtek";
v_intel:   str = "Intel";
v_vmware:  str = "VMware";
v_msft:    str = "Microsoft";
v_rpi:     str = "Raspberry Pi";
v_cisco:   str = "Cisco";
v_siemens: str = "Siemens";
v_rockwell:str = "Rockwell/AB";
v_schneid: str = "Schneider";
v_beckh:   str = "Beckhoff";
v_wago:    str = "WAGO";
v_hirsch:  str = "Hirschmann";
v_wd:      str = "Western Digital";
v_dell:    str = "Dell";
v_apple:   str = "Apple";
v_tplink:  str = "TP-Link";

@CODE
func ns_hexnib(v: i64) -> i64 { if v < 10 { return 48 + v; } return 55 + v; }

# 4 big-endian bytes at p -> host-order int (MIB dwAddr is network byte order)
func ns_hdr_ip(p: i64) -> i64 {
    return shl(load8(p), 24) + shl(load8(p + 1), 16) + shl(load8(p + 2), 8) + load8(p + 3);
}
# big-endian 16-bit read
func ns_be16(p: i64) -> i64 { return shl(load8(p), 8) + load8(p + 1); }

# host-order IPv4 -> network-order DWORD (for sockaddr_in.sin_addr)
func ns_host_to_net(host: i64) -> i64 {
    return band(shr(host, 24), 255) + shl(band(shr(host, 16), 255), 8)
         + shl(band(shr(host, 8), 255), 16) + shl(band(host, 255), 24);
}

# ---- OUI -> vendor.  mac = ptr to >=3 bytes.  Compact inline matrix. ----
func oui_lookup(mac: i64) -> i64 {
    oui = shl(load8(mac), 16) + shl(load8(mac + 1), 8) + load8(mac + 2);
    if oui == 0x003011 { return v_omron; }      # Omron
    if oui == 0x00A045 { return v_phoenix; }    # Phoenix Contact
    if oui == 0x00E04B { return v_moxa; }       # Moxa
    if oui == 0x00E04C { return v_realtek; }    # Realtek
    if oui == 0x001B21 { return v_intel; }      # Intel
    if oui == 0x000C29 { return v_vmware; }     # VMware
    if oui == 0x005056 { return v_vmware; }     # VMware
    if oui == 0x00155D { return v_msft; }       # Microsoft (Hyper-V)
    if oui == 0xB827EB { return v_rpi; }        # Raspberry Pi
    if oui == 0xDCA632 { return v_rpi; }        # Raspberry Pi
    if oui == 0xE45F01 { return v_rpi; }        # Raspberry Pi
    if oui == 0x00000C { return v_cisco; }      # Cisco
    if oui == 0x000E8C { return v_siemens; }    # Siemens
    if oui == 0x080006 { return v_siemens; }    # Siemens
    if oui == 0x0000BC { return v_rockwell; }   # Rockwell / Allen-Bradley
    if oui == 0x001D9C { return v_rockwell; }   # Rockwell / Allen-Bradley
    if oui == 0x000054 { return v_schneid; }    # Schneider
    if oui == 0x000105 { return v_beckh; }      # Beckhoff
    if oui == 0x0030DE { return v_wago; }       # WAGO
    if oui == 0x008063 { return v_hirsch; }     # Hirschmann
    if oui == 0x0000C0 { return v_wd; }         # Western Digital
    if oui == 0xB82A72 { return v_dell; }       # Dell
    if oui == 0x3C0754 { return v_apple; }      # Apple
    if oui == 0xF01898 { return v_apple; }      # Apple
    if oui == 0x50C7BF { return v_tplink; }     # TP-Link
    return v_unknown;                            # <- add more OUIs here (first 3 MAC bytes)
}

# format 6 MAC bytes at `mac` -> "AA:BB:CC:DD:EE:FF" at dst; return dst
func mac_to_str(mac: i64, dst: i64) -> i64 {
    w = dst; i = 0;
    while i < 6 {
        if i > 0 { store8(w, 58); w = w + 1; }          # ':'
        b = load8(mac + i);
        store8(w, ns_hexnib(band(shr(b, 4), 15))); w = w + 1;
        store8(w, ns_hexnib(band(b, 15)));          w = w + 1;
        i = i + 1;
    }
    store8(w, 0);
    return dst;
}

# register one host (dedup by IP); macptr -> 6 bytes.  1 added / 0 skipped.
func ns_add(host: i64, macptr: i64) -> i64 {
    c = load64(ns_count);
    i = 0;
    while i < c { if load64(ns_ip + i * 8) == host { return 0; } i = i + 1; }
    if c >= 64 { return 0; }
    store64(ns_ip + c * 8, host);
    memcpy(ns_mac + c * 8, macptr, 6);
    store64(ns_vendor + c * 8, oui_lookup(macptr));
    store64(ns_count, c + 1);
    return 1;
}

# ---------------------------------------------------------------------
# scan_assets: harvest IP + 48-bit MAC for every dynamic/static neighbor on
# the local subnet from the OS ARP cache (GetIpNetTable).  Returns the count.
# MIB_IPNETTABLE: u32 numEntries @0, then MIB_IPNETROW[stride 24] @4 with
#   dwPhysAddrLen @+4, bPhysAddr[8] @+8, dwAddr @+16, dwType @+20.
# ---------------------------------------------------------------------
func scan_assets(local_ip: i64, mask: i64) -> i64 {
    store64(ns_count, 0);
    store32(ns_arptab_len, 65536);
    if GetIpNetTable(ns_arptab, ns_arptab_len, 0) != 0 { return 0; }   # NO_ERROR=0
    cnt = load32(ns_arptab);
    if mask == 0 { mask = 0xFFFFFF00; }
    net = band(local_ip, mask);
    i = 0;
    while i < cnt {
        row = ns_arptab + 4 + i * 24;
        if load32(row + 20) >= 3 {                  # 3 dynamic / 4 static
            if load32(row + 4) == 6 {               # only rows carrying a real 6-byte MAC
                host = ns_hdr_ip(row + 16);
                if band(host, mask) == net {        # local subnet only
                    lo = band(host, 255);
                    if lo != 0 { if lo != 255 { ns_add(host, row + 8); } }
                }
            }
        }
        i = i + 1;
    }
    return load64(ns_count);
}

# ---- asset-table getters (for the dashboard / tests) ----
func ns_get_count() -> i64 { return load64(ns_count); }
func ns_get_ip(i: i64) -> i64 { return load64(ns_ip + i * 8); }
func ns_get_mac(i: i64) -> i64 { return ns_mac + i * 8; }       # -> 6 bytes
func ns_get_vendor(i: i64) -> i64 { return load64(ns_vendor + i * 8); }

# ---------------------------------------------------------------------
# NetBIOS Name Service node-status (NBSTAT) - active hostname discovery.
# ---------------------------------------------------------------------
# Build the 50-byte NBSTAT query for the wildcard "*" name.
func build_nbstat_query(b: i64) -> i64 {
    memset(b, 0, 50);
    store8(b + 5, 1);          # questions = 1
    store8(b + 12, 0x20);      # name length 32 (first-level encoded)
    store8(b + 13, 67);        # '*' (0x2A) -> hi nibble 2 -> 'A'+2 = 'C'
    store8(b + 14, 75);        #              lo nibble A -> 'A'+10 = 'K'
    i = 15;
    while i < 45 { store8(b + i, 65); i = i + 1; }   # 15 NUL bytes -> 'A','A' each (30 bytes)
    # b+45 = 0x00 name terminator (already zeroed)
    store8(b + 47, 0x21);      # QTYPE = NBSTAT
    store8(b + 49, 1);         # QCLASS = IN
    return 50;
}

# skip a NBNS/DNS name at offset off -> offset just past it (handles a
# compression pointer or a length-prefixed label list)
func ns_skip_name(p: i64, off: i64, n: i64) -> i64 {
    if off >= n { return n; }
    if band(load8(p + off), 0xC0) == 0xC0 { return off + 2; }   # pointer
    while off < n {
        l = load8(p + off);
        if l == 0 { return off + 1; }
        off = off + l + 1;
    }
    return off;
}

# Parse a NBNS node-status reply (or a captured port-137 payload).  Extracts
# the first unique Workstation name (suffix 0x00, group bit clear), trims
# trailing spaces into dst.  Returns 1 on success, else 0.
func nbns_extract_name(p: i64, n: i64, dst: i64) -> i64 {
    store8(dst, 0);
    if n < 12 { return 0; }
    off = 12;                                   # skip the 12-byte header
    if ns_be16(p + 4) >= 1 {                     # question count -> skip echoed question
        off = ns_skip_name(p, off, n);
        off = off + 4;                           # qtype + qclass
    }
    off = ns_skip_name(p, off, n);               # answer name
    off = off + 10;                              # type(2)+class(2)+ttl(4)+rdlength(2)
    if off >= n { return 0; }
    num = load8(p + off); off = off + 1;         # number of names
    k = 0;
    while k < num {
        if off + 18 > n { return 0; }
        if load8(p + off + 15) == 0 {            # suffix 0x00 = Workstation/Redirector
            if band(ns_be16(p + off + 16), 0x8000) == 0 {   # group bit clear = unique name
                e = 15;
                while e > 0 { if load8(p + off + e - 1) == 32 { e = e - 1; } else { break; } }
                memcpy(dst, p + off, e);
                store8(dst + e, 0);
                return 1;
            }
        }
        off = off + 18;
        k = k + 1;
    }
    return 0;
}

# Active NBSTAT query to `host` (host-order IPv4).  Writes the device name
# into dst (caller-sized).  Returns 1 if a name was resolved, else 0.
# Requires WSAStartup to have been called by the host program.
func nbstat_query(host: i64, dst: i64) -> i64 {
    store8(dst, 0);
    s = socket(2, 2, 17);                        # AF_INET, SOCK_DGRAM, UDP
    if s == 0 - 1 { return 0; }
    store16(ns_sa + 0, 2);
    store16(ns_sa + 2, htons(137));
    store32(ns_sa + 4, ns_host_to_net(host));
    store64(ns_sa + 8, 0);
    if connect(s, ns_sa, 16) != 0 { closesocket(s); return 0; }
    qlen = build_nbstat_query(ns_q);
    send(s, ns_q, qlen, 0);
    store32(ns_one, 1);
    ioctlsocket(s, 2147772030, ns_one);          # FIONBIO (non-blocking)
    t0 = GetTickCount();
    got = 0;
    while got == 0 {
        rn = recv(s, ns_r, 512, 0);
        if rn > 0 { got = nbns_extract_name(ns_r, rn, dst); }
        if got == 1 { break; }
        if GetTickCount() - t0 > 600 { break; }   # ~600 ms timeout
        Sleep(5);
    }
    closesocket(s);
    return got;
}

# =====================================================================
#  Active mDNS (multicast DNS) hostname resolution  (Phase 6.8).
#  Fires a reverse-PTR query (d.c.b.a.in-addr.arpa, type PTR) at the mDNS
#  group 224.0.0.251:5353 from an EPHEMERAL UDP socket with the QU
#  (unicast-response) bit set, so the target replies straight to our port -
#  no bind to the system-reserved 5353.  Zero-dep: sendto/recvfrom extern.
# =====================================================================
# write a length-prefixed DNS label (decimal of v) at b+w; return new w
func dns_put_octet(b: i64, w: i64, v: i64) -> i64 {
    int_to_str(md_oct, v);
    l = strlen(md_oct);
    store8(b + w, l); w = w + 1;
    memcpy(b + w, md_oct, l);
    return w + l;
}
# write a length-prefixed DNS label (C-string s) at b+w; return new w
func dns_put_label(b: i64, w: i64, s: i64) -> i64 {
    l = strlen(s);
    store8(b + w, l); w = w + 1;
    memcpy(b + w, s, l);
    return w + l;
}

# Build a reverse-PTR mDNS query for target_ip (host-order) into b -> length.
func build_mdns_ptr_query(b: i64, target_ip: i64) -> i64 {
    memset(b, 0, 128);
    store8(b + 5, 1);                                      # QDCOUNT = 1
    w = 12;
    w = dns_put_octet(b, w, band(target_ip, 255));         # d
    w = dns_put_octet(b, w, band(shr(target_ip, 8), 255)); # c
    w = dns_put_octet(b, w, band(shr(target_ip, 16), 255));# b
    w = dns_put_octet(b, w, band(shr(target_ip, 24), 255));# a
    w = dns_put_label(b, w, s_inaddr);                     # "in-addr"
    w = dns_put_label(b, w, s_arpa);                       # "arpa"
    store8(b + w, 0); w = w + 1;                           # root terminator
    store8(b + w, 0); store8(b + w + 1, 12); w = w + 2;    # QTYPE = PTR (0x000C)
    store8(b + w, 0x80); store8(b + w + 1, 0x01); w = w + 2;# QCLASS = IN | QU (0x8001, unicast response)
    return w;
}

# Create an ephemeral UDP socket and fire the mDNS PTR query at 224.0.0.251:5353.
# Returns the (non-blocking) socket, or -1 on failure.
func send_mdns_query(target_ip: i64) -> i64 {
    s = socket(2, 2, 17);                                  # AF_INET, SOCK_DGRAM, UDP
    if s == 0 - 1 { return 0 - 1; }
    store16(md_bind + 0, 2); store16(md_bind + 2, 0);      # bind 0.0.0.0:0 -> OS-assigned ephemeral port
    store32(md_bind + 4, 0); store64(md_bind + 8, 0);
    if bind(s, md_bind, 16) != 0 { closesocket(s); return 0 - 1; }
    store16(md_dst + 0, 2); store16(md_dst + 2, htons(5353));
    store32(md_dst + 4, ns_host_to_net(0xE00000FB));       # 224.0.0.251
    store64(md_dst + 8, 0);
    qlen = build_mdns_ptr_query(md_q, target_ip);
    sendto(s, md_q, qlen, 0, md_dst, 16);
    store32(md_one, 1);
    ioctlsocket(s, 2147772030, md_one);                    # FIONBIO
    return s;
}

# Follow DNS labels / 0xC0 compression pointers at off; write the dotted name
# into dst (cap-bounded).  Returns 1 if any label was read.
func dns_read_name(p: i64, n: i64, off: i64, dst: i64, cap: i64) -> i64 {
    w = 0; first = 1; hops = 0;
    while hops < 64 {
        if off >= n { break; }
        l = load8(p + off);
        if l == 0 { break; }
        if band(l, 0xC0) == 0xC0 {
            if off + 1 >= n { break; }
            off = band(shl(l, 8) + load8(p + off + 1), 0x3FFF);   # 14-bit pointer
            hops = hops + 1;
        } else {
            off = off + 1;
            if first == 0 { if w < cap - 1 { store8(dst + w, 46); w = w + 1; } }
            first = 0;
            k = 0;
            while k < l {
                if off < n { if w < cap - 1 { store8(dst + w, load8(p + off)); w = w + 1; } off = off + 1; }
                k = k + 1;
            }
        }
    }
    store8(dst + w, 0);
    if w > 0 { return 1; }
    return 0;
}

# skip a DNS name -> offset just past it.  A compression pointer can appear at
# the START or AFTER any run of labels (e.g. "www" + ptr), so the pointer test
# must run at EVERY position, not just the first byte.
func dns_skip_name(p: i64, off: i64, n: i64) -> i64 {
    while off < n {
        l = load8(p + off);
        if l == 0 { return off + 1; }
        if band(l, 0xC0) == 0xC0 { return off + 2; }   # compression pointer ends the name
        off = off + l + 1;
    }
    return off;
}

# cut a C-string at its first '.' (keep the leftmost label = bare hostname)
func cut_at_dot(s: i64) -> i64 {
    i = 0;
    while load8(s + i) != 0 { if load8(s + i) == 46 { store8(s + i, 0); return 0; } i = i + 1; }
    return 0;
}

# Parse a DNS/mDNS response; first PTR answer -> bare hostname into dst.  1/0.
func mdns_extract_hostname(p: i64, n: i64, dst: i64) -> i64 {
    store8(dst, 0);
    if n < 12 { return 0; }
    an = ns_be16(p + 6);
    if an < 1 { return 0; }
    off = 12;
    qd = ns_be16(p + 4);
    i = 0;
    while i < qd { off = dns_skip_name(p, off, n); off = off + 4; i = i + 1; }
    a = 0;
    while a < an {
        off = dns_skip_name(p, off, n);                    # answer NAME
        if off + 10 > n { return 0; }
        typ = ns_be16(p + off);
        rdlen = ns_be16(p + off + 8);
        off = off + 10;                                    # type+class+ttl+rdlength
        if typ == 12 {                                     # PTR -> RDATA is the host's domain name
            if dns_read_name(p, n, off, dst, 64) == 1 { cut_at_dot(dst); return 1; }
        }
        off = off + rdlen;
        a = a + 1;
    }
    return 0;
}

# Active mDNS resolve of target_ip (host-order) -> bare hostname in dst.  1/0.
# Requires WSAStartup.  Accepts only the unicast reply from the target itself.
func mdns_query(target_ip: i64, dst: i64) -> i64 {
    store8(dst, 0);
    s = send_mdns_query(target_ip);
    if s == 0 - 1 { return 0; }
    t0 = GetTickCount();
    got = 0;
    while got == 0 {
        store32(md_fromlen, 16);
        rn = recvfrom(s, md_r, 512, 0, md_from, md_fromlen);
        if rn > 0 {
            if ns_hdr_ip(md_from + 4) == target_ip {       # sin_addr@+4: only the target's own answer
                if mdns_extract_hostname(md_r, rn, dst) == 1 { got = 1; }
            }
        }
        if got == 1 { break; }
        if GetTickCount() - t0 > 400 { break; }            # ~400 ms timeout
        Sleep(5);
    }
    closesocket(s);
    return got;
}

# =====================================================================
#  Passive mDNS announcement listener  (Phase 6.8b).
#  Devices broadcast their A records (hostname.local -> IP) to the mDNS
#  group on startup and periodically.  We SHARE port 5353 via SO_REUSEADDR
#  (coexisting with the OS mDNS service - that is how mDNS is designed) and
#  JOIN 224.0.0.251, so we passively harvest those announcements over time -
#  reliable, no dependence on devices honouring reverse-PTR/QU queries.
# =====================================================================
# Open the shared, group-joined, non-blocking mDNS listen socket. -1 on fail.
func mdns_listen_open() -> i64 {
    s = socket(2, 2, 17);                                  # AF_INET, SOCK_DGRAM, UDP
    if s == 0 - 1 { return 0 - 1; }
    store32(md_one, 1);
    setsockopt(s, 0xFFFF, 0x0004, md_one, 4);              # SOL_SOCKET / SO_REUSEADDR (share :5353)
    store16(md_bind + 0, 2); store16(md_bind + 2, htons(5353));
    store32(md_bind + 4, 0); store64(md_bind + 8, 0);      # bind 0.0.0.0:5353
    if bind(s, md_bind, 16) != 0 { closesocket(s); return 0 - 1; }
    store32(md_mreq + 0, ns_host_to_net(0xE00000FB));      # imr_multiaddr = 224.0.0.251 (net order)
    store32(md_mreq + 4, 0);                               # imr_interface = default
    setsockopt(s, 0, 12, md_mreq, 8);                      # IPPROTO_IP / IP_ADD_MEMBERSHIP
    store32(md_one, 1);
    ioctlsocket(s, 2147772030, md_one);                   # FIONBIO (non-blocking)
    return s;
}

# Non-blocking solicit: multicast a reverse-PTR query for target_ip out of the
# (already group-joined) listen socket.  Replies - unicast OR multicast - land
# back on that same socket, where the pump harvests them.  No wait here.
func mdns_solicit(sock: i64, target_ip: i64) -> i64 {
    store16(md_dst + 0, 2); store16(md_dst + 2, htons(5353));
    store32(md_dst + 4, ns_host_to_net(0xE00000FB)); store64(md_dst + 8, 0);
    ql = build_mdns_ptr_query(md_q, target_ip);
    sendto(sock, md_q, ql, 0, md_dst, 16);
    return 0;
}

# Walk a DNS/mDNS message's answer+authority+additional RRs; return the
# idx-th A record (type 1, rdlen 4): bare hostname -> out_name, host-order
# IPv4 -> *out_ip.  Returns 1 if that record exists, else 0.
func mdns_extract_a(p: i64, n: i64, idx: i64, out_ip: i64, out_name: i64) -> i64 {
    store8(out_name, 0);
    if n < 12 { return 0; }
    total = ns_be16(p + 6) + ns_be16(p + 8) + ns_be16(p + 10);   # ancount + nscount + arcount
    off = 12;
    qd = ns_be16(p + 4);
    i = 0;
    while i < qd { off = dns_skip_name(p, off, n); off = off + 4; i = i + 1; }
    found = 0;
    r = 0;
    while r < total {
        nameoff = off;                                     # the RR's owner name (= the hostname)
        off = dns_skip_name(p, off, n);
        if off + 10 > n { return 0; }
        typ = ns_be16(p + off);
        rdlen = ns_be16(p + off + 8);
        rdata = off + 10;
        if typ == 1 {                                      # A record
            if rdlen == 4 {
                if rdata + 4 <= n {
                    if found == idx {
                        dns_read_name(p, n, nameoff, out_name, 64);
                        cut_at_dot(out_name);              # "host.local" -> "host"
                        store64(out_ip, ns_hdr_ip(p + rdata));
                        return 1;
                    }
                    found = found + 1;
                }
            }
        }
        off = rdata + rdlen;
        r = r + 1;
    }
    return 0;
}
