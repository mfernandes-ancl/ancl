import "../core_lib/text_encoding.ancl";

@DATA
raw:  buf = 256;
utf8: buf = 256;
norm: buf = 256;
out:  buf = 512;
wide: buf = 512;

@CODE
func require(ok: i64) -> i64 { if ok == 0 { return 0 - 1; } return 0; }

func main() -> i32 {
    store8(raw, 0xEF); store8(raw + 1, 0xBB); store8(raw + 2, 0xBF);
    store8(raw + 3, 0x41); store8(raw + 4, 10); store8(raw + 5, 0xC3); store8(raw + 6, 0xA9); store8(raw + 7, 0);
    if require(text_detect_encoding(raw, 7) == TEXT_ENC_UTF8_BOM) < 0 { return 1; }
    n = text_decode_to_utf8(raw, 7, TEXT_ENC_UTF8_BOM, utf8, 256, wide, 256);
    if require(n == 4) < 0 { return 2; }
    if require(load8(utf8 + 2) == 0xC3) < 0 { return 3; }
    if require(text_detect_eol(utf8) == TEXT_EOL_LF) < 0 { return 4; }

    n = text_normalize_eol(utf8, norm, 256, TEXT_EOL_CRLF);
    if require(n == 5) < 0 { return 5; }
    if require(load8(norm + 1) == 13) < 0 { return 6; }
    if require(load8(norm + 2) == 10) < 0 { return 7; }

    n = text_encode_from_utf8(norm, 5, TEXT_ENC_UTF16_LE, out, 512, wide, 256);
    if require(n == 10) < 0 { return 8; }
    if require(load8(out) == 0xFF) < 0 { return 9; }
    if require(load8(out + 1) == 0xFE) < 0 { return 10; }
    if require(text_detect_encoding(out, n) == TEXT_ENC_UTF16_LE) < 0 { return 11; }

    memset(utf8, 0, 256);
    n = text_decode_to_utf8(out, n, TEXT_ENC_UTF16_LE, utf8, 256, wide, 256);
    if require(n == 5) < 0 { return 12; }
    if require(load8(utf8 + 3) == 0xC3) < 0 { return 13; }

    n = text_encode_from_utf8(utf8, n, TEXT_ENC_UTF8_BOM, out, 512, wide, 256);
    if require(n == 8) < 0 { return 14; }
    if require(load8(out + 2) == 0xBF) < 0 { return 15; }
    return 0;
}
