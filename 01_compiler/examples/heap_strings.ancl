struct Node { value: i64; next: ptr; }

@DATA
mHead: str = "list: ";
mLen:  str = "length=";
mSum:  str = "sum=";
mStr:  str = "strlen(src)=";
mCmp:  str = "strcmp(src,src)=";
src:   str = "Hello, ANCL!";
buf1:  buf = 64;
buf2:  buf = 64;
sp:    str = " ";
nl:    str = "\n";

@CODE
func main() -> i32 {
    # build a heap linked list, pushing 1..5 on the front
    head = 0;
    i = 1;
    while i <= 5 {
        n = alloc(sizeof(Node));
        store64(n + Node.value, i);
        store64(n + Node.next, head);
        head = n;
        i = i + 1;
    }
    # traverse
    syscall 1, mHead;
    p = head;
    len = 0;
    sum = 0;
    while p != 0 {
        v = load64(p + Node.value);
        syscall 1, v, sp;
        sum = sum + v;
        len = len + 1;
        p = load64(p + Node.next);
    }
    syscall 1, nl;
    syscall 1, mLen, len, nl;          # 5
    syscall 1, mSum, sum, nl;          # 15
    # free it
    p = head;
    while p != 0 {
        nx = load64(p + Node.next);
        free(p);
        p = nx;
    }
    # string/mem helpers
    syscall 1, mStr, strlen(src), nl;  # 12
    syscall 1, mCmp, strcmp(src, src), nl;  # 0
    memset(buf1, 65, 5); store8(buf1 + 5, 0);   # "AAAAA"
    n2 = strlen(src); memcpy(buf2, src, n2); store8(buf2 + n2, 0);
    puts_cstr(buf2); syscall 1, nl;    # Hello, ANCL!
    puts_cstr(buf1); syscall 1, nl;    # AAAAA
    return 0;
}
