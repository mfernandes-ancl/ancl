# =====================================================================
#  anclc2_all_linux.ancl  -  GENERATED by gen_all_linux.ps1 (do not hand-edit)
#  LINUX build of the self-hosted compiler: core_lib (std + liblinux SHIMS)
#  is INLINED. Compile with:  bin\anclc.exe <this> anclc_linux --target=linux
#  Concatenation of: std.ancl, liblinux.ancl, lexer.ancl, parser.ancl, emit.ancl, codegen.ancl, pe_writer.ancl, elf_writer.ancl, main.ancl
# =====================================================================

# ===================== BEGIN std.ancl =====================
# --------------------------------------------------------------------
#  std.ancl  -  a minimal ANCL standard-library module
#  (imported via:  import "../lib/std.ancl";)
# --------------------------------------------------------------------

struct Pair { a: i64; b: i64; }

func imax(x: i64, y: i64) -> i64 {
    if x >= y { return x; }
    return y;
}

func imin(x: i64, y: i64) -> i64 {
    if x <= y { return x; }
    return y;
}

func iabs(x: i64) -> i64 {
    if x < 0 { return 0 - x; }
    return x;
}

func clamp(x: i64, lo: i64, hi: i64) -> i64 {
    return imax(lo, imin(x, hi));     # calls other module functions
}

func ipow(base: i64, exp: i64) -> i64 {
    r = 1;
    i = 0;
    while i < exp {
        r = r * base;
        i = i + 1;
    }
    return r;
}
# ===================== END std.ancl =====================

# ===================== BEGIN liblinux.ancl =====================
# =====================================================================
#  liblinux.ancl  -  pure-ANCL Linux syscall wrappers  (core_lib)  [thread C / M3]
#
#  Friendly names over the raw `syscall(nr, a0..a5)` primitive so a Linux
#  file-I/O program reads naturally instead of dialing syscall numbers by hand.
#
#  LINUX TARGET ONLY: every wrapper uses `syscall(...)`, which the compiler
#  accepts only under `--target=linux` (a Windows/PE build errors out). No
#  `extern`, no imports -> the ELF stays CRT-free and import-free.
#  Use it from a Linux program:   import "../core_lib/liblinux.ancl";
#
#  Convention: each wrapper returns the raw kernel result -- a non-negative
#  value on success, or a negative -errno on failure -> test with `if r < 0`.
#  x86-64 syscall numbers:  read 0  write 1  open 2  close 3  lseek 8
#                           fsync 74  unlink 87  exit_group 231
# =====================================================================

@DATA
# ---- open() flags (x86-64 Linux, asm-generic) ----
O_RDONLY:    i64 = 0;
O_WRONLY:    i64 = 1;
O_RDWR:      i64 = 2;
O_CREAT:     i64 = 0x40;     # 64
O_EXCL:      i64 = 0x80;     # 128
O_TRUNC:     i64 = 0x200;    # 512
O_APPEND:    i64 = 0x400;    # 1024
# ---- lseek() whence ----
SEEK_SET:    i64 = 0;
SEEK_CUR:    i64 = 1;
SEEK_END:    i64 = 2;
# ---- standard file descriptors ----
LX_STDIN:    i64 = 0;
LX_STDOUT:   i64 = 1;
LX_STDERR:   i64 = 2;
# ---- a sane default create mode: 0644 (rw-r--r--) ----
LX_MODE_644: i64 = 420;
# ---- mmap() prot + flags ----
PROT_READ:     i64 = 1;
PROT_WRITE:    i64 = 2;
PROT_EXEC:     i64 = 4;
MAP_SHARED:    i64 = 1;
MAP_PRIVATE:   i64 = 2;
MAP_ANONYMOUS: i64 = 0x20;   # 32
# ---- Win-name shim scratch (M4) ----
g_lx_cmdline:  buf = 4096;    # GetCommandLineA: reflattened, space-joined argv
g_lx_copybuf:  buf = 4096;    # CopyFileA: copy chunk (looped)

@CODE
# ---- raw file primitives (return >=0 on success, <0 = -errno) ----
func lx_read(fd: i64, buf: i64, n: i64) -> i64  { return syscall(0, fd, buf, n); }
func lx_write(fd: i64, buf: i64, n: i64) -> i64 { return syscall(1, fd, buf, n); }
func lx_open(path: i64, flags: i64, mode: i64) -> i64 { return syscall(2, path, flags, mode); }
func lx_close(fd: i64) -> i64 { return syscall(3, fd); }
func lx_lseek(fd: i64, off: i64, whence: i64) -> i64 { return syscall(8, fd, off, whence); }
func lx_fsync(fd: i64) -> i64 { return syscall(74, fd); }
func lx_unlink(path: i64) -> i64 { return syscall(87, path); }

# ---- mmap()/munmap() : raw memory mapping. For a plain zeroed heap block prefer
#      alloc()/free() (the compiler builtins, also mmap-backed); use these to map a
#      FILE into memory (MAP_SHARED + fd) or for explicit control. Returns the address
#      (<0 = -errno). e.g. lx_mmap(0, len, PROT_READ, MAP_PRIVATE, fd, 0).
func lx_mmap(addr: i64, len: i64, prot: i64, flags: i64, fd: i64, off: i64) -> i64 {
    return syscall(9, addr, len, prot, flags, fd, off);
}
func lx_munmap(addr: i64, len: i64) -> i64 { return syscall(11, addr, len); }

# ---- exit: never returns (exit_group terminates the whole process) ----
func lx_exit(code: i64) -> i64 { syscall(231, code); return 0; }

# ---- convenience: intent-named opens (hide the O_* flag arithmetic) ----
func lx_create(path: i64) -> i64 {            # create/truncate for writing, 0644
    return lx_open(path, O_WRONLY | O_CREAT | O_TRUNC, LX_MODE_644);
}
func lx_open_read(path: i64) -> i64 {         # open an existing file for reading
    return lx_open(path, O_RDONLY, 0);
}
func lx_open_append(path: i64) -> i64 {       # open/create for appending, 0644
    return lx_open(path, O_WRONLY | O_CREAT | O_APPEND, LX_MODE_644);
}

# ---- convenience: string + stdio helpers (write a NUL-terminated string) ----
func lx_write_str(fd: i64, s: i64) -> i64 { return lx_write(fd, s, strlen(s)); }
func lx_print(s: i64) -> i64  { return lx_write(LX_STDOUT, s, strlen(s)); }   # -> stdout
func lx_eprint(s: i64) -> i64 { return lx_write(LX_STDERR, s, strlen(s)); }   # -> stderr

# =====================================================================
#  WINDOWS-NAME SHIMS (M4): translate the kernel32 file/cmdline API to Linux
#  syscalls. A Windows ANCL program's file code ports by importing THIS file
#  instead of core_lib/win32_api.ancl -- under --target=linux the compiler
#  resolves these funcs over the same-named builtin imports (isImport precedence).
#  Win32 conventions reproduced: BOOL = 1 success / 0 fail; HANDLE = the fd;
#  CreateFileA returns INVALID_HANDLE_VALUE (0-1) on failure.
# =====================================================================

# CreateFileA(name, access, share, sa, disposition, flags, template) -> HANDLE(fd) | -1
func CreateFileA(name: i64, access: i64, share: i64, sa: i64, disp: i64, flags: i64, tmpl: i64) -> i64 {
    rd = band(access, 0x80000000);   # GENERIC_READ
    wr = band(access, 0x40000000);   # GENERIC_WRITE
    of = O_RDONLY;
    if wr != 0 { of = O_WRONLY; }
    if rd != 0 { if wr != 0 { of = O_RDWR; } }
    if disp == 2 { of = bor(of, bor(O_CREAT, O_TRUNC)); }   # CREATE_ALWAYS
    if disp == 4 { of = bor(of, O_CREAT); }                 # OPEN_ALWAYS
    if disp == 1 { of = bor(of, bor(O_CREAT, O_EXCL)); }    # CREATE_NEW
    if disp == 5 { of = bor(of, O_TRUNC); }                 # TRUNCATE_EXISTING
    md = 0;
    if band(of, O_CREAT) != 0 { md = LX_MODE_644; }
    r = lx_open(name, of, md);
    if r < 0 { return 0 - 1; }        # INVALID_HANDLE_VALUE
    return r;
}

# ReadFile(handle, buf, nToRead, &bytesRead, overlapped) -> BOOL
func ReadFile(h: i64, buf: i64, n: i64, pGot: i64, ovl: i64) -> i64 {
    r = lx_read(h, buf, n);
    if r < 0 { if pGot != 0 { store64(pGot, 0); } return 0; }
    if pGot != 0 { store64(pGot, r); }
    return 1;
}

# WriteFile(handle, buf, nToWrite, &bytesWritten, overlapped) -> BOOL
func WriteFile(h: i64, buf: i64, n: i64, pPut: i64, ovl: i64) -> i64 {
    r = lx_write(h, buf, n);
    if r < 0 { if pPut != 0 { store64(pPut, 0); } return 0; }
    if pPut != 0 { store64(pPut, r); }
    return 1;
}

# CloseHandle(handle) -> BOOL
func CloseHandle(h: i64) -> i64 {
    if h <= 2 { return 1; }           # never close the mapped std fds 0/1/2
    r = lx_close(h);
    if r < 0 { return 0; }
    return 1;
}

# GetStdHandle(nStdHandle) -> HANDLE(fd) : STD_OUTPUT(-11)->1, STD_INPUT(-10)->0, STD_ERROR(-12)->2
func GetStdHandle(n: i64) -> i64 {
    if n == 0 - 11 { return 1; }
    if n == 0 - 10 { return 0; }
    if n == 0 - 12 { return 2; }
    return 0 - 1;
}

# SetFilePointer(handle, distLow, &distHigh, whence) -> new offset (FILE_BEGIN/CURRENT/END = SEEK_SET/CUR/END)
func SetFilePointer(h: i64, dist: i64, pHigh: i64, whence: i64) -> i64 {
    return lx_lseek(h, dist, whence);
}

# ExitProcess(code) : exit_group, never returns
func ExitProcess(code: i64) -> i64 { syscall(231, code); return 0; }

# GetCommandLineA() -> LPSTR : reflatten the entry-stack argv into one space-joined string
# (so a program's existing GetCommandLineA tokenizer runs unchanged). Needs the compiler's
# __argv_base() (the rsp captured at _start).
# Any argv element that itself contains a space (or is empty) is wrapped in double-quotes,
# so the consumer's quote-aware tokenizer (e.g. main.ancl cargs()) reconstructs it as ONE
# token instead of re-splitting on the interior spaces. Space-free args are emitted verbatim
# (bit-identical to the old behavior), so single-word invocations are unaffected. This is what
# lets multi-word prompts ("The capital of France is") + a following max_new arg survive.
func GetCommandLineA() -> i64 {
    sp = __argv_base();
    argc = load64(sp);
    out = g_lx_cmdline;
    pos = 0;
    i = 0;
    while i < argc {
        ap = load64(sp + 8 + i * 8);          # argv[i]
        # scan: does this arg contain a space, or is it empty? -> needs quoting to stay one token
        needq = 0;
        k = 0;
        while load8(ap + k) != 0 {
            if load8(ap + k) == 32 { needq = 1; }
            k = k + 1;
        }
        if k == 0 { needq = 1; }
        if needq == 1 { if pos < 4094 { store8(out + pos, 34); pos = pos + 1; } }   # opening "
        j = 0;
        while load8(ap + j) != 0 {
            if pos < 4094 { store8(out + pos, load8(ap + j)); pos = pos + 1; }
            j = j + 1;
        }
        if needq == 1 { if pos < 4094 { store8(out + pos, 34); pos = pos + 1; } }   # closing "
        if i < argc - 1 { if pos < 4094 { store8(out + pos, 32); pos = pos + 1; } }
        i = i + 1;
    }
    store8(out + pos, 0);
    return out;
}

# CopyFileA(src, dst, bFailIfExists) -> BOOL : read/write loop (no sendfile; CRT-free)
func CopyFileA(src: i64, dst: i64, fail: i64) -> i64 {
    sfd = lx_open(src, O_RDONLY, 0);
    if sfd < 0 { return 0; }
    dfd = lx_create(dst);                      # O_WRONLY|O_CREAT|O_TRUNC, 0644
    if dfd < 0 { lx_close(sfd); return 0; }
    while 1 {
        got = lx_read(sfd, g_lx_copybuf, 4096);
        if got <= 0 { break; }
        lx_write(dfd, g_lx_copybuf, got);
    }
    lx_close(sfd);
    lx_close(dfd);
    return 1;
}
# ===================== END liblinux.ancl =====================

# ===================== BEGIN lexer.ancl =====================
# =====================================================================
#  lexer.ancl  -  ANCL tokenizer for anclc2 (self-hosting compiler)
#
#  Converts raw source bytes into a flat parallel token array.
#  All token text (identifiers, string values) is stored in g_str_pool.
#  Call lex_init(src_ptr, src_len) -> token_count (0 on error).
# =====================================================================

@DATA

# --- Token kind constants ---
TOK_END:        i64 = 0;
TOK_IDENT:      i64 = 1;
TOK_INT:        i64 = 2;
TOK_STR:        i64 = 3;
TOK_KWFUNC:     i64 = 4;
TOK_KWIF:       i64 = 5;
TOK_KWELSE:     i64 = 6;
TOK_KWWHILE:    i64 = 7;
TOK_KWRETURN:   i64 = 8;
TOK_KWBREAK:    i64 = 9;
TOK_KWCONTINUE: i64 = 10;
TOK_KWSYSCALL:  i64 = 11;
TOK_KWSTRUCT:   i64 = 12;
TOK_KWIMPORT:   i64 = 13;
TOK_KWEXTERN:   i64 = 14;
TOK_KWDATA:     i64 = 15;
TOK_KWCODE:     i64 = 16;
TOK_KWLOOP:     i64 = 17;
TOK_LPAREN:     i64 = 18;
TOK_RPAREN:     i64 = 19;
TOK_LBRACE:     i64 = 20;
TOK_RBRACE:     i64 = 21;
TOK_LBRACKET:   i64 = 22;
TOK_RBRACKET:   i64 = 23;
TOK_COLON:      i64 = 24;
TOK_SEMI:       i64 = 25;
TOK_COMMA:      i64 = 26;
TOK_ARROW:      i64 = 27;
TOK_ASSIGN:     i64 = 28;
TOK_DOT:        i64 = 29;
TOK_PLUS:       i64 = 30;
TOK_MINUS:      i64 = 31;
TOK_STAR:       i64 = 32;
TOK_SLASH:      i64 = 33;
TOK_PERCENT:    i64 = 34;
TOK_EQEQ:       i64 = 35;
TOK_NE:         i64 = 36;
TOK_LT:         i64 = 37;
TOK_LE:         i64 = 38;
TOK_GT:         i64 = 39;
TOK_GE:         i64 = 40;
TOK_AMP:        i64 = 41;
TOK_ANDAND:     i64 = 42;
TOK_OROR:       i64 = 43;
TOK_BANG:       i64 = 44;
TOK_PIPE:       i64 = 45;    # |   bitwise or
TOK_CARET:      i64 = 46;    # ^   bitwise xor
TOK_SHL:        i64 = 47;    # <<  shift left
TOK_SHR:        i64 = 48;    # >>  shift right
TOK_KWTOOL:     i64 = 49;    # tool  (LLM-callable fn + JSON-Schema descriptor)
TOK_FATARROW:   i64 = 50;    # =>    match arm (feature #5)
TOK_FLOAT:      i64 = 51;    # f64 literal; g_tok_ival holds the raw IEEE-754 bits

# --- Parallel token arrays (65536 tokens * 8 bytes each = 524288) ---
g_tok_kind:  buf = 524288;
g_tok_ival:  buf = 524288;
g_tok_toff:  buf = 524288;
g_tok_tlen:  buf = 524288;
g_tok_line:  buf = 524288;
g_tok_srcoff: buf = 524288;   # F1/F2: source byte offset where each token STARTS in g_src (--fix splice point)
g_tok_count: buf = 8;

# --- String / identifier text pool (256KB) ---
g_str_pool:     buf = 262144;
g_str_pool_off: buf = 8;

# --- Error strings ---
lex_err_over: str = "[lex] too many tokens\n";
lex_err_pool: str = "[lex] string pool overflow\n";
lex_err_str:  str = "[lex] unterminated string\n";

@CODE

# ----------------------------------------------------------------
#  Character classification helpers
# ----------------------------------------------------------------
func lex_isident_start(c: i64) -> i64 {
    if c == 64  { return 1; }    # '@'
    if c == 95  { return 1; }    # '_'
    if c >= 65  { if c <= 90  { return 1; } }   # A-Z
    if c >= 97  { if c <= 122 { return 1; } }   # a-z
    return 0;
}

func lex_isalnum(c: i64) -> i64 {
    if c == 95  { return 1; }    # '_'
    if c >= 48  { if c <= 57  { return 1; } }   # 0-9
    if c >= 65  { if c <= 90  { return 1; } }   # A-Z
    if c >= 97  { if c <= 122 { return 1; } }   # a-z
    return 0;
}

func lex_isdigit(c: i64) -> i64 {
    if c >= 48 { if c <= 57 { return 1; } }
    return 0;
}

func lex_ishex(c: i64) -> i64 {
    if c >= 48 { if c <= 57  { return 1; } }
    if c >= 65 { if c <= 70  { return 1; } }
    if c >= 97 { if c <= 102 { return 1; } }
    return 0;
}

func lex_hexval(c: i64) -> i64 {
    if c >= 48 { if c <= 57  { return c - 48; } }
    if c >= 65 { if c <= 70  { return c - 55; } }
    if c >= 97 { if c <= 102 { return c - 87; } }
    return 0;
}

# ----------------------------------------------------------------
#  lex_f64_bits(m, decexp) -> raw IEEE-754 bits of  m * 10^decexp
#  This is the ONLY place the compiler uses f64 itself: it dogfoods
#  the float support being added.  Clinger fast-path -- exact for
#  m < 2^53 and |decexp| <= 22 (every literal a human writes), and
#  graceful (one extra rounding) past that.  The result is the same
#  i64 bit-pattern strtod would yield, so g_tok_ival carries it.
# ----------------------------------------------------------------
func lex_f64_bits(m: i64, decexp: i64) -> i64 {
    f = itof(m);          # mantissa as a double
    p = 1.0;              # 10^|decexp|
    n = decexp;
    if n < 0 { n = 0 - n; }
    i = 0;
    while i < n {
        p = p * 10.0;
        i = i + 1;
    }
    if decexp >= 0 { f = f * p; }
    if decexp <  0 { f = f / p; }
    return fbits(f);
}

# ----------------------------------------------------------------
#  Pool helper: append one byte
# ----------------------------------------------------------------
func lex_pool_putc(ch: i64) -> i64 {
    off = load64(g_str_pool_off);
    if off >= 262142 { syscall 1, lex_err_pool; return 0 - 1; }
    store8(g_str_pool + off, ch);
    store64(g_str_pool_off, off + 1);
    return 0;
}

# ----------------------------------------------------------------
#  lex_escape(ch) -> decoded escape character value
# ----------------------------------------------------------------
func lex_escape(ch: i64) -> i64 {
    if ch == 110 { return 10; }    # \n -> LF
    if ch == 116 { return 9;  }    # \t -> TAB
    if ch == 114 { return 13; }    # \r -> CR
    if ch == 48  { return 0;  }    # \0 -> NUL
    if ch == 92  { return 92; }    # \\ -> backslash
    if ch == 34  { return 34; }    # \" -> quote
    if ch == 39  { return 39; }    # \' -> apostrophe
    return ch;
}

# ----------------------------------------------------------------
#  lex_iskw(pool_off, len) -> keyword TOK kind or TOK_IDENT
# ----------------------------------------------------------------
func lex_iskw(p: i64, len: i64) -> i64 {
    c0 = 0; c1 = 0; c2 = 0; c3 = 0; c4 = 0; c5 = 0; c6 = 0; c7 = 0;
    if len >= 1 { c0 = load8(g_str_pool + p + 0); }
    if len >= 2 { c1 = load8(g_str_pool + p + 1); }
    if len >= 3 { c2 = load8(g_str_pool + p + 2); }
    if len >= 4 { c3 = load8(g_str_pool + p + 3); }
    if len >= 5 { c4 = load8(g_str_pool + p + 4); }
    if len >= 6 { c5 = load8(g_str_pool + p + 5); }
    if len >= 7 { c6 = load8(g_str_pool + p + 6); }
    if len >= 8 { c7 = load8(g_str_pool + p + 7); }

    # "if" (2)
    if len == 2 {
        if c0 == 105 { if c1 == 102 { return TOK_KWIF; } }
    }
    # len == 4
    if len == 4 {
        # "func"  f=102 u=117 n=110 c=99
        if c0 == 102 { if c1 == 117 { if c2 == 110 { if c3 == 99  { return TOK_KWFUNC; } } } }
        # "else"  e=101 l=108 s=115 e=101
        if c0 == 101 { if c1 == 108 { if c2 == 115 { if c3 == 101 { return TOK_KWELSE; } } } }
        # "loop"  l=108 o=111 o=111 p=112
        if c0 == 108 { if c1 == 111 { if c2 == 111 { if c3 == 112 { return TOK_KWLOOP; } } } }
        # "tool"  t=116 o=111 o=111 l=108
        if c0 == 116 { if c1 == 111 { if c2 == 111 { if c3 == 108 { return TOK_KWTOOL; } } } }
    }
    # len == 5
    if len == 5 {
        # "while" w=119 h=104 i=105 l=108 e=101
        if c0 == 119 { if c1 == 104 { if c2 == 105 { if c3 == 108 { if c4 == 101 { return TOK_KWWHILE; } } } } }
        # "break" b=98 r=114 e=101 a=97 k=107
        if c0 == 98  { if c1 == 114 { if c2 == 101 { if c3 == 97  { if c4 == 107 { return TOK_KWBREAK; } } } } }
        # @DATA   @=64 D=68 A=65 T=84 A=65
        if c0 == 64  { if c1 == 68  { if c2 == 65  { if c3 == 84  { if c4 == 65  { return TOK_KWDATA; } } } } }
        # @CODE   @=64 C=67 O=79 D=68 E=69
        if c0 == 64  { if c1 == 67  { if c2 == 79  { if c3 == 68  { if c4 == 69  { return TOK_KWCODE; } } } } }
    }
    # len == 6
    if len == 6 {
        # "return" r=114 e=101 t=116 u=117 r=114 n=110
        if c0 == 114 { if c1 == 101 { if c2 == 116 { if c3 == 117 { if c4 == 114 { if c5 == 110 { return TOK_KWRETURN; } } } } } }
        # "struct" s=115 t=116 r=114 u=117 c=99  t=116
        if c0 == 115 { if c1 == 116 { if c2 == 114 { if c3 == 117 { if c4 == 99  { if c5 == 116 { return TOK_KWSTRUCT; } } } } } }
        # "import" i=105 m=109 p=112 o=111 r=114 t=116
        if c0 == 105 { if c1 == 109 { if c2 == 112 { if c3 == 111 { if c4 == 114 { if c5 == 116 { return TOK_KWIMPORT; } } } } } }
        # "extern" e=101 x=120 t=116 e=101 r=114 n=110
        if c0 == 101 { if c1 == 120 { if c2 == 116 { if c3 == 101 { if c4 == 114 { if c5 == 110 { return TOK_KWEXTERN; } } } } } }
    }
    # len == 7
    if len == 7 {
        # "syscall" s=115 y=121 s=115 c=99 a=97 l=108 l=108
        if c0 == 115 { if c1 == 121 { if c2 == 115 { if c3 == 99 { if c4 == 97 { if c5 == 108 { if c6 == 108 { return TOK_KWSYSCALL; } } } } } } }
    }
    # len == 8
    if len == 8 {
        # "continue" c=99 o=111 n=110 t=116 i=105 n=110 u=117 e=101
        if c0 == 99 { if c1 == 111 { if c2 == 110 { if c3 == 116 { if c4 == 105 { if c5 == 110 { if c6 == 117 { if c7 == 101 { return TOK_KWCONTINUE; } } } } } } } }
    }
    return TOK_IDENT;
}

# ----------------------------------------------------------------
#  lex_tok_set: store one token into parallel arrays at index idx
# ----------------------------------------------------------------
func lex_tok_set(idx: i64, kind: i64, ival: i64, toff: i64, tlen: i64, line: i64) -> i64 {
    base = idx * 8;
    store64(g_tok_kind + base, kind);
    store64(g_tok_ival + base, ival);
    store64(g_tok_toff + base, toff);
    store64(g_tok_tlen + base, tlen);
    store64(g_tok_line + base, line);
    return 0;
}

# ----------------------------------------------------------------
#  lex_init(src, src_len) -> token count  (0 on error)
#
#  Single-pass tokenizer.  Uses global g_str_pool for all text.
# ----------------------------------------------------------------
func lex_init(src: i64, src_len: i64) -> i64 {
    store64(g_tok_count, 0);
    store64(g_str_pool_off, 0);

    pos  = 0;
    line = 1;
    ntok = 0;

    while pos < src_len {

        # ---- skip whitespace and # comments ----
        do_skip = 1;
        while do_skip == 1 {
            do_skip = 0;
            if pos < src_len {
                sc = load8(src + pos);
                if sc == 32  { pos = pos + 1; do_skip = 1; }
                if sc == 9   { pos = pos + 1; do_skip = 1; }
                if sc == 13  { pos = pos + 1; do_skip = 1; }
                if sc == 10  { line = line + 1; pos = pos + 1; do_skip = 1; }
                if sc == 35  {
                    pos = pos + 1;
                    in_cmt = 1;
                    while in_cmt == 1 {
                        if pos >= src_len { in_cmt = 0; }
                        if in_cmt == 1 {
                            cc = load8(src + pos);
                            pos = pos + 1;
                            if cc == 10 { line = line + 1; in_cmt = 0; }
                        }
                    }
                    do_skip = 1;
                }
            }
        }

        if pos >= src_len { pos = src_len; }

        if pos < src_len {
            c = load8(src + pos);

            # guard max tokens
            if ntok >= 65534 { syscall 1, lex_err_over; return 0; }

            # F1/F2: record this token's START byte offset in the source (the --fix
            # splice point for a missing token that should appear before it). `pos`
            # is the token start here (post whitespace/comment skip); `ntok` is the
            # index every branch below assigns via lex_tok_set(ntok, ...). Written but
            # never read unless --fix recovery runs -> inert for the normal compile.
            store64(g_tok_srcoff + ntok * 8, pos);

            # ============================================================
            # IDENTIFIER / KEYWORD  (alpha, '_', or '@DATA'/'@CODE')
            # ============================================================
            if lex_isident_start(c) == 1 {
                tstart = load64(g_str_pool_off);
                tlen2  = 0;
                # Always consume the first character (including '@')
                lex_pool_putc(c);
                tlen2 = 1;
                pos   = pos + 1;
                going  = 1;
                while going == 1 {
                    if pos >= src_len { going = 0; }
                    if going == 1 {
                        ch2 = load8(src + pos);
                        if lex_isalnum(ch2) == 1 {
                            lex_pool_putc(ch2);
                            tlen2 = tlen2 + 1;
                            pos   = pos + 1;
                        }
                        if lex_isalnum(ch2) == 0 { going = 0; }
                    }
                }
                kind2 = lex_iskw(tstart, tlen2);
                lex_tok_set(ntok, kind2, 0, tstart, tlen2, line);
                ntok = ntok + 1;
            }

            # ============================================================
            # INTEGER / HEX LITERAL
            # ============================================================
            if lex_isdigit(c) == 1 {
                ival2  = 0;
                is_hex = 0;
                fl_is  = 0;       # 1 if this literal turns out to be an f64
                fl_de  = 0;       # base-10 exponent to apply (fraction + e-notation)
                # check 0x prefix
                if c == 48 {
                    if pos + 1 < src_len {
                        nc = load8(src + pos + 1);
                        if nc == 120 { is_hex = 1; pos = pos + 2; }
                        if nc == 88  { is_hex = 1; pos = pos + 2; }
                    }
                }
                if is_hex == 1 {
                    going = 1;
                    while going == 1 {
                        if pos >= src_len { going = 0; }
                        if going == 1 {
                            hc = load8(src + pos);
                            if lex_ishex(hc) == 1 {
                                ival2 = ival2 * 16 + lex_hexval(hc);
                                pos   = pos + 1;
                            }
                            if lex_ishex(hc) == 0 { going = 0; }
                        }
                    }
                }
                if is_hex == 0 {
                    going = 1;
                    while going == 1 {
                        if pos >= src_len { going = 0; }
                        if going == 1 {
                            dc = load8(src + pos);
                            if lex_isdigit(dc) == 1 {
                                ival2 = ival2 * 10 + (dc - 48);
                                pos   = pos + 1;
                            }
                            if lex_isdigit(dc) == 0 { going = 0; }
                        }
                    }
                    # ---- fraction: '.' immediately followed by a digit ----
                    # (so "<int>.field" stays TOK_INT + TOK_DOT, matching the bootstrap)
                    fl_p0 = 0; if pos     < src_len { fl_p0 = load8(src + pos);     }
                    fl_p1 = 0; if pos + 1 < src_len { fl_p1 = load8(src + pos + 1); }
                    if fl_p0 == 46 {
                        if lex_isdigit(fl_p1) == 1 {
                            fl_is = 1;
                            pos   = pos + 1;                 # consume '.'
                            going = 1;
                            while going == 1 {
                                if pos >= src_len { going = 0; }
                                if going == 1 {
                                    fl_fc = load8(src + pos);
                                    if lex_isdigit(fl_fc) == 1 { ival2 = ival2 * 10 + (fl_fc - 48); fl_de = fl_de - 1; pos = pos + 1; }
                                    if lex_isdigit(fl_fc) == 0 { going = 0; }
                                }
                            }
                        }
                    }
                    # ---- exponent: e/E [ +/- ] digits  (1.5e3, 2e10, 2E-5) ----
                    fl_p0 = 0; if pos     < src_len { fl_p0 = load8(src + pos);     }
                    fl_p1 = 0; if pos + 1 < src_len { fl_p1 = load8(src + pos + 1); }
                    fl_p2 = 0; if pos + 2 < src_len { fl_p2 = load8(src + pos + 2); }
                    fl_ise = 0;
                    if fl_p0 == 101 { fl_ise = 1; }          # 'e'
                    if fl_p0 == 69  { fl_ise = 1; }          # 'E'
                    if fl_ise == 1 {
                        fl_ok = 0;
                        if lex_isdigit(fl_p1) == 1 { fl_ok = 1; }
                        if fl_p1 == 43 { if lex_isdigit(fl_p2) == 1 { fl_ok = 1; } }   # '+'
                        if fl_p1 == 45 { if lex_isdigit(fl_p2) == 1 { fl_ok = 1; } }   # '-'
                        if fl_ok == 1 {
                            fl_is = 1;
                            pos   = pos + 1;                 # consume 'e'/'E'
                            fl_es = 1;
                            if pos < src_len { if load8(src + pos) == 43 { pos = pos + 1; } }
                            if pos < src_len { if load8(src + pos) == 45 { fl_es = 0 - 1; pos = pos + 1; } }
                            fl_ev = 0;
                            going = 1;
                            while going == 1 {
                                if pos >= src_len { going = 0; }
                                if going == 1 {
                                    fl_xc = load8(src + pos);
                                    if lex_isdigit(fl_xc) == 1 { fl_ev = fl_ev * 10 + (fl_xc - 48); pos = pos + 1; }
                                    if lex_isdigit(fl_xc) == 0 { going = 0; }
                                }
                            }
                            fl_de = fl_de + fl_es * fl_ev;
                        }
                    }
                }
                if fl_is == 1 { lex_tok_set(ntok, TOK_FLOAT, lex_f64_bits(ival2, fl_de), 0, 0, line); }
                if fl_is == 0 { lex_tok_set(ntok, TOK_INT,   ival2,                     0, 0, line); }
                ntok = ntok + 1;
            }

            # ============================================================
            # CHAR LITERAL  'x'
            # ============================================================
            if c == 39 {
                pos  = pos + 1;
                cval = 0;
                if pos < src_len {
                    cval = load8(src + pos);
                    pos  = pos + 1;
                    if cval == 92 {
                        if pos < src_len {
                            cval = lex_escape(load8(src + pos));
                            pos  = pos + 1;
                        }
                    }
                    if pos < src_len {
                        if load8(src + pos) == 39 { pos = pos + 1; }
                    }
                }
                lex_tok_set(ntok, TOK_INT, cval, 0, 0, line);
                ntok = ntok + 1;
            }

            # ============================================================
            # STRING LITERAL  "..."
            # ============================================================
            if c == 34 {
                pos    = pos + 1;
                tstart = load64(g_str_pool_off);
                tlen2  = 0;
                going  = 1;
                while going == 1 {
                    if pos >= src_len { syscall 1, lex_err_str; return 0; }
                    sch = load8(src + pos);
                    if sch == 34 {
                        pos   = pos + 1;
                        going = 0;
                    }
                    if going == 1 {
                        pos = pos + 1;
                        if sch == 92 {
                            if pos < src_len {
                                sch = lex_escape(load8(src + pos));
                                pos = pos + 1;
                            }
                        }
                        lex_pool_putc(sch);
                        tlen2 = tlen2 + 1;
                    }
                }
                lex_tok_set(ntok, TOK_STR, 0, tstart, tlen2, line);
                ntok = ntok + 1;
            }

            # ============================================================
            # SINGLE-CHAR PUNCTUATION
            # ============================================================
            if c == 40  { lex_tok_set(ntok, TOK_LPAREN,   0,0,0,line); ntok=ntok+1; pos=pos+1; }
            if c == 41  { lex_tok_set(ntok, TOK_RPAREN,   0,0,0,line); ntok=ntok+1; pos=pos+1; }
            if c == 123 { lex_tok_set(ntok, TOK_LBRACE,   0,0,0,line); ntok=ntok+1; pos=pos+1; }
            if c == 125 { lex_tok_set(ntok, TOK_RBRACE,   0,0,0,line); ntok=ntok+1; pos=pos+1; }
            if c == 91  { lex_tok_set(ntok, TOK_LBRACKET, 0,0,0,line); ntok=ntok+1; pos=pos+1; }
            if c == 93  { lex_tok_set(ntok, TOK_RBRACKET, 0,0,0,line); ntok=ntok+1; pos=pos+1; }
            if c == 46  { lex_tok_set(ntok, TOK_DOT,      0,0,0,line); ntok=ntok+1; pos=pos+1; }
            if c == 58  { lex_tok_set(ntok, TOK_COLON,    0,0,0,line); ntok=ntok+1; pos=pos+1; }
            if c == 59  { lex_tok_set(ntok, TOK_SEMI,     0,0,0,line); ntok=ntok+1; pos=pos+1; }
            if c == 44  { lex_tok_set(ntok, TOK_COMMA,    0,0,0,line); ntok=ntok+1; pos=pos+1; }
            if c == 43  { lex_tok_set(ntok, TOK_PLUS,     0,0,0,line); ntok=ntok+1; pos=pos+1; }
            if c == 42  { lex_tok_set(ntok, TOK_STAR,     0,0,0,line); ntok=ntok+1; pos=pos+1; }
            if c == 47  { lex_tok_set(ntok, TOK_SLASH,    0,0,0,line); ntok=ntok+1; pos=pos+1; }
            if c == 37  { lex_tok_set(ntok, TOK_PERCENT,  0,0,0,line); ntok=ntok+1; pos=pos+1; }
            if c == 94  { lex_tok_set(ntok, TOK_CARET,    0,0,0,line); ntok=ntok+1; pos=pos+1; }

            # ============================================================
            # MULTI-CHAR OPERATORS
            # ============================================================
            if c == 38 {
                pos = pos + 1;
                kind2 = TOK_AMP;
                if pos < src_len {
                    if load8(src + pos) == 38 { kind2 = TOK_ANDAND; pos = pos + 1; }
                }
                lex_tok_set(ntok, kind2, 0,0,0,line); ntok=ntok+1;
            }
            if c == 124 {
                pos = pos + 1;
                kind2 = TOK_PIPE;
                if pos < src_len {
                    if load8(src + pos) == 124 { kind2 = TOK_OROR; pos = pos + 1; }
                }
                lex_tok_set(ntok, kind2, 0,0,0,line); ntok=ntok+1;
            }
            if c == 33 {
                pos = pos + 1;
                kind2 = TOK_BANG;
                if pos < src_len {
                    if load8(src + pos) == 61 { kind2 = TOK_NE; pos = pos + 1; }
                }
                lex_tok_set(ntok, kind2, 0,0,0,line); ntok=ntok+1;
            }
            if c == 61 {
                pos = pos + 1;
                kind2 = TOK_ASSIGN;
                if pos < src_len {
                    if load8(src + pos) == 61 { kind2 = TOK_EQEQ; pos = pos + 1; }
                    if kind2 == TOK_ASSIGN {                                              # only if '==' didn't fire
                        if load8(src + pos) == 62 { kind2 = TOK_FATARROW; pos = pos + 1; }   # '=>' (feature #5)
                    }
                }
                lex_tok_set(ntok, kind2, 0,0,0,line); ntok=ntok+1;
            }
            if c == 60 {
                pos = pos + 1;
                kind2 = TOK_LT;
                if pos < src_len {
                    nc = load8(src + pos);
                    if nc == 61 { kind2 = TOK_LE;  pos = pos + 1; }
                    if nc == 60 { kind2 = TOK_SHL; pos = pos + 1; }
                }
                lex_tok_set(ntok, kind2, 0,0,0,line); ntok=ntok+1;
            }
            if c == 62 {
                pos = pos + 1;
                kind2 = TOK_GT;
                if pos < src_len {
                    nc = load8(src + pos);
                    if nc == 61 { kind2 = TOK_GE;  pos = pos + 1; }
                    if nc == 62 { kind2 = TOK_SHR; pos = pos + 1; }
                }
                lex_tok_set(ntok, kind2, 0,0,0,line); ntok=ntok+1;
            }
            if c == 45 {
                pos = pos + 1;
                kind2 = TOK_MINUS;
                if pos < src_len {
                    if load8(src + pos) == 62 { kind2 = TOK_ARROW; pos = pos + 1; }
                }
                lex_tok_set(ntok, kind2, 0,0,0,line); ntok=ntok+1;
            }
        }
    }

    # sentinel TOK_END
    store64(g_tok_srcoff + ntok * 8, src_len);   # F1/F2: a missing token at EOF splices at end-of-source
    lex_tok_set(ntok, TOK_END, 0, 0, 0, line);

    store64(g_tok_count, ntok);
    return ntok;
}
# ===================== END lexer.ancl =====================

# ===================== BEGIN parser.ancl =====================
# =====================================================================
#  parser.ancl  -  Recursive descent parser for anclc2
#
#  Builds a flat AST using parallel arrays indexed by node ID.
#  Import lexer.ancl before this file.
# =====================================================================

@DATA

# --- AST node kind constants ---
ND_INT:      i64 = 1;
ND_STR:      i64 = 2;
ND_VAR:      i64 = 3;
ND_BINARY:   i64 = 4;
ND_CALL:     i64 = 5;
ND_ADDR:     i64 = 6;
ND_FLOAT:    i64 = 7;     # f64 literal; g_nd_ival holds the raw IEEE-754 bits

ST_ASSIGN:   i64 = 10;
ST_IF:       i64 = 11;
ST_LOOP:     i64 = 12;
ST_RETURN:   i64 = 13;
ST_SYSCALL:  i64 = 14;
ST_EXPRSTMT: i64 = 15;
ST_BREAK:    i64 = 16;
ST_CONTINUE: i64 = 17;

# --- AST node parallel arrays (32768 nodes * 8 bytes = 262144) ---
g_nd_kind:    buf = 262144;
g_nd_ival:    buf = 262144;
g_nd_a:       buf = 262144;
g_nd_b:       buf = 262144;
g_nd_c:       buf = 262144;
g_nd_name:    buf = 262144;
g_nd_namelen: buf = 262144;
g_nd_isfloat: buf = 262144;   # per-node: 1 if the value is an f64 (lives in XMM0); set by the float-stamping pass
g_nd_count:   buf = 8;

# --- Program-level function table (512 fns * 8 bytes = 4096) ---
# (raised 256->512 for the Linux self-host: anclc2_all_linux.ancl has ~263 funcs)
g_fn_name:      buf = 4096;
g_fn_namelen:   buf = 4096;
g_fn_body:      buf = 4096;
g_fn_stmtcount: buf = 4096;
g_fn_nparams:   buf = 4096;
g_fn_rettype:   buf = 4096;
g_fn_count:     buf = 8;

# fn_params: 512 fns * 8 params * 2 slots (name_off, name_len) = 8192 * 8 = 65536 bytes
# layout: fn*128 + param*16 + 0 = name_off, fn*128 + param*16 + 8 = name_len
g_fn_params:    buf = 65536;
# f64 signature info (Win64 XMM calling convention):
g_fn_retfloat:  buf = 4096;     # 1 if the function returns f64/f32 (-> result in XMM0)
g_fn_pfloat:    buf = 32768;    # per fn, per param float flag; layout fn*64 + param*8 (8 params max)

# --- @DATA variable table (512 vars * 8 bytes = 4096) ---
g_dv_name:    buf = 4096;
g_dv_namelen: buf = 4096;
g_dv_type:    buf = 4096;
g_dv_ival:    buf = 4096;
g_dv_strid:   buf = 4096;
g_dv_bufsize: buf = 4096;
g_dv_isfloat: buf = 4096;     # 1 if this @DATA const is an f64/f32 (g_dv_ival holds IEEE-754 bits)
g_dv_count:   buf = 8;
g_arr_scratch: buf = 65536;   # scratch for building @DATA array byte blobs (interned as .rdata strings)

# g_dv_type values:
DV_I64:  i64 = 0;
DV_STR:  i64 = 1;
DV_BUF:  i64 = 2;
DV_I32:  i64 = 3;
DV_PTR:  i64 = 4;
DV_I8:   i64 = 5;
DV_I16:  i64 = 6;
DV_F64:  i64 = 7;
DV_F32:  i64 = 8;

# --- String literal table (1024 strings; content pool 128KB) ---
g_strings:   buf = 131072;
g_str_off:   buf = 8192;
g_str_len:   buf = 8192;
g_str_count: buf = 8;
g_str_next:  buf = 8;

# --- Extern declarations ---
g_ext_fn:    buf = 2048;
g_ext_fnlen: buf = 2048;
g_ext_dll:   buf = 2048;
g_ext_dlllen:buf = 2048;
g_ext_ptr:   buf = 2048;
g_ext_float: buf = 2048;     # 1 if the extern returns f64/f32 (result in XMM0; no sign-extend)
g_ext_count: buf = 8;

# --- Struct declarations (compile-time only; for sizeof + Struct.field) ---
# Flat parallel-array design, mirroring the AST arrays.
#   struct N owns fields [g_struct_ffield[N] .. g_struct_ffield[N]+g_struct_nfields[N])
g_struct_name:    buf = 512;   # i64[64] - pool offset of struct name
g_struct_namelen: buf = 512;   # i64[64] - length of struct name
g_struct_size:    buf = 512;   # i64[64] - total size (8-byte rounded)
g_struct_ffield:  buf = 512;   # i64[64] - index of first field in g_field_*
g_struct_nfields: buf = 512;   # i64[64] - number of fields
g_struct_count:   buf = 8;

g_field_name:   buf = 4096;   # i64[512] - pool offset of field name
g_field_namelen:buf = 4096;   # i64[512] - length of field name
g_field_off:    buf = 4096;   # i64[512] - byte offset within struct
g_field_count:  buf = 8;

# side-channel: par_typesize writes the parsed type's alignment here
g_par_typealign: buf = 8;

# --- Parser state ---
g_par_pos: buf = 8;

# --- Error strings ---
par_err_expect: str = "[par] unexpected token\n";
par_err_nd:     str = "[par] too many AST nodes\n";
par_err_fn:     str = "[par] too many functions\n";
par_err_dv:     str = "[par] too many data vars\n";
par_err_str:    str = "[par] too many strings\n";
par_err_ext:    str = "[par] too many externs\n";
par_err_struct: str = "[par] too many structs/fields\n";
par_err_type:   str = "[par] unknown type in sizeof\n";
par_err_nostr:  str = "[par] not a struct in .field\n";
par_err_nofld:  str = "[par] no such struct field\n";
par_err_cexpr:  str = "[par] bad const-expr in @DATA initializer\n";
par_err_arr:    str = "[par] bad @DATA array decl (type/length)\n";

# --- tool registry (feature #2): a `tool` is a func PLUS a JSON-Schema descriptor ---
g_tool_count:     buf = 8;       # number of `tool` decls
g_tool_fnidx:     buf = 2048;    # 256 tools: function index (into g_fn_*) per tool
g_tool_namesid:   buf = 2048;    # interned name string id per tool
g_tool_schemasid: buf = 2048;    # interned per-tool schema-object string id
g_tools_json_sid: buf = 8;       # interned "[{...},...]" array string id (built post-parse)
g_tool_schemabuf: buf = 8192;    # scratch: one tool's schema object
g_tool_propbuf:   buf = 8192;    # scratch: "properties" body
g_tool_reqbuf:    buf = 2048;    # scratch: "required" body
g_tool_jsonbuf:   buf = 65536;   # scratch: the full array

# JSON fragments (Anthropic tool-use format)
j_open:  str = "{\"name\":\"";
j_desc:  str = "\",\"description\":\"";
j_props: str = "\",\"input_schema\":{\"type\":\"object\",\"properties\":{";
j_q:     str = "\"";
j_pmid:  str = "\":{\"type\":\"";
j_pend:  str = "\"}";
j_comma: str = ",";
j_req:   str = "},\"required\":[";
j_close: str = "]}}";
# type-name literals (param type -> JSON type)
ty_i8:  str = "i8";
ty_i16: str = "i16";
ty_i32: str = "i32";
ty_i64: str = "i64";
ty_f32: str = "f32";
ty_f64: str = "f64";
jt_integer: str = "integer";
jt_number:  str = "number";
jt_string:  str = "string";

# --- prompt literals (feature #3): desugar to a func that calls ai_request ---
# interned-once pool offsets of the helper identifiers the desugared body references
g_pid_e:      buf = 8;
g_pid_strcpy: buf = 8;
g_pid_itoa:   buf = 8;
g_pid_strlen: buf = 8;
g_pid_airq:   buf = 8;
g_pid_pbuild: buf = 8;
g_pid_preply: buf = 8;
g_pid_done:   buf = 8;
pid_e_s:      str = "e";
pid_strcpy_s: str = "str_copy";
pid_itoa_s:   str = "int_to_str";
pid_strlen_s: str = "strlen";
pid_airq_s:   str = "ai_request";
pid_pbuild_s: str = "__prompt_build";
pid_preply_s: str = "__prompt_reply";
prompt_kw:    str = "prompt";
prompt_err_ret: str = "[par] a prompt must return str or ptr\n";
prompt_err_hole: str = "[par] prompt hole is not a parameter\n";
# scratch for template splitting + body synthesis
g_prompt_pisint: buf = 64;     # per-param: 1 if i8..i64 hole substitutes via int_to_str
g_prompt_segbuf: buf = 16384;  # current literal segment being assembled
g_prompt_segids: buf = 512;    # interned string id per segment (<=64)
g_prompt_holes:  buf = 512;    # param index per hole (<=64)
g_pchain_first:  buf = 8;      # synthesized statement-chain state
g_pchain_last:   buf = 8;
g_pchain_cnt:    buf = 8;

# --- feature #4: p.field / a[i] (typed locals; desugar to load/store) ---
# par_typesize side-channel: a COMPACT type. kind 0=plain scalar, 1=struct-pointer/value
# (dottable; aux=struct index), 2=scalar-pointer/array (indexable; aux=element width=stride).
g_pt_kind:   buf = 8;
g_pt_aux:    buf = 8;
g_pt_width:  buf = 8;          # value load/store width (8 for ptr; N for scalar) -> p.field width
g_pt_isaddr: buf = 8;          # 1 if array/struct-value field (.field yields its address)
# struct field types, parallel to g_field_off
g_field_width:  buf = 4096;
g_field_isaddr: buf = 4096;
# feature #4 v1.1 chaining: each field's COMPACT result type (par_typesize side-channel),
# so a `.field` step knows whether the value is itself dottable/indexable for the next step.
g_field_kind:   buf = 4096;    # 0 plain scalar, 1 struct-ptr (aux=struct index), 2 scalar-ptr/array (aux=elem width)
g_field_aux:    buf = 4096;
# per-function typed-local table (name -> compact type), reset per function body
g_lt_noff:  buf = 512;
g_lt_nlen:  buf = 512;
g_lt_kind:  buf = 512;
g_lt_aux:   buf = 512;
g_lt_count: buf = 8;
# interned load/store intrinsic names (for the synthesized .field/[i] nodes)
ld8_s:  str = "load8";   ld16_s: str = "load16";  ld32_s: str = "load32";  ld64_s: str = "load64";
st8_s:  str = "store8";  st16_s: str = "store16"; st32_s: str = "store32"; st64_s: str = "store64";
g_ld_off:  buf = 64;           # 8 entries: load8/16/32/64, store8/16/32/64
g_ld_len:  buf = 64;
g_ld_done: buf = 8;
fld_err_ann: str = "[par] .field/[i] needs a typed local (annotate `p: *Struct` / `a: *i32`)\n";

# --- feature #5: sum types (tagged unions) + match ---
# par_typesize also reports whether the type is a *Sum (g_pt_sum = sum index, else -1),
# and the per-function typed-local table records it (g_lt_sum) so `match` can detect a sum scrutinee.
g_pt_sum:  buf = 8;            # sum index for *Sum / bare Sum, else -1
g_lt_sum:  buf = 512;          # parallel to g_lt_*: sum index of a sum-typed local, else -1
# sum tables (mirror g_struct_*): sum N owns variants [g_sum_fvar[N] .. +g_sum_nvar[N])
g_sum_name:    buf = 512;      # i64[64] pool offset of sum name
g_sum_namelen: buf = 512;
g_sum_block:   buf = 512;      # i64[64] block size (8 tag + max payload, 8-aligned)
g_sum_fvar:    buf = 512;      # i64[64] index of first variant in g_var_*
g_sum_nvar:    buf = 512;      # i64[64] variant count
g_sum_count:   buf = 8;
# variant tables: variant V owns fields [g_var_ffield[V] .. +g_var_nfields[V])
g_var_name:    buf = 2048;     # i64[256] pool offset of variant name
g_var_namelen: buf = 2048;
g_var_tag:     buf = 2048;     # i64[256] variant index (the tag value)
g_var_ffield:  buf = 2048;     # i64[256] first field in g_vf_*
g_var_nfields: buf = 2048;
g_var_makeroff:buf = 2048;     # i64[256] pool offset of the synthesized maker fn name
g_var_makerlen:buf = 2048;
g_var_count:   buf = 8;
# variant-field tables (the payload fields of each variant)
g_vf_name:    buf = 4096;      # i64[512] pool offset of field name
g_vf_namelen: buf = 4096;
g_vf_off:     buf = 4096;      # i64[512] byte offset within the block (>=8)
g_vf_width:   buf = 4096;      # i64[512] load/store width
g_vf_count:   buf = 8;
# interned helper idents for makers + scratch for building maker names
sum_kw:    str = "sum";
mk_pre_s:  str = "__sum_";     # maker name prefix
mk_sep_s:  str = "_";          # sum_variant separator
alloc_s:   str = "alloc";
pvar_s:    str = "__p";        # maker's pointer local (avoids a field named `p`)
match_kw:  str = "match";
g_sum_ids_done: buf = 8;       # interned-once flag
g_id_alloc_off: buf = 8;       # pool ref of "alloc"
g_id_alloc_len: buf = 8;
g_id_p_off:     buf = 8;       # pool ref of "__p"
g_id_p_len:     buf = 8;
g_mk_scratch:   buf = 256;     # scratch buffer for building "__sum_Sum_Variant"
sum_err_var: str = "[par] unknown sum variant in construction/match\n";

# SC4: the `intent` oracle (L3). A contextual top-level keyword (like prompt/sum).
#   intent NAME { goal: "..."; case fn(args) => expected; ... }
# Backport of compiler/anclc.cpp parseIntent()/synthesizeCheckRunner(); dormant unless
# used, so the anclc3==anclc4 fixpoint is unaffected.
intent_kw:   str = "intent";
int_pre_s:   str = "__intent_";    # synthetic checker-name prefix
int_rt_s:    str = "i64";          # checker return type (g_fn_rettype slot; codegen ignores it)
int_main_s:  str = "main";         # --check synthesizes a fresh entry `main`
int_a_s:     str = "__a";          # actual-result temp local
int_e_s:     str = "__e";          # expected-value temp local
int_r_s:     str = "r";            # runner result temp local
ce_s0:       str = "intent ";
ce_s1:       str = " case ";
ce_s2:       str = ": expected ";
ce_s3:       str = " got ";
ce_nl:       str = "\n";
ce_ok:       str = "all intents OK\n";
g_int_scratch:  buf = 256;         # scratch for building "__intent_<name>"
g_intent_off:   buf = 512;         # i64[64] pool offset of each checker name
g_intent_len:   buf = 512;         # i64[64] checker-name length
g_intent_count: buf = 8;

# SC1 F1/F2: parser-side error recovery (missing-token insertion under --fix).
# All INERT during a normal compile: g_recover is set ONLY by the main.ancl --fix
# driver while it re-parses; par_expect poisons instead of ExitProcess only then.
# A valid self-compile never sets g_recover, so g_perr stays 0 -> codegen unchanged
# -> the anclc3==anclc4 fixpoint is preserved.
g_recover:  buf = 8;   # 1 while the --fix driver is parsing (par_expect recovers, never exits)
g_perr:     buf = 8;   # poison flag: 1 after the FIRST recoverable missing-token error
g_exp_tok:  buf = 8;   # the expected token kind that was missing
g_exp_off:  buf = 8;   # source byte offset (in the fix buffer) to splice the inserted token

@CODE

# ----------------------------------------------------------------
#  nd_alloc(kind) -> node id   (0 is reserved = null/empty)
# ----------------------------------------------------------------
func nd_alloc(kind: i64) -> i64 {
    n = load64(g_nd_count);
    n = n + 1;
    if n >= 32766 { syscall 1, par_err_nd; return 0; }
    store64(g_nd_count, n);
    base = n * 8;
    store64(g_nd_kind    + base, kind);
    store64(g_nd_ival    + base, 0);
    store64(g_nd_a       + base, 0);
    store64(g_nd_b       + base, 0);
    store64(g_nd_c       + base, 0);
    store64(g_nd_name    + base, 0);
    store64(g_nd_namelen + base, 0);
    return n;
}

# ----------------------------------------------------------------
#  str_intern(ptr, len) -> string id
#  Adds a string literal to g_strings, returns its id.
# ----------------------------------------------------------------
func str_intern(p: i64, len: i64) -> i64 {
    id  = load64(g_str_count);
    off = load64(g_str_next);
    if id >= 1023 { syscall 1, par_err_str; return 0; }
    # copy bytes into g_strings
    i = 0;
    while i < len {
        store8(g_strings + off + i, load8(p + i));
        i = i + 1;
    }
    store8(g_strings + off + len, 0);   # NUL terminator
    store64(g_str_off + id * 8, off);
    store64(g_str_len + id * 8, len);
    store64(g_str_count, id + 1);
    store64(g_str_next,  off + len + 1);
    return id;
}

# ----------------------------------------------------------------
#  pool_intern(p, len) -> offset in g_str_pool
#  Adds identifier/name text; returns byte offset.
# ----------------------------------------------------------------
func pool_intern(p: i64, len: i64) -> i64 {
    off = load64(g_str_pool_off);
    i   = 0;
    while i < len {
        store8(g_str_pool + off + i, load8(p + i));
        i = i + 1;
    }
    store8(g_str_pool + off + len, 0);
    store64(g_str_pool_off, off + len + 1);
    return off;
}

# ----------------------------------------------------------------
#  par_name_is(name_off, name_len, lit) -> 1 if pool slice == lit
#  Length-aware comparison of a (NON null-terminated) g_str_pool
#  name slice against a null-terminated C-string literal.  Mirrors
#  codegen's cg_fname_is (parser cannot call into codegen).
# ----------------------------------------------------------------
func par_name_is(name_off: i64, name_len: i64, lit: i64) -> i64 {
    i = 0;
    while i < name_len {
        if load8(lit + i) == 0 { return 0; }
        if load8(g_str_pool + name_off + i) != load8(lit + i) { return 0; }
        i = i + 1;
    }
    if load8(lit + name_len) != 0 { return 0; }
    return 1;
}

# ----------------------------------------------------------------
#  par_pool_eq(oa, la, ob, lb) -> 1 if two pool slices are equal
# ----------------------------------------------------------------
func par_pool_eq(oa: i64, la: i64, ob: i64, lb: i64) -> i64 {
    if la != lb { return 0; }
    i = 0;
    while i < la {
        if load8(g_str_pool + oa + i) != load8(g_str_pool + ob + i) { return 0; }
        i = i + 1;
    }
    return 1;
}

# ----------------------------------------------------------------
#  par_align_up(v, a) -> v rounded up to a multiple of a
# ----------------------------------------------------------------
func par_align_up(v: i64, a: i64) -> i64 {
    if a <= 1 { return v; }
    return (v + a - 1) / a * a;
}

# ----------------------------------------------------------------
#  par_struct_find(name_off, name_len) -> struct index or -1
# ----------------------------------------------------------------
func par_struct_find(name_off: i64, name_len: i64) -> i64 {
    n = load64(g_struct_count);
    i = 0;
    while i < n {
        if par_pool_eq(load64(g_struct_name + i*8), load64(g_struct_namelen + i*8), name_off, name_len) == 1 {
            return i;
        }
        i = i + 1;
    }
    return 0 - 1;
}

# feature #5: find a sum type by name -> index or -1 (mirrors par_struct_find)
func par_sum_find(name_off: i64, name_len: i64) -> i64 {
    n = load64(g_sum_count);
    i = 0;
    while i < n {
        if par_pool_eq(load64(g_sum_name + i*8), load64(g_sum_namelen + i*8), name_off, name_len) == 1 { return i; }
        i = i + 1;
    }
    return 0 - 1;
}
# find a variant of sum si by name -> GLOBAL variant index or -1
func par_variant_find(si: i64, name_off: i64, name_len: i64) -> i64 {
    base = load64(g_sum_fvar + si*8);
    nv   = load64(g_sum_nvar + si*8);
    i = 0;
    while i < nv {
        vi = base + i;
        if par_pool_eq(load64(g_var_name + vi*8), load64(g_var_namelen + vi*8), name_off, name_len) == 1 { return vi; }
        i = i + 1;
    }
    return 0 - 1;
}
# intern the maker helper idents (alloc, __p) into the pool once
func sum_ensure_ids() -> i64 {
    if load64(g_sum_ids_done) == 1 { return 0; }
    store64(g_id_alloc_off, pool_intern(alloc_s, strlen(alloc_s)));  store64(g_id_alloc_len, strlen(alloc_s));
    store64(g_id_p_off,     pool_intern(pvar_s,  strlen(pvar_s)));   store64(g_id_p_len,     strlen(pvar_s));
    store64(g_sum_ids_done, 1);
    return 0;
}
# build "__sum_<Sum>_<Variant>" into the pool; store its ref into g_var_maker*[vi]
func sum_build_maker_name(vi: i64, soff: i64, slen: i64, voff: i64, vlen: i64) -> i64 {
    o = 0;
    plen = strlen(mk_pre_s);
    i = 0; while i < plen { store8(g_mk_scratch + o, load8(mk_pre_s + i)); o = o + 1; i = i + 1; }
    i = 0; while i < slen { store8(g_mk_scratch + o, load8(g_str_pool + soff + i)); o = o + 1; i = i + 1; }
    store8(g_mk_scratch + o, 95); o = o + 1;          # '_'
    i = 0; while i < vlen { store8(g_mk_scratch + o, load8(g_str_pool + voff + i)); o = o + 1; i = i + 1; }
    store64(g_var_makeroff + vi*8, pool_intern(g_mk_scratch, o));
    store64(g_var_makerlen + vi*8, o);
    return 0;
}

# ----------------------------------------------------------------
#  par_field_off(struct_idx, fld_off, fld_len) -> byte offset or -1
# ----------------------------------------------------------------
func par_field_off(si: i64, fld_off: i64, fld_len: i64) -> i64 {
    base = load64(g_struct_ffield  + si*8);
    nf   = load64(g_struct_nfields + si*8);
    i = 0;
    while i < nf {
        idx = base + i;
        if par_pool_eq(load64(g_field_name + idx*8), load64(g_field_namelen + idx*8), fld_off, fld_len) == 1 {
            return load64(g_field_off + idx*8);
        }
        i = i + 1;
    }
    return 0 - 1;
}

# feature #4: field array-index (to read g_field_off/width/isaddr) or -1
func par_field_index(si: i64, fld_off: i64, fld_len: i64) -> i64 {
    base = load64(g_struct_ffield  + si*8);
    nf   = load64(g_struct_nfields + si*8);
    i = 0;
    while i < nf {
        idx = base + i;
        if par_pool_eq(load64(g_field_name + idx*8), load64(g_field_namelen + idx*8), fld_off, fld_len) == 1 {
            return idx;
        }
        i = i + 1;
    }
    return 0 - 1;
}

# ----------------------------------------------------------------
#  Parser token accessors
# ----------------------------------------------------------------
func par_init() -> i64 {
    store64(g_nd_count, 0);
    store64(g_fn_count, 0);
    store64(g_dv_count, 0);
    store64(g_str_count, 0);
    store64(g_str_next, 0);
    store64(g_ext_count, 0);
    store64(g_struct_count, 0);
    store64(g_field_count, 0);
    store64(g_sum_count, 0);          # feature #5
    store64(g_var_count, 0);
    store64(g_vf_count, 0);
    store64(g_intent_count, 0);       # SC4
    store64(g_par_pos, 0);
    return 0;
}

func par_peek() -> i64 {
    pos = load64(g_par_pos);
    return load64(g_tok_kind + pos * 8);
}

func par_cur_ival() -> i64 {
    pos = load64(g_par_pos);
    return load64(g_tok_ival + pos * 8);
}

func par_cur_toff() -> i64 {
    pos = load64(g_par_pos);
    return load64(g_tok_toff + pos * 8);
}

func par_cur_tlen() -> i64 {
    pos = load64(g_par_pos);
    return load64(g_tok_tlen + pos * 8);
}

func par_cur_line() -> i64 {
    pos = load64(g_par_pos);
    return load64(g_tok_line + pos * 8);
}

func par_advance() -> i64 {
    pos = load64(g_par_pos);
    store64(g_par_pos, pos + 1);
    return 0;
}

func par_accept(kind: i64) -> i64 {
    if par_peek() == kind { par_advance(); return 1; }
    return 0;
}

func par_expect(kind: i64) -> i64 {
    if par_peek() != kind {
        if load64(g_recover) != 0 {
            # SC1 F1/F2: recoverable missing token. Poison + record the FIRST error's
            # expected kind and the source splice point (start of the failing token).
            # Do NOT advance, do NOT exit; the parser's loops unwind on g_perr and the
            # --fix driver inserts the token text + re-parses.
            if load64(g_perr) == 0 {
                store64(g_perr, 1);
                store64(g_exp_tok, kind);
                store64(g_exp_off, load64(g_tok_srcoff + load64(g_par_pos) * 8));
            }
            return 0;
        }
        syscall 1, par_err_expect;
        ExitProcess(1);
        return 0;
    }
    par_advance();
    return 0;
}

# ----------------------------------------------------------------
#  par_typesize() -> total byte size of a type spec; writes the
#  base alignment into g_par_typealign.  Mirrors anclc.cpp
#  parseTypeSize: handles *T pointers, built-in scalars, struct
#  names, and T[N] arrays (N is a compile-time integer literal).
# ----------------------------------------------------------------
func par_scalarwidth(toff: i64, tlen: i64) -> i64 {
    if par_name_is(toff, tlen, "i8")  == 1 { return 1; }
    if par_name_is(toff, tlen, "i16") == 1 { return 2; }
    if par_name_is(toff, tlen, "i32") == 1 { return 4; }
    if par_name_is(toff, tlen, "f32") == 1 { return 4; }
    return 8;   # i64/f64/ptr/str/unknown
}

func par_typesize() -> i64 {
    base  = 8;
    align = 8;
    isptr = 0;
    eltoff = 0;
    eltlen = 0;

    # *T  -> pointer (8 bytes); capture the pointee name
    if par_peek() == TOK_STAR {
        par_advance();
        if par_peek() == TOK_IDENT {
            eltoff = par_cur_toff();
            eltlen = par_cur_tlen();
            par_advance();
        }
        base = 8; align = 8; isptr = 1;
    }
    if isptr == 0 {
        if par_peek() == TOK_IDENT {
            eltoff = par_cur_toff();
            eltlen = par_cur_tlen();
            par_advance();
            si = par_struct_find(eltoff, eltlen);
            if si != 0 - 1 {
                base = load64(g_struct_size + si * 8);
                align = 8;
            }
            if si == 0 - 1 {
                if par_name_is(eltoff, eltlen, "i8")  == 1 { base = 1; align = 1; }
                if par_name_is(eltoff, eltlen, "i16") == 1 { base = 2; align = 2; }
                if par_name_is(eltoff, eltlen, "i32") == 1 { base = 4; align = 4; }
                if par_name_is(eltoff, eltlen, "f32") == 1 { base = 4; align = 4; }
                if par_name_is(eltoff, eltlen, "i64") == 1 { base = 8; align = 8; }
                if par_name_is(eltoff, eltlen, "f64") == 1 { base = 8; align = 8; }
                if par_name_is(eltoff, eltlen, "ptr") == 1 { base = 8; align = 8; }
                if par_name_is(eltoff, eltlen, "str") == 1 { base = 8; align = 8; }
            }
        }
    }

    # compact type for the NON-array base
    sidx = par_struct_find(eltoff, eltlen);
    sumx = par_sum_find(eltoff, eltlen);     # feature #5: sum index or -1
    ptkind = 0; ptaux = 0; ptwidth = base; ptisaddr = 0;
    if isptr == 1 {
        ptwidth = 8;
        if sumx == 0 - 1 {                                                  # (a *Sum stays plain -> match, not .field/[i])
            if sidx != 0 - 1 { ptkind = 1; ptaux = sidx; }                  # *Struct -> dottable
            if sidx == 0 - 1 { ptkind = 2; ptaux = par_scalarwidth(eltoff, eltlen); }  # *scalar -> indexable
        }
    }
    if isptr == 0 {
        if sidx != 0 - 1 { ptkind = 1; ptaux = sidx; ptwidth = 8; ptisaddr = 1; }  # struct value -> dottable, addr
        # bare sum value -> ptkind stays 0 (plain); g_pt_sum carries the sum index
    }

    total = base;
    # T[N] array  (N is an integer literal)
    if par_peek() == TOK_LBRACKET {
        par_advance();
        cnt = par_cur_ival();
        par_expect(TOK_INT);
        par_expect(TOK_RBRACKET);
        total = base * cnt;
        ptisaddr = 1; ptwidth = 8;
        ptkind = 0; ptaux = 0;
        if isptr == 0 {
            if sidx == 0 - 1 { ptkind = 2; ptaux = base; }                 # scalar[N] indexable (base = scalar width)
        }
    }

    store64(g_par_typealign, align);
    store64(g_pt_kind,   ptkind);
    store64(g_pt_aux,    ptaux);
    store64(g_pt_width,  ptwidth);
    store64(g_pt_isaddr, ptisaddr);
    store64(g_pt_sum,    sumx);       # feature #5
    return total;
}

# ----------------------------------------------------------------
#  par_term() -> node id   (highest precedence: atoms)
# ----------------------------------------------------------------
func par_term() -> i64 {
    k = par_peek();

    # float literal (g_tok_ival carries the raw IEEE-754 bits from the lexer)
    if k == TOK_FLOAT {
        nd = nd_alloc(ND_FLOAT);
        store64(g_nd_ival    + nd * 8, par_cur_ival());
        store64(g_nd_isfloat + nd * 8, 1);
        par_advance();
        return nd;
    }

    # integer literal
    if k == TOK_INT {
        nd = nd_alloc(ND_INT);
        store64(g_nd_ival + nd * 8, par_cur_ival());
        par_advance();
        return nd;
    }

    # string literal
    if k == TOK_STR {
        toff = par_cur_toff();
        tlen = par_cur_tlen();
        sid  = str_intern(g_str_pool + toff, tlen);
        nd   = nd_alloc(ND_STR);
        store64(g_nd_ival + nd * 8, sid);
        par_advance();
        return nd;
    }

    # parenthesised expression
    if k == TOK_LPAREN {
        par_advance();
        nd = par_expr();
        par_expect(TOK_RPAREN);
        return nd;
    }

    # M5: raw syscall(...) in expression position (e.g. `fd = syscall(2, path, fl, md)`)
    # -> ND_CALL named "syscall". The legacy `syscall N, ...;` print form is statement-only.
    if k == TOK_KWSYSCALL {
        sys_toff = par_cur_toff();
        sys_tlen = par_cur_tlen();
        par_advance();
        par_expect(TOK_LPAREN);
        nd = nd_alloc(ND_CALL);
        store64(g_nd_name    + nd * 8, sys_toff);
        store64(g_nd_namelen + nd * 8, sys_tlen);
        first_arg = 0; last_arg = 0;
        if par_peek() != TOK_RPAREN {
            going = 1;
            while going == 1 {
                arg = par_expr();
                if first_arg == 0 { first_arg = arg; }
                if last_arg  != 0 { store64(g_nd_c + last_arg * 8, arg); }
                last_arg = arg;
                if par_peek() == TOK_COMMA { par_advance(); }
                else { going = 0; }
                if par_peek() == TOK_END { going = 0; }
            }
        }
        par_expect(TOK_RPAREN);
        store64(g_nd_a + nd * 8, first_arg);
        return nd;
    }

    # address-of:  &name
    if k == TOK_AMP {
        par_advance();
        nd  = nd_alloc(ND_ADDR);
        off = par_cur_toff();
        ln  = par_cur_tlen();
        store64(g_nd_name    + nd * 8, off);
        store64(g_nd_namelen + nd * 8, ln);
        par_expect(TOK_IDENT);
        return nd;
    }

    # unary minus  -> (0 - term)
    if k == TOK_MINUS {
        par_advance();
        rhs = par_term();
        nd  = nd_alloc(ND_BINARY);
        lhs = nd_alloc(ND_INT);
        store64(g_nd_ival + lhs * 8, 0);
        store64(g_nd_ival + nd  * 8, 45);   # '-'
        store64(g_nd_a    + nd  * 8, lhs);
        store64(g_nd_b    + nd  * 8, rhs);
        return nd;
    }

    # unary bang  -> (term == 0)
    if k == TOK_BANG {
        par_advance();
        lhs = par_term();
        nd  = nd_alloc(ND_BINARY);
        rhs = nd_alloc(ND_INT);
        store64(g_nd_ival + rhs * 8, 0);
        store64(g_nd_ival + nd  * 8, 101);  # 'e' == equal
        store64(g_nd_a    + nd  * 8, lhs);
        store64(g_nd_b    + nd  * 8, rhs);
        return nd;
    }

    # identifier: variable, call, struct.field access, sizeof
    if k == TOK_IDENT {
        toff = par_cur_toff();
        tlen = par_cur_tlen();
        par_advance();

        # sizeof(typespec) -> compile-time integer
        if par_name_is(toff, tlen, "sizeof") == 1 {
            if par_peek() == TOK_LPAREN {
                par_advance();
                sz = par_typesize();
                par_expect(TOK_RPAREN);
                nd = nd_alloc(ND_INT);
                store64(g_nd_ival + nd * 8, sz);
                return nd;
            }
        }

        # feature #5: sum construction  SumName.Variant  or  SumName.Variant(args)
        if par_peek() == TOK_DOT {
            smx = par_sum_find(toff, tlen);
            if smx != 0 - 1 {
                par_advance();                              # '.'
                vnoff = par_cur_toff(); vnlen = par_cur_tlen();
                par_expect(TOK_IDENT);
                vix = par_variant_find(smx, vnoff, vnlen);
                if vix == 0 - 1 { syscall 1, sum_err_var; ExitProcess(1); }
                nd = nd_alloc(ND_CALL);                     # call the synthesized maker
                store64(g_nd_name    + nd * 8, load64(g_var_makeroff + vix*8));
                store64(g_nd_namelen + nd * 8, load64(g_var_makerlen + vix*8));
                first_arg = 0; last_arg = 0;
                if par_peek() == TOK_LPAREN {
                    par_advance();
                    if par_peek() != TOK_RPAREN {
                        going = 1;
                        while going == 1 {
                            arg = par_expr();
                            if first_arg == 0 { first_arg = arg; }
                            if last_arg  != 0 { store64(g_nd_c + last_arg * 8, arg); }
                            last_arg = arg;
                            if par_peek() == TOK_COMMA { par_advance(); }
                            else { going = 0; }
                            if par_peek() == TOK_END { going = 0; }
                        }
                    }
                    par_expect(TOK_RPAREN);
                }
                store64(g_nd_a + nd * 8, first_arg);
                return nd;
            }
        }
        # StructName.field -> compile-time byte offset (single level, unchanged)
        if par_peek() == TOK_DOT {
            sidx0 = par_struct_find(toff, tlen);
            if sidx0 != 0 - 1 {
                par_advance();
                ftoff = par_cur_toff();
                ftlen = par_cur_tlen();
                par_expect(TOK_IDENT);
                foff = par_field_off(sidx0, ftoff, ftlen);
                if foff == 0 - 1 { syscall 1, par_err_nofld; ExitProcess(1); }
                nd = nd_alloc(ND_INT);
                store64(g_nd_ival + nd * 8, foff);
                return nd;
            }
        }
        # feature #4 v1.1: typed local followed by a postfix .field / [i] CHAIN
        #   p.next.tag  /  rows[i].field  /  bus.ports[i]  /  grid[i].ports[j]
        # Thread a running compact type (ctk,cta): a scalar/pointer step LOADS, a
        # struct/array step yields the ADDRESS (so the next . / [ chains off it).
        is_chain = 0;
        if par_peek() == TOK_DOT      { is_chain = 1; }
        if par_peek() == TOK_LBRACKET { is_chain = 1; }
        if is_chain == 1 {
            li = lt_find(toff, tlen);
            if li == 0 - 1 { syscall 1, fld_err_ann; ExitProcess(1); }
            cnode = nd_var(toff, tlen);
            ctk = load64(g_lt_kind + li * 8);
            cta = load64(g_lt_aux  + li * 8);
            going = 1;
            while going == 1 {
                going = 0;
                pk = par_peek();
                if pk == TOK_DOT {
                    par_advance();
                    ftoff = par_cur_toff();
                    ftlen = par_cur_tlen();
                    par_expect(TOK_IDENT);
                    if ctk != 1 { syscall 1, fld_err_ann; ExitProcess(1); }
                    fidx = par_field_index(cta, ftoff, ftlen);
                    if fidx == 0 - 1 { syscall 1, par_err_nofld; ExitProcess(1); }
                    faddr = nd_binary(43, cnode, nd_int(load64(g_field_off + fidx * 8)));
                    if load64(g_field_isaddr + fidx * 8) == 1 { cnode = faddr; }            # nested struct / array field -> address
                    else { cnode = nd_load(load64(g_field_width + fidx * 8), faddr); }      # scalar / pointer field -> load
                    ctk = load64(g_field_kind + fidx * 8);
                    cta = load64(g_field_aux  + fidx * 8);
                    going = 1;
                }
                if pk == TOK_LBRACKET {
                    par_advance();
                    ix = par_expr();
                    par_expect(TOK_RBRACKET);
                    if ctk == 0 { syscall 1, fld_err_ann; ExitProcess(1); }
                    if ctk == 1 {                                                          # struct element -> address; ct stays *Struct
                        istr = load64(g_struct_size + cta * 8);
                        cnode = nd_binary(43, cnode, nd_binary(42, ix, nd_int(istr)));
                    }
                    if ctk == 2 {                                                          # scalar element -> load; chain ends
                        cnode = nd_load(cta, nd_binary(43, cnode, nd_binary(42, ix, nd_int(cta))));
                        ctk = 0;
                        cta = 0;
                    }
                    going = 1;
                }
            }
            return cnode;
        }

        # function call: name(args...)
        if par_peek() == TOK_LPAREN {
            par_advance();
            nd = nd_alloc(ND_CALL);
            store64(g_nd_name    + nd * 8, toff);
            store64(g_nd_namelen + nd * 8, tlen);
            # args stored as linked list: g_nd_a = first arg node, each node g_nd_c = next.
            # (Must use g_nd_c, not g_nd_b: ND_BINARY uses g_nd_b for its RHS, so a
            #  binary expression passed as an argument would otherwise corrupt the chain.)
            first_arg = 0;
            last_arg  = 0;
            if par_peek() != TOK_RPAREN {
                going = 1;
                while going == 1 {
                    arg = par_expr();
                    if first_arg == 0 { first_arg = arg; }
                    if last_arg  != 0 { store64(g_nd_c + last_arg * 8, arg); }
                    last_arg = arg;
                    if par_peek() == TOK_COMMA { par_advance(); }
                    else { going = 0; }
                    if par_peek() == TOK_END { going = 0; }
                }
            }
            par_expect(TOK_RPAREN);
            store64(g_nd_a + nd * 8, first_arg);
            return nd;
        }

        # variable
        nd = nd_alloc(ND_VAR);
        store64(g_nd_name    + nd * 8, toff);
        store64(g_nd_namelen + nd * 8, tlen);
        return nd;
    }

    # fallback: return 0
    return 0;
}

# ----------------------------------------------------------------
#  par_mul() -> node  (*, /, %)
# ----------------------------------------------------------------
func par_mul() -> i64 {
    l = par_term();
    going = 1;
    while going == 1 {
        if load64(g_perr) != 0 { return l; }   # F1/F2: bail on poison, return partial LHS
        going = 0;
        k = par_peek();
        op = 0;
        if k == TOK_STAR    { op = 42;  going = 1; }   # '*'
        if k == TOK_SLASH   { op = 47;  going = 1; }   # '/'
        if k == TOK_PERCENT { op = 109; going = 1; }   # 'm'
        if going == 1 {
            par_advance();
            r  = par_term();
            nd = nd_alloc(ND_BINARY);
            store64(g_nd_ival + nd * 8, op);
            store64(g_nd_a    + nd * 8, l);
            store64(g_nd_b    + nd * 8, r);
            l = nd;
        }
    }
    return l;
}

# ----------------------------------------------------------------
#  par_add() -> node  (+, -)
# ----------------------------------------------------------------
func par_add() -> i64 {
    l = par_mul();
    going = 1;
    while going == 1 {
        if load64(g_perr) != 0 { return l; }   # F1/F2: bail on poison, return partial LHS
        going = 0;
        k = par_peek();
        op = 0;
        if k == TOK_PLUS  { op = 43; going = 1; }   # '+'
        if k == TOK_MINUS { op = 45; going = 1; }   # '-'
        if going == 1 {
            par_advance();
            r  = par_mul();
            nd = nd_alloc(ND_BINARY);
            store64(g_nd_ival + nd * 8, op);
            store64(g_nd_a    + nd * 8, l);
            store64(g_nd_b    + nd * 8, r);
            l = nd;
        }
    }
    return l;
}

# ----------------------------------------------------------------
#  par_shift() -> node  (<<, >>)   binds tighter than < ; looser than +
# ----------------------------------------------------------------
func par_shift() -> i64 {
    l = par_add();
    going = 1;
    while going == 1 {
        if load64(g_perr) != 0 { return l; }   # F1/F2: bail on poison, return partial LHS
        going = 0;
        k = par_peek();
        op = 0;
        if k == TOK_SHL { op = 83; going = 1; }   # 'S' shl
        if k == TOK_SHR { op = 82; going = 1; }   # 'R' shr
        if going == 1 {
            par_advance();
            r  = par_add();
            nd = nd_alloc(ND_BINARY);
            store64(g_nd_ival + nd * 8, op);
            store64(g_nd_a    + nd * 8, l);
            store64(g_nd_b    + nd * 8, r);
            l = nd;
        }
    }
    return l;
}

# ----------------------------------------------------------------
#  par_compare() -> node  (==, !=, <, <=, >, >=)
# ----------------------------------------------------------------
func par_compare() -> i64 {
    l = par_shift();
    going = 1;
    while going == 1 {
        if load64(g_perr) != 0 { return l; }   # F1/F2: bail on poison, return partial LHS
        going = 0;
        k = par_peek();
        op = 0;
        if k == TOK_EQEQ { op = 101; going = 1; }   # 'e'
        if k == TOK_NE   { op = 110; going = 1; }   # 'n'
        if k == TOK_LT   { op = 108; going = 1; }   # 'l'
        if k == TOK_LE   { op = 76;  going = 1; }   # 'L'
        if k == TOK_GT   { op = 103; going = 1; }   # 'g'
        if k == TOK_GE   { op = 71;  going = 1; }   # 'G'
        if going == 1 {
            par_advance();
            r  = par_shift();
            nd = nd_alloc(ND_BINARY);
            store64(g_nd_ival + nd * 8, op);
            store64(g_nd_a    + nd * 8, l);
            store64(g_nd_b    + nd * 8, r);
            l = nd;
        }
    }
    return l;
}

# ----------------------------------------------------------------
#  par_bitand() -> node  (&)   binds tighter than == ; looser than ^
# ----------------------------------------------------------------
func par_bitand() -> i64 {
    l = par_compare();
    while par_peek() == TOK_AMP {
        if load64(g_perr) != 0 { return l; }   # F1/F2: bail on poison, return partial LHS
        par_advance();
        r  = par_compare();
        nd = nd_alloc(ND_BINARY);
        store64(g_nd_ival + nd * 8, 38);   # '&'
        store64(g_nd_a    + nd * 8, l);
        store64(g_nd_b    + nd * 8, r);
        l = nd;
    }
    return l;
}

# ----------------------------------------------------------------
#  par_bitxor() -> node  (^)
# ----------------------------------------------------------------
func par_bitxor() -> i64 {
    l = par_bitand();
    while par_peek() == TOK_CARET {
        if load64(g_perr) != 0 { return l; }   # F1/F2: bail on poison, return partial LHS
        par_advance();
        r  = par_bitand();
        nd = nd_alloc(ND_BINARY);
        store64(g_nd_ival + nd * 8, 94);   # '^'
        store64(g_nd_a    + nd * 8, l);
        store64(g_nd_b    + nd * 8, r);
        l = nd;
    }
    return l;
}

# ----------------------------------------------------------------
#  par_bitor() -> node  (|)
# ----------------------------------------------------------------
func par_bitor() -> i64 {
    l = par_bitxor();
    while par_peek() == TOK_PIPE {
        if load64(g_perr) != 0 { return l; }   # F1/F2: bail on poison, return partial LHS
        par_advance();
        r  = par_bitxor();
        nd = nd_alloc(ND_BINARY);
        store64(g_nd_ival + nd * 8, 124);  # '|'
        store64(g_nd_a    + nd * 8, l);
        store64(g_nd_b    + nd * 8, r);
        l = nd;
    }
    return l;
}

# ----------------------------------------------------------------
#  par_and() -> node  (&&)
# ----------------------------------------------------------------
func par_and() -> i64 {
    l = par_bitor();
    while par_peek() == TOK_ANDAND {
        if load64(g_perr) != 0 { return l; }   # F1/F2: bail on poison, return partial LHS
        par_advance();
        r  = par_bitor();
        nd = nd_alloc(ND_BINARY);
        store64(g_nd_ival + nd * 8, 97);   # 'a'
        store64(g_nd_a    + nd * 8, l);
        store64(g_nd_b    + nd * 8, r);
        l = nd;
    }
    return l;
}

# ----------------------------------------------------------------
#  par_or() -> node  (||)
# ----------------------------------------------------------------
func par_or() -> i64 {
    l = par_and();
    while par_peek() == TOK_OROR {
        if load64(g_perr) != 0 { return l; }   # F1/F2: bail on poison, return partial LHS
        par_advance();
        r  = par_and();
        nd = nd_alloc(ND_BINARY);
        store64(g_nd_ival + nd * 8, 111);  # 'o'
        store64(g_nd_a    + nd * 8, l);
        store64(g_nd_b    + nd * 8, r);
        l = nd;
    }
    return l;
}

# ----------------------------------------------------------------
#  par_expr() -> node
# ----------------------------------------------------------------
func par_expr() -> i64 {
    return par_or();
}

# ----------------------------------------------------------------
#  par_stmt(fn_idx) -> node id of statement
# ----------------------------------------------------------------
func par_stmt(fn_idx: i64) -> i64 {
    k = par_peek();

    # if / else
    if k == TOK_KWIF {
        par_advance();
        nd = nd_alloc(ST_IF);
        cond = par_expr();
        store64(g_nd_a + nd * 8, cond);
        par_expect(TOK_LBRACE);
        # parse then-body as linked list of stmts
        first_then = 0; last_then = 0; cnt_then = 0;
        while par_peek() != TOK_RBRACE {
            if par_peek() == TOK_END { return nd; }
            if load64(g_perr) != 0 { return nd; }   # F1/F2: bail on poison
            s = par_stmt(fn_idx);
            if first_then == 0 { first_then = s; }
            if last_then  != 0 { store64(g_nd_c + last_then * 8, s); }
            last_then = s; cnt_then = cnt_then + 1;
        }
        par_expect(TOK_RBRACE);
        # g_nd_b = then-head, g_nd_ival = then-count
        store64(g_nd_b    + nd * 8, first_then);
        store64(g_nd_ival + nd * 8, cnt_then);
        # optional else.
        # NOTE: the else-branch HEAD is stored in the ST_IF node's g_nd_name
        # (an otherwise-unused slot for statements), NOT in g_nd_c.  g_nd_c is
        # the statement sibling link; storing the else-head there would collide
        # for  else { if ... }  (the inner-if's own g_nd_c else-link would be
        # mistaken for a sibling of the outer else-body).
        if par_peek() == TOK_KWELSE {
            par_advance();
            # else if -> nested
            if par_peek() == TOK_KWIF {
                esi = par_stmt(fn_idx);
                store64(g_nd_name + nd * 8, esi);
            }
            if par_peek() != TOK_KWIF {
                par_expect(TOK_LBRACE);
                first_el = 0; last_el = 0;
                while par_peek() != TOK_RBRACE {
                    if par_peek() == TOK_END { return nd; }
                    if load64(g_perr) != 0 { return nd; }   # F1/F2: bail on poison
                    s = par_stmt(fn_idx);
                    if first_el == 0 { first_el = s; }
                    if last_el  != 0 { store64(g_nd_c + last_el * 8, s); }
                    last_el = s;
                }
                par_expect(TOK_RBRACE);
                store64(g_nd_name + nd * 8, first_el);
            }
        }
        return nd;
    }

    # while / loop
    if k == TOK_KWWHILE { par_advance(); }
    if k == TOK_KWLOOP  { par_advance(); k = TOK_KWWHILE; }
    if k == TOK_KWWHILE {
        nd = nd_alloc(ST_LOOP);
        cond = par_expr();
        store64(g_nd_a + nd * 8, cond);
        par_expect(TOK_LBRACE);
        first_s = 0; last_s = 0; cnt_s = 0;
        while par_peek() != TOK_RBRACE {
            if par_peek() == TOK_END { return nd; }
            if load64(g_perr) != 0 { return nd; }   # F1/F2: bail on poison
            s = par_stmt(fn_idx);
            if first_s == 0 { first_s = s; }
            if last_s  != 0 { store64(g_nd_c + last_s * 8, s); }
            last_s = s; cnt_s = cnt_s + 1;
        }
        par_expect(TOK_RBRACE);
        store64(g_nd_b    + nd * 8, first_s);
        store64(g_nd_ival + nd * 8, cnt_s);
        return nd;
    }

    # return
    if k == TOK_KWRETURN {
        par_advance();
        nd = nd_alloc(ST_RETURN);
        e  = par_expr();
        store64(g_nd_a + nd * 8, e);
        par_expect(TOK_SEMI);
        return nd;
    }

    # break
    if k == TOK_KWBREAK {
        par_advance();
        par_expect(TOK_SEMI);
        return nd_alloc(ST_BREAK);
    }

    # continue
    if k == TOK_KWCONTINUE {
        par_advance();
        par_expect(TOK_SEMI);
        return nd_alloc(ST_CONTINUE);
    }

    # syscall
    if k == TOK_KWSYSCALL {
        sys_toff = par_cur_toff();
        sys_tlen = par_cur_tlen();
        par_advance();
        # M5: raw `syscall(nr, a0..a5)` CALL form (statement) -> ND_CALL named "syscall"
        # (the keyword token's pooled text IS "syscall"). The legacy `syscall N, args;`
        # PRINT form (next token is an INT) is byte-preserved -> the PE fixpoint is unaffected.
        if par_peek() == TOK_LPAREN {
            par_advance();
            nd   = nd_alloc(ST_EXPRSTMT);
            call = nd_alloc(ND_CALL);
            store64(g_nd_name    + call * 8, sys_toff);
            store64(g_nd_namelen + call * 8, sys_tlen);
            first_a = 0; last_a = 0;
            if par_peek() != TOK_RPAREN {
                going = 1;
                while going == 1 {
                    if load64(g_perr) != 0 { going = 0; }
                    arg = par_expr();
                    if first_a == 0 { first_a = arg; }
                    if last_a  != 0 { store64(g_nd_c + last_a * 8, arg); }
                    last_a = arg;
                    if par_peek() == TOK_COMMA { par_advance(); }
                    else { going = 0; }
                    if par_peek() == TOK_END { going = 0; }
                }
            }
            par_expect(TOK_RPAREN);
            par_expect(TOK_SEMI);
            store64(g_nd_a + call * 8, first_a);
            store64(g_nd_a + nd   * 8, call);
            return nd;
        }
        nd = nd_alloc(ST_SYSCALL);
        sysno = par_cur_ival();
        par_expect(TOK_INT);
        store64(g_nd_ival + nd * 8, sysno);
        first_a = 0; last_a = 0; cnt_a = 0;
        while par_peek() == TOK_COMMA {
            if load64(g_perr) != 0 { return nd; }   # F1/F2: bail on poison
            par_advance();
            arg = par_expr();
            if first_a == 0 { first_a = arg; }
            if last_a  != 0 { store64(g_nd_c + last_a * 8, arg); }   # arg-next via g_nd_c (see par_term note)
            last_a = arg; cnt_a = cnt_a + 1;
        }
        par_expect(TOK_SEMI);
        store64(g_nd_a + nd * 8, first_a);
        return nd;
    }

    # identifier -> assignment or expression-statement (call)
    if k == TOK_IDENT {
        toff = par_cur_toff();
        tlen = par_cur_tlen();
        par_advance();

        # feature #5: `match` is contextual -- a keyword only when followed by an identifier
        # (the scrutinee). `match = â€¦` / `match(â€¦)` keep `match` as an ordinary identifier.
        if par_name_is(toff, tlen, match_kw) == 1 {
            if par_peek() == TOK_IDENT { return par_match(fn_idx); }
        }

        # function call as statement
        if par_peek() == TOK_LPAREN {
            par_advance();
            nd = nd_alloc(ST_EXPRSTMT);
            call = nd_alloc(ND_CALL);
            store64(g_nd_name    + call * 8, toff);
            store64(g_nd_namelen + call * 8, tlen);
            first_a = 0; last_a = 0;
            if par_peek() != TOK_RPAREN {
                going = 1;
                while going == 1 {
                    if load64(g_perr) != 0 { going = 0; }   # F1/F2: bail on poison
                    arg = par_expr();
                    if first_a == 0 { first_a = arg; }
                    if last_a  != 0 { store64(g_nd_c + last_a * 8, arg); }   # arg-next via g_nd_c (see par_term note)
                    last_a = arg;
                    if par_peek() == TOK_COMMA { par_advance(); }
                    else { going = 0; }
                    if par_peek() == TOK_END { going = 0; }
                }
            }
            par_expect(TOK_RPAREN);
            par_expect(TOK_SEMI);
            store64(g_nd_a + call * 8, first_a);
            store64(g_nd_a + nd   * 8, call);
            return nd;
        }

        # feature #4: typed local declaration  `name : type = expr ;`
        if par_peek() == TOK_COLON {
            par_advance();
            par_typesize();                                   # fills g_pt_kind/aux side-channel
            lt_add(toff, tlen, load64(g_pt_kind), load64(g_pt_aux));
            par_expect(TOK_ASSIGN);
            nd = nd_alloc(ST_ASSIGN);
            store64(g_nd_name    + nd * 8, toff);
            store64(g_nd_namelen + nd * 8, tlen);
            e = par_expr();
            store64(g_nd_a + nd * 8, e);
            par_expect(TOK_SEMI);
            return nd;
        }
        # feature #4 v1.1: typed-local field/index STORE, possibly CHAINED:
        #   p.field = v ;  p.next.tag = v ;  a[i] = v ;  rows[i].field = v ;
        # Navigate the chain; the FINAL step (the access followed by '=') becomes a store.
        is_chain = 0;
        if par_peek() == TOK_DOT      { is_chain = 1; }
        if par_peek() == TOK_LBRACKET { is_chain = 1; }
        if is_chain == 1 {
            li = lt_find(toff, tlen);
            if li == 0 - 1 { syscall 1, fld_err_ann; ExitProcess(1); }
            cnode = nd_var(toff, tlen);
            ctk = load64(g_lt_kind + li * 8);
            cta = load64(g_lt_aux  + li * 8);
            sresult = 0;
            sdone = 0;
            while sdone == 0 {
                if load64(g_perr) != 0 { sdone = 1; }   # F1/F2: bail on poison
                pk = par_peek();
                if pk != TOK_DOT {
                    if pk != TOK_LBRACKET {
                        if load64(g_perr) == 0 { syscall 1, par_err_expect; ExitProcess(1); }
                        sdone = 1;
                    }
                }
                if pk == TOK_DOT {
                    par_advance();
                    ftoff = par_cur_toff();
                    ftlen = par_cur_tlen();
                    par_expect(TOK_IDENT);
                    if ctk != 1 { syscall 1, fld_err_ann; ExitProcess(1); }
                    fidx = par_field_index(cta, ftoff, ftlen);
                    if fidx == 0 - 1 { syscall 1, par_err_nofld; ExitProcess(1); }
                    faddr = nd_binary(43, cnode, nd_int(load64(g_field_off + fidx * 8)));
                    if par_peek() == TOK_ASSIGN {
                        par_advance();
                        rhs = par_expr();
                        par_expect(TOK_SEMI);
                        sresult = nd_store(load64(g_field_width + fidx * 8), faddr, rhs);
                        sdone = 1;
                    }
                    if sdone == 0 {
                        if load64(g_field_isaddr + fidx * 8) == 1 { cnode = faddr; }
                        else { cnode = nd_load(load64(g_field_width + fidx * 8), faddr); }
                        ctk = load64(g_field_kind + fidx * 8);
                        cta = load64(g_field_aux  + fidx * 8);
                    }
                }
                if pk == TOK_LBRACKET {
                    par_advance();
                    ix = par_expr();
                    par_expect(TOK_RBRACKET);
                    if ctk == 0 { syscall 1, fld_err_ann; ExitProcess(1); }
                    istr = cta;
                    if ctk == 1 { istr = load64(g_struct_size + cta * 8); }
                    iaddr = nd_binary(43, cnode, nd_binary(42, ix, nd_int(istr)));
                    if par_peek() == TOK_ASSIGN {
                        if ctk == 1 { syscall 1, fld_err_ann; ExitProcess(1); }   # cannot store a struct element directly
                        par_advance();
                        rhs = par_expr();
                        par_expect(TOK_SEMI);
                        sresult = nd_store(cta, iaddr, rhs);
                        sdone = 1;
                    }
                    if sdone == 0 {
                        if ctk == 1 { cnode = iaddr; }
                        else { cnode = nd_load(cta, iaddr); ctk = 0; cta = 0; }
                    }
                }
            }
            nd = nd_alloc(ST_EXPRSTMT);
            store64(g_nd_a + nd * 8, sresult);
            return nd;
        }

        # assignment
        nd = nd_alloc(ST_ASSIGN);
        store64(g_nd_name    + nd * 8, toff);
        store64(g_nd_namelen + nd * 8, tlen);
        par_expect(TOK_ASSIGN);
        e = par_expr();
        store64(g_nd_a + nd * 8, e);
        par_expect(TOK_SEMI);
        return nd;
    }

    # unknown statement
    syscall 1, par_err_expect;
    return 0;
}

# ----------------------------------------------------------------
#  tool-schema string builders (append into `buf` at `off`, return new off)
# ----------------------------------------------------------------
func tb_puts(buf: i64, off: i64, cstr: i64) -> i64 {       # append a C-string
    i = 0;
    while load8(cstr + i) != 0 {
        store8(buf + off + i, load8(cstr + i));
        i = i + 1;
    }
    return off + i;
}
func tb_putpool(buf: i64, off: i64, pooloff: i64, poollen: i64) -> i64 {   # append a g_str_pool slice
    i = 0;
    while i < poollen {
        store8(buf + off + i, load8(g_str_pool + pooloff + i));
        i = i + 1;
    }
    return off + poollen;
}
func tb_putbuf(buf: i64, off: i64, src: i64, srclen: i64) -> i64 {         # append a raw buffer slice
    i = 0;
    while i < srclen {
        store8(buf + off + i, load8(src + i));
        i = i + 1;
    }
    return off + srclen;
}
func tb_putesc(buf: i64, off: i64, pooloff: i64, poollen: i64) -> i64 {    # append a g_str_pool slice, JSON-escaped
    i = 0;
    while i < poollen {
        c = load8(g_str_pool + pooloff + i);
        if c == 34 { store8(buf + off, 92); store8(buf + off + 1, 34);  off = off + 2; }   # \"
        if c == 92 { store8(buf + off, 92); store8(buf + off + 1, 92);  off = off + 2; }   # \\
        if c == 10 { store8(buf + off, 92); store8(buf + off + 1, 110); off = off + 2; }   # \n
        if c == 13 { store8(buf + off, 92); store8(buf + off + 1, 114); off = off + 2; }   # \r
        if c == 9  { store8(buf + off, 92); store8(buf + off + 1, 116); off = off + 2; }   # \t
        if c != 34 { if c != 92 { if c != 10 { if c != 13 { if c != 9 {
            store8(buf + off, c); off = off + 1;
        } } } } }
        i = i + 1;
    }
    return off;
}

# param ANCL type (pool slice) -> JSON-schema type C-string
func tool_jtype(toff: i64, tlen: i64) -> i64 {
    if par_name_is(toff, tlen, ty_i8)  == 1 { return jt_integer; }
    if par_name_is(toff, tlen, ty_i16) == 1 { return jt_integer; }
    if par_name_is(toff, tlen, ty_i32) == 1 { return jt_integer; }
    if par_name_is(toff, tlen, ty_i64) == 1 { return jt_integer; }
    if par_name_is(toff, tlen, ty_f32) == 1 { return jt_number; }
    if par_name_is(toff, tlen, ty_f64) == 1 { return jt_number; }
    return jt_string;          # str / ptr / struct* -> opaque "string"
}

# ----------------------------------------------------------------
#  par_tool() -> function index
#  Parses like par_func (so the tool is a normal callable function),
#  PLUS records a JSON-Schema descriptor for the tool registry.
# ----------------------------------------------------------------
func par_tool() -> i64 {
    par_expect(TOK_KWTOOL);

    fi = load64(g_fn_count);
    if fi >= 511 { syscall 1, par_err_fn; return 0 - 1; }
    ti = load64(g_tool_count);

    # function name
    toff = par_cur_toff();
    tlen = par_cur_tlen();
    par_expect(TOK_IDENT);
    store64(g_fn_name    + fi * 8, toff);
    store64(g_fn_namelen + fi * 8, tlen);

    # schema so far:  {"name":"<name>","description":"
    so = 0;
    so = tb_puts(g_tool_schemabuf, so, j_open);
    so = tb_putpool(g_tool_schemabuf, so, toff, tlen);
    so = tb_puts(g_tool_schemabuf, so, j_desc);

    # parameter list -> accumulate properties + required into scratch buffers
    par_expect(TOK_LPAREN);
    np = 0;
    po = 0;
    ro = 0;
    store64(g_lt_count, 0);                  # feature #4: reset the typed-local table for this body
    if par_peek() != TOK_RPAREN {
        going = 1;
        while going == 1 {
            if load64(g_perr) != 0 { going = 0; }   # F1/F2: bail on poison (par_expect stops advancing -> would spin)
            ptoff = par_cur_toff();
            ptlen = par_cur_tlen();
            par_expect(TOK_IDENT);
            par_expect(TOK_COLON);
            tytoff = par_cur_toff();
            tytlen = par_cur_tlen();
            par_expect(TOK_IDENT);
            lt_seed_param(ptoff, ptlen, tytoff, tytlen);   # feature #4
            store64(g_fn_params + fi * 128 + np * 16 + 0, ptoff);
            store64(g_fn_params + fi * 128 + np * 16 + 8, ptlen);
            if np > 0 {
                po = tb_puts(g_tool_propbuf, po, j_comma);
                ro = tb_puts(g_tool_reqbuf,  ro, j_comma);
            }
            # "pname":{"type":"<jtype>"}
            po = tb_puts(g_tool_propbuf, po, j_q);
            po = tb_putpool(g_tool_propbuf, po, ptoff, ptlen);
            po = tb_puts(g_tool_propbuf, po, j_pmid);
            po = tb_puts(g_tool_propbuf, po, tool_jtype(tytoff, tytlen));
            po = tb_puts(g_tool_propbuf, po, j_pend);
            # "pname"
            ro = tb_puts(g_tool_reqbuf, ro, j_q);
            ro = tb_putpool(g_tool_reqbuf, ro, ptoff, ptlen);
            ro = tb_puts(g_tool_reqbuf, ro, j_q);
            np = np + 1;
            if par_peek() == TOK_COMMA { par_advance(); }
            if par_peek() == TOK_RPAREN { going = 0; }
            if par_peek() == TOK_ARROW  { going = 0; }   # F1/F2: '->' ends the param list, so a missing ')' heals AS ')' (not as a bogus IDENT)
            if par_peek() == TOK_END    { going = 0; }
        }
    }
    par_expect(TOK_RPAREN);
    store64(g_fn_nparams + fi * 8, np);

    # return type
    par_expect(TOK_ARROW);
    rt = par_cur_toff();
    par_expect(TOK_IDENT);
    store64(g_fn_rettype + fi * 8, rt);

    # optional description string (fills the "description" value)
    if par_peek() == TOK_STR {
        dtoff = par_cur_toff();
        dtlen = par_cur_tlen();
        par_advance();
        so = tb_putesc(g_tool_schemabuf, so, dtoff, dtlen);
    }

    # finish schema:  ","input_schema":{...,"properties":{<props>},"required":[<req>]}}
    so = tb_puts(g_tool_schemabuf, so, j_props);
    so = tb_putbuf(g_tool_schemabuf, so, g_tool_propbuf, po);
    so = tb_puts(g_tool_schemabuf, so, j_req);
    so = tb_putbuf(g_tool_schemabuf, so, g_tool_reqbuf, ro);
    so = tb_puts(g_tool_schemabuf, so, j_close);

    # intern the name + the per-tool schema; record the registry entry
    nsid = str_intern(g_str_pool + toff, tlen);
    ssid = str_intern(g_tool_schemabuf, so);
    store64(g_tool_fnidx     + ti * 8, fi);
    store64(g_tool_namesid   + ti * 8, nsid);
    store64(g_tool_schemasid + ti * 8, ssid);
    store64(g_tool_count, ti + 1);

    # body (identical to par_func)
    par_expect(TOK_LBRACE);
    first_s = 0; last_s = 0; cnt_s = 0;
    while par_peek() != TOK_RBRACE {
        if par_peek() == TOK_END { par_expect(TOK_RBRACE); return 0 - 1; }
        if load64(g_perr) != 0 { return 0 - 1; }   # F1/F2: bail on poison
        s = par_stmt(fi);
        if first_s == 0 { first_s = s; }
        if last_s  != 0 { store64(g_nd_c + last_s * 8, s); }
        last_s = s; cnt_s = cnt_s + 1;
    }
    par_expect(TOK_RBRACE);

    store64(g_fn_body      + fi * 8, first_s);
    store64(g_fn_stmtcount + fi * 8, cnt_s);
    store64(g_fn_count, fi + 1);
    return fi;
}

# Build the "[{schema},...]" array string from all per-tool schemas. Call once
# after par_program (no-op when no tools were declared).
func build_tool_registry() -> i64 {
    nt = load64(g_tool_count);
    if nt == 0 { return 0; }
    bo = 0;
    store8(g_tool_jsonbuf + bo, 91); bo = bo + 1;        # '['
    k = 0;
    while k < nt {
        if k > 0 { store8(g_tool_jsonbuf + bo, 44); bo = bo + 1; }   # ','
        sid  = load64(g_tool_schemasid + k * 8);
        soff = load64(g_str_off + sid * 8);
        slen = load64(g_str_len + sid * 8);
        i = 0;
        while i < slen {
            store8(g_tool_jsonbuf + bo + i, load8(g_strings + soff + i));
            i = i + 1;
        }
        bo = bo + slen;
        k = k + 1;
    }
    store8(g_tool_jsonbuf + bo, 93); bo = bo + 1;        # ']'
    jsid = str_intern(g_tool_jsonbuf, bo);
    store64(g_tools_json_sid, jsid);
    return 0;
}

# ----------------------------------------------------------------
#  prompt literals (feature #3): a `prompt` desugars to an ordinary
#  function (built as flat AST nodes) that substitutes {param} holes
#  into __prompt_build, calls ai_request(build, reply), returns reply.
# ----------------------------------------------------------------
func prompt_ensure_ids() -> i64 {
    if load64(g_pid_done) == 1 { return 0; }
    store64(g_pid_e,      pool_intern(pid_e_s,      strlen(pid_e_s)));
    store64(g_pid_strcpy, pool_intern(pid_strcpy_s, strlen(pid_strcpy_s)));
    store64(g_pid_itoa,   pool_intern(pid_itoa_s,   strlen(pid_itoa_s)));
    store64(g_pid_strlen, pool_intern(pid_strlen_s, strlen(pid_strlen_s)));
    store64(g_pid_airq,   pool_intern(pid_airq_s,   strlen(pid_airq_s)));
    store64(g_pid_pbuild, pool_intern(pid_pbuild_s, strlen(pid_pbuild_s)));
    store64(g_pid_preply, pool_intern(pid_preply_s, strlen(pid_preply_s)));
    store64(g_pid_done, 1);
    return 0;
}

# flat-AST node builders (mirror the inline node construction elsewhere in the parser)
func nd_var(off: i64, len: i64) -> i64 {
    nd = nd_alloc(ND_VAR);
    store64(g_nd_name    + nd * 8, off);
    store64(g_nd_namelen + nd * 8, len);
    return nd;
}
func nd_strlit(sid: i64) -> i64 {
    nd = nd_alloc(ND_STR);
    store64(g_nd_ival + nd * 8, sid);
    return nd;
}
func nd_call1(noff: i64, nlen: i64, a: i64) -> i64 {
    nd = nd_alloc(ND_CALL);
    store64(g_nd_name    + nd * 8, noff);
    store64(g_nd_namelen + nd * 8, nlen);
    store64(g_nd_a + nd * 8, a);
    store64(g_nd_c + a  * 8, 0);
    return nd;
}
func nd_call2(noff: i64, nlen: i64, a: i64, b: i64) -> i64 {
    nd = nd_alloc(ND_CALL);
    store64(g_nd_name    + nd * 8, noff);
    store64(g_nd_namelen + nd * 8, nlen);
    store64(g_nd_a + nd * 8, a);     # first arg
    store64(g_nd_c + a  * 8, b);     # arg chain a -> b  (args link via g_nd_c)
    store64(g_nd_c + b  * 8, 0);     # b is last
    return nd;
}
func nd_binary(op: i64, a: i64, b: i64) -> i64 {
    nd = nd_alloc(ND_BINARY);
    store64(g_nd_ival + nd * 8, op);
    store64(g_nd_a    + nd * 8, a);
    store64(g_nd_b    + nd * 8, b);
    return nd;
}
func nd_assign(noff: i64, nlen: i64, val: i64) -> i64 {
    nd = nd_alloc(ST_ASSIGN);
    store64(g_nd_name    + nd * 8, noff);
    store64(g_nd_namelen + nd * 8, nlen);
    store64(g_nd_a + nd * 8, val);
    return nd;
}
func nd_exprstmt(e: i64) -> i64 {
    nd = nd_alloc(ST_EXPRSTMT);
    store64(g_nd_a + nd * 8, e);
    return nd;
}
func nd_return(e: i64) -> i64 {
    nd = nd_alloc(ST_RETURN);
    store64(g_nd_a + nd * 8, e);
    return nd;
}
# SC4: a single-arg `syscall 1, <expr>` (print) statement node.
func nd_syscall1(arg: i64) -> i64 {
    nd = nd_alloc(ST_SYSCALL);
    store64(g_nd_ival + nd * 8, 1);     # syscall #1 = print
    store64(g_nd_a    + nd * 8, arg);
    store64(g_nd_c    + arg * 8, 0);     # exactly one syscall arg
    return nd;
}

# ---- feature #4 helpers: typed-local table + load/store node builders ----
func nd_int(v: i64) -> i64 {
    nd = nd_alloc(ND_INT);
    store64(g_nd_ival + nd * 8, v);
    return nd;
}
func ldst_ensure() -> i64 {
    if load64(g_ld_done) == 1 { return 0; }
    store64(g_ld_off + 0*8, pool_intern(ld8_s,  strlen(ld8_s)));  store64(g_ld_len + 0*8, strlen(ld8_s));
    store64(g_ld_off + 1*8, pool_intern(ld16_s, strlen(ld16_s))); store64(g_ld_len + 1*8, strlen(ld16_s));
    store64(g_ld_off + 2*8, pool_intern(ld32_s, strlen(ld32_s))); store64(g_ld_len + 2*8, strlen(ld32_s));
    store64(g_ld_off + 3*8, pool_intern(ld64_s, strlen(ld64_s))); store64(g_ld_len + 3*8, strlen(ld64_s));
    store64(g_ld_off + 4*8, pool_intern(st8_s,  strlen(st8_s)));  store64(g_ld_len + 4*8, strlen(st8_s));
    store64(g_ld_off + 5*8, pool_intern(st16_s, strlen(st16_s))); store64(g_ld_len + 5*8, strlen(st16_s));
    store64(g_ld_off + 6*8, pool_intern(st32_s, strlen(st32_s))); store64(g_ld_len + 6*8, strlen(st32_s));
    store64(g_ld_off + 7*8, pool_intern(st64_s, strlen(st64_s))); store64(g_ld_len + 7*8, strlen(st64_s));
    store64(g_ld_done, 1);
    return 0;
}
func ldst_idx(w: i64, isstore: i64) -> i64 {
    k = 3;                 # default 8 -> load64
    if w == 1 { k = 0; }
    if w == 2 { k = 1; }
    if w == 4 { k = 2; }
    k = k + isstore * 4;
    return k;
}
func nd_load(w: i64, addr: i64) -> i64 {        # load{w}(addr)
    ldst_ensure();
    idx = ldst_idx(w, 0);
    return nd_call1(load64(g_ld_off + idx*8), load64(g_ld_len + idx*8), addr);
}
func nd_store(w: i64, addr: i64, val: i64) -> i64 {   # store{w}(addr, val)
    ldst_ensure();
    idx = ldst_idx(w, 1);
    return nd_call2(load64(g_ld_off + idx*8), load64(g_ld_len + idx*8), addr, val);
}
func lt_add(noff: i64, nlen: i64, kind: i64, aux: i64) -> i64 {
    i = load64(g_lt_count);
    if i >= 63 { return 0; }
    store64(g_lt_noff + i*8, noff);
    store64(g_lt_nlen + i*8, nlen);
    store64(g_lt_kind + i*8, kind);
    store64(g_lt_aux  + i*8, aux);
    store64(g_lt_sum  + i*8, load64(g_pt_sum));   # feature #5: sum index of a sum-typed local (else -1)
    store64(g_lt_count, i + 1);
    return 0;
}
func lt_find(noff: i64, nlen: i64) -> i64 {     # -> table index or -1
    n = load64(g_lt_count);
    i = 0;
    r = 0 - 1;
    while i < n {
        if par_pool_eq(noff, nlen, load64(g_lt_noff + i*8), load64(g_lt_nlen + i*8)) == 1 { r = i; }
        i = i + 1;
    }
    return r;
}
# seed a param's type: a struct-name type is dottable; a bare sum name is a sum scrutinee; else plain.
func lt_seed_param(noff: i64, nlen: i64, tyoff: i64, tylen: i64) -> i64 {
    si = par_struct_find(tyoff, tylen);
    store64(g_pt_sum, par_sum_find(tyoff, tylen));   # feature #5: lt_add records g_lt_sum from this
    if si != 0 - 1 { lt_add(noff, nlen, 1, si); }
    if si == 0 - 1 { lt_add(noff, nlen, 0, 0); }
    return 0;
}

# append a statement to the synthesized body (statements chain via g_nd_c)
func prompt_append(s: i64) -> i64 {
    if load64(g_pchain_first) == 0 { store64(g_pchain_first, s); }
    last = load64(g_pchain_last);
    if last != 0 { store64(g_nd_c + last * 8, s); }
    store64(g_pchain_last, s);
    store64(g_pchain_cnt, load64(g_pchain_cnt) + 1);
    return 0;
}
# add the two shared @DATA buffers once
func prompt_ensure_buffers() -> i64 {
    n = load64(g_dv_count);
    i = 0;
    while i < n {
        if par_name_is(load64(g_dv_name + i*8), load64(g_dv_namelen + i*8), pid_pbuild_s) == 1 { return 0; }
        i = i + 1;
    }
    prompt_ensure_ids();
    vi = load64(g_dv_count);
    store64(g_dv_name    + vi*8, load64(g_pid_pbuild));
    store64(g_dv_namelen + vi*8, strlen(pid_pbuild_s));
    store64(g_dv_type    + vi*8, DV_BUF);
    store64(g_dv_bufsize + vi*8, 16384);
    store64(g_dv_count, vi + 1);
    vi = vi + 1;
    store64(g_dv_name    + vi*8, load64(g_pid_preply));
    store64(g_dv_namelen + vi*8, strlen(pid_preply_s));
    store64(g_dv_type    + vi*8, DV_BUF);
    store64(g_dv_bufsize + vi*8, 65536);
    store64(g_dv_count, vi + 1);
    return 0;
}

func par_prompt() -> i64 {
    par_advance();   # consume the contextual 'prompt' identifier

    fi = load64(g_fn_count);
    if fi >= 511 { syscall 1, par_err_fn; return 0 - 1; }

    # name
    toff = par_cur_toff();
    tlen = par_cur_tlen();
    par_expect(TOK_IDENT);
    store64(g_fn_name    + fi * 8, toff);
    store64(g_fn_namelen + fi * 8, tlen);

    # params (record name + whether the hole substitutes as an integer)
    par_expect(TOK_LPAREN);
    np = 0;
    if par_peek() != TOK_RPAREN {
        going = 1;
        while going == 1 {
            if load64(g_perr) != 0 { going = 0; }   # F1/F2: bail on poison (par_expect stops advancing -> would spin)
            ptoff = par_cur_toff();
            ptlen = par_cur_tlen();
            par_expect(TOK_IDENT);
            par_expect(TOK_COLON);
            tytoff = par_cur_toff();
            tytlen = par_cur_tlen();
            par_expect(TOK_IDENT);
            store64(g_fn_params + fi * 128 + np * 16 + 0, ptoff);
            store64(g_fn_params + fi * 128 + np * 16 + 8, ptlen);
            isint = 0;
            if par_name_is(tytoff, tytlen, ty_i8)  == 1 { isint = 1; }
            if par_name_is(tytoff, tytlen, ty_i16) == 1 { isint = 1; }
            if par_name_is(tytoff, tytlen, ty_i32) == 1 { isint = 1; }
            if par_name_is(tytoff, tytlen, ty_i64) == 1 { isint = 1; }
            store64(g_prompt_pisint + np * 8, isint);
            np = np + 1;
            if par_peek() == TOK_COMMA { par_advance(); }
            if par_peek() == TOK_RPAREN { going = 0; }
            if par_peek() == TOK_ARROW  { going = 0; }   # F1/F2: '->' ends the param list, so a missing ')' heals AS ')' (not as a bogus IDENT)
            if par_peek() == TOK_END    { going = 0; }
        }
    }
    par_expect(TOK_RPAREN);
    store64(g_fn_nparams + fi * 8, np);

    # return type (str/ptr expected; recorded as metadata)
    par_expect(TOK_ARROW);
    rt = par_cur_toff();
    par_expect(TOK_IDENT);
    store64(g_fn_rettype + fi * 8, rt);

    # body = one template string literal
    par_expect(TOK_LBRACE);
    tmpl_off = par_cur_toff();
    tmpl_len = par_cur_tlen();
    par_expect(TOK_STR);
    par_expect(TOK_RBRACE);

    # split the template into literal segments + {param} holes ({{ }} -> literal braces)
    nseg = 0;
    nhole = 0;
    segoff = 0;
    i = 0;
    while i < tmpl_len {
        c = load8(g_str_pool + tmpl_off + i);
        nextc = 0;
        if i + 1 < tmpl_len { nextc = load8(g_str_pool + tmpl_off + i + 1); }
        if c == 123 {
            if nextc == 123 {
                store8(g_prompt_segbuf + segoff, 123);
                segoff = segoff + 1;
                i = i + 2;
            }
            if nextc != 123 {
                store64(g_prompt_segids + nseg * 8, str_intern(g_prompt_segbuf, segoff));
                nseg = nseg + 1;
                segoff = 0;
                j = i + 1;
                hstart = j;
                going2 = 1;
                while going2 == 1 {
                    if j >= tmpl_len { going2 = 0; }
                    if going2 == 1 {
                        if load8(g_str_pool + tmpl_off + j) == 125 { going2 = 0; }
                        if load8(g_str_pool + tmpl_off + j) != 125 { j = j + 1; }
                    }
                }
                holelen = j - hstart;
                hidx = 0 - 1;
                pp = 0;
                while pp < np {
                    if par_pool_eq(tmpl_off + hstart, holelen, load64(g_fn_params + fi*128 + pp*16 + 0), load64(g_fn_params + fi*128 + pp*16 + 8)) == 1 { hidx = pp; }
                    pp = pp + 1;
                }
                if hidx == 0 - 1 { syscall 1, prompt_err_hole; }
                store64(g_prompt_holes + nhole * 8, hidx);
                nhole = nhole + 1;
                i = j + 1;
            }
        }
        if c == 125 {
            store8(g_prompt_segbuf + segoff, 125);
            segoff = segoff + 1;
            if nextc == 125 { i = i + 2; }
            if nextc != 125 { i = i + 1; }
        }
        if c != 123 {
            if c != 125 {
                store8(g_prompt_segbuf + segoff, c);
                segoff = segoff + 1;
                i = i + 1;
            }
        }
    }
    store64(g_prompt_segids + nseg * 8, str_intern(g_prompt_segbuf, segoff));
    nseg = nseg + 1;

    prompt_ensure_buffers();
    prompt_ensure_ids();

    # synthesize the desugared body
    store64(g_pchain_first, 0);
    store64(g_pchain_last, 0);
    store64(g_pchain_cnt, 0);

    e_off = load64(g_pid_e);      e_len = strlen(pid_e_s);
    bld_off = load64(g_pid_pbuild); bld_len = strlen(pid_pbuild_s);
    rpl_off = load64(g_pid_preply); rpl_len = strlen(pid_preply_s);
    sc_off = load64(g_pid_strcpy);  sc_len = strlen(pid_strcpy_s);
    it_off = load64(g_pid_itoa);    it_len = strlen(pid_itoa_s);
    sl_off = load64(g_pid_strlen);  sl_len = strlen(pid_strlen_s);
    aq_off = load64(g_pid_airq);    aq_len = strlen(pid_airq_s);

    # e = str_copy(__prompt_build, seg0)
    prompt_append(nd_assign(e_off, e_len,
        nd_call2(sc_off, sc_len, nd_var(bld_off, bld_len), nd_strlit(load64(g_prompt_segids + 0)))));

    h = 0;
    while h < nhole {
        hidx = load64(g_prompt_holes + h * 8);
        pnoff = load64(g_fn_params + fi*128 + hidx*16 + 0);
        pnlen = load64(g_fn_params + fi*128 + hidx*16 + 8);
        if load64(g_prompt_pisint + hidx * 8) == 1 {
            # int_to_str(e, param) ; e = e + strlen(e)
            prompt_append(nd_exprstmt(nd_call2(it_off, it_len, nd_var(e_off,e_len), nd_var(pnoff,pnlen))));
            prompt_append(nd_assign(e_off, e_len,
                nd_binary(43, nd_var(e_off,e_len), nd_call1(sl_off, sl_len, nd_var(e_off,e_len)))));
        }
        if load64(g_prompt_pisint + hidx * 8) == 0 {
            # e = str_copy(e, param)
            prompt_append(nd_assign(e_off, e_len,
                nd_call2(sc_off, sc_len, nd_var(e_off,e_len), nd_var(pnoff,pnlen))));
        }
        # e = str_copy(e, seg[h+1])
        prompt_append(nd_assign(e_off, e_len,
            nd_call2(sc_off, sc_len, nd_var(e_off,e_len), nd_strlit(load64(g_prompt_segids + (h+1)*8)))));
        h = h + 1;
    }
    # ai_request(__prompt_build, __prompt_reply) ; return __prompt_reply
    prompt_append(nd_exprstmt(nd_call2(aq_off, aq_len, nd_var(bld_off,bld_len), nd_var(rpl_off,rpl_len))));
    prompt_append(nd_return(nd_var(rpl_off, rpl_len)));

    store64(g_fn_body      + fi * 8, load64(g_pchain_first));
    store64(g_fn_stmtcount + fi * 8, load64(g_pchain_cnt));
    store64(g_fn_count, fi + 1);
    return fi;
}

# ----------------------------------------------------------------
#  par_func() -> function index
# ----------------------------------------------------------------
func par_func() -> i64 {
    par_expect(TOK_KWFUNC);

    fi = load64(g_fn_count);
    if fi >= 511 { syscall 1, par_err_fn; return 0 - 1; }

    # function name
    toff = par_cur_toff();
    tlen = par_cur_tlen();
    par_expect(TOK_IDENT);
    store64(g_fn_name    + fi * 8, toff);
    store64(g_fn_namelen + fi * 8, tlen);

    # parameter list
    par_expect(TOK_LPAREN);
    np = 0;
    store64(g_lt_count, 0);                  # feature #4: reset the typed-local table for this body
    if par_peek() != TOK_RPAREN {
        going = 1;
        while going == 1 {
            if load64(g_perr) != 0 { going = 0; }   # F1/F2: bail on poison (par_expect stops advancing -> would spin)
            ptoff = par_cur_toff();
            ptlen = par_cur_tlen();
            par_expect(TOK_IDENT);
            par_expect(TOK_COLON);
            ftyoff = par_cur_toff();
            ftylen = par_cur_tlen();
            par_expect(TOK_IDENT);           # param type
            lt_seed_param(ptoff, ptlen, ftyoff, ftylen);   # feature #4: param dottable iff a struct name
            store64(g_fn_params + fi * 128 + np * 16 + 0, ptoff);
            store64(g_fn_params + fi * 128 + np * 16 + 8, ptlen);
            # f64 param? (a bare f64/f32 ident -- *f64 would be a pointer, i.e. an int address)
            pflt = 0;
            if par_name_is(ftyoff, ftylen, "f64") == 1 { pflt = 1; }
            if par_name_is(ftyoff, ftylen, "f32") == 1 { pflt = 1; }
            if np < 8 { store64(g_fn_pfloat + fi * 64 + np * 8, pflt); }
            np = np + 1;
            if par_peek() == TOK_COMMA { par_advance(); }
            if par_peek() == TOK_RPAREN { going = 0; }
            if par_peek() == TOK_ARROW  { going = 0; }   # F1/F2: '->' ends the param list, so a missing ')' heals AS ')' (not as a bogus IDENT)
            if par_peek() == TOK_END    { going = 0; }
        }
    }
    par_expect(TOK_RPAREN);
    store64(g_fn_nparams + fi * 8, np);

    # return type
    par_expect(TOK_ARROW);
    rt    = par_cur_toff();
    rtlen = par_cur_tlen();
    par_expect(TOK_IDENT);
    store64(g_fn_rettype + fi * 8, rt);
    rflt = 0;
    if par_name_is(rt, rtlen, "f64") == 1 { rflt = 1; }
    if par_name_is(rt, rtlen, "f32") == 1 { rflt = 1; }
    store64(g_fn_retfloat + fi * 8, rflt);

    # body
    par_expect(TOK_LBRACE);
    first_s = 0; last_s = 0; cnt_s = 0;
    while par_peek() != TOK_RBRACE {
        if par_peek() == TOK_END { par_expect(TOK_RBRACE); return 0 - 1; }
        if load64(g_perr) != 0 { return 0 - 1; }   # F1/F2: bail on poison
        s = par_stmt(fi);
        if first_s == 0 { first_s = s; }
        if last_s  != 0 { store64(g_nd_c + last_s * 8, s); }
        last_s = s; cnt_s = cnt_s + 1;
    }
    par_expect(TOK_RBRACE);

    store64(g_fn_body      + fi * 8, first_s);
    store64(g_fn_stmtcount + fi * 8, cnt_s);
    store64(g_fn_count, fi + 1);
    return fi;
}

# ----------------------------------------------------------------
#  par_const_expr() -> i64   --  @DATA compile-time const-expression
#  Self-contained recursive-descent evaluator: parses AND directly
#  evaluates an integer const-expr to i64 (no AST nodes). v1 supports
#  int/hex/char literals (all lex to TOK_INT), unary minus, parens, and
#  binary + - * / %  << >>  & ^ |  with C precedence. (const-NAME refs +
#  f64 const-exprs are deferred to v1.1.) Called from par_data.
#  Ladder (loose -> tight): | -> ^ -> & -> shift -> add -> mul -> unary.
# ----------------------------------------------------------------
func par_const_primary() -> i64 {
    k = par_peek();
    if k == TOK_LPAREN {
        par_advance();
        v = par_const_expr();
        par_expect(TOK_RPAREN);
        return v;
    }
    if k == TOK_INT {
        v = par_cur_ival();
        par_advance();
        return v;
    }
    # unexpected token in a const-expr: poison under --fix recover, else hard error
    if load64(g_recover) != 0 {
        if load64(g_perr) == 0 { store64(g_perr, 1); }
        return 0;
    }
    syscall 1, par_err_cexpr;
    ExitProcess(1);
    return 0;
}

func par_const_unary() -> i64 {
    k = par_peek();
    if k == TOK_MINUS { par_advance(); return 0 - par_const_unary(); }
    if k == TOK_PLUS  { par_advance(); return par_const_unary(); }
    return par_const_primary();
}

func par_const_mul() -> i64 {
    v = par_const_unary();
    going = 1;
    while going == 1 {
        k = par_peek();
        if k == TOK_STAR    { par_advance(); v = v * par_const_unary(); }
        if k == TOK_SLASH   { par_advance(); r = par_const_unary(); if r == 0 { v = 0; } if r != 0 { v = v / r; } }
        if k == TOK_PERCENT { par_advance(); r = par_const_unary(); if r == 0 { v = 0; } if r != 0 { v = v % r; } }
        if k != TOK_STAR { if k != TOK_SLASH { if k != TOK_PERCENT { going = 0; } } }
    }
    return v;
}

func par_const_add() -> i64 {
    v = par_const_mul();
    going = 1;
    while going == 1 {
        k = par_peek();
        if k == TOK_PLUS  { par_advance(); v = v + par_const_mul(); }
        if k == TOK_MINUS { par_advance(); v = v - par_const_mul(); }
        if k != TOK_PLUS { if k != TOK_MINUS { going = 0; } }
    }
    return v;
}

func par_const_shift() -> i64 {
    v = par_const_add();
    going = 1;
    while going == 1 {
        k = par_peek();
        if k == TOK_SHL { par_advance(); v = v << par_const_add(); }
        if k == TOK_SHR { par_advance(); v = v >> par_const_add(); }
        if k != TOK_SHL { if k != TOK_SHR { going = 0; } }
    }
    return v;
}

func par_const_bitand() -> i64 {
    v = par_const_shift();
    while par_peek() == TOK_AMP {
        par_advance();
        v = v & par_const_shift();
    }
    return v;
}

func par_const_bitxor() -> i64 {
    v = par_const_bitand();
    while par_peek() == TOK_CARET {
        par_advance();
        v = v ^ par_const_bitand();
    }
    return v;
}

func par_const_expr() -> i64 {
    v = par_const_bitxor();
    while par_peek() == TOK_PIPE {
        par_advance();
        v = v | par_const_bitxor();
    }
    return v;
}

# ----------------------------------------------------------------
#  par_data() -> 0
# ----------------------------------------------------------------
func par_data() -> i64 {
    while par_peek() == TOK_IDENT {
        if load64(g_perr) != 0 { return 0; }   # F1/F2: bail on poison
        vi = load64(g_dv_count);
        if vi >= 511 { syscall 1, par_err_dv; return 0 - 1; }

        ntoff = par_cur_toff();
        ntlen = par_cur_tlen();
        par_advance();

        par_expect(TOK_COLON);

        # type
        tytoff = par_cur_toff();
        tytlen = par_cur_tlen();
        par_expect(TOK_IDENT);

        # initialized integer array:  name: scalarType[N] = { cexpr, ... }
        # -> a read-only byte blob in .rdata (interned via the string path); the
        #    name evaluates to the blob's address (read with load*(name + i*w)).
        is_arr = 0;
        if par_peek() == TOK_LBRACKET {
            is_arr = 1;
            aw = 0;
            if par_name_is(tytoff, tytlen, "i8")  { aw = 1; }
            if par_name_is(tytoff, tytlen, "i16") { aw = 2; }
            if par_name_is(tytoff, tytlen, "i32") { aw = 4; }
            if par_name_is(tytoff, tytlen, "i64") { aw = 8; }
            if par_name_is(tytoff, tytlen, "ptr") { aw = 8; }
            if aw == 0 { syscall 1, par_err_arr; ExitProcess(1); }   # f64/struct arrays -> v1.1
            par_advance();                  # consume '['
            an = par_const_expr();          # element count N (const-expr)
            par_expect(TOK_RBRACKET);
            par_expect(TOK_ASSIGN);
            par_expect(TOK_LBRACE);
            if an * aw > 65500 { syscall 1, par_err_arr; ExitProcess(1); }   # blob must fit g_arr_scratch (64KB)
            bz = 0;                          # zero the blob region (C-style zero-fill of remainder)
            while bz < an * aw { store8(g_arr_scratch + bz, 0); bz = bz + 1; }
            ei = 0;
            while par_peek() != TOK_RBRACE {
                ev = par_const_expr();
                if ei >= an { syscall 1, par_err_arr; ExitProcess(1); }
                bk = 0;
                while bk < aw {
                    store8(g_arr_scratch + ei * aw + bk, ev & 255);
                    ev = ev >> 8;
                    bk = bk + 1;
                }
                ei = ei + 1;
                if par_peek() == TOK_COMMA { par_advance(); }
                else { if par_peek() != TOK_RBRACE { syscall 1, par_err_arr; ExitProcess(1); } }   # ',' required between elements
            }
            par_expect(TOK_RBRACE);
            sid = str_intern(g_arr_scratch, an * aw);
            store64(g_dv_name    + vi * 8, ntoff);
            store64(g_dv_namelen + vi * 8, ntlen);
            store64(g_dv_type    + vi * 8, DV_STR);
            store64(g_dv_strid   + vi * 8, sid);
        }
        if is_arr == 0 {
        par_expect(TOK_ASSIGN);

        # determine type code from pool text
        tc = DV_I64;
        c0 = load8(g_str_pool + tytoff);
        # "str" s=115 t=116 r=114  len=3
        if tytlen == 3 {
            c1 = load8(g_str_pool + tytoff + 1);
            c2 = load8(g_str_pool + tytoff + 2);
            if c0 == 115 { if c1 == 116 { if c2 == 114 { tc = DV_STR; } } }
            # "buf" b=98 u=117 f=102
            if c0 == 98  { if c1 == 117 { if c2 == 102 { tc = DV_BUF; } } }
            # "ptr" p=112 t=116 r=114
            if c0 == 112 { if c1 == 116 { if c2 == 114 { tc = DV_PTR; } } }
            # "i64" i=105 6=54 4=52
            if c0 == 105 { if c1 == 54  { if c2 == 52  { tc = DV_I64; } } }
            # "i32" i=105 3=51 2=50
            if c0 == 105 { if c1 == 51  { if c2 == 50  { tc = DV_I32; } } }
            # "i16" i=105 1=49 6=54
            if c0 == 105 { if c1 == 49  { if c2 == 54  { tc = DV_I16; } } }
            # "f64" f=102 6=54 4=52
            if c0 == 102 { if c1 == 54  { if c2 == 52  { tc = DV_F64; } } }
            # "f32" f=102 3=51 2=50
            if c0 == 102 { if c1 == 51  { if c2 == 50  { tc = DV_F32; } } }
            # "i8"  only len=2
        }
        if tytlen == 2 {
            c1 = load8(g_str_pool + tytoff + 1);
            if c0 == 105 { if c1 == 56 { tc = DV_I8; } }   # "i8"
        }

        store64(g_dv_name    + vi * 8, ntoff);
        store64(g_dv_namelen + vi * 8, ntlen);
        store64(g_dv_type    + vi * 8, tc);

        if tc == DV_STR {
            stoff = par_cur_toff();
            stlen = par_cur_tlen();
            par_expect(TOK_STR);
            sid = str_intern(g_str_pool + stoff, stlen);
            store64(g_dv_strid + vi * 8, sid);
        }
        if tc == DV_BUF {
            # buf size is an integer literal OR sizeof(Typespec).
            # (The bootstrap folds a const-expr here; network.ancl uses
            #  buf = sizeof(Ring) to size its ring arenas. par_typesize
            #  handles struct names, scalars, and T[N] arrays.)
            if par_peek() == TOK_IDENT {
                par_advance();              # consume 'sizeof'
                par_expect(TOK_LPAREN);
                bufsz = par_typesize();
                par_expect(TOK_RPAREN);
            } else {
                bufsz = par_const_expr();
            }
            store64(g_dv_bufsize + vi * 8, bufsz);
        }
        if tc != DV_STR {
            if tc != DV_BUF {
                isfl = 0;
                if tc == DV_F64 { isfl = 1; }
                if tc == DV_F32 { isfl = 1; }
                if isfl == 1 {
                    # f64/f32 const: a float literal carries IEEE-754 bits; an int literal converts
                    if par_peek() == TOK_FLOAT {
                        store64(g_dv_ival + vi * 8, par_cur_ival());
                        par_advance();
                    } else {
                        store64(g_dv_ival + vi * 8, lex_f64_bits(par_cur_ival(), 0));
                        par_expect(TOK_INT);
                    }
                    store64(g_dv_isfloat + vi * 8, 1);
                } else {
                    # integer constant -- a compile-time const-expression now
                    # (int/hex/char literals, unary minus, parens, and
                    #  + - * / %  << >>  & ^ |  with C precedence)
                    ival2 = par_const_expr();
                    store64(g_dv_ival + vi * 8, ival2);
                }
            }
        }
        }

        par_expect(TOK_SEMI);
        store64(g_dv_count, vi + 1);
    }
    return 0;
}

# ----------------------------------------------------------------
#  par_extern_decl() -> 0
# ----------------------------------------------------------------
func par_extern_decl() -> i64 {
    par_expect(TOK_KWEXTERN);
    # dll name as string
    dlltoff = par_cur_toff();
    dlltlen = par_cur_tlen();
    par_expect(TOK_STR);

    going = 1;
    while going == 1 {
        if load64(g_perr) != 0 { going = 0; }   # F1/F2: bail on poison (par_expect stops advancing -> would spin)
        ei = load64(g_ext_count);
        if ei >= 255 { syscall 1, par_err_ext; return 0 - 1; }

        fntoff = par_cur_toff();
        fntlen = par_cur_tlen();
        par_expect(TOK_IDENT);

        is_ptr = 0;
        ext_fl = 0;
        if par_peek() == TOK_ARROW {
            par_advance();
            rtoff = par_cur_toff();
            rtlen = par_cur_tlen();
            par_expect(TOK_IDENT);   # return type
            is_ptr = 1;              # -> ptr/i64/f64 all keep the full 64-bit return (no sign-extend)
            if par_name_is(rtoff, rtlen, "f64") == 1 { ext_fl = 1; }
            if par_name_is(rtoff, rtlen, "f32") == 1 { ext_fl = 1; }
        }

        store64(g_ext_fn     + ei * 8, fntoff);
        store64(g_ext_fnlen  + ei * 8, fntlen);
        store64(g_ext_dll    + ei * 8, dlltoff);
        store64(g_ext_dlllen + ei * 8, dlltlen);
        store64(g_ext_ptr    + ei * 8, is_ptr);
        store64(g_ext_float  + ei * 8, ext_fl);
        store64(g_ext_count, ei + 1);

        if par_peek() == TOK_COMMA { par_advance(); }
        if par_peek() != TOK_IDENT { going = 0; }
    }
    par_expect(TOK_SEMI);
    return 0;
}

# ----------------------------------------------------------------
#  par_struct_decl() -> 0
#  Parses  struct Name { field: type; ... }  recording the layout
#  (field byte offsets + total size) into the g_struct_*/g_field_*
#  tables.  Mirrors anclc.cpp parseStruct: per-field alignment, and
#  total size rounded up to 8 (min 8).
# ----------------------------------------------------------------
func par_struct_decl() -> i64 {
    par_expect(TOK_KWSTRUCT);

    si = load64(g_struct_count);
    if si >= 63 { syscall 1, par_err_struct; ExitProcess(1); }

    ntoff = par_cur_toff();
    ntlen = par_cur_tlen();
    par_expect(TOK_IDENT);

    par_expect(TOK_LBRACE);

    ffield = load64(g_field_count);
    off    = 0;
    nf     = 0;

    # forward-register the struct NAME before parsing fields, so a self-referential
    # `next: *Self` field resolves as a struct pointer (kind 1) for v1.1 chaining.
    # Size/nfields are provisional (0) here and finalized after the loop; a *Self
    # field is 8 bytes regardless, so the layout is unaffected (mirrors anclc.cpp).
    store64(g_struct_name    + si * 8, ntoff);
    store64(g_struct_namelen + si * 8, ntlen);
    store64(g_struct_ffield  + si * 8, ffield);
    store64(g_struct_size    + si * 8, 0);
    store64(g_struct_nfields + si * 8, 0);
    store64(g_struct_count, si + 1);

    while par_peek() == TOK_IDENT {
        if load64(g_perr) != 0 { return 0; }   # F1/F2: bail on poison
        ftoff = par_cur_toff();
        ftlen = par_cur_tlen();
        par_advance();
        par_expect(TOK_COLON);

        sz = par_typesize();
        al = load64(g_par_typealign);
        off = par_align_up(off, al);

        fi = load64(g_field_count);
        if fi >= 511 { syscall 1, par_err_struct; ExitProcess(1); }
        store64(g_field_name    + fi * 8, ftoff);
        store64(g_field_namelen + fi * 8, ftlen);
        store64(g_field_off     + fi * 8, off);
        store64(g_field_width   + fi * 8, load64(g_pt_width));    # feature #4: p.field width / address
        store64(g_field_isaddr  + fi * 8, load64(g_pt_isaddr));
        store64(g_field_kind    + fi * 8, load64(g_pt_kind));     # feature #4 v1.1: result type for chaining
        store64(g_field_aux     + fi * 8, load64(g_pt_aux));
        store64(g_field_count, fi + 1);

        off = off + sz;
        nf  = nf + 1;

        # field separator: ';' or ',' (either accepted, like the C++ reference)
        if par_peek() == TOK_SEMI  { par_advance(); }
        else { if par_peek() == TOK_COMMA { par_advance(); } }
    }

    par_expect(TOK_RBRACE);

    total = par_align_up(off, 8);
    if total == 0 { total = 8; }

    # finalize the forward-registered struct (name/ffield/count set before the loop)
    store64(g_struct_size    + si * 8, total);
    store64(g_struct_nfields + si * 8, nf);
    return 0;
}

# ----------------------------------------------------------------
#  feature #5: par_sum() -> 0   (sum Name { Variant(f: T,...), Empty, ... })
#  records the layout (tag@0, payload@8) + synthesizes a maker fn per variant.
# ----------------------------------------------------------------
func sum_emit_maker(vi: i64, block: i64) -> i64 {
    fi = load64(g_fn_count);
    if fi >= 511 { syscall 1, par_err_fn; return 0 - 1; }
    store64(g_fn_name    + fi*8, load64(g_var_makeroff + vi*8));
    store64(g_fn_namelen + fi*8, load64(g_var_makerlen + vi*8));
    ffield = load64(g_var_ffield  + vi*8);
    nf     = load64(g_var_nfields + vi*8);
    np = 0;
    while np < nf {
        store64(g_fn_params + fi*128 + np*16 + 0, load64(g_vf_name    + (ffield+np)*8));
        store64(g_fn_params + fi*128 + np*16 + 8, load64(g_vf_namelen + (ffield+np)*8));
        np = np + 1;
    }
    store64(g_fn_nparams + fi*8, nf);
    store64(g_fn_rettype + fi*8, 0);                 # write-only metadata (codegen ignores it)
    # body:  __p = alloc(block); store64(__p, tag); store{w}(__p+off, field)...; return __p;
    store64(g_pchain_first, 0); store64(g_pchain_last, 0); store64(g_pchain_cnt, 0);
    poff = load64(g_id_p_off); plen = load64(g_id_p_len);
    prompt_append(nd_assign(poff, plen, nd_call1(load64(g_id_alloc_off), load64(g_id_alloc_len), nd_int(block))));
    prompt_append(nd_exprstmt(nd_store(8, nd_var(poff, plen), nd_int(load64(g_var_tag + vi*8)))));
    np = 0;
    while np < nf {
        prompt_append(nd_exprstmt(nd_store(load64(g_vf_width + (ffield+np)*8),
            nd_binary(43, nd_var(poff, plen), nd_int(load64(g_vf_off + (ffield+np)*8))),
            nd_var(load64(g_vf_name + (ffield+np)*8), load64(g_vf_namelen + (ffield+np)*8)))));
        np = np + 1;
    }
    prompt_append(nd_return(nd_var(poff, plen)));
    store64(g_fn_body      + fi*8, load64(g_pchain_first));
    store64(g_fn_stmtcount + fi*8, load64(g_pchain_cnt));
    store64(g_fn_count, fi + 1);
    return 0;
}
func par_sum() -> i64 {
    par_advance();                                   # consume 'sum' (contextual ident)
    sum_ensure_ids();
    ldst_ensure();                                   # makers use store{w} nodes

    si = load64(g_sum_count);
    soff = par_cur_toff(); slen = par_cur_tlen();
    par_expect(TOK_IDENT);
    par_expect(TOK_LBRACE);

    fvar = load64(g_var_count);
    # forward-register the sum name (self-referential payloads resolve)
    store64(g_sum_name    + si*8, soff);
    store64(g_sum_namelen + si*8, slen);
    store64(g_sum_fvar    + si*8, fvar);
    store64(g_sum_block   + si*8, 8);
    store64(g_sum_nvar    + si*8, 0);
    store64(g_sum_count, si + 1);

    maxend = 8; tag = 0;
    while par_peek() == TOK_IDENT {
        if load64(g_perr) != 0 { return 0; }   # F1/F2: bail on poison
        vi = load64(g_var_count);
        voff = par_cur_toff(); vlen = par_cur_tlen();
        par_advance();
        ffield = load64(g_vf_count);
        off = 8; nf = 0;
        if par_peek() == TOK_LPAREN {
            par_advance();
            if par_peek() != TOK_RPAREN {
                going = 1;
                while going == 1 {
                    if load64(g_perr) != 0 { going = 0; }   # F1/F2: bail on poison (uniformity w/ the other going-loops)
                    fnoff = par_cur_toff(); fnlen = par_cur_tlen();
                    par_expect(TOK_IDENT);
                    par_expect(TOK_COLON);
                    sz = par_typesize();
                    off = par_align_up(off, load64(g_par_typealign));
                    vf = load64(g_vf_count);
                    store64(g_vf_name    + vf*8, fnoff);
                    store64(g_vf_namelen + vf*8, fnlen);
                    store64(g_vf_off     + vf*8, off);
                    store64(g_vf_width   + vf*8, load64(g_pt_width));
                    store64(g_vf_count, vf + 1);
                    off = off + sz; nf = nf + 1;
                    if par_peek() == TOK_COMMA { par_advance(); }
                    else { going = 0; }
                    if par_peek() == TOK_RPAREN { going = 0; }
                }
            }
            par_expect(TOK_RPAREN);
        }
        if off > maxend { maxend = off; }
        store64(g_var_name    + vi*8, voff);
        store64(g_var_namelen + vi*8, vlen);
        store64(g_var_tag     + vi*8, tag);
        store64(g_var_ffield  + vi*8, ffield);
        store64(g_var_nfields + vi*8, nf);
        sum_build_maker_name(vi, soff, slen, voff, vlen);
        store64(g_var_count, vi + 1);
        tag = tag + 1;
        if par_peek() == TOK_COMMA { par_advance(); }    # optional variant separator
    }
    par_expect(TOK_RBRACE);

    block = par_align_up(maxend, 8);
    if block < 8 { block = 8; }
    store64(g_sum_block + si*8, block);
    store64(g_sum_nvar  + si*8, tag);

    v = 0;                                           # synthesize a maker per variant (block size now known)
    while v < tag {
        sum_emit_maker(fvar + v, block);
        v = v + 1;
    }
    return 0;
}

# ----------------------------------------------------------------
#  feature #5: `match` desugar -> nested if/else-if chain in `if 1 { ... }`.
#  Recursive over arms (each level owns its locals -> nesting-safe), building
#  `if (disc==cmp) { body } else { rest }` from the front; the `_` arm's body
#  becomes the terminal else. sum-mode dispatches on load64(scrut) (the tag) and
#  binds variant fields; int-mode dispatches on the scrutinee variable's value.
# ----------------------------------------------------------------
func par_match_arm(fn_idx: i64, soff: i64, slen: i64, summode: i64, smidx: i64) -> i64 {
    if par_peek() == TOK_RBRACE { return 0; }
    if par_peek() == TOK_END    { return 0; }

    isdef = 0; cmpval = 0; var_idx = 0 - 1;
    bind_head = 0; bind_last = 0;

    if par_peek() == TOK_IDENT {
        if par_name_is(par_cur_toff(), par_cur_tlen(), "_") == 1 { isdef = 1; par_advance(); }
    }
    if isdef == 0 {
        if summode == 1 {
            vnoff = par_cur_toff(); vnlen = par_cur_tlen();
            par_expect(TOK_IDENT);
            var_idx = par_variant_find(smidx, vnoff, vnlen);
            if var_idx == 0 - 1 { syscall 1, sum_err_var; ExitProcess(1); }
            cmpval = load64(g_var_tag + var_idx * 8);
            nbind = 0;
            if par_peek() == TOK_LPAREN {
                par_advance();
                if par_peek() != TOK_RPAREN {
                    going = 1;
                    while going == 1 {
                        if load64(g_perr) != 0 { going = 0; }   # F1/F2: bail on poison (uniformity w/ the other going-loops)
                        boff = par_cur_toff(); blen = par_cur_tlen();
                        par_expect(TOK_IDENT);
                        vfi = load64(g_var_ffield + var_idx * 8) + nbind;
                        bstmt = nd_assign(boff, blen, nd_load(load64(g_vf_width + vfi*8), nd_binary(43, nd_var(soff, slen), nd_int(load64(g_vf_off + vfi*8)))));
                        if bind_head == 0 { bind_head = bstmt; }
                        if bind_last != 0 { store64(g_nd_c + bind_last * 8, bstmt); }
                        bind_last = bstmt;
                        nbind = nbind + 1;
                        if par_peek() == TOK_COMMA { par_advance(); }
                        else { going = 0; }
                        if par_peek() == TOK_RPAREN { going = 0; }
                    }
                }
                par_expect(TOK_RPAREN);
            }
        }
        if summode == 0 {
            cmpval = par_cur_ival();          # int-match: integer-literal pattern
            par_expect(TOK_INT);
        }
    }

    par_expect(TOK_FATARROW);
    par_expect(TOK_LBRACE);
    head = bind_head; last = bind_last;       # body = bindings ++ block statements
    while par_peek() != TOK_RBRACE {
        if par_peek() == TOK_END { return head; }
        if load64(g_perr) != 0 { return head; }   # F1/F2: bail on poison
        bs = par_stmt(fn_idx);
        if head == 0 { head = bs; }
        if last != 0 { store64(g_nd_c + last * 8, bs); }
        last = bs;
    }
    par_expect(TOK_RBRACE);
    if last != 0 { store64(g_nd_c + last * 8, 0); }     # terminate the body chain
    if par_peek() == TOK_COMMA { par_advance(); }       # optional arm separator

    if isdef == 1 { return head; }                      # default body = the terminal else

    rest = par_match_arm(fn_idx, soff, slen, summode, smidx);
    ifnd = nd_alloc(ST_IF);
    disc = nd_var(soff, slen);
    if summode == 1 { disc = nd_load(8, nd_var(soff, slen)); }   # load64(scrut) = tag
    store64(g_nd_a    + ifnd * 8, nd_binary(101, disc, nd_int(cmpval)));   # 101 = 'e' (==)
    store64(g_nd_b    + ifnd * 8, head);
    store64(g_nd_ival + ifnd * 8, 0);
    store64(g_nd_name + ifnd * 8, rest);                # else-branch head
    return ifnd;
}
func par_match(fn_idx: i64) -> i64 {
    ldst_ensure();
    soff = par_cur_toff(); slen = par_cur_tlen();       # scrutinee identifier
    par_advance();
    par_expect(TOK_LBRACE);
    summode = 0; smidx = 0 - 1;
    li = lt_find(soff, slen);
    if li != 0 - 1 {
        if load64(g_lt_sum + li * 8) != 0 - 1 { summode = 1; smidx = load64(g_lt_sum + li * 8); }
    }
    head = par_match_arm(fn_idx, soff, slen, summode, smidx);
    par_expect(TOK_RBRACE);
    wrap = nd_alloc(ST_IF);                              # `if 1 { â€¦desugarâ€¦ }` (one Stmt carries it all)
    store64(g_nd_a    + wrap * 8, nd_int(1));
    store64(g_nd_b    + wrap * 8, head);
    store64(g_nd_ival + wrap * 8, 0);
    store64(g_nd_name + wrap * 8, 0);
    return wrap;
}

# ----------------------------------------------------------------
#  SC4: the `intent` oracle (L3). Contextual top-level keyword.
#    intent NAME { goal: "..."; case fn(args) => expected; ... }
#  Desugars (ZERO codegen change) into a synthetic checker __intent_NAME()
#  that returns the 1-based index of the first failing case (0 = all pass),
#  printing "intent NAME case K: expected E got A" on the first failure.
#  Mirrors compiler/anclc.cpp parseIntent(); the goal string is parsed but
#  not emitted (compile-time metadata for the AI repair driver).
# ----------------------------------------------------------------
func par_intent() -> i64 {
    par_advance();                            # consume 'intent'
    inoff = par_cur_toff(); inlen = par_cur_tlen();
    par_expect(TOK_IDENT);                    # intent name
    par_expect(TOK_LBRACE);
    par_expect(TOK_IDENT);                    # 'goal' (contextual; not strictly verified)
    par_expect(TOK_COLON);
    par_expect(TOK_STR);                      # goal string literal (metadata; discarded)
    par_expect(TOK_SEMI);

    # build "__intent_<name>" into scratch, intern as the checker function name
    o = 0;
    pl = strlen(int_pre_s);
    i = 0; while i < pl    { store8(g_int_scratch + o, load8(int_pre_s + i));        o = o + 1; i = i + 1; }
    i = 0; while i < inlen { store8(g_int_scratch + o, load8(g_str_pool + inoff + i)); o = o + 1; i = i + 1; }
    fnoff = pool_intern(g_int_scratch, o);
    fnlen = o;

    # interned-once temp-local names + the counterexample string-literal pieces
    aoff = pool_intern(int_a_s, strlen(int_a_s)); alen = strlen(int_a_s);
    eoff = pool_intern(int_e_s, strlen(int_e_s)); elen = strlen(int_e_s);
    nsid = str_intern(g_str_pool + inoff, inlen);   # the bare intent name
    sid0 = str_intern(ce_s0, strlen(ce_s0));        # "intent "
    sid1 = str_intern(ce_s1, strlen(ce_s1));        # " case "
    sid2 = str_intern(ce_s2, strlen(ce_s2));        # ": expected "
    sid3 = str_intern(ce_s3, strlen(ce_s3));        # " got "
    sidn = str_intern(ce_nl, strlen(ce_nl));        # "\n"

    # synthesize the checker function shell
    fi = load64(g_fn_count);
    if fi >= 511 { syscall 1, par_err_fn; return 0 - 1; }
    store64(g_fn_name     + fi * 8, fnoff);
    store64(g_fn_namelen  + fi * 8, fnlen);
    store64(g_fn_nparams  + fi * 8, 0);
    store64(g_fn_rettype  + fi * 8, pool_intern(int_rt_s, strlen(int_rt_s)));
    store64(g_fn_retfloat + fi * 8, 0);

    first_s = 0; last_s = 0; cnt_s = 0; caseno = 0;
    going = 1;
    while going == 1 {
        if load64(g_perr) != 0 { going = 0; }   # F1/F2: bail on poison
        if par_peek() == TOK_RBRACE { going = 0; }
        if par_peek() == TOK_END    { going = 0; }
        if going == 1 {
            par_expect(TOK_IDENT);                # 'case'
            cfoff = par_cur_toff(); cflen = par_cur_tlen();
            par_expect(TOK_IDENT);                # function name
            par_expect(TOK_LPAREN);
            # call node: fn(args)
            callnd = nd_alloc(ND_CALL);
            store64(g_nd_name    + callnd * 8, cfoff);
            store64(g_nd_namelen + callnd * 8, cflen);
            first_arg = 0; last_arg = 0;
            if par_peek() != TOK_RPAREN {
                ag = 1;
                while ag == 1 {
                    if load64(g_perr) != 0 { ag = 0; }   # F1/F2: bail on poison (uniformity w/ the other going-loops)
                    arg = par_expr();
                    if first_arg == 0 { first_arg = arg; }
                    if last_arg  != 0 { store64(g_nd_c + last_arg * 8, arg); }
                    last_arg = arg;
                    if par_peek() == TOK_COMMA { par_advance(); } else { ag = 0; }
                    if par_peek() == TOK_RPAREN { ag = 0; }
                }
            }
            if last_arg != 0 { store64(g_nd_c + last_arg * 8, 0); }
            store64(g_nd_a + callnd * 8, first_arg);
            par_expect(TOK_RPAREN);
            par_expect(TOK_FATARROW);
            expnode = par_expr();                 # expected value expression
            par_expect(TOK_SEMI);
            caseno = caseno + 1;

            # __a = fn(args);  __e = expected;  if __a != __e { print counterexample; return K }
            s1 = nd_assign(aoff, alen, callnd);
            s2 = nd_assign(eoff, elen, expnode);
            ifnd = nd_alloc(ST_IF);
            store64(g_nd_a    + ifnd * 8, nd_binary(110, nd_var(aoff, alen), nd_var(eoff, elen)));  # __a != __e
            store64(g_nd_name + ifnd * 8, 0);     # no else
            store64(g_nd_ival + ifnd * 8, 0);
            p0 = nd_syscall1(nd_strlit(sid0));    # "intent "
            p1 = nd_syscall1(nd_strlit(nsid));    # NAME
            p2 = nd_syscall1(nd_strlit(sid1));    # " case "
            p3 = nd_syscall1(nd_int(caseno));     # K
            p4 = nd_syscall1(nd_strlit(sid2));    # ": expected "
            p5 = nd_syscall1(nd_var(eoff, elen)); # E (= __e)
            p6 = nd_syscall1(nd_strlit(sid3));    # " got "
            p7 = nd_syscall1(nd_var(aoff, alen)); # A (= __a)
            p8 = nd_syscall1(nd_strlit(sidn));    # "\n"
            pr = nd_return(nd_int(caseno));
            store64(g_nd_c + p0 * 8, p1);  store64(g_nd_c + p1 * 8, p2);
            store64(g_nd_c + p2 * 8, p3);  store64(g_nd_c + p3 * 8, p4);
            store64(g_nd_c + p4 * 8, p5);  store64(g_nd_c + p5 * 8, p6);
            store64(g_nd_c + p6 * 8, p7);  store64(g_nd_c + p7 * 8, p8);
            store64(g_nd_c + p8 * 8, pr);  store64(g_nd_c + pr * 8, 0);
            store64(g_nd_b + ifnd * 8, p0);       # then-head

            # append s1 -> s2 -> ifnd to the checker body
            if first_s == 0 { first_s = s1; }
            if last_s  != 0 { store64(g_nd_c + last_s * 8, s1); }
            store64(g_nd_c + s1 * 8, s2);
            store64(g_nd_c + s2 * 8, ifnd);
            last_s = ifnd; cnt_s = cnt_s + 3;
        }
    }
    par_expect(TOK_RBRACE);

    # final `return 0` (all cases passed)
    rfin = nd_return(nd_int(0));
    if first_s == 0 { first_s = rfin; }
    if last_s  != 0 { store64(g_nd_c + last_s * 8, rfin); }
    store64(g_nd_c + rfin * 8, 0);
    cnt_s = cnt_s + 1;

    store64(g_fn_body      + fi * 8, first_s);
    store64(g_fn_stmtcount + fi * 8, cnt_s);
    store64(g_fn_count, fi + 1);

    # record the checker for --check
    ii = load64(g_intent_count);
    store64(g_intent_off + ii * 8, fnoff);
    store64(g_intent_len + ii * 8, fnlen);
    store64(g_intent_count, ii + 1);
    return 0;
}

# ----------------------------------------------------------------
#  SC4 --check: synthesize a fresh `main` that runs every intent checker and
#  returns the first non-zero failing-case ordinal (0 = all pass). Appended
#  last, so cg_emit_start (which picks the LAST `main`) makes it the entry,
#  shadowing any user main -- matching the bootstrap's "replaces any main".
# ----------------------------------------------------------------
func par_check_runner() -> i64 {
    roff = pool_intern(int_r_s, strlen(int_r_s)); rlen = strlen(int_r_s);
    sidok = str_intern(ce_ok, strlen(ce_ok));      # "all intents OK\n"

    fi = load64(g_fn_count);
    if fi >= 511 { syscall 1, par_err_fn; return 0 - 1; }
    store64(g_fn_name     + fi * 8, pool_intern(int_main_s, strlen(int_main_s)));
    store64(g_fn_namelen  + fi * 8, strlen(int_main_s));
    store64(g_fn_nparams  + fi * 8, 0);
    store64(g_fn_rettype  + fi * 8, pool_intern(int_rt_s, strlen(int_rt_s)));
    store64(g_fn_retfloat + fi * 8, 0);

    first_s = 0; last_s = 0; cnt_s = 0;
    n = load64(g_intent_count); i = 0;
    while i < n {
        # r = __intent_X()
        callnd = nd_alloc(ND_CALL);
        store64(g_nd_name    + callnd * 8, load64(g_intent_off + i * 8));
        store64(g_nd_namelen + callnd * 8, load64(g_intent_len + i * 8));
        store64(g_nd_a       + callnd * 8, 0);     # zero args
        s1 = nd_assign(roff, rlen, callnd);
        # if r != 0 { return r }
        ifnd = nd_alloc(ST_IF);
        store64(g_nd_a    + ifnd * 8, nd_binary(110, nd_var(roff, rlen), nd_int(0)));
        store64(g_nd_name + ifnd * 8, 0);
        store64(g_nd_ival + ifnd * 8, 0);
        rr = nd_return(nd_var(roff, rlen));
        store64(g_nd_c + rr * 8, 0);
        store64(g_nd_b + ifnd * 8, rr);
        if first_s == 0 { first_s = s1; }
        if last_s  != 0 { store64(g_nd_c + last_s * 8, s1); }
        store64(g_nd_c + s1 * 8, ifnd);
        last_s = ifnd; cnt_s = cnt_s + 2;
        i = i + 1;
    }
    # syscall 1, "all intents OK\n";  return 0
    sok  = nd_syscall1(nd_strlit(sidok));
    rfin = nd_return(nd_int(0));
    store64(g_nd_c + sok * 8, rfin);
    store64(g_nd_c + rfin * 8, 0);
    if first_s == 0 { first_s = sok; }
    if last_s  != 0 { store64(g_nd_c + last_s * 8, sok); }
    cnt_s = cnt_s + 2;

    store64(g_fn_body      + fi * 8, first_s);
    store64(g_fn_stmtcount + fi * 8, cnt_s);
    store64(g_fn_count, fi + 1);
    return 0;
}

# ----------------------------------------------------------------
#  par_program() -> 0
#  Top-level: parses @DATA, @CODE, func, extern, import sections.
# ----------------------------------------------------------------
func par_program() -> i64 {
    going = 1;
    while going == 1 {
        if load64(g_perr) != 0 { going = 0; }   # F1/F2: detection point -- stop, the --fix driver handles it
        k = par_peek();
        if k == TOK_END { going = 0; }
        if k == TOK_KWDATA {
            par_advance();
            par_data();
        }
        if k == TOK_KWCODE {
            par_advance();
            going2 = 1;
            while going2 == 1 {
                if load64(g_perr) != 0 { going2 = 0; }   # F1/F2: bail on poison
                pk = par_peek();
                if pk == TOK_KWFUNC { par_func(); }
                if pk == TOK_KWTOOL { par_tool(); }
                if pk != TOK_KWFUNC { if pk != TOK_KWTOOL { going2 = 0; } }
            }
        }
        if k == TOK_KWFUNC { par_func(); }
        if k == TOK_KWTOOL { par_tool(); }
        # 'prompt' is a CONTEXTUAL keyword: a bare top-level identifier is only valid if it is
        # 'prompt' (a prompt declaration); anything else ends the program. Capture the verdict
        # BEFORE par_prompt advances the cursor.
        if k == TOK_IDENT {
            is_prompt = par_name_is(par_cur_toff(), par_cur_tlen(), prompt_kw);
            is_sum    = par_name_is(par_cur_toff(), par_cur_tlen(), sum_kw);   # feature #5 (contextual)
            is_intent = par_name_is(par_cur_toff(), par_cur_tlen(), intent_kw); # SC4 (contextual)
            if is_prompt == 1 { par_prompt(); }
            if is_sum == 1 { par_sum(); }
            if is_intent == 1 { par_intent(); }
            if is_prompt == 0 { if is_sum == 0 { if is_intent == 0 { going = 0; } } }
        }
        if k == TOK_KWEXTERN { par_extern_decl(); }
        if k == TOK_KWIMPORT {
            par_advance();
            par_advance();   # skip the string path
            par_accept(TOK_SEMI);
        }
        if k == TOK_KWSTRUCT {
            par_struct_decl();
        }
        if k == TOK_END    { going = 0; }
        if k != TOK_KWDATA  {
            if k != TOK_KWCODE  {
                if k != TOK_KWFUNC  {
                    if k != TOK_KWTOOL {
                        if k != TOK_IDENT {      # TOK_IDENT already handled above (prompt or stop)
                            if k != TOK_KWEXTERN {
                                if k != TOK_KWIMPORT {
                                    if k != TOK_KWSTRUCT {
                                        if k != TOK_END { going = 0; }
                                    }
                                }
                            }
                        }
                    }
                }
            }
        }
    }
    return 0;
}
# ===================== END parser.ancl =====================

# ===================== BEGIN emit.ancl =====================
# =====================================================================
#  emit.ancl  -  x86-64 byte emitter for anclc2
#
#  Emits raw machine code bytes into g_code[], tracks labels and
#  relocation fixups that are resolved later by the PE writer.
#
#  Fixup kinds:
#    0 = rel32 to label   (branch / call within .text)
#    1 = rip-relative to .rdata string (by string id)
#    2 = rip-relative to .data buffer (by data offset)
#    3 = rip-relative to IAT slot (by import index)
# =====================================================================

@DATA

# --- Code buffer (1 MB; the self-host output is ~184 KB of code) ---
g_code:     buf = 1048576;
g_code_len: buf = 8;

# --- Label table: g_labels[id] = code offset, or -1 if unplaced (16384 entries) ---
g_labels:      buf = 131072;
g_label_count: buf = 8;

# --- Fixup tables (16384 entries each) ---
g_fixup_pos:   buf = 131072;
g_fixup_kind:  buf = 131072;
g_fixup_tgt:   buf = 131072;
g_fixup_count: buf = 8;

# --- Register constants ---
EM_RAX: i64 = 0;
EM_RCX: i64 = 1;
EM_RDX: i64 = 2;
EM_RBX: i64 = 3;
EM_RSP: i64 = 4;
EM_RBP: i64 = 5;
EM_RSI: i64 = 6;
EM_RDI: i64 = 7;
EM_R8:  i64 = 8;
EM_R9:  i64 = 9;
EM_R10: i64 = 10;
EM_R11: i64 = 11;
EM_R12: i64 = 12;
EM_R13: i64 = 13;
EM_R14: i64 = 14;
EM_R15: i64 = 15;

@CODE

# ----------------------------------------------------------------
#  em_b(v) -- emit one byte
# ----------------------------------------------------------------
func em_b(v: i64) -> i64 {
    off = load64(g_code_len);
    store8(g_code + off, v);
    store64(g_code_len, off + 1);
    return 0;
}

# ----------------------------------------------------------------
#  em_d32(v) -- emit 4 bytes little-endian
# ----------------------------------------------------------------
func em_d32(v: i64) -> i64 {
    em_b(v        % 256);
    em_b(shr(v,  8) % 256);
    em_b(shr(v, 16) % 256);
    em_b(shr(v, 24) % 256);
    return 0;
}

# ----------------------------------------------------------------
#  em_d64(v) -- emit 8 bytes little-endian
# ----------------------------------------------------------------
func em_d64(v: i64) -> i64 {
    em_b(v        % 256);
    em_b(shr(v,  8) % 256);
    em_b(shr(v, 16) % 256);
    em_b(shr(v, 24) % 256);
    em_b(shr(v, 32) % 256);
    em_b(shr(v, 40) % 256);
    em_b(shr(v, 48) % 256);
    em_b(shr(v, 56) % 256);
    return 0;
}

# ----------------------------------------------------------------
#  em_rex(W, R, X, B)  -- REX prefix
# ----------------------------------------------------------------
func em_rex(W: i64, R: i64, X: i64, B: i64) -> i64 {
    v = 64 + shl(W,3) + shl(R,2) + shl(X,1) + B;
    em_b(v);
    return 0;
}

# ----------------------------------------------------------------
#  em_mem_operand(reg_field, base, disp)
#  Emits ModRM + optional SIB + disp32 for [base+disp] (mod=10)
# ----------------------------------------------------------------
func em_mem_operand(reg_field: i64, base: i64, disp: i64) -> i64 {
    rm = base % 8;
    em_b(128 + shl(band(reg_field,7), 3) + rm);
    if rm == 4 { em_b(36); }   # SIB byte for RSP/R12 base
    em_d32(disp);
    return 0;
}

# ----------------------------------------------------------------
#  em_label_new() -> label id
# ----------------------------------------------------------------
func em_label_new() -> i64 {
    id = load64(g_label_count);
    store64(g_labels + id * 8, 0 - 1);   # -1 = unplaced
    store64(g_label_count, id + 1);
    return id;
}

# ----------------------------------------------------------------
#  em_label_place(id)  -- set label position = current code offset
# ----------------------------------------------------------------
func em_label_place(id: i64) -> i64 {
    off = load64(g_code_len);
    store64(g_labels + id * 8, off);
    return 0;
}

# ----------------------------------------------------------------
#  em_fixup(kind, tgt)  -- record a fixup at current pos, emit 4 zero bytes
# ----------------------------------------------------------------
func em_fixup(kind: i64, tgt: i64) -> i64 {
    fi = load64(g_fixup_count);
    pos = load64(g_code_len);
    store64(g_fixup_pos  + fi * 8, pos);
    store64(g_fixup_kind + fi * 8, kind);
    store64(g_fixup_tgt  + fi * 8, tgt);
    store64(g_fixup_count, fi + 1);
    em_d32(0);
    return 0;
}

# ----------------------------------------------------------------
#  em_mov_ri(r, imm)   movabs r64, imm64
# ----------------------------------------------------------------
func em_mov_ri(r: i64, imm: i64) -> i64 {
    b_ext = 0;
    if r >= 8 { b_ext = 1; }
    em_rex(1, 0, 0, b_ext);
    em_b(184 + band(r, 7));   # 0xB8 + reg
    em_d64(imm);
    return 0;
}

# ----------------------------------------------------------------
#  em_mov_rr(dst, src)   mov r64, r64
# ----------------------------------------------------------------
func em_mov_rr(dst: i64, src: i64) -> i64 {
    r_ext = 0; b_ext = 0;
    if src >= 8 { r_ext = 1; }
    if dst >= 8 { b_ext = 1; }
    em_rex(1, r_ext, 0, b_ext);
    em_b(137);   # 0x89  MOV r/m64, r64
    em_b(192 + shl(band(src,7), 3) + band(dst,7));
    return 0;
}

# ----------------------------------------------------------------
#  em_mov_rm(dst, base, disp)   mov r64,[base+disp]
# ----------------------------------------------------------------
func em_mov_rm(dst: i64, base: i64, disp: i64) -> i64 {
    r_ext = 0; b_ext = 0;
    if dst  >= 8 { r_ext = 1; }
    if base >= 8 { b_ext = 1; }
    em_rex(1, r_ext, 0, b_ext);
    em_b(139);   # 0x8B  MOV r64,r/m64
    em_mem_operand(dst, base, disp);
    return 0;
}

# ----------------------------------------------------------------
#  em_mov_mr(base, disp, src)   mov [base+disp],r64
# ----------------------------------------------------------------
func em_mov_mr(base: i64, disp: i64, src: i64) -> i64 {
    r_ext = 0; b_ext = 0;
    if src  >= 8 { r_ext = 1; }
    if base >= 8 { b_ext = 1; }
    em_rex(1, r_ext, 0, b_ext);
    em_b(137);   # 0x89  MOV r/m64,r64
    em_mem_operand(src, base, disp);
    return 0;
}

# ----------------------------------------------------------------
#  em_mov_mr8(base, disp, src)   mov byte[base+disp],r8
# ----------------------------------------------------------------
func em_mov_mr8(base: i64, disp: i64, src: i64) -> i64 {
    if base >= 8 { em_rex(0, 0, 0, 1); }
    if src  >= 8 { em_rex(0, 1, 0, 0); }
    em_b(136);   # 0x88
    em_mem_operand(src, base, disp);
    return 0;
}

# ----------------------------------------------------------------
#  em_movzx_rm8(dst, base, disp)   movzx r64,byte[base+disp]
# ----------------------------------------------------------------
func em_movzx_rm8(dst: i64, base: i64, disp: i64) -> i64 {
    r_ext = 0; b_ext = 0;
    if dst  >= 8 { r_ext = 1; }
    if base >= 8 { b_ext = 1; }
    em_rex(1, r_ext, 0, b_ext);
    em_b(15); em_b(182);   # 0x0F 0xB6
    em_mem_operand(dst, base, disp);
    return 0;
}

# ----------------------------------------------------------------
#  em_lea_mem(dst, base, disp)   lea r64,[base+disp]
# ----------------------------------------------------------------
func em_lea_mem(dst: i64, base: i64, disp: i64) -> i64 {
    r_ext = 0; b_ext = 0;
    if dst  >= 8 { r_ext = 1; }
    if base >= 8 { b_ext = 1; }
    em_rex(1, r_ext, 0, b_ext);
    em_b(141);   # 0x8D  LEA
    em_mem_operand(dst, base, disp);
    return 0;
}

# ----------------------------------------------------------------
#  em_lea_rip(dst, kind, tgt)  lea r64,[rip+disp32]  + fixup
# ----------------------------------------------------------------
func em_lea_rip(dst: i64, kind: i64, tgt: i64) -> i64 {
    r_ext = 0;
    if dst >= 8 { r_ext = 1; }
    em_rex(1, r_ext, 0, 0);
    em_b(141);   # 0x8D  LEA
    em_b(shl(band(dst,7), 3) + 5);   # mod=00 rm=101 (RIP-relative)
    em_fixup(kind, tgt);
    return 0;
}

# ----------------------------------------------------------------
#  em_mov_rip_load(dst, kind, tgt)  mov r64,[rip+disp32]  + fixup
# ----------------------------------------------------------------
func em_mov_rip_load(dst: i64, kind: i64, tgt: i64) -> i64 {
    r_ext = 0;
    if dst >= 8 { r_ext = 1; }
    em_rex(1, r_ext, 0, 0);
    em_b(139);   # 0x8B  MOV r64,r/m64
    em_b(shl(band(dst,7), 3) + 5);   # mod=00 rm=101
    em_fixup(kind, tgt);
    return 0;
}

# ----------------------------------------------------------------
#  em_mov_rip_store(src, kind, tgt)  mov [rip+disp32],r64  + fixup
# ----------------------------------------------------------------
func em_mov_rip_store(src: i64, kind: i64, tgt: i64) -> i64 {
    r_ext = 0;
    if src >= 8 { r_ext = 1; }
    em_rex(1, r_ext, 0, 0);
    em_b(137);   # 0x89  MOV r/m64,r64
    em_b(shl(band(src,7), 3) + 5);   # mod=00 rm=101
    em_fixup(kind, tgt);
    return 0;
}

# ----------------------------------------------------------------
#  ALU reg,reg
# ----------------------------------------------------------------
func em_add_rr(d: i64, s: i64) -> i64 {
    r_ext = 0; b_ext = 0;
    if s >= 8 { r_ext = 1; } if d >= 8 { b_ext = 1; }
    em_rex(1,r_ext,0,b_ext); em_b(1);   # ADD r/m64,r64
    em_b(192 + shl(band(s,7),3) + band(d,7));
    return 0;
}
func em_sub_rr(d: i64, s: i64) -> i64 {
    r_ext = 0; b_ext = 0;
    if s >= 8 { r_ext = 1; } if d >= 8 { b_ext = 1; }
    em_rex(1,r_ext,0,b_ext); em_b(41);  # SUB r/m64,r64
    em_b(192 + shl(band(s,7),3) + band(d,7));
    return 0;
}
func em_and_rr(d: i64, s: i64) -> i64 {
    r_ext = 0; b_ext = 0;
    if s >= 8 { r_ext = 1; } if d >= 8 { b_ext = 1; }
    em_rex(1,r_ext,0,b_ext); em_b(33);  # AND r/m64,r64
    em_b(192 + shl(band(s,7),3) + band(d,7));
    return 0;
}
func em_or_rr(d: i64, s: i64) -> i64 {
    r_ext = 0; b_ext = 0;
    if s >= 8 { r_ext = 1; } if d >= 8 { b_ext = 1; }
    em_rex(1,r_ext,0,b_ext); em_b(9);   # OR r/m64,r64
    em_b(192 + shl(band(s,7),3) + band(d,7));
    return 0;
}
func em_xor_rr(d: i64, s: i64) -> i64 {
    r_ext = 0; b_ext = 0;
    if s >= 8 { r_ext = 1; } if d >= 8 { b_ext = 1; }
    em_rex(1,r_ext,0,b_ext); em_b(49);  # XOR r/m64,r64
    em_b(192 + shl(band(s,7),3) + band(d,7));
    return 0;
}
func em_cmp_rr(a: i64, b: i64) -> i64 {
    r_ext = 0; b_ext = 0;
    if b >= 8 { r_ext = 1; } if a >= 8 { b_ext = 1; }
    em_rex(1,r_ext,0,b_ext); em_b(57);  # CMP r/m64,r64
    em_b(192 + shl(band(b,7),3) + band(a,7));
    return 0;
}
func em_test_rr(a: i64, b: i64) -> i64 {
    r_ext = 0; b_ext = 0;
    if b >= 8 { r_ext = 1; } if a >= 8 { b_ext = 1; }
    em_rex(1,r_ext,0,b_ext); em_b(133); # TEST r/m64,r64
    em_b(192 + shl(band(b,7),3) + band(a,7));
    return 0;
}
func em_imul_rr(d: i64, s: i64) -> i64 {
    r_ext = 0; b_ext = 0;
    if d >= 8 { r_ext = 1; } if s >= 8 { b_ext = 1; }
    em_rex(1,r_ext,0,b_ext); em_b(15); em_b(175); # IMUL r64,r/m64
    em_b(192 + shl(band(d,7),3) + band(s,7));
    return 0;
}

# ----------------------------------------------------------------
#  ALU reg,imm32  (0x81 group)
# ----------------------------------------------------------------
func em_grp1_ri(ext: i64, r: i64, imm: i64) -> i64 {
    b_ext = 0; if r >= 8 { b_ext = 1; }
    em_rex(1, 0, 0, b_ext);
    em_b(129);   # 0x81
    em_b(192 + shl(ext,3) + band(r,7));
    em_d32(imm);
    return 0;
}
func em_add_ri(r: i64, imm: i64) -> i64 { return em_grp1_ri(0, r, imm); }
func em_sub_ri(r: i64, imm: i64) -> i64 { return em_grp1_ri(5, r, imm); }
func em_cmp_ri(r: i64, imm: i64) -> i64 { return em_grp1_ri(7, r, imm); }

# ----------------------------------------------------------------
#  Unary ops
# ----------------------------------------------------------------
func em_neg(r: i64) -> i64 {
    b_ext = 0; if r >= 8 { b_ext = 1; }
    em_rex(1,0,0,b_ext); em_b(247); em_b(192 + shl(3,3) + band(r,7));
    return 0;
}
func em_cqo() -> i64 {
    em_rex(1,0,0,0); em_b(153); return 0;
}
func em_idiv(r: i64) -> i64 {
    b_ext = 0; if r >= 8 { b_ext = 1; }
    em_rex(1,0,0,b_ext); em_b(247); em_b(192 + shl(7,3) + band(r,7));
    return 0;
}
func em_shl_cl(r: i64) -> i64 {
    b_ext = 0; if r >= 8 { b_ext = 1; }
    em_rex(1,0,0,b_ext); em_b(211); em_b(192 + shl(4,3) + band(r,7));
    return 0;
}
func em_shr_cl(r: i64) -> i64 {
    b_ext = 0; if r >= 8 { b_ext = 1; }
    em_rex(1,0,0,b_ext); em_b(211); em_b(192 + shl(5,3) + band(r,7));
    return 0;
}

# ----------------------------------------------------------------
#  setcc al + movzx rax,al
#    cc codes: sete=0x94  setne=0x95  setl=0x9C  setle=0x9E
#              setg=0x9F  setge=0x9D  setns=0x99
# ----------------------------------------------------------------
func em_setcc(cc: i64) -> i64 {
    em_b(15); em_b(cc); em_b(192);         # setcc al  (rm=al)
    em_rex(1,0,0,0); em_b(15); em_b(182); em_b(192);  # movzx rax,al
    return 0;
}

# ----------------------------------------------------------------
#  Jumps (rel32)
# ----------------------------------------------------------------
func em_jmp(label: i64) -> i64 {
    em_b(233); em_fixup(0, label); return 0;
}
func em_jcc(cc: i64, label: i64) -> i64 {
    em_b(15); em_b(cc); em_fixup(0, label); return 0;
}
func em_je(l: i64)  -> i64 { return em_jcc(132, l); }
func em_jne(l: i64) -> i64 { return em_jcc(133, l); }
func em_jz(l: i64)  -> i64 { return em_jcc(132, l); }
func em_jnz(l: i64) -> i64 { return em_jcc(133, l); }
func em_jl(l: i64)  -> i64 { return em_jcc(140, l); }
func em_jg(l: i64)  -> i64 { return em_jcc(143, l); }
func em_jge(l: i64) -> i64 { return em_jcc(141, l); }
func em_jle(l: i64) -> i64 { return em_jcc(142, l); }
func em_jns(l: i64) -> i64 { return em_jcc(137, l); }

# ----------------------------------------------------------------
#  Calls
# ----------------------------------------------------------------
func em_call_label(label: i64) -> i64 {
    em_b(232); em_fixup(0, label); return 0;
}
func em_call_import(idx: i64) -> i64 {
    em_b(255); em_b(21); em_fixup(3, idx); return 0;
}
# --target=linux-dyn only: indirect call through the .got.plt slot for a dynamic (libc/.so) import,
# resolved by ld.so at load under BIND_NOW. FF 15 rip-relative + fixup kind 4 (elf_write_dyn resolves
# it to the GOT slot). Same byte shape as em_call_import; only the fixup kind differs. Never emitted
# for PE / static ELF, so the anclc3==anclc4 and Linux fixpoints are untouched.
func em_call_dynimport(idx: i64) -> i64 {
    em_b(255); em_b(21); em_fixup(4, idx); return 0;
}
func em_call_rax() -> i64 {
    em_b(255); em_b(208); return 0;
}

# ----------------------------------------------------------------
#  syscall  (Linux x86-64, 0F 05; clobbers RCX + R11)
#  Only ever emitted from targetLinux-gated codegen, so the Windows
#  byte stream is untouched.
# ----------------------------------------------------------------
func em_syscall() -> i64 {
    em_b(15); em_b(5); return 0;
}

# ----------------------------------------------------------------
#  RET
# ----------------------------------------------------------------
func em_ret() -> i64 {
    em_b(195); return 0;
}

# ----------------------------------------------------------------
#  movsxd rax,eax   (sign-extend 32-bit return to 64)
# ----------------------------------------------------------------
func em_movsxd_rax() -> i64 {
    em_rex(1,0,0,0); em_b(99); em_b(192); return 0;
}

# ----------------------------------------------------------------
#  zext_eax  -- zero-extend rax = just write eax to itself
#              mov eax,eax  (implicit zero-extends)
# ----------------------------------------------------------------
func em_zext_eax() -> i64 {
    em_b(137); em_b(192); return 0;
}

# ----------------------------------------------------------------
#  SSE2 scalar-double (f64) instructions
#  Mirror the bootstrap anclc.cpp sse_rr/movsd/cvt/movq encoders.
#  Layout: [mandatory prefix 66/F2] [REX (W=1 for cvt/movq; else only if
#  a register >=8)] 0F [opcode] [ModRM].  XMM regs are numbered 0..15 just
#  like GP regs; the codegen only ever uses xmm0/xmm1.
# ----------------------------------------------------------------
#  reg<-reg SSE: prefix 0F op  ModRM(11 xd xs).  REX (W=0) only if xd|xs>=8.
func em_sse_rr(pre: i64, op: i64, xd: i64, xs: i64) -> i64 {
    em_b(pre);
    rr = 0; bb = 0; need = 0;
    if xd >= 8 { rr = 1; need = 1; }
    if xs >= 8 { bb = 1; need = 1; }
    if need == 1 { em_rex(0, rr, 0, bb); }
    em_b(15); em_b(op);
    em_b(192 + shl(band(xd,7),3) + band(xs,7));
    return 0;
}
func em_addsd(xd: i64, xs: i64)  -> i64 { return em_sse_rr(242, 88, xd, xs); }  # F2 0F 58
func em_subsd(xd: i64, xs: i64)  -> i64 { return em_sse_rr(242, 92, xd, xs); }  # F2 0F 5C
func em_mulsd(xd: i64, xs: i64)  -> i64 { return em_sse_rr(242, 89, xd, xs); }  # F2 0F 59
func em_divsd(xd: i64, xs: i64)  -> i64 { return em_sse_rr(242, 94, xd, xs); }  # F2 0F 5E
func em_sqrtsd(xd: i64, xs: i64) -> i64 { return em_sse_rr(242, 81, xd, xs); }  # F2 0F 51
func em_ucomisd(xd: i64, xs: i64)-> i64 { return em_sse_rr(102, 46, xd, xs); }  # 66 0F 2E
func em_movsd_xx(xd: i64, xs: i64)-> i64 { return em_sse_rr(242, 16, xd, xs); } # F2 0F 10 (xmm<-xmm)

#  movsd xmm, [base+disp]   F2 0F 10  (load an f64 from a stack slot)
func em_movsd_xm(xd: i64, base: i64, disp: i64) -> i64 {
    em_b(242);
    rr = 0; bb = 0; need = 0;
    if xd   >= 8 { rr = 1; need = 1; }
    if base >= 8 { bb = 1; need = 1; }
    if need == 1 { em_rex(0, rr, 0, bb); }
    em_b(15); em_b(16);                # 0F 10
    em_mem_operand(xd, base, disp);
    return 0;
}
#  movsd [base+disp], xmm   F2 0F 11  (store an f64 to a stack slot)
func em_movsd_mx(base: i64, disp: i64, xs: i64) -> i64 {
    em_b(242);
    rr = 0; bb = 0; need = 0;
    if xs   >= 8 { rr = 1; need = 1; }
    if base >= 8 { bb = 1; need = 1; }
    if need == 1 { em_rex(0, rr, 0, bb); }
    em_b(15); em_b(17);                # 0F 11
    em_mem_operand(xs, base, disp);
    return 0;
}
#  cvtsi2sd xmm, r64   F2 REX.W 0F 2A   (int -> f64 promote)
func em_cvtsi2sd(xd: i64, gs: i64) -> i64 {
    em_b(242);
    rr = 0; bb = 0;
    if xd >= 8 { rr = 1; }
    if gs >= 8 { bb = 1; }
    em_rex(1, rr, 0, bb);
    em_b(15); em_b(42);                # 0F 2A
    em_b(192 + shl(band(xd,7),3) + band(gs,7));
    return 0;
}
#  cvttsd2si r64, xmm   F2 REX.W 0F 2C  (f64 -> int truncate)
func em_cvttsd2si(gd: i64, xs: i64) -> i64 {
    em_b(242);
    rr = 0; bb = 0;
    if gd >= 8 { rr = 1; }
    if xs >= 8 { bb = 1; }
    em_rex(1, rr, 0, bb);
    em_b(15); em_b(44);                # 0F 2C
    em_b(192 + shl(band(gd,7),3) + band(xs,7));
    return 0;
}
#  movq xmm, r64   66 REX.W 0F 6E   (load f64 bits from a GP reg into XMM)
func em_movq_xr(xd: i64, gs: i64) -> i64 {
    em_b(102);                         # 66
    rr = 0; bb = 0;
    if xd >= 8 { rr = 1; }
    if gs >= 8 { bb = 1; }
    em_rex(1, rr, 0, bb);
    em_b(15); em_b(110);               # 0F 6E
    em_b(192 + shl(band(xd,7),3) + band(gs,7));
    return 0;
}
#  movq r64, xmm   66 REX.W 0F 7E   (extract f64 bits from XMM into a GP reg)
func em_movq_rx(gd: i64, xs: i64) -> i64 {
    em_b(102);                         # 66
    rr = 0; bb = 0;
    if xs >= 8 { rr = 1; }
    if gd >= 8 { bb = 1; }
    em_rex(1, rr, 0, bb);
    em_b(15); em_b(126);               # 0F 7E
    em_b(192 + shl(band(xs,7),3) + band(gd,7));
    return 0;
}

# ----------------------------------------------------------------
#  em_init() -- reset emitter state
# ----------------------------------------------------------------
func em_init() -> i64 {
    store64(g_code_len,    0);
    store64(g_label_count, 0);
    store64(g_fixup_count, 0);
    return 0;
}
# ===================== END emit.ancl =====================

# ===================== BEGIN codegen.ancl =====================
# =====================================================================
#  codegen.ancl  -  Code generation for anclc2
#
#  Walks the flat AST built by parser.ancl and emits x86-64 into the
#  g_code buffer via emit.ancl.  Also emits the runtime helper routines
#  (print_str, print_int, getch, etc.) that the generated code calls.
#
#  Import order: lexer.ancl -> parser.ancl -> emit.ancl -> codegen.ancl
# =====================================================================

@DATA

# --- Import table: flat list of (fn_name_pool_off, dll_name) pairs ---
g_imp_fn:    buf = 4096;   # i64[512] - pool offset of function name
g_imp_fnlen: buf = 4096;   # i64[512] - length of function name
g_imp_dll:   buf = 4096;   # i64[512] - pool offset of dll name
g_imp_dlllen:buf = 4096;   # i64[512] - length of dll name
g_imp_count: buf = 8;

# Fixed IAT slot indices (runtime helpers depend on these being first)
IMP_GetStdHandle:  i64 = 0;
IMP_WriteFile:     i64 = 1;
IMP_ReadFile:      i64 = 2;
IMP_ExitProcess:   i64 = 3;

# --- Per-function code generation state ---
g_cg_frame_n:       buf = 8;
g_cg_frame_argbase: buf = 8;
g_cg_scratch_base:  buf = 8;
g_cg_scratch_top:   buf = 8;
g_cg_ret_label:     buf = 8;
g_cg_ret_float:     buf = 8;     # 1 if the current function returns f64 (Return converges to XMM0)
g_cg_is_gui:        buf = 8;
g_cg_data_size:     buf = 8;

# --- f64 float-stamping pass state ---
# Per-function "float local" name set (rebuilt for each function); seeded from
# float params and grown by inference (an assignment with a float RHS).  512 names max.
g_sf_off:   buf = 4096;
g_sf_len:   buf = 4096;
g_sf_count: buf = 8;

# Local variable table: name pool offset + frame offset (2048 entries; no
# overflow guard in cg_local_alloc, so sized well above any single function)
g_cg_loc_name:  buf = 16384;   # i64[2048] - pool offset
g_cg_loc_len:   buf = 16384;   # i64[2048] - name length
g_cg_loc_off:   buf = 16384;   # i64[2048] - frame offset from RSP
g_cg_loc_count: buf = 8;

# Loop stack for break/continue (32 levels deep)
g_loop_cont:  buf = 256;   # i64[32] - continue label
g_loop_brk:   buf = 256;   # i64[32] - break label
g_loop_depth: buf = 8;

# Function label table
g_fn_label:    buf = 4096;   # i64[512] - label id per function (raised 256->512 for the Linux self-host)
g_fn_arity:    buf = 4096;   # i64[512] - param count per function

# --- Runtime helper label IDs ---
L_start:       buf = 8;
L_print_str:   buf = 8;
L_print_int:   buf = 8;
L_getch:       buf = 8;
L_read_char:   buf = 8;
L_read_int:    buf = 8;
L_int_to_str:  buf = 8;
L_puts_cstr:   buf = 8;
L_str_to_int:  buf = 8;
L_str_copy:    buf = 8;
L_memcpy:      buf = 8;
L_memset:      buf = 8;
L_strlen:      buf = 8;
L_strcmp:      buf = 8;

# .data layout constants
DAT_INBUF:  i64 = 0;
DAT_INLEN:  i64 = 256;
DAT_INPOS:  i64 = 264;
DAT_BASE:   i64 = 272;
# DAT_ARGV aliases DAT_BASE (272): Linux-only slot holding the entry rsp (argc/argv).
# Reserved at [272,280) ONLY under --target=linux; the Windows .data layout is unchanged.
DAT_ARGV:   i64 = 272;
# Target selection (set by main.ancl before cg_run). 0 = Windows PE (default, fixpoint-preserving);
# 1 = Linux static ELF via raw syscalls. Every Linux codegen branch is `if load64(g_targetlinux)==1`.
g_targetlinux:      buf = 8;
# --target=linux-dyn: additionally emit a DYNAMIC ELF (dlopen/dlsym via .rela.plt/GOT under BIND_NOW).
# Implies g_targetlinux. Inert (0) for PE and plain --target=linux -> their fixpoints stay byte-identical.
g_targetlinuxdyn:   buf = 8;
# dynamic imports (dlopen/dlsym/...) -- parallel to the g_imp_* IAT table; resolved by ld.so via .got.plt.
# Each entry records the fn name + its extern soname (DT_NEEDED), both as g_str_pool offsets.
g_dynimp_fn:        buf = 1024;   # g_str_pool offset of each dyn import fn name (128 slots)
g_dynimp_fnlen:     buf = 1024;
g_dynimp_so:        buf = 1024;   # g_str_pool offset of the soname
g_dynimp_solen:     buf = 1024;
g_dynimp_count:     buf = 8;
cg_err_syscall_win: str = "[cg] syscall(...) requires --target=linux\n";
cg_err_argv_win:    str = "[cg] __argv_base() requires --target=linux\n";
cg_err_no_shim:     str = "[cg] --target=linux: Windows import with no Linux shim\n";

# --- String table for intern'd dll/fn names used by importer ---
# We store pool offsets for known built-in dlls
cg_k32:    str = "kernel32.dll";
cg_ws2:    str = "ws2_32.dll";
cg_u32:    str = "user32.dll";

# Error strings
cg_err_imp: str = "[cg] import table full\n";
cg_err_loc: str = "[cg] local table full\n";

@CODE

# ----------------------------------------------------------------
#  cg_pool_cmp(off_a, len_a, off_b, len_b) -> 1 if equal
#  Compares two names stored in g_str_pool
# ----------------------------------------------------------------
func cg_pool_cmp(oa: i64, la: i64, ob: i64, lb: i64) -> i64 {
    if la != lb { return 0; }
    i = 0;
    while i < la {
        if load8(g_str_pool + oa + i) != load8(g_str_pool + ob + i) { return 0; }
        i = i + 1;
    }
    return 1;
}

# ----------------------------------------------------------------
#  cg_str_eq_lit(pool_off, pool_len, literal_ptr, lit_len) -> 1 if equal
#  Compares pool text against an ANCL str constant (which is also
#  stored as pool text after being interned by the lexer)
# ----------------------------------------------------------------
func cg_name_is(pool_off: i64, pool_len: i64, lit: i64, lit_len: i64) -> i64 {
    if pool_len != lit_len { return 0; }
    return strcmp(g_str_pool + pool_off, lit) == 0;
}

# ----------------------------------------------------------------
#  cg_fname_is(name_off, name_len, lit) -> 1 if equal, else 0
#  Length-aware comparison of a (NON null-terminated) pool name
#  slice against a null-terminated C-string literal.  Does not rely
#  on the pool slice being null-terminated -- the lexer stores
#  identifier tokens back-to-back in g_str_pool with no separators,
#  so plain strcmp would over-read past the name and mis-compare.
# ----------------------------------------------------------------
func cg_fname_is(name_off: i64, name_len: i64, lit: i64) -> i64 {
    i = 0;
    while i < name_len {
        if load8(lit + i) == 0 { return 0; }   # literal is shorter than name
        if load8(g_str_pool + name_off + i) != load8(lit + i) { return 0; }
        i = i + 1;
    }
    if load8(lit + name_len) != 0 { return 0; }   # literal is longer than name
    return 1;
}

# ----------------------------------------------------------------
#  cg_use_import(fn_off, fn_len, dll_off, dll_len) -> IAT index
#  Returns existing slot or allocates a new one.
# ----------------------------------------------------------------
func cg_use_import(fn_off: i64, fn_len: i64, dll_off: i64, dll_len: i64) -> i64 {
    n = load64(g_imp_count);
    i = 0;
    while i < n {
        if cg_pool_cmp(load64(g_imp_fn + i*8), load64(g_imp_fnlen + i*8), fn_off, fn_len) == 1 {
            return i;
        }
        i = i + 1;
    }
    # not found - add new
    if n >= 511 { syscall 1, cg_err_imp; return 0; }
    store64(g_imp_fn     + n*8, fn_off);
    store64(g_imp_fnlen  + n*8, fn_len);
    store64(g_imp_dll    + n*8, dll_off);
    store64(g_imp_dlllen + n*8, dll_len);
    store64(g_imp_count, n + 1);
    return n;
}

# ----------------------------------------------------------------
#  cg_local_slot(name_off, name_len) -> frame offset or -1
# ----------------------------------------------------------------
func cg_local_slot(name_off: i64, name_len: i64) -> i64 {
    n = load64(g_cg_loc_count);
    i = 0;
    while i < n {
        if cg_pool_cmp(load64(g_cg_loc_name + i*8), load64(g_cg_loc_len + i*8), name_off, name_len) == 1 {
            return load64(g_cg_loc_off + i*8);
        }
        i = i + 1;
    }
    return 0 - 1;
}

# ----------------------------------------------------------------
#  cg_local_alloc(name_off, name_len) -> frame offset
#  Allocates a new local variable slot in the current frame.
# ----------------------------------------------------------------
func cg_local_alloc(name_off: i64, name_len: i64) -> i64 {
    n   = load64(g_cg_loc_count);
    off = load64(g_cg_frame_argbase) + n * 8;
    store64(g_cg_loc_name + n*8, name_off);
    store64(g_cg_loc_len  + n*8, name_len);
    store64(g_cg_loc_off  + n*8, off);
    store64(g_cg_loc_count, n + 1);
    return off;
}

# ----------------------------------------------------------------
#  cg_alloc_scratch() -> scratch slot frame offset
# ----------------------------------------------------------------
func cg_alloc_scratch() -> i64 {
    top  = load64(g_cg_scratch_top);
    base = load64(g_cg_scratch_base);
    off  = base + top * 8;
    store64(g_cg_scratch_top, top + 1);
    return off;
}

func cg_free_scratch(n: i64) -> i64 {
    top = load64(g_cg_scratch_top);
    store64(g_cg_scratch_top, top - n);
    return 0;
}

# ----------------------------------------------------------------
#  cg_dv_find(name_off, name_len) -> data-var index or -1
# ----------------------------------------------------------------
func cg_dv_find(name_off: i64, name_len: i64) -> i64 {
    n = load64(g_dv_count);
    i = 0;
    while i < n {
        if cg_pool_cmp(load64(g_dv_name + i*8), load64(g_dv_namelen + i*8), name_off, name_len) == 1 {
            return i;
        }
        i = i + 1;
    }
    return 0 - 1;
}

# ----------------------------------------------------------------
#  cg_fn_find(name_off, name_len) -> function index or -1
# ----------------------------------------------------------------
func cg_fn_find(name_off: i64, name_len: i64) -> i64 {
    n = load64(g_fn_count);
    i = 0;
    while i < n {
        if cg_pool_cmp(load64(g_fn_name + i*8), load64(g_fn_namelen + i*8), name_off, name_len) == 1 {
            return i;
        }
        i = i + 1;
    }
    return 0 - 1;
}

# ----------------------------------------------------------------
#  cg_imp_find(name_off, name_len) -> IAT index or -1
# ----------------------------------------------------------------
func cg_imp_find(name_off: i64, name_len: i64) -> i64 {
    n = load64(g_imp_count);
    i = 0;
    while i < n {
        if cg_pool_cmp(load64(g_imp_fn + i*8), load64(g_imp_fnlen + i*8), name_off, name_len) == 1 {
            return i;
        }
        i = i + 1;
    }
    return 0 - 1;
}

# ----------------------------------------------------------------
#  cg_extend_ret(name_off, name_len)
#  After a Win32 import call: sign-extend EAX->RAX unless it's
#  a known 64-bit return (HANDLE, ptr, SOCKET etc.)
# ----------------------------------------------------------------
func cg_extend_ret(name_off: i64, name_len: i64) -> i64 {
    # Check if it is declared as -> ptr in the extern table
    n = load64(g_ext_count);
    i = 0;
    while i < n {
        if cg_pool_cmp(load64(g_ext_fn + i*8), load64(g_ext_fnlen + i*8), name_off, name_len) == 1 {
            if load64(g_ext_ptr + i*8) == 1 { return 0; }
        }
        i = i + 1;
    }
    # Known 64-bit returns that do NOT need sign-extension
    # GetStdHandle, GetModuleHandleA, GetProcessHeap, HeapAlloc, socket, accept, SetTimer
    # We check via strcmp against literal names in g_str_pool
    ptr = g_str_pool + name_off;
    if cg_fname_is(name_off, name_len, "GetStdHandle") == 1 { return 0; }
    if cg_fname_is(name_off, name_len, "GetModuleHandleA") == 1 { return 0; }
    if cg_fname_is(name_off, name_len, "GetProcessHeap") == 1 { return 0; }
    if cg_fname_is(name_off, name_len, "HeapAlloc") == 1 { return 0; }
    if cg_fname_is(name_off, name_len, "socket") == 1 { return 0; }
    if cg_fname_is(name_off, name_len, "accept") == 1 { return 0; }
    if cg_fname_is(name_off, name_len, "SetTimer") == 1 { return 0; }
    if cg_fname_is(name_off, name_len, "CreateWindowExA") == 1 { return 0; }
    if cg_fname_is(name_off, name_len, "DefWindowProcA") == 1 { return 0; }
    if cg_fname_is(name_off, name_len, "DispatchMessageA") == 1 { return 0; }
    if cg_fname_is(name_off, name_len, "LoadCursorA") == 1 { return 0; }
    # Known unsigned 16/32-bit returns: zero-extend
    if cg_fname_is(name_off, name_len, "htons") == 1 { em_zext_eax(); return 0; }
    if cg_fname_is(name_off, name_len, "GetTickCount") == 1 { em_zext_eax(); return 0; }
    if cg_fname_is(name_off, name_len, "RegisterClassExA") == 1 { em_zext_eax(); return 0; }
    # default: sign-extend 32-bit int
    em_movsxd_rax();
    return 0;
}

# ----------------------------------------------------------------
#  cg_is_import_name(name_off, name_len) -> 1 if in import table
# ----------------------------------------------------------------
func cg_is_import_name(name_off: i64, name_len: i64) -> i64 {
    if cg_imp_find(name_off, name_len) != 0 - 1 { return 1; }
    return 0;
}

# ----------------------------------------------------------------
#  cg_pool_off_for_lit(lit, lit_len) -> offset in g_str_pool
#  Interns a C-string literal into g_str_pool if not already there.
# ----------------------------------------------------------------
func cg_pool_intern_cstr(lit: i64) -> i64 {
    ln = strlen(lit);
    off = load64(g_str_pool_off);
    # copy
    i = 0;
    while i <= ln {
        store8(g_str_pool + off + i, load8(lit + i));
        i = i + 1;
    }
    store64(g_str_pool_off, off + ln + 1);
    return off;
}

# ----------------------------------------------------------------
#  cg_add_builtin_import(fn_cstr, dll_cstr) -> IAT index
# ----------------------------------------------------------------
func cg_add_builtin(fn_cstr: i64, dll_cstr: i64) -> i64 {
    fn_len  = strlen(fn_cstr);
    dll_len = strlen(dll_cstr);
    fn_off  = cg_pool_intern_cstr(fn_cstr);
    dll_off = cg_pool_intern_cstr(dll_cstr);
    return cg_use_import(fn_off, fn_len, dll_off, dll_len);
}

# ================================================================
#  f64 float-stamping pass (mirrors anclc.cpp stampFloats)
#  Runs before codegen.  Walks every function body and sets
#  g_nd_isfloat on each node (1 = value is an f64, lives in XMM0).
#  Float-ness flows from f64 literals, f64 params/locals/@DATA consts,
#  f64-returning calls (user fns / externs / sqrt|itof|ffrombits), and
#  f64 arithmetic.  An assignment with a float RHS makes its target a
#  float local (inference), grown to a fixpoint per function.
# ================================================================

# find an extern by name -> index, or -1
func cg_ext_find(noff: i64, nlen: i64) -> i64 {
    n = load64(g_ext_count);
    i = 0;
    while i < n {
        if cg_pool_cmp(load64(g_ext_fn + i*8), load64(g_ext_fnlen + i*8), noff, nlen) == 1 { return i; }
        i = i + 1;
    }
    return 0 - 1;
}

# --target=linux-dyn: intern a dynamic import (dlopen/dlsym/...) -> slot index (parallel to cg_use_import).
# Dedup by fn name; records the fn name + its extern soname (g_ext_dll) so elf_write_dyn can build the
# .dynstr / .dynsym / DT_NEEDED. Only reached from the SysV call branch under g_targetlinuxdyn.
func cg_use_dynimport(fn_off: i64, fn_len: i64) -> i64 {
    n = load64(g_dynimp_count);
    i = 0;
    while i < n {
        if cg_pool_cmp(load64(g_dynimp_fn + i*8), load64(g_dynimp_fnlen + i*8), fn_off, fn_len) == 1 { return i; }
        i = i + 1;
    }
    ei = cg_ext_find(fn_off, fn_len);
    so_off = 0;
    so_len = 0;
    if ei != 0 - 1 { so_off = load64(g_ext_dll + ei*8); so_len = load64(g_ext_dlllen + ei*8); }
    store64(g_dynimp_fn    + n*8, fn_off);
    store64(g_dynimp_fnlen + n*8, fn_len);
    store64(g_dynimp_so    + n*8, so_off);
    store64(g_dynimp_solen + n*8, so_len);
    store64(g_dynimp_count, n + 1);
    return n;
}

# does a callee (by name) return an f64?  intrinsic / user fn / extern
func cg_callee_retfloat(noff: i64, nlen: i64) -> i64 {
    if cg_fname_is(noff, nlen, "sqrt")      == 1 { return 1; }
    if cg_fname_is(noff, nlen, "itof")      == 1 { return 1; }
    if cg_fname_is(noff, nlen, "ffrombits") == 1 { return 1; }
    if cg_fname_is(noff, nlen, "ftoi")      == 1 { return 0; }
    if cg_fname_is(noff, nlen, "fbits")     == 1 { return 0; }
    fi = cg_fn_find(noff, nlen);
    if fi != 0 - 1 { return load64(g_fn_retfloat + fi * 8); }
    ei = cg_ext_find(noff, nlen);
    if ei != 0 - 1 { return load64(g_ext_float + ei * 8); }
    return 0;
}

# is param k of user function fi an f64?
func cg_fn_param_isfloat(fi: i64, k: i64) -> i64 {
    if k >= 8 { return 0; }
    return load64(g_fn_pfloat + fi * 64 + k * 8);
}

# --- per-function float-local name set ---
func cg_sf_clear() -> i64 { store64(g_sf_count, 0); return 0; }
func cg_sf_has(noff: i64, nlen: i64) -> i64 {
    n = load64(g_sf_count);
    i = 0;
    while i < n {
        if cg_pool_cmp(load64(g_sf_off + i*8), load64(g_sf_len + i*8), noff, nlen) == 1 { return 1; }
        i = i + 1;
    }
    return 0;
}
func cg_sf_add(noff: i64, nlen: i64) -> i64 {     # returns 1 if newly added
    if cg_sf_has(noff, nlen) == 1 { return 0; }
    n = load64(g_sf_count);
    store64(g_sf_off + n*8, noff);
    store64(g_sf_len + n*8, nlen);
    store64(g_sf_count, n + 1);
    return 1;
}

# stamp one expression node; sets g_nd_isfloat[nd]; returns it
func cg_sf_stamp_expr(nd: i64) -> i64 {
    if nd == 0 { return 0; }
    kind = load64(g_nd_kind + nd * 8);

    if kind == ND_FLOAT { store64(g_nd_isfloat + nd*8, 1); return 1; }
    if kind == ND_INT   { store64(g_nd_isfloat + nd*8, 0); return 0; }
    if kind == ND_STR   { store64(g_nd_isfloat + nd*8, 0); return 0; }
    if kind == ND_ADDR  { store64(g_nd_isfloat + nd*8, 0); return 0; }

    if kind == ND_VAR {
        noff = load64(g_nd_name + nd*8);
        nlen = load64(g_nd_namelen + nd*8);
        r = 0;
        if cg_sf_has(noff, nlen) == 1 { r = 1; }
        if r == 0 {
            vi = cg_dv_find(noff, nlen);
            if vi != 0 - 1 { if load64(g_dv_isfloat + vi*8) == 1 { r = 1; } }
        }
        store64(g_nd_isfloat + nd*8, r);
        return r;
    }

    if kind == ND_CALL {
        arg = load64(g_nd_a + nd*8);
        while arg != 0 { cg_sf_stamp_expr(arg); arg = load64(g_nd_c + arg*8); }
        r = cg_callee_retfloat(load64(g_nd_name + nd*8), load64(g_nd_namelen + nd*8));
        store64(g_nd_isfloat + nd*8, r);
        return r;
    }

    if kind == ND_BINARY {
        op = load64(g_nd_ival + nd*8);
        lf = cg_sf_stamp_expr(load64(g_nd_a + nd*8));
        rf = cg_sf_stamp_expr(load64(g_nd_b + nd*8));
        # comparisons (== != < <= > >=) and && || yield an int boolean, never f64
        isint = 0;
        if op == 101 { isint = 1; }
        if op == 110 { isint = 1; }
        if op == 108 { isint = 1; }
        if op == 76  { isint = 1; }
        if op == 103 { isint = 1; }
        if op == 71  { isint = 1; }
        if op == 97  { isint = 1; }
        if op == 111 { isint = 1; }
        r = 0;
        if isint == 0 { if lf == 1 { r = 1; } if rf == 1 { r = 1; } }
        store64(g_nd_isfloat + nd*8, r);
        return r;
    }

    store64(g_nd_isfloat + nd*8, 0);
    return 0;
}

# stamp one statement; returns 1 if the float-local set grew
func cg_sf_stamp_stmt(nd: i64) -> i64 {
    if nd == 0 { return 0; }
    kind = load64(g_nd_kind + nd * 8);
    grew = 0;

    if kind == ST_ASSIGN {
        rhs  = load64(g_nd_a + nd*8);
        rf   = cg_sf_stamp_expr(rhs);
        noff = load64(g_nd_name + nd*8);
        nlen = load64(g_nd_namelen + nd*8);
        if rf == 1 { if cg_sf_add(noff, nlen) == 1 { grew = 1; } }
        tf = 0;
        if cg_sf_has(noff, nlen) == 1 { tf = 1; }
        store64(g_nd_isfloat + nd*8, tf);
        return grew;
    }
    if kind == ST_EXPRSTMT { cg_sf_stamp_expr(load64(g_nd_a + nd*8)); return 0; }
    if kind == ST_RETURN   { cg_sf_stamp_expr(load64(g_nd_a + nd*8)); return 0; }
    if kind == ST_SYSCALL {
        arg = load64(g_nd_a + nd*8);
        while arg != 0 { cg_sf_stamp_expr(arg); arg = load64(g_nd_c + arg*8); }
        return 0;
    }
    if kind == ST_IF {
        cg_sf_stamp_expr(load64(g_nd_a + nd*8));
        s = load64(g_nd_b + nd*8);
        while s != 0 { if cg_sf_stamp_stmt(s) == 1 { grew = 1; } s = load64(g_nd_c + s*8); }
        s = load64(g_nd_name + nd*8);
        while s != 0 { if cg_sf_stamp_stmt(s) == 1 { grew = 1; } s = load64(g_nd_c + s*8); }
        return grew;
    }
    if kind == ST_LOOP {
        cg_sf_stamp_expr(load64(g_nd_a + nd*8));
        s = load64(g_nd_b + nd*8);
        while s != 0 { if cg_sf_stamp_stmt(s) == 1 { grew = 1; } s = load64(g_nd_c + s*8); }
        return grew;
    }
    return 0;
}

# stamp one function to a fixpoint
func cg_stamp_func(fi: i64) -> i64 {
    cg_sf_clear();
    np = load64(g_fn_nparams + fi*8);
    i = 0;
    while i < np {
        if cg_fn_param_isfloat(fi, i) == 1 {
            cg_sf_add(load64(g_fn_params + fi*128 + i*16 + 0), load64(g_fn_params + fi*128 + i*16 + 8));
        }
        i = i + 1;
    }
    changed = 1;
    while changed == 1 {
        changed = 0;
        s = load64(g_fn_body + fi*8);
        while s != 0 {
            if cg_sf_stamp_stmt(s) == 1 { changed = 1; }
            s = load64(g_nd_c + s*8);
        }
    }
    return 0;
}

func cg_stamp_program() -> i64 {
    n = load64(g_fn_count);
    i = 0;
    while i < n { cg_stamp_func(i); i = i + 1; }
    return 0;
}

# ================================================================
#  cg_gen_expr(nd) -> result in RAX  (or XMM0 if the node is an f64)
# ================================================================
func cg_gen_expr(nd: i64) -> i64 {
    if nd == 0 { em_mov_ri(EM_RAX, 0); return 0; }
    kind = load64(g_nd_kind + nd * 8);

    # ND_INT
    if kind == ND_INT {
        em_mov_ri(EM_RAX, load64(g_nd_ival + nd * 8));
        return 0;
    }

    # ND_FLOAT  -- materialize the IEEE-754 bits, move into XMM0
    if kind == ND_FLOAT {
        em_mov_ri(EM_RAX, load64(g_nd_ival + nd * 8));
        em_movq_xr(0, EM_RAX);
        return 0;
    }

    # ND_STR  -- lea rax,[rip+string_rdata]
    if kind == ND_STR {
        sid = load64(g_nd_ival + nd * 8);
        em_lea_rip(EM_RAX, 1, sid);
        return 0;
    }

    # ND_ADDR  -- address of a function or data variable
    if kind == ND_ADDR {
        noff = load64(g_nd_name    + nd * 8);
        nlen = load64(g_nd_namelen + nd * 8);
        # check function
        fi = cg_fn_find(noff, nlen);
        if fi != 0 - 1 {
            lbl = load64(g_fn_label + fi * 8);
            em_lea_rip(EM_RAX, 0, lbl);
            return 0;
        }
        # check data var
        vi = cg_dv_find(noff, nlen);
        if vi != 0 - 1 {
            vt = load64(g_dv_type + vi * 8);
            if vt == DV_STR {
                sid2 = load64(g_dv_strid + vi * 8);
                em_lea_rip(EM_RAX, 1, sid2);
                return 0;
            }
            if vt == DV_BUF {
                # data offset stored at runtime in g_dv_ival after buffer layout
                doff = load64(g_dv_ival + vi * 8);
                em_lea_rip(EM_RAX, 2, doff);
                return 0;
            }
        }
        em_mov_ri(EM_RAX, 0);
        return 0;
    }

    # ND_VAR
    if kind == ND_VAR {
        noff = load64(g_nd_name    + nd * 8);
        nlen = load64(g_nd_namelen + nd * 8);
        ndf  = load64(g_nd_isfloat + nd * 8);
        # local?
        loff = cg_local_slot(noff, nlen);
        if loff != 0 - 1 {
            if ndf == 1 { em_movsd_xm(0, EM_RSP, loff); return 0; }   # f64 local -> XMM0
            em_mov_rm(EM_RAX, EM_RSP, loff);
            return 0;
        }
        # data var?
        vi = cg_dv_find(noff, nlen);
        if vi != 0 - 1 {
            vt = load64(g_dv_type + vi * 8);
            if vt == DV_STR {
                sid2 = load64(g_dv_strid + vi * 8);
                em_lea_rip(EM_RAX, 1, sid2);
                return 0;
            }
            if vt == DV_BUF {
                doff2 = load64(g_dv_ival + vi * 8);
                em_lea_rip(EM_RAX, 2, doff2);
                return 0;
            }
            # f64 const -> raw bits -> XMM0
            if ndf == 1 {
                em_mov_ri(EM_RAX, load64(g_dv_ival + vi * 8));
                em_movq_xr(0, EM_RAX);
                return 0;
            }
            # integer constant
            em_mov_ri(EM_RAX, load64(g_dv_ival + vi * 8));
            return 0;
        }
        # unknown
        em_mov_ri(EM_RAX, 0);
        return 0;
    }

    # ND_BINARY
    if kind == ND_BINARY {
        op = load64(g_nd_ival + nd * 8);
        la = load64(g_nd_a    + nd * 8);
        rb = load64(g_nd_b    + nd * 8);

        # short-circuit &&  ||
        if op == 97 {   # 'a' = &&
            lsc  = em_label_new();
            lend2 = em_label_new();
            cg_gen_expr(la);
            em_test_rr(EM_RAX, EM_RAX);
            em_jz(lsc);
            cg_gen_expr(rb);
            em_test_rr(EM_RAX, EM_RAX);
            em_setcc(149);   # setne
            em_jmp(lend2);
            em_label_place(lsc);
            em_mov_ri(EM_RAX, 0);
            em_label_place(lend2);
            return 0;
        }
        if op == 111 {  # 'o' = ||
            lsc  = em_label_new();
            lend2 = em_label_new();
            cg_gen_expr(la);
            em_test_rr(EM_RAX, EM_RAX);
            em_jnz(lsc);
            cg_gen_expr(rb);
            em_test_rr(EM_RAX, EM_RAX);
            em_setcc(149);   # setne
            em_jmp(lend2);
            em_label_place(lsc);
            em_mov_ri(EM_RAX, 1);
            em_label_place(lend2);
            return 0;
        }

        # ---- f64 path: float arithmetic, or a comparison with a float operand ----
        ndf = load64(g_nd_isfloat + nd * 8);
        laf = load64(g_nd_isfloat + la * 8);
        rbf = load64(g_nd_isfloat + rb * 8);
        iscmp = 0;
        if op == 101 { iscmp = 1; }
        if op == 110 { iscmp = 1; }
        if op == 108 { iscmp = 1; }
        if op == 76  { iscmp = 1; }
        if op == 103 { iscmp = 1; }
        if op == 71  { iscmp = 1; }
        dofl = 0;
        if ndf == 1 { dofl = 1; }
        if iscmp == 1 { if laf == 1 { dofl = 1; } if rbf == 1 { dofl = 1; } }
        if dofl == 1 {
            cg_gen_expr(la);                          # L -> XMM0 (if float) or RAX
            if laf == 0 { em_cvtsi2sd(0, EM_RAX); }   # promote an int operand
            svf = cg_alloc_scratch();
            em_movsd_mx(EM_RSP, svf, 0);              # save L
            cg_gen_expr(rb);                          # R
            if rbf == 0 { em_cvtsi2sd(0, EM_RAX); }
            em_movsd_xx(1, 0);                        # R -> XMM1
            em_movsd_xm(0, EM_RSP, svf);              # reload L -> XMM0
            cg_free_scratch(1);
            if op == 43  { em_addsd(0, 1); return 0; }   # +
            if op == 45  { em_subsd(0, 1); return 0; }   # -
            if op == 42  { em_mulsd(0, 1); return 0; }   # *
            if op == 47  { em_divsd(0, 1); return 0; }   # /
            # comparisons: ucomisd sets CF/ZF -> UNSIGNED setcc (NaN ignored in v1)
            if op == 101 { em_ucomisd(0, 1); em_setcc(148); return 0; }   # ==  sete
            if op == 110 { em_ucomisd(0, 1); em_setcc(149); return 0; }   # !=  setne
            if op == 108 { em_ucomisd(0, 1); em_setcc(146); return 0; }   # <   setb
            if op == 76  { em_ucomisd(0, 1); em_setcc(150); return 0; }   # <=  setbe
            if op == 103 { em_ucomisd(0, 1); em_setcc(151); return 0; }   # >   seta
            if op == 71  { em_ucomisd(0, 1); em_setcc(147); return 0; }   # >=  setae
            return 0;
        }

        # general binary: eval L -> save -> eval R -> combine
        cg_gen_expr(la);
        sv = cg_alloc_scratch();
        em_mov_mr(EM_RSP, sv, EM_RAX);
        cg_gen_expr(rb);
        em_mov_rr(EM_RCX, EM_RAX);
        em_mov_rm(EM_RAX, EM_RSP, sv);
        cg_free_scratch(1);

        if op == 43  { em_add_rr(EM_RAX, EM_RCX); return 0; }   # '+'
        if op == 45  { em_sub_rr(EM_RAX, EM_RCX); return 0; }   # '-'
        if op == 42  { em_imul_rr(EM_RAX, EM_RCX); return 0; }  # '*'
        if op == 47  { em_cqo(); em_idiv(EM_RCX); return 0; }   # '/'
        if op == 109 { em_cqo(); em_idiv(EM_RCX); em_mov_rr(EM_RAX, EM_RDX); return 0; }  # 'm'=%
        if op == 101 { em_cmp_rr(EM_RAX, EM_RCX); em_setcc(148); return 0; }  # 'e'==  sete=0x94
        if op == 110 { em_cmp_rr(EM_RAX, EM_RCX); em_setcc(149); return 0; }  # 'n'!=  setne=0x95
        if op == 108 { em_cmp_rr(EM_RAX, EM_RCX); em_setcc(156); return 0; }  # 'l'<   setl=0x9C
        if op == 76  { em_cmp_rr(EM_RAX, EM_RCX); em_setcc(158); return 0; }  # 'L'<=  setle=0x9E
        if op == 103 { em_cmp_rr(EM_RAX, EM_RCX); em_setcc(159); return 0; }  # 'g'>   setg=0x9F
        if op == 71  { em_cmp_rr(EM_RAX, EM_RCX); em_setcc(157); return 0; }  # 'G'>=  setge=0x9D
        if op == 124 { em_or_rr(EM_RAX, EM_RCX);  return 0; }   # '|'  bitwise or  (== bor)
        if op == 94  { em_xor_rr(EM_RAX, EM_RCX); return 0; }   # '^'  bitwise xor (== bxor)
        if op == 38  { em_and_rr(EM_RAX, EM_RCX); return 0; }   # '&'  bitwise and (== band)
        if op == 83  { em_shl_cl(EM_RAX);         return 0; }   # 'S'  shl (count in cl == shl)
        if op == 82  { em_shr_cl(EM_RAX);         return 0; }   # 'R'  shr (== shr)
        return 0;
    }

    # ND_CALL
    if kind == ND_CALL {
        return cg_gen_call(nd);
    }

    return 0;
}

# ================================================================
#  cg_tool_index_accessor(nd, mode) -> ptr in RAX (0 if index oob)
#  Emits an if-ladder for tool_name(i)/tool_schema(i)/tool_fn(i).
#  mode 0 = name string, 1 = schema string, 2 = function address.
# ================================================================
func cg_tool_index_accessor(nd: i64, mode: i64) -> i64 {
    cg_gen_expr(load64(g_nd_a + nd * 8));     # index -> RAX
    sv = cg_alloc_scratch();
    em_mov_mr(EM_RSP, sv, EM_RAX);            # save index
    em_mov_ri(EM_RAX, 0);                     # default result (out of range)
    lend = em_label_new();
    nt = load64(g_tool_count);
    k = 0;
    while k < nt {
        lnext = em_label_new();
        em_mov_rm(EM_RCX, EM_RSP, sv);        # RCX = index
        em_mov_ri(EM_RDX, k);                 # RDX = k
        em_cmp_rr(EM_RCX, EM_RDX);
        em_jne(lnext);
        if mode == 0 { em_lea_rip(EM_RAX, 1, load64(g_tool_namesid   + k * 8)); }
        if mode == 1 { em_lea_rip(EM_RAX, 1, load64(g_tool_schemasid + k * 8)); }
        if mode == 2 {
            fnidx = load64(g_tool_fnidx + k * 8);
            em_lea_rip(EM_RAX, 0, load64(g_fn_label + fnidx * 8));
        }
        em_jmp(lend);
        em_label_place(lnext);
        k = k + 1;
    }
    em_label_place(lend);
    cg_free_scratch(1);
    return 0;
}

# ================================================================
#  cg_gen_call(nd) -> result in RAX
#  Handles builtin intrinsics, user functions, and Win32 imports.
# ================================================================
func cg_gen_call(nd: i64) -> i64 {
    name_off = load64(g_nd_name    + nd * 8);
    name_len = load64(g_nd_namelen + nd * 8);
    fname    = g_str_pool + name_off;

    # Count args + collect them
    nargs = 0;
    a = load64(g_nd_a + nd * 8);
    tmp = a;
    while tmp != 0 { nargs = nargs + 1; tmp = load64(g_nd_c + tmp * 8); }

    # ---- Builtin: read_int ----
    if cg_fname_is(name_off, name_len, "read_int") == 1 { em_call_label(load64(L_read_int));   return 0; }
    if cg_fname_is(name_off, name_len, "read_char") == 1 { em_call_label(load64(L_read_char));  return 0; }

    # ---- M5: raw Linux syscall(nr, a0..a5) -> RAX (Linux target only) ----
    if cg_fname_is(name_off, name_len, "syscall") == 1 {
        if load64(g_targetlinux) == 0 { syscall 1, cg_err_syscall_win; ExitProcess(1); }
        # eval each arg into a scratch slot, then load into the SYSCALL reg order
        # {RAX, RDI, RSI, RDX, R10, R8, R9} (R10 NOT RCX; 0F05 clobbers RCX+R11).
        sc_slots = alloc(nargs * 8);
        ai = load64(g_nd_a + nd * 8);
        ns = 0;
        while ai != 0 {
            sv = cg_alloc_scratch();
            store64(sc_slots + ns * 8, sv);
            cg_gen_expr(ai);
            em_mov_mr(EM_RSP, sv, EM_RAX);
            ns = ns + 1;
            ai = load64(g_nd_c + ai * 8);
        }
        k = 0;
        while k < ns {
            reg = EM_RAX;
            if k == 1 { reg = EM_RDI; }
            if k == 2 { reg = EM_RSI; }
            if k == 3 { reg = EM_RDX; }
            if k == 4 { reg = EM_R10; }
            if k == 5 { reg = EM_R8; }
            if k == 6 { reg = EM_R9; }
            em_mov_rm(reg, EM_RSP, load64(sc_slots + k * 8));
            k = k + 1;
        }
        em_syscall();
        cg_free_scratch(ns);
        return 0;
    }
    # ---- M5: __argv_base() -> entry rsp captured at _start (Linux target only) ----
    if cg_fname_is(name_off, name_len, "__argv_base") == 1 {
        if load64(g_targetlinux) == 0 { syscall 1, cg_err_argv_win; ExitProcess(1); }
        em_mov_rip_load(EM_RAX, 2, DAT_ARGV);
        return 0;
    }

    # ---- Builtin: puts_cstr(p) ----
    if cg_fname_is(name_off, name_len, "puts_cstr") == 1 {
        cg_gen_expr(load64(g_nd_a + nd * 8));
        em_mov_rr(EM_RCX, EM_RAX);
        em_call_label(load64(L_puts_cstr));
        return 0;
    }

    # ---- Builtin: str_to_int(p) ----
    if cg_fname_is(name_off, name_len, "str_to_int") == 1 {
        cg_gen_expr(load64(g_nd_a + nd * 8));
        em_mov_rr(EM_RCX, EM_RAX);
        em_call_label(load64(L_str_to_int));
        return 0;
    }

    # ---- Builtin: str_copy(dst, src) ----
    if cg_fname_is(name_off, name_len, "str_copy") == 1 {
        arg0 = load64(g_nd_a + nd * 8);
        arg1 = load64(g_nd_c + arg0 * 8);
        cg_gen_expr(arg0);
        sv0 = cg_alloc_scratch();
        em_mov_mr(EM_RSP, sv0, EM_RAX);
        cg_gen_expr(arg1);
        em_mov_rr(EM_RDX, EM_RAX);
        em_mov_rm(EM_RCX, EM_RSP, sv0);
        em_call_label(load64(L_str_copy));
        cg_free_scratch(1);
        return 0;
    }

    # ---- Builtin: int_to_str(buf, val) ----
    if cg_fname_is(name_off, name_len, "int_to_str") == 1 {
        arg0 = load64(g_nd_a + nd * 8);
        arg1 = load64(g_nd_c + arg0 * 8);
        cg_gen_expr(arg0);
        sv0 = cg_alloc_scratch();
        em_mov_mr(EM_RSP, sv0, EM_RAX);
        cg_gen_expr(arg1);
        sv1 = cg_alloc_scratch();
        em_mov_mr(EM_RSP, sv1, EM_RAX);
        em_mov_rm(EM_RCX, EM_RSP, sv0);
        em_mov_rm(EM_RDX, EM_RSP, sv1);
        em_call_label(load64(L_int_to_str));
        cg_free_scratch(2);
        return 0;
    }

    # ---- Builtin: alloc(n) = HeapAlloc(GetProcessHeap(), HEAP_ZERO_MEMORY, n)  [Windows]
    #                        = mmap-backed block with an 8-byte length header     [Linux, M5] ----
    if cg_fname_is(name_off, name_len, "alloc") == 1 {
        if load64(g_targetlinux) == 1 {
            # mmap(0, n+16, PROT_RW=3, MAP_PRIVATE|ANON=0x22, fd=-1, 0) [sys 9]; store len header; ret base+16.
            cg_gen_expr(load64(g_nd_a + nd * 8));   # RAX = n
            em_add_ri(EM_RAX, 16);                  # len = n + 16
            sv0 = cg_alloc_scratch();
            em_mov_mr(EM_RSP, sv0, EM_RAX);         # save len
            em_mov_rr(EM_RSI, EM_RAX);              # a1 = length
            em_xor_rr(EM_RDI, EM_RDI);              # a0 = NULL
            em_mov_ri(EM_RDX, 3);                   # a2 = PROT_READ|PROT_WRITE
            em_mov_ri(EM_R10, 34);                  # a3 = MAP_PRIVATE|MAP_ANONYMOUS (0x22)
            em_mov_ri(EM_R8, 0 - 1);                # a4 = fd = -1
            em_xor_rr(EM_R9, EM_R9);                # a5 = offset = 0
            em_mov_ri(EM_RAX, 9);                   # sys_mmap
            em_syscall();                           # RAX = base addr or -errno
            Lok2   = em_label_new();
            Ldone2 = em_label_new();
            em_test_rr(EM_RAX, EM_RAX);
            em_jns(Lok2);                           # addr >= 0 -> success (errno is negative)
            em_xor_rr(EM_RAX, EM_RAX); em_jmp(Ldone2);   # failure -> NULL
            em_label_place(Lok2);
            em_mov_rm(EM_RCX, EM_RSP, sv0);         # len
            em_mov_mr(EM_RAX, 0, EM_RCX);           # store64(base, len)
            em_add_ri(EM_RAX, 16);                  # user ptr = base + 16
            em_label_place(Ldone2);
            cg_free_scratch(1);
            return 0;
        }
        # cg_add_builtin returns the already-registered IAT slot (idempotent).
        heap_imp  = cg_add_builtin("GetProcessHeap", "kernel32.dll");
        halloc_imp = cg_add_builtin("HeapAlloc",     "kernel32.dll");
        cg_gen_expr(load64(g_nd_a + nd * 8));
        sv0 = cg_alloc_scratch();
        em_mov_mr(EM_RSP, sv0, EM_RAX);
        em_call_import(heap_imp);            # rax = heap handle
        em_mov_rr(EM_RCX, EM_RAX);           # rcx = heap
        em_mov_ri(EM_RDX, 8);                # rdx = HEAP_ZERO_MEMORY
        em_mov_rm(EM_R8, EM_RSP, sv0);       # r8  = n
        em_call_import(halloc_imp);          # rax = zeroed ptr
        cg_free_scratch(1);
        return 0;
    }

    # ---- Builtin: free(p) = HeapFree(GetProcessHeap(), 0, p)  [Windows]
    #                       = munmap(p-16, header_len)           [Linux, M5] ----
    if cg_fname_is(name_off, name_len, "free") == 1 {
        if load64(g_targetlinux) == 1 {
            cg_gen_expr(load64(g_nd_a + nd * 8));   # RAX = p
            Lfdone = em_label_new();
            em_test_rr(EM_RAX, EM_RAX);
            em_jz(Lfdone);                          # free(NULL) -> skip
            em_sub_ri(EM_RAX, 16);                  # base = p - 16
            em_mov_rm(EM_RSI, EM_RAX, 0);           # a1 = length = load64(base)
            em_mov_rr(EM_RDI, EM_RAX);              # a0 = addr = base
            em_mov_ri(EM_RAX, 11);                  # sys_munmap
            em_syscall();
            em_label_place(Lfdone);
            return 0;
        }
        heap_imp  = cg_add_builtin("GetProcessHeap", "kernel32.dll");
        hfree_imp = cg_add_builtin("HeapFree",       "kernel32.dll");
        cg_gen_expr(load64(g_nd_a + nd * 8));
        sv0 = cg_alloc_scratch();
        em_mov_mr(EM_RSP, sv0, EM_RAX);
        em_call_import(heap_imp);            # rax = heap handle
        em_mov_rr(EM_RCX, EM_RAX);           # rcx = heap
        em_xor_rr(EM_RDX, EM_RDX);           # rdx = 0 flags
        em_mov_rm(EM_R8, EM_RSP, sv0);       # r8  = p
        em_call_import(hfree_imp);
        cg_free_scratch(1);
        return 0;
    }

    # ---- Builtins: memcpy, memset, strlen, strcmp ----
    is_helper = 0;
    helper_lbl = 0;
    if cg_fname_is(name_off, name_len, "memcpy") == 1 { is_helper = 1; helper_lbl = load64(L_memcpy);  }
    if cg_fname_is(name_off, name_len, "memset") == 1 { is_helper = 1; helper_lbl = load64(L_memset);  }
    if cg_fname_is(name_off, name_len, "strlen") == 1 { is_helper = 1; helper_lbl = load64(L_strlen);  }
    if cg_fname_is(name_off, name_len, "strcmp") == 1 { is_helper = 1; helper_lbl = load64(L_strcmp);  }
    if is_helper == 1 {
        slots = alloc(nargs * 8);
        ai = 0;
        arg = load64(g_nd_a + nd * 8);
        while arg != 0 {
            cg_gen_expr(arg);
            sv0 = cg_alloc_scratch();
            em_mov_mr(EM_RSP, sv0, EM_RAX);
            store64(slots + ai * 8, sv0);
            ai = ai + 1;
            arg = load64(g_nd_c + arg * 8);
        }
        arg_regs = alloc(4 * 8);
        store64(arg_regs + 0, EM_RCX);
        store64(arg_regs + 8, EM_RDX);
        store64(arg_regs + 16, EM_R8);
        store64(arg_regs + 24, EM_R9);
        i = 0;
        while i < nargs {
            if i < 4 {
                em_mov_rm(load64(arg_regs + i*8), EM_RSP, load64(slots + i*8));
            }
            i = i + 1;
        }
        em_call_label(helper_lbl);
        cg_free_scratch(nargs);
        free(slots);
        free(arg_regs);
        return 0;
    }

    # ---- Builtins: load8/16/32/64 ----
    if cg_fname_is(name_off, name_len, "load8") == 1 { cg_gen_expr(load64(g_nd_a + nd*8)); em_movzx_rm8(EM_RAX, EM_RAX, 0); return 0; }
    if cg_fname_is(name_off, name_len, "load64") == 1 { cg_gen_expr(load64(g_nd_a + nd*8)); em_mov_rm(EM_RAX, EM_RAX, 0); return 0; }
    if cg_fname_is(name_off, name_len, "load32") == 1 {
        cg_gen_expr(load64(g_nd_a + nd*8));
        # mov eax,[rax]  zero-extends
        em_b(139); em_b(0);   # MOV r32,[rax]
        return 0;
    }
    if cg_fname_is(name_off, name_len, "load16") == 1 {
        cg_gen_expr(load64(g_nd_a + nd*8));
        # movzx rax,word[rax]
        em_rex(1,0,0,0); em_b(15); em_b(183); em_b(0);
        return 0;
    }

    # ---- Builtins: store8/16/32/64 ----
    if cg_fname_is(name_off, name_len, "store8") == 1 {
        arg0 = load64(g_nd_a + nd * 8);
        arg1 = load64(g_nd_c + arg0 * 8);
        cg_gen_expr(arg0);
        sv0 = cg_alloc_scratch();
        em_mov_mr(EM_RSP, sv0, EM_RAX);
        cg_gen_expr(arg1);
        em_mov_rr(EM_RCX, EM_RAX);
        em_mov_rm(EM_RAX, EM_RSP, sv0);
        cg_free_scratch(1);
        em_mov_mr8(EM_RAX, 0, EM_RCX);
        em_mov_rr(EM_RAX, EM_RCX);
        return 0;
    }
    if cg_fname_is(name_off, name_len, "store64") == 1 {
        arg0 = load64(g_nd_a + nd * 8);
        arg1 = load64(g_nd_c + arg0 * 8);
        cg_gen_expr(arg0);
        sv0 = cg_alloc_scratch();
        em_mov_mr(EM_RSP, sv0, EM_RAX);
        cg_gen_expr(arg1);
        em_mov_rr(EM_RCX, EM_RAX);
        em_mov_rm(EM_RAX, EM_RSP, sv0);
        cg_free_scratch(1);
        em_mov_mr(EM_RAX, 0, EM_RCX);
        em_mov_rr(EM_RAX, EM_RCX);
        return 0;
    }
    if cg_fname_is(name_off, name_len, "store32") == 1 {
        arg0 = load64(g_nd_a + nd * 8);
        arg1 = load64(g_nd_c + arg0 * 8);
        cg_gen_expr(arg0);
        sv0 = cg_alloc_scratch();
        em_mov_mr(EM_RSP, sv0, EM_RAX);
        cg_gen_expr(arg1);
        em_mov_rr(EM_RCX, EM_RAX);
        em_mov_rm(EM_RAX, EM_RSP, sv0);
        cg_free_scratch(1);
        # mov dword[rax],ecx
        em_b(137); em_b(8);
        em_mov_rr(EM_RAX, EM_RCX);
        return 0;
    }
    if cg_fname_is(name_off, name_len, "store16") == 1 {
        arg0 = load64(g_nd_a + nd * 8);
        arg1 = load64(g_nd_c + arg0 * 8);
        cg_gen_expr(arg0);
        sv0 = cg_alloc_scratch();
        em_mov_mr(EM_RSP, sv0, EM_RAX);
        cg_gen_expr(arg1);
        em_mov_rr(EM_RCX, EM_RAX);
        em_mov_rm(EM_RAX, EM_RSP, sv0);
        cg_free_scratch(1);
        # mov word[rax],cx
        em_b(102); em_b(137); em_b(8);
        em_mov_rr(EM_RAX, EM_RCX);
        return 0;
    }

    # ---- Bitwise/shift ----
    if cg_fname_is(name_off, name_len, "shl") == 1 {
        arg0 = load64(g_nd_a + nd * 8);
        arg1 = load64(g_nd_c + arg0 * 8);
        cg_gen_expr(arg0); sv0 = cg_alloc_scratch(); em_mov_mr(EM_RSP, sv0, EM_RAX);
        cg_gen_expr(arg1); em_mov_rr(EM_RCX, EM_RAX); em_mov_rm(EM_RAX, EM_RSP, sv0);
        cg_free_scratch(1); em_shl_cl(EM_RAX); return 0;
    }
    if cg_fname_is(name_off, name_len, "shr") == 1 {
        arg0 = load64(g_nd_a + nd * 8);
        arg1 = load64(g_nd_c + arg0 * 8);
        cg_gen_expr(arg0); sv0 = cg_alloc_scratch(); em_mov_mr(EM_RSP, sv0, EM_RAX);
        cg_gen_expr(arg1); em_mov_rr(EM_RCX, EM_RAX); em_mov_rm(EM_RAX, EM_RSP, sv0);
        cg_free_scratch(1); em_shr_cl(EM_RAX); return 0;
    }
    if cg_fname_is(name_off, name_len, "band") == 1 {
        arg0 = load64(g_nd_a + nd * 8);
        arg1 = load64(g_nd_c + arg0 * 8);
        cg_gen_expr(arg0); sv0 = cg_alloc_scratch(); em_mov_mr(EM_RSP, sv0, EM_RAX);
        cg_gen_expr(arg1); em_mov_rr(EM_RCX, EM_RAX); em_mov_rm(EM_RAX, EM_RSP, sv0);
        cg_free_scratch(1); em_and_rr(EM_RAX, EM_RCX); return 0;
    }
    if cg_fname_is(name_off, name_len, "bor") == 1 {
        arg0 = load64(g_nd_a + nd * 8);
        arg1 = load64(g_nd_c + arg0 * 8);
        cg_gen_expr(arg0); sv0 = cg_alloc_scratch(); em_mov_mr(EM_RSP, sv0, EM_RAX);
        cg_gen_expr(arg1); em_mov_rr(EM_RCX, EM_RAX); em_mov_rm(EM_RAX, EM_RSP, sv0);
        cg_free_scratch(1); em_or_rr(EM_RAX, EM_RCX); return 0;
    }
    if cg_fname_is(name_off, name_len, "bxor") == 1 {
        arg0 = load64(g_nd_a + nd * 8);
        arg1 = load64(g_nd_c + arg0 * 8);
        cg_gen_expr(arg0); sv0 = cg_alloc_scratch(); em_mov_mr(EM_RSP, sv0, EM_RAX);
        cg_gen_expr(arg1); em_mov_rr(EM_RCX, EM_RAX); em_mov_rm(EM_RAX, EM_RSP, sv0);
        cg_free_scratch(1); em_xor_rr(EM_RAX, EM_RCX); return 0;
    }

    # ---- f64 intrinsics (SSE2, no DLL) ----
    # sqrt(x)->f64 ; ftoi(x) f64->i64 trunc ; itof(n) i64->f64 ;
    # fbits(x) f64 raw IEEE-754 bits->i64 ; ffrombits(n) i64 bits->f64.
    # Int args to sqrt/itof promote; float args to ftoi/fbits pass through.
    if cg_fname_is(name_off, name_len, "sqrt") == 1 {
        a0 = load64(g_nd_a + nd * 8);
        cg_gen_expr(a0);
        if load64(g_nd_isfloat + a0 * 8) == 0 { em_cvtsi2sd(0, EM_RAX); }
        em_sqrtsd(0, 0);
        return 0;
    }
    if cg_fname_is(name_off, name_len, "ftoi") == 1 {
        a0 = load64(g_nd_a + nd * 8);
        cg_gen_expr(a0);
        if load64(g_nd_isfloat + a0 * 8) == 1 { em_cvttsd2si(EM_RAX, 0); }
        return 0;
    }
    if cg_fname_is(name_off, name_len, "itof") == 1 {
        a0 = load64(g_nd_a + nd * 8);
        cg_gen_expr(a0);
        if load64(g_nd_isfloat + a0 * 8) == 0 { em_cvtsi2sd(0, EM_RAX); }
        return 0;
    }
    if cg_fname_is(name_off, name_len, "fbits") == 1 {
        a0 = load64(g_nd_a + nd * 8);
        cg_gen_expr(a0);
        if load64(g_nd_isfloat + a0 * 8) == 1 { em_movq_rx(EM_RAX, 0); }
        return 0;
    }
    if cg_fname_is(name_off, name_len, "ffrombits") == 1 {
        a0 = load64(g_nd_a + nd * 8);
        cg_gen_expr(a0);
        if load64(g_nd_isfloat + a0 * 8) == 0 { em_movq_xr(0, EM_RAX); }
        return 0;
    }

    # ---- ExitProcess(n) ----
    # Windows-only fast path (direct import). Under --target=linux, fall through to the general
    # dispatch so the call resolves to the liblinux ExitProcess shim (exit_group) -- otherwise this
    # would emit a kind-3 import fixup that the ELF writer rejects (anclc's own error paths call it).
    if cg_fname_is(name_off, name_len, "ExitProcess") == 1 {
        if load64(g_targetlinux) == 0 {
            cg_gen_expr(load64(g_nd_a + nd * 8));
            em_mov_rr(EM_RCX, EM_RAX);
            em_call_import(IMP_ExitProcess);
            return 0;
        }
    }

    # ---- callp(fnptr, args...) : indirect call through a RUNTIME pointer (COM vtable / GetProcAddress) ----
    # arg0 = target address; arg1.. are passed by the Win64 ABI (RCX/RDX/R8/R9 + stack). The 32-bit
    # return is sign-extended (HRESULTs are 32-bit, so FAILED(hr) == hr < 0 works). Mirrors anclc.cpp.
    if cg_fname_is(name_off, name_len, "callp") == 1 {
        slotsp = alloc(nargs * 8 + 8);
        ap = 0;
        argp = load64(g_nd_a + nd * 8);
        while argp != 0 {
            cg_gen_expr(argp);
            svp = cg_alloc_scratch();
            em_mov_mr(EM_RSP, svp, EM_RAX);
            store64(slotsp + ap * 8, svp);
            ap = ap + 1;
            argp = load64(g_nd_c + argp * 8);
        }
        # outgoing args = slots 1..ap-1 -> RCX/RDX/R8/R9, then stack [rsp + 8*j]
        if ap >= 2 { em_mov_rm(EM_RCX, EM_RSP, load64(slotsp + 1 * 8)); }
        if ap >= 3 { em_mov_rm(EM_RDX, EM_RSP, load64(slotsp + 2 * 8)); }
        if ap >= 4 { em_mov_rm(EM_R8,  EM_RSP, load64(slotsp + 3 * 8)); }
        if ap >= 5 { em_mov_rm(EM_R9,  EM_RSP, load64(slotsp + 4 * 8)); }
        j = 4;
        while j + 1 < ap {                                   # outgoing arg j (0-based) for j>=4 -> [rsp+8*j]
            em_mov_rm(EM_RAX, EM_RSP, load64(slotsp + (1 + j) * 8));
            em_mov_mr(EM_RSP, 8 * j, EM_RAX);
            j = j + 1;
        }
        em_mov_rm(EM_RAX, EM_RSP, load64(slotsp + 0 * 8));   # target pointer -> RAX
        em_call_rax();
        em_movsxd_rax();                                     # 32-bit / HRESULT return -> sign-extended
        cg_free_scratch(ap);
        free(slotsp);
        return 0;
    }

    # ---- callpp(fnptr, args...) : callp but the return is a full 64-bit POINTER/handle ----
    # Identical dispatch, NO sign-extension - for indirect calls that return a pointer the
    # caller must keep intact (e.g. GetProcAddress'd pcap_open_live/pcap_next). Mirrors anclc.cpp.
    if cg_fname_is(name_off, name_len, "callpp") == 1 {
        slotsq = alloc(nargs * 8 + 8);
        aq = 0;
        argq = load64(g_nd_a + nd * 8);
        while argq != 0 {
            cg_gen_expr(argq);
            svq = cg_alloc_scratch();
            em_mov_mr(EM_RSP, svq, EM_RAX);
            store64(slotsq + aq * 8, svq);
            aq = aq + 1;
            argq = load64(g_nd_c + argq * 8);
        }
        # outgoing args = slots 1..aq-1 -> RCX/RDX/R8/R9, then stack [rsp + 8*j]
        if aq >= 2 { em_mov_rm(EM_RCX, EM_RSP, load64(slotsq + 1 * 8)); }
        if aq >= 3 { em_mov_rm(EM_RDX, EM_RSP, load64(slotsq + 2 * 8)); }
        if aq >= 4 { em_mov_rm(EM_R8,  EM_RSP, load64(slotsq + 3 * 8)); }
        if aq >= 5 { em_mov_rm(EM_R9,  EM_RSP, load64(slotsq + 4 * 8)); }
        jq = 4;
        while jq + 1 < aq {                                  # outgoing arg j (0-based) for j>=4 -> [rsp+8*j]
            em_mov_rm(EM_RAX, EM_RSP, load64(slotsq + (1 + jq) * 8));
            em_mov_mr(EM_RSP, 8 * jq, EM_RAX);
            jq = jq + 1;
        }
        em_mov_rm(EM_RAX, EM_RSP, load64(slotsq + 0 * 8));   # target pointer -> RAX
        em_call_rax();                                       # RAX = full 64-bit return, kept as-is
        cg_free_scratch(aq);
        free(slotsq);
        return 0;
    }

    # ---- tool registry accessors (feature #2) ----
    if cg_fname_is(name_off, name_len, "tool_count") == 1 {
        em_mov_ri(EM_RAX, load64(g_tool_count));
        return 0;
    }
    if cg_fname_is(name_off, name_len, "tools_json") == 1 {
        em_lea_rip(EM_RAX, 1, load64(g_tools_json_sid));
        return 0;
    }
    if cg_fname_is(name_off, name_len, "tool_name") == 1 {
        cg_tool_index_accessor(nd, 0);
        return 0;
    }
    if cg_fname_is(name_off, name_len, "tool_schema") == 1 {
        cg_tool_index_accessor(nd, 1);
        return 0;
    }
    if cg_fname_is(name_off, name_len, "tool_fn") == 1 {
        cg_tool_index_accessor(nd, 2);
        return 0;
    }

    # ---- General Win32 import or user function ----
    # Resolve the callee first so we know its declared param kinds (f64 convergence).
    fi2    = cg_fn_find(name_off, name_len);
    isusr2 = 0;
    if fi2 != 0 - 1 { isusr2 = 1; }
    isimp2 = 0;
    if cg_imp_find(name_off, name_len) != 0 - 1 { isimp2 = 1; }

    # Evaluate all args into scratch slots, converging each onto the param's kind:
    # int -> f64 param promotes (cvtsi2sd); f64 -> int param (user fn) truncates (cvttsd2si).
    # An import declares no param types, so a float arg stays float (placed in XMM below).
    slots2 = alloc(nargs * 8 + 8);
    argf2  = alloc(nargs * 8 + 8);
    ai2 = 0;
    arg2 = load64(g_nd_a + nd * 8);
    while arg2 != 0 {
        cg_gen_expr(arg2);                                # arg -> XMM0 (if float) or RAX
        af2 = load64(g_nd_isfloat + arg2 * 8);
        pf2 = 0;
        if isusr2 == 1 { if cg_fn_param_isfloat(fi2, ai2) == 1 { pf2 = 1; } }
        if pf2 == 1 { if af2 == 0 { em_cvtsi2sd(0, EM_RAX); af2 = 1; } }
        if pf2 == 0 { if af2 == 1 { if isusr2 == 1 { em_cvttsd2si(EM_RAX, 0); af2 = 0; } } }
        sv2 = cg_alloc_scratch();
        if af2 == 1 { em_movsd_mx(EM_RSP, sv2, 0); }
        if af2 == 0 { em_mov_mr(EM_RSP, sv2, EM_RAX); }
        store64(slots2 + ai2 * 8, sv2);
        store64(argf2  + ai2 * 8, af2);
        ai2 = ai2 + 1;
        arg2 = load64(g_nd_c + arg2 * 8);
    }
    # --target=linux-dyn: a user `extern "libX.so" fn` (dlopen/dlsym/...) is a DYNAMIC import. Marshal
    # System V (RDI/RSI/RDX/RCX/R8/R9, NO shadow space; overflow at [rsp+0..]) + call via .got.plt
    # (BIND_NOW). rsp is 16-aligned here (the genFunc frame invariant), matching the SysV rule. Inert
    # unless --target=linux-dyn AND the name is a user extern -> PE/static-ELF output is byte-identical.
    cdyn = 0;
    if load64(g_targetlinuxdyn) == 1 { if isusr2 == 0 { if cg_ext_find(name_off, name_len) != 0 - 1 { cdyn = 1; } } }
    if cdyn == 1 {
        sysv = alloc(6 * 8);
        store64(sysv + 0,  EM_RDI); store64(sysv + 8,  EM_RSI); store64(sysv + 16, EM_RDX);
        store64(sysv + 24, EM_RCX); store64(sysv + 32, EM_R8);  store64(sysv + 40, EM_R9);
        kd = 0;
        while kd < ai2 {
            if kd < 6 { em_mov_rm(load64(sysv + kd * 8), EM_RSP, load64(slots2 + kd * 8)); }
            if kd >= 6 { em_mov_rm(EM_RAX, EM_RSP, load64(slots2 + kd * 8)); em_mov_mr(EM_RSP, (kd - 6) * 8, EM_RAX); }
            kd = kd + 1;
        }
        free(sysv);
        em_xor_rr(EM_RAX, EM_RAX);                                   # AL=0: no vector args (SysV varargs rule)
        em_call_dynimport(cg_use_dynimport(name_off, name_len));
        cg_extend_ret(name_off, name_len);                           # '-> ptr' externs keep the full 64-bit RAX
        cg_free_scratch(ai2);
        free(slots2);
        free(argf2);
        return 0;
    }
    # Place args positionally: float arg k -> XMMk (+ GP-reg mirror for imports/varargs);
    # int arg k -> RCX/RDX/R8/R9; args 5+ -> stack at [rsp + 8*k] as raw bits.
    arg_regs2 = alloc(4 * 8);
    store64(arg_regs2 + 0,  EM_RCX);
    store64(arg_regs2 + 8,  EM_RDX);
    store64(arg_regs2 + 16, EM_R8);
    store64(arg_regs2 + 24, EM_R9);
    kk = 0;
    while kk < ai2 {
        if kk < 4 {
            if load64(argf2 + kk * 8) == 1 {
                em_movsd_xm(kk, EM_RSP, load64(slots2 + kk * 8));
                if isimp2 == 1 { em_mov_rm(load64(arg_regs2 + kk * 8), EM_RSP, load64(slots2 + kk * 8)); }
            }
            if load64(argf2 + kk * 8) == 0 {
                em_mov_rm(load64(arg_regs2 + kk * 8), EM_RSP, load64(slots2 + kk * 8));
            }
        }
        if kk >= 4 {
            em_mov_rm(EM_RAX, EM_RSP, load64(slots2 + kk * 8));
            em_mov_mr(EM_RSP, kk * 8, EM_RAX);
        }
        kk = kk + 1;
    }
    free(arg_regs2);
    cg_free_scratch(ai2);
    free(slots2);
    free(argf2);

    # Dispatch: user function or import?
    if isusr2 == 1 {
        em_call_label(load64(g_fn_label + fi2 * 8));
        return 0;
    }
    ii = cg_imp_find(name_off, name_len);
    if ii != 0 - 1 {
        # M5: under --target=linux there are no Windows imports; a builtin-import name with no
        # user shim (the user-func branch above already handled shims) is a clean compile error.
        if load64(g_targetlinux) == 1 { syscall 1, cg_err_no_shim; ExitProcess(1); }
        em_call_import(ii);
        cg_extend_ret(name_off, name_len);   # '-> f64' externs set g_ext_ptr=1, so this skips sign-extend
        return 0;
    }
    # Unknown call -- emit call to label 0 (will fail to link gracefully)
    em_mov_ri(EM_RAX, 0);
    return 0;
}

# ================================================================
#  cg_gen_stmt(nd)
# ================================================================
func cg_gen_stmt(nd: i64) -> i64 {
    if nd == 0 { return 0; }
    kind = load64(g_nd_kind + nd * 8);

    # ST_ASSIGN
    if kind == ST_ASSIGN {
        noff = load64(g_nd_name    + nd * 8);
        nlen = load64(g_nd_namelen + nd * 8);
        rhs  = load64(g_nd_a + nd * 8);
        cg_gen_expr(rhs);                            # RHS -> XMM0 (if float) or RAX
        loff = cg_local_slot(noff, nlen);
        if loff == 0 - 1 {
            loff = cg_local_alloc(noff, nlen);
        }
        tf = load64(g_nd_isfloat + nd  * 8);         # target is an f64 slot?
        rf = load64(g_nd_isfloat + rhs * 8);         # RHS produced an f64?
        if tf == 1 {
            if rf == 0 { em_cvtsi2sd(0, EM_RAX); }   # int RHS -> f64 slot
            em_movsd_mx(EM_RSP, loff, 0);
            return 0;
        }
        if rf == 1 { em_cvttsd2si(EM_RAX, 0); }      # f64 RHS -> int slot (truncate)
        em_mov_mr(EM_RSP, loff, EM_RAX);
        return 0;
    }

    # ST_EXPRSTMT
    if kind == ST_EXPRSTMT {
        cg_gen_expr(load64(g_nd_a + nd * 8));
        return 0;
    }

    # ST_RETURN
    if kind == ST_RETURN {
        rexpr = load64(g_nd_a + nd * 8);
        cg_gen_expr(rexpr);
        ef  = load64(g_nd_isfloat + rexpr * 8);
        crf = load64(g_cg_ret_float);
        if crf == 1 { if ef == 0 { em_cvtsi2sd(0, EM_RAX); } }    # int expr -> f64 return (XMM0)
        if crf == 0 { if ef == 1 { em_cvttsd2si(EM_RAX, 0); } }   # f64 expr -> int return (RAX)
        em_jmp(load64(g_cg_ret_label));
        return 0;
    }

    # ST_IF
    if kind == ST_IF {
        lelse = em_label_new();
        lend  = em_label_new();
        cg_gen_expr(load64(g_nd_a + nd * 8));
        em_test_rr(EM_RAX, EM_RAX);
        em_jz(lelse);
        # then-body: linked via g_nd_c chain
        s = load64(g_nd_b + nd * 8);
        while s != 0 {
            cg_gen_stmt(s);
            s = load64(g_nd_c + s * 8);
        }
        em_jmp(lend);
        em_label_place(lelse);
        # else-body: head is in g_nd_name (see parser note); siblings via g_nd_c
        s = load64(g_nd_name + nd * 8);
        while s != 0 {
            cg_gen_stmt(s);
            s = load64(g_nd_c + s * 8);
        }
        em_label_place(lend);
        return 0;
    }

    # ST_LOOP
    if kind == ST_LOOP {
        ltop = em_label_new();
        lend = em_label_new();
        em_label_place(ltop);
        cg_gen_expr(load64(g_nd_a + nd * 8));
        em_test_rr(EM_RAX, EM_RAX);
        em_jz(lend);
        # push loop stack
        depth = load64(g_loop_depth);
        store64(g_loop_cont + depth * 8, ltop);
        store64(g_loop_brk  + depth * 8, lend);
        store64(g_loop_depth, depth + 1);
        s = load64(g_nd_b + nd * 8);
        while s != 0 {
            cg_gen_stmt(s);
            s = load64(g_nd_c + s * 8);
        }
        depth = load64(g_loop_depth);
        store64(g_loop_depth, depth - 1);
        em_jmp(ltop);
        em_label_place(lend);
        return 0;
    }

    # ST_BREAK
    if kind == ST_BREAK {
        depth = load64(g_loop_depth);
        if depth > 0 {
            em_jmp(load64(g_loop_brk + (depth - 1) * 8));
        }
        return 0;
    }

    # ST_CONTINUE
    if kind == ST_CONTINUE {
        depth = load64(g_loop_depth);
        if depth > 0 {
            em_jmp(load64(g_loop_cont + (depth - 1) * 8));
        }
        return 0;
    }

    # ST_SYSCALL (syscall 1 = print)
    if kind == ST_SYSCALL {
        sysno = load64(g_nd_ival + nd * 8);
        if sysno == 1 {
            arg = load64(g_nd_a + nd * 8);
            while arg != 0 {
                akind = load64(g_nd_kind + arg * 8);
                # string literal -> print as text
                if akind == ND_STR {
                    sid = load64(g_nd_ival + arg * 8);
                    slen = load64(g_str_len + sid * 8);
                    em_lea_rip(EM_RCX, 1, sid);
                    em_mov_ri(EM_RDX, slen);
                    em_call_label(load64(L_print_str));
                    arg = load64(g_nd_c + arg * 8);
                    akind = 0 - 1;   # handled
                }
                if akind == ND_VAR {
                    # check if it's a data str
                    anoff = load64(g_nd_name    + arg * 8);
                    anlen = load64(g_nd_namelen + arg * 8);
                    vi3   = cg_dv_find(anoff, anlen);
                    if vi3 != 0 - 1 {
                        if load64(g_dv_type + vi3 * 8) == DV_STR {
                            sid2  = load64(g_dv_strid + vi3 * 8);
                            slen2 = load64(g_str_len  + sid2 * 8);
                            em_lea_rip(EM_RCX, 1, sid2);
                            em_mov_ri(EM_RDX, slen2);
                            em_call_label(load64(L_print_str));
                            arg = load64(g_nd_c + arg * 8);
                            akind = 0 - 1;
                        }
                    }
                }
                if akind != 0 - 1 {
                    # integer expression -> print decimal
                    cg_gen_expr(arg);
                    em_mov_rr(EM_RCX, EM_RAX);
                    em_call_label(load64(L_print_int));
                    arg = load64(g_nd_c + arg * 8);
                }
            }
        }
        return 0;
    }

    return 0;
}

# ================================================================
#  cg_max_call_args -- scan a function body to find the maximum
#  outgoing argument count of any call, so the prologue can reserve
#  a big-enough outgoing-argument area at [rsp, argbase).
#
#  Without this, a function with <=4 params that CALLS a function
#  taking >4 args would write stack args 5+ at [rsp+32], [rsp+40], ...
#  which overlaps the caller's own locals (locals start at argbase=32)
#  -> the caller's locals get clobbered.  Mirrors the C++ bootstrap's
#  scanExprArgs/scanStmtArgs (compiler/anclc.cpp).
#
#  We count EVERY call's arg count (including intrinsics); over-
#  reserving the outgoing area is always safe, only slightly larger.
# ================================================================
func cg_count_call_args(nd: i64) -> i64 {
    n = 0;
    a = load64(g_nd_a + nd * 8);
    while a != 0 {
        n = n + 1;
        a = load64(g_nd_c + a * 8);
    }
    return n;
}

func cg_max_call_args_expr(e: i64) -> i64 {
    if e == 0 { return 0; }
    k = load64(g_nd_kind + e * 8);
    mx = 0;
    if k == ND_CALL {
        mx = cg_count_call_args(e);
        # recurse into each argument expression
        a = load64(g_nd_a + e * 8);
        while a != 0 {
            m2 = cg_max_call_args_expr(a);
            if m2 > mx { mx = m2; }
            a = load64(g_nd_c + a * 8);
        }
    }
    if k == ND_BINARY {
        ml = cg_max_call_args_expr(load64(g_nd_a + e * 8));
        mr = cg_max_call_args_expr(load64(g_nd_b + e * 8));
        if ml > mx { mx = ml; }
        if mr > mx { mx = mr; }
    }
    if k == ND_ADDR {
        ma = cg_max_call_args_expr(load64(g_nd_a + e * 8));
        if ma > mx { mx = ma; }
    }
    return mx;
}

func cg_max_call_args_body(s: i64) -> i64 {
    mx = 0;
    while s != 0 {
        sk = load64(g_nd_kind + s * 8);
        if sk == ST_ASSIGN   { m2 = cg_max_call_args_expr(load64(g_nd_a + s * 8)); if m2 > mx { mx = m2; } }
        if sk == ST_EXPRSTMT { m2 = cg_max_call_args_expr(load64(g_nd_a + s * 8)); if m2 > mx { mx = m2; } }
        if sk == ST_RETURN   { m2 = cg_max_call_args_expr(load64(g_nd_a + s * 8)); if m2 > mx { mx = m2; } }
        if sk == ST_IF {
            mc = cg_max_call_args_expr(load64(g_nd_a + s * 8)); if mc > mx { mx = mc; }
            mt = cg_max_call_args_body(load64(g_nd_b    + s * 8)); if mt > mx { mx = mt; }
            me = cg_max_call_args_body(load64(g_nd_name + s * 8)); if me > mx { mx = me; }
        }
        if sk == ST_LOOP {
            mc = cg_max_call_args_expr(load64(g_nd_a + s * 8)); if mc > mx { mx = mc; }
            mb = cg_max_call_args_body(load64(g_nd_b + s * 8)); if mb > mx { mx = mb; }
        }
        if sk == ST_SYSCALL {
            a = load64(g_nd_a + s * 8);
            while a != 0 {
                m2 = cg_max_call_args_expr(a); if m2 > mx { mx = m2; }
                a = load64(g_nd_c + a * 8);
            }
        }
        s = load64(g_nd_c + s * 8);
    }
    return mx;
}

# ================================================================
#  cg_collect_locals -- pre-scan a function body to find all
#  assignment targets so we can size the frame correctly
# ================================================================
func cg_collect_locals_body(s: i64) -> i64 {
    while s != 0 {
        sk = load64(g_nd_kind + s * 8);
        if sk == ST_ASSIGN {
            noff = load64(g_nd_name    + s * 8);
            nlen = load64(g_nd_namelen + s * 8);
            if cg_local_slot(noff, nlen) == 0 - 1 {
                cg_local_alloc(noff, nlen);
            }
        }
        if sk == ST_IF {
            cg_collect_locals_body(load64(g_nd_b    + s * 8));   # then-head
            cg_collect_locals_body(load64(g_nd_name + s * 8));   # else-head (see parser note)
        }
        if sk == ST_LOOP {
            cg_collect_locals_body(load64(g_nd_b + s * 8));
        }
        s = load64(g_nd_c + s * 8);
    }
    return 0;
}

# ================================================================
#  cg_gen_func(fi) -- generate code for function index fi
# ================================================================
func cg_gen_func(fi: i64) -> i64 {
    # Place function label
    lbl = load64(g_fn_label + fi * 8);
    em_label_place(lbl);

    # Reset per-function state
    store64(g_cg_loc_count, 0);
    store64(g_cg_scratch_top, 0);
    store64(g_loop_depth, 0);
    store64(g_cg_ret_float, load64(g_fn_retfloat + fi * 8));   # f64 return -> Return/fallthrough use XMM0

    np = load64(g_fn_nparams + fi * 8);
    # Frame: outgoing-arg area + locals + scratch.
    # The outgoing-arg area at [rsp, argbase) must hold the shadow space
    # (>=32B) AND any stack-passed args (5th+) of calls THIS function makes.
    # So argbase = max(4, nparams, max_outgoing_call_args) * 8.
    # (Previously argbase ignored callee arity, so calling a >4-arg function
    #  clobbered this function's own locals -> e.g. the lexer broke.)
    max_args = cg_max_call_args_body(load64(g_fn_body + fi * 8));
    slots = 4;
    if np > slots       { slots = np; }
    if max_args > slots { slots = max_args; }
    argbase = slots * 8;
    store64(g_cg_frame_argbase, argbase);

    # Spill params into locals first
    i = 0;
    while i < np {
        ptoff = load64(g_fn_params + fi * 128 + i * 16 + 0);
        ptlen = load64(g_fn_params + fi * 128 + i * 16 + 8);
        cg_local_alloc(ptoff, ptlen);
        i = i + 1;
    }

    # Scan function body to discover all local names
    cg_collect_locals_body(load64(g_fn_body + fi * 8));

    nloc = load64(g_cg_loc_count);

    # scratch area starts after locals
    scratch_base = argbase + nloc * 8;
    store64(g_cg_scratch_base, scratch_base);

    SCRATCH_SLOTS = 48;
    frame_n = argbase + nloc * 8 + SCRATCH_SLOTS * 8;
    # Ensure rsp % 16 == 0 after the call (which pushes 8-byte return addr)
    if frame_n % 16 == 0 { frame_n = frame_n + 8; }
    store64(g_cg_frame_n, frame_n);

    ret_lbl = em_label_new();
    store64(g_cg_ret_label, ret_lbl);

    # Prologue: sub rsp, frame_n
    em_sub_ri(EM_RSP, frame_n);

    # Spill incoming params from registers / caller stack
    arg_regs = alloc(4 * 8);
    store64(arg_regs + 0,  EM_RCX);
    store64(arg_regs + 8,  EM_RDX);
    store64(arg_regs + 16, EM_R8);
    store64(arg_regs + 24, EM_R9);
    i = 0;
    while i < np {
        loff = cg_local_slot(load64(g_fn_params + fi * 128 + i * 16 + 0),
                             load64(g_fn_params + fi * 128 + i * 16 + 8));
        pflt2 = cg_fn_param_isfloat(fi, i);
        if i < 4 {
            if pflt2 == 1 { em_movsd_mx(EM_RSP, loff, i); }                        # f64 param arrives in XMMi
            if pflt2 == 0 { em_mov_mr(EM_RSP, loff, load64(arg_regs + i * 8)); }
        }
        if i >= 4 {
            # param came from caller stack at [rsp + frame_n + 8 + 8*i] (raw bits, float or int)
            em_mov_rm(EM_RAX, EM_RSP, frame_n + 8 + 8 * i);
            em_mov_mr(EM_RSP, loff, EM_RAX);
        }
        i = i + 1;
    }
    free(arg_regs);

    # Generate function body
    s = load64(g_fn_body + fi * 8);
    while s != 0 {
        cg_gen_stmt(s);
        s = load64(g_nd_c + s * 8);
    }

    # Fallthrough return 0 (an f64 function zeroes XMM0 too)
    em_mov_ri(EM_RAX, 0);
    if load64(g_cg_ret_float) == 1 { em_movq_xr(0, EM_RAX); }
    em_label_place(ret_lbl);
    em_add_ri(EM_RSP, frame_n);
    em_ret();
    return 0;
}

# ================================================================
#  Runtime helpers  (hand-encoded, matching anclc.cpp exactly)
# ================================================================

# __print_str(rcx=ptr, rdx=len)
func cg_emit_print_str() -> i64 {
    em_label_place(load64(L_print_str));
    if load64(g_targetlinux) == 1 {
        # Linux: write(rdi=1 stdout, rsi=ptr, rdx=len) ; entered with RCX=ptr, RDX=len
        em_mov_rr(EM_RSI, EM_RCX);
        em_mov_ri(EM_RDI, 1);
        em_mov_ri(EM_RAX, 1);          # sys_write (rdx already = len)
        em_syscall();
        em_ret();
        return 0;
    }
    em_sub_ri(EM_RSP, 72);
    em_mov_mr(EM_RSP, 48, EM_RCX);
    em_mov_mr(EM_RSP, 56, EM_RDX);
    em_mov_ri(EM_RCX, 0 - 11);
    em_call_import(IMP_GetStdHandle);
    em_mov_rr(EM_RCX, EM_RAX);
    em_xor_rr(EM_RAX, EM_RAX);
    em_mov_mr(EM_RSP, 32, EM_RAX);
    em_mov_rm(EM_RDX, EM_RSP, 48);
    em_mov_rm(EM_R8,  EM_RSP, 56);
    em_lea_mem(EM_R9, EM_RSP, 40);
    em_call_import(IMP_WriteFile);
    em_add_ri(EM_RSP, 72);
    em_ret();
    return 0;
}

# __print_int(rcx=value) -- itoa then print_str
func cg_emit_print_int() -> i64 {
    em_label_place(load64(L_print_int));
    # frame: [0..32) shadow, [32..64) buffer, [64..72) value, [72..80) p, [80..88) isNeg
    em_sub_ri(EM_RSP, 88);
    em_mov_mr(EM_RSP, 64, EM_RCX);
    em_xor_rr(EM_RAX, EM_RAX);
    em_mov_mr(EM_RSP, 80, EM_RAX);
    em_lea_mem(EM_RAX, EM_RSP, 64);
    em_mov_mr(EM_RSP, 72, EM_RAX);
    em_mov_rm(EM_RAX, EM_RSP, 64);
    em_test_rr(EM_RAX, EM_RAX);
    Lpos = em_label_new();
    em_jns(Lpos);
    em_mov_ri(EM_RCX, 1); em_mov_mr(EM_RSP, 80, EM_RCX);
    em_mov_rm(EM_RAX, EM_RSP, 64); em_neg(EM_RAX); em_mov_mr(EM_RSP, 64, EM_RAX);
    em_label_place(Lpos);
    Lloop = em_label_new();
    em_label_place(Lloop);
    em_mov_rm(EM_RAX, EM_RSP, 64);
    em_mov_ri(EM_RCX, 10);
    em_cqo(); em_idiv(EM_RCX);
    em_mov_mr(EM_RSP, 64, EM_RAX);
    em_add_ri(EM_RDX, 48);
    em_mov_rm(EM_RAX, EM_RSP, 72); em_sub_ri(EM_RAX, 1); em_mov_mr(EM_RSP, 72, EM_RAX);
    em_mov_mr8(EM_RAX, 0, EM_RDX);
    em_mov_rm(EM_RAX, EM_RSP, 64); em_test_rr(EM_RAX, EM_RAX);
    em_jnz(Lloop);
    em_mov_rm(EM_RAX, EM_RSP, 80); em_test_rr(EM_RAX, EM_RAX);
    Lprint = em_label_new();
    em_jz(Lprint);
    em_mov_rm(EM_RAX, EM_RSP, 72); em_sub_ri(EM_RAX, 1); em_mov_mr(EM_RSP, 72, EM_RAX);
    # '-' = 45
    em_mov_ri(EM_RCX, 45);
    em_mov_mr8(EM_RAX, 0, EM_RCX);
    em_label_place(Lprint);
    em_mov_rm(EM_RDX, EM_RSP, 72);
    em_lea_mem(EM_RAX, EM_RSP, 64);
    em_sub_rr(EM_RAX, EM_RDX);
    em_mov_rr(EM_RCX, EM_RDX);
    em_mov_rr(EM_RDX, EM_RAX);
    em_call_label(load64(L_print_str));
    em_add_ri(EM_RSP, 88);
    em_ret();
    return 0;
}

# __getch() -> rax
func cg_emit_getch() -> i64 {
    em_label_place(load64(L_getch));
    em_sub_ri(EM_RSP, 56);
    Lcheck = em_label_new();
    Lhave  = em_label_new();
    Leof   = em_label_new();
    em_label_place(Lcheck);
    # load inpos
    em_mov_rip_load(EM_RAX, 2, DAT_INPOS);
    em_mov_rip_load(EM_RCX, 2, DAT_INLEN);
    em_cmp_rr(EM_RAX, EM_RCX);
    em_jl(Lhave);
    # refill: read 256 bytes into inbuf -> RAX = bytesRead
    if load64(g_targetlinux) == 1 {
        em_mov_ri(EM_RDI, 0);               # fd = stdin
        em_lea_rip(EM_RSI, 2, DAT_INBUF);   # buffer
        em_mov_ri(EM_RDX, 256);             # count
        em_mov_ri(EM_RAX, 0);               # sys_read -> RAX = bytesRead
        em_syscall();
    }
    if load64(g_targetlinux) == 0 {
        em_mov_ri(EM_RCX, 0 - 10);
        em_call_import(IMP_GetStdHandle);
        em_mov_rr(EM_RCX, EM_RAX);
        em_lea_rip(EM_RDX, 2, DAT_INBUF);
        em_mov_ri(EM_R8, 256);
        em_lea_mem(EM_R9, EM_RSP, 40);
        em_xor_rr(EM_RAX, EM_RAX);
        em_mov_mr(EM_RSP, 32, EM_RAX);
        em_mov_mr(EM_RSP, 40, EM_RAX);
        em_call_import(IMP_ReadFile);
        em_mov_rm(EM_RAX, EM_RSP, 40);
    }
    em_mov_rip_store(EM_RAX, 2, DAT_INLEN);
    em_xor_rr(EM_RAX, EM_RAX);
    em_mov_rip_store(EM_RAX, 2, DAT_INPOS);
    em_mov_rip_load(EM_RAX, 2, DAT_INLEN); em_test_rr(EM_RAX, EM_RAX);
    em_jz(Leof);
    em_jmp(Lcheck);
    em_label_place(Leof);
    em_mov_ri(EM_RAX, 0 - 1);
    em_add_ri(EM_RSP, 56); em_ret();
    em_label_place(Lhave);
    em_mov_rip_load(EM_RAX, 2, DAT_INPOS);
    em_lea_rip(EM_RCX, 2, DAT_INBUF);
    em_add_rr(EM_RCX, EM_RAX);
    em_movzx_rm8(EM_RDX, EM_RCX, 0);
    em_add_ri(EM_RAX, 1);
    em_mov_rip_store(EM_RAX, 2, DAT_INPOS);
    em_mov_rr(EM_RAX, EM_RDX);
    em_add_ri(EM_RSP, 56); em_ret();
    return 0;
}

# __read_char() -> rax (first non-whitespace char, 0 on EOF)
func cg_emit_read_char() -> i64 {
    em_label_place(load64(L_read_char));
    em_sub_ri(EM_RSP, 40);
    Lloop = em_label_new(); Leof2 = em_label_new(); Ldone = em_label_new();
    em_label_place(Lloop);
    em_call_label(load64(L_getch));
    em_cmp_ri(EM_RAX, 0 - 1); em_je(Leof2);
    em_cmp_ri(EM_RAX, 32); em_je(Lloop);
    em_cmp_ri(EM_RAX, 10); em_je(Lloop);
    em_cmp_ri(EM_RAX, 13); em_je(Lloop);
    em_cmp_ri(EM_RAX, 9);  em_je(Lloop);
    em_jmp(Ldone);
    em_label_place(Leof2);
    em_xor_rr(EM_RAX, EM_RAX);
    em_label_place(Ldone);
    em_add_ri(EM_RSP, 40); em_ret();
    return 0;
}

# __read_int() -> rax
func cg_emit_read_int() -> i64 {
    em_label_place(load64(L_read_int));
    em_sub_ri(EM_RSP, 56);
    em_xor_rr(EM_RAX, EM_RAX);
    em_mov_mr(EM_RSP, 32, EM_RAX);
    em_mov_mr(EM_RSP, 40, EM_RAX);
    Lskip  = em_label_new(); Ldone0 = em_label_new(); Lchk = em_label_new();
    Ldloop = em_label_new(); Lend   = em_label_new(); Lpos2 = em_label_new();
    em_label_place(Lskip);
    em_call_label(load64(L_getch));
    em_cmp_ri(EM_RAX, 0 - 1); em_je(Ldone0);
    em_cmp_ri(EM_RAX, 32); em_je(Lskip);
    em_cmp_ri(EM_RAX, 10); em_je(Lskip);
    em_cmp_ri(EM_RAX, 13); em_je(Lskip);
    em_cmp_ri(EM_RAX, 9);  em_je(Lskip);
    em_cmp_ri(EM_RAX, 45); em_jne(Lchk);
    em_mov_ri(EM_RCX, 1); em_mov_mr(EM_RSP, 40, EM_RCX);
    em_call_label(load64(L_getch));
    em_label_place(Lchk);
    em_label_place(Ldloop);
    em_mov_mr(EM_RSP, 48, EM_RAX);
    em_mov_rr(EM_RCX, EM_RAX);
    em_cmp_ri(EM_RCX, 48); em_jl(Lend);
    em_cmp_ri(EM_RCX, 57); em_jg(Lend);
    em_mov_rm(EM_RAX, EM_RSP, 32);
    em_mov_ri(EM_RCX, 10); em_imul_rr(EM_RAX, EM_RCX);
    em_mov_rm(EM_RCX, EM_RSP, 48); em_sub_ri(EM_RCX, 48);
    em_add_rr(EM_RAX, EM_RCX);
    em_mov_mr(EM_RSP, 32, EM_RAX);
    em_call_label(load64(L_getch));
    em_jmp(Ldloop);
    em_label_place(Lend);
    em_mov_rm(EM_RAX, EM_RSP, 32);
    em_mov_rm(EM_RCX, EM_RSP, 40); em_test_rr(EM_RCX, EM_RCX); em_jz(Lpos2);
    em_neg(EM_RAX);
    em_label_place(Lpos2);
    em_add_ri(EM_RSP, 56); em_ret();
    em_label_place(Ldone0);
    em_xor_rr(EM_RAX, EM_RAX);
    em_add_ri(EM_RSP, 56); em_ret();
    return 0;
}

# __int_to_str(rcx=dest, rdx=value)
func cg_emit_int_to_str() -> i64 {
    em_label_place(load64(L_int_to_str));
    em_sub_ri(EM_RSP, 64);
    em_mov_mr(EM_RSP, 48, EM_RCX);
    em_mov_mr(EM_RSP, 32, EM_RDX);
    em_xor_rr(EM_RAX, EM_RAX); em_mov_mr(EM_RSP, 56, EM_RAX);
    em_lea_mem(EM_RAX, EM_RSP, 32); em_mov_mr(EM_RSP, 40, EM_RAX);
    em_mov_rm(EM_RAX, EM_RSP, 32); em_test_rr(EM_RAX, EM_RAX);
    Lpos3 = em_label_new();
    em_jns(Lpos3);
    em_mov_ri(EM_RCX, 1); em_mov_mr(EM_RSP, 56, EM_RCX);
    em_mov_rm(EM_RAX, EM_RSP, 32); em_neg(EM_RAX); em_mov_mr(EM_RSP, 32, EM_RAX);
    em_label_place(Lpos3);
    Lloop2 = em_label_new();
    em_label_place(Lloop2);
    em_mov_rm(EM_RAX, EM_RSP, 32); em_mov_ri(EM_RCX, 10); em_cqo(); em_idiv(EM_RCX);
    em_mov_mr(EM_RSP, 32, EM_RAX);
    em_add_ri(EM_RDX, 48);
    em_mov_rm(EM_RAX, EM_RSP, 40); em_sub_ri(EM_RAX, 1); em_mov_mr(EM_RSP, 40, EM_RAX);
    em_mov_mr8(EM_RAX, 0, EM_RDX);
    em_mov_rm(EM_RAX, EM_RSP, 32); em_test_rr(EM_RAX, EM_RAX); em_jnz(Lloop2);
    em_mov_rm(EM_RAX, EM_RSP, 56); em_test_rr(EM_RAX, EM_RAX);
    Lcopy = em_label_new();
    em_jz(Lcopy);
    em_mov_rm(EM_RAX, EM_RSP, 40); em_sub_ri(EM_RAX, 1); em_mov_mr(EM_RSP, 40, EM_RAX);
    em_mov_ri(EM_RCX, 45); em_mov_mr8(EM_RAX, 0, EM_RCX);
    em_label_place(Lcopy);
    Lcl = em_label_new(); Ldone2 = em_label_new();
    em_label_place(Lcl);
    em_mov_rm(EM_RAX, EM_RSP, 40);
    em_lea_mem(EM_RCX, EM_RSP, 32);
    em_cmp_rr(EM_RAX, EM_RCX); em_jge(Ldone2);
    em_movzx_rm8(EM_RDX, EM_RAX, 0);
    em_mov_rm(EM_RCX, EM_RSP, 48);
    em_mov_mr8(EM_RCX, 0, EM_RDX);
    em_add_ri(EM_RCX, 1); em_mov_mr(EM_RSP, 48, EM_RCX);
    em_mov_rm(EM_RAX, EM_RSP, 40); em_add_ri(EM_RAX, 1); em_mov_mr(EM_RSP, 40, EM_RAX);
    em_jmp(Lcl);
    em_label_place(Ldone2);
    em_mov_rm(EM_RCX, EM_RSP, 48); em_xor_rr(EM_RAX, EM_RAX); em_mov_mr8(EM_RCX, 0, EM_RAX);
    em_add_ri(EM_RSP, 64); em_ret();
    return 0;
}

# __puts_cstr(rcx=addr)
func cg_emit_puts_cstr() -> i64 {
    em_label_place(load64(L_puts_cstr));
    em_sub_ri(EM_RSP, 40);
    em_mov_mr(EM_RSP, 32, EM_RCX);
    em_mov_rr(EM_RAX, EM_RCX);
    Llen = em_label_new(); Lend2 = em_label_new();
    em_label_place(Llen);
    em_movzx_rm8(EM_RDX, EM_RAX, 0); em_test_rr(EM_RDX, EM_RDX); em_jz(Lend2);
    em_add_ri(EM_RAX, 1); em_jmp(Llen);
    em_label_place(Lend2);
    em_mov_rm(EM_RCX, EM_RSP, 32);
    em_sub_rr(EM_RAX, EM_RCX);
    em_mov_rr(EM_RDX, EM_RAX);
    em_call_label(load64(L_print_str));
    em_add_ri(EM_RSP, 40); em_ret();
    return 0;
}

# __str_to_int(rcx=addr) -> rax
func cg_emit_str_to_int() -> i64 {
    em_label_place(load64(L_str_to_int));
    em_sub_ri(EM_RSP, 56);
    em_mov_mr(EM_RSP, 48, EM_RCX);
    em_xor_rr(EM_RAX, EM_RAX); em_mov_mr(EM_RSP, 32, EM_RAX); em_mov_mr(EM_RSP, 40, EM_RAX);
    Lskip2 = em_label_new(); Lsign = em_label_new(); Ldl = em_label_new();
    Lend3  = em_label_new(); Lpos4 = em_label_new();
    em_label_place(Lskip2);
    em_mov_rm(EM_RAX, EM_RSP, 48); em_movzx_rm8(EM_RDX, EM_RAX, 0);
    em_cmp_ri(EM_RDX, 32); em_jne(Lsign);
    em_mov_rm(EM_RAX, EM_RSP, 48); em_add_ri(EM_RAX, 1); em_mov_mr(EM_RSP, 48, EM_RAX); em_jmp(Lskip2);
    em_label_place(Lsign);
    em_mov_rm(EM_RAX, EM_RSP, 48); em_movzx_rm8(EM_RDX, EM_RAX, 0);
    em_cmp_ri(EM_RDX, 45); em_jne(Ldl);
    em_mov_ri(EM_RCX, 1); em_mov_mr(EM_RSP, 40, EM_RCX);
    em_mov_rm(EM_RAX, EM_RSP, 48); em_add_ri(EM_RAX, 1); em_mov_mr(EM_RSP, 48, EM_RAX);
    em_label_place(Ldl);
    em_mov_rm(EM_RAX, EM_RSP, 48); em_movzx_rm8(EM_RDX, EM_RAX, 0);
    em_cmp_ri(EM_RDX, 48); em_jl(Lend3);
    em_cmp_ri(EM_RDX, 57); em_jg(Lend3);
    em_mov_rm(EM_RAX, EM_RSP, 32); em_mov_ri(EM_RCX, 10); em_imul_rr(EM_RAX, EM_RCX);
    em_sub_ri(EM_RDX, 48); em_add_rr(EM_RAX, EM_RDX);
    em_mov_mr(EM_RSP, 32, EM_RAX);
    em_mov_rm(EM_RAX, EM_RSP, 48); em_add_ri(EM_RAX, 1); em_mov_mr(EM_RSP, 48, EM_RAX);
    em_jmp(Ldl);
    em_label_place(Lend3);
    em_mov_rm(EM_RAX, EM_RSP, 32); em_mov_rm(EM_RCX, EM_RSP, 40); em_test_rr(EM_RCX, EM_RCX); em_jz(Lpos4);
    em_neg(EM_RAX);
    em_label_place(Lpos4);
    em_add_ri(EM_RSP, 56); em_ret();
    return 0;
}

# __str_copy(rcx=dst, rdx=src) -> rax=ptr to NUL in dst
func cg_emit_str_copy() -> i64 {
    em_label_place(load64(L_str_copy));
    Lcs = em_label_new(); Lend4 = em_label_new();
    em_label_place(Lcs);
    em_movzx_rm8(EM_RAX, EM_RDX, 0);
    em_mov_mr8(EM_RCX, 0, EM_RAX);
    em_test_rr(EM_RAX, EM_RAX); em_jz(Lend4);
    em_add_ri(EM_RCX, 1); em_add_ri(EM_RDX, 1); em_jmp(Lcs);
    em_label_place(Lend4);
    em_mov_rr(EM_RAX, EM_RCX); em_ret();
    return 0;
}

# __memcpy(rcx=dst, rdx=src, r8=n) -> rax=dst
func cg_emit_memcpy() -> i64 {
    em_label_place(load64(L_memcpy));
    em_mov_rr(EM_R9, EM_RCX);
    Lmc = em_label_new(); Ldmc = em_label_new();
    em_label_place(Lmc);
    em_test_rr(EM_R8, EM_R8); em_jz(Ldmc);
    em_movzx_rm8(EM_RAX, EM_RDX, 0); em_mov_mr8(EM_RCX, 0, EM_RAX);
    em_add_ri(EM_RCX, 1); em_add_ri(EM_RDX, 1); em_sub_ri(EM_R8, 1); em_jmp(Lmc);
    em_label_place(Ldmc); em_mov_rr(EM_RAX, EM_R9); em_ret();
    return 0;
}

# __memset(rcx=dst, rdx=val, r8=n) -> rax=dst
func cg_emit_memset() -> i64 {
    em_label_place(load64(L_memset));
    em_mov_rr(EM_R9, EM_RCX);
    Lms = em_label_new(); Ldms = em_label_new();
    em_label_place(Lms);
    em_test_rr(EM_R8, EM_R8); em_jz(Ldms);
    em_mov_mr8(EM_RCX, 0, EM_RDX);
    em_add_ri(EM_RCX, 1); em_sub_ri(EM_R8, 1); em_jmp(Lms);
    em_label_place(Ldms); em_mov_rr(EM_RAX, EM_R9); em_ret();
    return 0;
}

# __strlen(rcx=s) -> rax=len
func cg_emit_strlen() -> i64 {
    em_label_place(load64(L_strlen));
    em_mov_rr(EM_RAX, EM_RCX);
    Lsl = em_label_new(); Ldsl = em_label_new();
    em_label_place(Lsl);
    em_movzx_rm8(EM_RDX, EM_RAX, 0); em_test_rr(EM_RDX, EM_RDX); em_jz(Ldsl);
    em_add_ri(EM_RAX, 1); em_jmp(Lsl);
    em_label_place(Ldsl); em_sub_rr(EM_RAX, EM_RCX); em_ret();
    return 0;
}

# __strcmp(rcx=a, rdx=b) -> rax  (0 if equal)
func cg_emit_strcmp() -> i64 {
    em_label_place(load64(L_strcmp));
    Lsx = em_label_new(); Ldsx = em_label_new();
    em_label_place(Lsx);
    em_movzx_rm8(EM_R8, EM_RCX, 0); em_movzx_rm8(EM_R9, EM_RDX, 0);
    em_mov_rr(EM_RAX, EM_R8); em_sub_rr(EM_RAX, EM_R9);
    em_test_rr(EM_RAX, EM_RAX); em_jnz(Ldsx);
    em_test_rr(EM_R8, EM_R8); em_jz(Ldsx);
    em_add_ri(EM_RCX, 1); em_add_ri(EM_RDX, 1); em_jmp(Lsx);
    em_label_place(Ldsx); em_ret();
    return 0;
}

# _start  -- entry point
func cg_emit_start() -> i64 {
    em_label_place(load64(L_start));
    if load64(g_targetlinux) == 1 {
        # System V: argc at [rsp], argv[] at [rsp+8..], NO return addr. Save the entry rsp into
        # DAT_ARGV (for GetCommandLineA) -- MUST be the FIRST emitted instruction (the find-main
        # loop below emits no code). No shadow space on Linux.
        em_mov_rip_store(EM_RSP, 2, DAT_ARGV);
    }
    if load64(g_targetlinux) == 0 {
        em_sub_ri(EM_RSP, 40);
    }
    # find main function
    main_fi = cg_fn_find(0, 0);   # 0,0 won't match - we'll look properly below
    main_fi = 0 - 1;
    i = 0;
    n = load64(g_fn_count);
    while i < n {
        noff = load64(g_fn_name    + i * 8);
        nlen = load64(g_fn_namelen + i * 8);
        if nlen == 4 {
            if load8(g_str_pool + noff + 0) == 109 {   # 'm'
                if load8(g_str_pool + noff + 1) == 97  {   # 'a'
                    if load8(g_str_pool + noff + 2) == 105 {   # 'i'
                        if load8(g_str_pool + noff + 3) == 110 {   # 'n'
                            main_fi = i;
                        }
                    }
                }
            }
        }
        i = i + 1;
    }
    if main_fi != 0 - 1 {
        em_call_label(load64(g_fn_label + main_fi * 8));
    }
    if main_fi == 0 - 1 { em_xor_rr(EM_RAX, EM_RAX); }
    if load64(g_targetlinux) == 1 {
        em_mov_rr(EM_RDI, EM_RAX);     # exit code = main()'s return
        em_mov_ri(EM_RAX, 231);        # exit_group(231)
        em_syscall();
        return 0;                       # never returns
    }
    em_mov_rr(EM_RCX, EM_RAX);
    em_call_import(IMP_ExitProcess);
    em_ret();
    return 0;
}

# ================================================================
#  cg_init() -- reset all codegen state, register built-in imports
# ================================================================
func cg_init() -> i64 {
    em_init();
    store64(g_imp_count, 0);
    store64(g_cg_data_size, DAT_BASE);
    if load64(g_targetlinux) == 1 { store64(g_cg_data_size, DAT_BASE + 8); }   # reserve [DAT_ARGV,+8) (Linux only)
    store64(g_cg_is_gui, 0);

    # Register fixed-slot imports (must be slots 0,1,2,3)
    cg_add_builtin("GetStdHandle",  "kernel32.dll");
    cg_add_builtin("WriteFile",     "kernel32.dll");
    cg_add_builtin("ReadFile",      "kernel32.dll");
    cg_add_builtin("ExitProcess",   "kernel32.dll");

    # Register remaining built-in kernel32
    cg_add_builtin("GetModuleHandleA", "kernel32.dll");
    cg_add_builtin("GetTickCount",     "kernel32.dll");
    cg_add_builtin("GetProcessHeap",   "kernel32.dll");
    cg_add_builtin("HeapAlloc",        "kernel32.dll");
    cg_add_builtin("HeapFree",         "kernel32.dll");
    cg_add_builtin("Sleep",            "kernel32.dll");
    cg_add_builtin("GetLastError",     "kernel32.dll");

    # ws2_32 built-ins
    cg_add_builtin("WSAStartup",   "ws2_32.dll");
    cg_add_builtin("socket",       "ws2_32.dll");
    cg_add_builtin("bind",         "ws2_32.dll");
    cg_add_builtin("listen",       "ws2_32.dll");
    cg_add_builtin("accept",       "ws2_32.dll");
    cg_add_builtin("recv",         "ws2_32.dll");
    cg_add_builtin("send",         "ws2_32.dll");
    cg_add_builtin("closesocket",  "ws2_32.dll");
    cg_add_builtin("htons",        "ws2_32.dll");

    # Register user extern declarations
    n = load64(g_ext_count);
    i = 0;
    while i < n {
        fn_off  = load64(g_ext_fn     + i * 8);
        fn_len  = load64(g_ext_fnlen  + i * 8);
        dll_off = load64(g_ext_dll    + i * 8);
        dll_len = load64(g_ext_dlllen + i * 8);
        cg_use_import(fn_off, fn_len, dll_off, dll_len);
        i = i + 1;
    }

    return 0;
}

# ================================================================
#  cg_assign_data_offsets() -- assign .data offsets to buf vars
# ================================================================
func cg_assign_data_offsets() -> i64 {
    off = DAT_BASE;
    if load64(g_targetlinux) == 1 { off = DAT_BASE + 8; }   # reserve [DAT_ARGV,+8) (Linux only)
    n   = load64(g_dv_count);
    i   = 0;
    while i < n {
        if load64(g_dv_type + i * 8) == DV_BUF {
            # align to 8
            if off % 8 != 0 { off = off + (8 - off % 8); }
            store64(g_dv_ival + i * 8, off);
            bufsz = load64(g_dv_bufsize + i * 8);
            # round up to 8
            if bufsz % 8 != 0 { bufsz = bufsz + (8 - bufsz % 8); }
            off = off + bufsz;
        }
        i = i + 1;
    }
    store64(g_cg_data_size, off);
    return 0;
}

# ================================================================
#  cg_run() -- main codegen entry point
# ================================================================
func cg_run() -> i64 {
    cg_init();
    cg_assign_data_offsets();

    # Allocate function labels
    n = load64(g_fn_count);
    i = 0;
    while i < n {
        lbl = em_label_new();
        store64(g_fn_label  + i * 8, lbl);
        store64(g_fn_arity  + i * 8, load64(g_fn_nparams + i * 8));
        i = i + 1;
    }

    # Allocate runtime helper labels
    store64(L_start,      em_label_new());
    store64(L_print_str,  em_label_new());
    store64(L_print_int,  em_label_new());
    store64(L_getch,      em_label_new());
    store64(L_read_char,  em_label_new());
    store64(L_read_int,   em_label_new());
    store64(L_int_to_str, em_label_new());
    store64(L_puts_cstr,  em_label_new());
    store64(L_str_to_int, em_label_new());
    store64(L_str_copy,   em_label_new());
    store64(L_memcpy,     em_label_new());
    store64(L_memset,     em_label_new());
    store64(L_strlen,     em_label_new());
    store64(L_strcmp,     em_label_new());

    # Emit entry point
    cg_emit_start();

    # f64 float-stamping pass: set g_nd_isfloat on every node before codegen
    cg_stamp_program();

    # Emit user functions
    i = 0;
    while i < n {
        cg_gen_func(i);
        i = i + 1;
    }

    # Emit runtime helpers
    cg_emit_print_str();
    cg_emit_print_int();
    cg_emit_getch();
    cg_emit_read_char();
    cg_emit_read_int();
    cg_emit_int_to_str();
    cg_emit_puts_cstr();
    cg_emit_str_to_int();
    cg_emit_str_copy();
    cg_emit_memcpy();
    cg_emit_memset();
    cg_emit_strlen();
    cg_emit_strcmp();

    return load64(g_code_len);
}
# ===================== END codegen.ancl =====================

# ===================== BEGIN pe_writer.ancl =====================
# =====================================================================
#  pe_writer.ancl  -  PE32+ binary writer for anclc2
#
#  Assembles sections, resolves fixups, and writes a native Windows
#  PE32+ executable (.exe) from the emitted code + data.
#
#  Sections: .text | .rdata | .data | .idata
# =====================================================================

@DATA
# Holds the entire output file image. file_size = text_raw + rdata_raw +
# idata_raw (the zero-init .data section is NOT written to file, see below).
# 4 MB comfortably holds the self-host image (~200 KB code + rdata + idata).
g_pe_img:      buf = 4194304;
g_pe_img_size: buf = 8;
g_pe_nwritten: buf = 8;

# Error strings
pe_err_open:  str = "[pe] cannot open output file\n";
pe_err_write: str = "[pe] write error\n";
pe_ok:        str = "[pe] written OK\n";

@CODE

# ----------------------------------------------------------------
#  pe_put_le(at, val, n)  -- write n bytes LE at offset in g_pe_img
# ----------------------------------------------------------------
func pe_put_le(at: i64, val: i64, n: i64) -> i64 {
    i = 0;
    while i < n {
        store8(g_pe_img + at + i, val % 256);
        val = shr(val, 8);
        i = i + 1;
    }
    return 0;
}

# ----------------------------------------------------------------
#  pe_align(v, a) -- round v up to multiple of a (power of 2)
# ----------------------------------------------------------------
func pe_align(v: i64, a: i64) -> i64 {
    if v % a == 0 { return v; }
    return v + (a - v % a);
}

# ----------------------------------------------------------------
#  pe_memcpy_to_img(dst_off, src, n)
# ----------------------------------------------------------------
func pe_memcpy_to_img(dst: i64, src: i64, n: i64) -> i64 {
    i = 0;
    while i < n {
        store8(g_pe_img + dst + i, load8(src + i));
        i = i + 1;
    }
    return 0;
}

# ----------------------------------------------------------------
#  pe_write(path_ptr) -> 0 on success, -1 on error
# ----------------------------------------------------------------
func pe_write(path: i64) -> i64 {
    SECT_ALIGN = 4096;
    FILE_ALIGN = 512;
    IMAGE_BASE = 5368709120;   # 0x140000000

    # ---- collect rdata (string table) ----
    # Strings are in g_strings[]; their offsets/lengths in g_str_off/g_str_len
    rdata_base = 0;   # offset within rdata buffer
    str_rva_table = alloc(512 * 8);   # rdata offset for each string
    rdata_buf  = alloc(65536);
    rdata_size = 0;
    nstrs = load64(g_str_count);
    i = 0;
    while i < nstrs {
        soff = load64(g_str_off + i * 8);
        slen = load64(g_str_len + i * 8);
        store64(str_rva_table + i * 8, rdata_size);
        # copy string bytes + NUL
        j = 0;
        while j <= slen {
            store8(rdata_buf + rdata_size + j, load8(g_strings + soff + j));
            j = j + 1;
        }
        rdata_size = rdata_size + slen + 1;
        i = i + 1;
    }
    if rdata_size == 0 { store8(rdata_buf, 0); rdata_size = 1; }

    # ---- build idata (.idata section: IDT + ILT + IAT + hint-name table + dll names) ----
    nimps = load64(g_imp_count);

    # Group imports by DLL (preserving first-appearance order)
    # Use parallel arrays: dll_name_off[], dll_func_start[], dll_func_count[]
    MAX_DLLS = 16;
    dll_name_off = alloc(MAX_DLLS * 8);
    dll_name_len = alloc(MAX_DLLS * 8);
    dll_func_list = alloc(nimps * 8);   # ordered list of import indices per dll
    dll_func_off  = alloc(MAX_DLLS * 8);  # index into dll_func_list for each dll
    dll_func_cnt  = alloc(MAX_DLLS * 8);
    ndlls = 0;
    dll_func_pos = 0;

    # Pass 1: collect the distinct DLL names in first-seen order.
    i = 0;
    while i < nimps {
        fn_dnoff  = load64(g_imp_dll    + i * 8);
        fn_dnlen  = load64(g_imp_dlllen + i * 8);
        di = 0 - 1;
        j = 0;
        while j < ndlls {
            if cg_pool_cmp(load64(dll_name_off + j*8), load64(dll_name_len + j*8), fn_dnoff, fn_dnlen) == 1 {
                di = j;
            }
            j = j + 1;
        }
        if di == 0 - 1 {
            store64(dll_name_off + ndlls * 8, fn_dnoff);
            store64(dll_name_len + ndlls * 8, fn_dnlen);
            ndlls = ndlls + 1;
        }
        i = i + 1;
    }

    # Pass 2: for each DLL, append ALL its imports to dll_func_list
    # contiguously.  This is robust to interleaved imports in g_imp_*
    # (the previous single-pass packing overwrote later DLLs' regions when
    # a DLL's functions were not contiguous, e.g. kernel32 externs declared
    # after the ws2_32 builtins corrupted the ws2_32 import group).
    dll_func_pos = 0;
    di = 0;
    while di < ndlls {
        store64(dll_func_off + di * 8, dll_func_pos);
        cnt_here = 0;
        i = 0;
        while i < nimps {
            if cg_pool_cmp(load64(g_imp_dll + i*8), load64(g_imp_dlllen + i*8), load64(dll_name_off + di*8), load64(dll_name_len + di*8)) == 1 {
                store64(dll_func_list + dll_func_pos * 8, i);
                dll_func_pos = dll_func_pos + 1;
                cnt_here = cnt_here + 1;
            }
            i = i + 1;
        }
        store64(dll_func_cnt + di * 8, cnt_here);
        di = di + 1;
    }

    # Compute idata layout
    idt_size   = (ndlls + 1) * 20;
    ilt_total  = 0;
    iat_total  = 0;
    i = 0;
    while i < ndlls {
        cnt = load64(dll_func_cnt + i * 8);
        ilt_total = ilt_total + (cnt + 1) * 8;
        iat_total = iat_total + (cnt + 1) * 8;
        i = i + 1;
    }
    ilt_base = idt_size;
    iat_base = ilt_base + ilt_total;
    hn_base  = iat_base + iat_total;

    # Build hint-name entries and dll-name strings
    hn_buf  = alloc(32768);
    hn_size = 0;
    hn_off_table = alloc(nimps * 8);   # idata offset of each hn entry
    i = 0;
    while i < nimps {
        store64(hn_off_table + i * 8, hn_base + hn_size);
        store8(hn_buf + hn_size, 0); store8(hn_buf + hn_size + 1, 0);  # hint=0
        hn_size = hn_size + 2;
        fn_noff = load64(g_imp_fn    + i * 8);
        fn_nlen = load64(g_imp_fnlen + i * 8);
        j = 0;
        while j < fn_nlen {
            store8(hn_buf + hn_size, load8(g_str_pool + fn_noff + j));
            hn_size = hn_size + 1;
            j = j + 1;
        }
        store8(hn_buf + hn_size, 0);
        hn_size = hn_size + 1;
        if hn_size % 2 != 0 { store8(hn_buf + hn_size, 0); hn_size = hn_size + 1; }
        i = i + 1;
    }

    dllname_buf  = alloc(4096);
    dllname_size = 0;
    dllname_off_table = alloc(MAX_DLLS * 8);
    i = 0;
    while i < ndlls {
        store64(dllname_off_table + i * 8, hn_base + hn_size + dllname_size);
        dn_off = load64(dll_name_off + i * 8);
        dn_len = load64(dll_name_len + i * 8);
        j = 0;
        while j < dn_len {
            store8(dllname_buf + dllname_size, load8(g_str_pool + dn_off + j));
            dllname_size = dllname_size + 1;
            j = j + 1;
        }
        store8(dllname_buf + dllname_size, 0);
        dllname_size = dllname_size + 1;
        if dllname_size % 2 != 0 { store8(dllname_buf + dllname_size, 0); dllname_size = dllname_size + 1; }
        i = i + 1;
    }

    idata_total = hn_base + hn_size + dllname_size;

    # ---- section RVAs ----
    code_size  = load64(g_code_len);
    text_rva   = 4096;
    rdata_rva  = pe_align(text_rva  + code_size,  SECT_ALIGN);
    data_rva   = pe_align(rdata_rva + rdata_size,  SECT_ALIGN);
    data_size  = load64(g_cg_data_size);
    idata_rva  = pe_align(data_rva  + data_size,   SECT_ALIGN);
    image_size = pe_align(idata_rva + idata_total,  SECT_ALIGN);

    # ---- IAT slot RVAs (for fixup resolution) ----
    iat_slot_rva = alloc(nimps * 8);
    iat_cursor   = iat_base;
    di2 = 0;
    while di2 < ndlls {
        fstart2 = load64(dll_func_off  + di2 * 8);
        fcnt2   = load64(dll_func_cnt  + di2 * 8);
        j = 0;
        while j < fcnt2 {
            gi = load64(dll_func_list + (fstart2 + j) * 8);
            store64(iat_slot_rva + gi * 8, idata_rva + iat_cursor + j * 8);
            j = j + 1;
        }
        iat_cursor = iat_cursor + (fcnt2 + 1) * 8;
        di2 = di2 + 1;
    }

    # ---- resolve code fixups ----
    nfix = load64(g_fixup_count);
    i = 0;
    while i < nfix {
        fpos  = load64(g_fixup_pos  + i * 8);
        fkind = load64(g_fixup_kind + i * 8);
        ftgt  = load64(g_fixup_tgt  + i * 8);
        disp  = 0;
        if fkind == 0 {
            # rel32 -> label
            lbl_off = load64(g_labels + ftgt * 8);
            disp = lbl_off - (fpos + 4);
        }
        if fkind == 1 {
            # rip-relative to .rdata string
            str_off_in_rdata = load64(str_rva_table + ftgt * 8);
            tgt_rva = rdata_rva + str_off_in_rdata;
            disp = tgt_rva - (text_rva + fpos + 4);
        }
        if fkind == 2 {
            # rip-relative to .data offset
            tgt_rva2 = data_rva + ftgt;
            disp = tgt_rva2 - (text_rva + fpos + 4);
        }
        if fkind == 3 {
            # rip-relative to IAT slot
            iat_rva = load64(iat_slot_rva + ftgt * 8);
            disp = iat_rva - (text_rva + fpos + 4);
        }
        # Write disp directly into g_code at fpos (4 bytes LE)
        store8(g_code + fpos + 0, band(disp,       255));
        store8(g_code + fpos + 1, band(shr(disp,  8), 255));
        store8(g_code + fpos + 2, band(shr(disp, 16), 255));
        store8(g_code + fpos + 3, band(shr(disp, 24), 255));
        i = i + 1;
    }

    # ---- file offsets ----
    # The .data section is entirely zero-initialised (ANCL @DATA holds only
    # `buf` globals; int constants are inlined and `str` go to .rdata).  So we
    # reserve NO raw file space for it (SizeOfRawData=0, PointerToRawData=0) and
    # let the loader zero-fill it from VirtualSize.  This is essential for
    # self-hosting: the compiler's own .data is tens of MB (it contains the
    # output image buffer g_pe_img itself), and writing that to disk would make
    # file_size exceed g_pe_img -> overflow.  .idata follows .rdata directly.
    HDR_SIZE   = pe_align(64 + 4 + 20 + 240 + 4 * 40, FILE_ALIGN);
    text_fp    = HDR_SIZE;
    text_raw   = pe_align(code_size, FILE_ALIGN);
    rdata_fp   = text_fp + text_raw;
    rdata_raw  = pe_align(rdata_size, FILE_ALIGN);
    data_fp    = 0;                                  # .data not present in file
    data_raw   = 0;                                  # .data raw size = 0
    idata_fp   = rdata_fp + rdata_raw;
    idata_raw  = pe_align(idata_total, FILE_ALIGN);
    file_size  = idata_fp + idata_raw;

    # ---- zero image ----
    memset(g_pe_img, 0, file_size);
    store64(g_pe_img_size, file_size);

    # ---- DOS stub ----
    store8(g_pe_img + 0, 77);  store8(g_pe_img + 1, 90);   # 'MZ'
    pe_put_le(60, 64, 4);                                   # e_lfanew = 0x40

    # ---- PE signature ----
    pe_off = 64;
    store8(g_pe_img + pe_off + 0, 80); store8(g_pe_img + pe_off + 1, 69);  # 'PE'
    store8(g_pe_img + pe_off + 2, 0);  store8(g_pe_img + pe_off + 3, 0);

    # ---- File header ----
    fh = pe_off + 4;
    pe_put_le(fh + 0, 34404, 2);     # Machine = AMD64 = 0x8664
    pe_put_le(fh + 2, 4, 2);         # NumberOfSections = 4
    pe_put_le(fh + 4, 0, 4);         # TimeDateStamp
    pe_put_le(fh + 8, 0, 4);
    pe_put_le(fh + 12, 0, 4);
    pe_put_le(fh + 16, 240, 2);      # SizeOfOptionalHeader
    pe_put_le(fh + 18, 34, 2);       # Characteristics: EXECUTABLE|LARGE_ADDRESS_AWARE (0x22)

    # ---- Optional header (PE32+) ----
    oh = fh + 20;
    pe_put_le(oh + 0, 523, 2);        # Magic PE32+ = 0x20B
    store8(g_pe_img + oh + 2, 14);
    pe_put_le(oh + 4,  text_raw, 4);
    pe_put_le(oh + 8,  rdata_raw + data_raw + idata_raw, 4);
    pe_put_le(oh + 12, 0, 4);

    # AddressOfEntryPoint = text_rva + _start label pos
    entry_off = load64(g_labels + load64(L_start) * 8);
    pe_put_le(oh + 16, text_rva + entry_off, 4);
    pe_put_le(oh + 20, text_rva, 4);
    pe_put_le(oh + 24, IMAGE_BASE, 8);   # ImageBase
    pe_put_le(oh + 32, SECT_ALIGN, 4);
    pe_put_le(oh + 36, FILE_ALIGN, 4);
    pe_put_le(oh + 40, 6, 2); pe_put_le(oh + 42, 0, 2);  # OS ver
    pe_put_le(oh + 44, 0, 2); pe_put_le(oh + 46, 0, 2);
    pe_put_le(oh + 48, 6, 2); pe_put_le(oh + 50, 0, 2);  # subsystem ver
    pe_put_le(oh + 52, 0, 4);
    pe_put_le(oh + 56, image_size, 4);
    pe_put_le(oh + 60, HDR_SIZE, 4);
    pe_put_le(oh + 64, 0, 4);  # checksum
    pe_put_le(oh + 68, 3, 2);  # Subsystem: 3=CUI (console)
    pe_put_le(oh + 70, 256, 2);  # DllCharacteristics NX_COMPAT
    pe_put_le(oh + 72, 1048576, 8);  # SizeOfStackReserve
    pe_put_le(oh + 80, 4096, 8);
    pe_put_le(oh + 88, 1048576, 8);
    pe_put_le(oh + 96, 4096, 8);
    pe_put_le(oh + 104, 0, 4);
    pe_put_le(oh + 108, 16, 4);  # NumberOfRvaAndSizes

    # DataDirectory[16]
    dd = oh + 112;
    # [1] Import Directory
    idt_rva_abs = idata_rva + 0;
    idt_sz      = (ndlls + 1) * 20;
    pe_put_le(dd + 1*8 + 0, idt_rva_abs, 4);
    pe_put_le(dd + 1*8 + 4, idt_sz, 4);
    # [12] IAT
    iat_dir_rva = idata_rva + iat_base;
    iat_dir_sz  = iat_total;
    pe_put_le(dd + 12*8 + 0, iat_dir_rva, 4);
    pe_put_le(dd + 12*8 + 4, iat_dir_sz, 4);

    # ---- Section headers ----
    sh = oh + 240;
    # helper: write a section header
    # .text
    sh0 = sh + 0 * 40;
    store8(g_pe_img + sh0 + 0, 46); store8(g_pe_img + sh0 + 1, 116); store8(g_pe_img + sh0 + 2, 101);
    store8(g_pe_img + sh0 + 3, 120); store8(g_pe_img + sh0 + 4, 116); # ".text"
    pe_put_le(sh0 + 8,  code_size, 4);
    pe_put_le(sh0 + 12, text_rva,  4);
    pe_put_le(sh0 + 16, text_raw,  4);
    pe_put_le(sh0 + 20, text_fp,   4);
    pe_put_le(sh0 + 36, 1610612768, 4);  # 0x60000020 CODE|EXEC|READ
    # .rdata
    sh1 = sh + 1 * 40;
    store8(g_pe_img + sh1 + 0, 46); store8(g_pe_img + sh1 + 1, 114); store8(g_pe_img + sh1 + 2, 100);
    store8(g_pe_img + sh1 + 3, 97); store8(g_pe_img + sh1 + 4, 116); store8(g_pe_img + sh1 + 5, 97); # ".rdata"
    pe_put_le(sh1 + 8,  rdata_size, 4);
    pe_put_le(sh1 + 12, rdata_rva,  4);
    pe_put_le(sh1 + 16, rdata_raw,  4);
    pe_put_le(sh1 + 20, rdata_fp,   4);
    pe_put_le(sh1 + 36, 1073741888, 4);  # 0x40000040 IDATA|READ
    # .data
    sh2 = sh + 2 * 40;
    store8(g_pe_img + sh2 + 0, 46); store8(g_pe_img + sh2 + 1, 100); store8(g_pe_img + sh2 + 2, 97);
    store8(g_pe_img + sh2 + 3, 116); store8(g_pe_img + sh2 + 4, 97); # ".data"
    pe_put_le(sh2 + 8,  data_size, 4);
    pe_put_le(sh2 + 12, data_rva,  4);
    pe_put_le(sh2 + 16, data_raw,  4);
    pe_put_le(sh2 + 20, data_fp,   4);
    pe_put_le(sh2 + 36, 3221225536, 4);  # 0xC0000040 IDATA|READ|WRITE
    # .idata
    sh3 = sh + 3 * 40;
    store8(g_pe_img + sh3 + 0, 46); store8(g_pe_img + sh3 + 1, 105); store8(g_pe_img + sh3 + 2, 100);
    store8(g_pe_img + sh3 + 3, 97); store8(g_pe_img + sh3 + 4, 116); store8(g_pe_img + sh3 + 5, 97); # ".idata"
    pe_put_le(sh3 + 8,  idata_total, 4);
    pe_put_le(sh3 + 12, idata_rva,   4);
    pe_put_le(sh3 + 16, idata_raw,   4);
    pe_put_le(sh3 + 20, idata_fp,    4);
    pe_put_le(sh3 + 36, 3221225536, 4);  # 0xC0000040

    # ---- Copy section data ----
    # .text
    pe_memcpy_to_img(text_fp, g_code, code_size);
    # .rdata
    pe_memcpy_to_img(rdata_fp, rdata_buf, rdata_size);
    # .data is zero-initialised
    # .idata: build in-place
    idata_start = idata_fp;

    # Write IDT
    ilt_cursor2 = ilt_base;
    iat_cursor2 = iat_base;
    di3 = 0;
    while di3 < ndlls {
        fcnt3  = load64(dll_func_cnt + di3 * 8);
        dname3 = load64(dllname_off_table + di3 * 8);
        idt_at = idata_start + di3 * 20;
        pe_put_le(idt_at + 0,  idata_rva + ilt_cursor2, 4);         # OriginalFirstThunk (ILT)
        pe_put_le(idt_at + 4,  0, 4);
        pe_put_le(idt_at + 8,  0, 4);
        pe_put_le(idt_at + 12, idata_rva + dname3, 4);              # Name RVA (was missing idata_rva)
        pe_put_le(idt_at + 16, idata_rva + iat_cursor2, 4);   # FirstThunk (IAT)
        fstart3 = load64(dll_func_off + di3 * 8);
        j = 0;
        while j < fcnt3 {
            gi2 = load64(dll_func_list + (fstart3 + j) * 8);
            hn_rva = load64(hn_off_table + gi2 * 8);
            pe_put_le(idata_start + ilt_cursor2 + j * 8, idata_rva + hn_rva, 8);  # ILT entry (RVA)
            pe_put_le(idata_start + iat_cursor2 + j * 8, idata_rva + hn_rva, 8);  # IAT entry (RVA)
            j = j + 1;
        }
        # null terminators
        pe_put_le(idata_start + ilt_cursor2 + fcnt3 * 8, 0, 8);
        pe_put_le(idata_start + iat_cursor2 + fcnt3 * 8, 0, 8);
        ilt_cursor2 = ilt_cursor2 + (fcnt3 + 1) * 8;
        iat_cursor2 = iat_cursor2 + (fcnt3 + 1) * 8;
        di3 = di3 + 1;
    }
    # null IDT terminator
    pe_put_le(idata_start + ndlls * 20, 0, 20);

    # Copy hint-name table
    pe_memcpy_to_img(idata_start + hn_base, hn_buf, hn_size);
    # Copy dll name strings
    pe_memcpy_to_img(idata_start + hn_base + hn_size, dllname_buf, dllname_size);

    # ---- Write to disk ----
    h = CreateFileA(path, 1073741824, 0, 0, 2, 128, 0);  # GENERIC_WRITE, CREATE_ALWAYS, FILE_ATTRIBUTE_NORMAL
    if h == 0 - 1 {
        syscall 1, pe_err_open;
        return 0 - 1;
    }
    WriteFile(h, g_pe_img, file_size, g_pe_nwritten, 0);
    CloseHandle(h);

    # Cleanup
    free(str_rva_table);
    free(rdata_buf);
    free(dll_name_off); free(dll_name_len);
    free(dll_func_list); free(dll_func_off); free(dll_func_cnt);
    free(hn_buf); free(hn_off_table);
    free(dllname_buf); free(dllname_off_table);
    free(iat_slot_rva);

    return 0;
}
# ===================== END pe_writer.ancl =====================

# ===================== BEGIN elf_writer.ancl =====================
# =====================================================================
#  elf_writer.ancl  -  static x86-64 ELF writer for anclc2  (thread C / M5 5b)
#
#  Emits a static Linux ELF (ET_EXEC, statically linked) from the same
#  emitted code + data + fixups the PE writer consumes. A direct port of
#  the bootstrap C++ ELFWriter::write. Reuses pe_writer's image buffer
#  (g_pe_img) + helpers (pe_put_le / pe_align / pe_memcpy_to_img) and the
#  output file write (CreateFileA / WriteFile / CloseHandle).
#
#  Key tricks (mirroring the bootstrap):
#   - vaddr = LOAD_BASE + file_offset  -> page congruence is automatic.
#   - p_filesz = 0 for the R|W .data segment (loader zero-fills from
#     p_memsz); file ends at data_off, so the compiler's own multi-MB .data
#     costs ZERO file bytes (and never overflows the 4 MB g_pe_img).
#  Only emitted under --target=linux (main.ancl gates the call); dead in PE.
# =====================================================================

@DATA
elf_err_kind3: str = "[elf] internal: Windows import fixup under --target=linux\n";
elf_err_open:  str = "[elf] cannot open output file\n";
elfd_interp:   str = "/lib64/ld-linux-x86-64.so.2";   # PT_INTERP for --target=linux-dyn

@CODE

func elf_write(path: i64) -> i64 {
    LOAD_BASE = 4194304;    # 0x400000
    PAGE      = 4096;
    headers   = 176;        # Ehdr(64) + 2 * Phdr(56)

    # ---- string table (.rdata): record each string's offset within rdata ----
    nstrs = load64(g_str_count);
    elf_stroff = alloc((nstrs + 1) * 8);
    rdata_size = 0;
    i = 0;
    while i < nstrs {
        store64(elf_stroff + i * 8, rdata_size);
        rdata_size = rdata_size + load64(g_str_len + i * 8) + 1;
        i = i + 1;
    }
    if rdata_size == 0 { rdata_size = 1; }

    code_size = load64(g_code_len);
    data_size = load64(g_cg_data_size);

    # ---- file/vaddr layout (contiguous; vaddr = LOAD_BASE + file offset) ----
    text_off  = headers;
    rdata_off = text_off + code_size;
    seg1_end  = rdata_off + rdata_size;          # end of the R|X segment
    data_off  = pe_align(seg1_end, PAGE);        # R|W segment on a fresh page
    file_size = data_off;                        # p_filesz=0 for .data -> no .data bytes in the file
    entry     = LOAD_BASE + text_off + load64(g_labels + load64(L_start) * 8);

    # ---- resolve code fixups (kinds 0/1/2; kind 3 = error) into g_code ----
    nfix = load64(g_fixup_count);
    i = 0;
    while i < nfix {
        fpos  = load64(g_fixup_pos  + i * 8);
        fkind = load64(g_fixup_kind + i * 8);
        ftgt  = load64(g_fixup_tgt  + i * 8);
        disp  = 0;
        if fkind == 0 { disp = load64(g_labels + ftgt * 8) - (fpos + 4); }                              # rel32 -> label
        if fkind == 1 { disp = (rdata_off + load64(elf_stroff + ftgt * 8)) - (text_off + fpos + 4); }   # rip -> rdata string
        if fkind == 2 { disp = (data_off + ftgt) - (text_off + fpos + 4); }                             # rip -> .data offset
        if fkind == 3 { syscall 1, elf_err_kind3; ExitProcess(1); }                                     # Windows import -> error
        store8(g_code + fpos + 0, band(disp,        255));
        store8(g_code + fpos + 1, band(shr(disp,  8), 255));
        store8(g_code + fpos + 2, band(shr(disp, 16), 255));
        store8(g_code + fpos + 3, band(shr(disp, 24), 255));
        i = i + 1;
    }

    # ---- assemble the image into g_pe_img (already zero-initialised .data) ----
    # Elf64_Ehdr
    store8(g_pe_img + 0, 127); store8(g_pe_img + 1, 69); store8(g_pe_img + 2, 76); store8(g_pe_img + 3, 70);  # 0x7F 'E' 'L' 'F'
    store8(g_pe_img + 4, 2);   # EI_CLASS = ELFCLASS64
    store8(g_pe_img + 5, 1);   # EI_DATA  = ELFDATA2LSB
    store8(g_pe_img + 6, 1);   # EI_VERSION = EV_CURRENT
    pe_put_le(16, 2,  2);      # e_type = ET_EXEC
    pe_put_le(18, 62, 2);      # e_machine = EM_X86_64
    pe_put_le(20, 1,  4);      # e_version
    pe_put_le(24, entry, 8);   # e_entry (absolute vaddr)
    pe_put_le(32, 64, 8);      # e_phoff
    pe_put_le(52, 64, 2);      # e_ehsize
    pe_put_le(54, 56, 2);      # e_phentsize
    pe_put_le(56, 2,  2);      # e_phnum

    # Phdr[0] : PT_LOAD R|X  (headers + .text + .rdata)
    pe_put_le(64,  1, 4);              # p_type = PT_LOAD
    pe_put_le(68,  5, 4);              # p_flags = R|X
    pe_put_le(80,  LOAD_BASE, 8);      # p_vaddr
    pe_put_le(88,  LOAD_BASE, 8);      # p_paddr
    pe_put_le(96,  seg1_end, 8);       # p_filesz
    pe_put_le(104, seg1_end, 8);       # p_memsz
    pe_put_le(112, PAGE, 8);           # p_align
    # p_offset (72..79) = 0 (zero-init)

    # Phdr[1] : PT_LOAD R|W  (.data, zero-filled by the loader; NO file bytes)
    pe_put_le(120, 1, 4);                    # p_type = PT_LOAD
    pe_put_le(124, 6, 4);                    # p_flags = R|W
    pe_put_le(128, data_off, 8);             # p_offset
    pe_put_le(136, LOAD_BASE + data_off, 8); # p_vaddr
    pe_put_le(144, LOAD_BASE + data_off, 8); # p_paddr
    pe_put_le(160, data_size, 8);            # p_memsz   (p_filesz at 152..159 = 0, zero-init)
    pe_put_le(168, PAGE, 8);                 # p_align

    # segment contents
    pe_memcpy_to_img(text_off, g_code, code_size);
    i = 0;
    while i < nstrs {
        soff = load64(g_str_off + i * 8);
        slen = load64(g_str_len + i * 8);
        dst  = rdata_off + load64(elf_stroff + i * 8);
        j = 0;
        while j <= slen {
            store8(g_pe_img + dst + j, load8(g_strings + soff + j));
            j = j + 1;
        }
        i = i + 1;
    }

    store64(g_pe_img_size, file_size);

    # ---- write the file (GENERIC_WRITE, CREATE_ALWAYS) ----
    h = CreateFileA(path, 1073741824, 0, 0, 2, 128, 0);
    if h == 0 - 1 { syscall 1, elf_err_open; return 0 - 1; }
    WriteFile(h, g_pe_img, file_size, g_pe_nwritten, 0);
    CloseHandle(h);
    return 0;
}

# =====================================================================
#  elf_write_dyn(path)  --  DYNAMIC x86-64 ELF writer  (--target=linux-dyn)
#
#  A direct port of the bootstrap C++ ELFWriterDyn. Emits a dynamically
#  linked ET_EXEC (PT_INTERP=/lib64/ld-linux-x86-64.so.2, DT_NEEDED=libc.so.6)
#  that resolves libc dl* symbols through .rela.plt R_X86_64_JUMP_SLOT under
#  DF_BIND_NOW -- ld.so fills .got.plt at load, code calls `call [rip+GOT]`
#  (fixup kind 4), like the PE writer's IAT. NO PLT stubs. Non-PIE, fixed
#  LOAD_BASE=0x400000 so vaddr=LOAD_BASE+file_off (kind 1/2 fixups reuse the
#  static-writer arithmetic). seg1 R|X = Ehdr+Phdrs+.interp+.hash+.dynsym+
#  .dynstr+.rela.plt+.text+.rdata ; seg2 R|W = .dynamic+.got.plt+.data (bss).
#  Only emitted under --target=linux-dyn; dead in PE and static ELF.
# =====================================================================
func elf_write_dyn(path: i64) -> i64 {
    LOAD_BASE = 4194304;    # 0x400000
    PAGE      = 4096;
    headers   = 344;        # Ehdr(64) + 5 * Phdr(56)

    D = load64(g_dynimp_count);

    # ---- distinct sonames (dedup) -> one DT_NEEDED each ----
    so_off_arr = alloc(128 * 8);
    so_len_arr = alloc(128 * 8);
    nso = 0;
    di = 0;
    while di < D {
        foff = load64(g_dynimp_so    + di * 8);
        flen = load64(g_dynimp_solen + di * 8);
        seen = 0;
        s = 0;
        while s < nso {
            if cg_pool_cmp(load64(so_off_arr + s*8), load64(so_len_arr + s*8), foff, flen) == 1 { seen = 1; }
            s = s + 1;
        }
        if seen == 0 {
            store64(so_off_arr + nso*8, foff);
            store64(so_len_arr + nso*8, flen);
            nso = nso + 1;
        }
        di = di + 1;
    }

    # ---- .dynstr offsets: \0 + sonames + dyn import fn names ----
    dynstr_size = 1;                 # leading NUL
    so_stroff = alloc(128 * 8);
    s = 0;
    while s < nso {
        store64(so_stroff + s*8, dynstr_size);
        dynstr_size = dynstr_size + load64(so_len_arr + s*8) + 1;
        s = s + 1;
    }
    sym_stroff = alloc(128 * 8);
    di = 0;
    while di < D {
        store64(sym_stroff + di*8, dynstr_size);
        dynstr_size = dynstr_size + load64(g_dynimp_fnlen + di*8) + 1;
        di = di + 1;
    }
    nsym = 1 + D;

    # ---- .rdata (string literals) offsets, as in elf_write ----
    nstrs = load64(g_str_count);
    elf_stroff = alloc((nstrs + 1) * 8);
    rdata_size = 0;
    i = 0;
    while i < nstrs {
        store64(elf_stroff + i * 8, rdata_size);
        rdata_size = rdata_size + load64(g_str_len + i * 8) + 1;
        i = i + 1;
    }
    if rdata_size == 0 { rdata_size = 1; }

    interp_sz = strlen(elfd_interp) + 1;
    code_size = load64(g_code_len);
    data_size = load64(g_cg_data_size);

    # ---- seg1 (R|X) layout ----
    interp_off  = headers;
    hash_off    = pe_align(interp_off + interp_sz, 8);
    hash_bytes  = (3 + nsym) * 4;               # nbucket + nchain + bucket[0] + chain[nsym]
    dynsym_off  = pe_align(hash_off + hash_bytes, 8);
    dynsym_bytes= nsym * 24;
    dynstr_off  = dynsym_off + dynsym_bytes;
    relaplt_off = pe_align(dynstr_off + dynstr_size, 8);
    relaplt_bytes = D * 24;
    text_off    = pe_align(relaplt_off + relaplt_bytes, 16);
    rdata_off   = text_off + code_size;
    seg1_end    = rdata_off + rdata_size;

    # ---- seg2 (R|W): .dynamic + .got.plt (+ .data bss) ----
    dyn_off      = pe_align(seg1_end, PAGE);
    ndyn         = nso + 12;                     # NEEDED* + 11 fixed + DT_NULL
    dynamic_off  = dyn_off;
    dynamic_bytes= ndyn * 16;
    gotplt_off   = pe_align(dynamic_off + dynamic_bytes, 8);
    gotplt_bytes = (3 + D) * 8;
    seg2_end     = gotplt_off + gotplt_bytes;
    data_voff    = seg2_end;                     # .data base (bss) = right after .got.plt
    seg2_filesz  = seg2_end - dyn_off;
    seg2_memsz   = seg2_filesz + data_size;
    file_size    = seg2_end;

    entry = LOAD_BASE + text_off + load64(g_labels + load64(L_start) * 8);

    # ---- resolve code fixups (kinds 0/1/2 as in elf_write; kind 4 -> .got.plt slot) ----
    nfix = load64(g_fixup_count);
    i = 0;
    while i < nfix {
        fpos  = load64(g_fixup_pos  + i * 8);
        fkind = load64(g_fixup_kind + i * 8);
        ftgt  = load64(g_fixup_tgt  + i * 8);
        disp  = 0;
        if fkind == 0 { disp = load64(g_labels + ftgt * 8) - (fpos + 4); }
        if fkind == 1 { disp = (rdata_off + load64(elf_stroff + ftgt * 8)) - (text_off + fpos + 4); }
        if fkind == 2 { disp = (data_voff + ftgt) - (text_off + fpos + 4); }
        if fkind == 4 { disp = (gotplt_off + (3 + ftgt) * 8) - (text_off + fpos + 4); }
        if fkind == 3 { syscall 1, elf_err_kind3; ExitProcess(1); }
        store8(g_code + fpos + 0, band(disp,        255));
        store8(g_code + fpos + 1, band(shr(disp,  8), 255));
        store8(g_code + fpos + 2, band(shr(disp, 16), 255));
        store8(g_code + fpos + 3, band(shr(disp, 24), 255));
        i = i + 1;
    }

    # ---- assemble the image into g_pe_img (zero-initialised) ----
    # Elf64_Ehdr
    store8(g_pe_img + 0, 127); store8(g_pe_img + 1, 69); store8(g_pe_img + 2, 76); store8(g_pe_img + 3, 70);  # 0x7F 'E' 'L' 'F'
    store8(g_pe_img + 4, 2);   # ELFCLASS64
    store8(g_pe_img + 5, 1);   # ELFDATA2LSB
    store8(g_pe_img + 6, 1);   # EV_CURRENT
    pe_put_le(16, 2,  2);      # e_type = ET_EXEC
    pe_put_le(18, 62, 2);      # e_machine = EM_X86_64
    pe_put_le(20, 1,  4);      # e_version
    pe_put_le(24, entry, 8);   # e_entry
    pe_put_le(32, 64, 8);      # e_phoff
    pe_put_le(52, 64, 2);      # e_ehsize
    pe_put_le(54, 56, 2);      # e_phentsize
    pe_put_le(56, 5,  2);      # e_phnum = NPH

    # Phdr[0] PT_PHDR
    pe_put_le(64,  6, 4); pe_put_le(68,  4, 4);
    pe_put_le(72,  64, 8); pe_put_le(80, LOAD_BASE + 64, 8); pe_put_le(88, LOAD_BASE + 64, 8);
    pe_put_le(96,  280, 8); pe_put_le(104, 280, 8); pe_put_le(112, 8, 8);
    # Phdr[1] PT_INTERP
    pe_put_le(120, 3, 4); pe_put_le(124, 4, 4);
    pe_put_le(128, interp_off, 8); pe_put_le(136, LOAD_BASE + interp_off, 8); pe_put_le(144, LOAD_BASE + interp_off, 8);
    pe_put_le(152, interp_sz, 8); pe_put_le(160, interp_sz, 8); pe_put_le(168, 1, 8);
    # Phdr[2] PT_LOAD R|X (seg1)
    pe_put_le(176, 1, 4); pe_put_le(180, 5, 4);
    pe_put_le(184, 0, 8); pe_put_le(192, LOAD_BASE, 8); pe_put_le(200, LOAD_BASE, 8);
    pe_put_le(208, seg1_end, 8); pe_put_le(216, seg1_end, 8); pe_put_le(224, PAGE, 8);
    # Phdr[3] PT_LOAD R|W (seg2 = .dynamic + .got.plt + .data bss)
    pe_put_le(232, 1, 4); pe_put_le(236, 6, 4);
    pe_put_le(240, dyn_off, 8); pe_put_le(248, LOAD_BASE + dyn_off, 8); pe_put_le(256, LOAD_BASE + dyn_off, 8);
    pe_put_le(264, seg2_filesz, 8); pe_put_le(272, seg2_memsz, 8); pe_put_le(280, PAGE, 8);
    # Phdr[4] PT_DYNAMIC
    pe_put_le(288, 2, 4); pe_put_le(292, 6, 4);
    pe_put_le(296, dynamic_off, 8); pe_put_le(304, LOAD_BASE + dynamic_off, 8); pe_put_le(312, LOAD_BASE + dynamic_off, 8);
    pe_put_le(320, dynamic_bytes, 8); pe_put_le(328, dynamic_bytes, 8); pe_put_le(336, 8, 8);

    # .interp
    k = 0;
    while k < interp_sz - 1 { store8(g_pe_img + interp_off + k, load8(elfd_interp + k)); k = k + 1; }

    # .hash (SysV; nbucket=1)
    pe_put_le(hash_off + 0, 1, 4);         # nbucket
    pe_put_le(hash_off + 4, nsym, 4);      # nchain
    bkt = 0;
    if nsym > 1 { bkt = 1; }
    pe_put_le(hash_off + 8, bkt, 4);       # bucket[0]
    ci = 0;
    while ci < nsym {                       # chain[]: 1..nsym-2 -> next; ends -> 0; chain[0]=0
        cv = 0;
        if ci != 0 { if ci != nsym - 1 { cv = ci + 1; } }
        pe_put_le(hash_off + 12 + ci*4, cv, 4);
        ci = ci + 1;
    }

    # .dynsym (sym[0] = null; sym[1+k] = UNDEF GLOBAL FUNC)
    di = 0;
    while di < D {
        symb = dynsym_off + (1 + di) * 24;
        pe_put_le(symb + 0, load64(sym_stroff + di*8), 4);   # st_name
        store8(g_pe_img + symb + 4, 18);                     # st_info = (STB_GLOBAL<<4)|STT_FUNC
        di = di + 1;
    }

    # .dynstr (leading NUL already 0)
    s = 0;
    while s < nso {
        base = dynstr_off + load64(so_stroff + s*8);
        soff = load64(so_off_arr + s*8);
        slen = load64(so_len_arr + s*8);
        k = 0;
        while k < slen { store8(g_pe_img + base + k, load8(g_str_pool + soff + k)); k = k + 1; }
        s = s + 1;
    }
    di = 0;
    while di < D {
        base = dynstr_off + load64(sym_stroff + di*8);
        foff = load64(g_dynimp_fn    + di*8);
        flen = load64(g_dynimp_fnlen + di*8);
        k = 0;
        while k < flen { store8(g_pe_img + base + k, load8(g_str_pool + foff + k)); k = k + 1; }
        di = di + 1;
    }

    # .rela.plt (Elf64_Rela: r_offset, r_info, r_addend)
    di = 0;
    while di < D {
        rr = relaplt_off + di * 24;
        pe_put_le(rr + 0, LOAD_BASE + gotplt_off + (3 + di) * 8, 8);   # r_offset -> GOT slot
        pe_put_le(rr + 8, (1 + di) * 4294967296 + 7, 8);              # (symidx<<32)|R_X86_64_JUMP_SLOT
        di = di + 1;
    }

    # .text + .rdata
    pe_memcpy_to_img(text_off, g_code, code_size);
    i = 0;
    while i < nstrs {
        soff2 = load64(g_str_off + i * 8);
        slen2 = load64(g_str_len + i * 8);
        dst   = rdata_off + load64(elf_stroff + i * 8);
        j = 0;
        while j <= slen2 { store8(g_pe_img + dst + j, load8(g_strings + soff2 + j)); j = j + 1; }
        i = i + 1;
    }

    # .dynamic
    dyi = 0;
    s = 0;
    while s < nso {
        de = dynamic_off + dyi * 16;
        pe_put_le(de + 0, 1, 8);                         # DT_NEEDED
        pe_put_le(de + 8, load64(so_stroff + s*8), 8);
        dyi = dyi + 1;
        s = s + 1;
    }
    de = dynamic_off + dyi*16; pe_put_le(de+0, 4,  8); pe_put_le(de+8, LOAD_BASE + hash_off, 8);    dyi = dyi + 1;   # DT_HASH
    de = dynamic_off + dyi*16; pe_put_le(de+0, 5,  8); pe_put_le(de+8, LOAD_BASE + dynstr_off, 8);  dyi = dyi + 1;   # DT_STRTAB
    de = dynamic_off + dyi*16; pe_put_le(de+0, 6,  8); pe_put_le(de+8, LOAD_BASE + dynsym_off, 8);  dyi = dyi + 1;   # DT_SYMTAB
    de = dynamic_off + dyi*16; pe_put_le(de+0, 10, 8); pe_put_le(de+8, dynstr_size, 8);             dyi = dyi + 1;   # DT_STRSZ
    de = dynamic_off + dyi*16; pe_put_le(de+0, 11, 8); pe_put_le(de+8, 24, 8);                      dyi = dyi + 1;   # DT_SYMENT
    de = dynamic_off + dyi*16; pe_put_le(de+0, 3,  8); pe_put_le(de+8, LOAD_BASE + gotplt_off, 8);  dyi = dyi + 1;   # DT_PLTGOT
    de = dynamic_off + dyi*16; pe_put_le(de+0, 2,  8); pe_put_le(de+8, relaplt_bytes, 8);           dyi = dyi + 1;   # DT_PLTRELSZ
    de = dynamic_off + dyi*16; pe_put_le(de+0, 20, 8); pe_put_le(de+8, 7, 8);                       dyi = dyi + 1;   # DT_PLTREL = RELA
    de = dynamic_off + dyi*16; pe_put_le(de+0, 23, 8); pe_put_le(de+8, LOAD_BASE + relaplt_off, 8); dyi = dyi + 1;   # DT_JMPREL
    de = dynamic_off + dyi*16; pe_put_le(de+0, 24, 8); pe_put_le(de+8, 0, 8);                       dyi = dyi + 1;   # DT_BIND_NOW
    de = dynamic_off + dyi*16; pe_put_le(de+0, 30, 8); pe_put_le(de+8, 8, 8);                       dyi = dyi + 1;   # DT_FLAGS = DF_BIND_NOW
    de = dynamic_off + dyi*16; pe_put_le(de+0, 0,  8); pe_put_le(de+8, 0, 8);                       dyi = dyi + 1;   # DT_NULL

    # .got.plt : GOT[0] = &_DYNAMIC (reserved); GOT[1..2] and the D slots stay 0 (ld.so fills)
    pe_put_le(gotplt_off + 0, LOAD_BASE + dynamic_off, 8);

    store64(g_pe_img_size, file_size);

    free(so_off_arr); free(so_len_arr); free(so_stroff); free(sym_stroff); free(elf_stroff);

    # ---- write the file (GENERIC_WRITE, CREATE_ALWAYS) ----
    h = CreateFileA(path, 1073741824, 0, 0, 2, 128, 0);
    if h == 0 - 1 { syscall 1, elf_err_open; return 0 - 1; }
    WriteFile(h, g_pe_img, file_size, g_pe_nwritten, 0);
    CloseHandle(h);
    return 0;
}
# ===================== END elf_writer.ancl =====================

# ===================== BEGIN main.ancl =====================
# =====================================================================
#  main.ancl  -  Entry point for anclc2 (self-hosting ANCL compiler)
#
#  Usage:  anclc2 <input.ancl> <output.exe>
# =====================================================================

@DATA
m_banner:  str = "anclc2 - ANCL self-hosting bootstrap compiler\n";
m_usage:   str = "usage: anclc2 <input.ancl> <output.exe>\n";
m_lex_ok:  str = "[anclc2] lexed: ";
m_tok:     str = " tokens\n";
m_par_ok:  str = "[anclc2] parsed: ";
m_funcs:   str = " funcs\n";
m_cg_ok:   str = "[anclc2] codegen: ";
m_bytes:   str = " code bytes\n";
m_ok:      str = "[anclc2] written OK\n";
m_read_err:str = "[anclc2] cannot read input file\n";

# Input source buffer: 2 MB so the compiler can read large sources
# (the self-host source anclc2_all.ancl is ~150 KB; old 64 KB silently
# truncated it mid-file). One extra byte is reserved for the NUL terminator.
g_src:     buf = 2097152;
g_nread:   buf = 8;
g_arg1:    buf = 1024;
g_arg2:    buf = 1024;

# ---- SC1 self-correcting `--fix` (backport of compiler/anclc.cpp; docs/sc1_scope.md) ----
# F3 (// -> #) + F4 (strip let/var; bool/true/false/f32/float/double -> ANCL) text pre-passes.
# Gated by g_fix_mode so the NORMAL compile path is byte-identical (the anclc3==anclc4 fixpoint
# never sees --fix). F1/F2 (parser-driven missing-token insertion) now backported too -- see
# sc_tok_text/sc_splice/sc_fix_parse_loop below + the g_recover/g_perr recovery in parser.ancl.
g_arg3:      buf = 1024;     # scratch token slot for flag parsing
g_fix_mode:  buf = 8;        # 1 under --fix
g_fix_write: buf = 8;        # 1 under --write (rewrite the file)
g_check_mode: buf = 8;       # SC4: 1 under --check (build an intent-oracle checker)
g_fix_count: buf = 8;        # number of fixes applied
g_bak_path:  buf = 1100;     # <in>.bak scratch
fx_ffix:   str = "--fix";
fx_fwrite: str = "--write";
fx_fcheck: str = "--check";
fx_tlinux: str = "--target=linux";     # M5: emit a static Linux ELF instead of a Windows PE
fx_tlinuxdyn: str = "--target=linux-dyn"; # L4a: a DYNAMIC ELF (dlopen/dlsym via .rela.plt); implies --target=linux
kw_bool:   str = "bool";
kw_true:   str = "true";
kw_false:  str = "false";
kw_f32:    str = "f32";
kw_float:  str = "float";
kw_double: str = "double";
kw_let:    str = "let";
kw_var:    str = "var";
rep_i64:   str = "i64";
rep_1:     str = "1";
rep_0:     str = "0";
rep_f64:   str = "f64";
mf_pre:    str = "anclc2 --fix: ";
mf_mid:    str = " fix(es) ";
mf_prop:   str = "proposed (dry run; add --write to apply)\n";
mf_appl:   str = "applied\n";
mf_none:   str = "anclc2 --fix: no mechanical fixes needed\n";
# F1/F2 insertion-text table (mirror of anclc.cpp scTokText)
ins_semi:   str = ";";
ins_rparen: str = ")";
ins_lparen: str = "(";
ins_rbrace: str = "}";
ins_lbrace: str = "{";
ins_rbrack: str = "]";
ins_lbrack: str = "[";
ins_arrow:  str = "->";
ins_fatarw: str = "=>";
ins_colon:  str = ":";
ins_assign: str = "=";
ins_comma:  str = ",";
g_ins_len:  buf = 8;        # byte length of the last sc_tok_text result

@CODE

# ----------------------------------------------------------------
#  skip_spaces(p) -> ptr past leading spaces/tabs
# ----------------------------------------------------------------
func skip_spaces(p: i64) -> i64 {
    going = 1;
    while going == 1 {
        c = load8(p);
        if c == 32 { p = p + 1; }
        if c == 9  { p = p + 1; }
        if c != 32 { if c != 9 { going = 0; } }
        if c == 0  { going = 0; }
    }
    return p;
}

# ----------------------------------------------------------------
#  copy_token(src, dst) -> src pointer past the token
#  Copies a whitespace-delimited (or quoted) token into dst.
# ----------------------------------------------------------------
func copy_token(src: i64, dst: i64) -> i64 {
    di     = 0;
    quoted = 0;
    if load8(src) == 34 { quoted = 1; src = src + 1; }
    going = 1;
    while going == 1 {
        c = load8(src);
        if c == 0 { going = 0; }
        if going == 1 {
            if quoted == 1 {
                if c == 34 { src = src + 1; going = 0; }
                if going == 1 {
                    store8(dst + di, c);
                    di = di + 1; src = src + 1;
                }
            }
            if quoted == 0 {
                if c == 32 { going = 0; }
                if c == 9  { going = 0; }
                if going == 1 {
                    store8(dst + di, c);
                    di = di + 1; src = src + 1;
                }
            }
        }
    }
    store8(dst + di, 0);
    return src;
}

# ---- SC1 --fix helpers (self-correcting pass; mirror of compiler/anclc.cpp) ----
func arg_is(a: i64, b: i64) -> i64 {
    i = 0; going = 1; eq = 1;
    while going == 1 {
        ca = load8(a + i); cb = load8(b + i);
        if ca != cb { eq = 0; going = 0; }
        if going == 1 { if ca == 0 { going = 0; } else { i = i + 1; } }
    }
    return eq;
}
func sc_strcpy(dst: i64, src: i64) -> i64 {
    i = 0; going = 1;
    while going == 1 { c = load8(src + i); store8(dst + i, c); if c == 0 { going = 0; } else { i = i + 1; } }
    return i;
}
func sc_isident(c: i64) -> i64 {
    if c >= 97 { if c <= 122 { return 1; } }
    if c >= 65 { if c <= 90  { return 1; } }
    if c >= 48 { if c <= 57  { return 1; } }
    if c == 95 { return 1; }
    return 0;
}
func sc_match(buf: i64, at: i64, wlen: i64, lit: i64, litlen: i64) -> i64 {
    if wlen != litlen { return 0; }
    k = 0; going = 1; eq = 1;
    while going == 1 {
        if k >= wlen { going = 0; }
        else { if load8(buf + at + k) != load8(lit + k) { eq = 0; going = 0; } else { k = k + 1; } }
    }
    return eq;
}
# overwrite wlen bytes at buf+at with rep (replen bytes) padded with spaces (equal length)
func sc_swap(buf: i64, at: i64, wlen: i64, rep: i64, replen: i64) -> i64 {
    k = 0;
    while k < replen { store8(buf + at + k, load8(rep + k)); k = k + 1; }
    while k < wlen   { store8(buf + at + k, 32); k = k + 1; }
    return 0;
}
# delete n bytes at buf+at (shift the tail left); returns new length
func sc_splice_del(buf: i64, at: i64, n: i64, len: i64) -> i64 {
    k = at;
    while k + n < len { store8(buf + k, load8(buf + k + n)); k = k + 1; }
    return len - n;
}
# F3: '//' -> '#'  (string/comment-aware; equal-length, no memmove). Returns len.
func fix_f3_comments(buf: i64, len: i64) -> i64 {
    i = 0; instr = 0;
    while i < len {
        c = load8(buf + i);
        if instr == 1 {
            if c == 92 { i = i + 2; }
            else { if c == 34 { instr = 0; } i = i + 1; }
        } else {
            if c == 34 { instr = 1; i = i + 1; }
            else {
                if c == 35 {
                    g2 = 1;
                    while g2 == 1 { if i >= len { g2 = 0; } else { if load8(buf + i) == 10 { g2 = 0; } else { i = i + 1; } } }
                } else {
                    if c == 47 {
                        if load8(buf + i + 1) == 47 {
                            store8(buf + i, 35); store8(buf + i + 1, 32);
                            store64(g_fix_count, load64(g_fix_count) + 1);
                            i = i + 2;
                        } else { i = i + 1; }
                    } else { i = i + 1; }
                }
            }
        }
    }
    return len;
}
# F4: strip let/var; bool->i64 true->1 false->0 f32/float/double->f64 (string/comment-aware). Returns len.
func fix_f4_keywords(buf: i64, len: i64) -> i64 {
    i = 0; instr = 0;
    while i < len {
        c = load8(buf + i);
        if instr == 1 {
            if c == 92 { i = i + 2; }
            else { if c == 34 { instr = 0; } i = i + 1; }
        } else {
            if c == 34 { instr = 1; i = i + 1; }
            else {
                if c == 35 {
                    g2 = 1;
                    while g2 == 1 { if i >= len { g2 = 0; } else { if load8(buf + i) == 10 { g2 = 0; } else { i = i + 1; } } }
                } else {
                    boundary = 0;
                    if i == 0 { boundary = 1; } else { if sc_isident(load8(buf + i - 1)) == 0 { boundary = 1; } }
                    handled = 0;
                    if boundary == 1 { if sc_isident(c) == 1 {
                        j = i; gw = 1;
                        while gw == 1 { if j >= len { gw = 0; } else { if sc_isident(load8(buf + j)) == 1 { j = j + 1; } else { gw = 0; } } }
                        wlen = j - i;
                        if sc_match(buf, i, wlen, kw_bool, 4) == 1   { sc_swap(buf, i, wlen, rep_i64, 3); store64(g_fix_count, load64(g_fix_count)+1); i = j; handled = 1; }
                        if handled == 0 { if sc_match(buf, i, wlen, kw_true, 4) == 1  { sc_swap(buf, i, wlen, rep_1, 1);   store64(g_fix_count, load64(g_fix_count)+1); i = j; handled = 1; } }
                        if handled == 0 { if sc_match(buf, i, wlen, kw_false, 5) == 1 { sc_swap(buf, i, wlen, rep_0, 1);   store64(g_fix_count, load64(g_fix_count)+1); i = j; handled = 1; } }
                        if handled == 0 { if sc_match(buf, i, wlen, kw_f32, 3) == 1   { sc_swap(buf, i, wlen, rep_f64, 3); store64(g_fix_count, load64(g_fix_count)+1); i = j; handled = 1; } }
                        if handled == 0 { if sc_match(buf, i, wlen, kw_float, 5) == 1 { sc_swap(buf, i, wlen, rep_f64, 3); store64(g_fix_count, load64(g_fix_count)+1); i = j; handled = 1; } }
                        if handled == 0 { if sc_match(buf, i, wlen, kw_double, 6) == 1{ sc_swap(buf, i, wlen, rep_f64, 3); store64(g_fix_count, load64(g_fix_count)+1); i = j; handled = 1; } }
                        if handled == 0 { if sc_match(buf, i, wlen, kw_let, 3) == 1 {
                            sp = j; gs = 1;
                            while gs == 1 { if sp >= len { gs = 0; } else { cc = load8(buf + sp); if cc == 32 { sp = sp + 1; } else { if cc == 9 { sp = sp + 1; } else { gs = 0; } } } }
                            len = sc_splice_del(buf, i, sp - i, len);
                            store64(g_fix_count, load64(g_fix_count)+1); handled = 1;
                        } }
                        if handled == 0 { if sc_match(buf, i, wlen, kw_var, 3) == 1 {
                            sp = j; gs = 1;
                            while gs == 1 { if sp >= len { gs = 0; } else { cc = load8(buf + sp); if cc == 32 { sp = sp + 1; } else { if cc == 9 { sp = sp + 1; } else { gs = 0; } } } }
                            len = sc_splice_del(buf, i, sp - i, len);
                            store64(g_fix_count, load64(g_fix_count)+1); handled = 1;
                        } }
                        if handled == 0 { i = j; handled = 1; }
                    } }
                    if handled == 0 { i = i + 1; }
                }
            }
        }
    }
    return len;
}

# ---- SC1 F1/F2: parser-driven missing-token insertion (backport of anclc.cpp scTokText/scFixSource) ----
# After the F3/F4 text passes, re-parse in recover mode; on a missing STRUCTURAL token the parser
# poisons (g_perr) and records the expected kind + source splice point (start of the failing token).
# Insert the token's text + re-parse. Bounded (40) + a no-progress guard => guaranteed halt. ALL of
# this is inert outside --fix: g_recover stays 0, so par_expect never poisons on the self-compile.

# insertion text for a missing token kind (0 = not auto-insertable); sets g_ins_len.
func sc_tok_text(k: i64) -> i64 {
    if k == TOK_SEMI     { store64(g_ins_len, 1); return ins_semi;   }
    if k == TOK_RPAREN   { store64(g_ins_len, 1); return ins_rparen; }
    if k == TOK_LPAREN   { store64(g_ins_len, 1); return ins_lparen; }
    if k == TOK_RBRACE   { store64(g_ins_len, 1); return ins_rbrace; }
    if k == TOK_LBRACE   { store64(g_ins_len, 1); return ins_lbrace; }
    if k == TOK_RBRACKET { store64(g_ins_len, 1); return ins_rbrack; }
    if k == TOK_LBRACKET { store64(g_ins_len, 1); return ins_lbrack; }
    if k == TOK_ARROW    { store64(g_ins_len, 2); return ins_arrow;  }
    if k == TOK_FATARROW { store64(g_ins_len, 2); return ins_fatarw; }
    if k == TOK_COLON    { store64(g_ins_len, 1); return ins_colon;  }
    if k == TOK_ASSIGN   { store64(g_ins_len, 1); return ins_assign; }
    if k == TOK_COMMA    { store64(g_ins_len, 1); return ins_comma;  }
    store64(g_ins_len, 0);
    return 0;
}

# splice txtlen bytes from txt into buf at offset off (shift the tail right). Returns new length.
func sc_splice(buf: i64, len: i64, off: i64, txt: i64, txtlen: i64) -> i64 {
    i = len;
    while i > off {
        store8(buf + i - 1 + txtlen, load8(buf + i - 1));
        i = i - 1;
    }
    j = 0;
    while j < txtlen {
        store8(buf + off + j, load8(txt + j));
        j = j + 1;
    }
    return len + txtlen;
}

# F1/F2 driver: re-parse g_src in recover mode; on a missing-token poison, splice + re-parse.
# Returns the new source length (each insert grows it by g_ins_len). Mirrors scFixSource.
func sc_fix_parse_loop(srclen: i64) -> i64 {
    store64(g_recover, 1);
    last_off = 0 - 1; last_kind = 0 - 1;
    guard = 0;
    while guard < 40 {
        store64(g_perr, 0);
        lex_init(g_src, srclen);
        par_init();
        par_program();
        if load64(g_perr) == 0 { guard = 40; }                # parses clean -> done
        if load64(g_perr) != 0 {
            k   = load64(g_exp_tok);
            off = load64(g_exp_off);
            txt = sc_tok_text(k);
            if txt == 0 { guard = 40; }                       # not auto-insertable -> stop honestly
            if txt != 0 {
                if off > srclen { off = srclen; }
                stop = 0;
                if off == last_off { if k == last_kind { stop = 1; } }   # no-progress guard
                if stop == 1 { guard = 40; }
                if stop == 0 {
                    last_off = off; last_kind = k;
                    srclen = sc_splice(g_src, srclen, off, txt, load64(g_ins_len));
                    store8(g_src + srclen, 0);
                    store64(g_fix_count, load64(g_fix_count) + 1);
                    guard = guard + 1;
                }
            }
        }
    }
    store64(g_recover, 0);
    store64(g_perr, 0);
    return srclen;
}

func main() -> i32 {
    cmdline = GetCommandLineA();
    p       = cmdline;

    # skip argv[0]  (the .exe path)
    p = skip_spaces(p);
    if load8(p) == 0 { syscall 1, m_banner, m_usage; return 1; }
    p = copy_token(p, g_arg3);   # argv[0] discarded

    # remaining tokens: flags (--fix / --write) + up to two positionals (in, out).
    # With NO flags this leaves g_arg1=in, g_arg2=out exactly as before (fixpoint-safe).
    npos = 0;
    going = 1;
    while going == 1 {
        p = skip_spaces(p);
        if load8(p) == 0 { going = 0; }
        if going == 1 {
            p = copy_token(p, g_arg3);
            if arg_is(g_arg3, fx_ffix) == 1 { store64(g_fix_mode, 1); }
            else {
                if arg_is(g_arg3, fx_fwrite) == 1 { store64(g_fix_write, 1); }
                else {
                    if arg_is(g_arg3, fx_fcheck) == 1 { store64(g_check_mode, 1); }   # SC4
                    else {
                        if arg_is(g_arg3, fx_tlinux) == 1 { store64(g_targetlinux, 1); }   # M5: Linux ELF (does NOT advance npos)
                        else {
                            if arg_is(g_arg3, fx_tlinuxdyn) == 1 { store64(g_targetlinux, 1); store64(g_targetlinuxdyn, 1); }   # L4a: dynamic ELF
                            else {
                                if npos == 0 { sc_strcpy(g_arg1, g_arg3); npos = 1; }
                                else { if npos == 1 { sc_strcpy(g_arg2, g_arg3); npos = 2; } }
                            }
                        }
                    }
                }
            }
        }
    }
    if load64(g_fix_mode) == 0 { if npos < 2 { syscall 1, m_banner, m_usage; return 1; } }
    else { if npos < 1 { syscall 1, m_banner, m_usage; return 1; } }

    in_path  = g_arg1;
    out_path = g_arg2;

    # Read input file
    fh = CreateFileA(in_path, 2147483648, 1, 0, 3, 128, 0);
    if fh == 0 - 1 { syscall 1, m_read_err; return 1; }
    ReadFile(fh, g_src, 2097151, g_nread, 0);
    CloseHandle(fh);
    srclen = load64(g_nread);
    store8(g_src + srclen, 0);

    # SC1 --fix: deterministic text pre-passes, then report/write and STOP
    # (never lex/parse/codegen in fix mode). Only reachable under --fix.
    if load64(g_fix_mode) == 1 {
        srclen = fix_f3_comments(g_src, srclen);
        srclen = fix_f4_keywords(g_src, srclen);
        store8(g_src + srclen, 0);
        srclen = sc_fix_parse_loop(srclen);          # F1/F2: insert missing structural tokens, then re-parse
        store8(g_src + srclen, 0);
        if load64(g_fix_count) == 0 { syscall 1, mf_none; return 0; }
        syscall 1, mf_pre, load64(g_fix_count), mf_mid;
        if load64(g_fix_write) == 1 {
            wn = sc_strcpy(g_bak_path, in_path);
            store8(g_bak_path + wn, 46); store8(g_bak_path + wn + 1, 98);
            store8(g_bak_path + wn + 2, 97); store8(g_bak_path + wn + 3, 107);
            store8(g_bak_path + wn + 4, 0);                       # ".bak\0"
            CopyFileA(in_path, g_bak_path, 0);                    # back up original (in_path not yet overwritten)
            wf = CreateFileA(in_path, 1073741824, 0, 0, 2, 128, 0);  # GENERIC_WRITE, CREATE_ALWAYS
            WriteFile(wf, g_src, srclen, g_nread, 0);
            CloseHandle(wf);
            syscall 1, mf_appl;
        } else {
            syscall 1, mf_prop;
        }
        return 0;
    }

    # Lex
    ntok = lex_init(g_src, srclen);
    syscall 1, m_lex_ok, ntok, m_tok;

    # Parse
    par_init();
    par_program();
    if load64(g_check_mode) == 1 { par_check_runner(); }   # SC4: (re)define main as the intent runner
    build_tool_registry();         # assemble the tools_json array (no-op if no `tool` decls)
    nfuncs = load64(g_fn_count);
    syscall 1, m_par_ok, nfuncs, m_funcs;

    # Codegen
    code_bytes = cg_run();
    syscall 1, m_cg_ok, code_bytes, m_bytes;

    # Write the binary: dynamic Linux ELF (--target=linux-dyn), static Linux ELF (--target=linux), or Windows PE (default)
    if load64(g_targetlinux) == 1 {
        if load64(g_targetlinuxdyn) == 1 { elf_write_dyn(out_path); }
        else { elf_write(out_path); }
    }
    else { pe_write(out_path); }
    syscall 1, m_ok;

    return 0;
}
# ===================== END main.ancl =====================

