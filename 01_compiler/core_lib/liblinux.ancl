# =====================================================================
#  liblinux.ancl  -  pure-ANCL Linux syscall wrappers  (core_lib)  [thread C / M3]
#
#  Friendly names over the raw `syscall(nr, a0..a5)` primitive so a Linux
#  file-I/O program reads naturally instead of dialing syscall numbers by hand.
#
#  LINUX TARGET ONLY: every wrapper uses `syscall(...)`, which the compiler
#  accepts only under `--target=linux` (a Windows/PE build errors out). No
#  `extern`, no imports -> the ELF stays CRT-free and import-free.
#  Use it from a Linux program:   import "../core_lib/liblinux.ancl";
#
#  Convention: each wrapper returns the raw kernel result -- a non-negative
#  value on success, or a negative -errno on failure -> test with `if r < 0`.
#  x86-64 syscall numbers:  read 0  write 1  open 2  close 3  lseek 8
#                           fsync 74  unlink 87  exit_group 231
# =====================================================================

@DATA
# ---- open() flags (x86-64 Linux, asm-generic) ----
O_RDONLY:    i64 = 0;
O_WRONLY:    i64 = 1;
O_RDWR:      i64 = 2;
O_CREAT:     i64 = 0x40;     # 64
O_EXCL:      i64 = 0x80;     # 128
O_TRUNC:     i64 = 0x200;    # 512
O_APPEND:    i64 = 0x400;    # 1024
# ---- lseek() whence ----
SEEK_SET:    i64 = 0;
SEEK_CUR:    i64 = 1;
SEEK_END:    i64 = 2;
# ---- standard file descriptors ----
LX_STDIN:    i64 = 0;
LX_STDOUT:   i64 = 1;
LX_STDERR:   i64 = 2;
# ---- a sane default create mode: 0644 (rw-r--r--) ----
LX_MODE_644: i64 = 420;
# ---- mmap() prot + flags ----
PROT_READ:     i64 = 1;
PROT_WRITE:    i64 = 2;
PROT_EXEC:     i64 = 4;
MAP_SHARED:    i64 = 1;
MAP_PRIVATE:   i64 = 2;
MAP_ANONYMOUS: i64 = 0x20;   # 32
# ---- Win-name shim scratch (M4) ----
g_lx_cmdline:  buf = 4096;    # GetCommandLineA: reflattened, space-joined argv
g_lx_copybuf:  buf = 4096;    # CopyFileA: copy chunk (looped)

@CODE
# ---- raw file primitives (return >=0 on success, <0 = -errno) ----
func lx_read(fd: i64, buf: i64, n: i64) -> i64  { return syscall(0, fd, buf, n); }
func lx_write(fd: i64, buf: i64, n: i64) -> i64 { return syscall(1, fd, buf, n); }
func lx_open(path: i64, flags: i64, mode: i64) -> i64 { return syscall(2, path, flags, mode); }
func lx_close(fd: i64) -> i64 { return syscall(3, fd); }
func lx_lseek(fd: i64, off: i64, whence: i64) -> i64 { return syscall(8, fd, off, whence); }
func lx_fsync(fd: i64) -> i64 { return syscall(74, fd); }
func lx_unlink(path: i64) -> i64 { return syscall(87, path); }

# ---- mmap()/munmap() : raw memory mapping. For a plain zeroed heap block prefer
#      alloc()/free() (the compiler builtins, also mmap-backed); use these to map a
#      FILE into memory (MAP_SHARED + fd) or for explicit control. Returns the address
#      (<0 = -errno). e.g. lx_mmap(0, len, PROT_READ, MAP_PRIVATE, fd, 0).
func lx_mmap(addr: i64, len: i64, prot: i64, flags: i64, fd: i64, off: i64) -> i64 {
    return syscall(9, addr, len, prot, flags, fd, off);
}
func lx_munmap(addr: i64, len: i64) -> i64 { return syscall(11, addr, len); }

# ---- exit: never returns (exit_group terminates the whole process) ----
func lx_exit(code: i64) -> i64 { syscall(231, code); return 0; }

# ---- convenience: intent-named opens (hide the O_* flag arithmetic) ----
func lx_create(path: i64) -> i64 {            # create/truncate for writing, 0644
    return lx_open(path, O_WRONLY | O_CREAT | O_TRUNC, LX_MODE_644);
}
func lx_open_read(path: i64) -> i64 {         # open an existing file for reading
    return lx_open(path, O_RDONLY, 0);
}
func lx_open_append(path: i64) -> i64 {       # open/create for appending, 0644
    return lx_open(path, O_WRONLY | O_CREAT | O_APPEND, LX_MODE_644);
}

# ---- convenience: string + stdio helpers (write a NUL-terminated string) ----
func lx_write_str(fd: i64, s: i64) -> i64 { return lx_write(fd, s, strlen(s)); }
func lx_print(s: i64) -> i64  { return lx_write(LX_STDOUT, s, strlen(s)); }   # -> stdout
func lx_eprint(s: i64) -> i64 { return lx_write(LX_STDERR, s, strlen(s)); }   # -> stderr

# =====================================================================
#  WINDOWS-NAME SHIMS (M4): translate the kernel32 file/cmdline API to Linux
#  syscalls. A Windows ANCL program's file code ports by importing THIS file
#  instead of core_lib/win32_api.ancl -- under --target=linux the compiler
#  resolves these funcs over the same-named builtin imports (isImport precedence).
#  Win32 conventions reproduced: BOOL = 1 success / 0 fail; HANDLE = the fd;
#  CreateFileA returns INVALID_HANDLE_VALUE (0-1) on failure.
# =====================================================================

# CreateFileA(name, access, share, sa, disposition, flags, template) -> HANDLE(fd) | -1
func CreateFileA(name: i64, access: i64, share: i64, sa: i64, disp: i64, flags: i64, tmpl: i64) -> i64 {
    rd = band(access, 0x80000000);   # GENERIC_READ
    wr = band(access, 0x40000000);   # GENERIC_WRITE
    of = O_RDONLY;
    if wr != 0 { of = O_WRONLY; }
    if rd != 0 { if wr != 0 { of = O_RDWR; } }
    if disp == 2 { of = bor(of, bor(O_CREAT, O_TRUNC)); }   # CREATE_ALWAYS
    if disp == 4 { of = bor(of, O_CREAT); }                 # OPEN_ALWAYS
    if disp == 1 { of = bor(of, bor(O_CREAT, O_EXCL)); }    # CREATE_NEW
    if disp == 5 { of = bor(of, O_TRUNC); }                 # TRUNCATE_EXISTING
    md = 0;
    if band(of, O_CREAT) != 0 { md = LX_MODE_644; }
    r = lx_open(name, of, md);
    if r < 0 { return 0 - 1; }        # INVALID_HANDLE_VALUE
    return r;
}

# ReadFile(handle, buf, nToRead, &bytesRead, overlapped) -> BOOL
func ReadFile(h: i64, buf: i64, n: i64, pGot: i64, ovl: i64) -> i64 {
    r = lx_read(h, buf, n);
    if r < 0 { if pGot != 0 { store64(pGot, 0); } return 0; }
    if pGot != 0 { store64(pGot, r); }
    return 1;
}

# WriteFile(handle, buf, nToWrite, &bytesWritten, overlapped) -> BOOL
func WriteFile(h: i64, buf: i64, n: i64, pPut: i64, ovl: i64) -> i64 {
    r = lx_write(h, buf, n);
    if r < 0 { if pPut != 0 { store64(pPut, 0); } return 0; }
    if pPut != 0 { store64(pPut, r); }
    return 1;
}

# CloseHandle(handle) -> BOOL
func CloseHandle(h: i64) -> i64 {
    if h <= 2 { return 1; }           # never close the mapped std fds 0/1/2
    r = lx_close(h);
    if r < 0 { return 0; }
    return 1;
}

# GetStdHandle(nStdHandle) -> HANDLE(fd) : STD_OUTPUT(-11)->1, STD_INPUT(-10)->0, STD_ERROR(-12)->2
func GetStdHandle(n: i64) -> i64 {
    if n == 0 - 11 { return 1; }
    if n == 0 - 10 { return 0; }
    if n == 0 - 12 { return 2; }
    return 0 - 1;
}

# SetFilePointer(handle, distLow, &distHigh, whence) -> new offset (FILE_BEGIN/CURRENT/END = SEEK_SET/CUR/END)
func SetFilePointer(h: i64, dist: i64, pHigh: i64, whence: i64) -> i64 {
    return lx_lseek(h, dist, whence);
}

# ExitProcess(code) : exit_group, never returns
func ExitProcess(code: i64) -> i64 { syscall(231, code); return 0; }

# GetCommandLineA() -> LPSTR : reflatten the entry-stack argv into one space-joined string
# (so a program's existing GetCommandLineA tokenizer runs unchanged). Needs the compiler's
# __argv_base() (the rsp captured at _start).
# Any argv element that itself contains a space (or is empty) is wrapped in double-quotes,
# so the consumer's quote-aware tokenizer (e.g. main.ancl cargs()) reconstructs it as ONE
# token instead of re-splitting on the interior spaces. Space-free args are emitted verbatim
# (bit-identical to the old behavior), so single-word invocations are unaffected. This is what
# lets multi-word prompts ("The capital of France is") + a following max_new arg survive.
func GetCommandLineA() -> i64 {
    sp = __argv_base();
    argc = load64(sp);
    out = g_lx_cmdline;
    pos = 0;
    i = 0;
    while i < argc {
        ap = load64(sp + 8 + i * 8);          # argv[i]
        # scan: does this arg contain a space, or is it empty? -> needs quoting to stay one token
        needq = 0;
        k = 0;
        while load8(ap + k) != 0 {
            if load8(ap + k) == 32 { needq = 1; }
            k = k + 1;
        }
        if k == 0 { needq = 1; }
        if needq == 1 { if pos < 4094 { store8(out + pos, 34); pos = pos + 1; } }   # opening "
        j = 0;
        while load8(ap + j) != 0 {
            if pos < 4094 { store8(out + pos, load8(ap + j)); pos = pos + 1; }
            j = j + 1;
        }
        if needq == 1 { if pos < 4094 { store8(out + pos, 34); pos = pos + 1; } }   # closing "
        if i < argc - 1 { if pos < 4094 { store8(out + pos, 32); pos = pos + 1; } }
        i = i + 1;
    }
    store8(out + pos, 0);
    return out;
}

# CopyFileA(src, dst, bFailIfExists) -> BOOL : read/write loop (no sendfile; CRT-free)
func CopyFileA(src: i64, dst: i64, fail: i64) -> i64 {
    sfd = lx_open(src, O_RDONLY, 0);
    if sfd < 0 { return 0; }
    dfd = lx_create(dst);                      # O_WRONLY|O_CREAT|O_TRUNC, 0644
    if dfd < 0 { lx_close(sfd); return 0; }
    while 1 {
        got = lx_read(sfd, g_lx_copybuf, 4096);
        if got <= 0 { break; }
        lx_write(dfd, g_lx_copybuf, got);
    }
    lx_close(sfd);
    lx_close(dfd);
    return 1;
}
