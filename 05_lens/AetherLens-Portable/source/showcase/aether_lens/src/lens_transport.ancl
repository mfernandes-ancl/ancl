# =====================================================================
#  lens_transport.ancl - WinHTTP transports for Aether Lens.
#
#  Reuses the Aether Studio transport approach, extended with Ollama pull
#  and delete so Lens can manage local or remote Ollama model stores.
# =====================================================================
extern "winhttp.dll" WinHttpOpen -> ptr;
extern "winhttp.dll" WinHttpSetTimeouts;
extern "winhttp.dll" WinHttpSetOption;
extern "winhttp.dll" WinHttpConnect -> ptr;
extern "winhttp.dll" WinHttpOpenRequest -> ptr;
extern "winhttp.dll" WinHttpAddRequestHeaders;
extern "winhttp.dll" WinHttpSendRequest;
extern "winhttp.dll" WinHttpReceiveResponse;
extern "winhttp.dll" WinHttpQueryHeaders;
extern "winhttp.dll" WinHttpReadData;
extern "winhttp.dll" WinHttpCloseHandle;
extern "user32.dll"  PostMessageA;

@DATA
lt_ua_a:      str = "AetherLens/1.0";
lt_hdr_json:  str = "content-type: application/json";
lt_get_a:     str = "GET";
lt_post_a:    str = "POST";
lt_delete_a:  str = "DELETE";
lt_tags_path: str = "/api/tags";
lt_chat_path: str = "/api/chat";
lt_pull_path: str = "/api/pull";
lt_del_path:  str = "/api/delete";
lt_show_path: str = "/api/show";
lt_auth_pfx:  str = "Authorization: Bearer ";
lt_http:      str = "http://";
lt_https:     str = "https://";

lt_host_w: buf = 512;
lt_ua_w:   buf = 64;
lt_hdr_w:  buf = 256;
lt_verb_w: buf = 24;
lt_path_w: buf = 1024;
lt_xhdr_w: buf = 4096;
lt_auth_a: buf = 2048;
lt_redirect_policy: buf = 8;
lt_web_host: buf = 256;
lt_web_port: buf = 8;
lt_web_sec: buf = 8;
lt_web_path: buf = 1024;

lt_cur_host: buf = 256;
lt_cur_port: buf = 8;
lt_cur_sec:  buf = 8;
lt_def_host: str = "127.0.0.1";

lt_status: buf = 8;
lt_slen:   buf = 8;
lt_nread:  buf = 8;
lt_cur_req: buf = 8;
lt_progress_hwnd: buf = 8;
lt_progress_msg:  buf = 8;

@CODE
func lt_a2w(dst: i64, src: i64) -> i64 {
    i = 0;
    while 1 {
        c = load8(src + i);
        store8(dst + i * 2, c);
        store8(dst + i * 2 + 1, 0);
        if c == 0 { return i * 2; }
        i = i + 1;
    }
    return 0;
}

func lt_match(s: i64, pos: i64, pat: i64) -> i64 {
    j = 0;
    while 1 {
        pc = load8(pat + j);
        if pc == 0 { return 1; }
        if load8(s + pos + j) != pc { return 0; }
        j = j + 1;
    }
    return 0;
}

func lt_match_ci(s: i64, pos: i64, pat: i64) -> i64 {
    j = 0;
    while 1 {
        pc = load8(pat + j);
        if pc == 0 { return 1; }
        sc = load8(s + pos + j);
        if sc >= 65 { if sc <= 90 { sc = sc + 32; } }
        if pc >= 65 { if pc <= 90 { pc = pc + 32; } }
        if sc != pc { return 0; }
        j = j + 1;
    }
    return 0;
}

func lt_close_req() -> i64 {
    h = load64(lt_cur_req);
    if h != 0 {
        store64(lt_cur_req, 0);
        WinHttpCloseHandle(h);
    }
    return 0;
}

func lt_abort() -> i64 {
    lt_close_req();
    return 0;
}

func lt_progress_to(hwnd: i64, msg: i64) -> i64 {
    store64(lt_progress_hwnd, hwnd);
    store64(lt_progress_msg, msg);
    return 0;
}

func lt_progress_clear() -> i64 {
    store64(lt_progress_hwnd, 0);
    store64(lt_progress_msg, 0);
    return 0;
}

func lt_http3(host_a: i64, port: i64, secure: i64, verb_a: i64, path_a: i64, xhdr_a: i64, body: i64, blen: i64, resp: i64, cap: i64, receive_ms: i64, allow_redirects: i64) -> i64 {
    if cap <= 1 { return 0; }
    store8(resp, 0);
    lt_a2w(lt_host_w, host_a);
    lt_a2w(lt_ua_w, lt_ua_a);
    lt_a2w(lt_hdr_w, lt_hdr_json);
    lt_a2w(lt_verb_w, verb_a);
    lt_a2w(lt_path_w, path_a);

    hs = WinHttpOpen(lt_ua_w, 0, 0, 0, 0);
    if hs == 0 { return 0; }
    connect_ms = 30000;
    send_ms = 60000;
    if receive_ms < connect_ms { connect_ms = receive_ms; }
    if receive_ms < send_ms { send_ms = receive_ms; }
    WinHttpSetTimeouts(hs, connect_ms, connect_ms, send_ms, receive_ms);
    hc = WinHttpConnect(hs, lt_host_w, port, 0);
    if hc == 0 { WinHttpCloseHandle(hs); return 0; }
    fl = 0;
    if secure == 1 { fl = 0x00800000; }
    hr = WinHttpOpenRequest(hc, lt_verb_w, lt_path_w, 0, 0, 0, fl);
    if hr == 0 {
        WinHttpCloseHandle(hc);
        WinHttpCloseHandle(hs);
        return 0;
    }
    store64(lt_cur_req, hr);
    if allow_redirects == 0 {
        store32(lt_redirect_policy, 0);
        if WinHttpSetOption(hr, 88, lt_redirect_policy, 4) == 0 {
            lt_close_req(); WinHttpCloseHandle(hc); WinHttpCloseHandle(hs); return 0;
        }
    }
    WinHttpAddRequestHeaders(hr, lt_hdr_w, 0 - 1, 0x20000000);
    if xhdr_a != 0 {
        lt_a2w(lt_xhdr_w, xhdr_a);
        WinHttpAddRequestHeaders(hr, lt_xhdr_w, 0 - 1, 0x20000000);
    }

    sok = WinHttpSendRequest(hr, 0, 0, body, blen, blen, 0);
    if sok == 0 {
        lt_close_req();
        WinHttpCloseHandle(hc);
        WinHttpCloseHandle(hs);
        return 0;
    }
    rok = WinHttpReceiveResponse(hr, 0);
    if rok == 0 {
        lt_close_req();
        WinHttpCloseHandle(hc);
        WinHttpCloseHandle(hs);
        return 0;
    }

    store32(lt_slen, 4);
    WinHttpQueryHeaders(hr, 0x20000013, 0, lt_status, lt_slen, 0);
    total = 0;
    while 1 {
        chunk = cap - total - 1;
        if chunk <= 0 { break; }
        if chunk > 65536 { chunk = 65536; }
        if load64(lt_progress_hwnd) != 0 {
            if chunk > 256 { chunk = 256; }
        }
        rd = WinHttpReadData(hr, resp + total, chunk, lt_nread);
        if rd == 0 { break; }
        n = load32(lt_nread);
        if n == 0 { break; }
        total = total + n;
        store8(resp + total, 0);
        if load64(lt_progress_hwnd) != 0 {
            PostMessageA(load64(lt_progress_hwnd), load64(lt_progress_msg), total, 0);
        }
    }
    store8(resp + total, 0);
    lt_close_req();
    WinHttpCloseHandle(hc);
    WinHttpCloseHandle(hs);
    return load32(lt_status);
}

func lt_http2(host_a: i64, port: i64, secure: i64, verb_a: i64, path_a: i64, xhdr_a: i64, body: i64, blen: i64, resp: i64, cap: i64) -> i64 {
    return lt_http3(host_a, port, secure, verb_a, path_a, xhdr_a, body, blen, resp, cap, 600000, 1);
}

func lt_set_target(host_a: i64, port: i64, secure: i64) -> i64 {
    str_copy(lt_cur_host, host_a);
    store64(lt_cur_port, port);
    store64(lt_cur_sec, secure);
    return 0;
}

func lt_target_init() -> i64 {
    str_copy(lt_cur_host, lt_def_host);
    store64(lt_cur_port, 11434);
    store64(lt_cur_sec, 0);
    return 0;
}

func lt_ollama_tags(resp: i64, cap: i64) -> i64 {
    return lt_http2(lt_cur_host, load64(lt_cur_port), load64(lt_cur_sec), lt_get_a, lt_tags_path, 0, 0, 0, resp, cap);
}

func lt_ollama_chat(body: i64, resp: i64, cap: i64) -> i64 {
    return lt_http2(lt_cur_host, load64(lt_cur_port), load64(lt_cur_sec), lt_post_a, lt_chat_path, 0, body, strlen(body), resp, cap);
}

func lt_ollama_pull(body: i64, resp: i64, cap: i64) -> i64 {
    return lt_http2(lt_cur_host, load64(lt_cur_port), load64(lt_cur_sec), lt_post_a, lt_pull_path, 0, body, strlen(body), resp, cap);
}

func lt_ollama_delete(body: i64, resp: i64, cap: i64) -> i64 {
    return lt_http2(lt_cur_host, load64(lt_cur_port), load64(lt_cur_sec), lt_delete_a, lt_del_path, 0, body, strlen(body), resp, cap);
}

func lt_ollama_show(body: i64, resp: i64, cap: i64) -> i64 {
    return lt_http2(lt_cur_host, load64(lt_cur_port), load64(lt_cur_sec), lt_post_a, lt_show_path, 0, body, strlen(body), resp, cap);
}

func lt_oai_chat(host_a: i64, port: i64, secure: i64, path_a: i64, key_a: i64, body: i64, resp: i64, cap: i64) -> i64 {
    e = str_copy(lt_auth_a, lt_auth_pfx);
    str_copy(e, key_a);
    return lt_http2(host_a, port, secure, lt_post_a, path_a, lt_auth_a, body, strlen(body), resp, cap);
}

func lt_header_chat(host_a: i64, port: i64, secure: i64, path_a: i64, header_a: i64, body: i64, resp: i64, cap: i64) -> i64 {
    return lt_http2(host_a, port, secure, lt_post_a, path_a, header_a, body, strlen(body), resp, cap);
}

func lt_url_split(url: i64, host_out: i64, port_out: i64, sec_out: i64, path_out: i64) -> i64 {
    i = 0;
    sec = 0;
    if lt_match_ci(url, 0, lt_https) == 1 { sec = 1; i = 8; }
    else { if lt_match_ci(url, 0, lt_http) == 1 { sec = 0; i = 7; } }
    store64(sec_out, sec);

    h = 0;
    while 1 {
        c = load8(url + i);
        if c == 0 { break; }
        if c == 58 { break; }
        if c == 47 { break; }
        store8(host_out + h, c);
        h = h + 1;
        i = i + 1;
    }
    store8(host_out + h, 0);

    p = 80;
    if sec == 1 { p = 443; }
    if load8(url + i) == 58 {
        i = i + 1;
        p = 0;
        while 1 {
            c = load8(url + i);
            if c < 48 { break; }
            if c > 57 { break; }
            p = p * 10 + c - 48;
            i = i + 1;
        }
    }
    store64(port_out, p);

    k = 0;
    while 1 {
        c = load8(url + i);
        if c == 0 { break; }
        store8(path_out + k, c);
        k = k + 1;
        i = i + 1;
    }
    store8(path_out + k, 0);
    return 0;
}

func lt_web_get(url: i64, resp: i64, cap: i64) -> i64 {
    lt_url_split(url, lt_web_host, lt_web_port, lt_web_sec, lt_web_path);
    if load8(lt_web_path) == 0 { store8(lt_web_path, 47); store8(lt_web_path + 1, 0); }
    return lt_http3(lt_web_host, load64(lt_web_port), load64(lt_web_sec), lt_get_a, lt_web_path, 0, 0, 0, resp, cap, 15000, 0);
}
