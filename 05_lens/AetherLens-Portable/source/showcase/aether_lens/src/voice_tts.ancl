# Aether Lens R6 Stage 3: native, offline Windows SAPI text-to-WAV synthesis.
# No network, model server, subprocess, .NET, or third-party runtime is used.

import "../../../core_lib/win32_com.ancl";

extern "kernel32.dll" MultiByteToWideChar -> i32;
extern "kernel32.dll" WideCharToMultiByte -> i32;
extern "kernel32.dll" GetFileAttributesA;
extern "kernel32.dll" DeleteFileA;

@DATA
lvtts_clsid_stream: buf = 16;
lvtts_iid_stream: buf = 16;
lvtts_clsid_voice: buf = 16;
lvtts_iid_voice: buf = 16;
lvtts_wave_format_guid: buf = 16;
lvtts_wave_format: buf = 20;
lvtts_stream_p: buf = 8;
lvtts_voice_p: buf = 8;
lvtts_token_p: buf = 8;
lvtts_name_p: buf = 8;
lvtts_wpath: buf = 1800;
lvtts_wtext: buf = 32768;
lvtts_runtime_fallback: str = "Windows SAPI in-process voice (local/offline)";

@CODE
func lvtts_guid_init() -> i64 {
    # CLSID_SpStream {715D9C59-4442-11D2-9605-00C04F8EE628}
    store32(lvtts_clsid_stream + 0, 0x715D9C59);
    store16(lvtts_clsid_stream + 4, 0x4442); store16(lvtts_clsid_stream + 6, 0x11D2);
    store8(lvtts_clsid_stream + 8, 0x96); store8(lvtts_clsid_stream + 9, 0x05);
    store8(lvtts_clsid_stream + 10, 0x00); store8(lvtts_clsid_stream + 11, 0xC0);
    store8(lvtts_clsid_stream + 12, 0x4F); store8(lvtts_clsid_stream + 13, 0x8E);
    store8(lvtts_clsid_stream + 14, 0xE6); store8(lvtts_clsid_stream + 15, 0x28);
    # IID_ISpStream {12E3CCA9-7518-44C5-A5E7-BA5A79CB929E}
    store32(lvtts_iid_stream + 0, 0x12E3CCA9);
    store16(lvtts_iid_stream + 4, 0x7518); store16(lvtts_iid_stream + 6, 0x44C5);
    store8(lvtts_iid_stream + 8, 0xA5); store8(lvtts_iid_stream + 9, 0xE7);
    store8(lvtts_iid_stream + 10, 0xBA); store8(lvtts_iid_stream + 11, 0x5A);
    store8(lvtts_iid_stream + 12, 0x79); store8(lvtts_iid_stream + 13, 0xCB);
    store8(lvtts_iid_stream + 14, 0x92); store8(lvtts_iid_stream + 15, 0x9E);
    # CLSID_SpVoice {96749377-3391-11D2-9EE3-00C04F797396}
    store32(lvtts_clsid_voice + 0, 0x96749377);
    store16(lvtts_clsid_voice + 4, 0x3391); store16(lvtts_clsid_voice + 6, 0x11D2);
    store8(lvtts_clsid_voice + 8, 0x9E); store8(lvtts_clsid_voice + 9, 0xE3);
    store8(lvtts_clsid_voice + 10, 0x00); store8(lvtts_clsid_voice + 11, 0xC0);
    store8(lvtts_clsid_voice + 12, 0x4F); store8(lvtts_clsid_voice + 13, 0x79);
    store8(lvtts_clsid_voice + 14, 0x73); store8(lvtts_clsid_voice + 15, 0x96);
    # IID_ISpVoice {6C44DF74-72B9-4992-A1EC-EF996E0422D4}
    store32(lvtts_iid_voice + 0, 0x6C44DF74);
    store16(lvtts_iid_voice + 4, 0x72B9); store16(lvtts_iid_voice + 6, 0x4992);
    store8(lvtts_iid_voice + 8, 0xA1); store8(lvtts_iid_voice + 9, 0xEC);
    store8(lvtts_iid_voice + 10, 0xEF); store8(lvtts_iid_voice + 11, 0x99);
    store8(lvtts_iid_voice + 12, 0x6E); store8(lvtts_iid_voice + 13, 0x04);
    store8(lvtts_iid_voice + 14, 0x22); store8(lvtts_iid_voice + 15, 0xD4);
    # SPDFID_WaveFormatEx {C31ADBAE-527F-4FF5-A230-F62BB61FF70C}
    store32(lvtts_wave_format_guid + 0, 0xC31ADBAE);
    store16(lvtts_wave_format_guid + 4, 0x527F); store16(lvtts_wave_format_guid + 6, 0x4FF5);
    store8(lvtts_wave_format_guid + 8, 0xA2); store8(lvtts_wave_format_guid + 9, 0x30);
    store8(lvtts_wave_format_guid + 10, 0xF6); store8(lvtts_wave_format_guid + 11, 0x2B);
    store8(lvtts_wave_format_guid + 12, 0xB6); store8(lvtts_wave_format_guid + 13, 0x1F);
    store8(lvtts_wave_format_guid + 14, 0xF7); store8(lvtts_wave_format_guid + 15, 0x0C);
    memset(lvtts_wave_format, 0, 20);
    store16(lvtts_wave_format + 0, 1); store16(lvtts_wave_format + 2, 1);
    store32(lvtts_wave_format + 4, 16000); store32(lvtts_wave_format + 8, 32000);
    store16(lvtts_wave_format + 12, 2); store16(lvtts_wave_format + 14, 16);
    store16(lvtts_wave_format + 16, 0);
    return 1;
}

func lvtts_wlen(src: i64) -> i64 {
    n = 0; while load16(src + n * 2) != 0 { n = n + 1; } return n;
}

func lvtts_wide_to_utf8(src: i64, dst: i64, cap: i64) -> i64 {
    if src == 0 { store8(dst, 0); return 0; }
    n = lvtts_wlen(src); if n <= 0 { store8(dst, 0); return 0; }
    out = WideCharToMultiByte(65001, 0, src, n, dst, cap - 1, 0, 0);
    if out <= 0 { store8(dst, 0); return 0; }
    store8(dst + out, 0); return out;
}

func lvtts_path_to_wide(src: i64) -> i64 {
    memset(lvtts_wpath, 0, 1800);
    return MultiByteToWideChar(0, 0, src, 0 - 1, lvtts_wpath, 900);
}

func lvtts_text_to_wide(src: i64) -> i64 {
    memset(lvtts_wtext, 0, 32768);
    n = MultiByteToWideChar(65001, 0, src, 0 - 1, lvtts_wtext, 16384);
    if n <= 0 { n = MultiByteToWideChar(0, 0, src, 0 - 1, lvtts_wtext, 16384); }
    return n;
}

func lvtts_match_at(src: i64, pos: i64, token: i64) -> i64 {
    j = 0; while load8(token + j) != 0 { if load8(src + pos + j) != load8(token + j) { return 0; } j = j + 1; }
    return 1;
}

func lvtts_find(src: i64, from: i64, end: i64, token: i64) -> i64 {
    i = from; n = strlen(token);
    while i + n <= end { if lvtts_match_at(src, i, token) == 1 { return i; } i = i + 1; }
    return 0 - 1;
}

# Copies speakable answer text while always removing <think> tags. Hidden
# reasoning bodies remain omitted unless the user explicitly revealed them.
func lvtts_prepare_visible(src: i64, dst: i64, cap: i64, show_reasoning: i64, truncated_ptr: i64) -> i64 {
    if cap <= 1 { return 0; }
    if truncated_ptr != 0 { store64(truncated_ptr, 0); }
    n = strlen(src); i = 0; out = 0;
    while i < n {
        if lvtts_match_at(src, i, "<think>") == 1 {
            body = i + 7; close = lvtts_find(src, body, n, "</think>"); if close < 0 { close = n; }
            if show_reasoning == 1 {
                j = body;
                while j < close {
                    if out + 1 >= cap { if truncated_ptr != 0 { store64(truncated_ptr, 1); } break; }
                    store8(dst + out, load8(src + j)); out = out + 1; j = j + 1;
                }
            }
            if close < n { i = close + 8; } else { i = n; }
        } else {
            if out + 1 >= cap { if truncated_ptr != 0 { store64(truncated_ptr, 1); } break; }
            store8(dst + out, load8(src + i)); out = out + 1; i = i + 1;
        }
    }
    store8(dst + out, 0); return out;
}

func lvtts_runtime_name(voice: i64, dst: i64, cap: i64) -> i64 {
    str_copy(dst, lvtts_runtime_fallback);
    store64(lvtts_token_p, 0);
    if callp(vmeth(voice, 19), voice, lvtts_token_p) < 0 { return 0; }
    token = load64(lvtts_token_p); if token == 0 { return 0; }
    store64(lvtts_name_p, 0);
    hr = callp(vmeth(token, 6), token, 0, lvtts_name_p);
    if hr >= 0 {
        wide = load64(lvtts_name_p);
        if wide != 0 { lvtts_wide_to_utf8(wide, dst, cap); CoTaskMemFree(wide); }
    }
    com_release(token); store64(lvtts_token_p, 0); return 1;
}

func lvtts_cleanup(stream: i64, voice: i64, co_ok: i64) -> i64 {
    if voice != 0 { callp(vmeth(voice, 13), voice, 0, 1); com_release(voice); }
    if stream != 0 { callp(vmeth(stream, 18), stream); com_release(stream); }
    if co_ok == 1 { CoUninitialize(); }
    return 0;
}

# Returns 1=generated, -1=no local voice, -2=file/input, -3=synthesis,
# -4=cancelled/timeout. Output is a standard local WAV and is never played here.
func lvtts_synthesize_file(text: i64, path: i64, runtime: i64, runtime_cap: i64, cancel_ptr: i64) -> i64 {
    str_copy(runtime, lvtts_runtime_fallback);
    if text == 0 { return 0 - 2; }
    if load8(text) == 0 { return 0 - 2; }
    lvtts_guid_init();
    if lvtts_path_to_wide(path) <= 0 { return 0 - 2; }
    if lvtts_text_to_wide(text) <= 0 { return 0 - 2; }
    cohr = CoInitializeEx(0, 0); if cohr < 0 { return 0 - 3; }
    co_ok = 1; stream = 0; voice = 0;
    store64(lvtts_stream_p, 0);
    hr = CoCreateInstance(lvtts_clsid_stream, 0, 1, lvtts_iid_stream, lvtts_stream_p);
    if hr < 0 { lvtts_cleanup(stream, voice, co_ok); return 0 - 2; }
    stream = load64(lvtts_stream_p);
    hr = callp(vmeth(stream, 17), stream, lvtts_wpath, 3, lvtts_wave_format_guid, lvtts_wave_format, 0);
    if hr < 0 { lvtts_cleanup(stream, voice, co_ok); return 0 - 2; }
    store64(lvtts_voice_p, 0);
    hr = CoCreateInstance(lvtts_clsid_voice, 0, 1, lvtts_iid_voice, lvtts_voice_p);
    if hr < 0 { lvtts_cleanup(stream, voice, co_ok); DeleteFileA(path); return 0 - 1; }
    voice = load64(lvtts_voice_p); lvtts_runtime_name(voice, runtime, runtime_cap);
    hr = callp(vmeth(voice, 13), voice, stream, 1);
    if hr < 0 { lvtts_cleanup(stream, voice, co_ok); DeleteFileA(path); return 0 - 3; }
    hr = callp(vmeth(voice, 20), voice, lvtts_wtext, 17, 0);
    if hr < 0 { lvtts_cleanup(stream, voice, co_ok); DeleteFileA(path); return 0 - 3; }
    start = GetTickCount(); cancelled = 0; failed = 0; done = 0;
    while done == 0 {
        if cancel_ptr != 0 { if load64(cancel_ptr) != 0 { cancelled = 1; } }
        if band(GetTickCount() - start, 4294967295) > 120000 { cancelled = 1; }
        if cancelled == 1 {
            callp(vmeth(voice, 20), voice, 0, 3, 0);
            callp(vmeth(voice, 32), voice, 1000);
            break;
        }
        hr = callp(vmeth(voice, 32), voice, 100);
        if hr == 0 { done = 1; }
        else { if hr < 0 { failed = 1; break; } }
    }
    lvtts_cleanup(stream, voice, co_ok);
    if cancelled == 1 { DeleteFileA(path); return 0 - 4; }
    if failed == 1 { DeleteFileA(path); return 0 - 3; }
    if band(GetFileAttributesA(path), 4294967295) == 4294967295 { return 0 - 2; }
    return 1;
}
