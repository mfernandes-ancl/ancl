# =====================================================================
# artifact_security.ancl - fail-closed HTML/SVG preview policy.
# No rewriting: unsafe input is rejected and remains available to Copy/Save.
# =====================================================================

@CODE
func las_lower(c: i64) -> i64 {
    if c >= 65 { if c <= 90 { return c + 32; } }
    return c;
}

func las_match_ci(src: i64, pos: i64, ndl: i64) -> i64 {
    j = 0;
    while 1 {
        c = load8(ndl + j);
        if c == 0 { return 1; }
        if load8(src + pos + j) == 0 { return 0; }
        if las_lower(load8(src + pos + j)) != las_lower(c) { return 0; }
        j = j + 1;
    }
    return 0;
}

func las_contains_ci(src: i64, ndl: i64) -> i64 {
    i = 0;
    while load8(src + i) != 0 {
        if las_match_ci(src, i, ndl) == 1 { return 1; }
        i = i + 1;
    }
    return 0;
}

func las_has_tag(src: i64, name: i64) -> i64 {
    i = 0;
    while load8(src + i) != 0 {
        if load8(src + i) == 60 {
            j = i + 1;
            while las_space(load8(src + j)) == 1 { j = j + 1; }
            if load8(src + j) == 47 { j = j + 1; }
            if las_match_ci(src, j, name) == 1 {
                k = j + strlen(name);
                c = load8(src + k);
                if c == 0 { return 1; }
                if las_space(c) == 1 { return 1; }
                if c == 47 { return 1; }
                if c == 62 { return 1; }
            }
        }
        i = i + 1;
    }
    return 0;
}

func las_space(c: i64) -> i64 {
    if c == 32 { return 1; }
    if c == 9 { return 1; }
    if c == 10 { return 1; }
    if c == 13 { return 1; }
    return 0;
}

func las_name_char(c: i64) -> i64 {
    c = las_lower(c);
    if c >= 97 { if c <= 122 { return 1; } }
    if c >= 48 { if c <= 57 { return 1; } }
    if c == 45 { return 1; }
    if c == 95 { return 1; }
    if c == 58 { return 1; }
    return 0;
}

func las_has_event_attribute(src: i64) -> i64 {
    i = 0;
    in_tag = 0;
    while load8(src + i) != 0 {
        c = load8(src + i);
        if c == 60 { in_tag = 1; }
        else if c == 62 { in_tag = 0; }
        else if in_tag == 1 { if las_space(c) == 1 {
            j = i + 1;
            while las_space(load8(src + j)) == 1 { j = j + 1; }
            if las_lower(load8(src + j)) == 111 { if las_lower(load8(src + j + 1)) == 110 {
                k = j + 2;
                while las_name_char(load8(src + k)) == 1 { k = k + 1; }
                if k > j + 2 {
                    while las_space(load8(src + k)) == 1 { k = k + 1; }
                    if load8(src + k) == 61 { return 1; }
                }
            } }
        } }
        i = i + 1;
    }
    return 0;
}

func las_has_attribute(src: i64, name: i64) -> i64 {
    i = 0;
    in_tag = 0;
    while load8(src + i) != 0 {
        c = load8(src + i);
        if c == 60 { in_tag = 1; }
        else if c == 62 { in_tag = 0; }
        else if in_tag == 1 { if las_space(c) == 1 {
            j = i + 1;
            while las_space(load8(src + j)) == 1 { j = j + 1; }
            if las_match_ci(src, j, name) == 1 {
                k = j + strlen(name);
                if las_name_char(load8(src + k)) == 0 {
                    while las_space(load8(src + k)) == 1 { k = k + 1; }
                    if load8(src + k) == 61 { return 1; }
                }
            }
        } }
        i = i + 1;
    }
    return 0;
}

# Only local SVG paint references such as url(#gradient) are allowed.
func las_urls_are_fragments(src: i64) -> i64 {
    i = 0;
    while load8(src + i) != 0 {
        if las_match_ci(src, i, "url(") == 1 {
            j = i + 4;
            while las_space(load8(src + j)) == 1 { j = j + 1; }
            if load8(src + j) != 35 { return 0; }
            j = j + 1;
            if las_name_char(load8(src + j)) == 0 { return 0; }
            while las_name_char(load8(src + j)) == 1 { j = j + 1; }
            while las_space(load8(src + j)) == 1 { j = j + 1; }
            if load8(src + j) != 41 { return 0; }
            i = j;
        }
        i = i + 1;
    }
    return 1;
}

# Permit only the inert standard SVG namespace spelling. Every other http(s)
# token or protocol-relative URL remains blocked.
func las_network_tokens_safe(src: i64) -> i64 {
    i = 0;
    while load8(src + i) != 0 {
        if las_match_ci(src, i, "xmlns=\"http://www.w3.org/2000/svg\"") == 1 {
            i = i + strlen("xmlns=\"http://www.w3.org/2000/svg\"");
        } else if las_match_ci(src, i, "xmlns='http://www.w3.org/2000/svg'") == 1 {
            i = i + strlen("xmlns='http://www.w3.org/2000/svg'");
        } else {
            if las_match_ci(src, i, "http:") == 1 { return 0; }
            if las_match_ci(src, i, "https:") == 1 { return 0; }
            if las_match_ci(src, i, "//") == 1 { return 0; }
            i = i + 1;
        }
    }
    return 1;
}

func las_artifact_safe(src: i64) -> i64 {
    n = strlen(src);
    if n == 0 { return 0; }
    if n > 262144 { return 0; }
    if las_has_event_attribute(src) == 1 { return 0; }
    if las_urls_are_fragments(src) == 0 { return 0; }

    if las_has_tag(src, "script") == 1 { return 0; }
    if las_has_tag(src, "iframe") == 1 { return 0; }
    if las_has_tag(src, "frame") == 1 { return 0; }
    if las_has_tag(src, "object") == 1 { return 0; }
    if las_has_tag(src, "embed") == 1 { return 0; }
    if las_has_tag(src, "applet") == 1 { return 0; }
    if las_has_tag(src, "form") == 1 { return 0; }
    if las_has_tag(src, "input") == 1 { return 0; }
    if las_has_tag(src, "button") == 1 { return 0; }
    if las_has_tag(src, "textarea") == 1 { return 0; }
    if las_has_tag(src, "select") == 1 { return 0; }
    if las_has_tag(src, "base") == 1 { return 0; }
    if las_has_tag(src, "link") == 1 { return 0; }
    if las_has_tag(src, "foreignobject") == 1 { return 0; }
    if las_has_tag(src, "image") == 1 { return 0; }
    if las_has_tag(src, "use") == 1 { return 0; }
    if las_has_tag(src, "animate") == 1 { return 0; }
    if las_has_tag(src, "animatemotion") == 1 { return 0; }
    if las_has_tag(src, "animatetransform") == 1 { return 0; }
    if las_has_tag(src, "set") == 1 { return 0; }
    if las_has_tag(src, "filter") == 1 { return 0; }
    if las_contains_ci(src, "<fe") == 1 { return 0; }
    if las_has_tag(src, "audio") == 1 { return 0; }
    if las_has_tag(src, "video") == 1 { return 0; }
    if las_has_tag(src, "source") == 1 { return 0; }
    if las_has_tag(src, "track") == 1 { return 0; }
    if las_has_tag(src, "portal") == 1 { return 0; }
    if las_contains_ci(src, "<!entity") == 1 { return 0; }

    if las_has_attribute(src, "href") == 1 { return 0; }
    if las_has_attribute(src, "xlink:href") == 1 { return 0; }
    if las_has_attribute(src, "src") == 1 { return 0; }
    if las_has_attribute(src, "srcset") == 1 { return 0; }
    if las_has_attribute(src, "action") == 1 { return 0; }
    if las_has_attribute(src, "formaction") == 1 { return 0; }
    if las_has_attribute(src, "poster") == 1 { return 0; }
    # Inert metadata such as charset and viewport is normal in standalone HTML.
    # http-equiv remains blocked because it can refresh or alter browser policy.
    if las_has_attribute(src, "http-equiv") == 1 { return 0; }
    if las_contains_ci(src, "javascript:") == 1 { return 0; }
    if las_contains_ci(src, "vbscript:") == 1 { return 0; }
    if las_contains_ci(src, "data:") == 1 { return 0; }
    if las_network_tokens_safe(src) == 0 { return 0; }
    if las_contains_ci(src, "ftp:") == 1 { return 0; }
    if las_contains_ci(src, "file:") == 1 { return 0; }

    if las_contains_ci(src, "@import") == 1 { return 0; }
    if las_contains_ci(src, "expression(") == 1 { return 0; }
    if las_contains_ci(src, "behavior:") == 1 { return 0; }
    if las_contains_ci(src, "-moz-binding") == 1 { return 0; }
    if las_contains_ci(src, "image-set(") == 1 { return 0; }
    if las_contains_ci(src, "cross-fade(") == 1 { return 0; }
    return 1;
}
