# Aether Lens R6 Stage 2: native, offline Windows SAPI WAV transcription.
# No network, model server, subprocess, .NET, or third-party runtime is used.

import "../../../core_lib/win32_com.ancl";

extern "kernel32.dll" MultiByteToWideChar -> i32;
extern "kernel32.dll" WideCharToMultiByte -> i32;

@DATA
lvstt_clsid_stream: buf = 16;
lvstt_iid_stream: buf = 16;
lvstt_clsid_recognizer: buf = 16;
lvstt_iid_recognizer: buf = 16;
lvstt_stream_p: buf = 8;
lvstt_recognizer_p: buf = 8;
lvstt_context_p: buf = 8;
lvstt_grammar_p: buf = 8;
lvstt_token_p: buf = 8;
lvstt_text_p: buf = 8;
lvstt_event: buf = 32;
lvstt_fetched: buf = 8;
lvstt_display_attr: buf = 8;
lvstt_wpath: buf = 1800;
lvstt_runtime_fallback: str = "Windows SAPI in-process recognizer (local/offline)";

@CODE
func lvstt_guid_init() -> i64 {
    # CLSID_SpStream {715D9C59-4442-11D2-9605-00C04F8EE628}
    store32(lvstt_clsid_stream + 0, 0x715D9C59);
    store16(lvstt_clsid_stream + 4, 0x4442);
    store16(lvstt_clsid_stream + 6, 0x11D2);
    store8(lvstt_clsid_stream + 8, 0x96); store8(lvstt_clsid_stream + 9, 0x05);
    store8(lvstt_clsid_stream + 10, 0x00); store8(lvstt_clsid_stream + 11, 0xC0);
    store8(lvstt_clsid_stream + 12, 0x4F); store8(lvstt_clsid_stream + 13, 0x8E);
    store8(lvstt_clsid_stream + 14, 0xE6); store8(lvstt_clsid_stream + 15, 0x28);

    # IID_ISpStream {12E3CCA9-7518-44C5-A5E7-BA5A79CB929E}
    store32(lvstt_iid_stream + 0, 0x12E3CCA9);
    store16(lvstt_iid_stream + 4, 0x7518);
    store16(lvstt_iid_stream + 6, 0x44C5);
    store8(lvstt_iid_stream + 8, 0xA5); store8(lvstt_iid_stream + 9, 0xE7);
    store8(lvstt_iid_stream + 10, 0xBA); store8(lvstt_iid_stream + 11, 0x5A);
    store8(lvstt_iid_stream + 12, 0x79); store8(lvstt_iid_stream + 13, 0xCB);
    store8(lvstt_iid_stream + 14, 0x92); store8(lvstt_iid_stream + 15, 0x9E);

    # CLSID_SpInprocRecognizer {41B89B6B-9399-11D2-9623-00C04F8EE628}
    store32(lvstt_clsid_recognizer + 0, 0x41B89B6B);
    store16(lvstt_clsid_recognizer + 4, 0x9399);
    store16(lvstt_clsid_recognizer + 6, 0x11D2);
    store8(lvstt_clsid_recognizer + 8, 0x96); store8(lvstt_clsid_recognizer + 9, 0x23);
    store8(lvstt_clsid_recognizer + 10, 0x00); store8(lvstt_clsid_recognizer + 11, 0xC0);
    store8(lvstt_clsid_recognizer + 12, 0x4F); store8(lvstt_clsid_recognizer + 13, 0x8E);
    store8(lvstt_clsid_recognizer + 14, 0xE6); store8(lvstt_clsid_recognizer + 15, 0x28);

    # IID_ISpRecognizer {C2B5F241-DAA0-4507-9E16-5A1EAA2B7A5C}
    store32(lvstt_iid_recognizer + 0, 0xC2B5F241);
    store16(lvstt_iid_recognizer + 4, 0xDAA0);
    store16(lvstt_iid_recognizer + 6, 0x4507);
    store8(lvstt_iid_recognizer + 8, 0x9E); store8(lvstt_iid_recognizer + 9, 0x16);
    store8(lvstt_iid_recognizer + 10, 0x5A); store8(lvstt_iid_recognizer + 11, 0x1E);
    store8(lvstt_iid_recognizer + 12, 0xAA); store8(lvstt_iid_recognizer + 13, 0x2B);
    store8(lvstt_iid_recognizer + 14, 0x7A); store8(lvstt_iid_recognizer + 15, 0x5C);
    return 1;
}

func lvstt_path_to_wide(src: i64) -> i64 {
    memset(lvstt_wpath, 0, 1800);
    return MultiByteToWideChar(0, 0, src, 0 - 1, lvstt_wpath, 900);
}

func lvstt_wlen(src: i64) -> i64 {
    n = 0;
    while load16(src + n * 2) != 0 { n = n + 1; }
    return n;
}

func lvstt_wide_to_utf8(src: i64, dst: i64, cap: i64) -> i64 {
    if src == 0 { if cap > 0 { store8(dst, 0); } return 0; }
    n = lvstt_wlen(src);
    if n <= 0 { if cap > 0 { store8(dst, 0); } return 0; }
    out = WideCharToMultiByte(65001, 0, src, n, dst, cap - 1, 0, 0);
    if out <= 0 { store8(dst, 0); return 0; }
    store8(dst + out, 0);
    return out;
}

func lvstt_append_wide(dst: i64, cap: i64, src: i64) -> i64 {
    used = strlen(dst);
    if used > 0 {
        if used + 2 >= cap { return 0; }
        store8(dst + used, 32); used = used + 1; store8(dst + used, 0);
    }
    if used + 1 >= cap { return 0; }
    wrote = lvstt_wide_to_utf8(src, dst + used, cap - used);
    return wrote;
}

func lvstt_runtime_name(recognizer: i64, dst: i64, cap: i64) -> i64 {
    str_copy(dst, lvstt_runtime_fallback);
    store64(lvstt_token_p, 0);
    if callp(vmeth(recognizer, 8), recognizer, lvstt_token_p) < 0 { return 0; }
    token = load64(lvstt_token_p);
    if token == 0 { return 0; }
    store64(lvstt_text_p, 0);
    hr = callp(vmeth(token, 6), token, 0, lvstt_text_p);
    if hr >= 0 {
        wide = load64(lvstt_text_p);
        if wide != 0 { lvstt_wide_to_utf8(wide, dst, cap); CoTaskMemFree(wide); }
    }
    com_release(token);
    store64(lvstt_token_p, 0);
    return 1;
}

func lvstt_cleanup(stream: i64, recognizer: i64, context: i64, grammar: i64, co_ok: i64) -> i64 {
    if grammar != 0 {
        callp(vmeth(grammar, 22), grammar, 0);
        com_release(grammar);
    }
    if recognizer != 0 { callp(vmeth(recognizer, 17), recognizer, 3); }
    if context != 0 { com_release(context); }
    if recognizer != 0 { com_release(recognizer); }
    if stream != 0 { callp(vmeth(stream, 18), stream); com_release(stream); }
    if co_ok == 1 { CoUninitialize(); }
    return 0;
}

# Returns 1=text, 2=no speech, -1=no local recognizer, -2=file/input error,
# -3=recognition error, -4=cancelled/timeout.
func lvstt_transcribe_file(path: i64, dst: i64, cap: i64, runtime: i64, runtime_cap: i64, cancel_ptr: i64) -> i64 {
    if cap <= 1 { return 0 - 3; }
    store8(dst, 0);
    str_copy(runtime, lvstt_runtime_fallback);
    lvstt_guid_init();
    if lvstt_path_to_wide(path) <= 0 { return 0 - 2; }

    cohr = CoInitializeEx(0, 0);
    if cohr < 0 { return 0 - 3; }
    co_ok = 1;
    stream = 0; recognizer = 0; context = 0; grammar = 0;

    store64(lvstt_stream_p, 0);
    hr = CoCreateInstance(lvstt_clsid_stream, 0, 1, lvstt_iid_stream, lvstt_stream_p);
    if hr < 0 { lvstt_cleanup(stream, recognizer, context, grammar, co_ok); return 0 - 2; }
    stream = load64(lvstt_stream_p);
    hr = callp(vmeth(stream, 17), stream, lvstt_wpath, 0, 0, 0, 0);
    if hr < 0 { lvstt_cleanup(stream, recognizer, context, grammar, co_ok); return 0 - 2; }

    store64(lvstt_recognizer_p, 0);
    hr = CoCreateInstance(lvstt_clsid_recognizer, 0, 1, lvstt_iid_recognizer, lvstt_recognizer_p);
    if hr < 0 { lvstt_cleanup(stream, recognizer, context, grammar, co_ok); return 0 - 1; }
    recognizer = load64(lvstt_recognizer_p);
    lvstt_runtime_name(recognizer, runtime, runtime_cap);
    hr = callp(vmeth(recognizer, 9), recognizer, stream, 1);
    if hr < 0 { lvstt_cleanup(stream, recognizer, context, grammar, co_ok); return 0 - 2; }

    store64(lvstt_context_p, 0);
    hr = callp(vmeth(recognizer, 12), recognizer, lvstt_context_p);
    if hr < 0 { lvstt_cleanup(stream, recognizer, context, grammar, co_ok); return 0 - 3; }
    context = load64(lvstt_context_p);
    # End-stream + recognition, including SAPI's required flag-check bits.
    hr = callp(vmeth(context, 10), context, 0x4640000000, 0x4640000000);
    if hr < 0 { lvstt_cleanup(stream, recognizer, context, grammar, co_ok); return 0 - 3; }

    store64(lvstt_grammar_p, 0);
    hr = callp(vmeth(context, 14), context, 1, lvstt_grammar_p);
    if hr < 0 { lvstt_cleanup(stream, recognizer, context, grammar, co_ok); return 0 - 3; }
    grammar = load64(lvstt_grammar_p);
    hr = callp(vmeth(grammar, 20), grammar, 0, 0);
    if hr < 0 { lvstt_cleanup(stream, recognizer, context, grammar, co_ok); return 0 - 1; }
    hr = callp(vmeth(grammar, 22), grammar, 1);
    if hr < 0 { lvstt_cleanup(stream, recognizer, context, grammar, co_ok); return 0 - 3; }
    hr = callp(vmeth(recognizer, 17), recognizer, 2);
    if hr < 0 { lvstt_cleanup(stream, recognizer, context, grammar, co_ok); return 0 - 3; }

    start = GetTickCount(); done = 0; failed = 0; cancelled = 0;
    while done == 0 {
        if cancel_ptr != 0 { if load64(cancel_ptr) != 0 { cancelled = 1; break; } }
        callp(vmeth(context, 8), context, 200);
        while 1 {
            store64(lvstt_fetched, 0);
            memset(lvstt_event, 0, 32);
            hr = callp(vmeth(context, 11), context, 1, lvstt_event, lvstt_fetched);
            if hr < 0 { failed = 1; break; }
            if load32(lvstt_fetched) == 0 { break; }
            eid = load16(lvstt_event + 0);
            obj = load64(lvstt_event + 24);
            if eid == 38 {
                if obj != 0 {
                    store64(lvstt_text_p, 0);
                    hr2 = callp(vmeth(obj, 5), obj, 0, 4294967295, 1, lvstt_text_p, lvstt_display_attr);
                    if hr2 >= 0 {
                        wide = load64(lvstt_text_p);
                        if wide != 0 { lvstt_append_wide(dst, cap, wide); CoTaskMemFree(wide); }
                    }
                    com_release(obj);
                }
            }
            if eid == 34 { done = 1; }
        }
        if failed == 1 { break; }
        elapsed = band(GetTickCount() - start, 4294967295);
        if elapsed > 120000 { cancelled = 1; break; }
    }
    lvstt_cleanup(stream, recognizer, context, grammar, co_ok);
    if cancelled == 1 { return 0 - 4; }
    if failed == 1 { return 0 - 3; }
    if strlen(dst) == 0 { return 2; }
    return 1;
}
