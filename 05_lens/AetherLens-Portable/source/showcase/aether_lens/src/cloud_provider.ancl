# Pure safety policy for remote model providers.

@DATA
lcp_hf_router: str = "https://router.huggingface.co/v1";

@CODE
func lcp_hf_url_allowed(url: i64) -> i64 {
    if strcmp(url, lcp_hf_router) == 0 { return 1; }
    return 0;
}

func lcp_hf_text_only(has_image: i64, has_file: i64) -> i64 {
    if has_image != 0 { return 0; }
    # Lens turns its bounded .md/.txt/.ancl attachment into escaped prompt text,
    # so it remains within the text-only cloud contract.
    return 1;
}
