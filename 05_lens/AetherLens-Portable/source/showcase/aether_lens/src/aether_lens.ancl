func lens_cfg_val(buf: i64, from: i64, dst: i64) -> i64 {
    i = from;
    j = 0;
    while 1 {
        c = load8(buf + i);
        if c == 0 { store8(dst + j, 0); return i; }
        if c == 10 { store8(dst + j, 0); return i; }
        if c == 13 { store8(dst + j, 0); return i; }
        store8(dst + j, c);
        i = i + 1;
        j = j + 1;
    }
    return i;
}

func lens_cfg_at(buf: i64, i: i64, key: i64) -> i64 {
    j = 0;
    while 1 {
        c = load8(key + j);
        if c == 0 { return 1; }
        if load8(buf + i + j) != c { return 0; }
        j = j + 1;
    }
    return 0;
}

func lens_cfg_restore_str(buf: i64, key: i64, dst: i64) -> i64 {
    p = lj_find_after(buf, key);
    if p < 0 { return 0; }
    lens_cfg_val(buf, p, dst);
    return 1;
}

func lens_cfg_restore_int(buf: i64, key: i64, dst: i64) -> i64 {
    p = lj_find_after(buf, key);
    if p < 0 { return 0; }
    store64(dst, str_to_int(buf + p));
    return 1;
}

func lens_config_load() -> i64 {
    lens_defaults();
    n = lens_read_file(g_cfgpath, load64(g_filebuf_p), 65536);
    if n < 0 { return 0; }
    i = 0;
    while load8(load64(g_filebuf_p) + i) != 0 {
        if lens_cfg_at(load64(g_filebuf_p), i, cfg_backend) == 1 { store64(g_backend, str_to_int(load64(g_filebuf_p) + i + strlen(cfg_backend))); }
        if lens_cfg_at(load64(g_filebuf_p), i, cfg_ollama_url) == 1 { lens_cfg_val(load64(g_filebuf_p), i + strlen(cfg_ollama_url), g_ollama_url); }
        if lens_cfg_at(load64(g_filebuf_p), i, cfg_openai_url) == 1 { lens_cfg_val(load64(g_filebuf_p), i + strlen(cfg_openai_url), g_openai_url); }
        if lens_cfg_at(load64(g_filebuf_p), i, cfg_ollama_model) == 1 { lens_cfg_val(load64(g_filebuf_p), i + strlen(cfg_ollama_model), g_ollama_model); }
        if lens_cfg_at(load64(g_filebuf_p), i, cfg_openai_model) == 1 { lens_cfg_val(load64(g_filebuf_p), i + strlen(cfg_openai_model), g_openai_model); }
        if lens_cfg_at(load64(g_filebuf_p), i, cfg_cloud_provider) == 1 { store64(g_cloud_provider, str_to_int(load64(g_filebuf_p) + i + strlen(cfg_cloud_provider))); }
        if lens_cfg_at(load64(g_filebuf_p), i, cfg_anthropic_model) == 1 { lens_cfg_val(load64(g_filebuf_p), i + strlen(cfg_anthropic_model), g_anthropic_model); }
        if lens_cfg_at(load64(g_filebuf_p), i, cfg_aether_model) == 1 { lens_cfg_val(load64(g_filebuf_p), i + strlen(cfg_aether_model), g_aether_model); }
        if lens_cfg_at(load64(g_filebuf_p), i, cfg_aether_url) == 1 { lens_cfg_val(load64(g_filebuf_p), i + strlen(cfg_aether_url), g_aether_url); }
        if lens_cfg_at(load64(g_filebuf_p), i, cfg_aether_exe) == 1 { lens_cfg_val(load64(g_filebuf_p), i + strlen(cfg_aether_exe), g_aether_exe); }
        if lens_cfg_at(load64(g_filebuf_p), i, cfg_aether_hw) == 1 { store64(g_aether_hw, str_to_int(load64(g_filebuf_p) + i + strlen(cfg_aether_hw))); }
        if lens_cfg_at(load64(g_filebuf_p), i, cfg_aether_restrict) == 1 { store64(g_aether_restrict, str_to_int(load64(g_filebuf_p) + i + strlen(cfg_aether_restrict))); }
        if lens_cfg_at(load64(g_filebuf_p), i, cfg_aether_style) == 1 { store64(g_aether_style, str_to_int(load64(g_filebuf_p) + i + strlen(cfg_aether_style))); }
        if lens_cfg_at(load64(g_filebuf_p), i, cfg_aether_reasoning) == 1 { store64(g_aether_reasoning, str_to_int(load64(g_filebuf_p) + i + strlen(cfg_aether_reasoning))); }
        if lens_cfg_at(load64(g_filebuf_p), i, cfg_aether_max) == 1 { store64(g_aether_max, str_to_int(load64(g_filebuf_p) + i + strlen(cfg_aether_max))); }
        if lens_cfg_at(load64(g_filebuf_p), i, cfg_aether_spec) == 1 { store64(g_aether_spec, str_to_int(load64(g_filebuf_p) + i + strlen(cfg_aether_spec))); }
        if lens_cfg_at(load64(g_filebuf_p), i, cfg_aether_time) == 1 { store64(g_aether_time, str_to_int(load64(g_filebuf_p) + i + strlen(cfg_aether_time))); }
        if lens_cfg_at(load64(g_filebuf_p), i, cfg_preset) == 1 { store64(g_preset, str_to_int(load64(g_filebuf_p) + i + strlen(cfg_preset))); }
        if lens_cfg_at(load64(g_filebuf_p), i, cfg_chat) == 1 { lens_cfg_val(load64(g_filebuf_p), i + strlen(cfg_chat), g_chat_name); }
        if lens_cfg_at(load64(g_filebuf_p), i, cfg_vision_mode) == 1 { store64(g_vision_mode, str_to_int(load64(g_filebuf_p) + i + strlen(cfg_vision_mode))); }
        if lens_cfg_at(load64(g_filebuf_p), i, cfg_info_visible) == 1 { store64(g_info_visible, str_to_int(load64(g_filebuf_p) + i + strlen(cfg_info_visible))); }
        if lens_cfg_at(load64(g_filebuf_p), i, cfg_reasoning_visible) == 1 { store64(g_reasoning_visible, str_to_int(load64(g_filebuf_p) + i + strlen(cfg_reasoning_visible))); }
        if lens_cfg_at(load64(g_filebuf_p), i, cfg_knowledge_enabled) == 1 { store64(g_knowledge_enabled, str_to_int(load64(g_filebuf_p) + i + strlen(cfg_knowledge_enabled))); }
        if lens_cfg_at(load64(g_filebuf_p), i, cfg_arena_backend) == 1 { store64(g_arena_backend, str_to_int(load64(g_filebuf_p) + i + strlen(cfg_arena_backend))); }
        if lens_cfg_at(load64(g_filebuf_p), i, cfg_arena_model_a) == 1 { lens_cfg_val(load64(g_filebuf_p), i + strlen(cfg_arena_model_a), g_arena_model_a); }
        if lens_cfg_at(load64(g_filebuf_p), i, cfg_arena_model_b) == 1 { lens_cfg_val(load64(g_filebuf_p), i + strlen(cfg_arena_model_b), g_arena_model_b); }
        if lens_cfg_at(load64(g_filebuf_p), i, cfg_arena_blind) == 1 { store64(g_arena_blind, str_to_int(load64(g_filebuf_p) + i + strlen(cfg_arena_blind))); }
        while 1 {
            c = load8(load64(g_filebuf_p) + i);
            if c == 0 { break; }
            i = i + 1;
            if c == 10 { break; }
        }
    }
    # Explicit post-pass: these are the user-session keys whose restoration
    # must never depend on line-order or prefix-walk behavior. This also makes
    # older configs naturally migrate when newer keys are absent.
    lens_cfg_restore_int(load64(g_filebuf_p), cfg_backend, g_backend);
    lens_cfg_restore_str(load64(g_filebuf_p), cfg_ollama_url, g_ollama_url);
    lens_cfg_restore_str(load64(g_filebuf_p), cfg_openai_url, g_openai_url);
    lens_cfg_restore_str(load64(g_filebuf_p), cfg_ollama_model, g_ollama_model);
    lens_cfg_restore_str(load64(g_filebuf_p), cfg_openai_model, g_openai_model);
    lens_cfg_restore_int(load64(g_filebuf_p), cfg_cloud_provider, g_cloud_provider);
    lens_cfg_restore_str(load64(g_filebuf_p), cfg_anthropic_model, g_anthropic_model);
    lens_cfg_restore_str(load64(g_filebuf_p), cfg_aether_model, g_aether_model);
    lens_cfg_restore_str(load64(g_filebuf_p), cfg_aether_url, g_aether_url);
    lens_cfg_restore_str(load64(g_filebuf_p), cfg_aether_exe, g_aether_exe);
    lens_cfg_restore_int(load64(g_filebuf_p), cfg_aether_hw, g_aether_hw);
    lens_cfg_restore_int(load64(g_filebuf_p), cfg_aether_restrict, g_aether_restrict);
    lens_cfg_restore_int(load64(g_filebuf_p), cfg_aether_style, g_aether_style);
    lens_cfg_restore_int(load64(g_filebuf_p), cfg_aether_reasoning, g_aether_reasoning);
    lens_cfg_restore_int(load64(g_filebuf_p), cfg_aether_max, g_aether_max);
    lens_cfg_restore_int(load64(g_filebuf_p), cfg_aether_spec, g_aether_spec);
    lens_cfg_restore_int(load64(g_filebuf_p), cfg_aether_time, g_aether_time);
    lens_cfg_restore_int(load64(g_filebuf_p), cfg_preset, g_preset);
    lens_cfg_restore_str(load64(g_filebuf_p), cfg_chat, g_chat_name);
    lens_cfg_restore_int(load64(g_filebuf_p), cfg_vision_mode, g_vision_mode);
    lens_cfg_restore_int(load64(g_filebuf_p), cfg_info_visible, g_info_visible);
    lens_cfg_restore_int(load64(g_filebuf_p), cfg_reasoning_visible, g_reasoning_visible);
    lens_cfg_restore_int(load64(g_filebuf_p), cfg_knowledge_enabled, g_knowledge_enabled);
    lens_cfg_restore_int(load64(g_filebuf_p), cfg_arena_backend, g_arena_backend);
    lens_cfg_restore_str(load64(g_filebuf_p), cfg_arena_model_a, g_arena_model_a);
    lens_cfg_restore_str(load64(g_filebuf_p), cfg_arena_model_b, g_arena_model_b);
    lens_cfg_restore_int(load64(g_filebuf_p), cfg_arena_blind, g_arena_blind);
    store64(g_backend_display, load64(g_backend));
    if load64(g_preset) < 0 { store64(g_preset, 0); }
    if load64(g_preset) > 3 { store64(g_preset, 0); }
    if load64(g_vision_mode) < 0 { store64(g_vision_mode, 0); }
    if load64(g_vision_mode) > 3 { store64(g_vision_mode, 0); }
    if load64(g_backend) < 0 { store64(g_backend, 0); }
    if load64(g_backend) > 3 { store64(g_backend, 0); }
    if load64(g_cloud_provider) != 1 { store64(g_cloud_provider, 0); }
    if load64(g_aether_hw) < 0 { store64(g_aether_hw, 0); }
    if load64(g_aether_hw) > 2 { store64(g_aether_hw, 0); }
    if load64(g_aether_restrict) < 0 { store64(g_aether_restrict, 0); }
    if load64(g_aether_restrict) > 2 { store64(g_aether_restrict, 0); }
    if load64(g_aether_style) < 0 { store64(g_aether_style, 0); }
    if load64(g_aether_style) > 2 { store64(g_aether_style, 0); }
    if load64(g_aether_reasoning) != 0 { store64(g_aether_reasoning, 1); }
    if load64(g_aether_max) != 64 { if load64(g_aether_max) != 128 { if load64(g_aether_max) != 256 { if load64(g_aether_max) != 512 { store64(g_aether_max, 128); } } } }
    if load64(g_aether_spec) != 0 { store64(g_aether_spec, 1); }
    if load64(g_aether_time) != 0 { store64(g_aether_time, 1); }
    if load64(g_info_visible) != 0 { store64(g_info_visible, 1); }
    if load64(g_reasoning_visible) != 0 { store64(g_reasoning_visible, 1); }
    if load64(g_knowledge_enabled) != 0 { store64(g_knowledge_enabled, 1); }
    if load64(g_arena_backend) != 0 { if load64(g_arena_backend) != 3 { store64(g_arena_backend, 3); } }
    if load64(g_arena_blind) != 0 { store64(g_arena_blind, 1); }
    lens_aether_sanitize_url();
    # Dedicated last-use key is applied last so neither legacy migration nor
    # first-run defaults can replace an explicit Engine choice.
    if lens_cfg_restore_str(load64(g_filebuf_p), cfg_last_aether_model, g_tmp) == 1 {
        if load8(g_tmp) != 0 { str_copy(g_aether_model, g_tmp); }
    }
    str_copy(g_saved_aether_model, g_aether_model);
    store64(g_backend_display, load64(g_backend));
    return 0;
}

func lens_config_save() -> i64 {
    p = str_copy(load64(g_filebuf_p), cfg_backend);
    int_to_str(g_tmp, load64(g_backend));
    p = str_copy(p, g_tmp);
    p = str_copy(p, lf);
    p = str_copy(p, cfg_ollama_url); p = str_copy(p, g_ollama_url); p = str_copy(p, lf);
    p = str_copy(p, cfg_openai_url); p = str_copy(p, g_openai_url); p = str_copy(p, lf);
    p = str_copy(p, cfg_ollama_model); p = str_copy(p, g_ollama_model); p = str_copy(p, lf);
    p = str_copy(p, cfg_openai_model); p = str_copy(p, g_openai_model); p = str_copy(p, lf);
    p = str_copy(p, cfg_cloud_provider); int_to_str(g_tmp, load64(g_cloud_provider)); p = str_copy(p, g_tmp); p = str_copy(p, lf);
    p = str_copy(p, cfg_anthropic_model); p = str_copy(p, g_anthropic_model); p = str_copy(p, lf);
    p = str_copy(p, cfg_aether_model); p = str_copy(p, g_aether_model); p = str_copy(p, lf);
    p = str_copy(p, cfg_aether_url); p = str_copy(p, g_aether_url); p = str_copy(p, lf);
    p = str_copy(p, cfg_aether_exe);
    lens_join(g_tmp2, g_rootdir, default_aether_exe);
    # Keep the side-by-side Engine implicit in portable configs. An explicit
    # custom/remote Engine path is still persisted normally.
    if strcmp(g_aether_exe, g_tmp2) != 0 { p = str_copy(p, g_aether_exe); }
    p = str_copy(p, lf);
    p = str_copy(p, cfg_aether_hw); int_to_str(g_tmp, load64(g_aether_hw)); p = str_copy(p, g_tmp); p = str_copy(p, lf);
    p = str_copy(p, cfg_aether_restrict); int_to_str(g_tmp, load64(g_aether_restrict)); p = str_copy(p, g_tmp); p = str_copy(p, lf);
    p = str_copy(p, cfg_aether_style); int_to_str(g_tmp, load64(g_aether_style)); p = str_copy(p, g_tmp); p = str_copy(p, lf);
    p = str_copy(p, cfg_aether_reasoning); int_to_str(g_tmp, load64(g_aether_reasoning)); p = str_copy(p, g_tmp); p = str_copy(p, lf);
    p = str_copy(p, cfg_aether_max); int_to_str(g_tmp, load64(g_aether_max)); p = str_copy(p, g_tmp); p = str_copy(p, lf);
    p = str_copy(p, cfg_aether_spec); int_to_str(g_tmp, load64(g_aether_spec)); p = str_copy(p, g_tmp); p = str_copy(p, lf);
    p = str_copy(p, cfg_aether_time); int_to_str(g_tmp, load64(g_aether_time)); p = str_copy(p, g_tmp); p = str_copy(p, lf);
    p = str_copy(p, cfg_preset); int_to_str(g_tmp, load64(g_preset)); p = str_copy(p, g_tmp); p = str_copy(p, lf);
    p = str_copy(p, cfg_chat); p = str_copy(p, g_chat_name); p = str_copy(p, lf);
    p = str_copy(p, cfg_vision_mode); int_to_str(g_tmp, load64(g_vision_mode)); p = str_copy(p, g_tmp); p = str_copy(p, lf);
    p = str_copy(p, cfg_info_visible); int_to_str(g_tmp, load64(g_info_visible)); p = str_copy(p, g_tmp); p = str_copy(p, lf);
    p = str_copy(p, cfg_last_aether_model); p = str_copy(p, g_aether_model); p = str_copy(p, lf);
    p = str_copy(p, cfg_reasoning_visible); int_to_str(g_tmp, load64(g_reasoning_visible)); p = str_copy(p, g_tmp); p = str_copy(p, lf);
    p = str_copy(p, cfg_knowledge_enabled); int_to_str(g_tmp, load64(g_knowledge_enabled)); p = str_copy(p, g_tmp); p = str_copy(p, lf);
    p = str_copy(p, cfg_arena_backend); int_to_str(g_tmp, load64(g_arena_backend)); p = str_copy(p, g_tmp); p = str_copy(p, lf);
    p = str_copy(p, cfg_arena_model_a); p = str_copy(p, g_arena_model_a); p = str_copy(p, lf);
    p = str_copy(p, cfg_arena_model_b); p = str_copy(p, g_arena_model_b); p = str_copy(p, lf);
    p = str_copy(p, cfg_arena_blind); int_to_str(g_tmp, load64(g_arena_blind)); p = str_copy(p, g_tmp); p = str_copy(p, lf);
    store8(p, 0);
    lens_write_file(g_cfgpath, load64(g_filebuf_p), strlen(load64(g_filebuf_p)));
    return 0;
}

func lens_backend_model_ptr(b: i64) -> i64 {
    if b == 1 { return g_openai_model; }
    if b == 2 { return g_anthropic_model; }
    if b == 3 { return g_aether_model; }
    return g_ollama_model;
}

func lens_backend_url_ptr(b: i64) -> i64 {
    if b == 1 { return g_openai_url; }
    if b == 3 { return g_aether_url; }
    return g_ollama_url;
}

func lens_harvest_display() -> i64 {
    b = load64(g_backend_display);
    gui_get_text(load64(g_model_ed), lens_backend_model_ptr(b), 256);
    if b == 1 { gui_get_text(load64(g_url_ed), lens_backend_url_ptr(b), 256); }
    else if b == 3 {
        gui_get_text(load64(g_url_ed), g_aether_url, 256);
        lens_aether_sanitize_url();
    }
    else { gui_get_text(load64(g_url_ed), g_ollama_url, 256); }
    return 0;
}

func lens_sync_backend_controls() -> i64 {
    b = load64(g_backend_display);
    if b == 3 { lens_aether_sanitize_url(); }
    SetWindowTextA(load64(g_model_ed), lens_backend_model_ptr(b));
    SetWindowTextA(load64(g_url_ed), lens_backend_url_ptr(b));
    # The Hugging Face router is a fixed, security-reviewed endpoint: show it
    # immediately and keep this profile from being silently redirected.
    if b == 1 && load64(g_cloud_provider) == 1 { EnableWindow(load64(g_url_ed), 0); }
    else { EnableWindow(load64(g_url_ed), 1); }
    if load64(g_btn_catalog) != 0 { InvalidateRect(load64(g_btn_catalog), 0, 1); }
    if load64(g_btn_delete) != 0 { InvalidateRect(load64(g_btn_delete), 0, 1); }
    if b == 0 { lens_update_model_details(g_ollama_model); }
    else { lens_update_cloud_info(); }
    lens_refresh_attachment_ui();
    return 0;
}

func lens_harvest_all() -> i64 {
    lens_harvest_display();
    store64(g_backend, load64(g_backend_display));
    gui_get_text(load64(g_chatname_ed), g_chat_name, 160);
    return 0;
}

func lens_apply_ollama_url() -> i64 {
    lt_url_split(g_ollama_url, g_host, g_port, g_sec, g_path);
    lt_set_target(g_host, load64(g_port), load64(g_sec));
    return 0;
}

func lens_apply_aether_url() -> i64 {
    lt_url_split(g_aether_url, g_host, g_port, g_sec, g_path);
    lt_set_target(g_host, load64(g_port), load64(g_sec));
    return 0;
}

func lens_aether_is_local() -> i64 {
    lens_apply_aether_url();
    if strcmp(g_host, "127.0.0.1") == 0 { return 1; }
    if strcmp(g_host, "localhost") == 0 { return 1; }
    return 0;
}

func lens_aether_owned_alive() -> i64 {
    h = load64(g_aether_proc);
    if h == 0 { return 0; }
    store32(g_aether_exit, 0);
    if GetExitCodeProcess(h, g_aether_exit) == 0 {
        CloseHandle(h);
        store64(g_aether_proc, 0);
        return 0;
    }
    if load32(g_aether_exit) == 259 { return 1; }
    CloseHandle(h);
    store64(g_aether_proc, 0);
    return 0;
}

func lens_aether_stop_owned() -> i64 {
    h = load64(g_aether_proc);
    if h == 0 { return 0; }
    if lens_aether_owned_alive() == 1 {
        TerminateProcess(h, 0);
        WaitForSingleObject(h, 3000);
    }
    if load64(g_aether_proc) != 0 { CloseHandle(load64(g_aether_proc)); }
    store64(g_aether_proc, 0);
    store64(g_aether_pid, 0);
    return 1;
}

func lens_aether_build_serve_cmd() -> i64 {
    lens_apply_aether_url();
    p = str_copy(g_aether_cmd, q);
    p = str_copy(p, g_aether_exe);
    p = str_copy(p, q);
    p = str_copy(p, " serve ");
    p = str_copy(p, q);
    p = str_copy(p, g_aether_model);
    p = str_copy(p, q);
    p = str_copy(p, space);
    int_to_str(g_tmp, load64(g_port));
    p = str_copy(p, g_tmp);
    if load64(g_aether_hw) == 0 { p = str_copy(p, eng_flag_gpu); }
    if load64(g_aether_hw) == 1 { p = str_copy(p, eng_flag_final); }
    if load64(g_aether_restrict) == 1 { p = str_copy(p, eng_flag_ascii); }
    if load64(g_aether_restrict) == 2 { p = str_copy(p, eng_flag_digits); }
    if load64(g_aether_spec) == 1 { if load64(g_aether_hw) != 0 { p = str_copy(p, eng_flag_spec); } }
    if load64(g_aether_spec) == 0 { p = str_copy(p, eng_flag_nospec); }
    if load64(g_aether_time) == 1 { p = str_copy(p, eng_flag_time); }
    store8(p, 0);
    return 0;
}

func lens_aether_launch_owned() -> i64 {
    if lens_aether_owned_alive() == 1 { return 1; }
    if lens_aether_is_local() == 0 { return 0; }
    if GetFileAttributesA(g_aether_exe) == 0xFFFFFFFF { return 0; }
    lens_aether_build_serve_cmd();
    memset(g_aether_si, 0, 104);
    store32(g_aether_si, 104);
    memset(g_aether_pi, 0, 24);
    ok = CreateProcessA(0, g_aether_cmd, 0, 0, 0, 0x08000000, 0, 0, g_aether_si, g_aether_pi);
    if ok == 0 { return 0; }
    store64(g_aether_proc, load64(g_aether_pi));
    store64(g_aether_pid, load32(g_aether_pi + 16));
    CloseHandle(load64(g_aether_pi + 8));
    return 1;
}

func lens_aether_ensure_server(resp: i64, cap: i64) -> i64 {
    lens_apply_aether_url();
    st = lt_ollama_tags(resp, cap);
    if st == 200 { return st; }
    if lens_aether_is_local() == 0 { return st; }
    lens_set_status(st_engine_start);
    if lens_aether_launch_owned() == 0 { return 0; }
    tries = 0;
    while tries < 100 {
        Sleep(100);
        lens_apply_aether_url();
        st = lt_ollama_tags(resp, cap);
        if st == 200 { return st; }
        if lens_aether_owned_alive() == 0 { return 0; }
        tries = tries + 1;
    }
    return 0;
}

func lens_aether_capture(cmd: i64, out: i64, cap: i64) -> i64 {
    if cap <= 1 { return 0 - 1; }
    store8(out, 0);
    memset(g_aether_cli_sa, 0, 24);
    store32(g_aether_cli_sa, 24);
    store32(g_aether_cli_sa + 16, 1);
    if CreatePipe(g_aether_cli_hrd, g_aether_cli_hwr, g_aether_cli_sa, 0) == 0 { return 0 - 1; }
    SetHandleInformation(load64(g_aether_cli_hrd), 1, 0);
    memset(g_aether_cli_si, 0, 104);
    store32(g_aether_cli_si, 104);
    store32(g_aether_cli_si + 60, 0x100);
    store64(g_aether_cli_si + 88, load64(g_aether_cli_hwr));
    store64(g_aether_cli_si + 96, load64(g_aether_cli_hwr));
    memset(g_aether_cli_pi, 0, 24);
    ok = CreateProcessA(0, cmd, 0, 0, 1, 0x08000000, 0, 0, g_aether_cli_si, g_aether_cli_pi);
    if ok == 0 {
        CloseHandle(load64(g_aether_cli_hrd));
        CloseHandle(load64(g_aether_cli_hwr));
        return 0 - 1;
    }
    CloseHandle(load64(g_aether_cli_hwr));
    total = 0;
    while total < cap - 1 {
        chunk = cap - total - 1;
        if chunk > 65536 { chunk = 65536; }
        if ReadFile(load64(g_aether_cli_hrd), out + total, chunk, g_aether_cli_nread, 0) == 0 { break; }
        n = load32(g_aether_cli_nread);
        if n == 0 { break; }
        total = total + n;
        store8(out + total, 0);
        if load64(g_busy_kind) == 3 { PostMessageA(load64(g_hwnd), 0x8005, total, 0); }
    }
    store8(out + total, 0);
    CloseHandle(load64(g_aether_cli_hrd));
    WaitForSingleObject(load64(g_aether_cli_pi), 0 - 1);
    store32(g_aether_cli_exit, 1);
    GetExitCodeProcess(load64(g_aether_cli_pi), g_aether_cli_exit);
    CloseHandle(load64(g_aether_cli_pi));
    CloseHandle(load64(g_aether_cli_pi + 8));
    return total;
}

func lens_aether_build_models_cmd() -> i64 {
    p = str_copy(g_aether_cmd, q);
    p = str_copy(p, g_aether_exe);
    p = str_copy(p, q);
    str_copy(p, " models list");
    return 0;
}

func lens_aether_build_pull_cmd() -> i64 {
    p = str_copy(g_aether_cmd, q);
    p = str_copy(p, g_aether_exe);
    p = str_copy(p, q);
    p = str_copy(p, " models pull ");
    p = str_copy(p, q);
    p = str_copy(p, g_aether_model);
    str_copy(p, q);
    return 0;
}

func lens_aether_resolve_inspect_path(model: i64, dst: i64) -> i64 {
    store8(g_aether_store_name, 0);
    str_copy(g_aether_store_tag, inspect_latest);
    i = 0;
    ni = 0;
    while ni < 159 {
        c = load8(model + i);
        if c == 0 { break; }
        if c == 58 { i = i + 1; break; }
        store8(g_aether_store_name + ni, c);
        ni = ni + 1;
        i = i + 1;
    }
    store8(g_aether_store_name + ni, 0);
    if load8(model + i) != 0 {
        ti = 0;
        while ti < 159 {
            c = load8(model + i);
            if c == 0 { break; }
            store8(g_aether_store_tag + ti, c);
            ti = ti + 1;
            i = i + 1;
        }
        store8(g_aether_store_tag + ti, 0);
    }
    if load8(g_aether_store_name) == 0 { return 0; }
    lens_parent(g_aether_store_dir, g_aether_exe);
    p = str_copy(g_aether_manifest_path, g_aether_store_dir);
    p = str_copy(p, inspect_man_root);
    p = str_copy(p, g_aether_store_name);
    store8(p, 92); p = p + 1;
    p = str_copy(p, g_aether_store_tag);
    str_copy(p, inspect_man_ext);
    if lens_read_file(g_aether_manifest_path, load64(g_req_p), 1048576) < 1 { return 0; }
    off = lj_find_after(load64(g_req_p), inspect_model_digest);
    if off < 0 { return 0; }
    di = 0;
    while di < 64 {
        c = load8(load64(g_req_p) + off + di);
        if c == 0 { return 0; }
        if c == 34 { return 0; }
        store8(g_aether_store_digest + di, c);
        di = di + 1;
    }
    store8(g_aether_store_digest + 64, 0);
    p = str_copy(dst, g_aether_store_dir);
    p = str_copy(p, inspect_blob_root);
    str_copy(p, g_aether_store_digest);
    if GetFileAttributesA(dst) == 0 - 1 { return 0; }
    return 1;
}

func lens_aether_build_inspect_cmd() -> i64 {
    inspect_arg = g_show_model;
    if lens_aether_resolve_inspect_path(g_show_model, g_aether_inspect_path) == 1 { inspect_arg = g_aether_inspect_path; }
    p = str_copy(g_aether_cmd, q);
    p = str_copy(p, g_aether_exe);
    p = str_copy(p, q);
    p = str_copy(p, " inspect ");
    p = str_copy(p, q);
    p = str_copy(p, inspect_arg);
    str_copy(p, q);
    return 0;
}

func lens_aether_models_json(src: i64, dst: i64, cap: i64) -> i64 {
    p = str_copy(dst, "{\"models\":[");
    rows = 0;
    i = 0;
    while load8(src + i) != 0 {
        start = i;
        while load8(src + i) != 0 {
            c = load8(src + i);
            if c == 10 { break; }
            if c == 13 { break; }
            i = i + 1;
        }
        end = i;
        if end > start + 4 {
            if load8(src + start) == 32 {
                if load8(src + start + 1) == 32 {
                    ns = start + 2;
                    ne = ns;
                    while ne < end {
                        c = load8(src + ne);
                        if c <= 32 { break; }
                        ne = ne + 1;
                    }
                    if ne > ns {
                        sz = 0;
                        k = ne;
                        while k < end {
                            if load8(src + k) == 40 { k = k + 1; break; }
                            k = k + 1;
                        }
                        while k < end {
                            c = load8(src + k);
                            if c < 48 { break; }
                            if c > 57 { break; }
                            sz = sz * 10 + c - 48;
                            k = k + 1;
                        }
                        if rows > 0 { p = str_copy(p, comma); }
                        p = str_copy(p, "{\"name\":\"");
                        j = ns;
                        while j < ne { store8(p, load8(src + j)); p = p + 1; j = j + 1; }
                        p = str_copy(p, "\",\"model\":\"");
                        j = ns;
                        while j < ne { store8(p, load8(src + j)); p = p + 1; j = j + 1; }
                        p = str_copy(p, "\",\"size\":");
                        p = nf_u64dec(sz, p);
                        p = str_copy(p, "}");
                        rows = rows + 1;
                    }
                }
            }
        }
        while load8(src + i) == 13 { i = i + 1; }
        while load8(src + i) == 10 { i = i + 1; }
    }
    str_copy(p, "]}");
    return rows;
}

func lens_aether_load_store_models() -> i64 {
    lens_aether_build_models_cmd();
    n = lens_aether_capture(g_aether_cmd, load64(g_resp_p), 4194304);
    if n < 0 { return 0; }
    if load32(g_aether_cli_exit) != 0 { return 0; }
    return lens_aether_models_json(load64(g_resp_p), load64(g_tags_p), 1048576);
}

func lens_size_text(bytes: i64, dst: i64) -> i64 {
    if bytes <= 0 { str_copy(dst, "?"); return 0; }
    mb = bytes / 1048576;
    if mb < 1024 {
        p = nf_u64dec(mb, dst);
        str_copy(p, " MB");
        return 0;
    }
    gb10 = bytes / 107374182;
    p = nf_u64dec(gb10 / 10, dst);
    store8(p, 46);
    p = p + 1;
    store8(p, 48 + gb10 % 10);
    p = p + 1;
    str_copy(p, " GB");
    return 0;
}

func lens_extract_model_field(start: i64, ndl: i64, dst: i64, cap: i64) -> i64 {
    p = lj_find_after_from(load64(g_tags_p), start, ndl);
    if p < 0 { store8(dst, 0); return 0; }
    next = lj_find_after_from(load64(g_tags_p), start + 1, nd_name);
    if next > 0 { if p > next { store8(dst, 0); return 0; } }
    lj_json_unesc(load64(g_tags_p), p, dst, cap);
    return 1;
}

func lens_model_has_vision(model: i64) -> i64 {
    pos = 0;
    while 1 {
        p = lj_find_after_from(load64(g_tags_p), pos, nd_name);
        if p < 0 { return 0; }
        lj_json_unesc(load64(g_tags_p), p, g_tmp2, 256);
        next = lj_find_after_from(load64(g_tags_p), p, nd_name);
        if strcmp(g_tmp2, model) == 0 {
            c = lj_find_after_from(load64(g_tags_p), p, nd_caps);
            if c < 0 { return 0; }
            if next > 0 { if c > next { return 0; } }
            v = lj_find_after_from(load64(g_tags_p), c, nd_vision);
            if v < 0 { return 0; }
            if next > 0 { if v > next { return 0; } }
            return 1;
        }
        pos = p + 1;
    }
    return 0;
}

func lens_find_first_vision_model(dst: i64) -> i64 {
    if load64(g_tags_p) == 0 { store8(dst, 0); return 0; }
    mode = load64(g_vision_mode);
    if mode == 3 { store8(dst, 0); return 0; }
    store8(dst, 0);
    found = 0;
    pos = 0;
    while 1 {
        p = lj_find_after_from(load64(g_tags_p), pos, nd_name);
        if p < 0 {
            if mode != 1 {
                if found == 1 { return 1; }
            }
            store8(dst, 0);
            return 0;
        }
        next = lj_find_after_from(load64(g_tags_p), p + 1, nd_name);
        c = lj_find_after_from(load64(g_tags_p), p, nd_caps);
        if c >= 0 {
            if next < 0 { next = strlen(load64(g_tags_p)); }
            if c < next {
                v = lj_find_after_from(load64(g_tags_p), c, nd_vision);
                if v >= 0 {
                    if v < next {
                        lj_json_unesc(load64(g_tags_p), p, g_tmp2, 256);
                        if mode == 2 {
                            str_copy(dst, g_tmp2);
                            return 1;
                        }
                        if lens_starts_with_ci(g_tmp2, cat_moondream) == 1 {
                            str_copy(dst, g_tmp2);
                            return 1;
                        }
                        if found == 0 {
                            str_copy(dst, g_tmp2);
                            found = 1;
                        }
                    }
                }
            }
        }
        pos = p + 1;
    }
}

func lens_find_aether_vision_model(dst: i64) -> i64 {
    store8(dst, 0);
    if load64(g_vision_mode) == 3 { return 0; }
    if load64(g_vision_mode) == 1 { return 0; }
    if lens_find_model_pos(ae_tag_gemma4e) < 0 { return 0; }
    str_copy(dst, ae_tag_gemma4e);
    return 1;
}

func lens_current_model_has_vision() -> i64 {
    if load64(g_backend_display) == 3 {
        gui_get_text(load64(g_model_ed), g_tmp, 256);
        return lvp_aether_model_has_vision(g_tmp);
    }
    if load64(g_backend_display) != 0 { return 1; }
    gui_get_text(load64(g_model_ed), g_tmp, 256);
    return lens_model_has_vision(g_tmp);
}

func lens_refresh_attachment_ui() -> i64 {
    if load64(g_attach_lbl) == 0 { return 0; }
    if load64(g_has_image) == 0 {
        if load64(g_has_file) == 0 {
            str_copy(g_attach_text, att_none);
            SetWindowTextA(load64(g_attach_lbl), att_none);
            InvalidateRect(load64(g_attach_lbl), 0, 1);
            return 0;
        }
        p0 = str_copy(g_attach_text, att_file_ready);
        if load64(g_file_kind) == 2 { p0 = str_copy(g_attach_text, att_folder_ready); }
        p0 = str_copy(p0, g_file_name);
        p0 = str_copy(p0, att_mid);
        kb0 = load64(g_file_bytes) / 1024;
        if kb0 == 0 { if load64(g_file_bytes) > 0 { kb0 = 1; } }
        int_to_str(g_size_tmp, kb0);
        p0 = str_copy(p0, g_size_tmp);
        p0 = str_copy(p0, att_kb);
        store8(p0, 0);
        SetWindowTextA(load64(g_attach_lbl), g_attach_text);
        InvalidateRect(load64(g_attach_lbl), 0, 1);
        return 0;
    }
    p = str_copy(g_attach_text, att_ready);
    if lens_ends_with_ci(g_img_mime, mime_png) == 1 { p = str_copy(p, "png"); }
    else if lens_ends_with_ci(g_img_mime, mime_jpeg) == 1 { p = str_copy(p, "jpeg"); }
    else if lens_ends_with_ci(g_img_mime, mime_gif) == 1 { p = str_copy(p, "gif"); }
    else if lens_ends_with_ci(g_img_mime, mime_webp) == 1 { p = str_copy(p, "webp"); }
    else { p = str_copy(p, "?"); }
    p = str_copy(p, att_mid);
    kb = load64(g_img_bytes) / 1024;
    if kb == 0 { if load64(g_img_bytes) > 0 { kb = 1; } }
    int_to_str(g_size_tmp, kb);
    p = str_copy(p, g_size_tmp);
    p = str_copy(p, att_kb);
    if load64(g_has_file) == 1 {
        p = str_copy(p, att_plus_file);
        p = str_copy(p, g_file_name);
    }
    if lens_current_model_has_vision() == 0 {
        if load64(g_backend_display) == 3 {
            if lvp_aether_mime_supported(g_img_mime) == 1 {
                if lens_find_aether_vision_model(g_tmp) == 1 {
                    p = str_copy(p, att_helper);
                    p = str_copy(p, g_tmp);
                } else { p = str_copy(p, att_warn_aether); }
            } else { p = str_copy(p, att_warn_aether); }
        } else if lens_find_first_vision_model(g_tmp) == 1 {
            p = str_copy(p, att_helper);
            p = str_copy(p, g_tmp);
        }
        else { p = str_copy(p, att_warn); }
    } else {
        if load64(g_backend_display) == 3 {
            if lvp_aether_mime_supported(g_img_mime) == 1 { p = str_copy(p, att_native_vision); }
            else { p = str_copy(p, att_warn_aether); }
        }
    }
    store8(p, 0);
    SetWindowTextA(load64(g_attach_lbl), g_attach_text);
    InvalidateRect(load64(g_attach_lbl), 0, 1);
    return 0;
}

func lens_asset_make(rel: i64, prefix: i64, ext: i64) -> i64 {
    p = str_copy(g_asset_dir, g_chatdir);
    str_copy(p, asset_dir_suffix);
    CreateDirectoryA(g_asset_dir, 0);
    p = str_copy(rel, asset_rel_root);
    p = str_copy(p, prefix);
    int_to_str(g_size_tmp, GetTickCount());
    p = str_copy(p, g_size_tmp);
    str_copy(p, ext);
    p = str_copy(g_asset_path, g_chatdir);
    store8(p, 92);
    p = p + 1;
    str_copy(p, rel);
    return 1;
}

func lens_image_asset_ext() -> i64 {
    if lens_ends_with_ci(g_img_mime, mime_jpeg) == 1 { return ext_jpg; }
    if lens_ends_with_ci(g_img_mime, mime_gif) == 1 { return ext_gif; }
    if lens_ends_with_ci(g_img_mime, mime_webp) == 1 { return ext_webp; }
    return ".png";
}

func lens_document_asset_ext() -> i64 {
    if load64(g_file_kind) == 2 { return ext_txt; }
    if lens_ends_with_ci(g_file_name, md_ext) == 1 { return md_ext; }
    if lens_ends_with_ci(g_file_name, ext_ancl) == 1 { return ext_ancl; }
    return ext_txt;
}

func lens_archive_pending_image() -> i64 {
    store8(g_asset_img_rel, 0);
    if load64(g_has_image) == 0 { return 0; }
    if load8(g_imgpath) == 0 { return 0; }
    lens_asset_make(g_asset_img_rel, asset_img_prefix, lens_image_asset_ext());
    if CopyFileA(g_imgpath, g_asset_path, 0) == 0 { store8(g_asset_img_rel, 0); return 0; }
    return 1;
}

func lens_archive_pending_document() -> i64 {
    store8(g_asset_doc_rel, 0);
    if load64(g_has_file) == 0 { return 0; }
    lens_asset_make(g_asset_doc_rel, asset_doc_prefix, lens_document_asset_ext());
    if lens_write_file(g_asset_path, load64(g_file_text_p), strlen(load64(g_file_text_p))) == 0 { store8(g_asset_doc_rel, 0); return 0; }
    return 1;
}

func lens_append_sent_image_note() -> i64 {
    if load64(g_has_image) == 0 { return 0; }
    p = str_copy(g_tmp2, sent_img_a);
    if load64(g_backend) == 3 {
        if load64(g_aether_vision_sent) == 1 { p = str_copy(g_tmp2, sent_img_aether); }
        else { p = str_copy(g_tmp2, sent_img_aether_no); }
    }
    p = str_copy(p, g_img_mime);
    p = str_copy(p, sent_img_b);
    kb = load64(g_img_bytes) / 1024;
    if kb == 0 { if load64(g_img_bytes) > 0 { kb = 1; } }
    int_to_str(g_size_tmp, kb);
    p = str_copy(p, g_size_tmp);
    p = str_copy(p, sent_img_c);
    if load8(g_asset_img_rel) != 0 {
        p = str_copy(p, sent_img_preview_a);
        p = str_copy(p, g_asset_img_rel);
        p = str_copy(p, sent_preview_z);
    }
    store8(p, 0);
    lens_append_note(g_tmp2);
    return 1;
}

func lens_append_sent_vision_note() -> i64 {
    if load64(g_dual_vision_used) == 0 { return 0; }
    p = str_copy(g_tmp2, sent_vision_a);
    p = str_copy(p, g_vision_model);
    p = str_copy(p, sent_vision_b);
    i = 0;
    while i < 240 {
        c = load8(load64(g_vision_notes_p) + i);
        if c == 0 { break; }
        if c == 10 { c = 32; }
        if c == 13 { c = 32; }
        if c == 9 { c = 32; }
        store8(p, c);
        p = p + 1;
        i = i + 1;
    }
    if load8(load64(g_vision_notes_p) + i) != 0 { p = str_copy(p, "..."); }
    store8(p, 0);
    lens_append_note(g_tmp2);
    return 1;
}

func lens_append_sent_file_note() -> i64 {
    if load64(g_has_file) == 0 { return 0; }
    p = str_copy(g_tmp2, sent_file_a);
    if load64(g_file_kind) == 2 { p = str_copy(g_tmp2, sent_folder_a); }
    p = str_copy(p, g_file_name);
    p = str_copy(p, sent_img_b);
    kb = load64(g_file_bytes) / 1024;
    if kb == 0 { if load64(g_file_bytes) > 0 { kb = 1; } }
    int_to_str(g_size_tmp, kb);
    p = str_copy(p, g_size_tmp);
    p = str_copy(p, sent_img_c);
    if load8(g_asset_doc_rel) != 0 {
        p = str_copy(p, sent_doc_preview_a);
        p = str_copy(p, g_asset_doc_rel);
        p = str_copy(p, sent_preview_z);
    }
    store8(p, 0);
    lens_append_note(g_tmp2);
    return 1;
}

func lens_find_model_pos(model: i64) -> i64 {
    if load64(g_tags_p) == 0 { return 0 - 1; }
    pos = 0;
    while 1 {
        p = lj_find_after_from(load64(g_tags_p), pos, nd_name);
        if p < 0 { return 0 - 1; }
        lj_json_unesc(load64(g_tags_p), p, g_tmp, 256);
        if strcmp(g_tmp, model) == 0 { return p; }
        pos = p + 1;
    }
    return 0 - 1;
}

func lens_detail_append(p: i64, label: i64, value: i64) -> i64 {
    p = str_copy(p, label);
    if strlen(value) == 0 { return str_copy(p, det_unknown); }
    return str_copy(p, value);
}

func lens_extract_show_string(ndl: i64, dst: i64, cap: i64) -> i64 {
    p = lj_find_after(load64(g_resp_p), ndl);
    if p < 0 { store8(dst, 0); return 0; }
    lj_json_unesc(load64(g_resp_p), p, dst, cap);
    return 1;
}

func lens_extract_show_uint(ndl: i64, dst: i64) -> i64 {
    p = lj_find_after(load64(g_resp_p), ndl);
    if p < 0 { store8(dst, 0); return 0; }
    n = lj_parse_uint(load64(g_resp_p) + p);
    if n <= 0 { store8(dst, 0); return 0; }
    int_to_str(dst, n);
    return 1;
}

func lens_extract_show_first_uint(dst: i64, a: i64, b: i64, c: i64, d: i64) -> i64 {
    if lens_extract_show_uint(a, dst) == 1 { return 1; }
    if lens_extract_show_uint(b, dst) == 1 { return 1; }
    if lens_extract_show_uint(c, dst) == 1 { return 1; }
    return lens_extract_show_uint(d, dst);
}

func lens_append_show_caps(p: i64) -> i64 {
    p = str_copy(p, det_caps);
    c = lj_find_after(load64(g_resp_p), nd_show_caps);
    if c < 0 { return str_copy(p, det_unknown); }
    if lj_find_after_from(load64(g_resp_p), c, nd_vision) >= 0 { p = str_copy(p, det_vision); }
    else { p = str_copy(p, det_text); }
    return p;
}

func lens_append_show_details() -> i64 {
    p = g_model_details + strlen(g_model_details);
    p = str_copy(p, det_show);
    lens_extract_show_string(nd_arch, g_tmp, 128);
    p = lens_detail_append(p, det_arch, g_tmp);
    lens_extract_show_uint(nd_ctx_any, g_tmp);
    p = lens_detail_append(p, det_ctx, g_tmp);
    lens_extract_show_uint(nd_embed_any, g_tmp);
    p = lens_detail_append(p, det_embed, g_tmp);
    lens_extract_show_uint(nd_blocks_any, g_tmp);
    p = lens_detail_append(p, det_blocks, g_tmp);
    p = lens_append_show_caps(p);
    lens_extract_show_string(nd_parameters, g_tmp, 256);
    p = lens_detail_append(p, det_paramdef, g_tmp);
    store8(p, 0);
    lens_set_details(g_model_details);
    return 1;
}

func lens_append_show_info() -> i64 {
    p = g_info_text + strlen(g_info_text);
    lens_extract_show_string(nd_arch, g_tmp, 128);
    p = lens_detail_append(p, info_arch, g_tmp);
    lens_extract_show_uint(nd_ctx_any, g_tmp);
    if load8(g_tmp) != 0 { store64(g_model_context, str_to_int(g_tmp)); }
    p = lens_detail_append(p, info_ctx, g_tmp);
    lens_extract_show_uint(nd_embed_any, g_tmp);
    p = lens_detail_append(p, info_embed, g_tmp);
    lens_extract_show_uint(nd_blocks_any, g_tmp);
    p = lens_detail_append(p, info_blocks, g_tmp);
    lens_extract_show_string(nd_parameters, g_tmp, 256);
    p = lens_detail_append(p, info_defaults, g_tmp);
    store8(p, 0);
    lens_set_info(g_info_text);
    return 1;
}

func lens_set_details(text: i64) -> i64 {
    SetWindowTextA(load64(g_details_ed), text);
    return 0;
}

func lens_render_info() -> i64 {
    p = str_copy(g_info_display, g_info_text);
    if load8(g_runtime_text) != 0 { p = str_copy(p, g_runtime_text); }
    store8(p, 0);
    if load64(g_info_ed) != 0 { SetWindowTextA(load64(g_info_ed), g_info_display); }
    return 0;
}

func lens_set_info(text: i64) -> i64 {
    if text != g_info_text { str_copy(g_info_text, text); }
    lens_render_info();
    return 0;
}

func lens_aether_store_size(model: i64, dst: i64) -> i64 {
    store8(dst, 0);
    start = lens_find_model_pos(model);
    if start < 0 { return 0; }
    sp = lj_find_after_from(load64(g_tags_p), start, nd_size);
    next = lj_find_after_from(load64(g_tags_p), start + 1, nd_name);
    if next < 0 { next = strlen(load64(g_tags_p)); }
    if sp < 0 { return 0; }
    if sp >= next { return 0; }
    lens_size_text(lj_parse_uint(load64(g_tags_p) + sp), dst);
    return 1;
}

func lens_aether_details_base(model: i64) -> i64 {
    installed = lens_find_model_pos(model);
    lens_aether_store_size(model, g_size_tmp);
    p = str_copy(g_model_details, det_name);
    p = str_copy(p, model);
    p = lens_detail_append(p, det_size, g_size_tmp);
    p = lens_detail_append(p, det_format, det_aether_format);
    p = str_copy(p, det_caps);
    if lvp_aether_model_has_vision(model) == 1 { p = str_copy(p, det_vision); }
    else { p = str_copy(p, det_text); }
    p = str_copy(p, det_status);
    if installed >= 0 { p = str_copy(p, det_installed_aether); }
    else { p = str_copy(p, det_not_installed); }
    return p;
}

func lens_aether_append_settings(p: i64) -> i64 {
    p = str_copy(p, "\r\n\r\nServer: ");
    p = str_copy(p, g_aether_url);
    p = str_copy(p, "\r\nHardware: ");
    p = str_copy(p, lens_aether_hardware_label());
    p = str_copy(p, "\r\nOutput constraint: ");
    p = str_copy(p, lens_aether_output_label());
    p = str_copy(p, "\r\nGeneration: ");
    p = str_copy(p, lens_aether_style_label());
    p = str_copy(p, "\r\nReasoning: ");
    if load64(g_aether_reasoning) == 1 { p = str_copy(p, "think before answering"); }
    else { p = str_copy(p, "direct answer (recommended)"); }
    p = str_copy(p, "\r\nReply ceiling: ");
    int_to_str(g_tmp, load64(g_aether_max));
    p = str_copy(p, g_tmp);
    p = str_copy(p, " tokens\r\nSpeculation: ");
    if load64(g_aether_spec) == 1 { p = str_copy(p, "on"); }
    else { p = str_copy(p, "off"); }
    p = str_copy(p, " | GPU timing: ");
    if load64(g_aether_time) == 1 { p = str_copy(p, "on"); }
    else { p = str_copy(p, "off"); }
    return p;
}

func lens_update_aether_model_details(model: i64) -> i64 {
    lens_aether_store_size(model, g_size_tmp);
    p = str_copy(g_info_text, info_model);
    p = str_copy(p, model);
    p = lens_detail_append(p, info_size, g_size_tmp);
    p = str_copy(p, info_caps);
    if lvp_aether_model_has_vision(model) == 1 { p = str_copy(p, det_vision); }
    else { p = str_copy(p, det_text); }
    p = str_copy(p, "\r\nHardware: ");
    p = str_copy(p, lens_aether_hardware_label());
    store8(p, 0);
    lens_set_info(g_info_text);

    p = lens_aether_details_base(model);
    p = lens_aether_append_settings(p);
    store8(p, 0);
    lens_set_details(g_model_details);
    lens_refresh_attachment_ui();
    return 1;
}

func lens_param_text(raw: i64, dst: i64) -> i64 {
    n = lj_parse_uint(raw);
    if n >= 1000000000 {
        tenths = n / 100000000;
        int_to_str(dst, tenths / 10);
        p = dst + strlen(dst);
        p = str_copy(p, ".");
        int_to_str(g_size_tmp, tenths % 10);
        p = str_copy(p, g_size_tmp);
        str_copy(p, "B");
        return 1;
    }
    if n >= 1000000 {
        int_to_str(dst, n / 1000000);
        p = dst + strlen(dst);
        str_copy(p, "M");
        return 1;
    }
    str_copy(dst, raw);
    return 1;
}

func lens_extract_cli_line(ndl: i64, dst: i64, cap: i64) -> i64 {
    off = lj_find_after(load64(g_resp_p), ndl);
    if off < 0 { store8(dst, 0); return 0; }
    src = load64(g_resp_p) + off;
    i = 0;
    while i < cap - 1 {
        c = load8(src + i);
        if c == 0 { break; }
        if c == 10 { break; }
        if c == 13 { break; }
        store8(dst + i, c);
        i = i + 1;
    }
    store8(dst + i, 0);
    return 1;
}

func lens_aether_forward_cached(model: i64) -> i64 {
    if strcmp(model, g_aether_forward_model) != 0 { return 0; }
    return load64(g_aether_forward_state);
}

func lens_aether_warn_unsupported(model: i64) -> i64 {
    p = str_copy(g_tmp2, engine_unsupported_a);
    p = str_copy(p, model);
    str_copy(p, engine_unsupported_b);
    MessageBoxA(load64(g_hwnd), g_tmp2, engine_unsupported_title, 0x30);
    lens_set_status(st_engine_unsupported);
    return 0;
}

func lens_append_aether_inspect() -> i64 {
    str_copy(g_aether_forward_model, g_show_model);
    store64(g_aether_forward_state, lac_forward_state(load64(g_resp_p)));
    p = lens_aether_details_base(g_show_model);
    p = str_copy(p, det_native_inspect);
    lens_extract_cli_line(inspect_params, g_tmp2, 256);
    lens_param_text(g_tmp2, g_tmp);
    p = lens_detail_append(p, det_params, g_tmp);
    lens_extract_cli_line(inspect_quant, g_tmp, 256);
    p = lens_detail_append(p, det_quantization, g_tmp);
    lens_extract_cli_line(inspect_arch, g_tmp, 256);
    p = lens_detail_append(p, det_family, g_tmp);
    lens_extract_cli_line(inspect_version, g_tmp, 256);
    p = lens_detail_append(p, det_gguf_version, g_tmp);
    lens_extract_cli_line(inspect_kv, g_tmp, 256);
    p = lens_detail_append(p, det_kv_pairs, g_tmp);
    lens_extract_cli_line(inspect_tensors, g_tmp, 256);
    p = lens_detail_append(p, det_tensors, g_tmp);
    lens_extract_cli_line(inspect_file_bytes, g_tmp, 256);
    p = lens_detail_append(p, det_file_bytes, g_tmp);
    lens_extract_cli_line(inspect_layers, g_tmp, 256);
    p = lens_detail_append(p, det_blocks, g_tmp);
    lens_extract_cli_line(inspect_embed, g_tmp, 256);
    p = lens_detail_append(p, det_embed, g_tmp);
    lens_extract_cli_line(inspect_heads, g_tmp, 256);
    p = lens_detail_append(p, det_heads, g_tmp);
    lens_extract_cli_line(inspect_context, g_tmp, 256);
    p = lens_detail_append(p, det_ctx, g_tmp);
    lens_extract_cli_line(inspect_tokenizer, g_tmp, 256);
    p = lens_detail_append(p, det_tokenizer, g_tmp);
    lens_extract_cli_line(inspect_dtypes, g_tmp, 256);
    p = lens_detail_append(p, det_dtype_support, g_tmp);
    lens_extract_cli_line(inspect_forward, g_tmp, 256);
    p = lens_detail_append(p, det_forward, g_tmp);
    lens_extract_cli_line(inspect_digest, g_tmp, 65);
    lens_copy_str(g_privacy_model_digest, g_tmp, 96);
    p = lens_detail_append(p, det_digest, g_tmp);
    p = lens_aether_append_settings(p);
    store8(p, 0);
    lens_set_details(g_model_details);

    lens_aether_store_size(g_show_model, g_size_tmp);
    ip = str_copy(g_info_text, info_model);
    ip = str_copy(ip, g_show_model);
    ip = lens_detail_append(ip, info_size, g_size_tmp);
    lens_extract_cli_line(inspect_params, g_tmp2, 256);
    lens_param_text(g_tmp2, g_tmp);
    ip = lens_detail_append(ip, info_params, g_tmp);
    lens_extract_cli_line(inspect_quant, g_tmp, 256);
    ip = lens_detail_append(ip, info_quant, g_tmp);
    ip = str_copy(ip, info_caps);
    if lvp_aether_model_has_vision(g_show_model) == 1 { ip = str_copy(ip, det_vision); }
    else { ip = str_copy(ip, det_text); }
    lens_extract_cli_line(inspect_arch, g_tmp, 256);
    ip = lens_detail_append(ip, info_arch, g_tmp);
    lens_extract_cli_line(inspect_context, g_tmp, 256);
    if load8(g_tmp) != 0 { store64(g_model_context, str_to_int(g_tmp)); }
    ip = lens_detail_append(ip, info_ctx, g_tmp);
    lens_extract_cli_line(inspect_embed, g_tmp, 256);
    ip = lens_detail_append(ip, info_embed, g_tmp);
    lens_extract_cli_line(inspect_layers, g_tmp, 256);
    ip = lens_detail_append(ip, info_blocks, g_tmp);
    store8(ip, 0);
    lens_set_info(g_info_text);
    return 1;
}

func lens_update_cloud_info() -> i64 {
    b = load64(g_backend_display);
    if b == 0 { return 0; }
    if b == 3 { return lens_update_aether_model_details(g_aether_model); }
    model = lens_backend_model_ptr(b);
    env = env_openai;
    label = it_openai;
    if b == 1 { if load64(g_cloud_provider) == 1 { env = env_hf; label = it_huggingface; } }
    if b == 2 {
        env = env_anthropic;
        label = it_anthropic;
    }
    key_ok = GetEnvironmentVariableA(env, g_key, 1024);

    p = str_copy(g_info_text, info_backend);
    p = str_copy(p, label);
    p = str_copy(p, info_cloud_model);
    p = str_copy(p, model);
    p = str_copy(p, info_key);
    if key_ok > 0 { p = str_copy(p, info_key_found); }
    else {
        p = str_copy(p, info_key_missing);
        p = str_copy(p, env);
    }
    store8(p, 0);
    lens_set_info(g_info_text);

    p = str_copy(g_model_details, details_cloud_a);
    p = str_copy(p, label);
    p = str_copy(p, details_cloud_b);
    p = str_copy(p, model);
    p = str_copy(p, details_cloud_c);
    if key_ok > 0 { p = str_copy(p, info_key_found); }
    else {
        p = str_copy(p, info_key_missing);
        p = str_copy(p, env);
    }
    p = str_copy(p, details_cloud_d);
    store8(p, 0);
    lens_set_details(g_model_details);
    lens_refresh_attachment_ui();
    return 1;
}

func lens_cloud_env() -> i64 {
    if load64(g_cloud_provider) == 1 { return env_hf; }
    return env_openai;
}

func lens_hf_confirm_send() -> i64 {
    p = str_copy(g_tmp2, hf_permission_a);
    p = str_copy(p, g_openai_model);
    p = str_copy(p, hf_permission_b);
    store8(p, 0);
    if MessageBoxA(load64(g_hwnd), g_tmp2, hf_permission_title, 0x24) != 6 { return 0; }
    return 1;
}

func lens_update_info_base(model: i64) -> i64 {
    if load8(model) == 0 { lens_set_info(info_empty); return 0; }
    start = lens_find_model_pos(model);
    if start < 0 { lens_set_info(info_empty); return 0; }
    p = str_copy(g_info_text, info_model);
    p = str_copy(p, model);

    store8(g_size_tmp, 0);
    sp = lj_find_after_from(load64(g_tags_p), start, nd_size);
    next = lj_find_after_from(load64(g_tags_p), start + 1, nd_name);
    if next < 0 { next = strlen(load64(g_tags_p)); }
    if sp >= 0 { if sp < next {
        bytes = lj_parse_uint(load64(g_tags_p) + sp);
        lens_size_text(bytes, g_size_tmp);
    } }
    p = lens_detail_append(p, info_size, g_size_tmp);
    lens_extract_model_field(start, nd_param, g_tmp, 256);
    p = lens_detail_append(p, info_params, g_tmp);
    lens_extract_model_field(start, nd_quant, g_tmp, 256);
    p = lens_detail_append(p, info_quant, g_tmp);
    p = str_copy(p, info_caps);
    if lens_model_has_vision(model) == 1 { p = str_copy(p, det_vision); }
    else { p = str_copy(p, det_text); }
    store8(p, 0);
    lens_set_info(g_info_text);
    return 1;
}

func lens_update_model_details(model: i64) -> i64 {
    if load8(model) == 0 { lens_set_details(txt_details); lens_set_info(info_empty); lens_refresh_attachment_ui(); return 0; }
    store8(g_runtime_text, 0);
    start = lens_find_model_pos(model);
    if start < 0 {
        p = str_copy(g_model_details, det_name);
        p = str_copy(p, model);
        p = str_copy(p, det_status);
        str_copy(p, det_not_installed);
        lens_set_details(g_model_details);
        lens_set_info(info_empty);
        lens_refresh_attachment_ui();
        return 0;
    }
    lens_update_info_base(model);

    p = str_copy(g_model_details, det_name);
    p = str_copy(p, model);

    store8(g_size_tmp, 0);
    sp = lj_find_after_from(load64(g_tags_p), start, nd_size);
    next = lj_find_after_from(load64(g_tags_p), start + 1, nd_name);
    if next < 0 { next = strlen(load64(g_tags_p)); }
    if sp >= 0 { if sp < next {
        bytes = lj_parse_uint(load64(g_tags_p) + sp);
        lens_size_text(bytes, g_size_tmp);
    } }
    p = lens_detail_append(p, det_size, g_size_tmp);

    lens_extract_model_field(start, nd_param, g_tmp, 256);
    p = lens_detail_append(p, det_params, g_tmp);
    lens_extract_model_field(start, nd_quant, g_tmp, 256);
    p = lens_detail_append(p, det_quant, g_tmp);
    lens_extract_model_field(start, nd_family, g_tmp, 256);
    p = lens_detail_append(p, det_family, g_tmp);
    lens_extract_model_field(start, nd_format, g_tmp, 256);
    p = lens_detail_append(p, det_format, g_tmp);

    p = str_copy(p, det_caps);
    if lens_model_has_vision(model) == 1 { p = str_copy(p, det_vision); }
    else { p = str_copy(p, det_text); }

    lens_extract_model_field(start, nd_modified, g_tmp, 256);
    p = lens_detail_append(p, det_modified, g_tmp);
    lens_extract_model_field(start, nd_digest, g_tmp, 256);
    p = lens_detail_append(p, det_digest, g_tmp);
    store8(p, 0);
    lens_set_details(g_model_details);
    lens_refresh_attachment_ui();
    return 1;
}

func lens_update_selected_details() -> i64 {
    row = SendMessageA(load64(g_models), 4108, 0 - 1, 2);
    if row < 0 { return 0; }
    gui_lv_get_cell(load64(g_models), row, 0, g_model_tmp, 256);
    if load64(g_backend_display) == 3 {
        lens_update_aether_model_details(g_model_tmp);
        lens_show_model(g_model_tmp);
        return 1;
    }
    lens_update_model_details(g_model_tmp);
    lens_show_model(g_model_tmp);
    return 1;
}

func lens_aether_hardware_label() -> i64 {
    if load64(g_aether_hw) == 1 { return "Conservative GPU (final projection only)"; }
    if load64(g_aether_hw) == 2 { return "CPU reference"; }
    return "Full GPU (recommended; discrete adapter auto-selected)";
}

func lens_aether_output_label() -> i64 {
    if load64(g_aether_restrict) == 1 { return "ASCII characters only (not English-only)"; }
    if load64(g_aether_restrict) == 2 { return "Digits and numeric punctuation only"; }
    return "All languages / Unicode";
}

func lens_aether_style_label() -> i64 {
    if load64(g_aether_style) == 1 { return "Balanced (temperature 0.4)"; }
    if load64(g_aether_style) == 2 { return "Creative (temperature 0.8)"; }
    return "Precise / deterministic (greedy)";
}

func lens_aether_reasoning_label() -> i64 {
    if load64(g_aether_reasoning) == 1 { return "Think before answering"; }
    return "Direct answer (recommended)";
}

func lens_aether_apply_setting(id: i64) -> i64 {
    if load64(g_busy) != 0 { lens_set_status(st_busy); return 0; }
    restart = 0;
    if id == ID_ENG_HW_GPU { store64(g_aether_hw, 0); restart = 1; }
    if id == ID_ENG_HW_FINAL { store64(g_aether_hw, 1); restart = 1; }
    if id == ID_ENG_HW_CPU { store64(g_aether_hw, 2); restart = 1; }
    if id == ID_ENG_OUT_ALL { store64(g_aether_restrict, 0); restart = 1; }
    if id == ID_ENG_OUT_ASCII { store64(g_aether_restrict, 1); restart = 1; }
    if id == ID_ENG_OUT_DIGITS { store64(g_aether_restrict, 2); restart = 1; }
    if id == ID_ENG_STYLE_PRECISE { store64(g_aether_style, 0); }
    if id == ID_ENG_STYLE_BALANCED { store64(g_aether_style, 1); }
    if id == ID_ENG_STYLE_CREATIVE { store64(g_aether_style, 2); }
    if id == ID_ENG_REASON_DIRECT { store64(g_aether_reasoning, 0); }
    if id == ID_ENG_REASON_THINK {
        store64(g_aether_reasoning, 1);
        if load64(g_aether_max) < 512 { store64(g_aether_max, 512); }
        if load64(g_aether_style) == 0 { store64(g_aether_style, 1); }
    }
    if id == ID_ENG_LEN_64 { store64(g_aether_max, 64); }
    if id == ID_ENG_LEN_128 { store64(g_aether_max, 128); }
    if id == ID_ENG_LEN_256 { store64(g_aether_max, 256); }
    if id == ID_ENG_LEN_512 { store64(g_aether_max, 512); }
    if id == ID_ENG_SPEC_ON { store64(g_aether_spec, 1); restart = 1; }
    if id == ID_ENG_SPEC_OFF { store64(g_aether_spec, 0); restart = 1; }
    if id == ID_ENG_TIME_OFF { store64(g_aether_time, 0); restart = 1; }
    if id == ID_ENG_TIME_ON { store64(g_aether_time, 1); restart = 1; }
    lens_config_save();
    lens_update_cloud_info();
    if restart == 1 {
        if lens_aether_owned_alive() == 1 {
            lens_set_status(st_engine_cfg);
            lens_aether_stop_owned();
            lens_refresh_models();
        } else { lens_set_status(st_engine_remote); }
    } else { lens_set_status(st_engine_ready); }
    return 1;
}

func lens_catalog_select(model: i64) -> i64 {
    lens_harvest_display();
    store64(g_backend_display, 0);
    store64(g_backend, 0);
    str_copy(g_ollama_model, model);
    lens_sync_backend_controls();
    lens_update_model_details(g_ollama_model);
    lens_config_save();
    InvalidateRect(load64(g_backend_cb), 0, 1);
    lens_set_status(st_catalog_pick);
    return 0;
}

func lens_aether_catalog_tag(id: i64) -> i64 {
    if id == ID_AEC_GEMMA4E { return ae_tag_gemma4e; }
    if id == ID_AEC_GEMMA270 { return ae_tag_gemma270; }
    if id == ID_AEC_GEMMA1 { return ae_tag_gemma1; }
    if id == ID_AEC_GEMMA4 { return ae_tag_gemma4; }
    if id == ID_AEC_GEMMA12 { return ae_tag_gemma12; }
    if id == ID_AEC_QWEN3_06 { return ae_tag_qwen3_06; }
    if id == ID_AEC_QWEN3_17 { return ae_tag_qwen3_17; }
    if id == ID_AEC_QWEN3_4 { return ae_tag_qwen3_4; }
    if id == ID_AEC_QWEN3_8 { return ae_tag_qwen3_8; }
    if id == ID_AEC_QWEN25_05 { return ae_tag_qwen25_05; }
    if id == ID_AEC_QWEN25_15 { return ae_tag_qwen25_15; }
    if id == ID_AEC_QWEN25_3 { return ae_tag_qwen25_3; }
    if id == ID_AEC_QWEN25_7 { return ae_tag_qwen25_7; }
    if id == ID_AEC_LLAMA1 { return ae_tag_llama1; }
    if id == ID_AEC_LLAMA3 { return ae_tag_llama3; }
    if id == ID_AEC_MISTRAL { return ae_tag_mistral; }
    if id == ID_AEC_TINY { return ae_tag_tiny; }
    return 0;
}

func lens_aether_catalog_select(id: i64) -> i64 {
    model = lens_aether_catalog_tag(id);
    if model == 0 { return 0; }
    lens_harvest_display();
    store64(g_backend_display, 3);
    store64(g_backend, 3);
    str_copy(g_aether_model, model);
    lens_sync_backend_controls();
    lens_config_save();
    lens_set_status(st_aether_catalog_pick);
    return 1;
}

func lens_set_vision_mode(mode: i64, status: i64) -> i64 {
    store64(g_vision_mode, mode);
    lens_config_save();
    lens_refresh_attachment_ui();
    lens_set_status(status);
    return 0;
}

func lens_fill_models() -> i64 {
    lv = load64(g_models);
    gui_lv_clear(lv);
    row = 0;
    pos = 0;
    while row < 128 {
        p = lj_find_after_from(load64(g_tags_p), pos, nd_name);
        if p < 0 { break; }
        lj_json_unesc(load64(g_tags_p), p, g_model_tmp, 256);
        gui_lv_insert_row(lv, row, g_model_tmp);

        sp = lj_find_after_from(load64(g_tags_p), p, nd_size);
        next = lj_find_after_from(load64(g_tags_p), p + 1, nd_name);
        if sp >= 0 {
            if next < 0 { next = strlen(load64(g_tags_p)); }
            if sp < next {
                bytes = lj_parse_uint(load64(g_tags_p) + sp);
                lens_size_text(bytes, g_size_tmp);
                gui_lv_set_cell(lv, row, 1, g_size_tmp);
            }
        }

        lens_extract_model_field(p, nd_param, g_tmp, 256);
        lens_extract_model_field(p, nd_quant, g_tmp2, 256);
        info = str_copy(g_tmp3, g_tmp);
        if strlen(g_tmp2) > 0 {
            info = str_copy(info, space);
            info = str_copy(info, g_tmp2);
        }
        c = lj_find_after_from(load64(g_tags_p), p, nd_caps);
        if c >= 0 {
            if next < 0 { next = strlen(load64(g_tags_p)); }
            if c < next {
                vp = lj_find_after_from(load64(g_tags_p), c, nd_vision);
                if vp >= 0 { if vp < next {
                    info = str_copy(info, " vision");
                } }
            }
        }
        if load64(g_backend_display) == 3 {
            if lvp_aether_model_has_vision(g_model_tmp) == 1 { info = str_copy(info, " vision"); }
        }
        gui_lv_set_cell(lv, row, 2, g_tmp3);
        row = row + 1;
        pos = p + 1;
    }
    if load64(g_backend_display) == 3 { lens_update_aether_model_details(g_aether_model); }
    else { lens_update_model_details(g_ollama_model); }
    return row;
}

func lens_fill_hf_models() -> i64 {
    lv = load64(g_models);
    gui_lv_clear(lv);
    row = 0;
    pos = 0;
    while row < 128 {
        p = lj_find_after_from(load64(g_tags_p), pos, nd_id);
        if p < 0 { break; }
        lj_json_unesc(load64(g_tags_p), p, g_model_tmp, 220);
        # The router lists bare model ids. Lens deliberately adds its explicit
        # cost-routing policy so the selected value is ready to send as-is.
        str_copy(g_tmp3, g_model_tmp);
        str_copy(g_tmp3 + strlen(g_tmp3), ":cheapest");
        gui_lv_insert_row(lv, row, g_tmp3);
        gui_lv_set_cell(lv, row, 1, "cloud");
        gui_lv_set_cell(lv, row, 2, "text chat");
        row = row + 1;
        pos = p + 1;
    }
    return row;
}

func lens_system_prompt() -> i64 {
    if load64(g_canvas_request_active) == 1 {
        if load64(g_canvas_request_kind) == 1 { return sys_canvas_html; }
        if load64(g_canvas_request_kind) == 2 { return sys_canvas_svg; }
        if load64(g_canvas_request_kind) == 3 { return sys_canvas_csv; }
        return sys_canvas;
    }
    p = load64(g_preset);
    if p == 1 { return sys_ancl; }
    if p == 2 { return sys_industrial; }
    if p == 3 { return sys_general; }
    return sys_general;
}

func lens_append_ascii_char(c: i64) -> i64 {
    d = strlen(load64(g_transcript_p));
    if d >= 524200 { store8(load64(g_transcript_p) + d, 0); return d; }
    store8(load64(g_transcript_p) + d, c);
    store8(load64(g_transcript_p) + d + 1, 0);
    return d + 1;
}

func lens_append_ascii_str(s: i64) -> i64 {
    i = 0;
    d = strlen(load64(g_transcript_p));
    while d < 524200 {
        c = load8(s + i);
        if c == 0 { store8(load64(g_transcript_p) + d, 0); return d; }
        store8(load64(g_transcript_p) + d, c);
        d = d + 1;
        i = i + 1;
    }
    store8(load64(g_transcript_p) + d, 0);
    return d;
}

func lens_append_utf8_fallback(s: i64, i: i64) -> i64 {
    c = load8(s + i);
    n = 1;
    if c >= 240 { n = 4; }
    else if c >= 224 { n = 3; }
    else if c >= 192 { n = 2; }

    if c == 194 {
        c1 = load8(s + i + 1);
        if c1 == 160 { lens_append_ascii_char(32); return i + 2; }
        if c1 == 176 { lens_append_ascii_str(" deg"); return i + 2; }
    }
    if c == 226 {
        c1 = load8(s + i + 1);
        c2 = load8(s + i + 2);
        if c1 == 128 {
            if c2 == 152 { lens_append_ascii_char(39); return i + 3; }
            if c2 == 153 { lens_append_ascii_char(39); return i + 3; }
            if c2 == 156 { lens_append_ascii_char(34); return i + 3; }
            if c2 == 157 { lens_append_ascii_char(34); return i + 3; }
            if c2 == 147 { lens_append_ascii_char(45); return i + 3; }
            if c2 == 148 { lens_append_ascii_char(45); return i + 3; }
            if c2 == 166 { lens_append_ascii_str("..."); return i + 3; }
        }
    }

    lens_append_ascii_char(63);
    return i + n;
}

func lens_append_raw(s: i64) -> i64 {
    i = 0;
    while strlen(load64(g_transcript_p)) < 524200 {
        c = load8(s + i);
        if c == 0 { return strlen(load64(g_transcript_p)); }
        if c >= 128 {
            i = lens_append_utf8_fallback(s, i);
        } else {
            lens_append_ascii_char(c);
            i = i + 1;
        }
    }
    return strlen(load64(g_transcript_p));
}

func lens_append_user(s: i64) -> i64 {
    lens_append_raw(line_user);
    lens_append_raw(s);
    lens_append_raw(blank2);
    return 0;
}

func lens_append_ai(s: i64) -> i64 {
    lens_append_raw(line_ai);
    lens_append_raw(s);
    lens_append_raw(blank2);
    return 0;
}

func lens_append_note(s: i64) -> i64 {
    lens_append_raw(line_sys);
    lens_append_raw(s);
    lens_append_raw(nl);
    return 0;
}

func lens_rich_format_range(ed: i64, first: i64, last: i64, color: i64, bold: i64) -> i64 {
    if last <= first { return 0; }
    store32(g_rich_rng + 0, first);
    store32(g_rich_rng + 4, last);
    rich_exset_sel(ed, g_rich_rng);
    rich_cf_init(g_cf);
    store32(g_cf + 4, 0x40000001);
    if bold != 0 { store32(g_cf + 8, 1); }
    else { store32(g_cf + 8, 0); }
    store32(g_cf + 20, color);
    rich_set_charformat(ed, SCF_SELECTION, g_cf);
    return 1;
}

func lens_md_format_range(ed: i64, first: i64, last: i64, color: i64, effect_mask: i64, effects: i64, size: i64, back: i64) -> i64 {
    if last <= first { return 0; }
    store32(g_rich_rng + 0, first);
    store32(g_rich_rng + 4, last);
    rich_exset_sel(ed, g_rich_rng);
    memset(g_md_cf, 0, 84);
    store32(g_md_cf + 0, 84);
    mask = 0x40000000 + effect_mask;
    if size > 0 { mask = mask + 0x80000000; store32(g_md_cf + 12, size); }
    if back >= 0 { mask = mask + 0x04000000; store32(g_md_cf + 64, back); }
    store32(g_md_cf + 4, mask);
    store32(g_md_cf + 8, effects);
    store32(g_md_cf + 20, color);
    rich_set_charformat(ed, SCF_SELECTION, g_md_cf);
    return 1;
}

func lens_md_hide_range(ed: i64, first: i64, last: i64) -> i64 {
    return lens_md_format_range(ed, first, last, COLOR_MUTED, 0x100, 0x100, 0, 0 - 1);
}

func lens_md_find(src: i64, from: i64, end: i64, token: i64) -> i64 {
    i = from;
    n = strlen(token);
    while i + n <= end {
        if lens_match_at(src, i, token) == 1 { return i; }
        i = i + 1;
    }
    return 0 - 1;
}

func lens_md_rpos(src: i64, source_base: i64, rich_base: i64, pos: i64) -> i64 {
    return rich_base + lens_rich_len(src, source_base, pos);
}

func lens_style_reasoning(ed: i64, src: i64, start: i64, end: i64, rich_start: i64) -> i64 {
    pos = start;
    while pos < end {
        op = lens_md_find(src, pos, end, "<think>");
        if op < 0 { return 0; }
        body = op + 7;
        cl = lens_md_find(src, body, end, "</think>");
        if cl < 0 { cl = end; }
        rop = lens_md_rpos(src, start, rich_start, op);
        rbody = lens_md_rpos(src, start, rich_start, body);
        rcl = lens_md_rpos(src, start, rich_start, cl);
        lens_md_hide_range(ed, rop, rbody);
        if load64(g_reasoning_visible) == 0 { lens_md_hide_range(ed, rbody, rcl); }
        else { lens_md_format_range(ed, rbody, rcl, COLOR_MUTED, 2, 2, 0, 0 - 1); }
        if cl < end {
            rend = lens_md_rpos(src, start, rich_start, cl + 8);
            lens_md_hide_range(ed, rcl, rend);
            pos = cl + 8;
        } else { return 0; }
    }
    return 0;
}

func lens_style_inline_markdown(ed: i64, src: i64, start: i64, end: i64, rich_start: i64) -> i64 {
    i = start;
    while i < end {
        if load8(src + i) == 96 {
            if i + 2 < end {
                if load8(src + i + 1) != 96 {
                    close = i + 1;
                    while close < end { if load8(src + close) == 96 { break; } close = close + 1; }
                    if close < end {
                        a = lens_md_rpos(src, start, rich_start, i);
                        b = lens_md_rpos(src, start, rich_start, i + 1);
                        c = lens_md_rpos(src, start, rich_start, close);
                        d = lens_md_rpos(src, start, rich_start, close + 1);
                        lens_md_hide_range(ed, a, b);
                        lens_md_format_range(ed, b, c, COLOR_USER, 0, 0, 0, COLOR_CARD);
                        lens_md_hide_range(ed, c, d);
                        i = close + 1;
                    }
                }
            }
        }
        if i + 3 < end { if load8(src + i) == 42 { if load8(src + i + 1) == 42 {
            close = lens_md_find(src, i + 2, end, "**");
            if close >= 0 {
                a = lens_md_rpos(src, start, rich_start, i);
                b = lens_md_rpos(src, start, rich_start, i + 2);
                c = lens_md_rpos(src, start, rich_start, close);
                d = lens_md_rpos(src, start, rich_start, close + 2);
                lens_md_hide_range(ed, a, b);
                lens_md_format_range(ed, b, c, COLOR_TEXT, 1, 1, 0, 0 - 1);
                lens_md_hide_range(ed, c, d);
                i = close + 2;
            }
        } } }
        if i < end { if load8(src + i) == 91 {
            mid = lens_md_find(src, i + 1, end, "](");
            if mid >= 0 {
                close = lens_md_find(src, mid + 2, end, ")");
                if close >= 0 {
                    a = lens_md_rpos(src, start, rich_start, i);
                    b = lens_md_rpos(src, start, rich_start, i + 1);
                    c = lens_md_rpos(src, start, rich_start, mid);
                    d = lens_md_rpos(src, start, rich_start, mid + 2);
                    e = lens_md_rpos(src, start, rich_start, close + 1);
                    lens_md_hide_range(ed, a, b);
                    lens_md_format_range(ed, b, c, COLOR_ACCENT, 0x24, 0x24, 0, 0 - 1);
                    lens_md_hide_range(ed, c, d);
                    lens_md_hide_range(ed, d, e);
                    i = close + 1;
                }
            }
        } }
        i = i + 1;
    }
    return 0;
}

func lens_style_markdown(ed: i64, src: i64, start: i64, end: i64, rich_start: i64) -> i64 {
    lens_style_reasoning(ed, src, start, end, rich_start);
    line = start;
    rp = rich_start;
    in_code = 0;
    while line < end {
        le = line;
        while le < end { c = load8(src + le); if c == 13 { break; } if c == 10 { break; } le = le + 1; }
        next = le;
        if next < end { if load8(src + next) == 13 { next = next + 1; } }
        if next < end { if load8(src + next) == 10 { next = next + 1; } }
        next_rp = rp + lens_rich_len(src, line, next);
        is_fence = 0;
        if le - line >= 3 {
            if load8(src + line) == 96 { if load8(src + line + 1) == 96 { if load8(src + line + 2) == 96 { is_fence = 1; } } }
        }
        if is_fence == 1 {
            lens_md_hide_range(ed, rp, rp + lens_rich_len(src, line, le));
            if in_code == 0 { in_code = 1; }
            else { in_code = 0; }
        } else if in_code == 1 {
            lens_md_format_range(ed, rp, next_rp, COLOR_TEXT, 0, 0, 0, COLOR_CARD);
        } else {
            hashes = 0;
            while line + hashes < le { if load8(src + line + hashes) != 35 { break; } hashes = hashes + 1; }
            if hashes > 0 { if hashes <= 3 { if line + hashes < le { if load8(src + line + hashes) == 32 {
                marker_end = line + hashes + 1;
                rm = rp + lens_rich_len(src, line, marker_end);
                lens_md_hide_range(ed, rp, rm);
                hs = 280;
                if hashes == 1 { hs = 360; }
                if hashes == 2 { hs = 320; }
                lens_md_format_range(ed, rm, rp + lens_rich_len(src, line, le), COLOR_AI, 1, 1, hs, 0 - 1);
            } } } }
            if le - line >= 2 {
                c0 = load8(src + line);
                if load8(src + line + 1) == 32 {
                    if c0 == 62 { lens_md_format_range(ed, rp, rp + lens_rich_len(src, line, le), COLOR_MUTED, 2, 2, 0, 0 - 1); }
                    if c0 == 45 { lens_md_format_range(ed, rp, rp + 1, COLOR_ACCENT, 1, 1, 0, 0 - 1); }
                    if c0 == 42 { lens_md_format_range(ed, rp, rp + 1, COLOR_ACCENT, 1, 1, 0, 0 - 1); }
                    if c0 == 43 { lens_md_format_range(ed, rp, rp + 1, COLOR_ACCENT, 1, 1, 0, 0 - 1); }
                }
            }
            if le - line >= 3 {
                if load8(src + line) == 45 { if load8(src + line + 1) == 45 { if load8(src + line + 2) == 45 {
                    lens_md_format_range(ed, rp, rp + lens_rich_len(src, line, le), COLOR_ACCENT, 1, 1, 0, 0 - 1);
                } } }
            }
            j = line;
            while j < le {
                if load8(src + j) == 124 {
                    rr = rp + lens_rich_len(src, line, j);
                    lens_md_format_range(ed, rr, rr + 1, COLOR_ACCENT, 1, 1, 0, 0 - 1);
                }
                j = j + 1;
            }
            lens_style_inline_markdown(ed, src, line, le, rp);
        }
        rp = next_rp;
        line = next;
    }
    return 0;
}

func lens_rich_len(src: i64, first: i64, last: i64) -> i64 {
    i = first;
    n = 0;
    while i < last {
        c = load8(src + i);
        if c != 10 { n = n + 1; }
        else {
            if i == 0 { n = n + 1; }
            else { if load8(src + i - 1) != 13 { n = n + 1; } }
        }
        i = i + 1;
    }
    return n;
}

func lens_display_line_start(src: i64, pos: i64) -> i64 {
    if pos == 0 { return 1; }
    if load8(src + pos - 1) == 10 { return 1; }
    return 0;
}

func lens_display_role_at(src: i64, pos: i64) -> i64 {
    if lens_display_line_start(src, pos) == 0 { return 0; }
    if lens_match_at(src, pos, line_user) == 1 { return 1; }
    if lens_match_at(src, pos, line_ai) == 1 { return 2; }
    if lens_match_at(src, pos, line_sys) == 1 { return 3; }
    return 0;
}

func lens_display_next_turn(src: i64, pos: i64) -> i64 {
    i = pos;
    while 1 {
        c = load8(src + i);
        if c == 0 { return i; }
        if lens_display_role_at(src, i) != 0 { return i; }
        i = i + 1;
    }
    return i;
}

func lens_style_transcript(ed: i64) -> i64 {
    src = load64(g_transcript_p);
    rich_select_all(ed);
    rich_cf_init(g_cf);
    store32(g_cf + 4, 0x40000001);
    store32(g_cf + 8, 0);
    store32(g_cf + 20, COLOR_TEXT);
    rich_set_charformat(ed, SCF_SELECTION, g_cf);

    i = 0;
    rp = 0;
    while 1 {
        c = load8(src + i);
        if c == 0 { break; }
        role = lens_display_role_at(src, i);
        if role != 0 {
            label = line_user;
            lc = COLOR_USER;
            bc = COLOR_TEXT;
            if role == 2 {
                label = line_ai;
                lc = COLOR_AI;
                bc = COLOR_TEXT;
            }
            if role == 3 {
                label = line_sys;
                lc = COLOR_MUTED;
                bc = COLOR_MUTED;
            }
            lblen = strlen(label);
            next = lens_display_next_turn(src, i + 1);
            rlen = lens_rich_len(src, i, next);
            lens_rich_format_range(ed, rp, rp + lblen, lc, 1);
            lens_rich_format_range(ed, rp + lblen, rp + rlen, bc, 0);
            if role == 2 { lens_style_markdown(ed, src, i + lblen, next, rp + lblen); }
            if role == 3 {
                lens_md_format_range(ed, rp, rp + rlen, COLOR_MUTED, 0, 0, 0, COLOR_CARD);
                lens_style_markdown(ed, src, i + lblen, next, rp + lblen);
            }
            rp = rp + rlen;
            i = next;
        } else {
            if c != 10 { rp = rp + 1; }
            i = i + 1;
        }
    }
    return 0;
}

func lens_refresh_transcript() -> i64 {
    ed = load64(g_trans_ed);
    if ed == 0 { return 0; }
    rich_set_redraw(ed, 0);
    SendMessageA(ed, 0x43F, 1, 0);
    SendMessageA(ed, 0xCF, 0, 0);
    SetWindowTextA(ed, load64(g_transcript_p));
    lens_style_transcript(ed);
    n = strlen(load64(g_transcript_p));
    rn = lens_rich_len(load64(g_transcript_p), 0, n);
    SendMessageA(ed, 177, rn, rn);
    SendMessageA(ed, 0xB7, 0, 0);
    SendMessageA(ed, 0xCF, 1, 0);
    SendMessageA(ed, 0x43F, 0, 0);
    rich_set_redraw(ed, 1);
    InvalidateRect(ed, 0, 1);
    return 0;
}

func lens_set_app_icon(hwnd: i64) -> i64 {
    hicon = LoadIconA(load64(g_hinst), 1);
    if hicon != 0 {
        SendMessageA(hwnd, 0x80, 0, hicon);
        SendMessageA(hwnd, 0x80, 1, hicon);
    }
    return hicon;
}

func lens_show_help(on: i64) -> i64 {
    store64(g_help_visible, on);
    GetClientRect(load64(g_hwnd), g_rect);
    lens_layout(load32(g_rect + 8), load32(g_rect + 12));
    if on == 1 {
        BringWindowToTop(load64(g_help_ed));
        SetFocus(load64(g_help_ed));
    }
    return 0;
}

func lens_open_guide() -> i64 {
    p = str_copy(g_guide_path, g_rootdir);
    str_copy(p, guide_suffix);
    rv = ShellExecuteA(load64(g_hwnd), op_open, g_guide_path, 0, 0, 5);
    if rv <= 32 {
        lens_show_help(1);
        lens_set_status(st_noguide);
        MessageBoxA(load64(g_hwnd), st_noguide, help_title, 0x30);
    }
    return 0;
}

func lens_system_ram_gib() -> i64 {
    memset(g_memory_status, 0, 64);
    store32(g_memory_status, 64);
    if GlobalMemoryStatusEx(g_memory_status) == 0 { return 0; }
    bytes = load64(g_memory_status + 8);
    # Round to the nearest GiB so common marketed capacities read naturally.
    return (bytes + 536870912) / 1073741824;
}

func lens_first_run_guidance() -> i64 {
    if load64(g_first_run) == 0 { return 0; }
    ram = lens_system_ram_gib();
    model = fr_model_tag(ram);
    p = str_copy(g_first_run_text, first_run_a);
    if ram <= 0 { p = str_copy(p, first_run_unknown); }
    else {
        int_to_str(g_tmp, ram);
        p = str_copy(p, g_tmp);
        p = str_copy(p, first_run_gib);
    }
    p = str_copy(p, first_run_b);
    p = str_copy(p, model);
    p = str_copy(p, first_run_c);
    p = str_copy(p, fr_model_download(ram));
    p = str_copy(p, first_run_d);
    store8(p, 0);
    rc = MessageBoxA(load64(g_hwnd), g_first_run_text, first_run_title, 0x24);
    if rc == 6 {
        store64(g_backend, 3);
        store64(g_backend_display, 3);
        store64(g_aether_hw, 0);
        str_copy(g_aether_model, model);
        str_copy(g_saved_aether_model, model);
        lens_sync_backend_controls();
        lens_set_status(first_run_selected);
    }
    store64(g_first_run, 0);
    lens_config_save();
    return 1;
}

func lens_copy_str(dst: i64, src: i64, cap: i64) -> i64 {
    i = 0;
    lim = cap - 1;
    while i < lim {
        c = load8(src + i);
        store8(dst + i, c);
        if c == 0 { return i; }
        i = i + 1;
    }
    store8(dst + i, 0);
    return i;
}

func lens_sanitize_name(src: i64, dst: i64, cap: i64) -> i64 {
    i = 0;
    j = 0;
    lim = cap - 1;
    while j < lim {
        c = load8(src + i);
        if c == 0 { break; }
        if c == 92 { c = 95; }
        if c == 47 { c = 95; }
        if c == 58 { c = 95; }
        if c == 42 { c = 95; }
        if c == 63 { c = 95; }
        if c == 34 { c = 95; }
        if c == 60 { c = 95; }
        if c == 62 { c = 95; }
        if c == 124 { c = 95; }
        store8(dst + j, c);
        i = i + 1;
        j = j + 1;
    }
    if j == 0 {
        str_copy(dst, default_chat);
        return strlen(dst);
    }
    store8(dst + j, 0);
    return j;
}

func lens_file_exists(path: i64) -> i64 {
    if load8(path) == 0 { return 0; }
    h = CreateFileA(path, 0x80000000, 1, 0, 3, 0x80, 0);
    if h == 0 - 1 { return 0; }
    CloseHandle(h);
    return 1;
}

func lens_chat_make_path(dst: i64, name: i64, suffix: i64) -> i64 {
    lens_sanitize_name(name, g_tmp, 160);
    p = str_copy(dst, g_chatdir);
    store8(p, 92);
    p = p + 1;
    p = str_copy(p, g_tmp);
    if suffix != 0 { p = str_copy(p, suffix); }
    str_copy(p, chat_ext);
    return 0;
}

func lens_chat_path() -> i64 {
    gui_get_text(load64(g_chatname_ed), g_chat_name, 160);
    lens_chat_make_path(g_chatpath, g_chat_name, 0);
    return 0;
}

func lens_chat_write_current(path: i64) -> i64 {
    p = str_copy(load64(g_filebuf_p), chat_hdr);
    int_to_str(g_tmp2, strlen(g_chat_name));
    p = str_copy(p, g_tmp2);
    p = str_copy(p, chat_mid1);
    p = str_copy(p, g_chat_name);
    p = str_copy(p, chat_mid2);
    int_to_str(g_tmp2, strlen(load64(g_transcript_p)));
    p = str_copy(p, g_tmp2);
    p = str_copy(p, chat_mid3);
    p = str_copy(p, load64(g_transcript_p));
    store8(p, 0);
    if lens_write_file(path, load64(g_filebuf_p), strlen(load64(g_filebuf_p))) == 0 {
        lens_set_status(st_savefail);
        return 0;
    }
    lens_copy_str(g_chatpath, path, 900);
    lens_config_save();
    lens_set_status(st_saved);
    return 1;
}

func lens_chat_save() -> i64 {
    lens_chat_path();
    return lens_chat_write_current(g_chatpath);
}

func lens_chat_save_as() -> i64 {
    if load64(g_busy) != 0 { lens_set_status(st_busy); return 0; }
    lens_chat_path();
    if gui_save_file_dialog(g_ofn, load64(g_hwnd), g_lens_filter, g_chatpath, 900, g_chatdir, save_as_title, chat_ext + 1, 0x1806) == 0 { return 0; }
    lens_chat_name_from_path(g_chatpath);
    return lens_chat_write_current(g_chatpath);
}

func lens_chat_load() -> i64 {
    lens_chat_path();
    return lens_chat_load_path(g_chatpath);
}

func lens_chat_name_from_path(path: i64) -> i64 {
    bs = lens_last_bs(path);
    start = 0;
    if bs >= 0 { start = bs + 1; }
    i = start;
    j = 0;
    lim = 159;
    while j < lim {
        c = load8(path + i);
        if c == 0 { break; }
        if c == 46 {
            if lens_ends_with_ci(path + i, chat_ext) == 1 { break; }
        }
        store8(g_chat_name + j, c);
        i = i + 1;
        j = j + 1;
    }
    store8(g_chat_name + j, 0);
    if j == 0 { str_copy(g_chat_name, default_chat); }
    SetWindowTextA(load64(g_chatname_ed), g_chat_name);
    return 0;
}

func lens_chat_load_path(path: i64) -> i64 {
    store64(g_help_visible, 0);
    store64(g_edit_pending, 0);
    lens_copy_str(g_chatpath, path, 900);
    n = lens_read_file(g_chatpath, load64(g_filebuf_p), 1048576);
    if n < 0 { lens_set_status(st_loadfail); return 0; }
    p = lj_find_after(load64(g_filebuf_p), chat_mid3);
    if p < 0 { str_copy(load64(g_transcript_p), load64(g_filebuf_p)); }
    else { lens_copy_str(load64(g_transcript_p), load64(g_filebuf_p) + p, 524288); }
    lens_chat_name_from_path(g_chatpath);
    store64(g_has_image, 0);
    store64(g_has_file, 0);
    store64(g_dual_vision_used, 0);
    store64(g_aether_vision_sent, 0);
    store64(g_aether_vision_route, 0);
    store64(g_img_bytes, 0);
    store64(g_file_bytes, 0);
    store64(g_file_kind, 0);
    store8(g_file_name, 0);
    store8(load64(g_file_text_p), 0);
    store8(g_vision_model, 0);
    store8(load64(g_vision_notes_p), 0);
    lens_preview_clear();
    lens_clear_runtime_info();
    lens_refresh_attachment_ui();
    GetClientRect(load64(g_hwnd), g_rect);
    lens_layout(load32(g_rect + 8), load32(g_rect + 12));
    lens_refresh_transcript();
    lens_config_save();
    lens_set_status(st_loaded);
    return 1;
}

func lens_chat_load_dialog() -> i64 {
    if load64(g_busy) != 0 { lens_set_status(st_busy); return 0; }
    store8(g_chatpath, 0);
    if gui_open_file_dialog(g_ofn, load64(g_hwnd), g_lens_filter, g_chatpath, 900, g_chatdir, load_title, 0x1804) == 0 { return 0; }
    return lens_chat_load_path(g_chatpath);
}

func lens_recent_path_slot(i: i64) -> i64 {
    return g_recent_paths + i * 900;
}

func lens_recent_label_slot(i: i64) -> i64 {
    return g_recent_labels + i * 160;
}

func lens_recent_label_from_file(file: i64, dst: i64) -> i64 {
    i = 0;
    j = 0;
    while j < 159 {
        c = load8(file + i);
        if c == 0 { break; }
        if c == 46 {
            if lens_ends_with_ci(file + i, chat_ext) == 1 { break; }
        }
        store8(dst + j, c);
        i = i + 1;
        j = j + 1;
    }
    if j == 0 { return str_copy(dst, mi_no_chats); }
    store8(dst + j, 0);
    return j;
}

func lens_recent_add(file: i64, count: i64) -> i64 {
    if count >= 12 { return count; }
    if lens_ends_with_ci(file, chat_ext) == 0 { return count; }
    p = str_copy(lens_recent_path_slot(count), g_chatdir);
    store8(p, 92);
    p = p + 1;
    str_copy(p, file);
    lens_recent_label_from_file(file, lens_recent_label_slot(count));
    return count + 1;
}

func lens_recent_scan() -> i64 {
    p = str_copy(g_recent_glob, g_chatdir);
    store8(p, 92);
    p = p + 1;
    str_copy(p, flt_lens_b);
    count = 0;
    h = FindFirstFileA(g_recent_glob, g_recent_find);
    if h == 0 - 1 {
        store64(g_recent_count, 0);
        return 0;
    }
    while 1 {
        attr = load32(g_recent_find + 0);
        if band(attr, 16) == 0 {
            count = lens_recent_add(g_recent_find + 44, count);
        }
        if count >= 12 { break; }
        if FindNextFileA(h, g_recent_find) == 0 { break; }
    }
    FindClose(h);
    store64(g_recent_count, count);
    return count;
}

func lens_recent_menu_clear(menu: i64) -> i64 {
    c = GetMenuItemCount(menu);
    while c > 0 {
        RemoveMenu(menu, 0, 0x400);
        c = c - 1;
    }
    return 0;
}

func lens_recent_menu_build() -> i64 {
    menu = load64(g_load_menu);
    lens_recent_menu_clear(menu);
    count = lens_recent_scan();
    if count == 0 {
        lens_menu_item(menu, ID_RECENT_NONE, mi_no_chats);
    } else {
        i = 0;
        while i < count {
            lens_menu_item(menu, ID_RECENT_0 + i, lens_recent_label_slot(i));
            i = i + 1;
        }
    }
    gui_menu_sep(menu);
    lens_menu_item(menu, ID_LOAD_BROWSE, mi_browse_chats);
    lens_menu_item(menu, ID_CHAT_OPEN_DIR, mi_open_chats);
    gui_menu_sep(menu);
    lens_menu_item(menu, ID_CHAT_DUPLICATE, mi_duplicate_chat);
    lens_menu_item(menu, ID_BRANCH_CHAT, mi_branch_chat);
    lens_menu_item(menu, ID_CHAT_RENAME, mi_rename_chat);
    lens_menu_item(menu, ID_CHAT_DELETE, mi_delete_chat);
    lens_menu_dark(menu);
    return count;
}

func lens_recent_load(id: i64) -> i64 {
    idx = id - ID_RECENT_0;
    if idx < 0 { return 0; }
    if idx >= load64(g_recent_count) { return 0; }
    return lens_chat_load_path(lens_recent_path_slot(idx));
}

func lens_chat_load_menu() -> i64 {
    if load64(g_busy) != 0 { lens_set_status(st_busy); return 0; }
    lens_recent_menu_build();
    gui_menu_drop(load64(g_hwnd), load64(g_btn_load), load64(g_load_menu), g_rect);
    return 0;
}

func lens_chat_open_folder() -> i64 {
    ShellExecuteA(load64(g_hwnd), op_open, g_chatdir, 0, 0, 1);
    return 1;
}

func lens_chat_duplicate_current() -> i64 {
    if load64(g_busy) != 0 { lens_set_status(st_busy); return 0; }
    if lens_file_exists(g_chatpath) == 0 { lens_set_status(st_chat_no_file); return 0; }
    gui_get_text(load64(g_chatname_ed), g_chat_name, 160);
    lens_chat_make_path(g_exportpath, g_chat_name, chat_copy_suffix);
    if CopyFileA(g_chatpath, g_exportpath, 1) == 0 { lens_set_status(st_chat_duplicate_fail); return 0; }
    lens_chat_load_path(g_exportpath);
    lens_set_status(st_chat_duplicated);
    return 1;
}

func lens_chat_branch_current() -> i64 {
    if load64(g_busy) != 0 { lens_set_status(st_busy); return 0; }
    if lens_file_exists(g_chatpath) == 0 { lens_set_status(st_chat_no_file); return 0; }
    gui_get_text(load64(g_chatname_ed), g_chat_name, 160);
    lens_chat_make_path(g_exportpath, g_chat_name, 0);
    if strcmp(g_chatpath, g_exportpath) == 0 { lens_set_status(st_branch_name); return 0; }
    if lens_file_exists(g_exportpath) == 1 { lens_set_status(st_branch_exists); return 0; }
    if lens_chat_write_current(g_exportpath) == 0 { return 0; }
    lens_set_status(st_branch_created);
    return 1;
}

func lens_chat_rename_current() -> i64 {
    if load64(g_busy) != 0 { lens_set_status(st_busy); return 0; }
    if lens_file_exists(g_chatpath) == 0 { lens_set_status(st_chat_no_file); return 0; }
    gui_get_text(load64(g_chatname_ed), g_chat_name, 160);
    lens_chat_make_path(g_exportpath, g_chat_name, 0);
    if strcmp(g_chatpath, g_exportpath) == 0 { lens_set_status(st_chat_renamed); return 1; }
    if MoveFileA(g_chatpath, g_exportpath) == 0 { lens_set_status(st_chat_rename_fail); return 0; }
    lens_chat_load_path(g_exportpath);
    lens_set_status(st_chat_renamed);
    return 1;
}

func lens_chat_delete_current() -> i64 {
    if load64(g_busy) != 0 { lens_set_status(st_busy); return 0; }
    if lens_file_exists(g_chatpath) == 0 { lens_set_status(st_chat_no_file); return 0; }
    p = str_copy(g_delete_msg, chat_del_msg_a);
    p = str_copy(p, g_chatpath);
    str_copy(p, chat_del_msg_b);
    if MessageBoxA(load64(g_hwnd), g_delete_msg, chat_del_title, 0x24) != 6 { return 0; }
    if DeleteFileA(g_chatpath) == 0 { lens_set_status(st_chat_delete_fail); return 0; }
    lens_chat_new();
    str_copy(g_chat_name, default_chat);
    SetWindowTextA(load64(g_chatname_ed), g_chat_name);
    lens_chat_make_path(g_chatpath, g_chat_name, 0);
    lens_config_save();
    lens_set_status(st_chat_deleted);
    return 1;
}

func lens_chat_new() -> i64 {
    store64(g_help_visible, 0);
    store64(g_edit_pending, 0);
    store8(load64(g_transcript_p), 0);
    store64(g_has_image, 0);
    store64(g_has_file, 0);
    store64(g_dual_vision_used, 0);
    store64(g_aether_vision_sent, 0);
    store64(g_aether_vision_route, 0);
    store64(g_img_bytes, 0);
    store64(g_file_bytes, 0);
    store64(g_file_kind, 0);
    store8(g_file_name, 0);
    store8(load64(g_file_text_p), 0);
    store8(g_vision_model, 0);
    store8(load64(g_vision_notes_p), 0);
    lens_preview_clear();
    lens_clear_runtime_info();
    lens_refresh_attachment_ui();
    GetClientRect(load64(g_hwnd), g_rect);
    lens_layout(load32(g_rect + 8), load32(g_rect + 12));
    lens_refresh_transcript();
    lens_set_status(st_ready);
    return 0;
}

func lens_export_markdown() -> i64 {
    memset(g_ofn, 0, 152);
    store32(g_ofn + 0, 152);
    store64(g_ofn + 8, load64(g_hwnd));
    store64(g_ofn + 24, g_md_filter);
    store32(g_ofn + 44, 1);
    store64(g_ofn + 48, g_exportpath);
    store32(g_ofn + 56, 900);
    store64(g_ofn + 88, save_title);
    store32(g_ofn + 96, 0x1806);
    store64(g_ofn + 104, md_ext + 1);
    store8(g_exportpath, 0);
    if GetSaveFileNameA(g_ofn) == 0 { return 0; }
    p = str_copy(load64(g_filebuf_p), export_hdr);
    p = str_copy(p, load64(g_transcript_p));
    store8(p, 0);
    lens_write_file(g_exportpath, load64(g_filebuf_p), strlen(load64(g_filebuf_p)));
    lens_set_status(st_exported);
    return 1;
}

func lens_copy_transcript() -> i64 {
    gui_clip_write_text(load64(g_hwnd), load64(g_transcript_p), strlen(load64(g_transcript_p)));
    lens_set_status(st_copied);
    return 1;
}

func lens_copy_span(dst: i64, src: i64, first: i64, last: i64, cap: i64) -> i64 {
    n = last - first;
    if n < 0 { n = 0; }
    if n > cap - 1 { n = cap - 1; }
    if n > 0 { memcpy(dst, src + first, n); }
    store8(dst + n, 0);
    return n;
}

func lens_range_contains(src: i64, first: i64, last: i64, ndl: i64) -> i64 {
    return lco_range_contains(src, first, last, ndl);
}

func lens_find_last_user() -> i64 {
    src = load64(g_transcript_p);
    last_start = lco_last_user_start(src);
    if last_start < 0 { return 0; }
    last_content = last_start + strlen(line_user);
    last_end = lco_user_end(src, last_start);
    store64(g_last_user_start, last_start);
    store64(g_last_user_content, last_content);
    store64(g_last_user_end, last_end);
    lens_copy_span(g_user_msg, src, last_content, last_end, 65536);
    return 1;
}

func lens_find_last_answer_start() -> i64 {
    src = load64(g_transcript_p);
    last = lco_last_answer_start(src);
    if last < 0 { return 0; }
    store64(g_last_answer_start, last);
    return 1;
}

func lens_last_turn_used_attachment() -> i64 {
    if lens_find_last_user() == 0 { return 0; }
    src = load64(g_transcript_p);
    first = load64(g_last_user_end);
    last = strlen(src);
    if lens_range_contains(src, first, last, sent_img_a) == 1 { return 1; }
    if lens_range_contains(src, first, last, sent_file_a) == 1 { return 1; }
    if lens_range_contains(src, first, last, sent_folder_a) == 1 { return 1; }
    return 0;
}

func lens_edit_last_user() -> i64 {
    if load64(g_busy) != 0 { lens_set_status(st_busy); return 0; }
    if load64(g_edit_pending) == 1 { lens_set_status(st_edit_active); return 0; }
    if rich_get_text_length(load64(g_input_ed)) > 0 { lens_set_status(st_composer_used); return 0; }
    if lens_find_last_user() == 0 { lens_set_status(st_no_user); return 0; }
    store64(g_edit_pending, 1);
    store64(g_edit_pos, load64(g_last_user_start));
    SetWindowTextA(load64(g_input_ed), g_user_msg);
    SetFocus(load64(g_input_ed));
    lens_set_status(st_edit_ready);
    return 1;
}

func lens_cancel_staged_edit() -> i64 {
    if load64(g_edit_pending) == 0 { lens_set_status(st_no_edit); return 0; }
    store64(g_edit_pending, 0);
    lens_set_status(st_edit_cancelled);
    return 1;
}

func lens_regenerate_last_answer() -> i64 {
    if load64(g_busy) != 0 { lens_set_status(st_busy); return 0; }
    if load64(g_edit_pending) == 1 { lens_set_status(st_edit_active); return 0; }
    if rich_get_text_length(load64(g_input_ed)) > 0 { lens_set_status(st_composer_used); return 0; }
    if lens_find_last_answer_start() == 0 { lens_set_status(st_no_answer); return 0; }
    if lens_last_turn_used_attachment() == 1 { lens_set_status(st_regen_attach); return 0; }
    store64(g_edit_pending, 1);
    store64(g_edit_pos, load64(g_last_user_start));
    SetWindowTextA(load64(g_input_ed), g_user_msg);
    return lens_send_chat();
}

func lens_continue_last_answer() -> i64 {
    if load64(g_busy) != 0 { lens_set_status(st_busy); return 0; }
    if load64(g_edit_pending) == 1 { lens_set_status(st_edit_active); return 0; }
    if rich_get_text_length(load64(g_input_ed)) > 0 { lens_set_status(st_composer_used); return 0; }
    if lens_find_last_answer_start() == 0 { lens_set_status(st_no_answer); return 0; }
    SetWindowTextA(load64(g_input_ed), continue_prompt);
    lens_set_status(st_continue_ready);
    return lens_send_chat();
}

func lens_delete_last_answer() -> i64 {
    if load64(g_busy) != 0 { lens_set_status(st_busy); return 0; }
    if lens_find_last_answer_start() == 0 { lens_set_status(st_no_answer); return 0; }
    if MessageBoxA(load64(g_hwnd), delete_answer_msg, delete_answer_title, 0x24) != 6 { return 0; }
    store8(load64(g_transcript_p) + load64(g_last_answer_start), 0);
    store64(g_edit_pending, 0);
    lens_clear_runtime_info();
    lens_refresh_transcript();
    lens_set_status(st_answer_deleted);
    return 1;
}

func lens_copy_last_user() -> i64 {
    if lens_find_last_user() == 0 { lens_set_status(st_no_user); return 0; }
