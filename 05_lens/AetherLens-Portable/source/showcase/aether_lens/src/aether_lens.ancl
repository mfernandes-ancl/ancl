    p = str_copy(g_exportpath, g_rootdir);
    str_copy(p, answer_md_suffix);
    if gui_save_file_dialog(g_ofn, load64(g_hwnd), g_md_filter, g_exportpath, 900, g_rootdir, save_answer_title, md_ext + 1, 0x1806) == 0 { return 0; }
    lens_write_file(g_exportpath, load64(g_code_p), strlen(load64(g_code_p)));
    lens_set_status(st_answer_saved);
    return 1;
}

func lens_copy_last_metadata() -> i64 {
    if load8(g_runtime_text) == 0 { lens_set_status(st_no_metadata); return 0; }
    gui_clip_write_text(load64(g_hwnd), g_runtime_text, strlen(g_runtime_text));
    lens_set_status(st_metadata_copied);
    return 1;
}

func lens_extract_code_range(src: i64, start: i64, end: i64) -> i64 {
    i = start;
    open = 0 - 1;
    content = 0;
    found = 0;
    while i < end {
        line_start = i;
        le = i;
        while le < end { c = load8(src + le); if c == 13 { break; } if c == 10 { break; } le = le + 1; }
        next = le;
        if next < end { if load8(src + next) == 13 { next = next + 1; } }
        if next < end { if load8(src + next) == 10 { next = next + 1; } }
        fence = 0;
        if le - line_start >= 3 {
            if load8(src + line_start) == 96 { if load8(src + line_start + 1) == 96 { if load8(src + line_start + 2) == 96 { fence = 1; } } }
        }
        if fence == 1 {
            if open < 0 {
                open = line_start;
                content = next;
                ls = line_start + 3;
                while ls < le { if load8(src + ls) != 32 { break; } ls = ls + 1; }
                lens_copy_span(g_code_lang, src, ls, le, 32);
            } else {
                finish = line_start;
                while finish > content {
                    c = load8(src + finish - 1);
                    if c != 13 { if c != 10 { break; } }
                    finish = finish - 1;
                }
                lens_copy_span(load64(g_code_p), src, content, finish, 262144);
                found = 1;
                open = 0 - 1;
            }
        }
        i = next;
    }
    return found;
}

func lens_extract_last_code() -> i64 {
    src = load64(g_transcript_p);
    found = 0;
    i = 0;
    while load8(src + i) != 0 {
        role = lens_display_role_at(src, i);
        if role != 0 {
            next = lens_display_next_turn(src, i + 1);
            if role == 2 { if lens_extract_code_range(src, i + strlen(line_ai), next) == 1 { found = 1; } }
            i = next;
        } else { i = i + 1; }
    }
    return found;
}

func lens_extract_last_answer() -> i64 {
    src = load64(g_transcript_p);
    last_start = 0 - 1;
    last_end = 0;
    i = 0;
    while load8(src + i) != 0 {
        role = lens_display_role_at(src, i);
        if role != 0 {
            next = lens_display_next_turn(src, i + 1);
            if role == 2 { last_start = i + strlen(line_ai); last_end = next; }
            i = next;
        } else { i = i + 1; }
    }
    if last_start < 0 { return 0; }
    while last_end > last_start {
        c = load8(src + last_end - 1);
        if c != 13 { if c != 10 { break; } }
        last_end = last_end - 1;
    }
    lens_copy_span(load64(g_code_p), src, last_start, last_end, 262144);
    return 1;
}

func lens_code_extension() -> i64 {
    if lens_starts_with_ci(g_code_lang, "ancl") == 1 { return ".ancl"; }
    if lens_starts_with_ci(g_code_lang, "markdown") == 1 { return ".md"; }
    if strcmp(g_code_lang, "md") == 0 { return ".md"; }
    if lens_starts_with_ci(g_code_lang, "python") == 1 { return ".py"; }
    if strcmp(g_code_lang, "py") == 0 { return ".py"; }
    if lens_starts_with_ci(g_code_lang, "javascript") == 1 { return ".js"; }
    if strcmp(g_code_lang, "js") == 0 { return ".js"; }
    if lens_starts_with_ci(g_code_lang, "typescript") == 1 { return ".ts"; }
    if strcmp(g_code_lang, "json") == 0 { return ".json"; }
    if strcmp(g_code_lang, "html") == 0 { return ".html"; }
    if strcmp(g_code_lang, "css") == 0 { return ".css"; }
    if strcmp(g_code_lang, "sql") == 0 { return ".sql"; }
    if strcmp(g_code_lang, "powershell") == 0 { return ".ps1"; }
    if strcmp(g_code_lang, "bash") == 0 { return ".sh"; }
    if strcmp(g_code_lang, "sh") == 0 { return ".sh"; }
    if strcmp(g_code_lang, "cpp") == 0 { return ".cpp"; }
    if strcmp(g_code_lang, "c") == 0 { return ".c"; }
    if strcmp(g_code_lang, "rust") == 0 { return ".rs"; }
    if strcmp(g_code_lang, "go") == 0 { return ".go"; }
    return ".txt";
}

func lens_copy_last_code() -> i64 {
    if lens_extract_last_code() == 0 { lens_set_status(st_no_code); return 0; }
    gui_clip_write_text(load64(g_hwnd), load64(g_code_p), strlen(load64(g_code_p)));
    lens_set_status(st_code_copied);
    return 1;
}

func lens_save_last_code() -> i64 {
    if lens_extract_last_code() == 0 { lens_set_status(st_no_code); return 0; }
    ext = lens_code_extension();
    p = str_copy(g_exportpath, g_rootdir);
    p = str_copy(p, "\\answer-code");
    str_copy(p, ext);
    if gui_save_file_dialog(g_ofn, load64(g_hwnd), g_text_filter, g_exportpath, 900, g_rootdir, save_code_title, ext + 1, 0x1806) == 0 { return 0; }
    lens_write_file(g_exportpath, load64(g_code_p), strlen(load64(g_code_p)));
    lens_set_status(st_code_saved);
    return 1;
}

func lens_artifact_language_ok() -> i64 {
    if strcmp(g_code_lang, "html") == 0 { return 1; }
    if strcmp(g_code_lang, "htm") == 0 { return 1; }
    if strcmp(g_code_lang, "svg") == 0 { return 1; }
    return 0;
}

func lens_artifact_make_paths() -> i64 {
    p = str_copy(g_artifact_dir, g_chatdir);
    str_copy(p, artifact_dir_suffix);
    if CreateDirectoryA(g_artifact_dir, 0) == 0 {
        if GetFileAttributesA(g_artifact_dir) == 0xFFFFFFFF { return 0; }
    }
    int_to_str(g_size_tmp, GetTickCount());
    p = str_copy(g_artifact_content_name, artifact_content_prefix);
    p = str_copy(p, g_size_tmp);
    str_copy(p, artifact_ext);
    p = str_copy(g_artifact_preview_name, artifact_preview_prefix);
    p = str_copy(p, g_size_tmp);
    str_copy(p, artifact_ext);
    lens_path_join2(g_artifact_content_path, g_artifact_dir, g_artifact_content_name);
    lens_path_join2(g_artifact_preview_path, g_artifact_dir, g_artifact_preview_name);
    return 1;
}

func lens_preview_artifact_content(content: i64) -> i64 {
    if las_artifact_safe(content) == 0 { lens_set_status(st_artifact_blocked); return 0; }
    if lens_artifact_make_paths() == 0 { lens_set_status(st_artifact_write); return 0; }

    p = str_copy(load64(g_filebuf_p), artifact_content_a);
    p = str_copy(p, content);
    str_copy(p, artifact_content_z);
    if lens_write_file(g_artifact_content_path, load64(g_filebuf_p), strlen(load64(g_filebuf_p))) == 0 {
        lens_set_status(st_artifact_write);
        return 0;
    }

    p = str_copy(load64(g_filebuf_p), artifact_wrapper_a);
    p = str_copy(p, g_artifact_content_name);
    str_copy(p, artifact_wrapper_z);
    if lens_write_file(g_artifact_preview_path, load64(g_filebuf_p), strlen(load64(g_filebuf_p))) == 0 {
        DeleteFileA(g_artifact_content_path);
        lens_set_status(st_artifact_write);
        return 0;
    }
    rv = ShellExecuteA(load64(g_hwnd), op_open, g_artifact_preview_path, 0, 0, 5);
    if rv <= 32 { lens_set_status(st_artifact_write); return 0; }
    lens_set_status(st_artifact_open);
    return 1;
}

func lens_preview_last_artifact() -> i64 {
    if lens_extract_last_code() == 0 { lens_set_status(st_no_code); return 0; }
    if lens_artifact_language_ok() == 0 { lens_set_status(st_artifact_type); return 0; }
    return lens_preview_artifact_content(load64(g_code_p));
}

