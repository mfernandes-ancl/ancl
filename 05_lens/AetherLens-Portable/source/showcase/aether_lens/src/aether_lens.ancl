    if load64(g_web_text_p) != 0 { free(load64(g_web_text_p)); }
    if load64(g_search_raw_p) != 0 { free(load64(g_search_raw_p)); }
    if load64(g_search_text_p) != 0 { free(load64(g_search_text_p)); }
    if load64(g_voice_data_p) != 0 { free(load64(g_voice_data_p)); }
    if load64(g_img_raw_p) != 0 { free(load64(g_img_raw_p)); }
    if load64(g_img_b64_p) != 0 { free(load64(g_img_b64_p)); }
    return 0;
}

func lens_round(hwnd: i64, w: i64, h: i64, r: i64) -> i64 {
    if hwnd == 0 { return 0; }
    SetWindowRgn(hwnd, CreateRoundRectRgn(0, 0, w + 1, h + 1, r, r), 1);
    return 0;
}

func lens_a2w(dst: i64, src: i64) -> i64 {
    i = 0;
    while 1 {
        c = load8(src + i);
        store8(dst + i * 2, c);
        store8(dst + i * 2 + 1, 0);
        if c == 0 { return 0; }
        i = i + 1;
    }
    return 0;
}

func lens_enable_dark_app() -> i64 {
    if load64(g_dark_done) == 1 { return 0; }
    store64(g_dark_done, 1);
    lens_a2w(g_dm_explorer_w, dm_explorer);
    lens_a2w(g_dm_cfd_w, dm_cfd);
    hm = LoadLibraryA(dm_uxtheme);
    if hm != 0 {
        fn = GetProcAddress(hm, 135);
        if fn != 0 { callp(fn, 2); }
        store64(g_allowdark, GetProcAddress(hm, 133));
    }
    return 0;
}

func lens_allow_dark(hwnd: i64) -> i64 {
    ad = load64(g_allowdark);
    if ad != 0 { callp(ad, hwnd, 1); }
    return 0;
}

func lens_dark_scroll(hwnd: i64) -> i64 {
    if hwnd == 0 { return 0; }
    lens_allow_dark(hwnd);
    SetWindowTheme(hwnd, g_dm_explorer_w, 0);
    return 0;
}

func lens_dark_combo(hwnd: i64) -> i64 {
    if hwnd == 0 { return 0; }
    lens_allow_dark(hwnd);
    SetWindowTheme(hwnd, g_dm_cfd_w, 0);
    SendMessageA(hwnd, 0x031A, 0, 0);
    return 0;
}

func lens_draw_combo_arrow(hdc: i64, ax: i64, ay: i64) -> i64 {
    old = SelectObject(hdc, load64(g_pen_combo_arrow));
    MoveToEx(hdc, ax - 4, ay - 2, 0); LineTo(hdc, ax + 5, ay - 2);
    MoveToEx(hdc, ax - 3, ay - 1, 0); LineTo(hdc, ax + 4, ay - 1);
    MoveToEx(hdc, ax - 2, ay, 0); LineTo(hdc, ax + 3, ay);
    MoveToEx(hdc, ax - 1, ay + 1, 0); LineTo(hdc, ax + 2, ay + 1);
    MoveToEx(hdc, ax, ay + 2, 0); LineTo(hdc, ax + 1, ay + 2);
    SelectObject(hdc, old);
    return 0;
}

func LensArenaComboProc(hwnd: i64, msg: i64, wp: i64, lp: i64) -> i64 {
    if msg == 15 {
        hdc = BeginPaint(hwnd, g_arena_combo_ps);
        GetClientRect(hwnd, g_arena_combo_rc);
        l = load32(g_arena_combo_rc + 0); t = load32(g_arena_combo_rc + 4);
        r = load32(g_arena_combo_rc + 8); b = load32(g_arena_combo_rc + 12);
        FillRect(hdc, g_arena_combo_rc, load64(g_br_edit));
        ob = SelectObject(hdc, GetStockObject(5));
        op = SelectObject(hdc, load64(g_pen_line));
        Rectangle(hdc, l, t, r, b);
        SelectObject(hdc, op); SelectObject(hdc, ob);
        of = SelectObject(hdc, load64(g_font_ui));
        SetTextColor(hdc, COLOR_TEXT); SetBkMode(hdc, 1);
        sel = SendMessageA(hwnd, 327, 0, 0);
        if sel >= 0 {
            SendMessageA(hwnd, 328, sel, g_arena_combo_text);
            store32(g_arena_combo_rc + 0, l + 8); store32(g_arena_combo_rc + 4, t + 1);
            store32(g_arena_combo_rc + 8, r - 22); store32(g_arena_combo_rc + 12, b - 1);
            DrawTextA(hdc, g_arena_combo_text, 0 - 1, g_arena_combo_rc, 0x8024);
        }
        lens_draw_combo_arrow(hdc, r - 13, shr(t + b, 1));
        SelectObject(hdc, of);
        EndPaint(hwnd, g_arena_combo_ps);
        return 0;
    }
    if msg == 20 { return 1; }
    if msg == 7 { res = CallWindowProcA(load64(g_arena_combo_old_proc), hwnd, msg, wp, lp); InvalidateRect(hwnd, 0, 1); return res; }
    if msg == 8 { res = CallWindowProcA(load64(g_arena_combo_old_proc), hwnd, msg, wp, lp); InvalidateRect(hwnd, 0, 1); return res; }
    if msg == 10 { res = CallWindowProcA(load64(g_arena_combo_old_proc), hwnd, msg, wp, lp); InvalidateRect(hwnd, 0, 1); return res; }
    return CallWindowProcA(load64(g_arena_combo_old_proc), hwnd, msg, wp, lp);
}

func lens_arena_combo_subclass(hwnd: i64) -> i64 {
    lens_dark_combo(hwnd);
    old = SetWindowLongPtrA(hwnd, 0 - 4, &LensArenaComboProc);
    if load64(g_arena_combo_old_proc) == 0 { store64(g_arena_combo_old_proc, old); }
    return 0;
}

func LensArenaPromptProc(hwnd: i64, msg: i64, wp: i64, lp: i64) -> i64 {
    if msg == 15 {
        res = CallWindowProcA(load64(g_arena_prompt_old_proc), hwnd, msg, wp, lp);
        hdc = GetDC(hwnd);
        GetClientRect(hwnd, g_arena_prompt_rc);
        r = load32(g_arena_prompt_rc + 8); b = load32(g_arena_prompt_rc + 12);
        ob = SelectObject(hdc, GetStockObject(5)); op = SelectObject(hdc, load64(g_pen_line));
        Rectangle(hdc, 0, 0, r, b); SelectObject(hdc, op); SelectObject(hdc, ob);
        if SendMessageA(hwnd, 14, 0, 0) == 0 {
            store32(g_arena_prompt_rc + 0, 10); store32(g_arena_prompt_rc + 4, 3);
            store32(g_arena_prompt_rc + 8, r - 22); store32(g_arena_prompt_rc + 12, b - 3);
            of = SelectObject(hdc, load64(g_font_mono));
            SetTextColor(hdc, COLOR_MUTED); SetBkMode(hdc, 1);
            DrawTextA(hdc, arena_prompt_hint, 0 - 1, g_arena_prompt_rc, 0x8024);
            SelectObject(hdc, of);
        }
        ReleaseDC(hwnd, hdc);
        return res;
    }
    if msg == 7 { res = CallWindowProcA(load64(g_arena_prompt_old_proc), hwnd, msg, wp, lp); InvalidateRect(hwnd, 0, 1); return res; }
    if msg == 8 { res = CallWindowProcA(load64(g_arena_prompt_old_proc), hwnd, msg, wp, lp); InvalidateRect(hwnd, 0, 1); return res; }
    if msg == 12 { res = CallWindowProcA(load64(g_arena_prompt_old_proc), hwnd, msg, wp, lp); InvalidateRect(hwnd, 0, 1); return res; }
    if msg == 258 { res = CallWindowProcA(load64(g_arena_prompt_old_proc), hwnd, msg, wp, lp); InvalidateRect(hwnd, 0, 1); return res; }
    return CallWindowProcA(load64(g_arena_prompt_old_proc), hwnd, msg, wp, lp);
}

func lens_arena_prompt_subclass(hwnd: i64) -> i64 {
    old = SetWindowLongPtrA(hwnd, 0 - 4, &LensArenaPromptProc);
    if load64(g_arena_prompt_old_proc) == 0 { store64(g_arena_prompt_old_proc, old); }
    return 0;
}

func lens_menu_dark(menu: i64) -> i64 {
    memset(g_menu_info, 0, 40);
    store32(g_menu_info + 0, 40);
    store32(g_menu_info + 4, 0x2);
    store64(g_menu_info + 16, load64(g_br_card));
    SetMenuInfo(menu, g_menu_info);
    return 0;
}

func lens_menu_item(menu: i64, id: i64, label: i64) -> i64 {
    AppendMenuA(menu, 0x100, id, label);
    return 0;
}

func lens_menu_popup(menu: i64, popup: i64, label: i64) -> i64 {
    AppendMenuA(menu, 0x110, popup, label);
    return 0;
}

func lens_engine_menu_sync() -> i64 {
    menu = load64(g_engine_menu);
    id = ID_ENG_HW_GPU;
    while id <= ID_ENG_TIME_ON {
        CheckMenuItem(menu, id, 0);
        id = id + 1;
    }
    CheckMenuItem(menu, ID_ENG_REASON_DIRECT, 0);
    CheckMenuItem(menu, ID_ENG_REASON_THINK, 0);

    sel = ID_ENG_HW_GPU;
    if load64(g_aether_hw) == 1 { sel = ID_ENG_HW_FINAL; }
    if load64(g_aether_hw) == 2 { sel = ID_ENG_HW_CPU; }
    CheckMenuItem(menu, sel, 8);
    sel = ID_ENG_OUT_ALL;
    if load64(g_aether_restrict) == 1 { sel = ID_ENG_OUT_ASCII; }
    if load64(g_aether_restrict) == 2 { sel = ID_ENG_OUT_DIGITS; }
    CheckMenuItem(menu, sel, 8);
    sel = ID_ENG_STYLE_PRECISE;
    if load64(g_aether_style) == 1 { sel = ID_ENG_STYLE_BALANCED; }
    if load64(g_aether_style) == 2 { sel = ID_ENG_STYLE_CREATIVE; }
    CheckMenuItem(menu, sel, 8);
    if load64(g_aether_reasoning) == 1 { CheckMenuItem(menu, ID_ENG_REASON_THINK, 8); }
    else { CheckMenuItem(menu, ID_ENG_REASON_DIRECT, 8); }
    sel = ID_ENG_LEN_128;
    if load64(g_aether_max) == 64 { sel = ID_ENG_LEN_64; }
    if load64(g_aether_max) == 256 { sel = ID_ENG_LEN_256; }
    if load64(g_aether_max) == 512 { sel = ID_ENG_LEN_512; }
    CheckMenuItem(menu, sel, 8);
    if load64(g_aether_spec) == 1 { CheckMenuItem(menu, ID_ENG_SPEC_ON, 8); }
    else { CheckMenuItem(menu, ID_ENG_SPEC_OFF, 8); }
    if load64(g_aether_time) == 1 { CheckMenuItem(menu, ID_ENG_TIME_ON, 8); }
    else { CheckMenuItem(menu, ID_ENG_TIME_OFF, 8); }
    return 1;
}

func lens_button(parent: i64, hinst: i64, id: i64, text: i64, x: i64, y: i64, w: i64, h: i64) -> i64 {
    return CreateWindowExA(0, gui_button, text, 0x5000000B, x, y, w, h, parent, id, hinst, 0);
}

func lens_backend_label() -> i64 {
    b = load64(g_backend_display);
    if b == 1 { if load64(g_cloud_provider) == 1 { return it_huggingface; } return it_openai; }
    if b == 2 { return it_anthropic; }
    if b == 3 { return it_aether; }
    return it_ollama;
}

func lens_preset_label() -> i64 {
    p = load64(g_preset);
    if p == 1 { return pr_ancl; }
    if p == 2 { return pr_industrial; }
    if p == 3 { return pr_auto; }
    return pr_general;
}

func lens_button_label(id: i64) -> i64 {
    if id == ID_BACKEND { return lens_backend_label(); }
    if id == ID_PRESET { return lens_preset_label(); }
    if id == ID_REFRESH { return btn_refresh; }
    if id == ID_USE { return btn_use; }
    if id == ID_CATALOG {
        if load64(g_backend_display) == 3 { return btn_engine; }
        return btn_catalog;
    }
    if id == ID_INFO { return btn_info; }
    if id == ID_PRIVACY { return btn_privacy; }
    if id == ID_ARENA { return btn_arena; }
    if id == ID_VOICE { if load64(g_voice_state) == 1 { return btn_voice_rec; } return btn_voice; }
    if id == ID_PULL { return btn_pull; }
    if id == ID_DELETE {
        if load64(g_backend_display) == 3 { return btn_catalog; }
        return btn_delete;
    }
    if id == ID_SEND { return btn_send; }
    if id == ID_STOP { return btn_stop; }
    if id == ID_ATTACH { return btn_attach; }
    if id == ID_NEW { return btn_new; }
    if id == ID_SAVE { return btn_save; }
    if id == ID_SAVE_AS { return btn_save_as; }
    if id == ID_LOAD { return btn_load; }
    if id == ID_EXPORT { return btn_export; }
    if id == ID_COPY { return btn_copy; }
    if id == ID_HELP { return btn_help; }
    if id == ID_ARENA_VOTE_LEFT { return arena_vote_left; }
    if id == ID_ARENA_VOTE_TIE { return arena_vote_tie; }
    if id == ID_ARENA_VOTE_RIGHT { return arena_vote_right; }
    if id == ID_ARENA_COPY_LEFT { return arena_copy_left; }
    if id == ID_ARENA_COPY_RIGHT { return arena_copy_right; }
    if id == ID_ARENA_RUN { return arena_run; }
    if id == ID_ARENA_OPTIONS { return arena_options; }
    if id == ID_ARENA_CLOSE { return arena_close; }
    if id == ID_VOICE_REVIEW_INSERT { return voice_review_insert; }
    if id == ID_VOICE_REVIEW_COPY { return voice_review_copy; }
    if id == ID_VOICE_REVIEW_PLAY { return voice_review_play; }
    if id == ID_VOICE_REVIEW_AGAIN { return voice_review_again; }
    if id == ID_VOICE_REVIEW_CLOSE { return voice_review_close; }
    if id == ID_CANVAS_SAVE { return canvas_save; }
    if id == ID_CANVAS_SAVE_AS { return canvas_save_as; }
    if id == ID_CANVAS_COPY { return canvas_copy; }
    if id == ID_CANVAS_PREVIEW {
        if load64(g_canvas_kind) == 3 { return canvas_validate_csv; }
        if load64(g_canvas_kind) != 0 { return canvas_safe_preview; }
        if load64(g_canvas_preview_mode) == 1 { return canvas_edit; }
        return canvas_preview;
    }
    if id == ID_CANVAS_CLOSE { return canvas_close; }
    if id == ID_CALC_EVALUATE { return calc_evaluate; }
    if id == ID_CALC_COPY { return calc_copy; }
    if id == ID_CALC_INSERT { return calc_insert; }
    if id == ID_CALC_CLOSE { return calc_close; }
    if id == ID_CONV_CONVERT { return conv_convert; }
    if id == ID_CONV_COPY { return conv_copy; }
    if id == ID_CONV_INSERT { return conv_insert; }
    if id == ID_WEB_FETCH { if load64(g_busy_kind) == 7 { return web_fetching; } return web_fetch; }
    if id == ID_WEB_COPY { return web_copy; }
    if id == ID_WEB_INSERT { return web_insert; }
    if id == ID_WEB_CLOSE { return web_close; }
    if id == ID_SEARCH_GO { if load64(g_busy_kind) == 8 { return search_searching; } return search_go; }
    if id == ID_SEARCH_COPY { return search_copy; }
    if id == ID_SEARCH_INSERT { return search_insert; }
    if id == ID_SEARCH_CLOSE { return search_close; }
    return btn_copy;
}

func lens_draw_attachment(lp: i64) -> i64 {
    hdc = load64(lp + 32);
    rc = lp + 40;
    l = load32(rc + 0);
    t = load32(rc + 4);
    r = load32(rc + 8);
    b = load32(rc + 12);
    FillRect(hdc, rc, load64(g_br_panel));
    SetBkMode(hdc, 1);
    of = SelectObject(hdc, load64(g_font_ui));
    if load64(g_has_image) == 0 {
        if load64(g_has_file) == 1 {
            ob0 = SelectObject(hdc, load64(g_br_edit));
            op0 = SelectObject(hdc, load64(g_pen_line));
            RoundRect(hdc, l, t, r, b, 7, 7);
            SelectObject(hdc, op0);
            SelectObject(hdc, ob0);

            ob0 = SelectObject(hdc, load64(g_br_card));
            op0 = SelectObject(hdc, load64(g_pen_line));
            RoundRect(hdc, l + 8, t + 8, l + 66, b - 8, 7, 7);
            SelectObject(hdc, op0);
            SelectObject(hdc, ob0);
            SetTextColor(hdc, COLOR_MUTED);
            gdi_rect_set(g_thumb_rc, l + 8, t + 8, l + 66, b - 8);
            badge = att_file;
            if load64(g_file_kind) == 2 { badge = att_folder; }
            DrawTextA(hdc, badge, 0 - 1, g_thumb_rc, 0x25);
            SetTextColor(hdc, COLOR_TEXT);
            gdi_rect_set(g_thumb_rc, l + 78, t + 11, r - 12, t + 32);
            DrawTextA(hdc, g_attach_text, 0 - 1, g_thumb_rc, 0x8020);
            SetTextColor(hdc, COLOR_MUTED);
            gdi_rect_set(g_thumb_rc, l + 78, t + 35, r - 12, t + 56);
            DrawTextA(hdc, att_hint, 0 - 1, g_thumb_rc, 0x8020);
            SelectObject(hdc, of);
            return 1;
        }
        SetTextColor(hdc, COLOR_TEXT);
        gdi_rect_set(g_thumb_rc, l + 2, t, r - 2, b);
        DrawTextA(hdc, att_none, 0 - 1, g_thumb_rc, 0x24);
        SelectObject(hdc, of);
        return 1;
    }

    ob = SelectObject(hdc, load64(g_br_edit));
    op = SelectObject(hdc, load64(g_pen_line));
    RoundRect(hdc, l, t, r, b, 7, 7);
    SelectObject(hdc, op);
    SelectObject(hdc, ob);

    tx = l + 8;
    ty = t + 8;
    tw = 58;
    th = b - t - 16;
    if th > 52 { th = 52; }
    if th < 34 { th = 34; }

    ob = SelectObject(hdc, load64(g_br_card));
    op = SelectObject(hdc, load64(g_pen_line));
    RoundRect(hdc, tx, ty, tx + tw, ty + th, 7, 7);
    SelectObject(hdc, op);
    SelectObject(hdc, ob);

    hb = load64(g_img_hbm);
    iw = load32(g_img_w);
    ih = load32(g_img_h);
    if hb != 0 {
        if iw > 0 {
            if ih > 0 {
                dw = tw - 8;
                dh = dw * ih / iw;
                if dh > th - 8 {
                    dh = th - 8;
                    dw = dh * iw / ih;
                }
                dx = tx + (tw - dw) / 2;
                dy = ty + (th - dh) / 2;
                mem = CreateCompatibleDC(hdc);
                old = SelectObject(mem, hb);
                SetStretchBltMode(hdc, 3);
                StretchBlt(hdc, dx, dy, dw, dh, mem, 0, 0, iw, ih, 0x00CC0020);
                SelectObject(mem, old);
                DeleteDC(mem);
            }
        }
    } else {
        SetTextColor(hdc, COLOR_MUTED);
        gdi_rect_set(g_thumb_rc, tx, ty, tx + tw, ty + th);
        DrawTextA(hdc, att_img, 0 - 1, g_thumb_rc, 0x25);
    }

    SetTextColor(hdc, COLOR_TEXT);
    gdi_rect_set(g_thumb_rc, l + 78, t + 11, r - 12, t + 32);
    DrawTextA(hdc, g_attach_text, 0 - 1, g_thumb_rc, 0x8020);
    SetTextColor(hdc, COLOR_MUTED);
    gdi_rect_set(g_thumb_rc, l + 78, t + 35, r - 12, t + 56);
    DrawTextA(hdc, att_img_hint, 0 - 1, g_thumb_rc, 0x8020);
    SelectObject(hdc, of);
    return 1;
}

func lens_draw_button(lp: i64) -> i64 {
    id = load32(lp + 4);
    state = load32(lp + 16);
    hdc = load64(lp + 32);
    rc = lp + 40;
    pressed = band(state, 1);
    br = load64(g_br_card);
    pen = load64(g_pen_line);
    tc = COLOR_TEXT;
    if id == ID_SEND {
        br = load64(g_br_accent);
        pen = load64(g_pen_accent);
        tc = COLOR_PANEL;
    }
    if id == ID_ARENA {
        br = load64(g_br_arena);
        pen = load64(g_pen_arena);
        tc = COLOR_PANEL;
    }
    if id == ID_VOICE { if load64(g_voice_state) == 1 { br = load64(g_br_record); pen = load64(g_pen_record); tc = COLOR_TEXT; } }
    if id == ID_ARENA_RUN {
        br = load64(g_br_arena);
        pen = load64(g_pen_arena);
        tc = COLOR_PANEL;
    }
    if id == ID_ARENA_VOTE_LEFT { br = load64(g_br_arena_dark); pen = load64(g_pen_arena); }
    if id == ID_ARENA_VOTE_RIGHT { br = load64(g_br_arena_dark); pen = load64(g_pen_arena); }
    if pressed != 0 {
        br = load64(g_br_edit);
        tc = COLOR_TEXT;
    }
    FillRect(hdc, rc, load64(g_br_panel));
    ob = SelectObject(hdc, br);
    op = SelectObject(hdc, pen);
    RoundRect(hdc, load32(rc + 0), load32(rc + 4), load32(rc + 8), load32(rc + 12), 7, 7);
    SetBkMode(hdc, 1);
    SetTextColor(hdc, tc);
    of = SelectObject(hdc, load64(g_font_ui));
    DrawTextA(hdc, lens_button_label(id), 0 - 1, rc, 0x25);
    SelectObject(hdc, of);
    SelectObject(hdc, ob);
    SelectObject(hdc, op);
    return 1;
}

func lens_measure_menu(lp: i64) -> i64 {
    if load32(lp + 0) != 1 { return 0; }
    lbl = load64(lp + 24);
    w = strlen(lbl) * 7 + 38;
    if w < 128 { w = 128; }
    store32(lp + 12, w);
    store32(lp + 16, 25);
    return 1;
}

func lens_draw_menu(lp: i64) -> i64 {
    if load32(lp + 0) != 1 { return 0; }
    hdc = load64(lp + 32);
    rc = lp + 40;
    selected = band(load32(lp + 16), 1);
    checked = band(load32(lp + 16), 8);
    br = load64(g_br_card);
    tc = COLOR_TEXT;
    if selected != 0 {
        br = load64(g_br_hover);
        tc = COLOR_TEXT;
    }
    FillRect(hdc, rc, br);
    SetBkMode(hdc, 1);
    SetTextColor(hdc, tc);
    of = SelectObject(hdc, load64(g_font_ui));
    l = load32(rc + 0);
    t = load32(rc + 4);
    r = load32(rc + 8);
    b = load32(rc + 12);
    if selected != 0 {
        gdi_fill_xy(hdc, l + 2, t + 5, l + 5, b - 5, load64(g_br_accent));
    }
    if checked != 0 {
        gdi_line(hdc, l + 10, t + 13, l + 13, t + 16, load64(g_pen_accent));
        gdi_line(hdc, l + 13, t + 16, l + 20, t + 8, load64(g_pen_accent));
    }
    gdi_rect_set(g_menu_rc, l + 28, t, r - 12, b);
    DrawTextA(hdc, load64(lp + 56), 0 - 1, g_menu_rc, 0x24);
    submenu = 0;
    if strcmp(load64(lp + 56), mi_canvas_menu) == 0 { submenu = 1; }
    if strcmp(load64(lp + 56), mi_tools_menu) == 0 { submenu = 1; }
    if submenu == 1 {
        gdi_rect_set(g_menu_rc, r - 26, t, r - 8, b);
        DrawTextA(hdc, mi_submenu_arrow, 0 - 1, g_menu_rc, 0x25);
    }
    SelectObject(hdc, of);
    return 1;
}

func lens_image_preview_close() -> i64 {
    if load64(g_preview_hwnd) != 0 {
        DestroyWindow(load64(g_preview_hwnd));
        store64(g_preview_hwnd, 0);
    }
    return 0;
}

func lens_document_preview_close() -> i64 {
    if load64(g_doc_preview_hwnd) != 0 {
        DestroyWindow(load64(g_doc_preview_hwnd));
        store64(g_doc_preview_hwnd, 0);
        store64(g_doc_preview_ed, 0);
    }
    return 0;
}

func lens_canvas_harvest() -> i64 {
    if load64(g_canvas_ed) == 0 { return 0; }
    if load64(g_canvas_preview_mode) == 1 { return 1; }
    gui_get_text(load64(g_canvas_ed), load64(g_canvas_p), 262144);
    return 1;
}

# Place owned utility windows relative to the current Lens/Add position and
# clamp them to the work area of the monitor that currently contains Lens.
func lens_popup_position(w: i64, h: i64) -> i64 {
    GetWindowRect(load64(g_hwnd), g_rect);
    GetWindowRect(load64(g_btn_attach), g_preview_rc);
    store32(g_monitor_info, 40);
    mon = MonitorFromWindow(load64(g_hwnd), 2);
    if mon != 0 { GetMonitorInfoA(mon, g_monitor_info); }
    wl = load32(g_monitor_info + 20);
    wt = load32(g_monitor_info + 24);
    wr = load32(g_monitor_info + 28);
    wb = load32(g_monitor_info + 32);
    if wr <= wl { wl = 0; wt = 0; wr = 1920; wb = 1080; }

    x = load32(g_rect + 8) + 10;
    y = load32(g_preview_rc + 12) - h;
    if x + w > wr { x = load32(g_rect) - w - 10; }
    if x < wl {
        x = load32(g_preview_rc);
        y = load32(g_preview_rc + 4) - h - 10;
    }
    if x + w > wr { x = wr - w; }
    if x < wl { x = wl; }
    if y + h > wb { y = wb - h; }
    if y < wt { y = wt; }
    store32(g_popup_xy, x);
    store32(g_popup_xy + 4, y);
    return 1;
}

func lens_canvas_suffix() -> i64 {
    if load64(g_canvas_kind) == 1 { return canvas_html_suffix; }
    if load64(g_canvas_kind) == 2 { return canvas_svg_suffix; }
    if load64(g_canvas_kind) == 3 { return canvas_csv_suffix; }
    return canvas_md_suffix;
}

func lens_canvas_ext() -> i64 {
    if load64(g_canvas_kind) == 1 { return canvas_html_ext; }
    if load64(g_canvas_kind) == 2 { return canvas_svg_ext; }
    if load64(g_canvas_kind) == 3 { return canvas_csv_ext; }
    return md_ext;
}

func lens_canvas_save_title() -> i64 {
    if load64(g_canvas_kind) == 1 { return save_canvas_html_title; }
    if load64(g_canvas_kind) == 2 { return save_canvas_svg_title; }
    if load64(g_canvas_kind) == 3 { return save_canvas_csv_title; }
    return save_canvas_md_title;
}

func lens_canvas_head() -> i64 {
    if load64(g_canvas_kind) == 1 { return canvas_head_html; }
    if load64(g_canvas_kind) == 2 { return canvas_head_svg; }
    if load64(g_canvas_kind) == 3 { return canvas_head_csv; }
    return canvas_head_md;
}

func lens_canvas_armed_status(kind: i64) -> i64 {
    if kind == 1 { return st_canvas_armed_html; }
    if kind == 2 { return st_canvas_armed_svg; }
    if kind == 3 { return st_canvas_armed_csv; }
    return st_canvas_armed;
}

func lens_canvas_save_as() -> i64 {
    lens_canvas_harvest();
    if load8(g_canvas_path) == 0 {
        p = str_copy(g_canvas_path, g_rootdir);
        str_copy(p, lens_canvas_suffix());
    }
    filter = g_text_filter;
    if load64(g_canvas_kind) == 0 { filter = g_md_filter; }
    ext = lens_canvas_ext();
    if gui_save_file_dialog(g_ofn, load64(g_canvas_hwnd), filter, g_canvas_path, 900, g_rootdir, lens_canvas_save_title(), ext + 1, 0x1806) == 0 { return 0; }
    if lens_write_file(g_canvas_path, load64(g_canvas_p), strlen(load64(g_canvas_p))) == 0 { lens_set_status(st_savefail); return 0; }
    store64(g_canvas_dirty, 0);
    lens_set_status(st_canvas_saved);
    InvalidateRect(load64(g_canvas_hwnd), 0, 1);
    return 1;
}

func lens_canvas_save() -> i64 {
    if load8(g_canvas_path) == 0 { return lens_canvas_save_as(); }
    lens_canvas_harvest();
    if lens_write_file(g_canvas_path, load64(g_canvas_p), strlen(load64(g_canvas_p))) == 0 { lens_set_status(st_savefail); return 0; }
    store64(g_canvas_dirty, 0);
    lens_set_status(st_canvas_saved);
    InvalidateRect(load64(g_canvas_hwnd), 0, 1);
    return 1;
}

func lens_canvas_close() -> i64 {
    hwnd = load64(g_canvas_hwnd);
    if hwnd == 0 { return 1; }
    lens_canvas_harvest();
    if load64(g_canvas_dirty) == 1 {
        rc = MessageBoxA(hwnd, canvas_unsaved_msg, canvas_unsaved_title, 0x23);
        if rc == 2 { return 0; }
        if rc == 6 { if lens_canvas_save() == 0 { return 0; } }
    }
    DestroyWindow(hwnd);
    store64(g_canvas_hwnd, 0);
    store64(g_canvas_ed, 0);
    store64(g_canvas_btn_preview, 0);
    return 1;
}

func lens_canvas_toggle_preview() -> i64 {
    ed = load64(g_canvas_ed);
    if ed == 0 { return 0; }
    if load64(g_canvas_kind) == 3 {
        lens_canvas_harvest();
        if lcd_csv_validate(load64(g_canvas_p), g_canvas_csv_rows, g_canvas_csv_cols) == 0 {
            MessageBoxA(load64(g_canvas_hwnd), canvas_csv_invalid_msg, canvas_csv_invalid_title, 0x30);
            return 0;
        }
        p = str_copy(g_canvas_notice, canvas_csv_valid_a);
        int_to_str(g_tmp, load64(g_canvas_csv_rows)); p = str_copy(p, g_tmp);
        p = str_copy(p, canvas_csv_valid_b);
        int_to_str(g_tmp, load64(g_canvas_csv_cols)); str_copy(p, g_tmp);
        MessageBoxA(load64(g_canvas_hwnd), g_canvas_notice, canvas_csv_valid_title, 0x40);
        return 1;
    }
    if load64(g_canvas_kind) != 0 {
        lens_canvas_harvest();
        if las_artifact_safe(load64(g_canvas_p)) == 0 {
            lens_set_status(st_artifact_blocked);
            MessageBoxA(load64(g_canvas_hwnd), canvas_preview_blocked_msg, canvas_preview_blocked_title, 0x30);
            return 0;
        }
        rc = lens_preview_artifact_content(load64(g_canvas_p));
        if rc == 0 {
            MessageBoxA(load64(g_canvas_hwnd), canvas_preview_failed_msg, canvas_preview_failed_title, 0x30);
        }
        return rc;
    }
    store64(g_canvas_loading, 1);
    if load64(g_canvas_preview_mode) == 0 {
        lens_canvas_harvest();
        SetWindowTextA(ed, load64(g_canvas_p));
        SendMessageA(ed, 0xCF, 1, 0);
        lens_style_markdown(ed, load64(g_canvas_p), 0, strlen(load64(g_canvas_p)), 0);
        store64(g_canvas_preview_mode, 1);
        SetWindowTextA(load64(g_canvas_btn_preview), canvas_edit);
    } else {
        SetWindowTextA(ed, load64(g_canvas_p));
        SendMessageA(ed, 0xCF, 0, 0);
        store64(g_canvas_preview_mode, 0);
        SetWindowTextA(load64(g_canvas_btn_preview), canvas_preview);
    }
    InvalidateRect(load64(g_canvas_btn_preview), 0, 1);
    UpdateWindow(load64(g_canvas_btn_preview));
    store64(g_canvas_loading, 0);
    return 1;
}

func lens_canvas_open_last_answer_kind(kind: i64) -> i64 {
    if lens_extract_last_answer() == 0 { lens_set_status(st_no_answer); return 0; }
    if strlen(load64(g_code_p)) >= 262143 { lens_set_status(st_canvas_too_big); return 0; }
    if lens_canvas_close() == 0 { return 0; }
    lens_copy_str(load64(g_canvas_p), load64(g_code_p), 262144);
    lcd_unwrap_typed_fence(load64(g_canvas_p), kind);
    store8(g_canvas_path, 0);
    store64(g_canvas_kind, kind);
    store64(g_canvas_dirty, 1);
    store64(g_canvas_preview_mode, 0);
    lens_popup_position(980, 720);
    hwnd = CreateWindowExA(0, cls_canvas, title_canvas, 0x16CF0000, load32(g_popup_xy), load32(g_popup_xy + 4), 980, 720, load64(g_hwnd), 0, load64(g_hinst), 0);
    store64(g_canvas_hwnd, hwnd);
    if hwnd == 0 { return 0; }
    lens_set_app_icon(hwnd);
    ShowWindow(hwnd, 1);
    UpdateWindow(hwnd);
    lens_set_status(st_canvas_opened);
    return 1;
}

func lens_canvas_open_last_answer() -> i64 {
    return lens_canvas_open_last_answer_kind(0);
}

func lens_canvas_arm(kind: i64) -> i64 {
    if load64(g_busy) != 0 { lens_set_status(st_busy); return 0; }
    if load64(g_canvas_armed) == 0 {
        store64(g_canvas_request_kind, kind);
        store64(g_canvas_armed, 1);
        lens_set_status(lens_canvas_armed_status(kind));
        SetFocus(load64(g_input_ed));
    } else if load64(g_canvas_request_kind) != kind {
        store64(g_canvas_request_kind, kind);
        lens_set_status(lens_canvas_armed_status(kind));
        SetFocus(load64(g_input_ed));
    } else {
        store64(g_canvas_armed, 0);
        lens_set_status(st_canvas_cancelled);
    }
    lens_knowledge_menu_sync();
    return 1;
}

func LensCanvasProc(hwnd: i64, msg: i64, wp: i64, lp: i64) -> i64 {
    if msg == 1 {
        store32(g_dwm_dark, 1);
        DwmSetWindowAttribute(hwnd, 20, g_dwm_dark, 4);
        DwmSetWindowAttribute(hwnd, 19, g_dwm_dark, 4);
        hinst = load64(g_hinst);
        b = lens_button(hwnd, hinst, ID_CANVAS_SAVE, canvas_save, 14, 48, 76, 28); gui_set_font(b, load64(g_font_ui));
        b = lens_button(hwnd, hinst, ID_CANVAS_SAVE_AS, canvas_save_as, 98, 48, 92, 28); gui_set_font(b, load64(g_font_ui));
        b = lens_button(hwnd, hinst, ID_CANVAS_COPY, canvas_copy, 198, 48, 86, 28); gui_set_font(b, load64(g_font_ui));
        b = lens_button(hwnd, hinst, ID_CANVAS_PREVIEW, canvas_preview, 292, 48, 106, 28); store64(g_canvas_btn_preview, b); gui_set_font(b, load64(g_font_ui));
        b = lens_button(hwnd, hinst, ID_CANVAS_CLOSE, canvas_close, 406, 48, 76, 28); gui_set_font(b, load64(g_font_ui));
        store64(g_canvas_loading, 1);
        ed = CreateWindowExA(0, rich_cls, load64(g_canvas_p), 0x50211044, 14, 88, 936, 590, hwnd, ID_CANVAS_EDIT, hinst, 0);
        store64(g_canvas_ed, ed);
        gui_set_font(ed, load64(g_font_mono));
        lens_dark_scroll(ed);
        rich_limit_text(ed, 262143);
        rich_set_bg(ed, COLOR_EDIT);
        rich_cf_color(g_cf, COLOR_TEXT);
        rich_set_charformat(ed, SCF_ALL, g_cf);
        store64(g_canvas_loading, 0);
        return 0;
    }
    if msg == 5 {
        w = gui_loword(lp); h = gui_hiword(lp);
        if load64(g_canvas_ed) != 0 { MoveWindow(load64(g_canvas_ed), 14, 88, w - 28, h - 102, 1); }
        return 0;
    }
    if msg == 43 { return lens_draw_button(lp); }
    if msg == 273 {
        id = gui_loword(wp);
        if id == ID_CANVAS_EDIT { if gui_hiword(wp) == 0x300 { if load64(g_canvas_loading) == 0 { store64(g_canvas_dirty, 1); } } return 0; }
        if id == ID_CANVAS_SAVE { lens_canvas_save(); return 0; }
        if id == ID_CANVAS_SAVE_AS { lens_canvas_save_as(); return 0; }
        if id == ID_CANVAS_COPY { lens_canvas_harvest(); gui_clip_write_text(hwnd, load64(g_canvas_p), strlen(load64(g_canvas_p))); lens_set_status(st_canvas_copy); return 0; }
        if id == ID_CANVAS_PREVIEW { lens_canvas_toggle_preview(); return 0; }
        if id == ID_CANVAS_CLOSE { lens_canvas_close(); return 0; }
    }
    if msg == 256 { if wp == 27 { lens_canvas_close(); return 0; } }
    if msg == 16 { lens_canvas_close(); return 0; }
    if msg == 2 { store64(g_canvas_hwnd, 0); store64(g_canvas_ed, 0); store64(g_canvas_btn_preview, 0); return 0; }
    if msg == 15 {
        hdc = BeginPaint(hwnd, g_ps);
        GetClientRect(hwnd, g_preview_rc);
        w = load32(g_preview_rc + 8);
        FillRect(hdc, g_preview_rc, load64(g_br_bg));
        gdi_fill_xy(hdc, 0, 0, w, 38, load64(g_br_panel));
        SetBkMode(hdc, 1); SetTextColor(hdc, COLOR_TEXT);
        of = SelectObject(hdc, load64(g_font_ui));
        gdi_rect_set(g_thumb_rc, 14, 8, w - 14, 34);
        DrawTextA(hdc, lens_canvas_head(), 0 - 1, g_thumb_rc, 0x8024);
        SelectObject(hdc, of); EndPaint(hwnd, g_ps);
        return 0;
    }
    if msg == 20 { return 1; }
    return DefWindowProcA(hwnd, msg, wp, lp);
}

func lens_document_preview_show() -> i64 {
    lens_document_preview_close();
    hwnd = CreateWindowExA(0, cls_doc_preview, title_doc_preview, 0x16CF0000, 160, 90, 920, 680, 0, 0, load64(g_hinst), 0);
    store64(g_doc_preview_hwnd, hwnd);
    if hwnd == 0 { return 0; }
    lens_set_app_icon(hwnd);
    ShowWindow(hwnd, 1);
    UpdateWindow(hwnd);
    return 1;
}

func lens_document_preview_current() -> i64 {
    if load64(g_has_file) == 0 { lens_set_status(st_doc_preview_none); return 0; }
    lens_copy_str(load64(g_doc_preview_p), load64(g_file_text_p), 262144);
    str_copy(g_doc_preview_title, g_file_name);
    str_copy(g_doc_preview_path, g_textpath);
    return lens_document_preview_show();
}

func lens_calc_format(v: f64) -> i64 {
    nf_dtoa(fbits(v), g_calc_result);
    dot = 0 - 1;
    i = 0;
    while load8(g_calc_result + i) != 0 {
        if load8(g_calc_result + i) == 46 { dot = i; }
        i = i + 1;
    }
    if dot >= 0 {
        i = i - 1;
        while i > dot {
            if load8(g_calc_result + i) != 48 { break; }
            store8(g_calc_result + i, 0);
            i = i - 1;
        }
        if i == dot { store8(g_calc_result + i, 0); }
    }
    return 1;
}

func lens_calc_evaluate() -> i64 {
    if load64(g_calc_expr_ed) == 0 { return 0; }
    gui_get_text(load64(g_calc_expr_ed), g_calc_expr, 512);
    v = lct_eval(g_calc_expr, g_calc_error);
    err = load64(g_calc_error);
    if err == 2 { str_copy(g_calc_result, calc_divzero); }
    else if err != 0 { str_copy(g_calc_result, calc_syntax); }
    else { lens_calc_format(v); }
    SetWindowTextA(load64(g_calc_result_ed), g_calc_result);
    return err == 0;
}

func lens_calc_copy() -> i64 {
    if lens_calc_evaluate() == 0 { return 0; }
    gui_clip_write_text(load64(g_calc_hwnd), g_calc_result, strlen(g_calc_result));
    lens_set_status(st_calc_copied);
    return 1;
}

func lens_calc_insert() -> i64 {
    if lens_calc_evaluate() == 0 { return 0; }
    SendMessageA(load64(g_input_ed), 0xC2, 1, g_calc_result);
    SetFocus(load64(g_input_ed));
    lens_set_status(st_calc_inserted);
    return 1;
}

func lens_conv_build_all() -> i64 {
    p = str_copy(g_conv_all, conv_dec_a); p = str_copy(p, g_conv_dec_text);
    p = str_copy(p, conv_hex_a); p = str_copy(p, g_conv_hex_text);
    p = str_copy(p, conv_bin_a); str_copy(p, g_conv_bin_text);
    return 1;
}

func lens_conv_convert() -> i64 {
    gui_get_text(load64(g_conv_input_ed), g_conv_input, 128);
    if lct_parse_uint(g_conv_input, g_conv_value) == 0 {
        SetWindowTextA(load64(g_conv_dec_ed), conv_invalid);
        SetWindowTextA(load64(g_conv_hex_ed), rich_empty);
        SetWindowTextA(load64(g_conv_bin_ed), rich_empty);
        store8(g_conv_dec_text, 0); store8(g_conv_hex_text, 0); store8(g_conv_bin_text, 0);
        return 0;
    }
    v = load64(g_conv_value);
    lct_format_dec(v, g_conv_dec_text);
    lct_format_hex(v, g_conv_hex_text);
    lct_format_bin(v, g_conv_bin_text);
    SetWindowTextA(load64(g_conv_dec_ed), g_conv_dec_text);
    SetWindowTextA(load64(g_conv_hex_ed), g_conv_hex_text);
    SetWindowTextA(load64(g_conv_bin_ed), g_conv_bin_text);
    return 1;
}

func lens_conv_copy() -> i64 {
    if lens_conv_convert() == 0 { return 0; }
    lens_conv_build_all();
    gui_clip_write_text(load64(g_calc_hwnd), g_conv_all, strlen(g_conv_all));
    lens_set_status(st_conv_copied);
    return 1;
}

func lens_conv_insert() -> i64 {
    if lens_conv_convert() == 0 { return 0; }
    lens_conv_build_all();
    SendMessageA(load64(g_input_ed), 0xC2, 1, g_conv_all);
    SetFocus(load64(g_input_ed));
    lens_set_status(st_conv_inserted);
    return 1;
}

func LensCalculatorProc(hwnd: i64, msg: i64, wp: i64, lp: i64) -> i64 {
    if msg == 1 {
        store32(g_dwm_dark, 1);
        DwmSetWindowAttribute(hwnd, 20, g_dwm_dark, 4);
        DwmSetWindowAttribute(hwnd, 19, g_dwm_dark, 4);
        hinst = load64(g_hinst); f = load64(g_font_ui); fb = load64(g_font_bold); fm = load64(g_font_mono);
        h = gui_static_text(hwnd, hinst, calc_head, 20, 18, 520, 28); gui_set_font(h, fb);
        h = gui_static_text(hwnd, hinst, calc_expression, 20, 58, 120, 22); gui_set_font(h, f);
        e = CreateWindowExA(0, gui_edit, rich_empty, 0x50010080, 20, 82, 404, 30, hwnd, ID_CALC_EXPR, hinst, 0);
        store64(g_calc_expr_ed, e); gui_set_font(e, fm); SendMessageA(e, 197, 511, 0);
        b = lens_button(hwnd, hinst, ID_CALC_EVALUATE, calc_evaluate, 434, 82, 104, 30); gui_set_font(b, f);
        h = gui_static_text(hwnd, hinst, calc_hint, 20, 120, 518, 22); gui_set_font(h, f);
        h = gui_static_text(hwnd, hinst, calc_result, 20, 158, 120, 22); gui_set_font(h, f);
        e = CreateWindowExA(0, gui_edit, calc_empty, 0x50010880, 20, 182, 518, 34, hwnd, ID_CALC_RESULT, hinst, 0);
        store64(g_calc_result_ed, e); gui_set_font(e, fm);
        b = lens_button(hwnd, hinst, ID_CALC_COPY, calc_copy, 20, 238, 112, 30); gui_set_font(b, f);
        b = lens_button(hwnd, hinst, ID_CALC_INSERT, calc_insert, 142, 238, 150, 30); gui_set_font(b, f);
        h = gui_static_text(hwnd, hinst, conv_head, 20, 286, 518, 26); gui_set_font(h, fb);
        h = gui_static_text(hwnd, hinst, conv_input, 20, 318, 390, 22); gui_set_font(h, f);
        e = CreateWindowExA(0, gui_edit, rich_empty, 0x50010080, 20, 342, 404, 30, hwnd, ID_CONV_INPUT, hinst, 0);
        store64(g_conv_input_ed, e); gui_set_font(e, fm); SendMessageA(e, 197, 127, 0);
        b = lens_button(hwnd, hinst, ID_CONV_CONVERT, conv_convert, 434, 342, 104, 30); gui_set_font(b, f);
        h = gui_static_text(hwnd, hinst, conv_dec, 20, 388, 44, 26); gui_set_font(h, f);
        e = CreateWindowExA(0, gui_edit, rich_empty, 0x50010880, 70, 386, 468, 30, hwnd, ID_CONV_DEC, hinst, 0); store64(g_conv_dec_ed, e); gui_set_font(e, fm);
        h = gui_static_text(hwnd, hinst, conv_hex, 20, 426, 44, 26); gui_set_font(h, f);
        e = CreateWindowExA(0, gui_edit, rich_empty, 0x50010880, 70, 424, 468, 30, hwnd, ID_CONV_HEX, hinst, 0); store64(g_conv_hex_ed, e); gui_set_font(e, fm);
        h = gui_static_text(hwnd, hinst, conv_bin, 20, 464, 44, 26); gui_set_font(h, f);
        e = CreateWindowExA(0, gui_edit, rich_empty, 0x50010880, 70, 462, 468, 30, hwnd, ID_CONV_BIN, hinst, 0); store64(g_conv_bin_ed, e); gui_set_font(e, fm);
        b = lens_button(hwnd, hinst, ID_CONV_COPY, conv_copy, 20, 514, 136, 30); gui_set_font(b, f);
        b = lens_button(hwnd, hinst, ID_CONV_INSERT, conv_insert, 166, 514, 136, 30); gui_set_font(b, f);
        b = lens_button(hwnd, hinst, ID_CALC_CLOSE, calc_close, 462, 514, 76, 30); gui_set_font(b, f);
        SetFocus(load64(g_calc_expr_ed));
        return 0;
    }
    if msg == 16 { DestroyWindow(hwnd); return 0; }
    if msg == 2 {
        store64(g_calc_hwnd, 0); store64(g_calc_expr_ed, 0); store64(g_calc_result_ed, 0);
        store64(g_conv_input_ed, 0); store64(g_conv_dec_ed, 0); store64(g_conv_hex_ed, 0); store64(g_conv_bin_ed, 0);
        return 0;
    }
    if msg == 43 { return lens_draw_button(lp); }
    if msg == 273 {
        id = gui_loword(wp);
        if id == ID_CALC_EVALUATE { lens_calc_evaluate(); return 0; }
        if id == ID_CALC_COPY { lens_calc_copy(); return 0; }
        if id == ID_CALC_INSERT { lens_calc_insert(); return 0; }
        if id == ID_CALC_CLOSE { DestroyWindow(hwnd); return 0; }
        if id == ID_CONV_CONVERT { lens_conv_convert(); return 0; }
        if id == ID_CONV_COPY { lens_conv_copy(); return 0; }
        if id == ID_CONV_INSERT { lens_conv_insert(); return 0; }
    }
    if msg == 307 { SetTextColor(wp, COLOR_TEXT); SetBkColor(wp, COLOR_EDIT); return load64(g_br_edit); }
    if msg == 308 { SetTextColor(wp, COLOR_TEXT); SetBkColor(wp, COLOR_EDIT); return load64(g_br_edit); }
    if msg == 312 {
        SetTextColor(wp, COLOR_TEXT);
        readonly = 0;
        if lp == load64(g_calc_result_ed) { readonly = 1; }
        if lp == load64(g_conv_dec_ed) { readonly = 1; }
        if lp == load64(g_conv_hex_ed) { readonly = 1; }
        if lp == load64(g_conv_bin_ed) { readonly = 1; }
        if readonly == 1 { SetBkColor(wp, COLOR_EDIT); return load64(g_br_edit); }
        SetBkColor(wp, COLOR_BG); return load64(g_br_bg);
    }
    if msg == 15 {
        hdc = BeginPaint(hwnd, g_ps); GetClientRect(hwnd, g_rect);
        gdi_fill_xy(hdc, 0, 0, load32(g_rect + 8), load32(g_rect + 12), load64(g_br_bg));
        gdi_fill_xy(hdc, 0, 0, load32(g_rect + 8), 5, load64(g_br_accent));
        EndPaint(hwnd, g_ps); return 0;
    }
    if msg == 20 { return 1; }
    return DefWindowProcA(hwnd, msg, wp, lp);
}

func lens_calculator_show() -> i64 {
    if load64(g_calc_hwnd) != 0 {
        lens_popup_position(578, 600);
        MoveWindow(load64(g_calc_hwnd), load32(g_popup_xy), load32(g_popup_xy + 4), 578, 600, 1);
        ShowWindow(load64(g_calc_hwnd), 1);
        BringWindowToTop(load64(g_calc_hwnd));
        SetFocus(load64(g_calc_expr_ed));
        return 1;
    }
    lens_popup_position(578, 600);
    hwnd = CreateWindowExA(0, cls_calculator, title_calculator, 0x16CA0000, load32(g_popup_xy), load32(g_popup_xy + 4), 578, 600, load64(g_hwnd), 0, load64(g_hinst), 0);
    store64(g_calc_hwnd, hwnd);
    if hwnd == 0 { return 0; }
    lens_set_app_icon(hwnd);
    ShowWindow(hwnd, 1);
    UpdateWindow(hwnd);
    return 1;
}

func lens_web_build_meta() -> i64 {
    p = str_copy(g_web_meta, web_source_a); p = str_copy(p, g_web_url);
    p = str_copy(p, web_retrieved_a);
    GetLocalTime(g_web_time);
    p = nf_4d(load16(g_web_time), p); store8(p, 45); p = p + 1;
    p = nf_2d(load16(g_web_time + 2), p); store8(p, 45); p = p + 1;
    p = nf_2d(load16(g_web_time + 6), p); store8(p, 32); p = p + 1;
    p = nf_2d(load16(g_web_time + 8), p); store8(p, 58); p = p + 1;
    p = nf_2d(load16(g_web_time + 10), p); store8(p, 58); p = p + 1;
    p = nf_2d(load16(g_web_time + 12), p);
    p = str_copy(p, web_http_meta); int_to_str(g_tmp, load64(g_web_status)); p = str_copy(p, g_tmp);
    p = str_copy(p, web_bytes_a); int_to_str(g_tmp, strlen(load64(g_web_text_p))); str_copy(p, g_tmp);
    return 1;
}

func lens_web_source_text(dst: i64, cap: i64) -> i64 {
    if cap < 64 { return 0; }
    p = str_copy(dst, web_insert_a); p = str_copy(p, g_web_url); p = str_copy(p, web_insert_b);
    out = p - dst;
    src = load64(g_web_text_p); i = 0;
    while load8(src + i) != 0 {
        if out + 1 >= cap { break; }
        store8(dst + out, load8(src + i)); out = out + 1; i = i + 1;
    }
    store8(dst + out, 0);
    return out;
}

func lens_web_thread_fn(param: i64) -> i64 {
    store64(g_web_status, lt_web_get(g_web_url, load64(g_web_raw_p), 131072));
    if load64(g_web_cancel) == 1 { store64(g_web_status, 0); store8(load64(g_web_raw_p), 0); }
    store8(load64(g_web_text_p), 0);
    if load64(g_web_status) == 200 {
        lwr_html_to_text(load64(g_web_raw_p), load64(g_web_text_p), 65536);
    }
    PostMessageA(load64(g_hwnd), 0x800D, 0, 0);
    return 0;
}

func lens_web_finish() -> i64 {
    h = load64(g_web_thread);
    if h != 0 { CloseHandle(h); store64(g_web_thread, 0); }
    if load64(g_busy_kind) == 7 { lens_end_busy(); }
    if load64(g_web_url_ed) != 0 { EnableWindow(load64(g_web_url_ed), 1); }
    if load64(g_web_fetch_btn) != 0 { EnableWindow(load64(g_web_fetch_btn), 1); InvalidateRect(load64(g_web_fetch_btn), 0, 1); }
    status = load64(g_web_status);
    msg = web_failed;
    if status == 200 {
        if load8(load64(g_web_text_p)) == 0 { msg = web_empty_text; lens_set_status(st_web_failed); }
        else { lens_web_build_meta(); msg = load64(g_web_text_p); lens_set_status(st_web_ready); }
    } else if status >= 300 {
        if status < 400 { msg = web_redirect; lens_set_status(st_web_failed); }
        else { p = str_copy(g_web_meta, web_http_a); int_to_str(g_tmp, status); p = str_copy(p, g_tmp); str_copy(p, web_http_b); msg = g_web_meta; lens_set_status(st_web_failed); }
    } else { lens_set_status(st_web_failed); }
    if load64(g_web_text_ed) != 0 { SetWindowTextA(load64(g_web_text_ed), msg); }
    if load64(g_web_meta_lbl) != 0 {
        if status == 200 { if load8(load64(g_web_text_p)) != 0 { SetWindowTextA(load64(g_web_meta_lbl), g_web_meta); } else { SetWindowTextA(load64(g_web_meta_lbl), web_empty_text); } }
        else { SetWindowTextA(load64(g_web_meta_lbl), msg); }
    }
    return 1;
}

func lens_web_fetch_start() -> i64 {
    if load64(g_busy) != 0 { lens_set_status(st_busy); return 0; }
    gui_get_text(load64(g_web_url_ed), g_web_url, 1024);
    if lwr_url_valid(g_web_url, g_web_host) == 0 {
        SetWindowTextA(load64(g_web_meta_lbl), web_invalid);
        return 0;
    }
    p = str_copy(g_web_permission, web_permission_a); p = str_copy(p, g_web_host);
    p = str_copy(p, web_permission_b); p = str_copy(p, g_web_url); str_copy(p, web_permission_c);
    if MessageBoxA(load64(g_web_hwnd), g_web_permission, web_permission_title, 0x24) != 6 {
        lens_set_status(st_web_denied); return 0;
    }
    if lens_begin_busy(7, st_web_fetching) == 0 { return 0; }
    store8(load64(g_web_raw_p), 0); store8(load64(g_web_text_p), 0); store64(g_web_status, 0); store64(g_web_cancel, 0);
    SetWindowTextA(load64(g_web_meta_lbl), web_wait);
    SetWindowTextA(load64(g_web_text_ed), web_wait);
    EnableWindow(load64(g_web_url_ed), 0); EnableWindow(load64(g_web_fetch_btn), 0);
    InvalidateRect(load64(g_web_fetch_btn), 0, 1);
    h = CreateThread(0, 0, &lens_web_thread_fn, 0, 0, g_thread_id);
    store64(g_web_thread, h);
    if h == 0 { lens_end_busy(); EnableWindow(load64(g_web_url_ed), 1); EnableWindow(load64(g_web_fetch_btn), 1); lens_set_status(st_web_failed); return 0; }
    return 1;
}

func lens_web_copy() -> i64 {
    if load8(load64(g_web_text_p)) == 0 { return 0; }
    lens_web_source_text(load64(g_filebuf_p), 1048576);
    gui_clip_write_text(load64(g_web_hwnd), load64(g_filebuf_p), strlen(load64(g_filebuf_p)));
    lens_set_status(st_web_copied);
    return 1;
}

func lens_web_insert() -> i64 {
    if load8(load64(g_web_text_p)) == 0 { return 0; }
    lens_web_source_text(g_web_insert, 16384);
    SendMessageA(load64(g_input_ed), 0xC2, 1, g_web_insert);
    SetFocus(load64(g_input_ed)); lens_set_status(st_web_inserted);
    return 1;
}

func LensWebReaderProc(hwnd: i64, msg: i64, wp: i64, lp: i64) -> i64 {
    if msg == 1 {
        store32(g_dwm_dark, 1); DwmSetWindowAttribute(hwnd, 20, g_dwm_dark, 4); DwmSetWindowAttribute(hwnd, 19, g_dwm_dark, 4);
        hinst = load64(g_hinst); f = load64(g_font_ui); fb = load64(g_font_bold); fm = load64(g_font_mono);
        h = gui_static_text(hwnd, hinst, web_head, 20, 18, 760, 28); gui_set_font(h, fb);
        h = gui_static_text(hwnd, hinst, web_notice, 20, 50, 800, 22); gui_set_font(h, f);
        h = gui_static_text(hwnd, hinst, web_url_label, 20, 82, 50, 24); gui_set_font(h, f);
        e = CreateWindowExA(0, gui_edit, g_web_url, 0x50010080, 70, 78, 640, 30, hwnd, ID_WEB_URL, hinst, 0); store64(g_web_url_ed, e); gui_set_font(e, fm); SendMessageA(e, 197, 1000, 0);
        b = lens_button(hwnd, hinst, ID_WEB_FETCH, web_fetch, 720, 78, 116, 30); store64(g_web_fetch_btn, b); gui_set_font(b, f);
        h = gui_static_text(hwnd, hinst, web_empty, 20, 118, 816, 42); store64(g_web_meta_lbl, h); gui_set_font(h, f);
        e = CreateWindowExA(0, rich_cls, web_empty, LENS_RICH_WRAP, 20, 164, 816, 404, hwnd, ID_WEB_TEXT, hinst, 0); store64(g_web_text_ed, e); gui_set_font(e, fm); lens_dark_scroll(e); rich_limit_text(e, 65535); rich_set_bg(e, COLOR_EDIT); rich_cf_color(g_cf, COLOR_TEXT); rich_set_charformat(e, SCF_ALL, g_cf); SendMessageA(e, 0xCF, 1, 0);
        b = lens_button(hwnd, hinst, ID_WEB_COPY, web_copy, 20, 584, 112, 30); gui_set_font(b, f);
        b = lens_button(hwnd, hinst, ID_WEB_INSERT, web_insert, 142, 584, 126, 30); gui_set_font(b, f);
        b = lens_button(hwnd, hinst, ID_WEB_CLOSE, web_close, 760, 584, 76, 30); gui_set_font(b, f);
        return 0;
    }
    if msg == 16 { if load64(g_busy_kind) == 7 { store64(g_web_cancel, 1); lt_abort(); } DestroyWindow(hwnd); return 0; }
    if msg == 2 { store64(g_web_hwnd, 0); store64(g_web_url_ed, 0); store64(g_web_meta_lbl, 0); store64(g_web_text_ed, 0); store64(g_web_fetch_btn, 0); return 0; }
    if msg == 43 { return lens_draw_button(lp); }
    if msg == 273 {
        id = gui_loword(wp);
        if id == ID_WEB_FETCH { lens_web_fetch_start(); return 0; }
        if id == ID_WEB_COPY { lens_web_copy(); return 0; }
        if id == ID_WEB_INSERT { lens_web_insert(); return 0; }
        if id == ID_WEB_CLOSE { if load64(g_busy_kind) == 7 { store64(g_web_cancel, 1); lt_abort(); } DestroyWindow(hwnd); return 0; }
    }
    if msg == 307 { SetTextColor(wp, COLOR_TEXT); SetBkColor(wp, COLOR_EDIT); return load64(g_br_edit); }
    if msg == 312 { SetTextColor(wp, COLOR_TEXT); SetBkColor(wp, COLOR_BG); return load64(g_br_bg); }
    if msg == 15 { hdc = BeginPaint(hwnd, g_ps); GetClientRect(hwnd, g_rect); gdi_fill_xy(hdc, 0, 0, load32(g_rect + 8), load32(g_rect + 12), load64(g_br_bg)); gdi_fill_xy(hdc, 0, 0, load32(g_rect + 8), 5, load64(g_br_accent)); EndPaint(hwnd, g_ps); return 0; }
    if msg == 20 { return 1; }
    return DefWindowProcA(hwnd, msg, wp, lp);
}

func lens_web_reader_show() -> i64 {
    if load64(g_web_hwnd) != 0 { ShowWindow(load64(g_web_hwnd), 1); BringWindowToTop(load64(g_web_hwnd)); SetFocus(load64(g_web_url_ed)); return 1; }
    lens_popup_position(876, 670);
    hwnd = CreateWindowExA(0, cls_web_reader, title_web_reader, 0x16CF0000, load32(g_popup_xy), load32(g_popup_xy + 4), 876, 670, load64(g_hwnd), 0, load64(g_hinst), 0);
    store64(g_web_hwnd, hwnd); if hwnd == 0 { return 0; }
