    lens_menu_item(menu, ID_PRESET_INDUSTRIAL, pr_industrial);
    lens_menu_item(menu, ID_PRESET_AUTO, pr_auto);
    lens_menu_dark(menu);

    gui_static_text(hwnd, hinst, txt_chat_name, 916, 16, 84, 20);
    e = CreateWindowExA(0, gui_edit, g_chat_name, 0x50010080, 1004, 12, 160, 24, hwnd, ID_CHATNAME, hinst, 0);
    store64(g_chatname_ed, e); gui_set_font(e, f);

    inf = CreateWindowExA(0, rich_cls, info_empty, LENS_RICH_WRAP, 382, 44, 620, 120, hwnd, ID_INFO_PANEL, hinst, 0);
    store64(g_info_ed, inf);
    gui_set_font(inf, f);
    lens_dark_scroll(inf);
    rich_limit_text(inf, 8192);
    rich_set_bg(inf, COLOR_EDIT);
    rich_cf_color(g_cf, COLOR_TEXT);
    rich_set_charformat(inf, SCF_ALL, g_cf);
    SendMessageA(inf, 0xCF, 1, 0);
    lens_set_info(info_empty);

    tr = CreateWindowExA(0, rich_cls, rich_empty, LENS_RICH_WRAP, 382, 44, 620, 360, hwnd, ID_TRANS, hinst, 0);
    store64(g_trans_ed, tr);
    gui_set_font(tr, fm);
    lens_dark_scroll(tr);
    rich_limit_text(tr, 524288);
    rich_set_bg(tr, COLOR_EDIT);
    rich_cf_color(g_cf, COLOR_TEXT);
    rich_set_charformat(tr, SCF_ALL, g_cf);
    SendMessageA(tr, 0xCF, 1, 0);
    SendMessageA(tr, 0x45B, 1, 0); # EM_AUTOURLDETECT
    rich_set_event_mask(tr, 0x04000000); # ENM_LINK

    menu = gui_menu_create();
    store64(g_answer_menu, menu);
    lens_menu_item(menu, ID_EDIT_USER, mi_edit_user);
    lens_menu_item(menu, ID_CANCEL_EDIT, mi_cancel_edit);
    lens_menu_item(menu, ID_REGENERATE, mi_regenerate);
    lens_menu_item(menu, ID_CONTINUE, mi_continue);
    lens_menu_item(menu, ID_DELETE_ANSWER, mi_delete_answer);
    gui_menu_sep(menu);
    lens_menu_item(menu, ID_COPY_USER, mi_copy_user);
    lens_menu_item(menu, ID_COPY_ANSWER, mi_copy_answer);
    lens_menu_item(menu, ID_COPY_EXCHANGE, mi_copy_exchange);
    lens_menu_item(menu, ID_SAVE_ANSWER, mi_save_answer);
    lens_menu_item(menu, ID_OPEN_CANVAS, mi_open_canvas);
    lens_menu_item(menu, ID_COPY_METADATA, mi_copy_metadata);
    gui_menu_sep(menu);
    lens_menu_item(menu, ID_COPY_CODE, mi_copy_code);
    lens_menu_item(menu, ID_SAVE_CODE, mi_save_code);
    lens_menu_item(menu, ID_PREVIEW_ARTIFACT, mi_preview_artifact);
    gui_menu_sep(menu);
    lens_menu_item(menu, ID_TOGGLE_REASONING, mi_reasoning);
    lens_menu_dark(menu);

    p = str_copy(load64(g_filebuf_p), help_text);
    p = str_copy(p, help_engine_text);
    p = str_copy(p, help_hf_text);
    p = str_copy(p, help_vision_text);
    p = str_copy(p, help_knowledge_text);
    p = str_copy(p, help_conversation_text);
    p = str_copy(p, help_arena_text);
    p = str_copy(p, help_voice_text);
    p = str_copy(p, help_privacy_text);
    str_copy(p, help_rich_text);
    hp = CreateWindowExA(0, rich_cls, load64(g_filebuf_p), LENS_RICH_WRAP, 382, 44, 620, 360, hwnd, ID_HELP_PANEL, hinst, 0);
    store64(g_help_ed, hp);
    gui_set_font(hp, fm);
    lens_dark_scroll(hp);
    rich_limit_text(hp, 65536);
    rich_set_bg(hp, COLOR_EDIT);
    rich_cf_color(g_cf, COLOR_TEXT);
    rich_set_charformat(hp, SCF_ALL, g_cf);
    SendMessageA(hp, 0xCF, 1, 0);
    ShowWindow(hp, 0);

    al = CreateWindowExA(0, gui_static, att_none, 0x5000010D, 382, 406, 620, 24, hwnd, ID_ATTACH_PANEL, hinst, 0);
    store64(g_attach_lbl, al);
    gui_set_font(al, f);

    inp = CreateWindowExA(0, rich_cls, rich_empty, LENS_RICH_WRAP, 382, 414, 620, 92, hwnd, ID_INPUT, hinst, 0);
    store64(g_input_ed, inp);
    gui_set_font(inp, fm);
    lens_dark_scroll(inp);
    rich_limit_text(inp, 65536);
    rich_set_bg(inp, COLOR_EDIT);
    rich_cf_color(g_cf, COLOR_TEXT);
    rich_set_charformat(inp, SCF_ALL, g_cf);

    menu = gui_menu_create();
    store64(g_add_menu, menu);
    cm = gui_menu_create();
    store64(g_canvas_menu, cm);
    lens_menu_item(cm, ID_ADD_CANVAS, mi_add_canvas);
    lens_menu_item(cm, ID_ADD_CANVAS_HTML, mi_add_canvas_html);
    lens_menu_item(cm, ID_ADD_CANVAS_SVG, mi_add_canvas_svg);
    lens_menu_item(cm, ID_ADD_CANVAS_CSV, mi_add_canvas_csv);
    lens_menu_dark(cm);
    lens_menu_popup(menu, cm, mi_canvas_menu);
    tm = gui_menu_create();
    store64(g_tools_menu, tm);
    lens_menu_item(tm, ID_TOOL_CALCULATOR, mi_tool_calculator);
    lens_menu_item(tm, ID_TOOL_WEB_READER, mi_tool_web_reader);
    lens_menu_item(tm, ID_TOOL_WEB_SEARCH, mi_tool_web_search);
    lens_menu_dark(tm);
    lens_menu_popup(menu, tm, mi_tools_menu);
    gui_menu_sep(menu);
    lens_menu_item(menu, ID_ADD_IMAGE, mi_add_image);
    lens_menu_item(menu, ID_ADD_CLIPBOARD, mi_paste_image);
    lens_menu_item(menu, ID_ADD_FOLDER, mi_add_folder);
    lens_menu_item(menu, ID_CLEAR_IMAGE, mi_clear_image);
    lens_menu_item(menu, ID_ADD_FILES, mi_add_files);
    gui_menu_sep(menu);
    lens_menu_item(menu, ID_KNOWLEDGE_FILE, mi_knowledge_file);
    lens_menu_item(menu, ID_KNOWLEDGE_FOLDER, mi_knowledge_folder);
    lens_menu_item(menu, ID_KNOWLEDGE_USE, mi_knowledge_use);
    lens_menu_item(menu, ID_KNOWLEDGE_SHOW, mi_knowledge_show);
    lens_menu_item(menu, ID_KNOWLEDGE_OPEN, mi_knowledge_open);
    lens_menu_item(menu, ID_KNOWLEDGE_CLEAR, mi_knowledge_clear);
    gui_menu_sep(menu);
    lens_menu_item(menu, ID_VISION_AUTO, mi_helper_auto);
    lens_menu_item(menu, ID_VISION_MOON, mi_helper_moon);
    lens_menu_item(menu, ID_VISION_FIRST, mi_helper_first);
    lens_menu_item(menu, ID_VISION_OFF, mi_helper_off);
    lens_menu_dark(menu);

    b = lens_button(hwnd, hinst, ID_SEND, btn_send, 382, 514, 40, 26);
    store64(g_btn_send, b); gui_set_font(b, f);
    b = lens_button(hwnd, hinst, ID_STOP, btn_stop, 462, 514, 74, 26);
    store64(g_btn_stop, b); gui_set_font(b, f);
    b = lens_button(hwnd, hinst, ID_ATTACH, btn_attach, 542, 514, 46, 26);
    store64(g_btn_attach, b); gui_set_font(b, f);
    b = lens_button(hwnd, hinst, ID_NEW, btn_new, 660, 514, 82, 26);
    store64(g_btn_new, b); gui_set_font(b, f);
    b = lens_button(hwnd, hinst, ID_SAVE, btn_save, 748, 514, 64, 26);
    store64(g_btn_save, b); gui_set_font(b, f);
    b = lens_button(hwnd, hinst, ID_SAVE_AS, btn_save_as, 818, 514, 86, 26);
    store64(g_btn_save_as, b); gui_set_font(b, f);
    b = lens_button(hwnd, hinst, ID_LOAD, btn_load, 912, 514, 64, 26);
    store64(g_btn_load, b); gui_set_font(b, f);
    menu = gui_menu_create();
    store64(g_load_menu, menu);
    lens_recent_menu_build();
    b = lens_button(hwnd, hinst, ID_EXPORT, btn_export, 982, 514, 70, 26);
    store64(g_btn_export, b); gui_set_font(b, f);
    b = lens_button(hwnd, hinst, ID_COPY, btn_copy, 1058, 514, 64, 26);
    store64(g_btn_copy, b); gui_set_font(b, f);
    b = lens_button(hwnd, hinst, ID_INFO, btn_info, 1128, 514, 84, 26);
    store64(g_btn_info, b); gui_set_font(b, f);
    b = lens_button(hwnd, hinst, ID_PRIVACY, btn_privacy, 1218, 514, 70, 26);
    store64(g_btn_privacy, b); gui_set_font(b, f);
    menu = gui_menu_create();
    store64(g_privacy_menu, menu);
    lens_menu_item(menu, ID_PRIVACY_SHOW, mi_privacy_show);
    gui_menu_sep(menu);
    lens_menu_item(menu, ID_PRIVACY_ROOT, mi_privacy_root);
    lens_menu_item(menu, ID_PRIVACY_CHATS, mi_privacy_chats);
    lens_menu_item(menu, ID_PRIVACY_KNOWLEDGE, mi_privacy_knowledge);
    lens_menu_item(menu, ID_PRIVACY_MODELS, mi_privacy_models);
    lens_menu_item(menu, ID_PRIVACY_ARENA, mi_arena_open);
    gui_menu_sep(menu);
    lens_menu_item(menu, ID_PRIVACY_CLEAR_CHAT, mi_privacy_clear_chat);
    lens_menu_item(menu, ID_PRIVACY_CLEAR_KNOWLEDGE, mi_privacy_clear_knowledge);
    lens_menu_item(menu, ID_PRIVACY_CLEAR_PREVIEWS, mi_privacy_clear_previews);
    lens_menu_item(menu, ID_PRIVACY_CLEAR_WEBVIEW, mi_privacy_clear_webview);
    lens_menu_item(menu, ID_PRIVACY_CLEAR_ARENA, mi_arena_clear);
    lens_menu_dark(menu);
    b = lens_button(hwnd, hinst, ID_ARENA, btn_arena, 1218, 514, 78, 26);
    store64(g_btn_arena, b); gui_set_font(b, f);
    menu = gui_menu_create();
    store64(g_arena_menu, menu);
    lens_menu_item(menu, ID_ARENA_BLIND, mi_arena_blind);
    gui_menu_sep(menu);
    lens_menu_item(menu, ID_ARENA_HISTORY, mi_arena_history);
    lens_menu_item(menu, ID_ARENA_OPEN, mi_arena_open);
    lens_menu_item(menu, ID_ARENA_CLEAR, mi_arena_clear);
    lens_menu_dark(menu);
    b = lens_button(hwnd, hinst, ID_HELP, btn_help, 1218, 514, 78, 26);
    store64(g_btn_help, b); gui_set_font(b, f);

    st = gui_static_text(hwnd, hinst, st_ready, 12, 680, 1000, 24);
    store64(g_status, st);
    gui_set_font(st, f);
    lens_sync_backend_controls();
    GetClientRect(hwnd, g_rect);
    lens_layout(load32(g_rect + 8), load32(g_rect + 12));
    return 0;
}

func lens_command(id: i64, code: i64) -> i64 {
    if id == ID_BACKEND {
        gui_menu_drop(load64(g_hwnd), load64(g_backend_cb), load64(g_backend_menu), g_rect);
        return 0;
    }
    if id == ID_BACKEND_OLLAMA {
        lens_harvest_display();
        store64(g_backend_display, 0);
        store64(g_backend, 0);
        lens_sync_backend_controls();
        lens_config_save();
        InvalidateRect(load64(g_backend_cb), 0, 1);
        return 0;
    }
    if id == ID_BACKEND_OPENAI {
        lens_harvest_display();
        store64(g_cloud_provider, 0);
        store64(g_backend_display, 1);
        store64(g_backend, 1);
        lens_sync_backend_controls();
        lens_config_save();
        InvalidateRect(load64(g_backend_cb), 0, 1);
        return 0;
    }
    if id == ID_BACKEND_HF {
        lens_harvest_display();
        store64(g_cloud_provider, 1);
        str_copy(g_openai_url, hf_router_url);
        str_copy(g_openai_model, hf_default_model);
        store64(g_backend_display, 1);
        store64(g_backend, 1);
        lens_sync_backend_controls();
        # Set the visible field directly as well. This avoids any stale
        # localhost text when the command is dispatched from the backend menu.
        SetWindowTextA(load64(g_url_ed), hf_router_url);
        lens_config_save();
        InvalidateRect(load64(g_backend_cb), 0, 1);
        return 0;
    }
    if id == ID_BACKEND_ANTHROPIC {
        lens_harvest_display();
        store64(g_backend_display, 2);
        store64(g_backend, 2);
        lens_sync_backend_controls();
        lens_config_save();
        InvalidateRect(load64(g_backend_cb), 0, 1);
        return 0;
    }
    if id == ID_BACKEND_AETHER {
        lens_harvest_display();
        store64(g_backend_display, 3);
        store64(g_backend, 3);
        lens_sync_backend_controls();
        lens_config_save();
        InvalidateRect(load64(g_backend_cb), 0, 1);
        return 0;
    }
    if id == ID_PRESET {
        gui_menu_drop(load64(g_hwnd), load64(g_preset_cb), load64(g_preset_menu), g_rect);
        return 0;
    }
    if id == ID_PRESET_GENERAL {
        store64(g_preset, 0);
        lens_config_save();
        InvalidateRect(load64(g_preset_cb), 0, 1);
        return 0;
    }
    if id == ID_PRESET_ANCL {
        store64(g_preset, 1);
        lens_config_save();
        InvalidateRect(load64(g_preset_cb), 0, 1);
        return 0;
    }
    if id == ID_PRESET_INDUSTRIAL {
        store64(g_preset, 2);
        lens_config_save();
        InvalidateRect(load64(g_preset_cb), 0, 1);
        return 0;
    }
    if id == ID_PRESET_AUTO {
        store64(g_preset, 3);
        lens_config_save();
        InvalidateRect(load64(g_preset_cb), 0, 1);
        return 0;
    }
    if id == ID_REFRESH { if load64(g_backend_display) == 1 { if load64(g_cloud_provider) == 1 { lens_hf_browse_models(); return 0; } } lens_refresh_models(); return 0; }
    if id == ID_USE { lens_use_selected(); return 0; }
    if id == ID_CATALOG {
        if load64(g_backend_display) == 1 { if load64(g_cloud_provider) == 1 {
            lens_hf_browse_models();
            return 0;
        } }
        if load64(g_backend_display) == 3 {
            lens_engine_menu_sync();
            gui_menu_drop(load64(g_hwnd), load64(g_btn_catalog), load64(g_engine_menu), g_rect);
        }
        else { gui_menu_drop(load64(g_hwnd), load64(g_btn_catalog), load64(g_catalog_menu), g_rect); }
        return 0;
    }
    if id == ID_HF_GPTOSS20 { str_copy(g_openai_model, hf_model_20); SetWindowTextA(load64(g_model_ed), g_openai_model); lens_config_save(); lens_update_cloud_info(); lens_set_status(st_hf_selected); return 0; }
    if id == ID_HF_GPTOSS120 { str_copy(g_openai_model, hf_model_120); SetWindowTextA(load64(g_model_ed), g_openai_model); lens_config_save(); lens_update_cloud_info(); lens_set_status(st_hf_selected); return 0; }
    if id >= ID_ENG_HW_GPU { if id <= ID_ENG_TIME_ON { lens_aether_apply_setting(id); return 0; } }
    if id == ID_ENG_REASON_DIRECT { lens_aether_apply_setting(id); return 0; }
    if id == ID_ENG_REASON_THINK { lens_aether_apply_setting(id); return 0; }
    if id >= ID_AEC_GEMMA270 { if id <= ID_AEC_TINY { lens_aether_catalog_select(id); return 0; } }
    if id == ID_AEC_GEMMA4E { lens_aether_catalog_select(id); return 0; }
    if id == ID_CAT_LLAMA32_1B { lens_catalog_select(cat_llama32_1b); return 0; }
    if id == ID_CAT_LLAMA32_3B { lens_catalog_select(cat_llama32_3b); return 0; }
    if id == ID_CAT_LLAMA31_8B { lens_catalog_select(cat_llama31_8b); return 0; }
    if id == ID_CAT_LLAMA33 { lens_catalog_select(cat_llama33); return 0; }
    if id == ID_CAT_LLAMA32V { lens_catalog_select(cat_llama32v); return 0; }
    if id == ID_CAT_QWEN3_17 { lens_catalog_select(cat_qwen3_17); return 0; }
    if id == ID_CAT_QWEN3_4 { lens_catalog_select(cat_qwen3_4); return 0; }
    if id == ID_CAT_QWEN25COD { lens_catalog_select(cat_qwen25cod); return 0; }
    if id == ID_CAT_MOONDREAM { lens_catalog_select(cat_moondream); return 0; }
    if id == ID_CAT_GRANITE32V { lens_catalog_select(cat_granite32v); return 0; }
    if id == ID_CAT_QWEN25VL3 { lens_catalog_select(cat_qwen25vl3); return 0; }
    if id == ID_CAT_GEMMA3_4 { lens_catalog_select(cat_gemma3_4); return 0; }
    if id == ID_CAT_PHI4MINI { lens_catalog_select(cat_phi4mini); return 0; }
    if id == ID_CAT_MISTRAL { lens_catalog_select(cat_mistral); return 0; }
    if id == ID_CAT_DEEPSEEK8 { lens_catalog_select(cat_deepseek8); return 0; }
    if id == ID_PULL { if load64(g_backend_display) == 1 { if load64(g_cloud_provider) == 1 { lens_set_status(st_hf_remote); return 0; } } lens_pull_model(); return 0; }
    if id == ID_DELETE {
        if load64(g_backend_display) == 1 { if load64(g_cloud_provider) == 1 { lens_set_status(st_hf_remote); return 0; } }
        if load64(g_backend_display) == 3 { gui_menu_drop(load64(g_hwnd), load64(g_btn_delete), load64(g_aether_catalog_menu), g_rect); }
        else { lens_delete_model(); }
        return 0;
    }
    if id == ID_SEND { lens_send_chat(); return 0; }
    if id == ID_STOP { lens_stop(); return 0; }
    if id == ID_ATTACH { lens_knowledge_menu_sync(); gui_menu_drop(load64(g_hwnd), load64(g_btn_attach), load64(g_add_menu), g_rect); return 0; }
    if id == ID_ADD_IMAGE { lens_attach_image(); return 0; }
    if id == ID_ADD_CLIPBOARD { if lens_paste_clipboard_image() == 0 { lens_set_status(st_clipfail); } return 0; }
    if id == ID_ADD_FOLDER { lens_attach_folder(); return 0; }
    if id == ID_CLEAR_IMAGE { lens_clear_image_attachment(); return 0; }
    if id == ID_ADD_FILES { lens_attach_text_file(); return 0; }
    if id == ID_ADD_CANVAS { lens_canvas_arm(0); return 0; }
    if id == ID_ADD_CANVAS_HTML { lens_canvas_arm(1); return 0; }
    if id == ID_ADD_CANVAS_SVG { lens_canvas_arm(2); return 0; }
    if id == ID_ADD_CANVAS_CSV { lens_canvas_arm(3); return 0; }
    if id == ID_TOOL_CALCULATOR { lens_calculator_show(); return 0; }
    if id == ID_TOOL_WEB_READER { lens_web_reader_show(); return 0; }
    if id == ID_TOOL_WEB_SEARCH { lens_web_search_show(); return 0; }
    if id == ID_VISION_AUTO { lens_set_vision_mode(0, st_helper_auto); return 0; }
    if id == ID_VISION_MOON { lens_set_vision_mode(1, st_helper_moon); return 0; }
    if id == ID_VISION_FIRST { lens_set_vision_mode(2, st_helper_first); return 0; }
    if id == ID_VISION_OFF { lens_set_vision_mode(3, st_helper_off); return 0; }
    if id == ID_KNOWLEDGE_FILE { lens_knowledge_index_file(); return 0; }
    if id == ID_KNOWLEDGE_FOLDER { lens_knowledge_index_folder(); return 0; }
    if id == ID_KNOWLEDGE_USE { lens_knowledge_toggle(); return 0; }
    if id == ID_KNOWLEDGE_SHOW { lens_knowledge_show(); return 0; }
    if id == ID_KNOWLEDGE_OPEN { ShellExecuteA(load64(g_hwnd), op_open, g_knowledge_dir, 0, 0, 1); return 0; }
    if id == ID_KNOWLEDGE_CLEAR { lens_knowledge_clear(); return 0; }
    if id == ID_INFO {
        if load64(g_info_visible) == 0 { store64(g_info_visible, 1); }
        else { store64(g_info_visible, 0); }
        GetClientRect(load64(g_hwnd), g_rect);
        lens_layout(load32(g_rect + 8), load32(g_rect + 12));
        lens_config_save();
        return 0;
    }
    if id == ID_PRIVACY { lens_privacy_menu_show(); return 0; }
    if id == ID_PRIVACY_SHOW { lens_privacy_show(); return 0; }
    if id == ID_PRIVACY_ROOT { ShellExecuteA(load64(g_hwnd), op_open, g_rootdir, 0, 0, 1); return 0; }
    if id == ID_PRIVACY_CHATS { ShellExecuteA(load64(g_hwnd), op_open, g_chatdir, 0, 0, 1); return 0; }
    if id == ID_PRIVACY_KNOWLEDGE { ShellExecuteA(load64(g_hwnd), op_open, g_knowledge_dir, 0, 0, 1); return 0; }
    if id == ID_PRIVACY_MODELS {
        p = str_copy(g_privacy_model_store, g_rootdir); str_copy(p, "\\models"); CreateDirectoryA(g_privacy_model_store, 0);
        ShellExecuteA(load64(g_hwnd), op_open, g_privacy_model_store, 0, 0, 1); return 0;
    }
    if id == ID_PRIVACY_ARENA { ShellExecuteA(load64(g_hwnd), op_open, g_arena_dir, 0, 0, 1); return 0; }
    if id == ID_PRIVACY_CLEAR_CHAT { lens_privacy_clear_chat(); return 0; }
    if id == ID_PRIVACY_CLEAR_KNOWLEDGE { lens_knowledge_clear(); return 0; }
    if id == ID_PRIVACY_CLEAR_PREVIEWS { lens_privacy_clear_previews(); return 0; }
    if id == ID_PRIVACY_CLEAR_WEBVIEW { lens_privacy_clear_webview(); return 0; }
    if id == ID_PRIVACY_CLEAR_ARENA { lens_arena_clear_history(); return 0; }
    if id == ID_ARENA { lens_arena_show(); return 0; }
    if id == ID_ARENA_SET_A { lens_arena_set_a(); return 0; }
    if id == ID_ARENA_SET_B { lens_arena_set_b(); return 0; }
    if id == ID_ARENA_RUN { lens_arena_start(); return 0; }
    if id == ID_ARENA_SHOW { lens_arena_show(); if load64(g_arena_complete) == 0 { lens_set_status(st_arena_none); } return 0; }
    if id == ID_ARENA_BLIND {
        if load64(g_arena_blind) == 0 { store64(g_arena_blind, 1); } else { store64(g_arena_blind, 0); }
        lens_config_save(); lens_arena_refresh_window(); return 0;
    }
    if id == ID_ARENA_HISTORY { lens_arena_show_history(); return 0; }
    if id == ID_ARENA_OPEN { ShellExecuteA(load64(g_hwnd), op_open, g_arena_dir, 0, 0, 1); return 0; }
    if id == ID_ARENA_CLEAR { lens_arena_clear_history(); return 0; }
    if id == ID_VOICE { lens_voice_menu_show(); return 0; }
    if id == ID_VOICE_START { lens_voice_start(); return 0; }
    if id == ID_VOICE_STOP { lens_voice_finish(1); return 0; }
    if id == ID_VOICE_CANCEL { lens_voice_finish(0); return 0; }
    if id == ID_VOICE_PLAY { lens_voice_play(); return 0; }
    if id == ID_VOICE_PLAY_STOP { lens_voice_stop_playback(); return 0; }
    if id == ID_VOICE_OPEN { ShellExecuteA(load64(g_hwnd), op_open, g_voice_dir, 0, 0, 1); return 0; }
    if id == ID_VOICE_DELETE { lens_voice_delete(); return 0; }
    if id == ID_VOICE_TRANSCRIBE { lens_voice_transcribe_start(); return 0; }
    if id == ID_VOICE_CANCEL_STT { lens_voice_transcribe_cancel(); return 0; }
    if id == ID_VOICE_REVIEW { lens_voice_review_show(); return 0; }
    if id == ID_VOICE_SPEAK_ANSWER { lens_tts_speak_answer(); return 0; }
    if id == ID_VOICE_SPEAK_COMPOSER { lens_tts_speak_composer(); return 0; }
    if id == ID_VOICE_STOP_SPEECH { lens_tts_stop(); return 0; }
    if id == ID_VOICE_REPLAY_SPEECH { lens_tts_replay(); return 0; }
    if id == ID_VOICE_DELETE_SPEECH { lens_tts_delete(); return 0; }
    if id == ID_HELP {
        lens_open_guide();
        return 0;
    }
    if id == ID_NEW { lens_chat_new(); return 0; }
    if id == ID_SAVE { lens_chat_save(); return 0; }
    if id == ID_SAVE_AS { lens_chat_save_as(); return 0; }
    if id == ID_LOAD { lens_chat_load_menu(); return 0; }
    if id == ID_LOAD_BROWSE { lens_chat_load_dialog(); return 0; }
    if id == ID_CHAT_OPEN_DIR { lens_chat_open_folder(); return 0; }
    if id == ID_CHAT_DUPLICATE { lens_chat_duplicate_current(); return 0; }
    if id == ID_BRANCH_CHAT { lens_chat_branch_current(); return 0; }
    if id == ID_CHAT_RENAME { lens_chat_rename_current(); return 0; }
    if id == ID_CHAT_DELETE { lens_chat_delete_current(); return 0; }
    if id == ID_RECENT_NONE { return 0; }
    if id >= ID_RECENT_0 { if id <= ID_RECENT_11 { lens_recent_load(id); return 0; } }
    if id == ID_EXPORT { lens_export_markdown(); return 0; }
    if id == ID_COPY { lens_copy_transcript(); return 0; }
    if id == ID_COPY_ANSWER { lens_copy_last_answer(); return 0; }
    if id == ID_EDIT_USER { lens_edit_last_user(); return 0; }
    if id == ID_CANCEL_EDIT { lens_cancel_staged_edit(); return 0; }
    if id == ID_REGENERATE { lens_regenerate_last_answer(); return 0; }
    if id == ID_CONTINUE { lens_continue_last_answer(); return 0; }
    if id == ID_DELETE_ANSWER { lens_delete_last_answer(); return 0; }
    if id == ID_COPY_USER { lens_copy_last_user(); return 0; }
    if id == ID_COPY_EXCHANGE { lens_copy_last_exchange(); return 0; }
    if id == ID_SAVE_ANSWER { lens_save_last_answer(); return 0; }
    if id == ID_COPY_METADATA { lens_copy_last_metadata(); return 0; }
    if id == ID_COPY_CODE { lens_copy_last_code(); return 0; }
    if id == ID_SAVE_CODE { lens_save_last_code(); return 0; }
    if id == ID_OPEN_CANVAS { lens_canvas_open_last_answer(); return 0; }
    if id == ID_PREVIEW_ARTIFACT { lens_preview_last_artifact(); return 0; }
    if id == ID_TOGGLE_REASONING { lens_toggle_reasoning(); return 0; }
    if id == ID_MODEL {
        if load64(g_backend_display) == 0 { lens_refresh_attachment_ui(); }
        else {
            lens_harvest_display();
            lens_update_cloud_info();
        }
        return 0;
    }
    if id == ID_ATTACH_PANEL {
        lens_attachment_preview_open();
        return 0;
    }
    return 0;
}

func LensWndProc(hwnd: i64, msg: i64, wp: i64, lp: i64) -> i64 {
    if msg == 1 { DragAcceptFiles(hwnd, 1); lens_create_controls(hwnd); return 0; }
    if msg == 5 { lens_layout(gui_loword(lp), gui_hiword(lp)); return 0; }
    if msg == 0x0233 { lens_drop_image(wp); return 0; }
    if msg == 256 { if wp == 0x70 { lens_open_guide(); return 0; } }
    if msg == 513 {
        if lens_attachment_hit(gui_loword(lp), gui_hiword(lp)) == 1 { lens_attachment_preview_open(); return 0; }
    }
    if msg == 123 {
        if wp == load64(g_trans_ed) {
            lens_answer_menu_sync();
            if lp == 0 - 1 { gui_menu_drop(hwnd, load64(g_trans_ed), load64(g_answer_menu), g_rect); }
            else { TrackPopupMenu(load64(g_answer_menu), 0, gui_loword(lp), gui_hiword(lp), 0, hwnd, 0); }
            return 0;
        }
    }
    if msg == 44 { return lens_measure_menu(lp); }
    if msg == 43 {
        if lens_draw_menu(lp) == 1 { return 1; }
        if load32(lp + 4) == ID_ATTACH_PANEL { return lens_draw_attachment(lp); }
        return lens_draw_button(lp);
    }
    if msg == 273 {
        lens_command(gui_loword(wp), gui_hiword(wp));
        return 0;
    }
    if msg == 78 {
        if load64(lp + 0) == load64(g_trans_ed) {
            code = band(load32(lp + 16), 4294967295);
            if code == 0x70B { lens_open_notified_link(lp); return 0; }
        }
        if load64(lp + 0) == load64(g_models) {
            if load64(g_backend_display) != 0 {
                if load64(g_backend_display) != 3 { lens_update_cloud_info(); return 0; }
            }
            code = band(load32(lp + 16), 4294967295);
            if code == 4294967294 {
                lens_update_selected_details();
                return 0;
            }
            if code == 4294967293 { lens_use_selected(); return 0; }
        }
        return 0;
    }
    if msg == 0x8001 { lens_finish_refresh(); return 0; }
    if msg == 0x8002 { lens_finish_chat(); return 0; }
    if msg == 0x8003 { lens_finish_pull(); return 0; }
    if msg == 0x8004 { lens_finish_delete(); return 0; }
    if msg == 0x800B { lens_voice_review_commit(); return 0; }
    if msg == 0x800C { lens_tts_finish(); return 0; }
    if msg == 0x800D { lens_web_finish(); return 0; }
    if msg == 0x800E { lens_search_finish(); return 0; }
    if msg == 0x8005 { lens_pull_progress(); return 0; }
    if msg == 0x8006 { lens_chat_progress(); return 0; }
    if msg == 0x8007 { lens_finish_show(); return 0; }
    if msg == 0x8008 { lens_finish_arena(); return 0; }
    if msg == 0x8009 { lens_arena_progress(wp); return 0; }
    if msg == 0x800A { lens_voice_transcribe_finish(); return 0; }
    if msg == 275 {
        if wp == 21 { if load64(g_busy_kind) == 2 { lens_pulse_render(); } else { KillTimer(hwnd, 21); } }
        if wp == 22 { lens_voice_tick(); }
        return 0;
    }
    if msg == 307 {
        if lp == load64(g_url_ed) { SetTextColor(wp, COLOR_TEXT); SetBkColor(wp, COLOR_EDIT); return load64(g_br_edit); }
        if lp == load64(g_model_ed) { SetTextColor(wp, COLOR_TEXT); SetBkColor(wp, COLOR_EDIT); return load64(g_br_edit); }
        if lp == load64(g_chatname_ed) { SetTextColor(wp, COLOR_TEXT); SetBkColor(wp, COLOR_EDIT); return load64(g_br_edit); }
        SetTextColor(wp, COLOR_TEXT); SetBkColor(wp, COLOR_PANEL); return load64(g_br_panel);
    }
    if msg == 312 {
        if lp == load64(g_info_ed) { SetTextColor(wp, COLOR_TEXT); SetBkColor(wp, COLOR_EDIT); return load64(g_br_edit); }
        SetTextColor(wp, COLOR_TEXT); SetBkColor(wp, COLOR_PANEL); return load64(g_br_panel);
    }
    if msg == 308 {
        SetTextColor(wp, COLOR_TEXT); SetBkColor(wp, COLOR_EDIT); return load64(g_br_edit);
    }
    if msg == 15 {
        hdc = BeginPaint(hwnd, g_ps);
        GetClientRect(hwnd, g_rect);
        w = load32(g_rect + 8);
        h = load32(g_rect + 12);
        gdi_fill_xy(hdc, 0, 0, w, h, load64(g_br_bg));
        gdi_fill_xy(hdc, 0, 0, 372, h, load64(g_br_panel));
        gdi_line(hdc, 372, 0, 372, h, load64(g_pen_line));
        EndPaint(hwnd, g_ps);
        return 0;
    }
    if msg == 20 { return 1; }
    if msg == 16 {
        if lens_canvas_close() == 0 { return 0; }
        DestroyWindow(hwnd);
        return 0;
    }
    if msg == 2 {
        DragAcceptFiles(hwnd, 0);
        KillTimer(hwnd, 21);
        KillTimer(hwnd, 22);
        lens_voice_stt_shutdown();
        lens_tts_shutdown();
        lens_web_shutdown();
        lens_search_shutdown();
        lwv2_shutdown();
        lens_voice_cancel_quiet();
        PlaySoundA(0, 0, 0);
        lens_harvest_all();
        lens_config_save();
        lens_aether_stop_owned();
        PostQuitMessage(0);
        return 0;
    }
    return DefWindowProcA(hwnd, msg, wp, lp);
}

func lens_message_loop(msgbuf: ptr) -> i32 {
    while GetMessageA(msgbuf, 0, 0, 0) != 0 {
        if load64(msgbuf + 0) == load64(g_input_ed) {
            if load32(msgbuf + 8) == 256 {
                if load64(msgbuf + 16) == 13 {
                    if gui_key_down(16) == 0 {
                        lens_send_chat();
                        continue;
                    }
                }
                if load64(msgbuf + 16) == 86 {
                    if gui_key_down(17) != 0 {
                        if lens_paste_clipboard_image() == 1 {
                            continue;
                        }
                    }
                }
            }
        }
        TranslateMessage(msgbuf);
        DispatchMessageA(msgbuf);
    }
    return 0;
}

func main() -> i32 {
    lens_paths_init();
    lens_build_filters();
    if lens_alloc_buffers() == 0 { return 1; }
    lens_config_load();
    startup_backend = load64(g_backend);
    startup_cloud = load64(g_cloud_provider);
    str_copy(g_startup_cloud_url, g_openai_url);
    str_copy(g_startup_cloud_model, g_openai_model);
    lt_target_init();
    lens_apply_ollama_url();

    store64(g_br_bg, CreateSolidBrush(COLOR_BG));
    store64(g_br_panel, CreateSolidBrush(COLOR_PANEL));
    store64(g_br_card, CreateSolidBrush(COLOR_CARD));
    store64(g_br_hover, CreateSolidBrush(COLOR_HOVER));
    store64(g_br_accent, CreateSolidBrush(COLOR_ACCENT));
    store64(g_br_arena, CreateSolidBrush(COLOR_ARENA));
    store64(g_br_arena_dark, CreateSolidBrush(COLOR_ARENA_DARK));
    store64(g_br_record, CreateSolidBrush(COLOR_RECORD));
    store64(g_br_edit, CreateSolidBrush(COLOR_EDIT));
    store64(g_pen_line, CreatePen(0, 1, COLOR_LINE));
    store64(g_pen_accent, CreatePen(0, 1, COLOR_ACCENT));
    store64(g_pen_arena, CreatePen(0, 1, COLOR_ARENA));
    store64(g_pen_record, CreatePen(0, 1, COLOR_RECORD));
    store64(g_pen_combo_arrow, CreatePen(0, 1, COLOR_TEXT));
    store64(g_font_ui, gdi_make_font(0 - 14, 400, face_ui));
    store64(g_font_bold, gdi_make_font(0 - 17, 700, face_ui));
    store64(g_font_mono, gdi_make_font(0 - 15, 400, face_mono));
    lens_enable_dark_app();

    hinst = GetModuleHandleA(0);
    store64(g_hinst, hinst);
    cursor = LoadCursorA(0, 32512);
    gui_init_common_controls(1);
    gui_register_class(g_wc, cls_main, &LensWndProc, hinst, cursor, load64(g_br_bg));
    gui_register_class(g_preview_wc, cls_preview, &LensPreviewProc, hinst, cursor, load64(g_br_bg));
    gui_register_class(g_doc_preview_wc, cls_doc_preview, &LensDocumentPreviewProc, hinst, cursor, load64(g_br_bg));
    gui_register_class(g_canvas_wc, cls_canvas, &LensCanvasProc, hinst, cursor, load64(g_br_bg));
    gui_register_class(g_calculator_wc, cls_calculator, &LensCalculatorProc, hinst, cursor, load64(g_br_bg));
    gui_register_class(g_web_reader_wc, cls_web_reader, &LensWebReaderProc, hinst, cursor, load64(g_br_bg));
    gui_register_class(g_web_search_wc, cls_web_search, &LensWebSearchProc, hinst, cursor, load64(g_br_bg));
    gui_register_class(g_arena_wc, cls_arena, &LensArenaProc, hinst, cursor, load64(g_br_bg));
    gui_register_class(g_voice_review_wc, cls_voice_review, &LensVoiceReviewProc, hinst, cursor, load64(g_br_bg));
    hwnd = CreateWindowExA(0, cls_main, title_app, 0x16CF0000, 80, 60, 1320, 780, 0, 0, hinst, 0);
    store64(g_hwnd, hwnd);
    if hwnd == 0 { return 1; }
    # Some Win32 control initialization uses the shared scratch/config area.
    # Re-apply the already validated saved Engine choice before the definitive
    # startup sync and refresh so a session never falls back to the seed model.
    if load8(g_saved_aether_model) != 0 { str_copy(g_aether_model, g_saved_aether_model); }
    store64(g_backend, startup_backend);
    store64(g_backend_display, startup_backend);
    store64(g_cloud_provider, startup_cloud);
    str_copy(g_openai_url, g_startup_cloud_url);
    str_copy(g_openai_model, g_startup_cloud_model);
    lens_sync_backend_controls();
    lens_set_app_icon(hwnd);
    store32(g_dwm_dark, 1);
    DwmSetWindowAttribute(hwnd, 20, g_dwm_dark, 4);
    DwmSetWindowAttribute(hwnd, 19, g_dwm_dark, 4);
    ShowWindow(hwnd, 1);
    UpdateWindow(hwnd);
    lens_first_run_guidance();
    lens_refresh_models();
    lens_message_loop(g_msg);

    lens_document_preview_close();
    lens_canvas_close();
    if load64(g_calc_hwnd) != 0 { DestroyWindow(load64(g_calc_hwnd)); }
    if load64(g_web_hwnd) != 0 { DestroyWindow(load64(g_web_hwnd)); }
    if load64(g_search_hwnd) != 0 { DestroyWindow(load64(g_search_hwnd)); }
    lens_image_preview_close();
    lens_arena_close();
    if load64(g_voice_review_hwnd) != 0 { DestroyWindow(load64(g_voice_review_hwnd)); }

    gdi_delete(load64(g_font_ui));
    gdi_delete(load64(g_font_bold));
    gdi_delete(load64(g_font_mono));
    gdi_delete(load64(g_br_bg));
    gdi_delete(load64(g_br_panel));
    gdi_delete(load64(g_br_card));
    gdi_delete(load64(g_br_hover));
    gdi_delete(load64(g_br_accent));
    gdi_delete(load64(g_br_arena));
    gdi_delete(load64(g_br_arena_dark));
    gdi_delete(load64(g_br_record));
    gdi_delete(load64(g_br_edit));
    gdi_delete(load64(g_pen_line));
    gdi_delete(load64(g_pen_accent));
    gdi_delete(load64(g_pen_arena));
    gdi_delete(load64(g_pen_record));
    gdi_delete(load64(g_pen_combo_arrow));
    if load64(g_gdip_tok) != 0 { GdiplusShutdown(load64(g_gdip_tok)); }
    lens_free_buffers();
    return 0;
}
