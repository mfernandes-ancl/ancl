    if lens_extract_last_answer() == 0 { lens_set_status(st_no_answer); return 0; }
    gui_clip_write_text(load64(g_hwnd), load64(g_code_p), strlen(load64(g_code_p)));
    lens_set_status(st_answer_copied);
    return 1;
}

func lens_toggle_reasoning() -> i64 {
    if load64(g_reasoning_visible) == 0 { store64(g_reasoning_visible, 1); lens_set_status(st_reason_show); }
    else { store64(g_reasoning_visible, 0); lens_set_status(st_reason_hide); }
    lens_config_save();
    lens_refresh_transcript();
    return 1;
}

func lens_answer_menu_sync() -> i64 {
    menu = load64(g_answer_menu);
    CheckMenuItem(menu, ID_TOGGLE_REASONING, 0);
    if load64(g_reasoning_visible) == 1 { CheckMenuItem(menu, ID_TOGGLE_REASONING, 8); }
    return 0;
}

func lens_source_pos_from_rich(src: i64, target: i64) -> i64 {
    i = 0;
    rp = 0;
    while load8(src + i) != 0 {
        if rp >= target { return i; }
        if load8(src + i) == 13 {
            if load8(src + i + 1) == 10 { i = i + 2; }
            else { i = i + 1; }
        } else { i = i + 1; }
        rp = rp + 1;
    }
    return i;
}

func lens_asset_rel_ok(rel: i64) -> i64 {
    if lens_starts_with_ci(rel, asset_rel_root) == 0 { return 0; }
    i = 0;
    while load8(rel + i) != 0 {
        c = load8(rel + i);
        if c == 58 { return 0; }
        if c == 47 { return 0; }
        if c == 46 { if load8(rel + i + 1) == 46 { return 0; } }
        i = i + 1;
    }
    return 1;
}

func lens_asset_full_path(rel: i64) -> i64 {
    if lens_asset_rel_ok(rel) == 0 { return 0; }
    p = str_copy(g_asset_path, g_chatdir);
    store8(p, 92);
    p = p + 1;
    str_copy(p, rel);
    if GetFileAttributesA(g_asset_path) == 0xFFFFFFFF { return 0; }
    return 1;
}

func lens_open_image_asset(rel: i64) -> i64 {
    if lens_asset_full_path(rel) == 0 { lens_set_status(st_asset_missing); return 1; }
    if lens_preview_load(g_asset_path) == 0 { lens_set_status(st_imgfail); return 1; }
    lens_image_preview_open();
    return 1;
}

func lens_open_document_asset(rel: i64) -> i64 {
    if lens_asset_full_path(rel) == 0 { lens_set_status(st_asset_missing); return 1; }
    lens_document_preview_open_path(g_asset_path);
    return 1;
}

func lens_open_notified_link(note: i64) -> i64 {
    if load32(note + 24) != 514 { return 0; }
    first = load32(note + 48);
    last = load32(note + 52);
    if last <= first { return 0; }
    if last - first > 1000 { last = first + 1000; }
    store32(g_link_range + 0, first);
    store32(g_link_range + 4, last);
    store64(g_link_range + 8, g_tmp);
    SendMessageA(load64(g_trans_ed), 0x44B, 0, g_link_range);
    if lens_starts_with_ci(g_tmp, "http://") == 0 { if lens_starts_with_ci(g_tmp, "https://") == 0 {
    if lens_starts_with_ci(g_tmp, asset_img_scheme) == 0 { if lens_starts_with_ci(g_tmp, asset_doc_scheme) == 0 { if lens_starts_with_ci(g_tmp, knowledge_scheme) == 0 {
        src = load64(g_transcript_p);
        sp = lens_source_pos_from_rich(src, first);
        if sp <= 0 { return 0; }
        if load8(src + sp - 1) != 91 { return 0; }
        mid = lens_md_find(src, sp, strlen(src), "](");
        if mid < 0 { return 0; }
        close = lens_md_find(src, mid + 2, strlen(src), ")");
        if close < 0 { return 0; }
        lens_copy_span(g_tmp, src, mid + 2, close, 1000);
    } } } } }
    if lens_starts_with_ci(g_tmp, asset_img_scheme) == 1 {
        return lens_open_image_asset(g_tmp + strlen(asset_img_scheme));
    }
    if lens_starts_with_ci(g_tmp, asset_doc_scheme) == 1 {
        return lens_open_document_asset(g_tmp + strlen(asset_doc_scheme));
    }
    if lens_starts_with_ci(g_tmp, knowledge_scheme) == 1 {
        return lens_open_knowledge_excerpt(g_tmp + strlen(knowledge_scheme));
    }
    if lens_starts_with_ci(g_tmp, "http://") == 0 { if lens_starts_with_ci(g_tmp, "https://") == 0 { return 0; } }
    p = str_copy(g_tmp2, link_msg_a);
    str_copy(p, g_tmp);
    if MessageBoxA(load64(g_hwnd), g_tmp2, link_title, 0x24) != 6 { return 1; }
    ShellExecuteA(load64(g_hwnd), op_open, g_tmp, 0, 0, 1);
    return 1;
}

func lens_lower(c: i64) -> i64 {
    if c >= 65 { if c <= 90 { return c + 32; } }
    return c;
}

func lens_starts_with_ci(s: i64, prefix: i64) -> i64 {
    i = 0;
    while 1 {
        c = load8(prefix + i);
        if c == 0 { return 1; }
        if load8(s + i) == 0 { return 0; }
        if lens_lower(load8(s + i)) != lens_lower(c) { return 0; }
        i = i + 1;
    }
    return 0;
}

func lens_ends_with_ci(s: i64, suf: i64) -> i64 {
    ls = strlen(s);
    lf2 = strlen(suf);
    if lf2 > ls { return 0; }
    i = 0;
    while i < lf2 {
        if lens_lower(load8(s + ls - lf2 + i)) != lens_lower(load8(suf + i)) { return 0; }
        i = i + 1;
    }
    return 1;
}

func lens_set_img_mime(path: i64) -> i64 {
    str_copy(g_img_mime, mime_png);
    if lens_ends_with_ci(path, ext_jpg) == 1 { str_copy(g_img_mime, mime_jpeg); }
    if lens_ends_with_ci(path, ext_jpeg) == 1 { str_copy(g_img_mime, mime_jpeg); }
    if lens_ends_with_ci(path, ext_gif) == 1 { str_copy(g_img_mime, mime_gif); }
    if lens_ends_with_ci(path, ext_webp) == 1 { str_copy(g_img_mime, mime_webp); }
    return 0;
}

func lens_supported_text_file(path: i64) -> i64 {
    if lens_ends_with_ci(path, md_ext) == 1 { return 1; }
    if lens_ends_with_ci(path, ext_ancl) == 1 { return 1; }
    if lens_ends_with_ci(path, ext_txt) == 1 { return 1; }
    if lens_ends_with_ci(path, ext_csv) == 1 { return 1; }
    if lens_ends_with_ci(path, ext_json) == 1 { return 1; }
    if lens_ends_with_ci(path, ext_xml) == 1 { return 1; }
    if lens_ends_with_ci(path, ext_html) == 1 { return 1; }
    if lens_ends_with_ci(path, ext_htm) == 1 { return 1; }
    if lens_ends_with_ci(path, ext_log) == 1 { return 1; }
    if lens_ends_with_ci(path, ext_ini) == 1 { return 1; }
    if lens_ends_with_ci(path, ext_cfg) == 1 { return 1; }
    if lens_ends_with_ci(path, ext_yaml) == 1 { return 1; }
    if lens_ends_with_ci(path, ext_yml) == 1 { return 1; }
    return 0;
}

func lens_file_name_from_path(path: i64, dst: i64, cap: i64) -> i64 {
    bs = lens_last_bs(path);
    start = 0;
    if bs >= 0 { start = bs + 1; }
    i = start;
    j = 0;
    lim = cap - 1;
    while j < lim {
        c = load8(path + i);
        if c == 0 { break; }
        store8(dst + j, c);
        i = i + 1;
        j = j + 1;
    }
    if j == 0 { return str_copy(dst, "attached.txt"); }
    store8(dst + j, 0);
    return j;
}

func lens_snapshot_append(s: i64) -> i64 {
    dst = load64(g_file_text_p);
    d = strlen(dst);
    i = 0;
    while d < 48000 {
        c = load8(s + i);
        if c == 0 { store8(dst + d, 0); return 1; }
        store8(dst + d, c);
        d = d + 1;
        i = i + 1;
    }
    store8(dst + d, 0);
    store64(g_folder_truncated, 1);
    return 0;
}

func lens_rel_join(dst: i64, rel: i64, name: i64) -> i64 {
    if load8(rel) == 0 {
        str_copy(dst, name);
        return 0;
    }
    p = str_copy(dst, rel);
    store8(p, 92);
    p = p + 1;
    str_copy(p, name);
    return 0;
}

func lens_path_join2(dst: i64, base: i64, name: i64) -> i64 {
    p = str_copy(dst, base);
    store8(p, 92);
    p = p + 1;
    str_copy(p, name);
    return 0;
}

func lens_folder_skip_dir(name: i64) -> i64 {
    if load8(name) == 46 {
        if load8(name + 1) == 0 { return 1; }
        if load8(name + 1) == 46 { if load8(name + 2) == 0 { return 1; } }
    }
    if strcmp(name, skip_dotgit) == 0 { return 1; }
    if strcmp(name, skip_node) == 0 { return 1; }
    if strcmp(name, skip_bin) == 0 { return 1; }
    if strcmp(name, skip_build) == 0 { return 1; }
    if strcmp(name, skip_dist) == 0 { return 1; }
    if strcmp(name, skip_target) == 0 { return 1; }
    if strcmp(name, skip_pycache) == 0 { return 1; }
    return 0;
}

func lens_snapshot_append_file(path: i64, rel: i64) -> i64 {
    if load64(g_folder_truncated) != 0 { return 0; }
    if load64(g_folder_files) >= 16 { store64(g_folder_truncated, 1); return 0; }
    n = lens_read_file(path, load64(g_filebuf_p), 8192);
    if n <= 0 { return 0; }
    lens_snapshot_append(folder_list_a);
    lens_snapshot_append(rel);
    lens_snapshot_append("\n");
    lens_snapshot_append(folder_file_a);
    lens_snapshot_append(rel);
    lens_snapshot_append(folder_file_b);
    lens_snapshot_append(load64(g_filebuf_p));
    if n >= 8191 { lens_snapshot_append(folder_trunc); }
    lens_snapshot_append(file_ctx_c);
    store64(g_folder_files, load64(g_folder_files) + 1);
    return 1;
}

func lens_folder_scan_dir(dir: i64, rel: i64, depth: i64) -> i64 {
    if load64(g_folder_truncated) != 0 { return 0; }
    if depth > 3 { return 0; }
    findbuf = g_folder_finds + depth * 320;
    glob = g_folder_globs + depth * 900;
    childpath = g_folder_paths + depth * 900;
    childrel = g_folder_rels + depth * 512;

    p = str_copy(glob, dir);
    store8(p, 92);
    p = p + 1;
    str_copy(p, "*.*");
    h = FindFirstFileA(glob, findbuf);
    if h == 0 - 1 { return 0; }
    while 1 {
        name = findbuf + 44;
        attr = load32(findbuf + 0);
        if band(attr, 16) != 0 {
            if depth < 3 {
                if lens_folder_skip_dir(name) == 0 {
                    lens_path_join2(childpath, dir, name);
                    lens_rel_join(childrel, rel, name);
                    lens_folder_scan_dir(childpath, childrel, depth + 1);
                }
            }
        } else {
            lens_path_join2(childpath, dir, name);
            lens_rel_join(childrel, rel, name);
            if lens_supported_text_file(childpath) == 1 { lens_snapshot_append_file(childpath, childrel); }
        }
        if load64(g_folder_truncated) != 0 { break; }
        if FindNextFileA(h, findbuf) == 0 { break; }
    }
    FindClose(h);
    return 1;
}

func lens_attach_folder_path(path: i64) -> i64 {
    store8(load64(g_file_text_p), 0);
    store64(g_folder_files, 0);
    store64(g_folder_truncated, 0);
    lens_file_name_from_path(path, g_file_name, 256);
    lens_snapshot_append(folder_intro_a);
    lens_snapshot_append(path);
    lens_snapshot_append(folder_intro_b);
    store8(g_folder_rels, 0);
    lens_folder_scan_dir(path, g_folder_rels, 0);
    if load64(g_folder_files) == 0 { lens_snapshot_append("\n[lens] No supported text/code files found.\n"); }
    if load64(g_folder_truncated) != 0 { lens_snapshot_append(folder_trunc); }
    store64(g_has_file, 1);
    store64(g_file_kind, 2);
    store64(g_file_bytes, strlen(load64(g_file_text_p)));
    lens_refresh_attachment_ui();
    GetClientRect(load64(g_hwnd), g_rect);
    lens_layout(load32(g_rect + 8), load32(g_rect + 12));
    lens_append_note(st_folderattach);
    lens_refresh_transcript();
    lens_set_status(st_folderattach);
    return 1;
}

func lens_attach_folder() -> i64 {
    if load64(g_busy) != 0 { lens_set_status(st_busy); return 0; }
    memset(g_browse_info, 0, 64);
    store64(g_browse_info + 0, load64(g_hwnd));
    store64(g_browse_info + 16, g_folder_display);
    store64(g_browse_info + 24, folder_title);
    store32(g_browse_info + 32, 0x41);
    pidl = SHBrowseForFolderA(g_browse_info);
    if pidl == 0 { return 0; }
    ok = SHGetPathFromIDListA(pidl, g_folderpath);
    CoTaskMemFree(pidl);
    if ok == 0 { lens_set_status(st_folderfail); return 0; }
    return lens_attach_folder_path(g_folderpath);
}

# ---------------------------------------------------------------------
# R3 local knowledge: explicit portable corpus + bounded lexical search.
# ---------------------------------------------------------------------
func lens_knowledge_supported(path: i64) -> i64 {
    if lens_supported_text_file(path) == 1 { return 1; }
    if lens_ends_with_ci(path, ext_csv) == 1 { return 1; }
    if lens_ends_with_ci(path, ext_json) == 1 { return 1; }
    if lens_ends_with_ci(path, ext_xml) == 1 { return 1; }
    if lens_ends_with_ci(path, ext_html) == 1 { return 1; }
    if lens_ends_with_ci(path, ext_htm) == 1 { return 1; }
    if lens_ends_with_ci(path, ext_log) == 1 { return 1; }
    if lens_ends_with_ci(path, ext_ini) == 1 { return 1; }
    if lens_ends_with_ci(path, ext_cfg) == 1 { return 1; }
    if lens_ends_with_ci(path, ext_yaml) == 1 { return 1; }
    if lens_ends_with_ci(path, ext_yml) == 1 { return 1; }
    return 0;
}

func lens_knowledge_is_binary(src: i64, n: i64) -> i64 {
    i = 0;
    while i < n {
        if load8(src + i) == 0 { return 1; }
        i = i + 1;
    }
    return 0;
}

func lens_knowledge_manifest_append(s: i64) -> i64 {
    dst = load64(g_knowledge_manifest_p);
    d = strlen(dst);
    i = 0;
    while d < 262143 {
        c = load8(s + i);
        if c == 0 { store8(dst + d, 0); return 1; }
        store8(dst + d, c);
        d = d + 1;
        i = i + 1;
    }
    store8(dst + d, 0);
    return 0;
}

func lens_knowledge_clean_dir(dir: i64) -> i64 {
    p = str_copy(g_knowledge_glob, dir);
    store8(p, 92);
    p = p + 1;
    str_copy(p, "*.*");
    h = FindFirstFileA(g_knowledge_glob, g_knowledge_find);
    if h == 0 - 1 { return 0; }
    while 1 {
        if band(load32(g_knowledge_find), 16) == 0 {
            lens_path_join2(g_knowledge_doc_path, dir, g_knowledge_find + 44);
            DeleteFileA(g_knowledge_doc_path);
        }
        if FindNextFileA(h, g_knowledge_find) == 0 { break; }
    }
    FindClose(h);
    return 1;
}

func lens_knowledge_begin(root: i64) -> i64 {
    lens_set_status(st_knowledge_indexing);
    CreateDirectoryA(g_knowledge_dir, 0);
    CreateDirectoryA(g_knowledge_docs_dir, 0);
    CreateDirectoryA(g_knowledge_excerpt_dir, 0);
    lens_knowledge_clean_dir(g_knowledge_docs_dir);
    lens_knowledge_clean_dir(g_knowledge_excerpt_dir);
    DeleteFileA(g_knowledge_manifest_path);
    store64(g_knowledge_files, 0);
    store64(g_knowledge_bytes, 0);
    store64(g_knowledge_skipped, 0);
    p = str_copy(load64(g_knowledge_manifest_p), knowledge_header);
    p = str_copy(p, knowledge_root_a);
    p = str_copy(p, root);
    str_copy(p, lf);
    return 1;
}

func lens_knowledge_safe_path(src: i64) -> i64 {
    lens_copy_str(g_knowledge_source_path, src, 900);
    i = 0;
    while load8(g_knowledge_source_path + i) != 0 {
        c = load8(g_knowledge_source_path + i);
        if c == 9 { store8(g_knowledge_source_path + i, 32); }
        if c == 10 { store8(g_knowledge_source_path + i, 32); }
        if c == 13 { store8(g_knowledge_source_path + i, 32); }
        i = i + 1;
    }
    return 1;
}

func lens_knowledge_add_file(path: i64) -> i64 {
    if load64(g_knowledge_files) >= 96 { store64(g_knowledge_skipped, load64(g_knowledge_skipped) + 1); return 0; }
    n = lens_read_file(path, load64(g_knowledge_doc_p), 262145);
    if n <= 0 { store64(g_knowledge_skipped, load64(g_knowledge_skipped) + 1); return 0; }
    if n >= 262144 { store64(g_knowledge_skipped, load64(g_knowledge_skipped) + 1); return 0; }
    if load64(g_knowledge_bytes) + n > 4194304 { store64(g_knowledge_skipped, load64(g_knowledge_skipped) + 1); return 0; }
    if lens_knowledge_is_binary(load64(g_knowledge_doc_p), n) == 1 { store64(g_knowledge_skipped, load64(g_knowledge_skipped) + 1); return 0; }

    p = str_copy(g_knowledge_doc_name, knowledge_doc_prefix);
    int_to_str(g_tmp, load64(g_knowledge_files) + 1);
    p = str_copy(p, g_tmp);
    str_copy(p, knowledge_doc_ext);
    lens_path_join2(g_knowledge_doc_path, g_knowledge_docs_dir, g_knowledge_doc_name);
    if lens_write_file(g_knowledge_doc_path, load64(g_knowledge_doc_p), n) == 0 {
        store64(g_knowledge_skipped, load64(g_knowledge_skipped) + 1);
        return 0;
    }
    lens_knowledge_safe_path(path);
    lens_knowledge_manifest_append(g_knowledge_doc_name);
    lens_knowledge_manifest_append("\t");
    lens_knowledge_manifest_append(g_knowledge_source_path);
    lens_knowledge_manifest_append("\t");
    int_to_str(g_tmp, n);
    lens_knowledge_manifest_append(g_tmp);
    lens_knowledge_manifest_append(lf);
    store64(g_knowledge_files, load64(g_knowledge_files) + 1);
    store64(g_knowledge_bytes, load64(g_knowledge_bytes) + n);
    return 1;
}

func lens_knowledge_finish() -> i64 {
    lens_write_file(g_knowledge_manifest_path, load64(g_knowledge_manifest_p), strlen(load64(g_knowledge_manifest_p)));
    if load64(g_knowledge_files) == 0 {
        store64(g_knowledge_enabled, 0);
        lens_config_save();
        lens_set_status(st_knowledge_empty);
        return 0;
    }
    store64(g_knowledge_enabled, 1);
    lens_config_save();
    p = str_copy(g_tmp2, st_knowledge_done_a);
    int_to_str(g_tmp, load64(g_knowledge_files)); p = str_copy(p, g_tmp);
    p = str_copy(p, st_knowledge_done_b);
    lens_size_text(load64(g_knowledge_bytes), g_tmp); p = str_copy(p, g_tmp);
    if load64(g_knowledge_skipped) > 0 {
        p = str_copy(p, " (skipped "); int_to_str(g_tmp, load64(g_knowledge_skipped)); p = str_copy(p, g_tmp); p = str_copy(p, ")");
    }
    str_copy(p, st_knowledge_done_c);
    lens_set_status(g_tmp2);
    return 1;
}

func lens_knowledge_scan_dir(dir: i64, rel: i64, depth: i64) -> i64 {
    if depth > 6 { return 0; }
    if load64(g_knowledge_files) >= 96 { return 0; }
    if load64(g_knowledge_bytes) >= 4194304 { return 0; }
    findbuf = g_knowledge_find + depth * 320;
    glob = g_knowledge_glob + depth * 900;
    childpath = g_knowledge_paths + depth * 900;
    childrel = g_knowledge_rels + depth * 900;
    p = str_copy(glob, dir); store8(p, 92); p = p + 1; str_copy(p, "*.*");
    h = FindFirstFileA(glob, findbuf);
    if h == 0 - 1 { return 0; }
    while 1 {
        name = findbuf + 44;
        attr = load32(findbuf);
        if band(attr, 16) != 0 {
            if depth < 6 { if lens_folder_skip_dir(name) == 0 {
                lens_path_join2(childpath, dir, name);
                lens_rel_join(childrel, rel, name);
                lens_knowledge_scan_dir(childpath, childrel, depth + 1);
            } }
        } else {
            lens_path_join2(childpath, dir, name);
            if lens_knowledge_supported(childpath) == 1 { lens_knowledge_add_file(childpath); }
        }
        if load64(g_knowledge_files) >= 96 { break; }
        if load64(g_knowledge_bytes) >= 4194304 { break; }
        if FindNextFileA(h, findbuf) == 0 { break; }
    }
    FindClose(h);
    return 1;
}

func lens_knowledge_index_file_path(path: i64) -> i64 {
    if lens_knowledge_supported(path) == 0 { lens_set_status(st_filetype); return 0; }
    lens_knowledge_begin(path);
    lens_knowledge_add_file(path);
    return lens_knowledge_finish();
}

func lens_knowledge_index_file() -> i64 {
    if load64(g_busy) != 0 { lens_set_status(st_busy); return 0; }
    memset(g_ofn, 0, 152);
    store32(g_ofn, 152); store64(g_ofn + 8, load64(g_hwnd));
    store64(g_ofn + 24, g_text_filter); store32(g_ofn + 44, 1);
    store64(g_ofn + 48, g_textpath); store32(g_ofn + 56, 900);
    store64(g_ofn + 88, knowledge_file_title); store32(g_ofn + 96, 0x1804);
    store8(g_textpath, 0);
    if GetOpenFileNameA(g_ofn) == 0 { return 0; }
    return lens_knowledge_index_file_path(g_textpath);
}

func lens_knowledge_index_folder_path(path: i64) -> i64 {
    lens_knowledge_begin(path);
    store8(g_knowledge_rels, 0);
    lens_knowledge_scan_dir(path, g_knowledge_rels, 0);
    return lens_knowledge_finish();
}

func lens_knowledge_index_folder() -> i64 {
    if load64(g_busy) != 0 { lens_set_status(st_busy); return 0; }
    memset(g_browse_info, 0, 64);
    store64(g_browse_info, load64(g_hwnd));
    store64(g_browse_info + 16, g_folder_display);
    store64(g_browse_info + 24, knowledge_folder_title);
    store32(g_browse_info + 32, 0x41);
    pidl = SHBrowseForFolderA(g_browse_info);
    if pidl == 0 { return 0; }
    ok = SHGetPathFromIDListA(pidl, g_folderpath);
    CoTaskMemFree(pidl);
    if ok == 0 { lens_set_status(st_folderfail); return 0; }
    return lens_knowledge_index_folder_path(g_folderpath);
}

func lens_knowledge_manifest_stats() -> i64 {
    store64(g_knowledge_files, 0);
    store64(g_knowledge_bytes, 0);
    n = lens_read_file(g_knowledge_manifest_path, load64(g_knowledge_manifest_p), 262144);
    if n <= 0 { return 0; }
    src = load64(g_knowledge_manifest_p);
    i = 0;
    while i < n {
        le = i; while le < n { if load8(src + le) == 10 { break; } le = le + 1; }
        t1 = i; while t1 < le { if load8(src + t1) == 9 { break; } t1 = t1 + 1; }
        if t1 < le {
            t2 = t1 + 1; while t2 < le { if load8(src + t2) == 9 { break; } t2 = t2 + 1; }
            if t2 < le {
                store64(g_knowledge_files, load64(g_knowledge_files) + 1);
                store64(g_knowledge_bytes, load64(g_knowledge_bytes) + str_to_int(src + t2 + 1));
            }
        }
        i = le + 1;
    }
    return load64(g_knowledge_files);
}

func lens_knowledge_preview_append(s: i64) -> i64 {
    dst = load64(g_doc_preview_p); d = strlen(dst); i = 0;
    while d < 262143 { c = load8(s + i); if c == 0 { store8(dst + d, 0); return 1; } store8(dst + d, c); d = d + 1; i = i + 1; }
    store8(dst + d, 0); return 0;
}

func lens_knowledge_preview_span(src: i64, first: i64, last: i64) -> i64 {
    dst = load64(g_doc_preview_p); d = strlen(dst); i = first;
    while i < last { if d >= 262143 { break; } store8(dst + d, load8(src + i)); d = d + 1; i = i + 1; }
    store8(dst + d, 0); return 1;
}

func lens_knowledge_show() -> i64 {
    if lens_knowledge_manifest_stats() == 0 { lens_set_status(st_knowledge_none); return 0; }
    src = load64(g_knowledge_manifest_p);
    p = str_copy(load64(g_doc_preview_p), knowledge_preview_a);
    if load64(g_knowledge_enabled) == 1 { p = str_copy(p, knowledge_preview_state_on); }
    else { p = str_copy(p, knowledge_preview_state_off); }
    p = str_copy(p, knowledge_preview_storage); p = str_copy(p, g_knowledge_dir); p = str_copy(p, knowledge_preview_caps);
    i = 0; n = strlen(src);
    while i < n {
        le = i; while le < n { if load8(src + le) == 10 { break; } le = le + 1; }
        t1 = i; while t1 < le { if load8(src + t1) == 9 { break; } t1 = t1 + 1; }
        if t1 < le {
            t2 = t1 + 1; while t2 < le { if load8(src + t2) == 9 { break; } t2 = t2 + 1; }
            if t2 < le {
                lens_knowledge_preview_append(knowledge_preview_item);
                lens_knowledge_preview_span(src, t1 + 1, t2);
                lens_knowledge_preview_append(" (");
                lens_knowledge_preview_span(src, t2 + 1, le);
                lens_knowledge_preview_append(knowledge_preview_bytes);
            }
        }
        i = le + 1;
    }
    str_copy(g_doc_preview_title, knowledge_preview_title);
    str_copy(g_doc_preview_path, g_knowledge_manifest_path);
    lens_document_preview_show();
    return 1;
}

func lens_knowledge_clear() -> i64 {
    if MessageBoxA(load64(g_hwnd), knowledge_clear_msg, knowledge_clear_title, 0x24) != 6 { return 0; }
    lens_knowledge_clean_dir(g_knowledge_docs_dir);
    lens_knowledge_clean_dir(g_knowledge_excerpt_dir);
    DeleteFileA(g_knowledge_manifest_path);
    store64(g_knowledge_enabled, 0);
    store64(g_knowledge_files, 0);
    store64(g_knowledge_bytes, 0);
    lens_config_save();
    lens_set_status(st_knowledge_cleared);
    return 1;
}

func lens_privacy_endpoint_build() -> i64 {
    b = load64(g_backend);
    if b == 2 { str_copy(g_privacy_endpoint, "https://api.anthropic.com/v1/messages"); return g_privacy_endpoint; }
    lens_copy_str(g_privacy_endpoint, lens_backend_url_ptr(b), 512);
    return g_privacy_endpoint;
}

func lens_privacy_model_digest_build() -> i64 {
    # Preserve a digest captured by native GGUF inspection. The portable store
    # resolver can refresh it, but shared Engine stores are not always adjacent
    # to Lens and must not make already verified identity disappear.
    lens_copy_str(g_tmp3, g_privacy_model_digest, 96);
    store8(g_privacy_model_digest, 0);
    b = load64(g_backend);
    model = lens_backend_model_ptr(b);
    if b == 3 {
        store8(g_aether_store_digest, 0);
        if lens_aether_resolve_inspect_path(model, g_aether_inspect_path) == 1 {
            lens_copy_str(g_privacy_model_digest, g_aether_store_digest, 96);
        } else if strlen(g_tmp3) == 64 {
            lens_copy_str(g_privacy_model_digest, g_tmp3, 96);
        }
    } else if b == 0 {
        start = lens_find_model_pos(model);
        if start >= 0 { lens_extract_model_field(start, nd_digest, g_privacy_model_digest, 96); }
    }
    if load8(g_privacy_model_digest) == 0 {
        if b == 1 { str_copy(g_privacy_model_digest, "remote provider managed / not locally inspectable"); }
        else if b == 2 { str_copy(g_privacy_model_digest, "remote provider managed / not locally inspectable"); }
        else { str_copy(g_privacy_model_digest, "not available; inspect or install the selected model"); }
    }
    return g_privacy_model_digest;
}

func lens_privacy_append(s: i64) -> i64 {
    return lens_knowledge_preview_append(s);
}

func lens_privacy_show() -> i64 {
    if load64(g_busy) != 0 { lens_set_status(st_busy); return 0; }
    lens_harvest_all();
    endpoint = lens_privacy_endpoint_build();
    model = lens_backend_model_ptr(load64(g_backend));
    local = lpp_loopback_url(endpoint);
    store8(g_privacy_engine_digest, 0);
    lfh_sha256_file(g_aether_exe, g_privacy_engine_digest);
    if load8(g_privacy_engine_digest) == 0 { str_copy(g_privacy_engine_digest, "unavailable (executable not found or unreadable)"); }
    lens_privacy_model_digest_build();
    lens_knowledge_manifest_stats();

    p = str_copy(load64(g_doc_preview_p), "Aether Lens Privacy Proof\r\n==========================\r\n\r\nConnection\r\nBackend: ");
    p = str_copy(p, lens_backend_label());
    p = str_copy(p, "\r\nEndpoint: "); p = str_copy(p, endpoint);
    p = str_copy(p, "\r\nClassification: ");
    if local == 1 { p = str_copy(p, "LOCAL LOOPBACK - traffic stays on this PC"); }
    else { p = str_copy(p, "NETWORK / CLOUD - requests can leave this PC"); }
    p = str_copy(p, "\r\nCredential storage: environment only; API keys are not saved by Lens\r\n\r\nRuntime identity\r\nSelected model: ");
    p = str_copy(p, model);
    p = str_copy(p, "\r\nModel digest / identity: "); p = str_copy(p, g_privacy_model_digest);
    p = str_copy(p, "\r\nAether Engine executable: "); p = str_copy(p, g_aether_exe);
    p = str_copy(p, "\r\nEngine executable SHA-256: "); p = str_copy(p, g_privacy_engine_digest);
    p = str_copy(p, "\r\nEngine ownership: ");
    if load64(g_backend) != 3 { p = str_copy(p, "not selected"); }
    else if lens_aether_owned_alive() == 1 { p = str_copy(p, "Lens-owned local process"); }
    else { p = str_copy(p, "external, remote, or not currently running"); }
    p = str_copy(p, "\r\nRuntime contract: native /api/chat; identity pinned above by executable digest\r\n\r\nCurrent disclosure\r\nQueued image: ");
    if load64(g_has_image) == 1 { p = str_copy(p, g_img_mime); p = str_copy(p, " / "); int_to_str(g_tmp, load64(g_img_bytes)); p = str_copy(p, g_tmp); p = str_copy(p, " bytes"); }
    else { p = str_copy(p, "none"); }
    p = str_copy(p, "\r\nAether Engine native vision: ");
    if load64(g_backend) != 3 { p = str_copy(p, "not selected"); }
    else if lvp_aether_model_has_vision(model) == 1 { p = str_copy(p, "direct on gemma4:e4b / one PNG per message"); }
    else if lens_find_aether_vision_model(g_tmp) == 1 { p = str_copy(p, "local sequential helper available: "); p = str_copy(p, g_tmp); }
    else { p = str_copy(p, "not available for the selected model/settings"); }
    p = str_copy(p, "\r\nQueued document/folder: ");
    if load64(g_has_file) == 1 { p = str_copy(p, g_file_name); p = str_copy(p, " / "); int_to_str(g_tmp, load64(g_file_bytes)); p = str_copy(p, g_tmp); p = str_copy(p, " bytes"); }
    else { p = str_copy(p, "none"); }
    p = str_copy(p, "\r\nLocal knowledge: ");
    if load64(g_knowledge_enabled) == 1 { p = str_copy(p, "enabled"); } else { p = str_copy(p, "disabled"); }
    p = str_copy(p, " / indexed files "); int_to_str(g_tmp, load64(g_knowledge_files)); p = str_copy(p, g_tmp);
    p = str_copy(p, " / last prompt matches "); int_to_str(g_tmp, load64(g_knowledge_matches)); p = str_copy(p, g_tmp);
    p = str_copy(p, "\r\nMicrophone capture: ");
    if load64(g_voice_state) == 1 { p = str_copy(p, "ACTIVE - local PCM recording only"); }
    else { p = str_copy(p, "inactive"); }
    p = str_copy(p, "\r\nSaved voice recording: ");
    if GetFileAttributesA(g_voice_last_path) == 4294967295 { p = str_copy(p, "none"); }
    else { p = str_copy(p, g_voice_last_path); }
    p = str_copy(p, "\r\nLocal speech-to-text: ");
    if load64(g_stt_state) == 1 { p = str_copy(p, "running offline"); }
    else { p = str_copy(p, "idle"); }
    p = str_copy(p, "\r\nRecognition runtime: ");
    if load8(g_stt_runtime) == 0 { p = str_copy(p, "not initialized"); } else { p = str_copy(p, g_stt_runtime); }
    p = str_copy(p, "\r\nReviewed voice text: ");
    if load8(load64(g_stt_text_p)) == 0 { p = str_copy(p, "none"); }
    else { p = str_copy(p, "pending locally / "); int_to_str(g_tmp, strlen(load64(g_stt_text_p))); p = str_copy(p, g_tmp); p = str_copy(p, " bytes"); }
    p = str_copy(p, "\r\nLocal text-to-speech: ");
    if load64(g_tts_state) == 1 { p = str_copy(p, "synthesizing offline"); } else { p = str_copy(p, "idle"); }
    p = str_copy(p, "\r\nSynthesis runtime: ");
    if load8(g_tts_runtime) == 0 { p = str_copy(p, "not initialized"); } else { p = str_copy(p, g_tts_runtime); }
    p = str_copy(p, "\r\nSynthesized speech WAV: ");
    if band(GetFileAttributesA(g_voice_tts_path), 4294967295) == 4294967295 { p = str_copy(p, "none"); }
    else { p = str_copy(p, g_voice_tts_path); }
    p = str_copy(p, "\r\nVoice disclosure: recording and synthesized WAV files are never attached or sent; reviewed text enters the composer only after Insert and still requires Send");
    p = str_copy(p, "\r\nTranscript disclosure: [lens] lines record sent attachments and exact [K1]-[K3] passages\r\n\r\nPortable storage\r\nApp root: "); p = str_copy(p, g_rootdir);
    p = str_copy(p, "\r\nConfiguration: "); p = str_copy(p, g_cfgpath);
    p = str_copy(p, "\r\nSaved chats/assets: "); p = str_copy(p, g_chatdir);
    p = str_copy(p, "\r\nKnowledge corpus/excerpts: "); p = str_copy(p, g_knowledge_dir);
    p = str_copy(p, "\r\nArena preference history: "); p = str_copy(p, g_arena_history_path);
    p = str_copy(p, "\r\nLocal voice recording: "); p = str_copy(p, g_voice_last_path);
    p = str_copy(p, "\r\nLocal synthesized speech: "); p = str_copy(p, g_voice_tts_path);
    q2 = str_copy(g_search_profile, g_rootdir); str_copy(q2, "\\webview2-profile");
    p = str_copy(p, "\r\nEmbedded browser profile: "); p = str_copy(p, g_search_profile);
    q2 = str_copy(g_privacy_model_store, g_rootdir); str_copy(q2, "\\models");
    p = str_copy(p, "\r\nPortable model store: "); p = str_copy(p, g_privacy_model_store);
    p = str_copy(p, "\r\n\r\nRetention controls\r\nUse the Proof menu to open each storage location, clear the current in-memory conversation, clear copied knowledge, remove generated artifact previews, clear embedded browser cookies/cache/site storage, or clear Arena preference history. Saved chats and attachment assets are never bulk-deleted silently.\r\n\r\nGenerated locally. Opening this proof made no model or network request.");
    store8(p, 0);
    str_copy(g_doc_preview_title, "Aether Lens Privacy Proof");
    store8(g_doc_preview_path, 0);
    lens_document_preview_show();
    lens_set_status(st_privacy_open);
    return 1;
}

func lens_privacy_clear_chat() -> i64 {
    if load64(g_busy) != 0 { lens_set_status(st_busy); return 0; }
    if MessageBoxA(load64(g_hwnd), privacy_chat_msg, privacy_chat_title, 0x24) != 6 { return 0; }
    lens_chat_new();
    lens_set_status(st_privacy_chat_clear);
    return 1;
}

func lens_privacy_clear_previews() -> i64 {
    if MessageBoxA(load64(g_hwnd), privacy_preview_msg, privacy_preview_title, 0x24) != 6 { return 0; }
    p = str_copy(g_artifact_dir, g_chatdir); str_copy(p, artifact_dir_suffix);
    p = str_copy(g_recent_glob, g_artifact_dir); str_copy(p, "\\*");
    failed = 0;
    h = FindFirstFileA(g_recent_glob, g_recent_find);
    if h != 0 - 1 {
        while 1 {
            attr = load32(g_recent_find + 0);
            name = g_recent_find + 44;
            if band(attr, 16) == 0 {
                p = str_copy(g_exportpath, g_artifact_dir); store8(p, 92); p = p + 1; str_copy(p, name);
                if DeleteFileA(g_exportpath) == 0 { failed = failed + 1; }
            }
            if FindNextFileA(h, g_recent_find) == 0 { break; }
        }
        FindClose(h);
    }
    if failed > 0 { lens_set_status(st_privacy_preview_fail); return 0; }
    lens_set_status(st_privacy_preview_clear);
    return 1;
}

func lens_privacy_clear_webview() -> i64 {
    if load64(g_search_hwnd) != 0 { lens_set_status(privacy_webview_close); return 0; }
    p = str_copy(g_search_profile, g_rootdir); str_copy(p, "\\webview2-profile");
    if band(GetFileAttributesA(g_search_profile), 4294967295) == 4294967295 { lens_set_status(st_webview_cleared); return 1; }
    if MessageBoxA(load64(g_hwnd), privacy_webview_msg, privacy_webview_title, 0x24) != 6 { return 0; }
    memset(g_search_profile_delete, 0, 1104); str_copy(g_search_profile_delete, g_search_profile);
    memset(g_search_shfo, 0, 56); store64(g_search_shfo + 0, load64(g_hwnd)); store32(g_search_shfo + 8, 3);
    store64(g_search_shfo + 16, g_search_profile_delete); store16(g_search_shfo + 32, 0x414);
    hr = SHFileOperationA(g_search_shfo);
    if hr != 0 { lens_set_status(st_webview_clear_failed); return 0; }
    if load32(g_search_shfo + 36) != 0 { lens_set_status(st_webview_clear_failed); return 0; }
    lens_set_status(st_webview_cleared); return 1;
}

func lens_privacy_menu_show() -> i64 {
    gui_menu_drop(load64(g_hwnd), load64(g_btn_privacy), load64(g_privacy_menu), g_rect);
    return 1;
}

func lens_arena_menu_show(owner: i64, anchor: i64) -> i64 {
    CheckMenuItem(load64(g_arena_menu), ID_ARENA_BLIND, 0);
    if load64(g_arena_blind) == 1 { CheckMenuItem(load64(g_arena_menu), ID_ARENA_BLIND, 8); }
    gui_menu_drop(owner, anchor, load64(g_arena_menu), g_rect);
    return 1;
}

func lens_knowledge_toggle() -> i64 {
    if lens_knowledge_manifest_stats() == 0 { store64(g_knowledge_enabled, 0); lens_set_status(st_knowledge_none); return 0; }
    if load64(g_knowledge_enabled) == 0 { store64(g_knowledge_enabled, 1); lens_set_status(st_knowledge_enabled); }
    else { store64(g_knowledge_enabled, 0); lens_set_status(st_knowledge_disabled); }
    lens_config_save();
    return 1;
}

func lens_knowledge_menu_sync() -> i64 {
    cm = load64(g_canvas_menu);
    CheckMenuItem(cm, ID_ADD_CANVAS, 0);
    CheckMenuItem(cm, ID_ADD_CANVAS_HTML, 0);
    CheckMenuItem(cm, ID_ADD_CANVAS_SVG, 0);
    CheckMenuItem(cm, ID_ADD_CANVAS_CSV, 0);
    if load64(g_canvas_armed) == 1 {
        if load64(g_canvas_request_kind) == 1 { CheckMenuItem(cm, ID_ADD_CANVAS_HTML, 8); }
        else if load64(g_canvas_request_kind) == 2 { CheckMenuItem(cm, ID_ADD_CANVAS_SVG, 8); }
        else if load64(g_canvas_request_kind) == 3 { CheckMenuItem(cm, ID_ADD_CANVAS_CSV, 8); }
        else { CheckMenuItem(cm, ID_ADD_CANVAS, 8); }
    }
    CheckMenuItem(load64(g_add_menu), ID_VISION_AUTO, 0);
    CheckMenuItem(load64(g_add_menu), ID_VISION_MOON, 0);
    CheckMenuItem(load64(g_add_menu), ID_VISION_FIRST, 0);
    CheckMenuItem(load64(g_add_menu), ID_VISION_OFF, 0);
    if load64(g_vision_mode) == 0 { CheckMenuItem(load64(g_add_menu), ID_VISION_AUTO, 8); }
    else if load64(g_vision_mode) == 1 { CheckMenuItem(load64(g_add_menu), ID_VISION_MOON, 8); }
    else if load64(g_vision_mode) == 2 { CheckMenuItem(load64(g_add_menu), ID_VISION_FIRST, 8); }
    else { CheckMenuItem(load64(g_add_menu), ID_VISION_OFF, 8); }
    CheckMenuItem(load64(g_add_menu), ID_KNOWLEDGE_USE, 0);
    if load64(g_knowledge_enabled) == 1 { if lens_knowledge_manifest_stats() > 0 { CheckMenuItem(load64(g_add_menu), ID_KNOWLEDGE_USE, 8); } }
    return 1;
}

func lens_knowledge_top_copy(dst: i64, src: i64, cap: i64) -> i64 { return lens_copy_str(dst, src, cap); }

func lens_knowledge_top_insert(slot: i64, score: i64, start: i64, end: i64, line1: i64, line2: i64, doc: i64, path: i64) -> i64 {
    j = 2;
    while j > slot {
        store64(g_knowledge_top_score + j * 8, load64(g_knowledge_top_score + (j - 1) * 8));
        store64(g_knowledge_top_start + j * 8, load64(g_knowledge_top_start + (j - 1) * 8));
        store64(g_knowledge_top_end + j * 8, load64(g_knowledge_top_end + (j - 1) * 8));
        store64(g_knowledge_top_line1 + j * 8, load64(g_knowledge_top_line1 + (j - 1) * 8));
        store64(g_knowledge_top_line2 + j * 8, load64(g_knowledge_top_line2 + (j - 1) * 8));
        lens_knowledge_top_copy(g_knowledge_top_doc + j * 96, g_knowledge_top_doc + (j - 1) * 96, 96);
        lens_knowledge_top_copy(g_knowledge_top_path + j * 900, g_knowledge_top_path + (j - 1) * 900, 900);
        j = j - 1;
    }
    store64(g_knowledge_top_score + slot * 8, score);
    store64(g_knowledge_top_start + slot * 8, start);
    store64(g_knowledge_top_end + slot * 8, end);
    store64(g_knowledge_top_line1 + slot * 8, line1);
    store64(g_knowledge_top_line2 + slot * 8, line2);
    lens_knowledge_top_copy(g_knowledge_top_doc + slot * 96, doc, 96);
    lens_knowledge_top_copy(g_knowledge_top_path + slot * 900, path, 900);
    return 1;
}

func lens_knowledge_consider(score: i64, start: i64, end: i64, line1: i64, line2: i64, doc: i64, path: i64) -> i64 {
    if score <= 0 { return 0; }
    slot = 0;
    while slot < 3 {
        if score > load64(g_knowledge_top_score + slot * 8) { return lens_knowledge_top_insert(slot, score, start, end, line1, line2, doc, path); }
        slot = slot + 1;
    }
    return 0;
}

func lens_knowledge_context_append(s: i64) -> i64 {
    dst = load64(g_knowledge_context_p); d = strlen(dst); i = 0;
    while d < 16383 { c = load8(s + i); if c == 0 { store8(dst + d, 0); return 1; } store8(dst + d, c); d = d + 1; i = i + 1; }
    store8(dst + d, 0); return 0;
}

func lens_knowledge_context_span(src: i64, first: i64, last: i64) -> i64 {
    dst = load64(g_knowledge_context_p); d = strlen(dst); i = first;
    while i < last { if d >= 16383 { break; } store8(dst + d, load8(src + i)); d = d + 1; i = i + 1; }
    store8(dst + d, 0); return 1;
}

func lens_knowledge_note_append(s: i64) -> i64 {
    dst = load64(g_knowledge_note_p); d = strlen(dst); i = 0;
    while d < 8191 { c = load8(s + i); if c == 0 { store8(dst + d, 0); return 1; } store8(dst + d, c); d = d + 1; i = i + 1; }
    store8(dst + d, 0); return 0;
}

func lens_knowledge_make_excerpt(slot: i64, src: i64, start: i64, end: i64, path: i64, line1: i64, line2: i64) -> i64 {
    rel = g_knowledge_excerpt_rel + slot * 192;
    p = str_copy(rel, knowledge_rel_root); p = str_copy(p, knowledge_excerpt_prefix);
    int_to_str(g_tmp, GetTickCount()); p = str_copy(p, g_tmp); store8(p, 95); p = p + 1;
    int_to_str(g_tmp, slot + 1); p = str_copy(p, g_tmp); str_copy(p, knowledge_doc_ext);
    lens_path_join2(g_knowledge_doc_path, g_knowledge_dir, rel);
    p = str_copy(load64(g_filebuf_p), "Aether Lens cited passage [K");
    int_to_str(g_tmp, slot + 1); p = str_copy(p, g_tmp); p = str_copy(p, "]\r\nSource: "); p = str_copy(p, path);
    p = str_copy(p, "\r\nLines: "); int_to_str(g_tmp, line1); p = str_copy(p, g_tmp); p = str_copy(p, "-"); int_to_str(g_tmp, line2); p = str_copy(p, g_tmp); p = str_copy(p, "\r\n\r\n");
    i = start; while i < end { store8(p, load8(src + i)); p = p + 1; i = i + 1; } store8(p, 0);
    return lens_write_file(g_knowledge_doc_path, load64(g_filebuf_p), strlen(load64(g_filebuf_p)));
}

func lens_knowledge_build_selected() -> i64 {
    store8(load64(g_knowledge_context_p), 0);
    store8(load64(g_knowledge_note_p), 0);
    store64(g_knowledge_matches, 0);
    if load64(g_knowledge_top_score) <= 0 { lens_knowledge_note_append(st_knowledge_sent_none); return 0; }
    lens_knowledge_context_append(knowledge_ctx_a);
    lens_knowledge_note_append(knowledge_note_a);
    slot = 0;
    while slot < 3 {
        if load64(g_knowledge_top_score + slot * 8) <= 0 { break; }
        doc = g_knowledge_top_doc + slot * 96;
        path = g_knowledge_top_path + slot * 900;
        lens_path_join2(g_knowledge_doc_path, g_knowledge_docs_dir, doc);
        n = lens_read_file(g_knowledge_doc_path, load64(g_knowledge_doc_p), 262145);
        if n > 0 {
            start = load64(g_knowledge_top_start + slot * 8); end = load64(g_knowledge_top_end + slot * 8);
            line1 = load64(g_knowledge_top_line1 + slot * 8); line2 = load64(g_knowledge_top_line2 + slot * 8);
            lens_knowledge_make_excerpt(slot, load64(g_knowledge_doc_p), start, end, path, line1, line2);
            lens_knowledge_context_append(knowledge_ctx_k); int_to_str(g_tmp, slot + 1); lens_knowledge_context_append(g_tmp);
            lens_knowledge_context_append(knowledge_ctx_path); lens_knowledge_context_append(path); lens_knowledge_context_append(knowledge_ctx_lines);
            int_to_str(g_tmp, line1); lens_knowledge_context_append(g_tmp); lens_knowledge_context_append(knowledge_ctx_dash); int_to_str(g_tmp, line2); lens_knowledge_context_append(g_tmp);
            lens_knowledge_context_append(knowledge_ctx_close); lens_knowledge_context_span(load64(g_knowledge_doc_p), start, end); lens_knowledge_context_append(knowledge_ctx_end);
            if slot > 0 { lens_knowledge_note_append(knowledge_note_sep); }
            lens_knowledge_note_append(knowledge_note_k); int_to_str(g_tmp, slot + 1); lens_knowledge_note_append(g_tmp); lens_knowledge_note_append(knowledge_note_mid);
            lens_knowledge_note_append(path); lens_knowledge_note_append(knowledge_ctx_lines); int_to_str(g_tmp, line1); lens_knowledge_note_append(g_tmp); lens_knowledge_note_append(knowledge_ctx_dash); int_to_str(g_tmp, line2); lens_knowledge_note_append(g_tmp); lens_knowledge_note_append(")");
            lens_knowledge_note_append(knowledge_note_open); lens_knowledge_note_append(g_knowledge_excerpt_rel + slot * 192); lens_knowledge_note_append(knowledge_note_end);
            store64(g_knowledge_matches, load64(g_knowledge_matches) + 1);
        }
        slot = slot + 1;
    }
    return load64(g_knowledge_matches);
}

func lens_knowledge_prepare() -> i64 {
    store8(load64(g_knowledge_context_p), 0);
    store8(load64(g_knowledge_note_p), 0);
    if load64(g_knowledge_enabled) == 0 { return 0; }
    n = lens_read_file(g_knowledge_manifest_path, load64(g_knowledge_manifest_p), 262144);
    if n <= 0 { return 0; }
    memset(g_knowledge_top_score, 0, 24);
    memset(g_knowledge_top_start, 0, 24); memset(g_knowledge_top_end, 0, 24);
    memset(g_knowledge_top_line1, 0, 24); memset(g_knowledge_top_line2, 0, 24);
    memset(g_knowledge_top_doc, 0, 288); memset(g_knowledge_top_path, 0, 2700);
    src = load64(g_knowledge_manifest_p); i = 0;
    while i < n {
        le = i; while le < n { if load8(src + le) == 10 { break; } le = le + 1; }
        t1 = i; while t1 < le { if load8(src + t1) == 9 { break; } t1 = t1 + 1; }
        if t1 < le {
            t2 = t1 + 1; while t2 < le { if load8(src + t2) == 9 { break; } t2 = t2 + 1; }
            if t2 < le {
                lens_copy_span(g_knowledge_doc_name, src, i, t1, 96);
                lens_copy_span(g_knowledge_source_path, src, t1 + 1, t2, 900);
                lens_path_join2(g_knowledge_doc_path, g_knowledge_docs_dir, g_knowledge_doc_name);
                dn = lens_read_file(g_knowledge_doc_path, load64(g_knowledge_doc_p), 262145);
                if dn > 0 {
                    start = 0;
                    while start < dn {
                        end = lki_chunk_end(load64(g_knowledge_doc_p), start, dn, 1200, 1800);
                        score = lki_score(g_user_msg, load64(g_knowledge_doc_p), start, end, g_knowledge_source_path, g_knowledge_token);
                        line1 = lki_line_number(load64(g_knowledge_doc_p), start);
                        line2 = line1;
                        if end > start { line2 = lki_line_number(load64(g_knowledge_doc_p), end - 1); }
                        lens_knowledge_consider(score, start, end, line1, line2, g_knowledge_doc_name, g_knowledge_source_path);
                        if end <= start { break; }
                        start = end;
                    }
                }
            }
        }
        i = le + 1;
    }
    return lens_knowledge_build_selected();
}

func lens_knowledge_rel_ok(rel: i64) -> i64 {
    return lki_excerpt_rel_ok(rel);
}

func lens_open_knowledge_excerpt(rel: i64) -> i64 {
    if lens_knowledge_rel_ok(rel) == 0 { lens_set_status(st_asset_missing); return 1; }
    lens_path_join2(g_knowledge_doc_path, g_knowledge_dir, rel);
    if GetFileAttributesA(g_knowledge_doc_path) == 0xFFFFFFFF { lens_set_status(st_asset_missing); return 1; }
    lens_document_preview_open_path(g_knowledge_doc_path);
    return 1;
}

func lens_attach_text_file_path(path: i64) -> i64 {
    if lens_supported_text_file(path) == 0 { lens_set_status(st_filetype); return 0; }
    n = lens_read_file(path, load64(g_file_text_p), 262144);
    if n < 0 { store64(g_has_file, 0); store64(g_file_bytes, 0); store64(g_file_kind, 0); lens_set_status(st_filefail); lens_refresh_attachment_ui(); return 0; }
    if n <= 0 { store64(g_has_file, 0); store64(g_file_bytes, 0); store64(g_file_kind, 0); lens_set_status(st_filefail); lens_refresh_attachment_ui(); return 0; }
    if n >= 262143 { store64(g_has_file, 0); store64(g_file_bytes, 0); store64(g_file_kind, 0); lens_set_status(st_filebig); lens_refresh_attachment_ui(); return 0; }
    lens_file_name_from_path(path, g_file_name, 256);
    store64(g_has_file, 1);
    store64(g_file_kind, 1);
    store64(g_file_bytes, n);
    lens_refresh_attachment_ui();
    GetClientRect(load64(g_hwnd), g_rect);
    lens_layout(load32(g_rect + 8), load32(g_rect + 12));
    lens_append_note(st_fileattach);
    lens_refresh_transcript();
    lens_set_status(st_fileattach);
    return 1;
}

func lens_attach_text_file() -> i64 {
    if load64(g_busy) != 0 { lens_set_status(st_busy); return 0; }
    memset(g_ofn, 0, 152);
    store32(g_ofn + 0, 152);
    store64(g_ofn + 8, load64(g_hwnd));
    store64(g_ofn + 24, g_text_filter);
    store32(g_ofn + 44, 1);
    store64(g_ofn + 48, g_textpath);
    store32(g_ofn + 56, 900);
    store64(g_ofn + 88, file_title);
    store32(g_ofn + 96, 0x1804);
    store8(g_textpath, 0);
    if GetOpenFileNameA(g_ofn) == 0 { return 0; }
    return lens_attach_text_file_path(g_textpath);
}

func lens_attach_image_path(path: i64) -> i64 {
    h = CreateFileA(path, 0x80000000, 1, 0, 3, 0x80, 0);
    if h == 0 - 1 { store64(g_has_image, 0); store64(g_img_bytes, 0); lens_preview_clear(); lens_refresh_attachment_ui(); lens_set_status(st_imgfail); return 0; }
    total = 0;
    while total < 2097152 {
        chunk = 65536;
        if total + chunk > 2097152 { chunk = 2097152 - total; }
        r = ReadFile(h, load64(g_img_raw_p) + total, chunk, g_img_nread, 0);
        if r == 0 { break; }
        n = load32(g_img_nread);
        if n == 0 { break; }
        total = total + n;
    }
    CloseHandle(h);
    if total <= 0 { store64(g_has_image, 0); store64(g_img_bytes, 0); lens_preview_clear(); lens_refresh_attachment_ui(); lens_set_status(st_imgfail); return 0; }
    if total >= 2097152 { store64(g_has_image, 0); store64(g_img_bytes, 0); lens_preview_clear(); lens_refresh_attachment_ui(); lens_set_status(st_imgbig); return 0; }
    lens_copy_str(g_imgpath, path, 900);
    lj_b64_encode(load64(g_img_raw_p), total, load64(g_img_b64_p));
    lens_set_img_mime(path);
    lens_preview_load(path);
    store64(g_has_image, 1);
    store64(g_img_bytes, total);
    lens_refresh_attachment_ui();
    GetClientRect(load64(g_hwnd), g_rect);
    lens_layout(load32(g_rect + 8), load32(g_rect + 12));
    lens_append_note(st_attach);
    lens_refresh_transcript();
    lens_set_status(st_attach);
    return 1;
}

func lens_attach_image() -> i64 {
    if load64(g_busy) != 0 { lens_set_status(st_busy); return 0; }
    memset(g_ofn, 0, 152);
    store32(g_ofn + 0, 152);
    store64(g_ofn + 8, load64(g_hwnd));
    store64(g_ofn + 24, g_img_filter);
    store32(g_ofn + 44, 1);
    store64(g_ofn + 48, g_imgpath);
    store32(g_ofn + 56, 900);
    store64(g_ofn + 88, img_title);
    store32(g_ofn + 96, 0x1804);
    store8(g_imgpath, 0);
    if GetOpenFileNameA(g_ofn) == 0 { return 0; }
    return lens_attach_image_path(g_imgpath);
}

func lens_drop_image(hdrop: i64) -> i64 {
    count = DragQueryFileA(hdrop, 0xFFFFFFFF, 0, 0);
    if load64(g_busy) != 0 {
        DragFinish(hdrop);
        lens_set_status(st_busy);
        return 0;
    }
    if count != 1 {
        DragFinish(hdrop);
        lens_set_status(st_drop_one);
        return 0;
    }
    need = DragQueryFileA(hdrop, 0, 0, 0);
    if need <= 0 {
        DragFinish(hdrop);
        lens_set_status(st_drop_path);
        return 0;
    }
    if need >= 900 {
        DragFinish(hdrop);
        lens_set_status(st_drop_path);
        return 0;
    }
    store8(g_drop_path, 0);
    got = DragQueryFileA(hdrop, 0, g_drop_path, 900);
    DragFinish(hdrop);
    if got <= 0 {
        lens_set_status(st_drop_path);
        return 0;
    }
    if ldp_image_path_supported(g_drop_path) == 0 {
        lens_set_status(st_drop_type);
        return 0;
    }
    return lens_attach_image_path(g_drop_path);
}

func lens_clear_image_attachment() -> i64 {
    store64(g_has_image, 0);
    store64(g_has_file, 0);
    store64(g_dual_vision_used, 0);
    store64(g_aether_vision_sent, 0);
    store64(g_aether_vision_route, 0);
    store64(g_img_bytes, 0);
    store64(g_file_bytes, 0);
    store64(g_file_kind, 0);
    store8(load64(g_img_b64_p), 0);
    store8(load64(g_file_text_p), 0);
    store8(g_vision_model, 0);
    store8(load64(g_vision_notes_p), 0);
    store8(g_file_name, 0);
    store8(g_asset_img_rel, 0);
    store8(g_asset_doc_rel, 0);
    lens_preview_clear();
    lens_refresh_attachment_ui();
    GetClientRect(load64(g_hwnd), g_rect);
    lens_layout(load32(g_rect + 8), load32(g_rect + 12));
    lens_set_status(st_attachclear);
    return 1;
}

func lens_gdip_ensure() -> i64 {
    if load64(g_gdip_tok) != 0 { return 1; }
    store32(g_gdip_in + 0, 1);
    store32(g_gdip_in + 4, 0);
    store64(g_gdip_in + 8, 0);
    store64(g_gdip_in + 16, 0);
    if GdiplusStartup(g_gdip_tok, g_gdip_in, 0) != 0 { store64(g_gdip_tok, 0); return 0; }
    if load64(g_gdip_tok) == 0 { return 0; }
    return 1;
}

func lens_gdip_png_clsid() -> i64 {
    store32(g_png_clsid + 0,  0x557CF406);
    store32(g_png_clsid + 4,  0x11D31A04);
    store32(g_png_clsid + 8,  0x0000739A);
    store32(g_png_clsid + 12, 0x2EF31EF8);
    return 0;
}

func lens_preview_clear() -> i64 {
    lens_image_preview_close();
    hb = load64(g_img_hbm);
    if hb != 0 { DeleteObject(hb); }
    store64(g_img_hbm, 0);
    store64(g_img_w, 0);
    store64(g_img_h, 0);
    return 0;
}

func lens_preview_load(path: i64) -> i64 {
    lens_preview_clear();
    if lens_gdip_ensure() == 0 { return 0; }
    if MultiByteToWideChar(0, 0, path, 0 - 1, g_clip_wpath, 800) == 0 { return 0; }
    store64(g_gp_bm, 0);
    if GdipCreateBitmapFromFile(g_clip_wpath, g_gp_bm) != 0 { return 0; }
    bm = load64(g_gp_bm);
    if bm == 0 { return 0; }
    store32(g_img_w, 0);
    store32(g_img_h, 0);
    GdipGetImageWidth(bm, g_img_w);
    GdipGetImageHeight(bm, g_img_h);
    if GdipCreateHBITMAPFromBitmap(bm, g_img_hbm, 0xFF161619) != 0 {
        GdipDisposeImage(bm);
        store64(g_img_hbm, 0);
        return 0;
    }
    GdipDisposeImage(bm);
    return 1;
}

func lens_hbitmap_to_png(hbm: i64, apath: i64) -> i64 {
    if lens_gdip_ensure() == 0 { return 0; }
    store64(g_gp_bm, 0);
    if GdipCreateBitmapFromHBITMAP(hbm, 0, g_gp_bm) != 0 { return 0; }
    bm = load64(g_gp_bm);
    if bm == 0 { return 0; }
    lens_gdip_png_clsid();
    if MultiByteToWideChar(0, 0, apath, 0 - 1, g_clip_wpath, 800) == 0 {
        GdipDisposeImage(bm);
        return 0;
    }
    st = GdipSaveImageToFile(bm, g_clip_wpath, g_png_clsid, 0);
    GdipDisposeImage(bm);
    if st != 0 { return 0; }
    return 1;
}

func lens_dib_to_hbitmap(hdib: i64) -> i64 {
    lp = GlobalLock(hdib);
    if lp == 0 { return 0; }
    bisize = load32(lp + 0);
    clrused = load32(lp + 32);
    comp = load32(lp + 16);
    masks = 0;
    if comp == 3 { if bisize == 40 { masks = 12; } }
    bits = lp + bisize + clrused * 4 + masks;
    hdc = GetDC(0);
    hbm = CreateDIBitmap(hdc, lp, 4, bits, lp, 0);
    ReleaseDC(0, hdc);
    GlobalUnlock(hdib);
    return hbm;
}

func lens_paste_clipboard_image() -> i64 {
    if IsClipboardFormatAvailable(2) == 0 {
        if IsClipboardFormatAvailable(8) == 0 { return 0; }
    }
    if load64(g_busy) != 0 { lens_set_status(st_busy); return 1; }
    if OpenClipboard(load64(g_hwnd)) == 0 { return 0; }
    own_hbm = 0;
    hbm = GetClipboardData(2);
    if hbm == 0 {
        hdib = GetClipboardData(8);
        if hdib != 0 { hbm = lens_dib_to_hbitmap(hdib); own_hbm = 1; }
    }
    if hbm == 0 { CloseClipboard(); lens_set_status(st_clipfail); return 1; }
    lens_join(g_clip_png, g_rootdir, clip_suffix);
    ok = lens_hbitmap_to_png(hbm, g_clip_png);
    if own_hbm == 1 { DeleteObject(hbm); }
    CloseClipboard();
    if ok == 0 { store64(g_has_image, 0); store64(g_img_bytes, 0); lens_refresh_attachment_ui(); lens_set_status(st_imgfail); return 1; }
    lens_attach_image_path(g_clip_png);
    return 1;
}

func lens_build_model_body(dst: i64, a: i64, model: i64, b: i64) -> i64 {
    p = str_copy(dst, a);
    p = lj_json_esc(dst, p - dst, model) + dst;
    str_copy(p, b);
    return 0;
}

func lens_append_file_context(p: i64) -> i64 {
    if load64(g_has_file) == 1 {
        if load64(g_file_kind) == 2 { p = str_copy(p, folder_ctx_a); }
        else { p = str_copy(p, file_ctx_a); }
        p = str_copy(p, g_file_name);
        if load64(g_file_kind) == 2 { p = str_copy(p, folder_ctx_hint); }
        p = str_copy(p, file_ctx_b);
        p = str_copy(p, load64(g_file_text_p));
        p = str_copy(p, file_ctx_c);
    }
    return p;
}

func lens_append_vision_context(p: i64) -> i64 {
    if load64(g_dual_vision_used) == 1 {
        p = str_copy(p, vision_ctx_a);
        p = str_copy(p, g_vision_model);
        p = str_copy(p, vision_ctx_b);
        p = str_copy(p, load64(g_vision_notes_p));
        p = str_copy(p, vision_ctx_c);
    }
    return p;
}

func lens_append_knowledge_context(p: i64) -> i64 {
    if load8(load64(g_knowledge_context_p)) != 0 { p = str_copy(p, load64(g_knowledge_context_p)); }
    return p;
}

func lens_build_current_user_text(dst: i64, cap: i64) -> i64 {
    p = str_copy(dst, g_user_msg);
    p = lens_append_vision_context(p);
    p = lens_append_file_context(p);
    p = lens_append_knowledge_context(p);
    store8(p, 0);
    return 0;
}

func lens_build_user_text(dst: i64, cap: i64) -> i64 {
    p = str_copy(dst, ctx_a);
    if load8(load64(g_prior_p)) == 0 { p = str_copy(p, ctx_empty); }
    else { p = str_copy(p, load64(g_prior_p)); }
    p = str_copy(p, ctx_b);
    p = str_copy(p, g_user_msg);
    p = lens_append_vision_context(p);
    p = lens_append_file_context(p);
    p = lens_append_knowledge_context(p);
    store8(p, 0);
    return 0;
}

func lens_json_esc_range(dst: i64, d0: i64, src: i64, start: i64, end: i64) -> i64 {
    d = d0;
    i = start;
    while i < end {
        c = load8(src + i);
        if c == 0 { store8(dst + d, 0); return d; }
        if c == 34 {
            store8(dst + d, 92);
            store8(dst + d + 1, 34);
            d = d + 2;
        } else if c == 92 {
            store8(dst + d, 92);
            store8(dst + d + 1, 92);
            d = d + 2;
        } else if c == 10 {
            store8(dst + d, 92);
            store8(dst + d + 1, 110);
            d = d + 2;
        } else if c == 13 {
            store8(dst + d, 92);
            store8(dst + d + 1, 114);
            d = d + 2;
        } else if c == 9 {
            store8(dst + d, 92);
            store8(dst + d + 1, 116);
            d = d + 2;
        } else {
            store8(dst + d, c);
            d = d + 1;
        }
        i = i + 1;
    }
    store8(dst + d, 0);
    return d;
}

func lens_match_at(src: i64, pos: i64, ndl: i64) -> i64 {
    j = 0;
    while 1 {
        c = load8(ndl + j);
        if c == 0 { return 1; }
        if load8(src + pos + j) != c { return 0; }
        j = j + 1;
    }
    return 0;
}

func lens_turn_boundary(src: i64, pos: i64) -> i64 {
    if pos == 0 { return 1; }
    if pos >= 4 {
        if load8(src + pos - 4) == 13 {
            if load8(src + pos - 3) == 10 {
                if load8(src + pos - 2) == 13 {
                    if load8(src + pos - 1) == 10 { return 1; }
                }
            }
        }
    }
    return 0;
}

func lens_role_at(src: i64, pos: i64) -> i64 {
    if lens_turn_boundary(src, pos) == 0 { return 0; }
    if lens_match_at(src, pos, line_user) == 1 { return 1; }
    if lens_match_at(src, pos, line_ai) == 1 { return 2; }
    if lens_match_at(src, pos, line_sys) == 1 { return 3; }
    return 0;
}

func lens_next_turn(src: i64, pos: i64) -> i64 {
    i = pos;
    while 1 {
        c = load8(src + i);
        if c == 0 { return i; }
        if lens_role_at(src, i) != 0 { return i; }
        i = i + 1;
    }
    return i;
}

func lens_msg_text(dst: i64, p: i64, role: i64, text: i64) -> i64 {
    p = str_copy(p, rq_msg_a);
    p = str_copy(p, role);
    p = str_copy(p, rq_msg_b);
    p = lj_json_esc(dst, p - dst, text) + dst;
    p = str_copy(p, rq_msg_c);
    return p;
}

func lens_msg_range(dst: i64, p: i64, role: i64, src: i64, start: i64, end: i64) -> i64 {
    while end > start {
        c = load8(src + end - 1);
        if c == 13 { end = end - 1; }
        else if c == 10 { end = end - 1; }
        else { break; }
    }
    if end <= start { return p; }
    p = str_copy(p, rq_msg_a);
    p = str_copy(p, role);
    p = str_copy(p, rq_msg_b);
    p = lens_json_esc_range(dst, p - dst, src, start, end) + dst;
    p = str_copy(p, rq_msg_c);
    return p;
}

func lens_build_history_messages(dst: i64, p: i64) -> i64 {
    src = load64(g_prior_p);
    pos = 0;
    while load8(src + pos) != 0 {
        role = lens_role_at(src, pos);
        if role == 0 { pos = pos + 1; }
        else {
            content = pos;
            rptr = role_user;
            if role == 1 { content = pos + strlen(line_user); rptr = role_user; }
            else if role == 2 { content = pos + strlen(line_ai); rptr = role_assistant; }
            else { content = pos + strlen(line_sys); }
            next = lens_next_turn(src, content);
            if role != 3 {
                p = str_copy(p, comma);
                p = lens_msg_range(dst, p, rptr, src, content, next);
            }
            pos = next;
        }
    }
    return p;
}

func lens_build_native_chat_req(model: i64) -> i64 {
    lens_build_current_user_text(load64(g_prompt_p), 1048576);
    dst = load64(g_req_p);
    p = str_copy(dst, rq_model);
    p = lj_json_esc(dst, p - dst, model) + dst;
    p = str_copy(p, rq_msgs_a);
    p = lens_msg_text(dst, p, role_system, lens_system_prompt());
    p = lens_build_history_messages(dst, p);
    p = str_copy(p, comma);
    p = lens_msg_text(dst, p, role_user, load64(g_prompt_p));
    str_copy(p, rq_arr_close);
    return 0;
}

func lens_build_ollama_chat_req() -> i64 {
    return lens_build_native_chat_req(g_ollama_model);
}

func lens_append_aether_options() -> i64 {
    dst = load64(g_req_p);
    p = dst + strlen(dst) - 1;
    p = str_copy(p, ",\"options\":{\"num_predict\":");
    int_to_str(g_tmp, load64(g_aether_max));
    p = str_copy(p, g_tmp);
    if load64(g_aether_style) == 0 {
        p = str_copy(p, ",\"temperature\":0");
    } else if load64(g_aether_style) == 1 {
        p = str_copy(p, ",\"temperature\":0.4,\"top_k\":40,\"top_p\":0.9,\"min_p\":0.02,\"repeat_penalty\":1.1");
    } else {
        p = str_copy(p, ",\"temperature\":0.8,\"top_k\":40,\"top_p\":0.95,\"min_p\":0.05,\"repeat_penalty\":1.05");
    }
    p = str_copy(p, ",\"think\":");
    int_to_str(g_tmp, load64(g_aether_reasoning));
    p = str_copy(p, g_tmp);
    str_copy(p, "}}");
    return 0;
}

func lens_build_aether_chat_req() -> i64 {
    lens_build_native_chat_req(g_aether_model);
    return lens_append_aether_options();
}

func lens_build_aether_vision_req() -> i64 {
    p = str_copy(load64(g_req_p), rq_model);
    p = lj_json_esc(load64(g_req_p), p - load64(g_req_p), g_aether_model) + load64(g_req_p);
    lens_build_current_user_text(load64(g_prompt_p), 1048576);
    p = str_copy(p, rq_stream_user);
    p = lj_json_esc(load64(g_req_p), p - load64(g_req_p), load64(g_prompt_p)) + load64(g_req_p);
    p = str_copy(p, rq_img_oll_a);
    p = str_copy(p, load64(g_img_b64_p));
    str_copy(p, rq_img_oll_b);
    return lens_append_aether_options();
}

func lens_build_vision_helper_req() -> i64 {
    p = str_copy(load64(g_req_p), rq_model);
    p = lj_json_esc(load64(g_req_p), p - load64(g_req_p), g_vision_model) + load64(g_req_p);
    p = str_copy(p, rq_stream_user);
    p = lj_json_esc(load64(g_req_p), p - load64(g_req_p), vision_prompt) + load64(g_req_p);
    p = str_copy(p, rq_img_oll_a);
    p = str_copy(p, load64(g_img_b64_p));
    str_copy(p, rq_img_oll_b);
    return 0;
}

func lens_build_aether_vision_helper_req() -> i64 {
    hp = str_copy(load64(g_prompt_p), vision_prompt_engine_a);
    str_copy(hp, g_user_msg);
    p = str_copy(load64(g_req_p), rq_model);
    p = lj_json_esc(load64(g_req_p), p - load64(g_req_p), g_vision_model) + load64(g_req_p);
    p = str_copy(p, rq_stream_user);
    p = lj_json_esc(load64(g_req_p), p - load64(g_req_p), load64(g_prompt_p)) + load64(g_req_p);
    p = str_copy(p, rq_img_oll_a);
    p = str_copy(p, load64(g_img_b64_p));
    str_copy(p, rq_img_oll_b);
    return 0;
}

func lens_build_ollama_req() -> i64 {
    p = str_copy(load64(g_req_p), rq_model);
    p = lj_json_esc(load64(g_req_p), p - load64(g_req_p), g_ollama_model) + load64(g_req_p);
    if load64(g_has_image) == 1 {
        lens_build_current_user_text(load64(g_prompt_p), 1048576);
        p = str_copy(p, rq_stream_user);
        p = lj_json_esc(load64(g_req_p), p - load64(g_req_p), load64(g_prompt_p)) + load64(g_req_p);
        p = str_copy(p, rq_img_oll_a);
        p = str_copy(p, load64(g_img_b64_p));
        str_copy(p, rq_img_oll_b);
    } else {
        lens_build_ollama_chat_req();
    }
    return 0;
}

func lens_prepare_dual_vision() -> i64 {
    store64(g_dual_vision_used, 0);
    store8(g_vision_model, 0);
    store8(load64(g_vision_notes_p), 0);
    if load64(g_has_image) == 0 { return 0; }
    if lens_model_has_vision(g_ollama_model) == 1 { return 0; }
    if lens_find_first_vision_model(g_vision_model) == 0 { return 0; }
    store8(load64(g_resp_p), 0);
    store8(load64(g_reply_p), 0);
    lens_build_vision_helper_req();
    h = lt_ollama_chat(load64(g_req_p), load64(g_resp_p), 4194304);
    store64(g_http_status, h);
    if h != 200 {
        store8(load64(g_resp_p), 0);
        store8(load64(g_reply_p), 0);
        return 0;
    }
    n = lens_extract_ollama_stream(load64(g_vision_notes_p), 131072);
    if n <= 0 {
        lens_extract_reply();
        lens_copy_str(load64(g_vision_notes_p), load64(g_reply_p), 131072);
        n = strlen(load64(g_vision_notes_p));
    }
    store8(load64(g_resp_p), 0);
    store8(load64(g_reply_p), 0);
    if n <= 0 { return 0; }
    store64(g_dual_vision_used, 1);
    return 1;
}

func lens_prepare_aether_dual_vision() -> i64 {
    store64(g_dual_vision_used, 0);
    store64(g_aether_vision_sent, 0);
    store8(g_vision_model, 0);
    store8(load64(g_vision_notes_p), 0);
    if load64(g_has_image) == 0 { return 0; }
    if lvp_aether_mime_supported(g_img_mime) == 0 { return 0; }
    if lvp_aether_model_has_vision(g_aether_model) == 1 { return 0; }
    if lens_find_aether_vision_model(g_vision_model) == 0 { return 0; }
    if lens_aether_is_local() == 0 { return 0; }

    # Never switch a server Lens does not own. A stopped loopback endpoint is
    # safe: Lens will launch and retain ownership of both sequential models.
    lens_apply_aether_url();
    pre = lt_ollama_tags(load64(g_resp_p), 4194304);
    if pre == 200 { if lens_aether_owned_alive() == 0 { store8(load64(g_resp_p), 0); return 0; } }

    str_copy(g_vision_restore_model, g_aether_model);
    if lens_aether_owned_alive() == 1 { lens_aether_stop_owned(); }
    str_copy(g_aether_model, g_vision_model);
    helper_ok = 0;
    if lens_aether_ensure_server(load64(g_resp_p), 4194304) == 200 {
        store8(load64(g_resp_p), 0);
        store8(load64(g_reply_p), 0);
        lens_build_aether_vision_helper_req();
        lens_append_aether_options();
        if strlen(load64(g_req_p)) < aether_vision_req_cap {
            lens_apply_aether_url();
            h = lt_ollama_chat(load64(g_req_p), load64(g_resp_p), 4194304);
            if h == 200 {
                n = lens_extract_ollama_stream(load64(g_vision_notes_p), 131072);
                if n <= 0 {
                    lens_extract_reply();
                    lens_copy_str(load64(g_vision_notes_p), load64(g_reply_p), 131072);
                    n = strlen(load64(g_vision_notes_p));
                }
                if n > 0 { helper_ok = 1; }
            }
        } else { store64(g_aether_vision_route, 3); }
    }

    lens_aether_stop_owned();
    str_copy(g_aether_model, g_vision_restore_model);
    restored = lens_aether_ensure_server(load64(g_resp_p), 4194304);
    store8(load64(g_resp_p), 0);
    store8(load64(g_reply_p), 0);
    if load64(g_pulse_manual_stop) == 1 { return 0; }
    if restored != 200 { return 0; }
    if helper_ok == 0 { return 0; }
    store64(g_dual_vision_used, 1);
    store64(g_aether_vision_sent, 1);
    return 1;
}

func lens_build_oai_req() -> i64 {
    lens_build_user_text(load64(g_prompt_p), 1048576);
    p = str_copy(load64(g_req_p), oai_a);
    p = lj_json_esc(load64(g_req_p), p - load64(g_req_p), lens_backend_model_ptr(1)) + load64(g_req_p);
    p = str_copy(p, rq_stream_oai_b);
    p = lj_json_esc(load64(g_req_p), p - load64(g_req_p), lens_system_prompt()) + load64(g_req_p);
    if load64(g_has_image) == 1 {
        p = str_copy(p, oai_img_a);
        p = lj_json_esc(load64(g_req_p), p - load64(g_req_p), load64(g_prompt_p)) + load64(g_req_p);
        p = str_copy(p, oai_img_b);
        p = str_copy(p, g_img_mime);
        p = str_copy(p, oai_img_c);
        p = str_copy(p, load64(g_img_b64_p));
        str_copy(p, oai_img_d);
    } else {
        p = str_copy(p, oai_c);
        p = lj_json_esc(load64(g_req_p), p - load64(g_req_p), load64(g_prompt_p)) + load64(g_req_p);
        str_copy(p, rq_close);
    }
    return 0;
}

func lens_build_ant_req() -> i64 {
    lens_build_user_text(load64(g_prompt_p), 1048576);
    p = str_copy(load64(g_req_p), ant_a);
    p = lj_json_esc(load64(g_req_p), p - load64(g_req_p), g_anthropic_model) + load64(g_req_p);
    p = str_copy(p, ant_b);
    p = lj_json_esc(load64(g_req_p), p - load64(g_req_p), lens_system_prompt()) + load64(g_req_p);
    if load64(g_has_image) == 1 {
        p = str_copy(p, ant_img_a);
        p = str_copy(p, g_img_mime);
        p = str_copy(p, ant_img_b);
        p = str_copy(p, load64(g_img_b64_p));
        p = str_copy(p, ant_img_c);
        p = lj_json_esc(load64(g_req_p), p - load64(g_req_p), load64(g_prompt_p)) + load64(g_req_p);
        str_copy(p, ant_img_d);
    } else {
        p = str_copy(p, ant_c);
        p = lj_json_esc(load64(g_req_p), p - load64(g_req_p), load64(g_prompt_p)) + load64(g_req_p);
        str_copy(p, rq_close);
    }
    return 0;
}

func lens_extract_reply() -> i64 {
    if load64(g_http_status) == 0 {
        if load8(load64(g_resp_p)) != 0 { str_copy(load64(g_reply_p), load64(g_resp_p)); }
        else { str_copy(load64(g_reply_p), "[network] request failed or was stopped."); }
        return 0;
    }
    b = load64(g_backend);
    if b == 2 {
        if lj_extract_string_after(load64(g_resp_p), nd_text, load64(g_reply_p), 1048576) > 0 { return 1; }
    } else {
        if lj_extract_string_after(load64(g_resp_p), nd_content, load64(g_reply_p), 1048576) > 0 { return 1; }
    }
    if lj_extract_string_after(load64(g_resp_p), nd_message, load64(g_reply_p), 1048576) > 0 { return 1; }
    if lj_extract_string_after(load64(g_resp_p), nd_status, load64(g_reply_p), 1048576) > 0 { return 1; }
    lens_copy_str(load64(g_reply_p), load64(g_resp_p), 1048576);
    return 1;
}

func lens_extract_ollama_stream(dst: i64, cap: i64) -> i64 {
    if cap <= 1 { return 0; }
    src = load64(g_resp_p);
    out = 0;
    pos = 0;
    while out < cap - 1 {
        p = lj_find_after_from(src, pos, nd_content);
        if p < 0 { break; }
        lj_json_unesc(src, p, g_tmp, 1024);
        i = 0;
        while out < cap - 1 {
            c = load8(g_tmp + i);
            if c == 0 { break; }
            store8(dst + out, c);
            out = out + 1;
            i = i + 1;
        }
        pos = p + 1;
    }
    store8(dst + out, 0);
    return out;
}

func lens_extract_string_stream(dst: i64, cap: i64, ndl: i64) -> i64 {
    if cap <= 1 { return 0; }
    src = load64(g_resp_p);
    out = 0;
    pos = 0;
    while out < cap - 1 {
        p = lj_find_after_from(src, pos, ndl);
        if p < 0 { break; }
        lj_json_unesc(src, p, g_tmp, 1024);
        i = 0;
        while out < cap - 1 {
            c = load8(g_tmp + i);
            if c == 0 { break; }
            store8(dst + out, c);
            out = out + 1;
            i = i + 1;
        }
        pos = p + 1;
    }
    store8(dst + out, 0);
    return out;
}

func lens_extract_stream_reply(dst: i64, cap: i64) -> i64 {
    b = load64(g_backend);
    if b == 0 { return lens_extract_ollama_stream(dst, cap); }
    if b == 3 { return lens_extract_ollama_stream(dst, cap); }
    if b == 1 {
        n = lens_extract_string_stream(dst, cap, nd_delta_content);
        if n > 0 { return n; }
        return lens_extract_string_stream(dst, cap, nd_content);
    }
    return lens_extract_string_stream(dst, cap, nd_text);
}

func lens_render_stream_reply(final: i64) -> i64 {
    lens_copy_str(load64(g_transcript_p), load64(g_prior_p), 524288);
    lens_append_user(g_user_msg);
    lens_append_sent_image_note();
    lens_append_sent_vision_note();
    lens_append_sent_file_note();
    if load8(load64(g_knowledge_note_p)) != 0 { lens_append_note(load64(g_knowledge_note_p)); }
    lens_append_raw(line_ai);
    lens_append_raw(load64(g_reply_p));
    if final == 1 { lens_append_raw(blank2); }
    lens_refresh_transcript();
    return 0;
}

func lens_chat_progress() -> i64 {
    if load64(g_busy_kind) != 2 { return 0; }
    if lens_extract_stream_reply(load64(g_reply_p), 1048576) <= 0 { return 0; }
    lens_pulse_progress();
    lens_render_stream_reply(0);
    lens_set_status(st_streaming);
    return 0;
}

func lens_find_last_after(src: i64, ndl: i64) -> i64 {
    pos = 0;
    last = 0 - 1;
    while 1 {
        p = lj_find_after_from(src, pos, ndl);
        if p < 0 { return last; }
        last = p;
        pos = p + 1;
    }
    return last;
}

func lens_last_uint(src: i64, ndl: i64) -> i64 {
    p = lens_find_last_after(src, ndl);
    if p < 0 { return 0; }
    return lj_parse_uint(src + p);
}

func lens_clear_runtime_info() -> i64 {
    store8(g_runtime_text, 0);
    store64(g_pulse_start_ms, 0);
    store64(g_pulse_first_ms, 0);
    store64(g_pulse_reply_bytes, 0);
    store64(g_pulse_state, 0);
    store64(g_pulse_manual_stop, 0);
    store64(g_pulse_prompt_tokens, 0);
    store64(g_pulse_reply_tokens, 0);
    store64(g_pulse_total_ms, 0);
    store64(g_pulse_prompt_ms, 0);
    store64(g_pulse_eval_ms, 0);
    store64(g_pulse_load_ms, 0);
    store64(g_pulse_tps, 0);
    store8(g_pulse_reason, 0);
    lens_render_info();
    return 0;
}

func lens_pulse_append_int(p: i64, value: i64) -> i64 {
    int_to_str(g_size_tmp, value);
    return str_copy(p, g_size_tmp);
}

func lens_pulse_history_add(value: i64) -> i64 {
    count = load64(g_pulse_history_count);
    if count < 5 {
        store64(g_pulse_history + count * 8, value);
        store64(g_pulse_history_count, count + 1);
        return 1;
    }
    i = 0;
    while i < 4 {
        store64(g_pulse_history + i * 8, load64(g_pulse_history + (i + 1) * 8));
        i = i + 1;
    }
    store64(g_pulse_history + 32, value);
    return 1;
}

func lens_pulse_append_history(p: i64) -> i64 {
    count = load64(g_pulse_history_count);
    if count <= 0 { return p; }
    p = str_copy(p, info_history);
    i = 0;
    while i < count {
        if i > 0 { p = str_copy(p, " | "); }
        p = lens_pulse_append_int(p, load64(g_pulse_history + i * 8));
        i = i + 1;
    }
    return str_copy(p, info_toksec);
}

func lens_pulse_elapsed() -> i64 {
    start = load64(g_pulse_start_ms);
    if start == 0 { return 0; }
    return GetTickCount() - start;
}

func lens_pulse_render() -> i64 {
    state = load64(g_pulse_state);
    if state == 0 { store8(g_runtime_text, 0); lens_render_info(); return 0; }
    elapsed = lens_pulse_elapsed();
    first = load64(g_pulse_first_ms);
    ttft = 0;
    if first > 0 { ttft = first - load64(g_pulse_start_ms); }
    p = g_runtime_text;
    if state == 1 {
        if load64(g_backend) == 3 {
            if load64(g_aether_vision_route) == 1 {
                lens_set_status(st_engine_reading);
                p = str_copy(p, info_pulse_vision);
            } else if load64(g_aether_vision_route) == 2 {
                lens_set_status(st_engine_reading);
                p = str_copy(p, info_pulse_vision);
            } else {
                lens_set_status(st_pulse_wait);
                p = str_copy(p, info_pulse_wait);
            }
        } else {
            lens_set_status(st_pulse_wait);
            p = str_copy(p, info_pulse_wait);
        }
        p = lens_pulse_append_int(p, elapsed);
        p = str_copy(p, info_ms);
    } else if state == 2 {
        lens_set_status(st_pulse_stream);
        p = str_copy(p, info_pulse_stream);
        p = lens_pulse_append_int(p, ttft);
        p = str_copy(p, info_ms);
        p = str_copy(p, info_elapsed);
        p = lens_pulse_append_int(p, elapsed);
        p = str_copy(p, info_ms);
    } else if state == 3 {
        p = str_copy(p, info_pulse_done);
        p = lens_pulse_append_int(p, ttft);
        p = str_copy(p, info_ms);
        p = str_copy(p, info_elapsed);
        p = lens_pulse_append_int(p, load64(g_pulse_total_ms));
        p = str_copy(p, info_ms);
    } else if state == 4 {
        p = str_copy(p, info_pulse_stop);
        p = lens_pulse_append_int(p, ttft);
        p = str_copy(p, info_ms);
        p = str_copy(p, info_elapsed);
        p = lens_pulse_append_int(p, elapsed);
        p = str_copy(p, info_ms);
    } else {
        p = str_copy(p, info_pulse_fail);
        p = lens_pulse_append_int(p, elapsed);
        p = str_copy(p, info_ms);
    }

    if state == 3 {
        p = str_copy(p, info_stop_reason);
        if load8(g_pulse_reason) == 0 { p = str_copy(p, det_unknown); }
        else { p = str_copy(p, g_pulse_reason); }
        p = str_copy(p, info_exact_tok);
        p = lens_pulse_append_int(p, load64(g_pulse_prompt_tokens));
        p = str_copy(p, info_reply);
        p = lens_pulse_append_int(p, load64(g_pulse_reply_tokens));
        p = str_copy(p, info_context);
        p = lens_pulse_append_int(p, load64(g_pulse_prompt_tokens) + load64(g_pulse_reply_tokens));
        if load64(g_model_context) > 0 {
            p = str_copy(p, info_context_of);
            p = lens_pulse_append_int(p, load64(g_model_context));
        }
        p = str_copy(p, info_speed);
        p = lens_pulse_append_int(p, load64(g_pulse_tps));
        p = str_copy(p, info_prompt_ms);
        p = lens_pulse_append_int(p, load64(g_pulse_prompt_ms));
        p = str_copy(p, info_generation_ms);
        p = lens_pulse_append_int(p, load64(g_pulse_eval_ms));
        p = str_copy(p, info_load_ms);
        p = lens_pulse_append_int(p, load64(g_pulse_load_ms));
        p = str_copy(p, info_ms);
        p = lens_pulse_append_history(p);
    } else {
        show_partial = 0;
        if state == 2 { show_partial = 1; }
        if state == 4 { show_partial = 1; }
        if show_partial == 1 { if first > 0 {
            est = (load64(g_pulse_reply_bytes) + 3) / 4;
            gen_ms = GetTickCount() - first;
            live_tps = 0;
            if gen_ms > 0 { live_tps = est * 1000 / gen_ms; }
            p = str_copy(p, info_est_reply);
            p = lens_pulse_append_int(p, est);
            p = str_copy(p, " tokens | ~");
            p = lens_pulse_append_int(p, live_tps);
            p = str_copy(p, info_toksec);
        } }
    }
    store8(p, 0);
    lens_render_info();
    return 1;
}

func lens_pulse_begin() -> i64 {
    store64(g_pulse_start_ms, GetTickCount());
    store64(g_pulse_first_ms, 0);
    store64(g_pulse_reply_bytes, 0);
    store64(g_pulse_state, 1);
    store64(g_pulse_manual_stop, 0);
    store8(g_pulse_reason, 0);
    SetTimer(load64(g_hwnd), 21, 250, 0);
    return lens_pulse_render();
}

func lens_pulse_progress() -> i64 {
    n = strlen(load64(g_reply_p));
    if n <= 0 { return lens_pulse_render(); }
    store64(g_pulse_reply_bytes, n);
    if load64(g_pulse_first_ms) == 0 { store64(g_pulse_first_ms, GetTickCount()); }
    store64(g_pulse_state, 2);
    return lens_pulse_render();
}

func lens_pulse_finish_error() -> i64 {
    KillTimer(load64(g_hwnd), 21);
    if load64(g_pulse_manual_stop) == 1 { store64(g_pulse_state, 4); str_copy(g_pulse_reason, "user"); }
    else { store64(g_pulse_state, 5); str_copy(g_pulse_reason, "request failed"); }
    return lens_pulse_render();
}

func lens_update_runtime_info() -> i64 {
    rb = load64(g_backend);
    if rb != 0 { if rb != 3 { return 0; } }
    if load64(g_http_status) != 200 { return 0; }
    KillTimer(load64(g_hwnd), 21);
    prompt = lens_last_uint(load64(g_resp_p), nd_prompt_eval_count);
    eval = lens_last_uint(load64(g_resp_p), nd_eval_count);
    total_ns = lens_last_uint(load64(g_resp_p), nd_total_duration);
    load_ns = lens_last_uint(load64(g_resp_p), nd_load_duration);
    prompt_ns = lens_last_uint(load64(g_resp_p), nd_prompt_eval_duration);
    eval_ns = lens_last_uint(load64(g_resp_p), nd_eval_duration);
    if load64(g_pulse_first_ms) == 0 { if strlen(load64(g_reply_p)) > 0 { store64(g_pulse_first_ms, GetTickCount()); } }
    total_ms = total_ns / 1000000;
    wall_ms = lens_pulse_elapsed();
    if total_ms < wall_ms { total_ms = wall_ms; }
    prompt_ms = prompt_ns / 1000000;
    eval_ms = eval_ns / 1000000;
    load_ms = load_ns / 1000000;
    tps = 0;
    if eval_ns > 0 { tps = eval * 1000000000 / eval_ns; }
    store64(g_pulse_prompt_tokens, prompt);
    store64(g_pulse_reply_tokens, eval);
    store64(g_pulse_total_ms, total_ms);
    store64(g_pulse_prompt_ms, prompt_ms);
    store64(g_pulse_eval_ms, eval_ms);
    store64(g_pulse_load_ms, load_ms);
    store64(g_pulse_tps, tps);
    p = lens_find_last_after(load64(g_resp_p), nd_done_reason);
    if p >= 0 { lj_json_unesc(load64(g_resp_p), p, g_pulse_reason, 64); }
    lens_pulse_history_add(tps);
    p = str_copy(g_pulse_status_text, "Pulse: ");
    p = lens_pulse_append_int(p, tps);
    p = str_copy(p, info_toksec);
    p = str_copy(p, " | TTFT ");
    if load64(g_pulse_first_ms) > 0 { p = lens_pulse_append_int(p, load64(g_pulse_first_ms) - load64(g_pulse_start_ms)); }
    else { p = lens_pulse_append_int(p, 0); }
    p = str_copy(p, info_ms);
    p = str_copy(p, " | ");
    p = lens_pulse_append_int(p, prompt + eval);
    p = str_copy(p, " tokens");
    store8(p, 0);
    store64(g_pulse_state, 3);
    lens_pulse_render();
    return 1;
}

func lens_extract_last_status(dst: i64, cap: i64) -> i64 {
    p = lens_find_last_after(load64(g_resp_p), nd_status);
    if p < 0 {
        str_copy(dst, st_pulling);
        return 0;
    }
    lj_json_unesc(load64(g_resp_p), p, dst, cap);
    return 1;
}

func lens_pull_progress() -> i64 {
    if load64(g_busy_kind) != 3 { return 0; }
    if load64(g_backend) == 3 {
        at = lens_find_last_after(load64(g_resp_p), eng_pull_progress);
        if at < 0 { lens_set_status(st_engine_pulling); return 0; }
        pct = lj_parse_uint(load64(g_resp_p) + at);
        q0 = at;
        while load8(load64(g_resp_p) + q0) >= 48 { if load8(load64(g_resp_p) + q0) > 57 { break; } q0 = q0 + 1; }
        while load8(load64(g_resp_p) + q0) == 32 { q0 = q0 + 1; }
        done = lj_parse_uint(load64(g_resp_p) + q0);
        while load8(load64(g_resp_p) + q0) >= 48 { if load8(load64(g_resp_p) + q0) > 57 { break; } q0 = q0 + 1; }
        while load8(load64(g_resp_p) + q0) == 32 { q0 = q0 + 1; }
        total = lj_parse_uint(load64(g_resp_p) + q0);
        p = str_copy(g_tmp2, st_pull_prefix);
        int_to_str(g_size_tmp, pct);
        p = str_copy(p, g_size_tmp);
        p = str_copy(p, st_pull_pct);
        if done == 0 { str_copy(g_tmp, "0 MB"); }
        else { lens_size_text(done, g_tmp); }
        p = str_copy(p, g_tmp);
        p = str_copy(p, st_pull_of);
        lens_size_text(total, g_tmp3);
        p = str_copy(p, g_tmp3);
        str_copy(p, st_pull_verify);
        lens_set_status(g_tmp2);
        return 0;
    }
    lens_extract_last_status(g_tmp, 512);
    p = str_copy(g_tmp2, st_pull_prefix);
    total = lens_last_uint(load64(g_resp_p), nd_total);
    if total > 0 {
        done = lens_last_uint(load64(g_resp_p), nd_completed);
        pct = done * 100 / total;
        int_to_str(g_size_tmp, pct);
        p = str_copy(p, g_size_tmp);
        p = str_copy(p, st_pull_pct);
    }
    str_copy(p, g_tmp);
    lens_set_status(g_tmp2);
    return 0;
}

# ---------------------------------------------------------------------
# R5 Model Arena: isolated same-prompt, sequential local comparisons.
# ---------------------------------------------------------------------

func lens_arena_backend_label() -> i64 {
    if load64(g_arena_backend) == 3 { return arena_backend_aether; }
    return arena_backend_ollama;
}

func lens_arena_selected(dst: i64) -> i64 {
    b = load64(g_backend_display);
    if b != 0 { if b != 3 { lens_set_status(st_arena_backend); return 0; } }
    row = SendMessageA(load64(g_models), 4108, 0 - 1, 2);
    if row < 0 { lens_set_status(st_arena_select); return 0; }
    gui_lv_get_cell(load64(g_models), row, 0, dst, 256);
    if load8(dst) == 0 { lens_set_status(st_arena_select); return 0; }
    return 1;
}

func lens_arena_combo_get(combo: i64, dst: i64) -> i64 {
    if combo == 0 { store8(dst, 0); return 0; }
    sel = SendMessageA(combo, 327, 0, 0); # CB_GETCURSEL
    if sel < 0 { store8(dst, 0); return 0; }
    SendMessageA(combo, 328, sel, dst); # CB_GETLBTEXT
    if load8(dst) == 0 { return 0; }
    return 1;
}

func lens_arena_sync_pair() -> i64 {
    b = load64(g_backend_display);
    if b != 0 { if b != 3 { lens_set_status(st_arena_backend); return 0; } }
    if lens_arena_combo_get(load64(g_arena_model_a_cb), g_tmp) == 0 { lens_set_status(st_arena_select); return 0; }
    if lens_arena_combo_get(load64(g_arena_model_b_cb), g_tmp2) == 0 { lens_set_status(st_arena_select); return 0; }
    if lac_pair_valid(g_tmp, g_tmp2) == 0 { lens_set_status(st_arena_pair); return 0; }
    str_copy(g_arena_model_a, g_tmp);
    str_copy(g_arena_model_b, g_tmp2);
    store64(g_arena_backend, b);
    lens_config_save();
    return 1;
}

func lens_arena_reset_results() -> i64 {
    if load64(g_busy_kind) == 6 { return 0; }
    store8(load64(g_arena_result_a_p), 0);
    store8(load64(g_arena_result_b_p), 0);
    store64(g_arena_status_a, 0 - 1); store64(g_arena_status_b, 0 - 1);
    store64(g_arena_prompt_tokens_a, 0); store64(g_arena_reply_tokens_a, 0); store64(g_arena_ms_a, 0); store64(g_arena_tps_a, 0);
    store64(g_arena_prompt_tokens_b, 0); store64(g_arena_reply_tokens_b, 0); store64(g_arena_ms_b, 0); store64(g_arena_tps_b, 0);
    store64(g_arena_complete, 0);
    store64(g_arena_voted, 0);
    return 1;
}

func lens_arena_populate_models() -> i64 {
    ca = load64(g_arena_model_a_cb); cb = load64(g_arena_model_b_cb);
    if ca == 0 { return 0; }
    if cb == 0 { return 0; }
    SendMessageA(ca, 331, 0, 0); # CB_RESETCONTENT
    SendMessageA(cb, 331, 0, 0);
    b = load64(g_backend_display);
    if b != 0 { if b != 3 { lens_set_status(st_arena_backend); return 0; } }
    if load64(g_arena_backend) != b {
        store64(g_arena_backend, b);
        store8(g_arena_model_a, 0);
        store8(g_arena_model_b, 0);
    }
    row = 0; pos = 0; sela = 0 - 1; selb = 0 - 1;
    while row < 128 {
        p = lj_find_after_from(load64(g_tags_p), pos, nd_name);
        if p < 0 { break; }
        lj_json_unesc(load64(g_tags_p), p, g_model_tmp, 256);
        SendMessageA(ca, 323, 0, g_model_tmp); # CB_ADDSTRING
        SendMessageA(cb, 323, 0, g_model_tmp);
        if strcmp(g_model_tmp, g_arena_model_a) == 0 { sela = row; }
        if strcmp(g_model_tmp, g_arena_model_b) == 0 { selb = row; }
        row = row + 1;
        pos = p + 1;
    }
    if row == 0 { lens_set_status(st_arena_select); return 0; }
    if sela < 0 { sela = 0; }
    if selb < 0 {
        selb = 0;
        if row > 1 { selb = 1; }
    }
    if sela == selb { if row > 1 { if sela == 0 { selb = 1; } else { selb = 0; } } }
    SendMessageA(ca, 334, sela, 0); # CB_SETCURSEL
    SendMessageA(cb, 334, selb, 0);
    SendMessageA(ca, 328, sela, g_arena_model_a);
    SendMessageA(cb, 328, selb, g_arena_model_b);
    lens_config_save();
    return row;
}

func lens_arena_combo_changed() -> i64 {
    if load64(g_busy_kind) == 6 { return 0; }
    if lens_arena_sync_pair() == 1 { lens_arena_reset_results(); lens_arena_refresh_window(); }
    return 1;
}

func lens_arena_set_a() -> i64 {
    if lens_arena_selected(g_tmp) == 0 { return 0; }
    store64(g_arena_backend, load64(g_backend_display));
    str_copy(g_arena_model_a, g_tmp);
    if strcmp(g_arena_model_a, g_arena_model_b) == 0 { store8(g_arena_model_b, 0); }
    lens_config_save();
    p = str_copy(g_tmp2, st_arena_a); str_copy(p, g_arena_model_a); lens_set_status(g_tmp2);
    return 1;
}

func lens_arena_set_b() -> i64 {
    if lens_arena_selected(g_tmp) == 0 { return 0; }
    if load8(g_arena_model_a) != 0 {
        if load64(g_arena_backend) != load64(g_backend_display) { lens_set_status(st_arena_backend_changed); return 0; }
    } else { store64(g_arena_backend, load64(g_backend_display)); }
    if strcmp(g_tmp, g_arena_model_a) == 0 { lens_set_status(st_arena_pair); return 0; }
    str_copy(g_arena_model_b, g_tmp);
    lens_config_save();
    p = str_copy(g_tmp2, st_arena_b); str_copy(p, g_arena_model_b); lens_set_status(g_tmp2);
    return 1;
}

func lens_build_arena_req(model: i64) -> i64 {
    dst = load64(g_req_p);
    p = str_copy(dst, rq_model);
    p = lj_json_esc(dst, p - dst, model) + dst;
    p = str_copy(p, rq_msgs_a);
    p = lens_msg_text(dst, p, role_system, lens_system_prompt());
    p = str_copy(p, comma);
    p = lens_msg_text(dst, p, role_user, load64(g_arena_prompt_p));
    p = str_copy(p, "]");
    if load64(g_arena_backend) == 3 {
        p = str_copy(p, ",\"options\":{\"num_predict\":");
        int_to_str(g_tmp, load64(g_aether_max)); p = str_copy(p, g_tmp);
        if load64(g_aether_style) == 0 { p = str_copy(p, ",\"temperature\":0"); }
        else if load64(g_aether_style) == 1 { p = str_copy(p, ",\"temperature\":0.4,\"top_k\":40,\"top_p\":0.9,\"min_p\":0.02,\"repeat_penalty\":1.1"); }
        else { p = str_copy(p, ",\"temperature\":0.8,\"top_k\":40,\"top_p\":0.95,\"min_p\":0.05,\"repeat_penalty\":1.05"); }
        p = str_copy(p, ",\"think\":"); int_to_str(g_tmp, load64(g_aether_reasoning)); p = str_copy(p, g_tmp);
        p = str_copy(p, "}");
    }
    str_copy(p, "}");
    return 1;
}

func lens_arena_capture_stats(start_ms: i64, prompt_slot: i64, reply_slot: i64, ms_slot: i64, tps_slot: i64) -> i64 {
    prompt = lens_last_uint(load64(g_resp_p), nd_prompt_eval_count);
    reply = lens_last_uint(load64(g_resp_p), nd_eval_count);
    total_ns = lens_last_uint(load64(g_resp_p), nd_total_duration);
    eval_ns = lens_last_uint(load64(g_resp_p), nd_eval_duration);
    wall_ms = GetTickCount() - start_ms;
    total_ms = total_ns / 1000000;
    if total_ms < wall_ms { total_ms = wall_ms; }
    store64(prompt_slot, prompt);
    store64(reply_slot, reply);
    store64(ms_slot, total_ms);
    store64(tps_slot, lac_tokens_per_second(reply, eval_ns, wall_ms));
    return 1;
}

func lens_arena_request(model: i64, result: i64, prompt_slot: i64, reply_slot: i64, ms_slot: i64, tps_slot: i64) -> i64 {
    store8(load64(g_resp_p), 0);
    store8(load64(g_reply_p), 0);
    lens_build_arena_req(model);
    started = GetTickCount();
    if load64(g_arena_backend) == 0 {
        lens_apply_ollama_url();
        st = lt_ollama_chat(load64(g_req_p), load64(g_resp_p), 4194304);
    } else {
        lens_aether_stop_owned();
        str_copy(g_aether_model, model);
        if lens_aether_ensure_server(load64(g_tags_p), 1048576) != 200 { st = 0; }
        else {
            lens_apply_aether_url();
            st = lt_ollama_chat(load64(g_req_p), load64(g_resp_p), 4194304);
        }
    }
    lens_arena_capture_stats(started, prompt_slot, reply_slot, ms_slot, tps_slot);
    if lens_extract_ollama_stream(result, 1048576) <= 0 {
        if st == 200 { str_copy(result, st_emptyreply); }
        else {
            if load8(load64(g_resp_p)) != 0 { lens_copy_str(result, load64(g_resp_p), 1048576); }
            else { str_copy(result, "[arena] request failed or was stopped."); }
        }
    }
    return st;
}

func lens_arena_thread(param: i64) -> i64 {
    store64(g_arena_external_block, 0);
    if load64(g_arena_backend) == 3 {
        lens_apply_aether_url();
        pre = lt_ollama_tags(load64(g_tags_p), 1048576);
        if pre == 200 { if lens_aether_owned_alive() == 0 { store64(g_arena_external_block, 1); PostMessageA(load64(g_hwnd), 0x8008, 0, 0); return 0; } }
        if lens_aether_owned_alive() == 1 { lens_aether_stop_owned(); }
    }
    PostMessageA(load64(g_hwnd), 0x8009, 1, 0);
    sa = lens_arena_request(g_arena_model_a, load64(g_arena_result_a_p), g_arena_prompt_tokens_a, g_arena_reply_tokens_a, g_arena_ms_a, g_arena_tps_a);
    store64(g_arena_status_a, sa);
    if load64(g_arena_stop) == 0 {
        PostMessageA(load64(g_hwnd), 0x8009, 2, 0);
        sb = lens_arena_request(g_arena_model_b, load64(g_arena_result_b_p), g_arena_prompt_tokens_b, g_arena_reply_tokens_b, g_arena_ms_b, g_arena_tps_b);
        store64(g_arena_status_b, sb);
    }
    if load64(g_arena_backend) == 3 {
        lens_aether_stop_owned();
        str_copy(g_aether_model, g_arena_restore_model);
    }
    PostMessageA(load64(g_hwnd), 0x8008, 0, 0);
    return 0;
}

func lens_arena_start() -> i64 {
    if load64(g_busy) != 0 { lens_set_status(st_busy); return 0; }
    if load8(load64(g_arena_prompt_p)) == 0 { lens_set_status(st_arena_prompt); return 0; }
    if load64(g_arena_hwnd) != 0 { if lens_arena_sync_pair() == 0 { return 0; } }
    lens_harvest_all();
    if lac_pair_valid(g_arena_model_a, g_arena_model_b) == 0 { lens_set_status(st_arena_pair); return 0; }
    if load64(g_backend) != load64(g_arena_backend) { lens_set_status(st_arena_backend_changed); return 0; }
    if lens_find_model_pos(g_arena_model_a) < 0 { lens_set_status(st_arena_pair); return 0; }
    if lens_find_model_pos(g_arena_model_b) < 0 { lens_set_status(st_arena_pair); return 0; }
    if load64(g_has_image) == 1 { lens_set_status(st_arena_attach); return 0; }
    if load64(g_has_file) == 1 { lens_set_status(st_arena_attach); return 0; }
    if load64(g_arena_backend) == 3 { if lens_aether_is_local() == 0 { lens_set_status(st_arena_external); return 0; } }
    str_copy(g_arena_restore_model, g_aether_model);
    store8(load64(g_arena_result_a_p), 0);
    store8(load64(g_arena_result_b_p), 0);
    store64(g_arena_status_a, 0);
    store64(g_arena_status_b, 0);
    store64(g_arena_stop, 0);
    store64(g_arena_complete, 0);
    store64(g_arena_voted, 0);
    store64(g_arena_left_is_a, GetTickCount() % 2);
    lens_arena_show();
    lens_arena_refresh_window();
    if lens_begin_busy(6, st_arena_running_a) == 0 { return 0; }
    CreateThread(0, 0, &lens_arena_thread, 0, 0, g_thread_id);
    return 1;
}

func lens_arena_progress(step: i64) -> i64 {
    if step == 1 { lens_set_status(st_arena_running_a); }
    else { lens_set_status(st_arena_running_b); }
    lens_arena_refresh_window();
    return 1;
}

func lens_finish_arena() -> i64 {
    lens_end_busy();
    if load64(g_arena_external_block) == 1 {
        lens_set_status(st_arena_external);
        lens_arena_refresh_window();
        return 0;
    }
    if load64(g_arena_stop) == 1 { lens_set_status(st_arena_stopped); }
    else if load64(g_arena_status_a) == 200 { if load64(g_arena_status_b) == 200 { store64(g_arena_complete, 1); lens_set_status(st_arena_done); } else { lens_set_status(st_arena_failed); } }
    else { lens_set_status(st_arena_failed); }
    lens_arena_refresh_window();
    return 1;
}

func lens_arena_timestamp(dst: i64) -> i64 {
    GetLocalTime(g_arena_time);
    p = dst;
    int_to_str(g_tmp, load16(g_arena_time)); p = str_copy(p, g_tmp); p = str_copy(p, "-");
    int_to_str(g_tmp, load16(g_arena_time + 2)); p = str_copy(p, g_tmp); p = str_copy(p, "-");
    int_to_str(g_tmp, load16(g_arena_time + 6)); p = str_copy(p, g_tmp); p = str_copy(p, "T");
    int_to_str(g_tmp, load16(g_arena_time + 8)); p = str_copy(p, g_tmp); p = str_copy(p, ":");
    int_to_str(g_tmp, load16(g_arena_time + 10)); p = str_copy(p, g_tmp); p = str_copy(p, ":");
    int_to_str(g_tmp, load16(g_arena_time + 12)); p = str_copy(p, g_tmp); store8(p, 0);
    return dst;
}

func lens_arena_history_append(choice: i64, winner: i64) -> i64 {
    n = lens_read_file(g_arena_history_path, load64(g_arena_history_p), 262144);
    if n < 0 { str_copy(load64(g_arena_history_p), arena_history_header); }
    lfh_sha256_bytes(load64(g_arena_prompt_p), strlen(load64(g_arena_prompt_p)), g_arena_prompt_hash);
    p = g_arena_line;
    lens_arena_timestamp(p); p = p + strlen(p); p = str_copy(p, "\t");
    p = str_copy(p, lens_arena_backend_label()); p = str_copy(p, "\t");
    p = str_copy(p, g_arena_model_a); p = str_copy(p, "\t");
    p = str_copy(p, g_arena_model_b); p = str_copy(p, "\t");
    if load64(g_arena_left_is_a) == 1 { p = str_copy(p, g_arena_model_a); } else { p = str_copy(p, g_arena_model_b); }
    p = str_copy(p, "\t");
    if choice == 0 - 1 { p = str_copy(p, "left"); } else if choice == 1 { p = str_copy(p, "right"); } else { p = str_copy(p, "tie"); }
    p = str_copy(p, "\t");
    if winner == 1 { p = str_copy(p, g_arena_model_a); } else if winner == 2 { p = str_copy(p, g_arena_model_b); } else { p = str_copy(p, "tie"); }
    p = str_copy(p, "\t"); p = str_copy(p, g_arena_prompt_hash);
    p = str_copy(p, "\t"); int_to_str(g_tmp, load64(g_arena_tps_a)); p = str_copy(p, g_tmp);
    p = str_copy(p, "\t"); int_to_str(g_tmp, load64(g_arena_reply_tokens_a)); p = str_copy(p, g_tmp);
    p = str_copy(p, "\t"); int_to_str(g_tmp, load64(g_arena_ms_a)); p = str_copy(p, g_tmp);
    p = str_copy(p, "\t"); int_to_str(g_tmp, load64(g_arena_tps_b)); p = str_copy(p, g_tmp);
    p = str_copy(p, "\t"); int_to_str(g_tmp, load64(g_arena_reply_tokens_b)); p = str_copy(p, g_tmp);
    p = str_copy(p, "\t"); int_to_str(g_tmp, load64(g_arena_ms_b)); p = str_copy(p, g_tmp); str_copy(p, "\r\n");
    dst = load64(g_arena_history_p);
    if strlen(dst) + strlen(g_arena_line) >= 262143 { lens_set_status(st_arena_history_full); return 0; }
    str_copy(dst + strlen(dst), g_arena_line);
    return lens_write_file(g_arena_history_path, dst, strlen(dst));
}

func lens_arena_vote(choice: i64) -> i64 {
    if load64(g_arena_complete) == 0 { lens_set_status(st_arena_none); return 0; }
    if load64(g_arena_voted) == 1 { lens_set_status(st_arena_already_voted); return 0; }
    winner = lac_choice_winner(choice, load64(g_arena_left_is_a));
    if winner < 0 { return 0; }
    if lens_arena_history_append(choice, winner) == 0 { return 0; }
    store64(g_arena_voted, 1);
    lens_set_status(st_arena_voted);
    lens_arena_refresh_window();
    return 1;
}

func lens_arena_show_history() -> i64 {
    if GetFileAttributesA(g_arena_history_path) == 0xFFFFFFFF { lens_set_status(st_arena_history_none); return 0; }
    if lens_read_file(g_arena_history_path, load64(g_doc_preview_p), 262144) < 0 { lens_set_status(st_arena_history_none); return 0; }
    str_copy(g_doc_preview_path, g_arena_history_path);
    str_copy(g_doc_preview_title, arena_history_title);
    lens_document_preview_show();
    return 1;
}

func lens_arena_clear_history() -> i64 {
    if MessageBoxA(load64(g_hwnd), arena_clear_msg, arena_clear_title, 0x24) != 6 { return 0; }
    DeleteFileA(g_arena_history_path);
    lens_set_status(st_arena_history_clear);
    return 1;
}

func lens_chat_thread(param: i64) -> i64 {
    b = load64(g_backend);
    if b == 0 {
        lens_apply_ollama_url();
        if lens_prepare_dual_vision() == 1 { lens_build_ollama_chat_req(); }
        else { lens_build_ollama_req(); }
        lt_progress_to(load64(g_hwnd), 0x8006);
        store64(g_http_status, lt_ollama_chat(load64(g_req_p), load64(g_resp_p), 4194304));
        lt_progress_clear();
    } else if b == 1 {
        env = lens_cloud_env();
        if GetEnvironmentVariableA(env, g_key, 1024) == 0 {
            if load64(g_cloud_provider) == 1 { str_copy(load64(g_resp_p), st_nokey_hf); }
            else { str_copy(load64(g_resp_p), st_nokey_oai); }
            store64(g_http_status, 0);
        } else {
            lt_url_split(lens_backend_url_ptr(1), g_host, g_port, g_sec, g_path);
            if load8(g_path) == 0 { str_copy(g_path, "/chat/completions"); }
            else { str_copy(g_path + strlen(g_path), "/chat/completions"); }
            lens_build_oai_req();
            lt_progress_to(load64(g_hwnd), 0x8006);
            store64(g_http_status, lt_oai_chat(g_host, load64(g_port), load64(g_sec), g_path, g_key, load64(g_req_p), load64(g_resp_p), 4194304));
            lt_progress_clear();
        }
    } else if b == 2 {
        if GetEnvironmentVariableA(env_anthropic, g_key, 1024) == 0 {
            str_copy(load64(g_resp_p), st_nokey_ant);
            store64(g_http_status, 0);
        } else {
            p = str_copy(g_header, ant_hdr1);
            p = str_copy(p, g_key);
            str_copy(p, ant_hdr2);
            lens_build_ant_req();
            lt_progress_to(load64(g_hwnd), 0x8006);
            store64(g_http_status, lt_header_chat(ant_host, 443, 1, ant_path, g_header, load64(g_req_p), load64(g_resp_p), 4194304));
            lt_progress_clear();
        }
    } else {
        if load64(g_aether_vision_route) == 2 { lens_prepare_aether_dual_vision(); }
        if load64(g_pulse_manual_stop) == 1 {
            store8(load64(g_resp_p), 0);
            store64(g_http_status, 0);
        } else if lens_aether_ensure_server(load64(g_resp_p), 4194304) != 200 {
            str_copy(load64(g_resp_p), st_aether_fail);
            store64(g_http_status, 0);
        } else {
            lens_apply_aether_url();
            if load64(g_aether_vision_route) == 1 {
                store64(g_aether_vision_sent, 1);
                lens_build_aether_vision_req();
                if strlen(load64(g_req_p)) >= aether_vision_req_cap {
                    store64(g_aether_vision_sent, 0);
                    store64(g_aether_vision_route, 3);
                    lens_build_aether_chat_req();
                }
            } else { lens_build_aether_chat_req(); }
            lt_progress_to(load64(g_hwnd), 0x8006);
            store64(g_http_status, lt_ollama_chat(load64(g_req_p), load64(g_resp_p), 4194304));
            lt_progress_clear();
        }
    }
    if b == 3 {
        if lens_extract_stream_reply(load64(g_reply_p), 1048576) <= 0 {
            if load64(g_http_status) == 0 { str_copy(load64(g_reply_p), st_aether_fail); }
            else { lens_extract_reply(); }
        }
    } else {
        if lens_extract_stream_reply(load64(g_reply_p), 1048576) <= 0 { lens_extract_reply(); }
    }
    PostMessageA(load64(g_hwnd), 0x8002, 0, 0);
    return 0;
}

func lens_refresh_thread(param: i64) -> i64 {
    if load64(g_backend) == 3 {
        st = lens_aether_ensure_server(load64(g_tags_p), 1048576);
        store64(g_http_status, st);
        if lens_aether_is_local() == 1 {
            rows = lens_aether_load_store_models();
            if st != 200 { if rows > 0 { store64(g_http_status, 200); } }
        }
    } else {
        lens_apply_ollama_url();
        store64(g_http_status, lt_ollama_tags(load64(g_tags_p), 1048576));
    }
    PostMessageA(load64(g_hwnd), 0x8001, 0, 0);
    return 0;
}

func lens_hf_catalog_thread(param: i64) -> i64 {
    p = str_copy(g_header, hf_auth_pfx);
    str_copy(p, g_key);
    store64(g_http_status, lt_http3(hf_host, 443, 1, "GET", hf_models_path, g_header, 0, 0, load64(g_tags_p), 4194304, 30000, 0));
    PostMessageA(load64(g_hwnd), 0x8001, 0, 0);
    return 0;
}

func lens_pull_thread(param: i64) -> i64 {
    if load64(g_backend) == 3 {
        lens_aether_build_pull_cmd();
        n = lens_aether_capture(g_aether_cmd, load64(g_resp_p), 4194304);
        if n >= 0 { if load32(g_aether_cli_exit) == 0 { store64(g_http_status, 200); } else { store64(g_http_status, 0); } }
        else { store64(g_http_status, 0); }
    } else {
        lens_apply_ollama_url();
        lens_build_model_body(load64(g_req_p), pull_a, g_ollama_model, pull_b);
        lt_progress_to(load64(g_hwnd), 0x8005);
        store64(g_http_status, lt_ollama_pull(load64(g_req_p), load64(g_resp_p), 4194304));
        lt_progress_clear();
    }
    PostMessageA(load64(g_hwnd), 0x8003, 0, 0);
    return 0;
}

func lens_show_thread(param: i64) -> i64 {
    if load64(g_backend) == 3 {
        lens_aether_build_inspect_cmd();
        n = lens_aether_capture(g_aether_cmd, load64(g_resp_p), 4194304);
        if n >= 0 { if load32(g_aether_cli_exit) == 0 { store64(g_http_status, 200); } else { store64(g_http_status, 0); } }
        else { store64(g_http_status, 0); }
    } else {
        lens_apply_ollama_url();
        lens_build_model_body(load64(g_req_p), show_a, g_show_model, show_b);
        store64(g_http_status, lt_ollama_show(load64(g_req_p), load64(g_resp_p), 4194304));
    }
    PostMessageA(load64(g_hwnd), 0x8007, 0, 0);
    return 0;
}

func lens_delete_thread(param: i64) -> i64 {
    lens_apply_ollama_url();
    lens_build_model_body(load64(g_req_p), del_a, g_ollama_model, del_b);
    store64(g_http_status, lt_ollama_delete(load64(g_req_p), load64(g_resp_p), 4194304));
    PostMessageA(load64(g_hwnd), 0x8004, 0, 0);
    return 0;
}

func lens_begin_busy(kind: i64, status: i64) -> i64 {
    if load64(g_busy) != 0 { lens_set_status(st_busy); return 0; }
    store64(g_busy, 1);
    store64(g_busy_kind, kind);
    lens_set_status(status);
    return 1;
}

func lens_end_busy() -> i64 {
    store64(g_busy, 0);
    store64(g_busy_kind, 0);
    return 0;
}

func lens_refresh_models() -> i64 {
    lens_harvest_all();
    lens_config_save();
    if lens_begin_busy(1, st_refreshing) == 0 { return 0; }
    CreateThread(0, 0, &lens_refresh_thread, 0, 0, g_thread_id);
    return 1;
}

func lens_hf_browse_models() -> i64 {
    if GetEnvironmentVariableA(env_hf, g_key, 1024) == 0 { lens_set_status(st_nokey_hf); lens_update_cloud_info(); return 0; }
    if lens_begin_busy(1, st_hf_browsing) == 0 { return 0; }
    CreateThread(0, 0, &lens_hf_catalog_thread, 0, 0, g_thread_id);
    return 1;
}

func lens_show_model(model: i64) -> i64 {
    b = load64(g_backend_display);
    if b != 0 { if b != 3 { return 0; } }
    if load8(model) == 0 { return 0; }
    if lens_find_model_pos(model) < 0 { return 0; }
    if b == 3 { if lens_aether_is_local() == 0 { return 0; } }
    if load64(g_busy) != 0 { return 0; }
    str_copy(g_show_model, model);
    if b == 3 {
        str_copy(g_aether_forward_model, model);
        store64(g_aether_forward_state, 0);
    }
    if lens_begin_busy(5, st_showing) == 0 { return 0; }
    CreateThread(0, 0, &lens_show_thread, 0, 0, g_thread_id);
    return 1;
}

func lens_use_aether_model(model: i64) -> i64 {
    SetWindowTextA(load64(g_model_ed), model);
    str_copy(g_aether_model, model);
    store64(g_model_context, 0);
    lens_config_save();
    lens_update_cloud_info();
    if lens_aether_is_local() == 1 {
        lens_aether_stop_owned();
        lens_refresh_models();
    } else { lens_set_status(st_engine_remote); }
    return 1;
}

func lens_use_selected() -> i64 {
    row = SendMessageA(load64(g_models), 4108, 0 - 1, 2);
    if row < 0 { return 0; }
    gui_lv_get_cell(load64(g_models), row, 0, g_model_tmp, 256);
    if load64(g_backend_display) == 1 { if load64(g_cloud_provider) == 1 {
        str_copy(g_openai_model, g_model_tmp);
        SetWindowTextA(load64(g_model_ed), g_openai_model);
        lens_config_save();
        lens_update_cloud_info();
        lens_set_status(st_hf_selected);
        return 1;
    } }
    if load64(g_backend_display) == 3 {
        state = lens_aether_forward_cached(g_model_tmp);
        if state == 1 { return lens_use_aether_model(g_model_tmp); }
        if state == 2 { return lens_aether_warn_unsupported(g_model_tmp); }
        if load64(g_busy) != 0 {
            if load64(g_busy_kind) == 5 {
                if strcmp(g_show_model, g_model_tmp) == 0 {
                    str_copy(g_aether_pending_model, g_model_tmp);
                    store64(g_aether_use_pending, 1);
                    lens_set_status(st_engine_validating);
                    return 1;
                }
            }
            lens_set_status(st_busy);
            return 0;
        }
        str_copy(g_aether_pending_model, g_model_tmp);
        store64(g_aether_use_pending, 1);
        if lens_show_model(g_model_tmp) == 1 { lens_set_status(st_engine_validating); return 1; }
        store64(g_aether_use_pending, 0);
        lens_set_status(st_showfail);
        return 0;
    }
    SetWindowTextA(load64(g_model_ed), g_model_tmp);
    str_copy(lens_backend_model_ptr(load64(g_backend_display)), g_model_tmp);
    store64(g_model_context, 0);
    lens_config_save();
    lens_update_model_details(g_model_tmp);
    lens_show_model(g_model_tmp);
    return 1;
}

func lens_pull_model() -> i64 {
    lens_harvest_all();
    if load8(lens_backend_model_ptr(load64(g_backend))) == 0 { lens_set_status(st_no_model); return 0; }
    lens_config_save();
    ps = st_pulling;
    if load64(g_backend) == 3 { ps = st_engine_pulling; }
    if lens_begin_busy(3, ps) == 0 { return 0; }
    CreateThread(0, 0, &lens_pull_thread, 0, 0, g_thread_id);
    return 1;
}

func lens_delete_model() -> i64 {
    lens_harvest_all();
    if load64(g_backend) == 3 { lens_set_status(st_engine_no_delete); return 0; }
    if load8(g_ollama_model) == 0 { lens_set_status(st_no_model); return 0; }
    p = str_copy(g_delete_msg, del_msg_a);
    p = str_copy(p, g_ollama_model);
    str_copy(p, del_msg_b);
    if MessageBoxA(load64(g_hwnd), g_delete_msg, del_title, 0x24) != 6 { return 0; }
    if lens_begin_busy(4, st_deleting) == 0 { return 0; }
    CreateThread(0, 0, &lens_delete_thread, 0, 0, g_thread_id);
    return 1;
}

func lens_send_chat() -> i64 {
    if load64(g_busy) != 0 { lens_set_status(st_busy); return 0; }
    if load64(g_help_visible) == 1 { lens_show_help(0); }
    lens_harvest_all();
    gui_get_text(load64(g_input_ed), g_user_msg, 65536);
    if load8(g_user_msg) == 0 { lens_set_status(st_no_prompt); return 0; }
    if load8(lens_backend_model_ptr(load64(g_backend))) == 0 { lens_set_status(st_no_model); return 0; }
    if load64(g_backend) == 1 { if load64(g_cloud_provider) == 1 {
        if lcp_hf_url_allowed(g_openai_url) == 0 { lens_set_status(st_hf_url); return 0; }
        if GetEnvironmentVariableA(env_hf, g_key, 1024) == 0 { lens_set_status(st_nokey_hf); lens_update_cloud_info(); return 0; }
        if lcp_hf_text_only(load64(g_has_image), load64(g_has_file)) == 0 { lens_set_status(st_hf_attach); return 0; }
        if lens_hf_confirm_send() == 0 { lens_set_status(st_ready); return 0; }
    } }
    if load64(g_backend) == 3 {
        if lens_aether_is_local() == 1 {
            state = lens_aether_forward_cached(g_aether_model);
            if state == 2 { return lens_aether_warn_unsupported(g_aether_model); }
            if state != 1 {
                if lens_show_model(g_aether_model) == 1 {
                    lens_set_status(st_engine_validate_send);
                } else { lens_set_status(st_showfail); }
                return 0;
            }
        }
    }
    if load64(g_edit_pending) == 1 {
        pos = load64(g_edit_pos);
        if pos >= 0 { if pos <= strlen(load64(g_transcript_p)) { store8(load64(g_transcript_p) + pos, 0); } }
        store64(g_edit_pending, 0);
    }
    lens_knowledge_prepare();
    lens_clear_runtime_info();
    store64(g_dual_vision_used, 0);
    store64(g_aether_vision_sent, 0);
    store64(g_aether_vision_route, 0);
    store8(g_vision_model, 0);
    store8(load64(g_vision_notes_p), 0);
    lens_copy_str(load64(g_prior_p), load64(g_transcript_p), 524288);
    if load64(g_backend) == 0 {
        if load64(g_has_image) == 1 {
            if lens_model_has_vision(g_ollama_model) == 0 {
                if lens_find_first_vision_model(g_tmp) == 0 { lens_append_raw(warn_vision); }
            }
        }
    } else if load64(g_backend) == 3 {
        if load64(g_has_image) == 1 {
            helper_installed = 0;
            if lens_find_aether_vision_model(g_tmp) == 1 { helper_installed = 1; }
            route = lvp_aether_route(1, g_aether_model, g_img_mime, load64(g_vision_mode), helper_installed, lens_aether_is_local());
            store64(g_aether_vision_route, route);
            if route == 1 { store64(g_aether_vision_sent, 1); }
            else if route == 2 { store64(g_aether_vision_sent, 1); }
            else { lens_append_raw(warn_aether_vision); }
        }
    }
    lens_append_user(g_user_msg);
    lens_archive_pending_image();
    lens_archive_pending_document();
    lens_append_sent_image_note();
    lens_append_sent_file_note();
    if load8(load64(g_knowledge_note_p)) != 0 { lens_append_note(load64(g_knowledge_note_p)); }
    lens_refresh_transcript();
    SetWindowTextA(load64(g_input_ed), "");
    lens_config_save();
    busy_status = st_chatting;
    if load64(g_backend) == 3 { busy_status = st_engine; }
    if lens_begin_busy(2, busy_status) == 0 { return 0; }
    if load64(g_canvas_armed) == 1 {
        store64(g_canvas_request_active, 1);
        store64(g_canvas_armed, 0);
    } else { store64(g_canvas_request_active, 0); }
    if load64(g_backend) == 0 { lens_pulse_begin(); }
    else { if load64(g_backend) == 3 { lens_pulse_begin(); } }
    CreateThread(0, 0, &lens_chat_thread, 0, 0, g_thread_id);
    return 1;
}

func lens_stop() -> i64 {
    if load64(g_busy_kind) == 2 { store64(g_pulse_manual_stop, 1); }
    if load64(g_busy_kind) == 6 { store64(g_arena_stop, 1); }
    if load64(g_busy_kind) == 7 { store64(g_web_cancel, 1); }
    if load64(g_busy_kind) == 8 { store64(g_search_cancel, 1); }
    lt_abort();
    lens_set_status(st_stopping);
    return 0;
}

func lens_finish_refresh() -> i64 {
    lens_end_busy();
    if load64(g_backend_display) == 1 { if load64(g_cloud_provider) == 1 {
        if load64(g_http_status) == 200 {
            rows = lens_fill_hf_models();
            if rows > 0 { lens_set_status(st_hf_browsed); }
            else { lens_set_status(st_hf_browse_fail); }
        } else { lens_set_status(st_hf_browse_fail); }
        lens_update_cloud_info();
        return 0;
    } }
    if load64(g_http_status) == 200 {
        lens_fill_models();
        lens_refresh_attachment_ui();
        if load64(g_backend_display) == 3 {
            lens_update_cloud_info();
            lens_show_model(g_aether_model);
        } else { if load64(g_backend_display) != 0 { lens_update_cloud_info(); } }
        lens_set_status(st_refreshed);
    } else {
        if load64(g_backend_display) == 0 { lens_set_details(st_refreshfail); }
        else { lens_update_cloud_info(); }
        lens_set_status(st_refreshfail);
    }
    return 0;
}

func lens_finish_chat() -> i64 {
    lens_end_busy();
    lens_preview_clear();
    if load64(g_backend) == 0 {
        if load64(g_pulse_manual_stop) == 1 {
            if lens_extract_ollama_stream(load64(g_reply_p), 1048576) <= 0 { str_copy(load64(g_reply_p), "[stopped]"); }
            lens_pulse_finish_error();
        } else if load64(g_http_status) == 200 {
            if lens_extract_ollama_stream(load64(g_reply_p), 1048576) <= 0 { str_copy(load64(g_reply_p), st_emptyreply); }
            lens_update_runtime_info();
        }
        else { lens_extract_reply(); lens_pulse_finish_error(); }
        lens_render_stream_reply(1);
    } else if load64(g_backend) == 3 {
        if load64(g_pulse_manual_stop) == 1 {
            if lens_extract_ollama_stream(load64(g_reply_p), 1048576) <= 0 { str_copy(load64(g_reply_p), "[stopped]"); }
            lens_pulse_finish_error();
        } else if load64(g_http_status) == 200 {
            if lens_extract_ollama_stream(load64(g_reply_p), 1048576) <= 0 { str_copy(load64(g_reply_p), st_emptyreply); }
            lens_update_runtime_info();
        }
        else {
            if load64(g_http_status) == 0 { str_copy(load64(g_reply_p), st_aether_fail); }
            else { lens_extract_reply(); }
            lens_pulse_finish_error();
        }
        lens_render_stream_reply(1);
    } else {
        # Cloud replies can already be painted incrementally by
        # lens_chat_progress. Rebuild the final frame from the saved prior
        # transcript instead of appending the completed reply a second time.
        lens_render_stream_reply(1);
    }
    store64(g_has_image, 0);
    store64(g_has_file, 0);
    store64(g_dual_vision_used, 0);
    store64(g_aether_vision_sent, 0);
    store64(g_aether_vision_route, 0);
    store64(g_img_bytes, 0);
    store64(g_file_bytes, 0);
    store64(g_file_kind, 0);
    store8(g_file_name, 0);
    store8(load64(g_file_text_p), 0);
    store8(g_vision_model, 0);
    store8(load64(g_vision_notes_p), 0);
    lens_refresh_attachment_ui();
    GetClientRect(load64(g_hwnd), g_rect);
    lens_layout(load32(g_rect + 8), load32(g_rect + 12));
    if load64(g_pulse_state) == 4 { lens_set_status(st_stopped); }
    else if load64(g_pulse_state) == 5 { lens_set_status(st_chatfail); }
    else if load64(g_pulse_state) == 3 {
        if strcmp(g_pulse_reason, "length") == 0 { lens_set_status(st_reply_limit); }
        else { lens_set_status(g_pulse_status_text); }
    }
    else { lens_set_status(st_done); }
    if load64(g_canvas_request_active) == 1 {
        store64(g_canvas_request_active, 0);
        lens_canvas_open_last_answer_kind(load64(g_canvas_request_kind));
    }
    return 0;
}

func lens_finish_show() -> i64 {
    lens_end_busy();
    if load64(g_backend) == 3 {
        if load64(g_http_status) == 200 {
            lens_append_aether_inspect();
            lens_set_status(st_showed);
            if load64(g_aether_use_pending) == 1 {
                if strcmp(g_aether_pending_model, g_show_model) == 0 {
                    store64(g_aether_use_pending, 0);
                    if load64(g_aether_forward_state) == 1 { return lens_use_aether_model(g_aether_pending_model); }
                    return lens_aether_warn_unsupported(g_aether_pending_model);
                }
            }
        } else {
            store64(g_aether_use_pending, 0);
            lens_set_status(st_showfail);
        }
        return 0;
    }
    lens_update_model_details(g_show_model);
    if load64(g_http_status) == 200 {
        lens_append_show_details();
        lens_append_show_info();
        lens_set_status(st_showed);
    } else {
        lens_set_status(st_showfail);
    }
    return 0;
}

func lens_finish_pull() -> i64 {
    lens_end_busy();
    if load64(g_backend) == 3 {
        if load64(g_http_status) == 200 {
            p = str_copy(load64(g_reply_p), "Aether Engine pulled and SHA-256 verified ");
            str_copy(p, g_aether_model);
            lens_aether_stop_owned();
        } else { lens_copy_str(load64(g_reply_p), load64(g_resp_p), 1048576); }
    } else {
        if load64(g_http_status) == 200 { lens_extract_last_status(load64(g_reply_p), 1048576); }
        else { lens_extract_reply(); }
    }
    lens_append_note(load64(g_reply_p));
    lens_refresh_transcript();
    lens_set_status(st_pulled);
    lens_refresh_models();
    return 0;
}

func lens_finish_delete() -> i64 {
    lens_end_busy();
    lens_set_status(st_deleted);
    lens_refresh_models();
    return 0;
}

func lens_build_filters() -> i64 {
    p = gui_file_filter_first(g_img_filter, flt_img_a, flt_img_b);
    p = gui_file_filter_add(p, flt_all_a, flt_all_b);
    gui_file_filter_done(p);
    pt = gui_file_filter_first(g_text_filter, flt_text_a, flt_text_b);
    pt = gui_file_filter_add(pt, flt_all_a, flt_all_b);
    gui_file_filter_done(pt);
    pl = gui_file_filter_first(g_lens_filter, flt_lens_a, flt_lens_b);
    pl = gui_file_filter_add(pl, flt_all_a, flt_all_b);
    gui_file_filter_done(pl);
    p2 = gui_file_filter_first(g_md_filter, flt_md_a, flt_md_b);
    p2 = gui_file_filter_add(p2, flt_all_a, flt_all_b);
    gui_file_filter_done(p2);
    return 0;
}

