func lens_document_preview_open_path(path: i64) -> i64 {
    n = lens_read_file(path, load64(g_doc_preview_p), 262144);
    if n < 0 { lens_set_status(st_asset_missing); return 0; }
    str_copy(g_doc_preview_path, path);
    lens_file_name_from_path(path, g_doc_preview_title, 256);
    return lens_document_preview_show();
}

func LensDocumentPreviewProc(hwnd: i64, msg: i64, wp: i64, lp: i64) -> i64 {
    if msg == 1 {
        store32(g_dwm_dark, 1);
        DwmSetWindowAttribute(hwnd, 20, g_dwm_dark, 4);
        DwmSetWindowAttribute(hwnd, 19, g_dwm_dark, 4);
        ed = CreateWindowExA(0, rich_cls, load64(g_doc_preview_p), LENS_RICH_WRAP, 14, 50, 876, 590, hwnd, 0, load64(g_hinst), 0);
        store64(g_doc_preview_ed, ed);
        gui_set_font(ed, load64(g_font_mono));
        SendMessageA(ed, 0x443, COLOR_EDIT, 0);
        SendMessageA(ed, 0xCF, 1, 0);
        if lens_ends_with_ci(g_doc_preview_path, md_ext) == 1 {
            lens_style_markdown(ed, load64(g_doc_preview_p), 0, strlen(load64(g_doc_preview_p)), 0);
        }
        return 0;
    }
    if msg == 5 {
        w = gui_loword(lp);
        h = gui_hiword(lp);
        if load64(g_doc_preview_ed) != 0 { MoveWindow(load64(g_doc_preview_ed), 14, 50, w - 28, h - 64, 1); }
        return 0;
    }
    if msg == 256 { if wp == 27 { lens_document_preview_close(); return 0; } }
    if msg == 16 { lens_document_preview_close(); return 0; }
    if msg == 2 { store64(g_doc_preview_hwnd, 0); store64(g_doc_preview_ed, 0); return 0; }
    if msg == 15 {
        hdc = BeginPaint(hwnd, g_ps);
        GetClientRect(hwnd, g_preview_rc);
        w = load32(g_preview_rc + 8);
        h = load32(g_preview_rc + 12);
        FillRect(hdc, g_preview_rc, load64(g_br_bg));
        gdi_fill_xy(hdc, 0, 0, w, 38, load64(g_br_panel));
        SetBkMode(hdc, 1);
        SetTextColor(hdc, COLOR_TEXT);
        of = SelectObject(hdc, load64(g_font_ui));
        gdi_rect_set(g_thumb_rc, 14, 8, w - 14, 34);
        DrawTextA(hdc, g_doc_preview_title, 0 - 1, g_thumb_rc, 0x8024);
        SelectObject(hdc, of);
        EndPaint(hwnd, g_ps);
        return 0;
    }
    if msg == 20 { return 1; }
    return DefWindowProcA(hwnd, msg, wp, lp);
}

func lens_draw_queued_image(hdc: i64, l: i64, t: i64, r: i64, b: i64) -> i64 {
    hb = load64(g_img_hbm);
    iw = load32(g_img_w);
    ih = load32(g_img_h);
    if hb == 0 { return 0; }
    if iw <= 0 { return 0; }
    if ih <= 0 { return 0; }
    aw = r - l;
    ah = b - t;
    if aw <= 0 { return 0; }
    if ah <= 0 { return 0; }
    dw = aw;
    dh = dw * ih / iw;
    if dh > ah {
        dh = ah;
        dw = dh * iw / ih;
    }
    dx = l + (aw - dw) / 2;
    dy = t + (ah - dh) / 2;
    mem = CreateCompatibleDC(hdc);
    old = SelectObject(mem, hb);
    SetStretchBltMode(hdc, 3);
    StretchBlt(hdc, dx, dy, dw, dh, mem, 0, 0, iw, ih, 0x00CC0020);
    SelectObject(mem, old);
    DeleteDC(mem);
    return 1;
}

func LensPreviewProc(hwnd: i64, msg: i64, wp: i64, lp: i64) -> i64 {
    if msg == 1 {
        store32(g_dwm_dark, 1);
        DwmSetWindowAttribute(hwnd, 20, g_dwm_dark, 4);
        DwmSetWindowAttribute(hwnd, 19, g_dwm_dark, 4);
        return 0;
    }
    if msg == 256 {
        if wp == 27 { lens_image_preview_close(); return 0; }
    }
    if msg == 513 { lens_image_preview_close(); return 0; }
    if msg == 16 { lens_image_preview_close(); return 0; }
    if msg == 2 { store64(g_preview_hwnd, 0); return 0; }
    if msg == 15 {
        hdc = BeginPaint(hwnd, g_ps);
        GetClientRect(hwnd, g_preview_rc);
        w = load32(g_preview_rc + 8);
        h = load32(g_preview_rc + 12);
        FillRect(hdc, g_preview_rc, load64(g_br_bg));
        gdi_fill_xy(hdc, 0, 0, w, 38, load64(g_br_panel));
        SetBkMode(hdc, 1);
        SetTextColor(hdc, COLOR_TEXT);
        of = SelectObject(hdc, load64(g_font_ui));
        gdi_rect_set(g_thumb_rc, 14, 8, w - 14, 32);
        DrawTextA(hdc, title_preview, 0 - 1, g_thumb_rc, 0x8020);
        gdi_rect_set(g_thumb_rc, 18, 50, w - 18, h - 52);
        lens_draw_queued_image(hdc, 18, 50, w - 18, h - 52);
        SetTextColor(hdc, COLOR_MUTED);
        gdi_rect_set(g_thumb_rc, 18, h - 34, w - 18, h - 10);
        DrawTextA(hdc, "Click, Esc, or close to dismiss", 0 - 1, g_thumb_rc, 0x25);
        SelectObject(hdc, of);
        EndPaint(hwnd, g_ps);
        return 0;
    }
    if msg == 20 { return 1; }
    return DefWindowProcA(hwnd, msg, wp, lp);
}

func lens_image_preview_open() -> i64 {
    if load64(g_img_hbm) == 0 { lens_set_status(st_imgfail); return 0; }
    if load64(g_preview_hwnd) != 0 {
        BringWindowToTop(load64(g_preview_hwnd));
        InvalidateRect(load64(g_preview_hwnd), 0, 1);
        return 1;
    }
    pw = 920;
    ph = 680;
    hwnd = CreateWindowExA(0, cls_preview, title_preview, 0x16CF0000, 140, 80, pw, ph, 0, 0, load64(g_hinst), 0);
    store64(g_preview_hwnd, hwnd);
    if hwnd == 0 { return 0; }
    lens_set_app_icon(hwnd);
    ShowWindow(hwnd, 1);
    UpdateWindow(hwnd);
    return 1;
}

func lens_attachment_hit(x: i64, y: i64) -> i64 {
    if load64(g_has_image) == 0 { if load64(g_has_file) == 0 { return 0; } }
    if x < load32(g_attach_rc + 0) { return 0; }
    if y < load32(g_attach_rc + 4) { return 0; }
    if x > load32(g_attach_rc + 8) { return 0; }
    if y > load32(g_attach_rc + 12) { return 0; }
    return 1;
}

func lens_attachment_preview_open() -> i64 {
    if load64(g_has_image) == 1 { return lens_image_preview_open(); }
    if load64(g_has_file) == 1 { return lens_document_preview_current(); }
    lens_set_status(st_preview_none);
    return 0;
}

func lens_arena_stats_text(dst: i64, tps: i64, prompt: i64, reply: i64, ms: i64, status: i64) -> i64 {
    p = str_copy(dst, "Pulse: "); int_to_str(g_tmp, tps); p = str_copy(p, g_tmp); p = str_copy(p, " tok/s  |  prompt ");
    int_to_str(g_tmp, prompt); p = str_copy(p, g_tmp); p = str_copy(p, "  |  reply ");
    int_to_str(g_tmp, reply); p = str_copy(p, g_tmp); p = str_copy(p, "  |  elapsed ");
    int_to_str(g_tmp, ms); p = str_copy(p, g_tmp); p = str_copy(p, " ms  |  ");
    if status == 200 { str_copy(p, "complete"); }
    else if status < 0 { str_copy(p, "not run"); }
    else if status == 0 { if load64(g_busy_kind) == 6 { str_copy(p, "waiting"); } else { str_copy(p, "failed"); } }
    else { str_copy(p, "failed"); }
    return dst;
}

func lens_arena_refresh_window() -> i64 {
    hwnd = load64(g_arena_hwnd);
    if hwnd == 0 { return 0; }
    left_model = g_arena_model_a;
    right_model = g_arena_model_b;
    left_result = load64(g_arena_result_a_p);
    right_result = load64(g_arena_result_b_p);
    left_tps = load64(g_arena_tps_a); left_prompt = load64(g_arena_prompt_tokens_a); left_reply = load64(g_arena_reply_tokens_a); left_ms = load64(g_arena_ms_a); left_status = load64(g_arena_status_a);
    right_tps = load64(g_arena_tps_b); right_prompt = load64(g_arena_prompt_tokens_b); right_reply = load64(g_arena_reply_tokens_b); right_ms = load64(g_arena_ms_b); right_status = load64(g_arena_status_b);
    if load64(g_arena_left_is_a) == 0 {
        left_model = g_arena_model_b; right_model = g_arena_model_a;
        left_result = load64(g_arena_result_b_p); right_result = load64(g_arena_result_a_p);
        left_tps = load64(g_arena_tps_b); left_prompt = load64(g_arena_prompt_tokens_b); left_reply = load64(g_arena_reply_tokens_b); left_ms = load64(g_arena_ms_b); left_status = load64(g_arena_status_b);
        right_tps = load64(g_arena_tps_a); right_prompt = load64(g_arena_prompt_tokens_a); right_reply = load64(g_arena_reply_tokens_a); right_ms = load64(g_arena_ms_a); right_status = load64(g_arena_status_a);
    }
    hidden = 0;
    if load64(g_arena_blind) == 1 { if load64(g_arena_voted) == 0 { hidden = 1; } }
    if hidden == 1 {
        SetWindowTextA(load64(g_arena_left_label), arena_response_left);
        SetWindowTextA(load64(g_arena_right_label), arena_response_right);
    } else {
        SetWindowTextA(load64(g_arena_left_label), left_model);
        SetWindowTextA(load64(g_arena_right_label), right_model);
    }
    if load8(left_result) == 0 { SetWindowTextA(load64(g_arena_left_ed), arena_waiting); }
    else { SetWindowTextA(load64(g_arena_left_ed), left_result); }
    if load8(right_result) == 0 { SetWindowTextA(load64(g_arena_right_ed), arena_waiting); }
    else { SetWindowTextA(load64(g_arena_right_ed), right_result); }
    lens_arena_stats_text(g_arena_stats_left, left_tps, left_prompt, left_reply, left_ms, left_status);
    lens_arena_stats_text(g_arena_stats_right, right_tps, right_prompt, right_reply, right_ms, right_status);
    SetWindowTextA(load64(g_arena_left_stats), g_arena_stats_left);
    SetWindowTextA(load64(g_arena_right_stats), g_arena_stats_right);
    if load64(g_busy_kind) == 6 {
        if left_status == 0 { SetWindowTextA(load64(g_arena_hint), st_arena_running_a); }
        else { SetWindowTextA(load64(g_arena_hint), st_arena_running_b); }
    } else if load64(g_arena_complete) == 1 {
        if hidden == 1 { SetWindowTextA(load64(g_arena_hint), arena_blind_hint); }
        else if load64(g_arena_voted) == 1 {
            p = str_copy(g_arena_reveal, "Revealed: Left = "); p = str_copy(p, left_model); p = str_copy(p, "  |  Right = "); p = str_copy(p, right_model); str_copy(p, "  |  preference saved locally");
            SetWindowTextA(load64(g_arena_hint), g_arena_reveal);
        } else { SetWindowTextA(load64(g_arena_hint), arena_open_hint); }
    } else { SetWindowTextA(load64(g_arena_hint), arena_wait); }
    enabled = 1;
    if load64(g_busy_kind) == 6 { enabled = 0; }
    EnableWindow(load64(g_arena_model_a_cb), enabled);
    EnableWindow(load64(g_arena_model_b_cb), enabled);
    EnableWindow(load64(g_arena_prompt_ed), enabled);
    EnableWindow(load64(g_arena_btn_run), enabled);
    InvalidateRect(hwnd, 0, 1);
    return 1;
}

func lens_arena_copy_side(left: i64) -> i64 {
    if load64(g_arena_complete) == 0 { lens_set_status(st_arena_none); return 0; }
    src = load64(g_arena_result_a_p);
    if load64(g_arena_left_is_a) == 1 {
        if left == 0 { src = load64(g_arena_result_b_p); }
    } else {
        src = load64(g_arena_result_b_p);
        if left == 0 { src = load64(g_arena_result_a_p); }
    }
    gui_clip_write_text(load64(g_arena_hwnd), src, strlen(src));
    lens_set_status(st_arena_copied);
    return 1;
}

func lens_arena_layout(w: i64, h: i64) -> i64 {
    if w < 900 { w = 900; }
    if h < 560 { h = 560; }
    m = 20; gap = 18; col = (w - m * 2 - gap) / 2; rx = m + col + gap;
    MoveWindow(load64(g_arena_model_a_label), m, 54, 74, 24, 1);
    MoveWindow(load64(g_arena_model_a_cb), m + 78, 48, col - 78, 220, 1);
    MoveWindow(load64(g_arena_model_b_label), rx, 54, 74, 24, 1);
    MoveWindow(load64(g_arena_model_b_cb), rx + 78, 48, col - 78, 220, 1);
    MoveWindow(load64(g_arena_prompt_label), m, 86, 126, 24, 1);
    MoveWindow(load64(g_arena_prompt_ed), m + 130, 84, w - m * 2 - 130 - 146, 48, 1); lens_round(load64(g_arena_prompt_ed), w - m * 2 - 130 - 146, 48, 10);
    MoveWindow(load64(g_arena_btn_run), w - m - 136, 84, 136, 48, 1);
    edit_top = 188; edit_h = h - 284;
    MoveWindow(load64(g_arena_left_label), m, 140, col, 24, 1);
    MoveWindow(load64(g_arena_right_label), rx, 140, col, 24, 1);
    MoveWindow(load64(g_arena_left_stats), m, 164, col, 22, 1);
    MoveWindow(load64(g_arena_right_stats), rx, 164, col, 22, 1);
    MoveWindow(load64(g_arena_left_ed), m, edit_top, col, edit_h, 1); lens_round(load64(g_arena_left_ed), col, edit_h, 12);
    MoveWindow(load64(g_arena_right_ed), rx, edit_top, col, edit_h, 1); lens_round(load64(g_arena_right_ed), col, edit_h, 12);
    MoveWindow(load64(g_arena_hint), m, h - 84, w - m * 2, 24, 1);
    MoveWindow(load64(g_arena_btn_copy_left), m, h - 48, 92, 28, 1);
    MoveWindow(load64(g_arena_btn_vote_left), m + 102, h - 48, 96, 28, 1);
    MoveWindow(load64(g_arena_btn_vote_tie), w / 2 - 36, h - 48, 72, 28, 1);
    MoveWindow(load64(g_arena_btn_vote_right), w - m - 198, h - 48, 96, 28, 1);
    MoveWindow(load64(g_arena_btn_copy_right), w - m - 92, h - 48, 92, 28, 1);
    MoveWindow(load64(g_arena_btn_options), w - 168, 16, 76, 26, 1);
    MoveWindow(load64(g_arena_btn_close), w - 86, 16, 66, 26, 1);
    return 1;
}

func lens_arena_create_controls(hwnd: i64) -> i64 {
    hinst = load64(g_hinst); f = load64(g_font_ui); fb = load64(g_font_bold); fm = load64(g_font_mono);
    h = gui_static_text(hwnd, hinst, arena_head, 20, 18, 800, 28); gui_set_font(h, fb);
    h = gui_static_text(hwnd, hinst, arena_model_a_label, 20, 54, 74, 24); store64(g_arena_model_a_label, h); gui_set_font(h, fb);
    cb = CreateWindowExA(0, cls_combo, "", 0x50200003, 98, 48, 422, 220, hwnd, ID_ARENA_MODEL_A, hinst, 0); store64(g_arena_model_a_cb, cb); gui_set_font(cb, f); lens_arena_combo_subclass(cb);
    h = gui_static_text(hwnd, hinst, arena_model_b_label, 560, 54, 74, 24); store64(g_arena_model_b_label, h); gui_set_font(h, fb);
    cb = CreateWindowExA(0, cls_combo, "", 0x50200003, 638, 48, 422, 220, hwnd, ID_ARENA_MODEL_B, hinst, 0); store64(g_arena_model_b_cb, cb); gui_set_font(cb, f); lens_arena_combo_subclass(cb);
    h = gui_static_text(hwnd, hinst, arena_prompt_label, 20, 86, 126, 24); store64(g_arena_prompt_label, h); gui_set_font(h, fb);
    if load8(load64(g_arena_prompt_p)) == 0 { gui_get_text(load64(g_input_ed), load64(g_arena_prompt_p), 65536); }
    e = CreateWindowExA(0, gui_edit, load64(g_arena_prompt_p), 0x50211044, 150, 84, 774, 48, hwnd, ID_ARENA_PROMPT, hinst, 0); store64(g_arena_prompt_ed, e); gui_set_font(e, fm); lens_dark_scroll(e); SendMessageA(e, 197, 65535, 0); lens_arena_prompt_subclass(e);
    b = lens_button(hwnd, hinst, ID_ARENA_RUN, arena_run, 934, 84, 136, 48); store64(g_arena_btn_run, b); gui_set_font(b, fb);
    h = gui_static_text(hwnd, hinst, arena_response_left, 20, 140, 500, 24); store64(g_arena_left_label, h); gui_set_font(h, fb);
    h = gui_static_text(hwnd, hinst, arena_response_right, 560, 140, 500, 24); store64(g_arena_right_label, h); gui_set_font(h, fb);
    h = gui_static_text(hwnd, hinst, "", 20, 164, 500, 22); store64(g_arena_left_stats, h); gui_set_font(h, f);
    h = gui_static_text(hwnd, hinst, "", 560, 164, 500, 22); store64(g_arena_right_stats, h); gui_set_font(h, f);
    e = CreateWindowExA(0, rich_cls, arena_waiting, LENS_RICH_WRAP, 20, 188, 500, 374, hwnd, 306, hinst, 0); store64(g_arena_left_ed, e); gui_set_font(e, fm); lens_dark_scroll(e); rich_limit_text(e, 1048576); rich_set_bg(e, COLOR_EDIT); rich_cf_color(g_cf, COLOR_TEXT); rich_set_charformat(e, SCF_ALL, g_cf); SendMessageA(e, 0xCF, 1, 0);
    e = CreateWindowExA(0, rich_cls, arena_waiting, LENS_RICH_WRAP, 560, 188, 500, 374, hwnd, 307, hinst, 0); store64(g_arena_right_ed, e); gui_set_font(e, fm); lens_dark_scroll(e); rich_limit_text(e, 1048576); rich_set_bg(e, COLOR_EDIT); rich_cf_color(g_cf, COLOR_TEXT); rich_set_charformat(e, SCF_ALL, g_cf); SendMessageA(e, 0xCF, 1, 0);
    h = gui_static_text(hwnd, hinst, arena_wait, 20, 590, 1040, 24); store64(g_arena_hint, h); gui_set_font(h, f);
    b = lens_button(hwnd, hinst, ID_ARENA_COPY_LEFT, arena_copy_left, 20, 630, 92, 28); store64(g_arena_btn_copy_left, b); gui_set_font(b, f);
    b = lens_button(hwnd, hinst, ID_ARENA_VOTE_LEFT, arena_vote_left, 122, 630, 96, 28); store64(g_arena_btn_vote_left, b); gui_set_font(b, f);
    b = lens_button(hwnd, hinst, ID_ARENA_VOTE_TIE, arena_vote_tie, 514, 630, 72, 28); store64(g_arena_btn_vote_tie, b); gui_set_font(b, f);
    b = lens_button(hwnd, hinst, ID_ARENA_VOTE_RIGHT, arena_vote_right, 882, 630, 96, 28); store64(g_arena_btn_vote_right, b); gui_set_font(b, f);
    b = lens_button(hwnd, hinst, ID_ARENA_COPY_RIGHT, arena_copy_right, 988, 630, 92, 28); store64(g_arena_btn_copy_right, b); gui_set_font(b, f);
    b = lens_button(hwnd, hinst, ID_ARENA_OPTIONS, arena_options, 932, 16, 76, 26); store64(g_arena_btn_options, b); gui_set_font(b, f);
    b = lens_button(hwnd, hinst, ID_ARENA_CLOSE, arena_close, 1014, 16, 66, 26); store64(g_arena_btn_close, b); gui_set_font(b, f);
    lens_arena_populate_models();
    GetClientRect(hwnd, g_rect); lens_arena_layout(load32(g_rect + 8), load32(g_rect + 12));
    lens_arena_refresh_window();
    return 1;
}

func lens_arena_close() -> i64 {
    if load64(g_arena_hwnd) != 0 { DestroyWindow(load64(g_arena_hwnd)); }
    return 1;
}

func LensArenaProc(hwnd: i64, msg: i64, wp: i64, lp: i64) -> i64 {
    if msg == 1 { lens_arena_create_controls(hwnd); return 0; }
    if msg == 5 { lens_arena_layout(gui_loword(lp), gui_hiword(lp)); return 0; }
    if msg == 16 { lens_arena_close(); return 0; }
    if msg == 2 {
        store64(g_arena_hwnd, 0);
        store64(g_arena_model_a_cb, 0); store64(g_arena_model_b_cb, 0); store64(g_arena_prompt_ed, 0);
        store64(g_arena_btn_run, 0); store64(g_arena_btn_options, 0);
        return 0;
    }
    if msg == 44 { return lens_measure_menu(lp); }
    if msg == 43 {
        if lens_draw_menu(lp) == 1 { return 1; }
        return lens_draw_button(lp);
    }
    if msg == 273 {
        id = gui_loword(wp);
        code = gui_hiword(wp);
        if id == ID_ARENA_PROMPT { gui_get_text(lp, load64(g_arena_prompt_p), 65535); return 0; }
        if id == ID_ARENA_MODEL_A { if code == 1 { lens_arena_combo_changed(); } return 0; }
        if id == ID_ARENA_MODEL_B { if code == 1 { lens_arena_combo_changed(); } return 0; }
        if id >= ID_ARENA_BLIND { if id <= ID_ARENA_CLEAR { lens_command(id, code); return 0; } }
        if id == ID_ARENA_RUN { lens_arena_start(); return 0; }
        if id == ID_ARENA_OPTIONS { lens_arena_menu_show(hwnd, load64(g_arena_btn_options)); return 0; }
        if id == ID_ARENA_VOTE_LEFT { lens_arena_vote(0 - 1); return 0; }
        if id == ID_ARENA_VOTE_TIE { lens_arena_vote(0); return 0; }
        if id == ID_ARENA_VOTE_RIGHT { lens_arena_vote(1); return 0; }
        if id == ID_ARENA_COPY_LEFT { lens_arena_copy_side(1); return 0; }
        if id == ID_ARENA_COPY_RIGHT { lens_arena_copy_side(0); return 0; }
        if id == ID_ARENA_CLOSE { lens_arena_close(); return 0; }
    }
    if msg == 307 { SetTextColor(wp, COLOR_TEXT); SetBkColor(wp, COLOR_BG); return load64(g_br_bg); }
    if msg == 312 { SetTextColor(wp, COLOR_TEXT); SetBkColor(wp, COLOR_BG); return load64(g_br_bg); }
    if msg == 308 { SetTextColor(wp, COLOR_TEXT); SetBkColor(wp, COLOR_EDIT); return load64(g_br_edit); }
    if msg == 15 {
        hdc = BeginPaint(hwnd, g_ps); GetClientRect(hwnd, g_rect);
        gdi_fill_xy(hdc, 0, 0, load32(g_rect + 8), load32(g_rect + 12), load64(g_br_bg));
        gdi_fill_xy(hdc, 0, 0, load32(g_rect + 8), 5, load64(g_br_arena));
        EndPaint(hwnd, g_ps); return 0;
    }
    if msg == 20 { return 1; }
    return DefWindowProcA(hwnd, msg, wp, lp);
}

func lens_arena_show() -> i64 {
    if load64(g_arena_hwnd) != 0 {
        if load64(g_busy_kind) != 6 { lens_arena_populate_models(); }
        BringWindowToTop(load64(g_arena_hwnd)); lens_arena_refresh_window(); return 1;
    }
    hwnd = CreateWindowExA(0, cls_arena, title_arena, 0x16CF0000, 120, 70, 1120, 720, load64(g_hwnd), 0, load64(g_hinst), 0);
    store64(g_arena_hwnd, hwnd);
    if hwnd == 0 { return 0; }
    lens_set_app_icon(hwnd); store32(g_dwm_dark, 1); DwmSetWindowAttribute(hwnd, 20, g_dwm_dark, 4); DwmSetWindowAttribute(hwnd, 19, g_dwm_dark, 4);
    ShowWindow(hwnd, 1); UpdateWindow(hwnd); lens_arena_refresh_window();
    return 1;
}

func lens_voice_review_refresh() -> i64 {
    if load64(g_voice_review_hwnd) == 0 { return 0; }
    SetWindowTextA(load64(g_voice_review_ed), load64(g_stt_text_p));
    p = str_copy(g_stt_runtime_line, voice_review_runtime_a);
    if load8(g_stt_runtime) == 0 { str_copy(p, lvstt_runtime_fallback); }
    else { str_copy(p, g_stt_runtime); }
    SetWindowTextA(load64(g_voice_review_runtime_lbl), g_stt_runtime_line);
    return 1;
}

func lens_voice_review_insert() -> i64 {
    if load64(g_voice_review_ed) == 0 { lens_set_status(st_stt_review_none); return 0; }
    gui_get_text(load64(g_voice_review_ed), load64(g_stt_text_p), 65536);
    if load8(load64(g_stt_text_p)) == 0 { lens_set_status(st_stt_review_empty); return 0; }
    gui_get_text(load64(g_input_ed), load64(g_stt_composer_p), 65536);
    used = strlen(load64(g_stt_composer_p)); add = strlen(load64(g_stt_text_p));
    if used > 0 {
        if used + add + 3 >= 65536 { lens_set_status(st_stt_failed); return 0; }
        store8(load64(g_stt_composer_p) + used, 13); store8(load64(g_stt_composer_p) + used + 1, 10); used = used + 2;
        str_copy(load64(g_stt_composer_p) + used, load64(g_stt_text_p));
    } else { str_copy(load64(g_stt_composer_p), load64(g_stt_text_p)); }
    DestroyWindow(load64(g_voice_review_hwnd));
    PostMessageA(load64(g_hwnd), 0x800B, 0, 0);
    return 1;
}

func lens_voice_review_commit() -> i64 {
    ed = GetDlgItem(load64(g_hwnd), ID_INPUT);
    SetWindowTextA(ed, load64(g_stt_composer_p));
    SetFocus(ed);
    lens_set_status(st_stt_inserted);
    return 1;
}

func lens_voice_review_copy() -> i64 {
    if load64(g_voice_review_ed) == 0 { lens_set_status(st_stt_review_none); return 0; }
    gui_get_text(load64(g_voice_review_ed), load64(g_stt_text_p), 65536);
    if load8(load64(g_stt_text_p)) == 0 { lens_set_status(st_stt_review_empty); return 0; }
    gui_clip_write_text(load64(g_voice_review_hwnd), load64(g_stt_text_p), strlen(load64(g_stt_text_p)));
    lens_set_status(st_stt_copied);
    return 1;
}

func lens_voice_review_layout(w: i64, h: i64) -> i64 {
    if w < 680 { w = 680; }
    if h < 440 { h = 440; }
    m = 20;
    MoveWindow(load64(g_voice_review_runtime_lbl), m, 54, w - m * 2, 24, 1);
    MoveWindow(load64(g_voice_review_notice_lbl), m, 80, w - m * 2, 24, 1);
    MoveWindow(load64(g_voice_review_ed), m, 112, w - m * 2, h - 188, 1); lens_round(load64(g_voice_review_ed), w - m * 2, h - 188, 12);
    MoveWindow(load64(g_voice_review_btn_insert), m, h - 56, 150, 30, 1);
    MoveWindow(load64(g_voice_review_btn_copy), m + 160, h - 56, 120, 30, 1);
    MoveWindow(load64(g_voice_review_btn_play), m + 290, h - 56, 94, 30, 1);
    MoveWindow(load64(g_voice_review_btn_again), m + 394, h - 56, 126, 30, 1);
    MoveWindow(load64(g_voice_review_btn_close), w - m - 76, h - 56, 76, 30, 1);
    return 1;
}

func lens_voice_review_create_controls(hwnd: i64) -> i64 {
    hinst = load64(g_hinst); f = load64(g_font_ui); fb = load64(g_font_bold); fm = load64(g_font_mono);
    h = gui_static_text(hwnd, hinst, voice_review_head, 20, 18, 600, 28); gui_set_font(h, fb);
    h = gui_static_text(hwnd, hinst, "", 20, 54, 740, 24); store64(g_voice_review_runtime_lbl, h); gui_set_font(h, f);
    h = gui_static_text(hwnd, hinst, voice_review_notice, 20, 80, 740, 24); store64(g_voice_review_notice_lbl, h); gui_set_font(h, f);
    e = CreateWindowExA(0, gui_edit, load64(g_stt_text_p), 0x50211044, 20, 112, 740, 300, hwnd, ID_VOICE_REVIEW_EDIT, hinst, 0);
    store64(g_voice_review_ed, e); gui_set_font(e, fm); lens_dark_scroll(e); SendMessageA(e, 197, 65535, 0);
    b = lens_button(hwnd, hinst, ID_VOICE_REVIEW_INSERT, voice_review_insert, 20, 430, 150, 30); store64(g_voice_review_btn_insert, b); gui_set_font(b, f);
    b = lens_button(hwnd, hinst, ID_VOICE_REVIEW_COPY, voice_review_copy, 180, 430, 120, 30); store64(g_voice_review_btn_copy, b); gui_set_font(b, f);
    b = lens_button(hwnd, hinst, ID_VOICE_REVIEW_PLAY, voice_review_play, 310, 430, 94, 30); store64(g_voice_review_btn_play, b); gui_set_font(b, f);
    b = lens_button(hwnd, hinst, ID_VOICE_REVIEW_AGAIN, voice_review_again, 414, 430, 126, 30); store64(g_voice_review_btn_again, b); gui_set_font(b, f);
    b = lens_button(hwnd, hinst, ID_VOICE_REVIEW_CLOSE, voice_review_close, 684, 430, 76, 30); store64(g_voice_review_btn_close, b); gui_set_font(b, f);
    GetClientRect(hwnd, g_rect); lens_voice_review_layout(load32(g_rect + 8), load32(g_rect + 12));
    lens_voice_review_refresh();
    return 1;
}

func LensVoiceReviewProc(hwnd: i64, msg: i64, wp: i64, lp: i64) -> i64 {
    if msg == 1 { lens_voice_review_create_controls(hwnd); return 0; }
    if msg == 5 { lens_voice_review_layout(gui_loword(lp), gui_hiword(lp)); return 0; }
    if msg == 16 { DestroyWindow(hwnd); return 0; }
    if msg == 2 {
        store64(g_voice_review_hwnd, 0); store64(g_voice_review_ed, 0);
        store64(g_voice_review_runtime_lbl, 0); store64(g_voice_review_notice_lbl, 0);
        return 0;
    }
    if msg == 43 { return lens_draw_button(lp); }
    if msg == 273 {
        id = gui_loword(wp);
        if id == ID_VOICE_REVIEW_INSERT { lens_voice_review_insert(); return 0; }
        if id == ID_VOICE_REVIEW_COPY { lens_voice_review_copy(); return 0; }
        if id == ID_VOICE_REVIEW_PLAY { lens_voice_play(); return 0; }
        if id == ID_VOICE_REVIEW_AGAIN { lens_voice_transcribe_start(); return 0; }
        if id == ID_VOICE_REVIEW_CLOSE { DestroyWindow(hwnd); return 0; }
    }
    if msg == 307 { SetTextColor(wp, COLOR_TEXT); SetBkColor(wp, COLOR_BG); return load64(g_br_bg); }
    if msg == 308 { SetTextColor(wp, COLOR_TEXT); SetBkColor(wp, COLOR_EDIT); return load64(g_br_edit); }
    if msg == 15 {
        hdc = BeginPaint(hwnd, g_ps); GetClientRect(hwnd, g_rect);
        gdi_fill_xy(hdc, 0, 0, load32(g_rect + 8), load32(g_rect + 12), load64(g_br_bg));
        gdi_fill_xy(hdc, 0, 0, load32(g_rect + 8), 5, load64(g_br_accent));
        EndPaint(hwnd, g_ps); return 0;
    }
    if msg == 20 { return 1; }
    return DefWindowProcA(hwnd, msg, wp, lp);
}

func lens_voice_review_show() -> i64 {
    if load8(load64(g_stt_text_p)) == 0 { lens_set_status(st_stt_review_none); return 0; }
    if load64(g_voice_review_hwnd) != 0 {
        BringWindowToTop(load64(g_voice_review_hwnd)); lens_voice_review_refresh(); return 1;
    }
    hwnd = CreateWindowExA(0, cls_voice_review, title_voice_review, 0x16CF0000, 190, 120, 820, 540, load64(g_hwnd), 0, load64(g_hinst), 0);
    store64(g_voice_review_hwnd, hwnd);
    if hwnd == 0 { return 0; }
    lens_set_app_icon(hwnd); store32(g_dwm_dark, 1); DwmSetWindowAttribute(hwnd, 20, g_dwm_dark, 4); DwmSetWindowAttribute(hwnd, 19, g_dwm_dark, 4);
    ShowWindow(hwnd, 1); UpdateWindow(hwnd); lens_voice_review_refresh();
    return 1;
}

func lens_layout(w: i64, h: i64) -> i64 {
    if w < 880 { w = 880; }
    if h < 560 { h = 560; }
    m = 12;
    gap = 10;
    statusH = 24;
    leftW = 360;
    rightX = leftW + gap + m;
    rightW = w - rightX - m;
    bottom = h - statusH - m;
    top = 12;
    listTop = 138;
    detailH = 160;
    listH = bottom - listTop - detailH - 54;
    if listH < 160 { listH = 160; }

    urlW = leftW - 100;
    modelW = leftW - 208;
    listW = leftW - 12;
    MoveWindow(load64(g_url_ed), 88, 38, urlW, 24, 1); lens_round(load64(g_url_ed), urlW, 24, 8);
    MoveWindow(load64(g_btn_refresh), leftW - 116, 68, 104, 24, 1);
    MoveWindow(load64(g_model_ed), 88, 100, modelW, 24, 1); lens_round(load64(g_model_ed), modelW, 24, 8);
    MoveWindow(load64(g_btn_use), leftW - 114, 100, 102, 24, 1);
    MoveWindow(load64(g_models), m, listTop, listW, listH, 1); lens_round(load64(g_models), listW, listH, 10);
    detTop = listTop + listH + 8;
    MoveWindow(load64(g_details_ed), m, detTop, listW, detailH, 1); lens_round(load64(g_details_ed), listW, detailH, 10);
    by = detTop + detailH + 8;
    MoveWindow(load64(g_btn_catalog), m, by, 104, 26, 1);
    MoveWindow(load64(g_btn_pull), m + 112, by, 86, 26, 1);
    MoveWindow(load64(g_btn_delete), m + 206, by, 112, 26, 1);

    MoveWindow(load64(g_backend_cb), rightX + 70, top, 180, 26, 1);
    MoveWindow(load64(g_preset_cb), rightX + 342, top, 174, 26, 1);
    chatNameW = rightW - 610;
    MoveWindow(load64(g_chatname_ed), rightX + 610, top, chatNameW, 24, 1); lens_round(load64(g_chatname_ed), chatNameW, 24, 8);

    infoH = 0;
    if load64(g_info_visible) == 1 { infoH = 120; }
    transTop = 44 + infoH;
    if infoH > 0 { transTop = transTop + 8; }
    attachH = 24;
    if load64(g_has_image) == 1 { attachH = 68; }
    if load64(g_has_file) == 1 { attachH = 68; }
    inputH = 92;
    buttonH = 28;
    transH = bottom - transTop - attachH - inputH - buttonH - 26;
    if transH < 220 { transH = 220; }
    if load64(g_info_visible) == 1 {
        ShowWindow(load64(g_info_ed), 1);
        MoveWindow(load64(g_info_ed), rightX, 44, rightW, infoH, 1); lens_round(load64(g_info_ed), rightW, infoH, 12);
    } else {
        ShowWindow(load64(g_info_ed), 0);
    }
    if load64(g_help_visible) == 1 {
        ShowWindow(load64(g_trans_ed), 0);
        MoveWindow(load64(g_help_ed), rightX, transTop, rightW, transH, 1); lens_round(load64(g_help_ed), rightW, transH, 14);
        ShowWindow(load64(g_help_ed), 1);
        BringWindowToTop(load64(g_help_ed));
    } else {
        ShowWindow(load64(g_help_ed), 0);
        ShowWindow(load64(g_trans_ed), 1);
        MoveWindow(load64(g_trans_ed), rightX, transTop, rightW, transH, 1); lens_round(load64(g_trans_ed), rightW, transH, 14);
    }
    attTop = transTop + transH + 8;
    gdi_rect_set(g_attach_rc, rightX, attTop, rightX + rightW, attTop + attachH);
    MoveWindow(load64(g_attach_lbl), rightX, attTop, rightW, attachH, 1); lens_round(load64(g_attach_lbl), rightW, attachH, 10);
    inTop = attTop + attachH + 4;
    MoveWindow(load64(g_input_ed), rightX, inTop, rightW, inputH, 1); lens_round(load64(g_input_ed), rightW, inputH, 14);
    bTop = inTop + inputH + 8;
    MoveWindow(load64(g_btn_attach), rightX, bTop, 44, 26, 1);
    MoveWindow(load64(g_btn_stop), rightX + 50, bTop, 66, 26, 1);
    MoveWindow(load64(g_btn_new), rightX + 122, bTop, 60, 26, 1);
    MoveWindow(load64(g_btn_save), rightX + 188, bTop, 56, 26, 1);
    MoveWindow(load64(g_btn_save_as), rightX + 250, bTop, 68, 26, 1);
    MoveWindow(load64(g_btn_load), rightX + 324, bTop, 56, 26, 1);
    MoveWindow(load64(g_btn_export), rightX + 386, bTop, 64, 26, 1);
    MoveWindow(load64(g_btn_copy), rightX + 456, bTop, 52, 26, 1);
    MoveWindow(load64(g_btn_info), rightX + 514, bTop, 54, 26, 1);
    MoveWindow(load64(g_btn_privacy), rightX + 574, bTop, 54, 26, 1);
    MoveWindow(load64(g_btn_arena), rightX + 634, bTop, 76, 26, 1);
    MoveWindow(load64(g_btn_help), rightX + 716, bTop, 52, 26, 1);
    MoveWindow(load64(g_btn_send), rightX + rightW - 40, bTop, 40, 26, 1);
    MoveWindow(load64(g_status), m, h - statusH, w - 2 * m, statusH, 1);
    return 0;
}

