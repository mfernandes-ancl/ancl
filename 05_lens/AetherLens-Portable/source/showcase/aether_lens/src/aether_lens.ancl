vision_prompt:  str = "Describe this image for another model. Focus on visible text, UI elements, diagrams, code, screenshots, errors, and important details. Be concise but complete.";
vision_prompt_engine_a: str = "Inspect the image pixels and answer the user's exact question. Return concise factual visual evidence that another model can use; do not guess from filenames and do not add unrelated details. User question:\n";
