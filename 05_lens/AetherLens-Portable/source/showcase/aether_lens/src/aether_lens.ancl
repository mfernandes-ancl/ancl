    lens_set_status(st_user_copied);
    return 1;
}

func lens_copy_last_exchange() -> i64 {
    if lens_find_last_user() == 0 { lens_set_status(st_no_user); return 0; }
    if lens_find_last_answer_start() == 0 { lens_set_status(st_no_answer); return 0; }
    if load64(g_last_answer_start) < load64(g_last_user_start) { lens_set_status(st_no_answer); return 0; }
    src = load64(g_transcript_p);
    lens_copy_span(load64(g_code_p), src, load64(g_last_user_start), strlen(src), 262144);
    gui_clip_write_text(load64(g_hwnd), load64(g_code_p), strlen(load64(g_code_p)));
    lens_set_status(st_exchange_copied);
    return 1;
