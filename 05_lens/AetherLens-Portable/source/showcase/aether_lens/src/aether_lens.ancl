    store64(g_tags_p, alloc(1048576));
    store64(g_req_p, alloc(4194304));
    store64(g_resp_p, alloc(4194304));
    store64(g_reply_p, alloc(1048576));
    store64(g_prompt_p, alloc(1048576));
    store64(g_prior_p, alloc(524288));
    store64(g_transcript_p, alloc(524288));
    store64(g_filebuf_p, alloc(1048576));
    store64(g_file_text_p, alloc(262144));
    store64(g_doc_preview_p, alloc(262144));
    store64(g_canvas_p, alloc(262144));
    store64(g_vision_notes_p, alloc(131072));
    store64(g_code_p, alloc(262144));
    store64(g_knowledge_manifest_p, alloc(262144));
    store64(g_knowledge_doc_p, alloc(262146));
    store64(g_knowledge_context_p, alloc(16384));
    store64(g_knowledge_note_p, alloc(8192));
    store64(g_arena_prompt_p, alloc(65536));
    store64(g_arena_result_a_p, alloc(1048576));
    store64(g_arena_result_b_p, alloc(1048576));
    store64(g_arena_history_p, alloc(1048576));
    store64(g_stt_text_p, alloc(65536));
    store64(g_stt_composer_p, alloc(65536));
    store64(g_tts_text_p, alloc(16384));
    store64(g_web_raw_p, alloc(131072));
    store64(g_web_text_p, alloc(65536));
    store64(g_search_raw_p, alloc(131072));
    store64(g_search_text_p, alloc(65536));
    store64(g_img_raw_p, alloc(2097152));
    store64(g_img_b64_p, alloc(2800000));
    if load64(g_tags_p) == 0 { return 0; }
    if load64(g_req_p) == 0 { return 0; }
    if load64(g_resp_p) == 0 { return 0; }
    if load64(g_reply_p) == 0 { return 0; }
    if load64(g_prompt_p) == 0 { return 0; }
    if load64(g_prior_p) == 0 { return 0; }
    if load64(g_transcript_p) == 0 { return 0; }
    if load64(g_filebuf_p) == 0 { return 0; }
    if load64(g_file_text_p) == 0 { return 0; }
    if load64(g_doc_preview_p) == 0 { return 0; }
    if load64(g_canvas_p) == 0 { return 0; }
    if load64(g_vision_notes_p) == 0 { return 0; }
    if load64(g_code_p) == 0 { return 0; }
    if load64(g_knowledge_manifest_p) == 0 { return 0; }
    if load64(g_knowledge_doc_p) == 0 { return 0; }
    if load64(g_knowledge_context_p) == 0 { return 0; }
    if load64(g_knowledge_note_p) == 0 { return 0; }
    if load64(g_arena_prompt_p) == 0 { return 0; }
    if load64(g_arena_result_a_p) == 0 { return 0; }
    if load64(g_arena_result_b_p) == 0 { return 0; }
    if load64(g_arena_history_p) == 0 { return 0; }
    if load64(g_stt_text_p) == 0 { return 0; }
    if load64(g_stt_composer_p) == 0 { return 0; }
    if load64(g_tts_text_p) == 0 { return 0; }
    if load64(g_web_raw_p) == 0 { return 0; }
    if load64(g_web_text_p) == 0 { return 0; }
    if load64(g_search_raw_p) == 0 { return 0; }
    if load64(g_search_text_p) == 0 { return 0; }
    if load64(g_img_raw_p) == 0 { return 0; }
    if load64(g_img_b64_p) == 0 { return 0; }
    return 1;
}

