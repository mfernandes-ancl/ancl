func lens_web_shutdown() -> i64 {
    h = load64(g_web_thread);
    if h != 0 { store64(g_web_cancel, 1); lt_abort(); WaitForSingleObject(h, 20000); CloseHandle(h); store64(g_web_thread, 0); }
    return 1;
}

func lens_search_build_meta() -> i64 {
    p = str_copy(g_search_meta, search_meta_a); p = str_copy(p, g_search_query);
    p = str_copy(p, search_meta_b); int_to_str(g_tmp, load64(g_search_count)); p = str_copy(p, g_tmp);
    p = str_copy(p, web_http_meta); int_to_str(g_tmp, load64(g_search_status)); str_copy(p, g_tmp);
    return 1;
}

func lens_search_source_text(dst: i64, cap: i64) -> i64 {
    p = str_copy(dst, search_insert_a); p = str_copy(p, g_search_query); p = str_copy(p, search_insert_b);
    out = p - dst; src = load64(g_search_text_p); i = 0;
    while load8(src + i) != 0 { if out + 1 >= cap { break; } store8(dst + out, load8(src + i)); out = out + 1; i = i + 1; }
    store8(dst + out, 0); return out;
}

func lens_search_thread_fn(param: i64) -> i64 {
    store64(g_search_status, lt_web_get(g_search_url, load64(g_search_raw_p), 131072));
    if load64(g_search_cancel) == 1 { store64(g_search_status, 0); store8(load64(g_search_raw_p), 0); }
    store8(load64(g_search_text_p), 0); store64(g_search_count, 0);
    if load64(g_search_status) == 200 { lws_parse_rss(load64(g_search_raw_p), load64(g_search_text_p), 65536, 8, g_search_count); }
    PostMessageA(load64(g_hwnd), 0x800E, 0, 0); return 0;
}

func lens_search_finish() -> i64 {
    h = load64(g_search_thread); if h != 0 { CloseHandle(h); store64(g_search_thread, 0); }
    if load64(g_busy_kind) == 8 { lens_end_busy(); }
    if load64(g_search_query_ed) != 0 { EnableWindow(load64(g_search_query_ed), 1); }
    if load64(g_search_go_btn) != 0 { EnableWindow(load64(g_search_go_btn), 1); InvalidateRect(load64(g_search_go_btn), 0, 1); }
    status = load64(g_search_status); msg = web_failed;
    if status == 200 {
        if load64(g_search_count) == 0 { msg = search_none; lens_set_status(st_search_failed); }
        else { lens_search_build_meta(); msg = load64(g_search_text_p); lens_set_status(st_search_ready); }
    } else if status >= 300 {
        if status < 400 { msg = web_redirect; }
        else { p = str_copy(g_search_meta, web_http_a); int_to_str(g_tmp, status); p = str_copy(p, g_tmp); str_copy(p, web_http_b); msg = g_search_meta; }
        lens_set_status(st_search_failed);
    } else { lens_set_status(st_search_failed); }
    if load64(g_search_text_ed) != 0 { SetWindowTextA(load64(g_search_text_ed), msg); }
    if load64(g_search_meta_lbl) != 0 {
        if status == 200 { if load64(g_search_count) > 0 { SetWindowTextA(load64(g_search_meta_lbl), g_search_meta); } else { SetWindowTextA(load64(g_search_meta_lbl), search_none); } }
        else { SetWindowTextA(load64(g_search_meta_lbl), msg); }
    }
    return 1;
}

func lens_search_start() -> i64 {
    gui_get_text(load64(g_search_query_ed), g_search_query, 300);
    if lws_query_url(g_search_query, g_search_url, 1200) == 0 { SetWindowTextA(load64(g_search_meta_lbl), search_invalid); return 0; }
    p = str_copy(g_search_permission, search_permission_a); p = str_copy(p, g_search_query);
    p = str_copy(p, search_permission_b); p = str_copy(p, g_search_url); str_copy(p, search_permission_c);
    if MessageBoxA(load64(g_search_hwnd), g_search_permission, web_permission_title, 0x24) != 6 { lens_set_status(st_search_denied); return 0; }
    lwv2_navigate(g_search_url);
    if lwv2_ready() == 1 { SetWindowTextA(load64(g_search_meta_lbl), search_embedded_ready); lens_set_status(st_search_ready); return 1; }
    if lwv2_open(load64(g_search_hwnd), g_search_profile) == 1 {
        SetWindowTextA(load64(g_search_meta_lbl), search_empty); return 1;
    }
    h = ShellExecuteA(load64(g_search_hwnd), op_open, g_search_url, 0, 0, 1);
    if h <= 32 { lens_set_status(st_search_failed); return 0; }
    SetWindowTextA(load64(g_search_meta_lbl), search_embedded_failed); lens_set_status(st_search_fallback);
    return 1;
}

func lens_search_copy() -> i64 {
    if load64(g_search_count) == 0 { return 0; }
    lens_search_source_text(load64(g_filebuf_p), 1048576); gui_clip_write_text(load64(g_search_hwnd), load64(g_filebuf_p), strlen(load64(g_filebuf_p)));
    lens_set_status(st_search_copied); return 1;
}

func lens_search_insert() -> i64 {
    if load64(g_search_count) == 0 { return 0; }
    lens_search_source_text(g_search_insert, 32768); SendMessageA(load64(g_input_ed), 0xC2, 1, g_search_insert);
    SetFocus(load64(g_input_ed)); lens_set_status(st_search_inserted); return 1;
}

func LensWebSearchProc(hwnd: i64, msg: i64, wp: i64, lp: i64) -> i64 {
    if msg == 1 {
        store32(g_dwm_dark, 1); DwmSetWindowAttribute(hwnd, 20, g_dwm_dark, 4); DwmSetWindowAttribute(hwnd, 19, g_dwm_dark, 4);
        hinst = load64(g_hinst); f = load64(g_font_ui); fb = load64(g_font_bold); fm = load64(g_font_mono);
        h = gui_static_text(hwnd, hinst, search_head, 20, 18, 850, 28); gui_set_font(h, fb);
        h = gui_static_text(hwnd, hinst, search_notice, 20, 50, 850, 22); gui_set_font(h, f);
        h = gui_static_text(hwnd, hinst, search_query_label, 20, 82, 50, 24); gui_set_font(h, f);
        e = CreateWindowExA(0, gui_edit, g_search_query, 0x50010080, 70, 78, 650, 30, hwnd, ID_SEARCH_QUERY, hinst, 0); store64(g_search_query_ed, e); gui_set_font(e, fm); SendMessageA(e, 197, 256, 0);
        b = lens_button(hwnd, hinst, ID_SEARCH_GO, search_go, 730, 78, 130, 30); store64(g_search_go_btn, b); gui_set_font(b, f);
        h = gui_static_text(hwnd, hinst, search_empty, 20, 118, 840, 42); store64(g_search_meta_lbl, h); gui_set_font(h, f);
        b = lens_button(hwnd, hinst, ID_SEARCH_CLOSE, search_close, 784, 666, 76, 30); gui_set_font(b, f);
        p = str_copy(g_search_profile, g_rootdir); str_copy(p, "\\webview2-profile"); CreateDirectoryA(g_search_profile, 0);
        lwv2_resize(20, 164, 860, 650); lwv2_open(hwnd, g_search_profile);
        SetFocus(load64(g_search_query_ed)); return 0;
    }
    if msg == 5 { w = gui_loword(lp); h = gui_hiword(lp); lwv2_resize(20, 164, w - 20, h - 70); if load64(g_search_meta_lbl) != 0 { MoveWindow(load64(g_search_meta_lbl), 20, 118, w - 40, 42, 1); } return 0; }
    if msg == 0x800F {
        if wp == 1 { SetWindowTextA(load64(g_search_meta_lbl), search_embedded_ready); if load8(g_search_url) != 0 { lens_set_status(st_search_ready); } }
        else {
            SetWindowTextA(load64(g_search_meta_lbl), search_embedded_failed);
            if load8(g_search_url) != 0 { h = ShellExecuteA(hwnd, op_open, g_search_url, 0, 0, 1); if h > 32 { lens_set_status(st_search_fallback); } else { lens_set_status(st_search_failed); } }
        }
        return 0;
    }
    if msg == 16 { lwv2_close(); DestroyWindow(hwnd); return 0; }
    if msg == 2 { lwv2_close(); store64(g_search_hwnd, 0); store64(g_search_query_ed, 0); store64(g_search_meta_lbl, 0); store64(g_search_text_ed, 0); store64(g_search_go_btn, 0); return 0; }
    if msg == 43 { return lens_draw_button(lp); }
    if msg == 273 {
        id = gui_loword(wp);
        if id == ID_SEARCH_GO { lens_search_start(); return 0; }
        if id == ID_SEARCH_CLOSE { lwv2_close(); DestroyWindow(hwnd); return 0; }
    }
    if msg == 307 { SetTextColor(wp, COLOR_TEXT); SetBkColor(wp, COLOR_EDIT); return load64(g_br_edit); }
    if msg == 312 { SetTextColor(wp, COLOR_TEXT); SetBkColor(wp, COLOR_BG); return load64(g_br_bg); }
    if msg == 15 { hdc = BeginPaint(hwnd, g_ps); GetClientRect(hwnd, g_rect); gdi_fill_xy(hdc, 0, 0, load32(g_rect + 8), load32(g_rect + 12), load64(g_br_bg)); gdi_fill_xy(hdc, 0, 0, load32(g_rect + 8), 5, load64(g_br_accent)); EndPaint(hwnd, g_ps); return 0; }
    if msg == 20 { return 1; }
    return DefWindowProcA(hwnd, msg, wp, lp);
}

func lens_web_search_show() -> i64 {
    if load64(g_search_hwnd) != 0 { ShowWindow(load64(g_search_hwnd), 1); BringWindowToTop(load64(g_search_hwnd)); SetFocus(load64(g_search_query_ed)); return 1; }
    lens_popup_position(900, 760);
    hwnd = CreateWindowExA(0, cls_web_search, title_web_search, 0x16CF0000, load32(g_popup_xy), load32(g_popup_xy + 4), 900, 760, load64(g_hwnd), 0, load64(g_hinst), 0);
    store64(g_search_hwnd, hwnd); if hwnd == 0 { return 0; }
