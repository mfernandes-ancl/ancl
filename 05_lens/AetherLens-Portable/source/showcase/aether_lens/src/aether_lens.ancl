    store64(g_aether_restrict, 0);
    store64(g_aether_style, 0);
    store64(g_aether_reasoning, 0);
    store64(g_aether_max, 128);
    store64(g_aether_spec, 1);
    store64(g_aether_time, 0);
    store64(g_aether_proc, 0);
    store64(g_model_context, 0);
