@CODE
func lens_last_bs(s: i64) -> i64 {
    i = 0;
    last = 0 - 1;
    while 1 {
        c = load8(s + i);
        if c == 0 { return last; }
        if c == 92 { last = i; }
        i = i + 1;
    }
    return last;
}

func lens_exedir(dst: i64) -> i64 {
    GetModuleFileNameA(0, g_exe, 700);
    bs = lens_last_bs(g_exe);
    if bs < 0 { store8(dst, 0); return 0; }
    memcpy(dst, g_exe, bs);
    store8(dst + bs, 0);
    return bs;
}

func lens_join(dst: i64, base: i64, suffix: i64) -> i64 {
    p = str_copy(dst, base);
    str_copy(p, suffix);
    return 0;
}

func lens_parent(dst: i64, src: i64) -> i64 {
    bs = lens_last_bs(src);
    if bs < 0 { store8(dst, 0); return 0; }
    memcpy(dst, src, bs);
    store8(dst + bs, 0);
    return bs;
}

func lens_is_bin_dir(path: i64) -> i64 {
    n = strlen(path);
    if n < 3 { return 0; }
    if load8(path + n - 3) != 98 { return 0; }
    if load8(path + n - 2) != 105 { return 0; }
    if load8(path + n - 1) != 110 { return 0; }
    return 1;
}

func lens_paths_init() -> i64 {
    lens_exedir(g_exedir);
    if lens_is_bin_dir(g_exedir) == 1 { lens_parent(g_rootdir, g_exedir); }
    else { str_copy(g_rootdir, g_exedir); }
    lens_join(g_cfgpath, g_rootdir, cfg_suffix);
    if band(GetFileAttributesA(g_cfgpath), 4294967295) == 4294967295 { store64(g_first_run, 1); }
    else { store64(g_first_run, 0); }
    lens_join(g_chatdir, g_rootdir, chats_suffix);
    CreateDirectoryA(g_chatdir, 0);
    lens_join(g_knowledge_dir, g_rootdir, knowledge_suffix);
    CreateDirectoryA(g_knowledge_dir, 0);
    lens_join(g_knowledge_docs_dir, g_knowledge_dir, knowledge_docs_suffix);
    CreateDirectoryA(g_knowledge_docs_dir, 0);
    lens_join(g_knowledge_excerpt_dir, g_knowledge_dir, knowledge_excerpt_suffix);
    CreateDirectoryA(g_knowledge_excerpt_dir, 0);
    lens_join(g_knowledge_manifest_path, g_knowledge_dir, knowledge_manifest_suffix);
    lens_join(g_arena_dir, g_rootdir, arena_suffix);
    CreateDirectoryA(g_arena_dir, 0);
    lens_join(g_arena_history_path, g_arena_dir, arena_history_suffix);
    lens_join(g_voice_dir, g_rootdir, voice_suffix);
    CreateDirectoryA(g_voice_dir, 0);
    lens_join(g_voice_last_path, g_voice_dir, voice_last_suffix);
    lens_join(g_voice_tts_path, g_voice_dir, voice_tts_suffix);
    lens_join(g_voice_tts_pending_path, g_voice_dir, voice_tts_pending_suffix);
    DeleteFileA(g_voice_tts_pending_path);
    return 0;
}

func lens_read_file(path: i64, dst: i64, cap: i64) -> i64 {
    h = CreateFileA(path, 0x80000000, 1, 0, 3, 0x80, 0);
    if h == 0 - 1 { return 0 - 1; }
    total = 0;
    while 1 {
        chunk = cap - total - 1;
        if chunk <= 0 { break; }
        if chunk > 65536 { chunk = 65536; }
        r = ReadFile(h, dst + total, chunk, g_io, 0);
        if r == 0 { break; }
        n = load32(g_io);
        if n == 0 { break; }
        total = total + n;
    }
    CloseHandle(h);
    store8(dst + total, 0);
    return total;
}

func lens_write_file(path: i64, src: i64, n: i64) -> i64 {
    h = CreateFileA(path, 0x40000000, 0, 0, 2, 0x80, 0);
    if h == 0 - 1 { return 0; }
    WriteFile(h, src, n, g_io, 0);
    CloseHandle(h);
    return 1;
}

func lens_voice_button_refresh() -> i64 {
    if load64(g_btn_voice) != 0 { InvalidateRect(load64(g_btn_voice), 0, 1); }
    return 0;
}

func lens_voice_release() -> i64 {
    h = load64(g_voice_hwi);
    if h != 0 {
        waveInReset(h);
        waveInUnprepareHeader(h, g_voice_hdr, 48);
        waveInClose(h);
    }
    store64(g_voice_hwi, 0);
    store64(g_voice_state, 0);
    if load64(g_hwnd) != 0 { KillTimer(load64(g_hwnd), 22); }
    lens_voice_button_refresh();
    return 0;
}

func lens_voice_start() -> i64 {
    if load64(g_voice_state) == 1 { lens_set_status(st_voice_active); return 1; }
    if load64(g_stt_state) == 1 { lens_set_status(st_stt_busy); return 0; }
    if load64(g_tts_state) == 1 { lens_set_status(st_tts_busy); return 0; }
    if load64(g_busy) != 0 { lens_set_status(st_voice_busy); return 0; }
    PlaySoundA(0, 0, 0);
    if waveInGetNumDevs() <= 0 { lens_set_status(st_voice_no_device); return 0; }
    if load64(g_voice_data_p) == 0 { store64(g_voice_data_p, alloc(1920000)); }
    if load64(g_voice_data_p) == 0 { lens_set_status(st_voice_start_fail); return 0; }

    memset(g_voice_fmt, 0, 20);
    store16(g_voice_fmt + 0, 1);
    store16(g_voice_fmt + 2, 1);
    store32(g_voice_fmt + 4, 16000);
    store32(g_voice_fmt + 8, 32000);
    store16(g_voice_fmt + 12, 2);
    store16(g_voice_fmt + 14, 16);
    store16(g_voice_fmt + 16, 0);
    memset(g_voice_hdr, 0, 48);
    store64(g_voice_hdr + 0, load64(g_voice_data_p));
    store32(g_voice_hdr + 8, 1920000);
    store32(g_voice_hdr + 12, 0);
    store64(g_voice_hwi, 0);

    if waveInOpen(g_voice_hwi, 4294967295, g_voice_fmt, 0, 0, 0) != 0 {
        store64(g_voice_hwi, 0);
        lens_set_status(st_voice_open_fail);
        return 0;
    }
    h = load64(g_voice_hwi);
    if waveInPrepareHeader(h, g_voice_hdr, 48) != 0 {
        waveInClose(h); store64(g_voice_hwi, 0); lens_set_status(st_voice_start_fail); return 0;
    }
    if waveInAddBuffer(h, g_voice_hdr, 48) != 0 {
        waveInUnprepareHeader(h, g_voice_hdr, 48); waveInClose(h); store64(g_voice_hwi, 0); lens_set_status(st_voice_start_fail); return 0;
    }
    if waveInStart(h) != 0 {
        lens_voice_release(); lens_set_status(st_voice_start_fail); return 0;
    }
    store64(g_voice_state, 1);
    store64(g_voice_start_tick, GetTickCount());
    SetTimer(load64(g_hwnd), 22, 250, 0);
    lens_voice_button_refresh();
    lens_set_status(st_voice_recording);
    return 1;
}

func lens_voice_finish(keep: i64) -> i64 {
    if load64(g_voice_state) != 1 { lens_set_status(st_voice_not_active); return 0; }
    h = load64(g_voice_hwi);
    waveInStop(h);
    waveInReset(h);
    bytes = band(load32(g_voice_hdr + 12), 4294967295);
    waveInUnprepareHeader(h, g_voice_hdr, 48);
    waveInClose(h);
    store64(g_voice_hwi, 0);
    store64(g_voice_state, 0);
    KillTimer(load64(g_hwnd), 22);
    lens_voice_button_refresh();
    if keep == 0 { lens_set_status(st_voice_cancelled); return 1; }
    if lvc_capture_usable(bytes, 32000) == 0 { lens_set_status(st_voice_short); return 0; }

    lvc_wav_header(g_voice_wav_header, bytes, 16000);
    fh = CreateFileA(g_voice_last_path, 0x40000000, 0, 0, 2, 0x80, 0);
    if fh == 0 - 1 { lens_set_status(st_voice_write_fail); return 0; }
    ok = WriteFile(fh, g_voice_wav_header, 44, g_io, 0);
    if ok != 0 { if load32(g_io) != 44 { ok = 0; } }
    if ok != 0 {
        ok = WriteFile(fh, load64(g_voice_data_p), bytes, g_io, 0);
        if ok != 0 { if band(load32(g_io), 4294967295) != bytes { ok = 0; } }
    }
    CloseHandle(fh);
    if ok == 0 { DeleteFileA(g_voice_last_path); lens_set_status(st_voice_write_fail); return 0; }
    lens_set_status(st_voice_saved);
    return 1;
}

func lens_voice_cancel_quiet() -> i64 {
    if load64(g_voice_state) != 1 { return 0; }
    h = load64(g_voice_hwi);
    waveInStop(h);
    lens_voice_release();
    return 1;
}

func lens_voice_play() -> i64 {
    if load64(g_voice_state) == 1 { lens_set_status(st_voice_active); return 0; }
    if GetFileAttributesA(g_voice_last_path) == 4294967295 { lens_set_status(st_voice_none); return 0; }
    PlaySoundA(g_voice_last_path, 0, 0x00020003);
    lens_set_status(st_voice_playing);
    return 1;
}

func lens_voice_stop_playback() -> i64 {
    PlaySoundA(0, 0, 0);
    lens_set_status(st_voice_play_stop);
    return 1;
}

func lens_voice_delete() -> i64 {
    if load64(g_voice_state) == 1 { lens_set_status(st_voice_active); return 0; }
    if load64(g_stt_state) == 1 { lens_set_status(st_stt_busy); return 0; }
    if GetFileAttributesA(g_voice_last_path) == 4294967295 { lens_set_status(st_voice_none); return 0; }
    if MessageBoxA(load64(g_hwnd), voice_delete_msg, voice_delete_title, 0x24) != 6 { return 0; }
    PlaySoundA(0, 0, 0);
    if DeleteFileA(g_voice_last_path) == 0 { lens_set_status(st_voice_write_fail); return 0; }
    lens_set_status(st_voice_deleted);
    return 1;
}

func lens_voice_tick() -> i64 {
    if load64(g_voice_state) != 1 { KillTimer(load64(g_hwnd), 22); return 0; }
    elapsed = band(GetTickCount() - load64(g_voice_start_tick), 4294967295);
    if elapsed >= 60000 {
        if lens_voice_finish(1) == 1 { lens_set_status(st_voice_cap); }
        return 0;
    }
    if band(load32(g_voice_hdr + 24), 1) != 0 {
        if lens_voice_finish(1) == 1 { lens_set_status(st_voice_cap); }
        return 0;
    }
    p = str_copy(g_voice_status_text, st_voice_recording);
    int_to_str(g_tmp, elapsed / 1000);
    p = str_copy(p, g_tmp);
    str_copy(p, st_voice_recording_b);
    lens_set_status(g_voice_status_text);
    return 1;
}

func lens_voice_menu_show() -> i64 {
    gui_menu_drop(load64(g_hwnd), load64(g_btn_voice), load64(g_voice_menu), g_rect);
    return 1;
}

func lens_voice_stt_thread(param: i64) -> i64 {
    rc = lvstt_transcribe_file(g_voice_last_path, load64(g_stt_text_p), 65536, g_stt_runtime, 256, g_stt_cancel);
    store64(g_stt_result, rc);
    PostMessageA(load64(g_hwnd), 0x800A, 0, 0);
    return 0;
}

func lens_voice_transcribe_start() -> i64 {
    if load64(g_voice_state) == 1 { lens_set_status(st_voice_active); return 0; }
    if load64(g_stt_state) == 1 { lens_set_status(st_stt_busy); return 0; }
    if load64(g_tts_state) == 1 { lens_set_status(st_tts_busy); return 0; }
    if load64(g_busy) != 0 { lens_set_status(st_busy); return 0; }
    if GetFileAttributesA(g_voice_last_path) == 4294967295 { lens_set_status(st_voice_none); return 0; }
    store8(load64(g_stt_text_p), 0);
    store8(g_stt_runtime, 0);
    store64(g_stt_cancel, 0);
    store64(g_stt_result, 0);
    store64(g_stt_state, 1);
    h = CreateThread(0, 0, &lens_voice_stt_thread, 0, 0, g_thread_id);
    store64(g_stt_thread, h);
    if h == 0 { store64(g_stt_state, 0); lens_set_status(st_stt_failed); return 0; }
    lens_set_status(st_stt_running);
    return 1;
}

func lens_voice_transcribe_cancel() -> i64 {
    if load64(g_stt_state) != 1 { lens_set_status(st_stt_review_none); return 0; }
    store64(g_stt_cancel, 1);
    lens_set_status(st_stt_cancel_wait);
    return 1;
}

func lens_voice_transcribe_finish() -> i64 {
    h = load64(g_stt_thread);
    if h != 0 { CloseHandle(h); store64(g_stt_thread, 0); }
    store64(g_stt_state, 0);
    rc = load64(g_stt_result);
    if rc == 1 { lens_voice_review_show(); lens_set_status(st_stt_ready); return 1; }
    if rc == 2 { lens_set_status(st_stt_empty); return 0; }
    if rc == 0 - 1 { lens_set_status(st_stt_unavailable); return 0; }
    if rc == 0 - 2 { lens_set_status(st_stt_input); return 0; }
    if rc == 0 - 4 { lens_set_status(st_stt_cancelled); return 0; }
    lens_set_status(st_stt_failed);
    return 0;
}

func lens_voice_stt_shutdown() -> i64 {
    if load64(g_stt_state) == 1 {
        store64(g_stt_cancel, 1);
        h = load64(g_stt_thread);
        if h != 0 { WaitForSingleObject(h, 3000); CloseHandle(h); }
    }
    store64(g_stt_thread, 0);
    store64(g_stt_state, 0);
    return 0;
}

func lens_tts_copy_visible(src: i64) -> i64 {
    return lvtts_prepare_visible(src, load64(g_tts_text_p), 16384, load64(g_reasoning_visible), g_tts_truncated_flag);
}

func lens_tts_prepare_answer() -> i64 {
    if lens_extract_last_answer() == 0 { lens_set_status(st_tts_empty_answer); return 0; }
    if lens_tts_copy_visible(load64(g_code_p)) == 0 { lens_set_status(st_tts_empty_answer); return 0; }
    return 1;
}

func lens_tts_prepare_composer() -> i64 {
    n = rich_get_text_length(load64(g_input_ed));
    if n <= 0 { lens_set_status(st_tts_empty_composer); return 0; }
    store64(g_tts_truncated_flag, 0);
    if n >= 16384 { store64(g_tts_truncated_flag, 1); }
    gui_get_text(load64(g_input_ed), load64(g_tts_text_p), 16384);
    if load8(load64(g_tts_text_p)) == 0 { lens_set_status(st_tts_empty_composer); return 0; }
    return 1;
}

func lens_tts_thread(param: i64) -> i64 {
    rc = lvtts_synthesize_file(load64(g_tts_text_p), g_voice_tts_pending_path, g_tts_runtime, 256, g_tts_cancel);
    store64(g_tts_result, rc); PostMessageA(load64(g_hwnd), 0x800C, 0, 0); return 0;
}

func lens_tts_start_ready() -> i64 {
    if load64(g_voice_state) == 1 { lens_set_status(st_voice_active); return 0; }
    if load64(g_stt_state) == 1 { lens_set_status(st_stt_busy); return 0; }
    if load64(g_tts_state) == 1 { lens_set_status(st_tts_busy); return 0; }
    if load64(g_busy) != 0 { lens_set_status(st_busy); return 0; }
    PlaySoundA(0, 0, 0); DeleteFileA(g_voice_tts_pending_path);
    store8(g_tts_runtime, 0); store64(g_tts_cancel, 0); store64(g_tts_result, 0); store64(g_tts_state, 1);
    h = CreateThread(0, 0, &lens_tts_thread, 0, 0, g_thread_id); store64(g_tts_thread, h);
    if h == 0 { store64(g_tts_state, 0); lens_set_status(st_tts_failed); return 0; }
    lens_set_status(st_tts_running); return 1;
}

func lens_tts_speak_answer() -> i64 {
    if load64(g_tts_state) == 1 { lens_set_status(st_tts_busy); return 0; }
    if lens_tts_prepare_answer() == 0 { return 0; }
    return lens_tts_start_ready();
}

func lens_tts_speak_composer() -> i64 {
    if load64(g_tts_state) == 1 { lens_set_status(st_tts_busy); return 0; }
    if lens_tts_prepare_composer() == 0 { return 0; }
    return lens_tts_start_ready();
}

func lens_tts_stop() -> i64 {
    PlaySoundA(0, 0, 0);
    if load64(g_tts_state) == 1 { store64(g_tts_cancel, 1); lens_set_status(st_tts_cancel_wait); return 1; }
    lens_set_status(st_tts_stopped); return 1;
}

func lens_tts_replay() -> i64 {
    if load64(g_tts_state) == 1 { lens_set_status(st_tts_busy); return 0; }
    if band(GetFileAttributesA(g_voice_tts_path), 4294967295) == 4294967295 { lens_set_status(st_tts_none); return 0; }
    PlaySoundA(g_voice_tts_path, 0, 0x00020003);
    p = str_copy(g_tts_status_text, st_tts_speaking_a);
    if load8(g_tts_runtime) == 0 { p = str_copy(p, lvtts_runtime_fallback); } else { p = str_copy(p, g_tts_runtime); }
    str_copy(p, st_tts_speaking_b); lens_set_status(g_tts_status_text); return 1;
}

func lens_tts_finish() -> i64 {
    h = load64(g_tts_thread); if h != 0 { CloseHandle(h); store64(g_tts_thread, 0); }
    store64(g_tts_state, 0); rc = load64(g_tts_result);
    if rc == 1 {
        PlaySoundA(0, 0, 0); DeleteFileA(g_voice_tts_path);
        if MoveFileA(g_voice_tts_pending_path, g_voice_tts_path) == 0 { DeleteFileA(g_voice_tts_pending_path); lens_set_status(st_tts_write_fail); return 0; }
        PlaySoundA(g_voice_tts_path, 0, 0x00020003);
        p = str_copy(g_tts_status_text, st_tts_speaking_a);
        if load8(g_tts_runtime) == 0 { p = str_copy(p, lvtts_runtime_fallback); } else { p = str_copy(p, g_tts_runtime); }
        p = str_copy(p, st_tts_speaking_b);
        if load64(g_tts_truncated_flag) == 1 { str_copy(p, st_tts_truncated); }
        lens_set_status(g_tts_status_text); return 1;
    }
    DeleteFileA(g_voice_tts_pending_path);
    if rc == 0 - 1 { lens_set_status(st_tts_unavailable); return 0; }
    if rc == 0 - 4 { lens_set_status(st_tts_cancelled); return 0; }
    lens_set_status(st_tts_failed); return 0;
}

func lens_tts_delete() -> i64 {
    if load64(g_tts_state) == 1 { lens_set_status(st_tts_busy); return 0; }
    if band(GetFileAttributesA(g_voice_tts_path), 4294967295) == 4294967295 { lens_set_status(st_tts_none); return 0; }
    if MessageBoxA(load64(g_hwnd), voice_tts_delete_msg, voice_tts_delete_title, 0x24) != 6 { return 0; }
    PlaySoundA(0, 0, 0);
    if DeleteFileA(g_voice_tts_path) == 0 { lens_set_status(st_tts_write_fail); return 0; }
    lens_set_status(st_tts_deleted); return 1;
}

func lens_tts_shutdown() -> i64 {
    if load64(g_tts_state) == 1 {
        store64(g_tts_cancel, 1); h = load64(g_tts_thread);
        if h != 0 { WaitForSingleObject(h, 3000); CloseHandle(h); }
    }
    store64(g_tts_thread, 0); store64(g_tts_state, 0); DeleteFileA(g_voice_tts_pending_path); return 0;
}

func lens_aether_sanitize_url() -> i64 {
    if load8(g_aether_model) == 0 { str_copy(g_aether_model, default_aether_model); }
    # Only migrate the exact historical fixture value. Never treat a valid
    # user-selected registry tag as a reason to restore the built-in model.
    if strcmp(g_aether_model, old_aether_fixture) == 0 { str_copy(g_aether_model, default_aether_model); }
    if lt_match(g_aether_url, 0, lt_http) == 0 {
        if lt_match(g_aether_url, 0, lt_https) == 0 { str_copy(g_aether_url, default_aether_url); }
    }
    if strcmp(g_aether_url, g_ollama_url) == 0 { str_copy(g_aether_url, default_aether_url); }
    if load8(g_aether_exe) == 0 { lens_join(g_aether_exe, g_rootdir, default_aether_exe); }
    # Portable bundle: Lens and Engine sit side by side. Developer-tree clean
    # configs still fall back to the historical private Engine build path.
    lens_join(g_tmp2, g_rootdir, default_aether_exe);
    if strcmp(g_aether_exe, g_tmp2) == 0 {
        if GetFileAttributesA(g_aether_exe) == 4294967295 {
            lens_join(g_aether_exe, g_rootdir, legacy_aether_exe);
        }
    }
    return 0;
}

func lens_set_status(s: i64) -> i64 {
    if load64(g_status) != 0 { SetWindowTextA(load64(g_status), s); }
    return 0;
}

