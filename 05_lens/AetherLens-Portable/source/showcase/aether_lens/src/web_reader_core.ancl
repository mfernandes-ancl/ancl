# =====================================================================
# web_reader_core.ancl - URL gate and inert HTML/text extraction.
# Downloading is handled separately; this module never executes markup.
# =====================================================================

@CODE
func lwr_lower(c: i64) -> i64 {
    if c >= 65 { if c <= 90 { return c + 32; } }
    return c;
}

func lwr_match_ci(src: i64, pos: i64, pat: i64) -> i64 {
    i = 0;
    while load8(pat + i) != 0 {
        if load8(src + pos + i) == 0 { return 0; }
        if lwr_lower(load8(src + pos + i)) != lwr_lower(load8(pat + i)) { return 0; }
        i = i + 1;
    }
    return 1;
}

func lwr_contains(src: i64, pat: i64) -> i64 {
    i = 0;
    while load8(src + i) != 0 {
        j = 0;
        while load8(pat + j) != 0 {
            if load8(src + i + j) != load8(pat + j) { break; }
            j = j + 1;
        }
        if load8(pat + j) == 0 { return 1; }
        i = i + 1;
    }
    return 0;
}

func lwr_url_valid(url: i64, host_out: i64) -> i64 {
    n = strlen(url);
    if n < 8 { return 0; }
    if n > 1000 { return 0; }
    i = 0;
    if lwr_match_ci(url, 0, "https://") == 1 { i = 8; }
    else if lwr_match_ci(url, 0, "http://") == 1 { i = 7; }
    else { return 0; }
    h = 0;
    port_mode = 0;
    port = 0;
    port_digits = 0;
    while i < n {
        c = load8(url + i);
        if c == 47 { break; }
        if c == 35 { return 0; }
        if c == 64 { return 0; }
        if c == 92 { return 0; }
        if c == 58 {
            if port_mode == 1 { return 0; }
            port_mode = 1;
        } else if port_mode == 1 {
            if c < 48 { return 0; }
            if c > 57 { return 0; }
            port = port * 10 + c - 48;
            port_digits = port_digits + 1;
            if port > 65535 { return 0; }
        } else {
            ok = 0;
            if c >= 48 { if c <= 57 { ok = 1; } }
            lc = lwr_lower(c);
            if lc >= 97 { if lc <= 122 { ok = 1; } }
            if c == 45 { ok = 1; }
            if c == 46 { ok = 1; }
            if ok == 0 { return 0; }
            if h >= 253 { return 0; }
            store8(host_out + h, c);
            h = h + 1;
        }
        i = i + 1;
    }
    if h == 0 { return 0; }
    if load8(host_out) == 46 { return 0; }
    if load8(host_out + h - 1) == 46 { return 0; }
    if port_mode == 1 { if port_digits == 0 { return 0; } if port == 0 { return 0; } }
    store8(host_out + h, 0);
    while i < n {
        c = load8(url + i);
        if c <= 32 { return 0; }
        if c == 34 { return 0; }
        if c == 35 { return 0; }
        if c == 60 { return 0; }
        if c == 62 { return 0; }
        if c == 92 { return 0; }
        i = i + 1;
    }
    return 1;
}

func lwr_emit_space(dst: i64, out: i64, cap: i64, newline: i64) -> i64 {
    if out == 0 { return out; }
    prev = load8(dst + out - 1);
    if newline == 1 {
        if prev != 10 { if out + 1 < cap { store8(dst + out, 10); out = out + 1; } }
    } else {
        if prev != 32 { if prev != 10 { if out + 1 < cap { store8(dst + out, 32); out = out + 1; } } }
    }
    return out;
}

func lwr_block_tag(src: i64, pos: i64) -> i64 {
    if lwr_match_ci(src, pos, "<script") == 1 { return 1; }
    if lwr_match_ci(src, pos, "<style") == 1 { return 2; }
    return 0;
}

func lwr_break_tag(src: i64, pos: i64) -> i64 {
    if lwr_match_ci(src, pos, "<br") == 1 { return 1; }
    if lwr_match_ci(src, pos, "</p") == 1 { return 1; }
    if lwr_match_ci(src, pos, "</div") == 1 { return 1; }
    if lwr_match_ci(src, pos, "</li") == 1 { return 1; }
    if lwr_match_ci(src, pos, "</tr") == 1 { return 1; }
    if lwr_match_ci(src, pos, "</h") == 1 { return 1; }
    return 0;
}

func lwr_html_to_text(src: i64, dst: i64, cap: i64) -> i64 {
    if cap <= 1 { return 0; }
    i = 0; out = 0;
    while load8(src + i) != 0 {
        c = load8(src + i);
        if c == 60 {
            block = lwr_block_tag(src, i);
            if block != 0 {
                if block == 1 { close = "</script"; } else { close = "</style"; }
                i = i + 1;
                while load8(src + i) != 0 { if lwr_match_ci(src, i, close) == 1 { break; } i = i + 1; }
            }
            br = lwr_break_tag(src, i);
            quote = 0;
            while load8(src + i) != 0 {
                c = load8(src + i);
                if quote == 0 { if c == 34 { quote = 34; } else if c == 39 { quote = 39; } else if c == 62 { i = i + 1; break; } }
                else { if c == quote { quote = 0; } }
                i = i + 1;
            }
            if br == 1 { out = lwr_emit_space(dst, out, cap, 1); }
            continue;
        }
        if c == 38 {
            if lwr_match_ci(src, i, "&amp;") == 1 { c = 38; i = i + 5; }
            else if lwr_match_ci(src, i, "&lt;") == 1 { c = 60; i = i + 4; }
            else if lwr_match_ci(src, i, "&gt;") == 1 { c = 62; i = i + 4; }
            else if lwr_match_ci(src, i, "&quot;") == 1 { c = 34; i = i + 6; }
            else if lwr_match_ci(src, i, "&apos;") == 1 { c = 39; i = i + 6; }
            else if lwr_match_ci(src, i, "&nbsp;") == 1 { c = 32; i = i + 6; }
            else { i = i + 1; }
        } else { i = i + 1; }
        if c == 32 { out = lwr_emit_space(dst, out, cap, 0); continue; }
        if c == 9 { out = lwr_emit_space(dst, out, cap, 0); continue; }
        if c == 10 { out = lwr_emit_space(dst, out, cap, 1); continue; }
        if c == 13 { out = lwr_emit_space(dst, out, cap, 1); continue; }
        if c < 32 { continue; }
        if out + 1 >= cap { break; }
        store8(dst + out, c); out = out + 1;
    }
    while out > 0 {
        c = load8(dst + out - 1);
        if c == 32 { out = out - 1; continue; }
        if c == 10 { out = out - 1; continue; }
        break;
    }
    store8(dst + out, 0);
    return out;
}
