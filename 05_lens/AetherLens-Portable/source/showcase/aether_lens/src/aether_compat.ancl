# Pure parsing for Aether Engine's native GGUF compatibility report.

@CODE
func lac_contains(haystack: i64, needle: i64) -> i64 {
    if load8(needle) == 0 { return 1; }
    i = 0;
    while load8(haystack + i) != 0 {
        j = 0;
        while load8(needle + j) != 0 {
            if load8(haystack + i + j) != load8(needle + j) { break; }
            j = j + 1;
        }
        if load8(needle + j) == 0 { return 1; }
        i = i + 1;
    }
    return 0;
}

# 0 = no conclusive report, 1 = runnable, 2 = installed/inspectable but not runnable.
func lac_forward_state(report: i64) -> i64 {
    if lac_contains(report, "  forward status: supported") == 1 { return 1; }
    if lac_contains(report, "  forward status:") == 1 { return 2; }
    return 0;
}
