# ============================================================================
#  opc_explorer.ancl  -  Aether OPC Explorer (DA + UA + XML-DA)
#
#  A unified native Win32 OPC client/explorer with NexusEdge dark theme.
#  Phase 1: OPC UA Binary (TCP) â€” connect, browse, read, poll.
#  Phase 2: OPC DA (COM/DCOM) â€” enumerate, connect, browse, read, poll.
#  Phase 3: OPC XML-DA (HTTP/SOAP) â€” connect, browse, read.
#
#  Tabbed interface: [OPC UA] [OPC DA] [OPC XML]
#  Left: Browse tree (SysTreeView32)
#  Right: Value grid (SysListView32) + Poll controls
#  Bottom: Log panel
#
#  100% CRT-free PE32+, GUI subsystem.
# ============================================================================

import "std.ancl";
import "win32_api.ancl";
import "win32_com.ancl";
import "numfmt.ancl";

extern "ws2_32.dll" connect;
extern "gdi32.dll"  CreateFontA -> ptr;
extern "user32.dll" PostMessageA;
extern "kernel32.dll" GetSystemTimeAsFileTime;
extern "comctl32.dll" InitCommonControlsEx;
extern "dwmapi.dll" DwmSetWindowAttribute;
extern "user32.dll" TrackMouseEvent;
extern "gdi32.dll"  RoundRect;
extern "user32.dll" DrawTextA;
extern "user32.dll" GetWindowRect;
extern "user32.dll" GetParent -> ptr;
extern "user32.dll" SetCapture;
extern "user32.dll" ReleaseCapture;
extern "user32.dll" GetWindowLongA -> i64;
extern "user32.dll" SetWindowLongA -> i64;
extern "gdi32.dll"  GetStockObject -> ptr;
extern "uxtheme.dll" SetWindowTheme -> i32;
extern "user32.dll" DestroyWindow -> i32;
extern "kernel32.dll" GetProcAddress -> ptr;

