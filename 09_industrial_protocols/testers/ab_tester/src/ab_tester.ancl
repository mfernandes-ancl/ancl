# ============================================================================
# HELPER UTILITIES
# ============================================================================

func log_append(text: i64) -> i64 {
    hwnd_log = load64(g_log);
    if hwnd_log == 0 { return 0; }
    len = SendMessageA(hwnd_log, 14, 0, 0); # WM_GETTEXTLENGTH
    SendMessageA(hwnd_log, 177, len, len);  # EM_SETSEL
    SendMessageA(hwnd_log, 194, 0, text);   # EM_REPLACESEL
    return 0;
}

func str_equal(s1: i64, s2: i64) -> i64 {
    i = 0;
    while 1 {
        c1 = load8(s1 + i);
        c2 = load8(s2 + i);
        if c1 != c2 { return 0; }
        if c1 == 0 { return 1; }
        i = i + 1;
    }
    return 0;
}

func format_nibble(n: i64) -> i64 {
    if n >= 10 { return 55 + n; }
    return 48 + n;
}

func byte_to_hex(v: i64, dst: i64) -> i64 {
    store8(dst, format_nibble(band(shr(v, 4), 15)));
    store8(dst + 1, format_nibble(band(v, 15)));
    store8(dst + 2, 0);
    return 0;
}

func word_to_hex(v: i64, dst: i64) -> i64 {
    store8(dst, format_nibble(band(shr(v, 12), 15)));
    store8(dst + 1, format_nibble(band(shr(v, 8), 15)));
    store8(dst + 2, format_nibble(band(shr(v, 4), 15)));
    store8(dst + 3, format_nibble(band(v, 15)));
    store8(dst + 4, 0);
    return 0;
}

func dword_to_hex(v: i64, dst: i64) -> i64 {
    store8(dst, format_nibble(band(shr(v, 28), 15)));
    store8(dst + 1, format_nibble(band(shr(v, 24), 15)));
    store8(dst + 2, format_nibble(band(shr(v, 20), 15)));
    store8(dst + 3, format_nibble(band(shr(v, 16), 15)));
    store8(dst + 4, format_nibble(band(shr(v, 12), 15)));
    store8(dst + 5, format_nibble(band(shr(v, 8), 15)));
    store8(dst + 6, format_nibble(band(shr(v, 4), 15)));
    store8(dst + 7, format_nibble(band(v, 15)));
    store8(dst + 8, 0);
    return 0;
}

func store16_be(ptr: i64, val: i64) -> i64 {
    store8(ptr, band(shr(val, 8), 0xFF));
    store8(ptr + 1, band(val, 0xFF));
    return 0;
}


func log_recv_buf(len: i64) -> i64 {
    log_append("[AB Client] Recv PDU: ");
    i = 0;
    while i < len {
        val = load8(g_recv_buf + i);
        byte_to_hex(val, g_numbuf);
        log_append(g_numbuf);
        log_append(" ");
        i = i + 1;
    }
    log_append("\r\n");
    return 0;
}

# ============================================================================
# ETHERNET/IP & CIP PROTOCOL CLIENT ENGINE
# ============================================================================

func recv_n(s: i64, dst: i64, n: i64) -> i64 {
    got = 0;
    while got < n {
        r = recv(s, dst + got, n - got, 0);
        if r <= 0 { return 0 - 1; }
        got = got + r;
    }
    return n;
}

func recv_eip(s: i64, dst_buf: i64) -> i64 {
    if recv_n(s, dst_buf, 24) < 0 { return 0 - 1; }
    dl = load16(dst_buf + 2);
    if dl > 2000 { dl = 2000; }
    if dl > 0 {
        if recv_n(s, dst_buf + 24, dl) < 0 { return 0 - 1; }
    }
    return 24 + dl;
}

func drain_socket(s: i64) -> i64 {
    store64(g_nonblock, 1);
    ioctlsocket(s, 0x8004667E, g_nonblock);
    while recv(s, g_recv_buf, 2048, 0) > 0 {}
    return 0;
}

func send_browse_tags_job(s: i64, session_handle: i64, start_instance: i64) -> i64 {
    store16(g_send_buf + 0, 0x006F);
    store32(g_send_buf + 24, 0);
    store16(g_send_buf + 28, 0);
    store16(g_send_buf + 30, 2);
    store16(g_send_buf + 32, 0);
    store16(g_send_buf + 34, 0);
    store16(g_send_buf + 36, 0x00B2);
    
    store8(g_send_buf + 40, 0x55);
    store8(g_send_buf + 41, 2);
    store8(g_send_buf + 42, 0x20);
    store8(g_send_buf + 43, 0x6B);
    store8(g_send_buf + 44, 0x24);
    store8(g_send_buf + 45, start_instance);
    
    store16(g_send_buf + 46, 3);
    store16(g_send_buf + 48, 2);
    store16(g_send_buf + 50, 7);
    store16(g_send_buf + 52, 1);
    
    cip_len = 14;
    store16(g_send_buf + 38, cip_len);
    
    total_data_len = 16 + cip_len;
    store16(g_send_buf + 2, total_data_len);
    store32(g_send_buf + 4, session_handle);
    store32(g_send_buf + 8, 0);
    store64(g_send_buf + 12, 0);
    store32(g_send_buf + 20, 0);
    
    total_len = 24 + total_data_len;
    send(s, g_send_buf, total_len, 0);
    return 0;
}

func do_browse_tags() -> i64 {
    sock = load64(g_sock);
    if sock == 0 {
        log_append("[AB Client] Error: Not connected.\r\n");
        return 0;
    }
    session = load32(g_session);
    
    log_append("[AB Client] Browsing tags...\r\n");
    
    hlv = load64(g_listview);
    if hlv == 0 { return 0; }
    SendMessageA(hlv, 4105, 0, 0);
    
    start_instance = 1;
    total_found = 0;
    
    while 1 {
        drain_socket(sock);
        send_browse_tags_job(sock, session, start_instance);
        
        store64(g_nonblock, 0);
        ioctlsocket(sock, 0x8004667E, g_nonblock);
        
        tl = recv_eip(sock, g_recv_buf);
        
        store64(g_nonblock, 1);
        ioctlsocket(sock, 0x8004667E, g_nonblock);
        
        if tl <= 0 {
            log_append("[AB Client] Browse tags error or timeout.\r\n");
            break;
        }
        
        if load16(g_recv_buf + 0) != 0x006F {
            log_append("[AB Client] Browse response error: invalid EIP command.\r\n");
            break;
        }
        if load32(g_recv_buf + 8) != 0 {
            log_append("[AB Client] Browse response error: EIP error status.\r\n");
            break;
        }
        service_resp = load8(g_recv_buf + 40);
        if service_resp != 0xD5 {
            log_append("[AB Client] Browse response error: invalid CIP service reply.\r\n");
            break;
        }
        
        gen_status = load8(g_recv_buf + 42);
        if gen_status != 0 {
            if gen_status != 6 {
                log_append("[AB Client] Browse response error: CIP status error.\r\n");
                break;
            }
        }
        
        cip_len = load16(g_recv_buf + 38);
        data_len = cip_len - 4;
        if data_len <= 0 {
            break;
        }
        
        ptr = 44;
        limit = 44 + data_len;
        
        page_entries = 0;
        last_inst_id = start_instance;
        
        while ptr < limit {
            if ptr + 22 > limit {
                break;
            }
            
            inst_id = load32(g_recv_buf + ptr);
            sym_type = load16(g_recv_buf + ptr + 4);
            name_len = load16(g_recv_buf + ptr + 20);
            
            if ptr + 22 + name_len > limit {
                break;
            }
            
            memcpy(g_temp_text, g_recv_buf + ptr + 22, name_len);
            store8(g_temp_text + name_len, 0);
            
            type_str = "UNKNOWN";
            if sym_type == 0x00C1 { type_str = "BOOL"; }
            if sym_type == 0x00C3 { type_str = "INT"; }
            if sym_type == 0x00C4 { type_str = "DINT"; }
            if sym_type == 0x00D2 { type_str = "WORD"; }
            if sym_type == 0x00CA { type_str = "REAL"; }
            
            is_sys = 0;
            if name_len >= 2 {
                if load8(g_temp_text) == 95 {
                    if load8(g_temp_text + 1) == 95 {
                        is_sys = 1;
                    }
                }
            }
            
            if is_sys == 0 {
                insert_point_row(g_temp_text, type_str);
                total_found = total_found + 1;
            }
            
            last_inst_id = inst_id;
            ptr = ptr + 22 + name_len;
            page_entries = page_entries + 1;
        }
        
        if gen_status != 6 {
            break;
        }
        if page_entries == 0 {
            break;
        }
        start_instance = last_inst_id + 1;
    }
    
    log_append("[AB Client] Browse complete. Found ");
    int_to_str(g_numbuf, total_found);
    log_append(g_numbuf);
    log_append(" tags.\r\n");
    
    if load64(g_auto_poll) != 0 {
        handle_poll_timer();
    }
    
    return 0;
}

func build_symbol_path(tag_name: i64, dst_ptr: i64) -> i64 {
    len = strlen(tag_name);
    if len > 255 { len = 255; }
    
    store8(dst_ptr, 0x91); # Extended Symbol Segment
    store8(dst_ptr + 1, len);
    memcpy(dst_ptr + 2, tag_name, len);
    
    total_bytes = 2 + len;
    if band(total_bytes, 1) != 0 {
        store8(dst_ptr + total_bytes, 0);
        total_bytes = total_bytes + 1;
    }
    return total_bytes;
}

func send_read_tag_job(s: i64, session_handle: i64, tag_name: i64) -> i64 {
    path_len = build_symbol_path(tag_name, g_send_buf + 42);
    path_words = path_len / 2;
    
    store8(g_send_buf + 40, 0x4C); # Service: Read Tag
    store8(g_send_buf + 41, path_words);
    store16(g_send_buf + 42 + path_len, 1);
    
    cip_len = 2 + path_len + 2;
    
    store16(g_send_buf + 38, cip_len);
    
    store16(g_send_buf + 30, 2);
    store16(g_send_buf + 32, 0x0000);
    store16(g_send_buf + 34, 0x0000);
    store16(g_send_buf + 36, 0x00B2);
    
    store16(g_send_buf + 0, 0x006F); # SendRRData
    total_data_len = 16 + cip_len;
    store16(g_send_buf + 2, total_data_len);
    store32(g_send_buf + 4, session_handle);
    store32(g_send_buf + 8, 0);
    store64(g_send_buf + 12, 0);
    store32(g_send_buf + 20, 0);
    
    total_len = 24 + total_data_len;
    send(s, g_send_buf, total_len, 0);
    return 0;
}

func parse_read_tag_response(dst_val_dec: i64, dst_val_hex: i64, out_type_str: i64) -> i64 {
    if load16(g_recv_buf + 0) != 0x006F {
        return 0 - 1;
    }
    status = load32(g_recv_buf + 8);
    if status != 0 {
        return 0 - 2;
    }
    
    service_resp = load8(g_recv_buf + 40);
    if service_resp != 0xCC {
        return 0 - 3;
    }
    
    gen_status = load8(g_recv_buf + 42);
    if gen_status != 0 {
        return 0 - 4;
    }
    
    data_type = load16(g_recv_buf + 44);
    val_ptr = 46;
    
    val = 0;
    if data_type == 0x00C1 {
        str_copy(out_type_str, "BOOL");
        val = load8(g_recv_buf + val_ptr);
        if val != 0 {
            str_copy(dst_val_dec, "True");
        } else {
            str_copy(dst_val_dec, "False");
        }
        str_copy(dst_val_hex, dst_val_dec);
    } else if data_type == 0x00C3 {
        str_copy(out_type_str, "INT");
        val = load16(g_recv_buf + val_ptr);
        if val >= 32768 { val = val - 65536; }
        int_to_str(dst_val_dec, val);
        str_copy(dst_val_hex, "0x");
        word_to_hex(val, dst_val_hex + 2);
    } else if data_type == 0x00C4 {
        str_copy(out_type_str, "DINT");
        val = load32(g_recv_buf + val_ptr);
        if val >= 2147483648 { val = val - 4294967296; }
        int_to_str(dst_val_dec, val);
        str_copy(dst_val_hex, "0x");
        dword_to_hex(val, dst_val_hex + 2);
    } else if data_type == 0x00D2 {
        str_copy(out_type_str, "WORD");
        val = load16(g_recv_buf + val_ptr);
        int_to_str(dst_val_dec, val);
        str_copy(dst_val_hex, "0x");
        word_to_hex(val, dst_val_hex + 2);
    } else if data_type == 0x00CA {
        str_copy(out_type_str, "REAL");
        val = load32(g_recv_buf + val_ptr);
        nf_ftoa(val, dst_val_dec);
        str_copy(dst_val_hex, "0x");
        dword_to_hex(val, dst_val_hex + 2);
    } else {
        str_copy(out_type_str, "UNKNOWN");
        val = load32(g_recv_buf + val_ptr);
        int_to_str(dst_val_dec, val);
        str_copy(dst_val_hex, "0x");
        dword_to_hex(val, dst_val_hex + 2);
    }

    
    return 1;
}

func send_write_tag_job(s: i64, session_handle: i64, tag_name: i64, type: i64, val: i64) -> i64 {
    path_len = build_symbol_path(tag_name, g_send_buf + 42);
    path_words = path_len / 2;
    
    store8(g_send_buf + 40, 0x4D); # Service: Write Tag
    store8(g_send_buf + 41, path_words);
    
    cip_type = 0x00C3;
    val_size = 2;
    if type == 1 { cip_type = 0x00C1; val_size = 1; }
    if type == 2 { cip_type = 0x00C3; val_size = 2; }
    if type == 3 { cip_type = 0x00C4; val_size = 4; }
    if type == 4 { cip_type = 0x00D2; val_size = 2; }
    if type == 5 { cip_type = 0x00CA; val_size = 4; }
    
    store16(g_send_buf + 42 + path_len, cip_type);
    store16(g_send_buf + 42 + path_len + 2, 1);
    
    if val_size == 1 { store8(g_send_buf + 42 + path_len + 4, val); }
    if val_size == 2 { store16(g_send_buf + 42 + path_len + 4, val); }
    if val_size == 4 { store32(g_send_buf + 42 + path_len + 4, val); }
    
    cip_len = 2 + path_len + 4 + val_size;
    
    store16(g_send_buf + 38, cip_len);
    
    store16(g_send_buf + 30, 2);
    store16(g_send_buf + 32, 0x0000);
    store16(g_send_buf + 34, 0x0000);
    store16(g_send_buf + 36, 0x00B2);
    
    store16(g_send_buf + 0, 0x006F); # SendRRData
    total_data_len = 16 + cip_len;
    store16(g_send_buf + 2, total_data_len);
    store32(g_send_buf + 4, session_handle);
    store32(g_send_buf + 8, 0);
    store64(g_send_buf + 12, 0);
    store32(g_send_buf + 20, 0);
    
    total_len = 24 + total_data_len;
    send(s, g_send_buf, total_len, 0);
    return 0;
}

func parse_write_tag_response() -> i64 {
    if load16(g_recv_buf + 0) != 0x006F {
        return 0 - 1;
    }
    status = load32(g_recv_buf + 8);
    if status != 0 {
        return 0 - 2;
    }
    service_resp = load8(g_recv_buf + 40);
    if service_resp != 0xCD {
        return 0 - 3;
    }
    gen_status = load8(g_recv_buf + 42);
    if gen_status != 0 {
        return 0 - 4;
    }
    return 1;
}

# ============================================================================
# GUI LOGIC & OPERATIONS
# ============================================================================

func do_disconnect() -> i64 {
    sock = load64(g_sock);
    if sock != 0 {
        closesocket(sock);
        store64(g_sock, 0);
        WSACleanup();
        
        log_append("[AB Client] Disconnected.\r\n");
        SetWindowTextA(load64(g_status), "Status: Disconnected");
        SetWindowTextA(load64(g_btn_conn), "Connect");
        
        store64(g_auto_poll, 0);
        SetWindowTextA(load64(g_btn_poll), btn_poll_auto);
        KillTimer(load64(g_hwnd), 1);
        
        hlv = load64(g_listview);
        if hlv != 0 {
            count = SendMessageA(hlv, 4100, 0, 0);
            i = 0;
            while i < count {
                update_grid_value(i, "", "", "Offline");
                i = i + 1;
            }
        }
        InvalidateRect(load64(g_hwnd), 0, 1);
    }
    return 0;
}

func do_connect() -> i64 {
    sock = load64(g_sock);
    if sock != 0 { return 0; }
    
    GetWindowTextA(load64(g_host_ed), g_hostbuf, 256);
    GetWindowTextA(load64(g_port_ed), g_portbuf, 32);
    port = str_to_int(g_portbuf);
    if port < 1 { port = 44818; }
    
    log_append("[AB Client] Connecting to ");
    log_append(g_hostbuf);
    log_append(":");
    log_append(g_portbuf);
    log_append("...\r\n");
    
    WSAStartup(0x0202, g_wsa);
    
    memset(g_addr, 0, 16);
    store16(g_addr + 0, 2); # AF_INET
    store16_be(g_addr + 2, port);
    
    ip = 0;
    shift = 0;
    octet = 0;
    p = g_hostbuf;
    while load8(p) != 0 {
        c = load8(p);
        if c == 46 {
            ip = ip + shl(octet, shift);
            shift = shift + 8;
            octet = 0;
        } else {
            octet = octet * 10;
            octet = octet + c - 48;
        }
        p = p + 1;
    }
    ip = ip + shl(octet, shift);
    store32(g_addr + 4, ip);
    
    s = socket(2, 1, 6);
    if s == 0 - 1 {
        log_append("[AB Client] Failed to create socket.\r\n");
        WSACleanup();
        return 0;
    }
    
    store32(g_tmo, 3000);
    setsockopt(s, 65535, 4102, g_tmo, 4);
    
    rc = connect(s, g_addr, 16);
    if rc != 0 {
        closesocket(s);
        WSACleanup();
        log_append("[AB Client] Connection failed (unreachable or rejected).\r\n");
        return 0;
    }
    
    log_append("[AB Client] Sending RegisterSession...\r\n");
    memset(g_send_buf, 0, 32);
    store16(g_send_buf + 0, 0x0065);
    store16(g_send_buf + 2, 4);
    store16(g_send_buf + 24, 1);
    
    send(s, g_send_buf, 28, 0);
    
    tl = recv_eip(s, g_recv_buf);
    if tl <= 0 {
        closesocket(s);
        WSACleanup();
        log_append("[AB Client] Failed to receive RegisterSession response.\r\n");
        return 0;
    }
    
    if load16(g_recv_buf + 0) != 0x0065 {
        closesocket(s);
        WSACleanup();
        log_append("[AB Client] Invalid RegisterSession response.\r\n");
        return 0;
    }
    
    status = load32(g_recv_buf + 8);
    if status != 0 {
        closesocket(s);
        WSACleanup();
        log_append("[AB Client] RegisterSession status error.\r\n");
        return 0;
    }
    
    session = load32(g_recv_buf + 4);
    store32(g_session, session);
    
    log_append("[AB Client] EtherNet/IP Session registered. Session Handle: 0x");
    dword_to_hex(session, g_numbuf);
    log_append(g_numbuf);
    log_append("\r\n");
    
    store64(g_sock, s);
    
    store64(g_nonblock, 1);
    ioctlsocket(s, 0x8004667E, g_nonblock);
    
    SetWindowTextA(load64(g_status), "Status: Connected");
    SetWindowTextA(load64(g_btn_conn), "Connected");
    
    store64(g_auto_poll, 1);
    SetWindowTextA(load64(g_btn_poll), btn_poll_stop);
    SetTimer(load64(g_hwnd), 1, 1000, 0);
    
    handle_poll_timer();
    InvalidateRect(load64(g_hwnd), 0, 1);
    return 1;
}

func do_read_tag(tag_str: i64, row_idx: i64) -> i64 {
    sock = load64(g_sock);
    if sock == 0 { return 0; }
    session = load32(g_session);
    
    drain_socket(sock);
    
    send_read_tag_job(sock, session, tag_str);
    
    store64(g_nonblock, 0);
    ioctlsocket(sock, 0x8004667E, g_nonblock);
    
    tl = recv_eip(sock, g_recv_buf);
    
    store64(g_nonblock, 1);
    ioctlsocket(sock, 0x8004667E, g_nonblock);
    
    if tl <= 0 {
        do_disconnect();
        log_append("[AB Client] Error: Read response timeout or disconnected.\r\n");
        return 0;
    }
    
    parsed = parse_read_tag_response(g_valbuf_dec, g_valbuf_hex, g_temp_fc);
    if parsed < 0 {
        log_append("[AB Client] parse_read_tag_response failed: ");
        int_to_str(g_numbuf, parsed);
        log_append(g_numbuf);
        log_append("\r\n");
        log_recv_buf(32);
        update_grid_value(row_idx, "Err", "Err", "CIP Error");
        return 0;
    }
    
    update_grid_value(row_idx, g_valbuf_hex, g_valbuf_dec, "Success");
    
    if row_idx >= 0 {
        hlv = load64(g_listview);
        memset(g_lvitem, 0, 96);
        store32(g_lvitem + 0, 1); # mask = LVIF_TEXT = 1
        store32(g_lvitem + 4, row_idx); # iItem = row_idx
        store32(g_lvitem + 8, 1); # iSubItem = 1 (Type)
        store64(g_lvitem + 24, g_temp_fc);
        SendMessageA(hlv, 4142, row_idx, g_lvitem);
    }
    
    return 1;
}

func parse_float_string_to_f32_bits(s: i64) -> i64 {
    p = s;
    while load8(p) == 32 || load8(p) == 9 { p = p + 1; }
    
    sign = 1.0;
    if load8(p) == 45 { # '-'
        sign = 0.0 - 1.0;
        p = p + 1;
    } else if load8(p) == 43 { # '+'
        p = p + 1;
    }
    
    val = 0.0;
    while load8(p) >= 48 && load8(p) <= 57 {
        val = val * 10.0 + itof(load8(p) - 48);
        p = p + 1;
    }
    
    if load8(p) == 46 { # '.'
        p = p + 1;
        divisor = 10.0;
        while load8(p) >= 48 && load8(p) <= 57 {
            val = val + itof(load8(p) - 48) / divisor;
            divisor = divisor * 10.0;
            p = p + 1;
        }
    }
    
    fval = val * sign;
    bits = fbits(fval);
    sgn  = band(shr(bits, 63), 1);
    exp  = band(shr(bits, 52), 2047);
    mant = band(bits, 4503599627370495);
    
    if exp == 0 {
        return shl(sgn, 31);
    }
    if exp == 2047 {
        return shl(sgn, 31) + shl(255, 23) + shr(mant, 29);
    }
    
    new_exp = exp - 1023 + 127;
    if new_exp <= 0 {
        return shl(sgn, 31);
    }
    if new_exp >= 255 {
        return shl(sgn, 31) + shl(255, 23);
    }
    
    new_mant = shr(mant, 29);
    return shl(sgn, 31) + shl(new_exp, 23) + new_mant;
}

func do_write_tag(tag_str: i64, val_str: i64, row_idx: i64) -> i64 {
    sock = load64(g_sock);
    if sock == 0 {
        log_append("[AB Client] Error: Not connected.\r\n");
        return 0;
    }
    session = load32(g_session);
    
    type = 2;
    hlv = load64(g_listview);
    if row_idx >= 0 {
        memset(g_lvitem, 0, 96);
        store32(g_lvitem + 0, 1);
        store32(g_lvitem + 4, row_idx);
        store32(g_lvitem + 8, 1);
        store64(g_lvitem + 24, g_temp_fc);
        store32(g_lvitem + 32, 256);
        SendMessageA(hlv, 4141, row_idx, g_lvitem);
        
        if str_equal(g_temp_fc, "BOOL") != 0 { type = 1; }
        if str_equal(g_temp_fc, "INT") != 0 { type = 2; }
        if str_equal(g_temp_fc, "DINT") != 0 { type = 3; }
        if str_equal(g_temp_fc, "WORD") != 0 { type = 4; }
        if str_equal(g_temp_fc, "REAL") != 0 { type = 5; }
    }
    
    val = 0;
    if type == 1 { # BOOL
        if str_equal(val_str, "true") != 0 { val = 255; }
        else if str_equal(val_str, "True") != 0 { val = 255; }
        else if str_equal(val_str, "1") != 0 { val = 255; }
        else { val = 0; }
    } else if type == 5 { # REAL
        val = parse_float_string_to_f32_bits(val_str);
    } else {
        val = str_to_int(val_str);
    }
    
    drain_socket(sock);
    
    send_write_tag_job(sock, session, tag_str, type, val);
    
    store64(g_nonblock, 0);
    ioctlsocket(sock, 0x8004667E, g_nonblock);
    
    tl = recv_eip(sock, g_recv_buf);
    
    store64(g_nonblock, 1);
    ioctlsocket(sock, 0x8004667E, g_nonblock);
    
    if tl <= 0 {
        do_disconnect();
        log_append("[AB Client] Error: Write response timeout or disconnected.\r\n");
        return 0;
    }
    
    parsed = parse_write_tag_response();
    if parsed < 0 {
        log_append("[AB Client] CIP Write failed.\r\n");
        if row_idx >= 0 {
            update_grid_value(row_idx, "", "", "Write Err");
        }
        return 0;
    }
    
    log_append("[AB Client] Write successful: ");
    log_append(tag_str);
    log_append(" = ");
    log_append(val_str);
    log_append("\r\n");
    
    if row_idx >= 0 {
        do_read_tag(tag_str, row_idx);
    }
    return 1;
}

func handle_poll_toggle() -> i64 {
    sock = load64(g_sock);
    if sock == 0 {
        log_append("[AB Client] Error: Not connected.\r\n");
        return 0;
    }
    
    state = load64(g_auto_poll);
    hbtn = load64(g_btn_poll);
    if hbtn == 0 { return 0; }
    
    if state == 0 {
        store64(g_auto_poll, 1);
        SetWindowTextA(hbtn, btn_poll_stop);
        log_append("[AB Client] Auto polling started.\r\n");
        
        SetTimer(load64(g_hwnd), 1, 1000, 0);
        handle_poll_timer();
    } else {
        store64(g_auto_poll, 0);
        SetWindowTextA(hbtn, btn_poll_auto);
        log_append("[AB Client] Auto polling stopped.\r\n");
        
        KillTimer(load64(g_hwnd), 1);
    }
    return 0;
}

func handle_poll_timer() -> i64 {
    sock = load64(g_sock);
    if sock == 0 { return 0; }
    
    hlv = load64(g_listview);
    if hlv == 0 { return 0; }
    
    count = SendMessageA(hlv, 4100, 0, 0);
    i = 0;
    while i < count {
        memset(g_lvitem, 0, 96);
        store32(g_lvitem + 0, 1);
        store32(g_lvitem + 4, i);
        store32(g_lvitem + 8, 0);
        store64(g_lvitem + 24, g_temp_addr);
        store32(g_lvitem + 32, 256);
        SendMessageA(hlv, 4141, i, g_lvitem);
        
        do_read_tag(g_temp_addr, i);
        i = i + 1;
    }
    return 0;
}

func do_clear_log() -> i64 {
    SetWindowTextA(load64(g_log), gui_empty);
    return 0;
}

func do_save_log() -> i64 {
    hwnd_log = load64(g_log);
    if hwnd_log == 0 { return 0; }
    
    len = GetWindowTextA(hwnd_log, g_savebuf, 4096);
    if len <= 0 { return 0; }
    
    hf = CreateFileA(g_logpath, 0x40000000, 0, 0, 2, 128, 0);
    if hf == 0 - 1 {
        log_append(m_save_err);
        return 0;
    }
    
    WriteFile(hf, g_savebuf, len, g_numbuf, 0);
    CloseHandle(hf);
    log_append(m_save_ok);
    return 0;
}

func handle_manual_read() -> i64 {
    GetWindowTextA(load64(g_reg_ed), g_temp_addr, 256);
    if load8(g_temp_addr) == 0 {
        log_append("[AB Client] Error: Tag address edit field is empty.\r\n");
        return 0;
    }
    
    hlv = load64(g_listview);
    count = SendMessageA(hlv, 4100, 0, 0);
    row_idx = 0 - 1;
    i = 0;
    while i < count {
        memset(g_lvitem, 0, 96);
        store32(g_lvitem + 0, 1);
        store32(g_lvitem + 4, i);
        store32(g_lvitem + 8, 0);
        store64(g_lvitem + 24, g_temp_fc);
        store32(g_lvitem + 32, 256);
        SendMessageA(hlv, 4141, i, g_lvitem);
        
        if str_equal(g_temp_fc, g_temp_addr) != 0 {
            row_idx = i;
            break;
        }
        i = i + 1;
    }
    
    do_read_tag(g_temp_addr, row_idx);
    SetWindowTextA(load64(g_val_ed), g_valbuf_dec);
    return 0;
}

func handle_manual_write() -> i64 {
    GetWindowTextA(load64(g_reg_ed), g_temp_addr, 256);
    GetWindowTextA(load64(g_val_ed), g_numbuf, 32);
    
    if load8(g_temp_addr) == 0 {
        log_append("[AB Client] Error: Tag address edit field is empty.\r\n");
        return 0;
    }
    
    hlv = load64(g_listview);
    count = SendMessageA(hlv, 4100, 0, 0);
    row_idx = 0 - 1;
    
    i = 0;
    while i < count {
        memset(g_lvitem, 0, 96);
        store32(g_lvitem + 0, 1);
        store32(g_lvitem + 4, i);
        store32(g_lvitem + 8, 0);
        store64(g_lvitem + 24, g_temp_fc);
        store32(g_lvitem + 32, 256);
        SendMessageA(hlv, 4141, i, g_lvitem);
        
        if str_equal(g_temp_fc, g_temp_addr) != 0 {
            row_idx = i;
            break;
        }
        i = i + 1;
    }
    
    do_write_tag(g_temp_addr, g_numbuf, row_idx);
    return 0;
}

func handle_listview_click() -> i64 {
    hlv = load64(g_listview);
    sel_row = SendMessageA(hlv, 4108, 0 - 1, 2);
    if sel_row < 0 { return 0; }
    
    # Get Tag Name (Col 0)
    memset(g_lvitem, 0, 96);
    store32(g_lvitem + 0, 1);
    store32(g_lvitem + 4, sel_row);
    store32(g_lvitem + 8, 0);
    store64(g_lvitem + 24, g_temp_addr);
    store32(g_lvitem + 32, 256);
    SendMessageA(hlv, 4141, sel_row, g_lvitem);
    SetWindowTextA(load64(g_reg_ed), g_temp_addr);
    
    # Get Value (Col 3 - Dec)
    memset(g_lvitem, 0, 96);
    store32(g_lvitem + 0, 1);
    store32(g_lvitem + 4, sel_row);
    store32(g_lvitem + 8, 3);
    store64(g_lvitem + 24, g_numbuf);
    store32(g_lvitem + 32, 32);
    SendMessageA(hlv, 4141, sel_row, g_lvitem);
    SetWindowTextA(load64(g_val_ed), g_numbuf);
    
    return 0;
}

func handle_listview_double_click() -> i64 {
    handle_listview_click();
    
    hlv = load64(g_listview);
    sel_row = SendMessageA(hlv, 4108, 0 - 1, 2);
    if sel_row < 0 { return 0; }
    
    # Get Tag Name
    memset(g_lvitem, 0, 96);
    store32(g_lvitem + 0, 1);
    store32(g_lvitem + 4, sel_row);
    store32(g_lvitem + 8, 0);
    store64(g_lvitem + 24, g_temp_addr);
    store32(g_lvitem + 32, 256);
    SendMessageA(hlv, 4141, sel_row, g_lvitem);
    
    do_read_tag(g_temp_addr, sel_row);
    SetWindowTextA(load64(g_val_ed), g_valbuf_dec);
    
    return 0;
}

# ============================================================================
# LISTVIEW GRID HELPERS
# ============================================================================

func insert_point_row(addr_str: i64, type_str: i64) -> i64 {
    hlv = load64(g_listview);
    count = SendMessageA(hlv, 4100, 0, 0);
    
    memset(g_lvitem, 0, 96);
    store32(g_lvitem + 0, 1);
    store32(g_lvitem + 4, count);
    store32(g_lvitem + 8, 0);
    store64(g_lvitem + 24, addr_str);
    SendMessageA(hlv, 4103, 0, g_lvitem);
    
    memset(g_lvitem, 0, 96);
    store32(g_lvitem + 0, 1); # mask = LVIF_TEXT = 1
    store32(g_lvitem + 4, count); # iItem = count
    store32(g_lvitem + 8, 1); # iSubItem = 1 (Type)
    store64(g_lvitem + 24, type_str);
    SendMessageA(hlv, 4142, count, g_lvitem);
    
    memset(g_lvitem, 0, 96);
    store32(g_lvitem + 0, 1); # mask = LVIF_TEXT = 1
    store32(g_lvitem + 4, count); # iItem = count
    store32(g_lvitem + 8, 4); # iSubItem = 4 (Status)
    store64(g_lvitem + 24, "Offline");
    SendMessageA(hlv, 4142, count, g_lvitem);
    
    return 0;
}

func update_grid_value(row_idx: i64, hex_str: i64, dec_str: i64, status_str: i64) -> i64 {
    hlv = load64(g_listview);
    if hlv == 0 { return 0; }
    
    memset(g_lvitem, 0, 96);
    store32(g_lvitem + 0, 1);
    store32(g_lvitem + 4, row_idx);
    
    if load8(hex_str) != 0 {
        store32(g_lvitem + 8, 2);
        store64(g_lvitem + 24, hex_str);
        SendMessageA(hlv, 4142, row_idx, g_lvitem);
    }
    
    if load8(dec_str) != 0 {
        store32(g_lvitem + 8, 3);
        store64(g_lvitem + 24, dec_str);
        SendMessageA(hlv, 4142, row_idx, g_lvitem);
    }
    
    if load8(status_str) != 0 {
        store32(g_lvitem + 8, 4);
        store64(g_lvitem + 24, status_str);
        SendMessageA(hlv, 4142, row_idx, g_lvitem);
    }
    return 0;
}

func populate_default_registers() -> i64 {
    insert_point_row(tag_local_data,  "DINT");
    insert_point_row(tag_wtg_power,   "REAL");
    insert_point_row(tag_wtg_fault,   "BOOL");
    insert_point_row(tag_wtg_emerg,   "BOOL");
    insert_point_row(tag_wtg_running, "BOOL");
    return 0;
}

# ============================================================================
# DARK MODE OVERRIDES & GDI SUBCLASSING
# ============================================================================

func register_wide_string(dst: i64, src: i64) -> i64 {
    i = 0;
    while load8(src + i) != 0 {
        store16(dst + i * 2, load8(src + i));
        i = i + 1;
    }
    store16(dst + i * 2, 0);
    return 0;
}

func enable_dark_mode() -> i64 {
    register_wide_string(thm_dm_exp_w, "DarkMode_Explorer");
    register_wide_string(thm_dm_cfd_w, "CFD");
    hm = LoadLibraryA(thm_uxtheme);
    if hm != 0 {
        fn = GetProcAddress(hm, 135);
        if fn != 0 { callp(fn, 2); }
        store64(g_allowdark, GetProcAddress(hm, 133));
    }
    return 0;
}

func dark_scroll(hwnd: i64) -> i64 {
    ad = load64(g_allowdark);
    if ad != 0 { callp(ad, hwnd, 1); }
    SetWindowTheme(hwnd, thm_dm_exp_w, 0);
    return 0;
}

# Custom GlowButton procedure
func GlowButtonWndProc(hwnd: i64, msg: i64, wp: i64, lp: i64) -> i64 {
    if msg == 1 {
        SetWindowLongA(hwnd, 0 - 21, 0);
        return 0;
    }
    if msg == 512 {
        state = GetWindowLongA(hwnd, 0 - 21);
        hover = band(state, 1);
        if hover == 0 {
            pressed = band(state, 2);
            SetWindowLongA(hwnd, 0 - 21, bor(pressed, 1));
            InvalidateRect(hwnd, 0, 1);
            
            store32(g_track_mouse + 0, 24);
            store32(g_track_mouse + 4, 2);
            store64(g_track_mouse + 8, hwnd);
            store64(g_track_mouse + 16, 0);
            TrackMouseEvent(g_track_mouse);
        }
        return 0;
    }
    if msg == 675 {
        state = GetWindowLongA(hwnd, 0 - 21);
        pressed = band(state, 2);
        SetWindowLongA(hwnd, 0 - 21, pressed);
        InvalidateRect(hwnd, 0, 1);
        return 0;
    }
    if msg == 513 {
        state = GetWindowLongA(hwnd, 0 - 21);
        hover = band(state, 1);
        SetWindowLongA(hwnd, 0 - 21, bor(hover, 2));
        SetCapture(hwnd);
        InvalidateRect(hwnd, 0, 1);
        return 0;
    }
    if msg == 514 {
        state = GetWindowLongA(hwnd, 0 - 21);
        pressed = band(state, 2);
        if pressed == 2 {
            ReleaseCapture();
            hover = band(state, 1);
            SetWindowLongA(hwnd, 0 - 21, hover);
            InvalidateRect(hwnd, 0, 1);
            if hover == 1 {
                parent = GetParent(hwnd);
                id = GetWindowLongA(hwnd, 0 - 12);
                SendMessageA(parent, 273, id, hwnd);
            }
        }
        return 0;
    }
    if msg == 15 {
        hdc = BeginPaint(hwnd, g_ps);
        GetClientRect(hwnd, g_rect);
        w = load32(g_rect + 8);
        h = load32(g_rect + 12);
        
        state = GetWindowLongA(hwnd, 0 - 21);
        hover = band(state, 1);
        pressed = band(state, 2);
        
        brush = load64(g_brush_card);
        if pressed == 2 { brush = load64(g_brush_deep); }
        else if hover == 1 { brush = load64(g_brush_hover); }
        
        old_brush = SelectObject(hdc, brush);
        
        pen = load64(g_pen_border);
        if pressed == 2 { pen = load64(g_pen_neon); }
        else if hover == 1 { pen = load64(g_pen_neon); }
        
        old_pen = SelectObject(hdc, pen);
        RoundRect(hdc, 0, 0, w, h, 6, 6);
        
        if hover == 1 {
            SelectObject(hdc, load64(g_pen_neon));
            RoundRect(hdc, 1, 1, w - 1, h - 1, 6, 6);
        }
        
        SetBkMode(hdc, 1);
        tc = COLOR_TEXT_PRIMARY;
        if hover == 1 { tc = COL_ACCENT; }
        else if pressed == 2 { tc = COL_ACCENT; }
        SetTextColor(hdc, tc);
        
        SelectObject(hdc, load64(g_font));
        GetWindowTextA(hwnd, g_temp_text, 256);
        
        store32(g_rect + 0, 0);
        store32(g_rect + 4, 0);
        store32(g_rect + 8, w);
        store32(g_rect + 12, h);
        DrawTextA(hdc, g_temp_text, 0 - 1, g_rect, 37);
        
        SelectObject(hdc, old_brush);
        SelectObject(hdc, old_pen);
        EndPaint(hwnd, g_ps);
        return 0;
    }
    
    return DefWindowProcA(hwnd, msg, wp, lp);
}

func register_class(wndcls_ptr: i64, name: i64, wndproc_addr: i64, hinst: i64, cursor: i64, brush: i64) -> i64 {
    memset(wndcls_ptr, 0, 80);
    store32(wndcls_ptr + 0, 80);
    store32(wndcls_ptr + 4, 3);
    store64(wndcls_ptr + 8, wndproc_addr);
    store64(wndcls_ptr + 24, hinst);
    store64(wndcls_ptr + 40, cursor);
    store64(wndcls_ptr + 48, brush);
    store64(wndcls_ptr + 64, name);
    return RegisterClassExA(wndcls_ptr);
}

# ============================================================================
# MAIN WINDOW PROCEDURE
# ============================================================================

func wndproc(hwnd: i64, msg: i64, wp: i64, lp: i64) -> i64 {
    if msg == 1 { # WM_CREATE
        hinst = load64(g_hinst);
        
        gfont = CreateFontA(14, 0, 0, 0, 400, 0, 0, 0, 0, 0, 0, 0, 0, face_mono);
        store64(g_font, gfont);
        
        CreateWindowExA(0, cls_glow_btn, btn_min, 0x50000000, 1040, 6, 24, 24, hwnd, 108, hinst, 0);
        CreateWindowExA(0, cls_glow_btn, btn_close, 0x50000000, 1068, 6, 24, 24, hwnd, 109, hinst, 0);
        
        # ---- Row 1: Connection setup ----
        CreateWindowExA(0, cls_stat, lbl_host, 0x50000000, 12, 54, 40, 20, hwnd, 0, hinst, 0);
        h = CreateWindowExA(0, cls_edit, def_host, 0x50000080, 50, 52, 95, 24, hwnd, 0, hinst, 0);
        store64(g_host_ed, h); SendMessageA(h, 48, gfont, 1); dark_scroll(h);
        
        CreateWindowExA(0, cls_stat, lbl_port, 0x50000000, 155, 54, 40, 20, hwnd, 0, hinst, 0);
        h = CreateWindowExA(0, cls_edit, def_port, 0x50000080, 195, 52, 55, 24, hwnd, 0, hinst, 0);
        store64(g_port_ed, h); SendMessageA(h, 48, gfont, 1); dark_scroll(h);
        
        h = CreateWindowExA(0, cls_glow_btn, btn_conn, 0x50000000, 260, 50, 85, 28, hwnd, 101, hinst, 0);
        store64(g_btn_conn, h);
        
        h = CreateWindowExA(0, cls_glow_btn, btn_disc, 0x50000000, 355, 50, 85, 28, hwnd, 102, hinst, 0);
        store64(g_btn_disc, h);
        
        h = CreateWindowExA(0, cls_glow_btn, btn_browse, 0x50000000, 450, 50, 85, 28, hwnd, 114, hinst, 0);
        store64(g_btn_browse, h);
        
        h = CreateWindowExA(0, cls_glow_btn, btn_poll_auto, 0x50000000, 545, 50, 85, 28, hwnd, 115, hinst, 0);
        store64(g_btn_poll, h);
        
        h = CreateWindowExA(0, cls_stat, lbl_status, 0x50000000, 650, 54, 180, 20, hwnd, 0, hinst, 0);
        store64(g_status, h); SendMessageA(h, 48, gfont, 1);
        
        # ---- Log View (Y=100) ----
        CreateWindowExA(0, cls_stat, lbl_log, 0x50000000, 12, 82, 100, 20, hwnd, 0, hinst, 0);
        h = CreateWindowExA(0, cls_edit, gui_empty, 0x50200044, 12, 100, 480, 440, hwnd, 103, hinst, 0);
        store64(g_log, h); SendMessageA(h, 48, gfont, 1); dark_scroll(h);
        
        CreateWindowExA(0, cls_glow_btn, btn_clear, 0x50000000, 360, 550, 55, 26, hwnd, 106, hinst, 0);
        CreateWindowExA(0, cls_glow_btn, btn_save, 0x50000000, 425, 550, 55, 26, hwnd, 107, hinst, 0);
        
        # ---- ListView Grid (right side, Y=124) ----
        h = CreateWindowExA(0, cls_lv, gui_empty, 0x5000C04D, 510, 124, 560, 416, hwnd, 105, hinst, 0);
        store64(g_listview, h); SendMessageA(h, 48, gfont, 1);
        SendMessageA(h, 4150, 0x20, 0x20);
        
        SendMessageA(h, 4097, 0, COLOR_BG_CARD);
        SendMessageA(h, 4132, 0, COLOR_TEXT_PRIMARY);
        SendMessageA(h, 4134, 0, COLOR_BG_CARD);
        dark_scroll(h);
        
        # Columns
        memset(g_lvcol, 0, 64);
        store32(g_lvcol + 0, 15);
        store32(g_lvcol + 4, 0);
        
        store32(g_lvcol + 8, 120); store64(g_lvcol + 16, col_addr);
        SendMessageA(h, 4123, 0, g_lvcol);
        
        store32(g_lvcol + 8, 80); store64(g_lvcol + 16, col_type); store32(g_lvcol + 24, 1);
        SendMessageA(h, 4123, 1, g_lvcol);
        
        store32(g_lvcol + 8, 110); store64(g_lvcol + 16, col_val_hex); store32(g_lvcol + 24, 2);
        SendMessageA(h, 4123, 2, g_lvcol);
        
        store32(g_lvcol + 8, 110); store64(g_lvcol + 16, col_val_dec); store32(g_lvcol + 24, 3);
        SendMessageA(h, 4123, 3, g_lvcol);
        
        store32(g_lvcol + 8, 120); store64(g_lvcol + 16, col_status); store32(g_lvcol + 24, 4);
        SendMessageA(h, 4123, 4, g_lvcol);
        
        # ---- Edit Panel (Y=550) ----
        CreateWindowExA(0, cls_stat, lbl_reg, 0x50000000, 510, 554, 40, 20, hwnd, 0, hinst, 0);
        h = CreateWindowExA(0, cls_edit, gui_empty, 0x50000080, 550, 552, 100, 24, hwnd, 110, hinst, 0);
        store64(g_reg_ed, h); SendMessageA(h, 48, gfont, 1); dark_scroll(h);
        
        CreateWindowExA(0, cls_stat, lbl_val, 0x50000000, 665, 554, 50, 20, hwnd, 0, hinst, 0);
        h = CreateWindowExA(0, cls_edit, gui_empty, 0x50000080, 715, 552, 100, 24, hwnd, 111, hinst, 0);
        store64(g_val_ed, h); SendMessageA(h, 48, gfont, 1); dark_scroll(h);
        
        CreateWindowExA(0, cls_glow_btn, btn_read, 0x50000000, 825, 550, 85, 28, hwnd, 112, hinst, 0);
        CreateWindowExA(0, cls_glow_btn, btn_write, 0x50000000, 920, 550, 85, 28, hwnd, 113, hinst, 0);
        
        populate_default_registers();
        return 0;
    }
    
    if msg == 2 {
        do_disconnect();
        PostQuitMessage(0);
        return 0;
    }
    
    if msg == 15 {
        BeginPaint(hwnd, g_ps);
        hdc = load64(g_ps + 0);
        
        GetClientRect(hwnd, g_rect);
        FillRect(hdc, g_rect, load64(g_bg_brush));
        
        # Title bar background (y=[0, 36))
        store32(g_rect + 0, 0);
        store32(g_rect + 4, 0);
        store32(g_rect + 8, WIN_W);
        store32(g_rect + 12, 36);
        FillRect(hdc, g_rect, load64(g_brush_panel));
        
        SelectObject(hdc, load64(g_font_header));
        SetBkMode(hdc, 1);
        SetTextColor(hdc, COLOR_TEXT_PRIMARY);
        
        store32(g_rect + 0, 12);
        store32(g_rect + 4, 12);
        store32(g_rect + 8, 500);
        store32(g_rect + 12, 35);
        DrawTextA(hdc, title_draw, 0 - 1, g_rect, 0);
        
        sock = load64(g_sock);
        indicator = st_disc_ind;
        if sock != 0 {
            indicator = st_conn_ind;
            SetTextColor(hdc, COL_ACCENT);
        } else {
            SetTextColor(hdc, 0x555555);
        }
        
        store32(g_rect + 0, 290);
        store32(g_rect + 8, 480);
        DrawTextA(hdc, indicator, 0 - 1, g_rect, 0);
        
        SelectObject(hdc, load64(g_pen_neon));
        MoveToEx(hdc, 12, 36, 0);
        LineTo(hdc, WIN_W - 12, 36);
        
        # Draw custom flat headers for ListView Point Grid
        old_pen = SelectObject(hdc, load64(g_pen_border));
        old_brush = SelectObject(hdc, load64(g_edit_brush));
        
        # Column 0: Tag Name
        store32(g_rect + 0, 510); store32(g_rect + 4, 100); store32(g_rect + 8, 630); store32(g_rect + 12, 124);
        FillRect(hdc, g_rect, load64(g_edit_brush)); Rectangle(hdc, 510, 100, 630, 124);
        
        # Column 1: Type
        store32(g_rect + 0, 630); store32(g_rect + 4, 100); store32(g_rect + 8, 710); store32(g_rect + 12, 124);
        FillRect(hdc, g_rect, load64(g_edit_brush)); Rectangle(hdc, 630, 100, 710, 124);
        
        # Column 2: Value (Hex)
        store32(g_rect + 0, 710); store32(g_rect + 4, 100); store32(g_rect + 8, 820); store32(g_rect + 12, 124);
        FillRect(hdc, g_rect, load64(g_edit_brush)); Rectangle(hdc, 710, 100, 820, 124);
        
        # Column 3: Value (Dec)
        store32(g_rect + 0, 820); store32(g_rect + 4, 100); store32(g_rect + 8, 930); store32(g_rect + 12, 124);
        FillRect(hdc, g_rect, load64(g_edit_brush)); Rectangle(hdc, 820, 100, 930, 124);
        
        # Column 4: Status
        store32(g_rect + 0, 930); store32(g_rect + 4, 100); store32(g_rect + 8, 1070); store32(g_rect + 12, 124);
        FillRect(hdc, g_rect, load64(g_edit_brush)); Rectangle(hdc, 930, 100, 1070, 124);
        
        # Draw header text labels
        SetBkMode(hdc, 1);
        SetTextColor(hdc, COLOR_TEXT_PRIMARY);
        old_font = SelectObject(hdc, load64(g_font));
        TextOutA(hdc, 518, 104, col_addr, 8);
        TextOutA(hdc, 638, 104, col_type, 4);
        TextOutA(hdc, 718, 104, col_val_hex, 11);
        TextOutA(hdc, 828, 104, col_val_dec, 11);
        TextOutA(hdc, 938, 104, col_status, 6);
        SelectObject(hdc, old_font);
        
        SelectObject(hdc, old_brush);
        SelectObject(hdc, old_pen);
        
        EndPaint(hwnd, g_ps);
        return 0;
    }
    
    if msg == 307 { # WM_CTLCOLOREDIT
        hdc = wp;
        SetTextColor(hdc, COLOR_TEXT_PRIMARY);
        SetBkColor(hdc, COLOR_BG_INPUT);
        return load64(g_brush_input);
    }
    
    if msg == 312 { # WM_CTLCOLORSTATIC
        hdc = wp;
        SetTextColor(hdc, COL_TEXT);
        SetBkColor(hdc, COL_BG);
        return load64(g_bg_brush);
    }
    
    if msg == 311 { # WM_CTLCOLORSCROLLBAR
        hdc = wp;
        SetTextColor(hdc, COLOR_TEXT_PRIMARY);
        SetBkColor(hdc, COLOR_BG_INPUT);
        return load64(g_brush_input);
    }
    
    if msg == 273 { # WM_COMMAND
        cmd_id = band(wp, 0xFFFF);
        if cmd_id == 101 { do_connect(); }
        if cmd_id == 102 { do_disconnect(); }
        if cmd_id == 106 { do_clear_log(); }
        if cmd_id == 107 { do_save_log(); }
        if cmd_id == 108 { ShowWindow(hwnd, 6); return 0; }
        if cmd_id == 109 { DestroyWindow(hwnd); return 0; }
        if cmd_id == 112 { handle_manual_read(); }
        if cmd_id == 113 { handle_manual_write(); }
        if cmd_id == 114 { do_browse_tags(); }
        if cmd_id == 115 { handle_poll_toggle(); }
        return 0;
    }
    
    if msg == 275 { # WM_TIMER
        if wp == 1 {
            handle_poll_timer();
        }
        return 0;
    }
    
    if msg == 132 { # WM_NCHITTEST
        GetWindowRect(hwnd, g_rect);
        wl = load32(g_rect + 0);
        wt = load32(g_rect + 4);
        mx = band(lp, 65535);
        if mx >= 32768 { mx = mx - 65536; }
        my = band(shr(lp, 16), 65535);
        if my >= 32768 { my = my - 65536; }
        cx = mx - wl;
        cy = my - wt;
        
        if cy < 36 {
            if cx >= 1040 {
                if cx < 1064 {
                    if cy >= 6 {
                        if cy < 30 { return 1; }
                    }
                }
            }
            if cx >= 1068 {
                if cx < 1092 {
                    if cy >= 6 {
                        if cy < 30 { return 1; }
                    }
                }
            }
            return 2; # HTCAPTION
        }
    }
    
    if msg == 78 { # WM_NOTIFY
        hdr_ptr = lp;
        code = load32(hdr_ptr + 16);
        
        if code == 4294967294 {
            handle_listview_click();
        }
        if code == 4294967293 {
            handle_listview_double_click();
        }
        return 0;
    }
    
    return DefWindowProcA(hwnd, msg, wp, lp);
}

# ============================================================================
# ENTRY POINT
# ============================================================================

func main() -> i32 {
    store64(g_sock, 0);
    store64(g_auto_poll, 0);
    
    hinst = GetModuleHandleA(0);
    store64(g_hinst, hinst);
    cursor = LoadCursorA(0, 32512);
    
    enable_dark_mode();
    
    store64(g_bg_brush, CreateSolidBrush(COL_BG));
    store64(g_edit_brush, CreateSolidBrush(COL_PANEL));
    store64(g_brush_deep,  CreateSolidBrush(COLOR_BG_DEEP));
    store64(g_brush_panel, CreateSolidBrush(COLOR_BG_PANEL));
    store64(g_brush_card,  CreateSolidBrush(COLOR_BG_CARD));
    store64(g_brush_input, CreateSolidBrush(COLOR_BG_INPUT));
    store64(g_brush_hover, CreateSolidBrush(COLOR_BG_HOVER));
    store64(g_brush_neon,  CreateSolidBrush(COL_ACCENT));
    store64(g_pen_border,  CreatePen(0, 1, COLOR_BORDER));
    store64(g_pen_neon,    CreatePen(0, 2, COL_ACCENT));
    
    store64(g_font_header, CreateFontA(16, 0, 0, 0, 700, 0, 0, 0, 0, 0, 0, 0, 0, face_mono));
    
    res = register_class(g_wndclass_btn, cls_glow_btn, &GlowButtonWndProc, hinst, cursor, load64(g_brush_card));
    if res == 0 {
        MessageBoxA(0, "RegisterClassExA failed for Button!", "Error", 16);
    }
    
    memset(g_wndcls, 0, 96);
    store32(g_wndcls + 0, 80);
    store32(g_wndcls + 4, 0);
    store64(g_wndcls + 8, &wndproc);
    store64(g_wndcls + 24, hinst);
    store64(g_wndcls + 40, cursor);
    store64(g_wndcls + 48, load64(g_bg_brush));
    store64(g_wndcls + 64, clsname);
    RegisterClassExA(g_wndcls);
    
    hwnd = CreateWindowExA(0, clsname, title, 0x92000000, 100, 100, WIN_W, WIN_H, 0, 0, hinst, 0);
    if hwnd == 0 {
        MessageBoxA(0, "CreateWindowExA failed for main window!", "Error", 16);
    }
    store64(g_hwnd, hwnd);
    
    ShowWindow(hwnd, 1);
    UpdateWindow(hwnd);
    
    while GetMessageA(g_msg, 0, 0, 0) != 0 {
        TranslateMessage(g_msg);
        DispatchMessageA(g_msg);
    }
    return 0;
}
