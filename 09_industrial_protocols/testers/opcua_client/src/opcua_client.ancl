# ============================================================================
#  opcua_client.ancl  -  ANCL Native OPC UA Client  (Phase 1-3)
#
#  A native Win32 dark-mode GUI OPC UA Binary client, written in ANCL.
#  Phase 1: TCP connect + HELLO/ACK handshake.
#  Phase 2: OpenSecureChannel (SecurityMode=None)
#  Phase 3: CreateSession + ActivateSession (Anonymous)
#
#  OPC UA Connection Protocol (Part 6, Section 7.1):
#    HEL message: 'H','E','L','F' + MessageSize(u32) + fields
#    ACK message: 'A','C','K','F' + MessageSize(u32) + fields
#    OPN message: 'O','P','N','F' + SecureChannel framing + service body
#    MSG message: 'M','S','G','F' + SecureChannel framing + service body
#
#  100% CRT-free PE32+, GUI subsystem. Imports kernel32 + user32 + ws2_32.
# ============================================================================

import "../../../core_lib/std.ancl";
import "../../../core_lib/win32_api.ancl";

extern "ws2_32.dll" connect;
extern "gdi32.dll"  CreateFontA -> ptr;
extern "user32.dll" PostMessageA;
extern "user32.dll" PeekMessageA -> i32;
extern "kernel32.dll" GetSystemTimeAsFileTime;
extern "comctl32.dll" InitCommonControlsEx;
extern "dwmapi.dll" DwmSetWindowAttribute;
extern "user32.dll" TrackMouseEvent;
extern "gdi32.dll" RoundRect;
extern "user32.dll" DrawTextA;
extern "user32.dll" GetWindowRect;
extern "user32.dll" GetParent -> ptr;
extern "user32.dll" SetCapture;
extern "user32.dll" ReleaseCapture;
extern "user32.dll" GetWindowLongA -> i64;
extern "user32.dll" SetWindowLongA -> i64;
extern "gdi32.dll" GetStockObject -> ptr;
extern "uxtheme.dll" SetWindowTheme -> i32;

