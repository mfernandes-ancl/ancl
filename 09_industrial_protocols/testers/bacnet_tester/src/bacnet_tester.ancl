# ============================================================================
#  bacnet_tester.ancl  -  ANCL Native BACnet/IP Client Tester
#
#  A native Win32 dark-themed BACnet/IP client tester, written in ANCL.
#  Connects/Sends to UDP port 47808 and supports:
#   - Who-Is broadcast to discover devices
#   - Auto-polling point values via confirmed ReadProperty requests
#   - Writing values via confirmed WriteProperty requests
# ============================================================================

import "../../../core_lib/std.ancl";
import "../../../core_lib/win32_api.ancl";
import "../../../core_lib/numfmt.ancl";

# ---- Additional Win32 FFI ----
extern "user32.dll" PostMessageA;
extern "user32.dll" PeekMessageA -> i32;
extern "comctl32.dll" InitCommonControlsEx;
extern "dwmapi.dll" DwmSetWindowAttribute;
extern "user32.dll" TrackMouseEvent;
extern "gdi32.dll" RoundRect;
extern "user32.dll" DrawTextA;
extern "user32.dll" GetWindowRect;
extern "user32.dll" GetParent -> ptr;
extern "user32.dll" SetCapture;
extern "user32.dll" ReleaseCapture;
extern "user32.dll" GetWindowLongA -> i64;
extern "user32.dll" SetWindowLongA -> i64;
extern "user32.dll" SetWindowLongPtrA -> ptr;
extern "user32.dll" CallWindowProcA -> i64;
extern "gdi32.dll" GetStockObject -> ptr;
extern "gdi32.dll" CreateFontA -> ptr;
extern "uxtheme.dll" SetWindowTheme -> i32;
extern "user32.dll" DestroyWindow -> i32;
extern "kernel32.dll" GetProcAddress -> ptr;
extern "user32.dll" MessageBoxA -> i32;

# ---- Winsock FFI ----
extern "ws2_32.dll" WSAStartup -> i32;
extern "ws2_32.dll" WSACleanup -> i32;
extern "ws2_32.dll" socket -> i64;
extern "ws2_32.dll" bind -> i32;
extern "ws2_32.dll" recvfrom -> i32;
extern "ws2_32.dll" sendto -> i32;
extern "ws2_32.dll" closesocket -> i32;
extern "ws2_32.dll" ioctlsocket -> i32;
extern "ws2_32.dll" htons -> i16;
extern "ws2_32.dll" inet_addr -> i32;

