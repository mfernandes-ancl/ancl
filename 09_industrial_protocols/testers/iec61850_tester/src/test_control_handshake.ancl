import "../../../core_lib/std.ancl";
import "../../../core_lib/win32_api.ancl";
import "../../../core_lib/numfmt.ancl";
import "../../../core_lib/iec61850_compat.ancl";


@DATA
g_align_offset: buf = 8;
g_val_str:      buf = 256;
g_type_str:     buf = 64;
g_err:          buf = 8;

@CODE

func detect_mms_alignment() -> i64 {
    val1 = MmsValue_newBoolean(1);
    val0 = MmsValue_newBoolean(0);
    offset = 8;
    if load8(val1 + 5) == 1 {
        if load8(val0 + 5) == 0 {
            offset = 5;
        }
    }
    MmsValue_delete(val1);
    MmsValue_delete(val0);
    store64(g_align_offset, offset);
    return offset;
}

func decode_mms_value(val_ptr: i64) -> i64 {
    type = MmsValue_getType(val_ptr);
    offset = load64(g_align_offset);
    store8(g_val_str, 0);
    store8(g_type_str, 0);
    
    if type == 2 {
        str_copy(g_type_str, "Boolean");
        b = load8(val_ptr + offset);
        if b != 0 { str_copy(g_val_str, "True"); }
        else { str_copy(g_val_str, "False"); }
        return 0;
    }
    if type == 3 {
        str_copy(g_type_str, "BitString");
        bs_val = MmsValue_getBitStringAsInteger(val_ptr);
        bs_size = MmsValue_getBitStringSize(val_ptr);
        if bs_size == 2 {
            if bs_val == 0 { str_copy(g_val_str, "Intermediate (0)"); }
            else if bs_val == 1 { str_copy(g_val_str, "Off/Open (1)"); }
            else if bs_val == 2 { str_copy(g_val_str, "On/Closed (2)"); }
            else if bs_val == 3 { str_copy(g_val_str, "Bad (3)"); }
            else { nf_u64dec(bs_val, g_val_str); }
        } else {
            nf_u64dec(bs_val, g_val_str);
        }
        return 0;
    }
    if type == 4 {
        str_copy(g_type_str, "Integer");
        nf_u64dec(MmsValue_toInt64(val_ptr), g_val_str);
        return 0;
    }
    str_copy(g_type_str, "Other");
    nf_u64dec(type, g_val_str);
    return 0;
}

func read_status(conn: i64, tag: i64, fc: i64) -> i64 {
    store32(g_err, 0);
    val = IedConnection_readObject(conn, g_err, tag, fc);
    if load32(g_err) == 0 && val != 0 {
        decode_mms_value(val);
        puts_cstr("Read status of "); puts_cstr(tag); puts_cstr(" -> "); puts_cstr(g_val_str); puts_cstr("\n");
        MmsValue_delete(val);
    } else {
        puts_cstr("Failed to read "); puts_cstr(tag); puts_cstr("\n");
    }
    return 0;
}

func write_control(conn: i64, tag: i64, val: i64) -> i64 {
    puts_cstr("Operating "); puts_cstr(tag);
    if val == 1 { puts_cstr(" -> True...\n"); } else { puts_cstr(" -> False...\n"); }
    
    control = ControlObjectClient_create(tag, conn);
    if control != 0 {
        ctlVal = MmsValue_newBoolean(val);
        ControlObjectClient_setOrigin(control, 0, 3);
        
        puts_cstr("  Selecting...\n");
        sel = ControlObjectClient_selectWithValue(control, ctlVal);
        if sel != 0 {
            puts_cstr("  Select Succeeded. Operating...\n");
            res = ControlObjectClient_operate(control, ctlVal, 0);
            if res != 0 {
                puts_cstr("  Operation Succeeded!\n");
            } else {
                puts_cstr("  Operation FAILED.\n");
            }
        } else {
            puts_cstr("  Select FAILED.\n");
        }
        MmsValue_delete(ctlVal);
        ControlObjectClient_destroy(control);
    } else {
        puts_cstr("  Failed to create control client.\n");
    }
    return 0;
}

func main() -> i32 {
    detect_mms_alignment();
    
    puts_cstr("Connecting to 127.0.0.1:10102...\n");
    conn = IedConnection_create();
    store32(g_err, 0);
    IedConnection_connect(conn, g_err, "127.0.0.1", 10102);
    if load32(g_err) != 0 {
        puts_cstr("Connection failed.\n");
        return 1;
    }
    
    # 1. Read initial status
    read_status(conn, "MT1_IBCTRL/DISJCSWI1.Pos.stVal", 0); # FC: ST = 0
    read_status(conn, "MT1_IBCTRL/DISJXCBR1.Pos.stVal", 0); # FC: ST = 0
    
    # 2. Write False (0)
    write_control(conn, "MT1_IBCTRL/DISJCSWI1.Pos", 0);
    Sleep(1000); # Wait for simulation thread to update
    
    # 3. Read status after False
    read_status(conn, "MT1_IBCTRL/DISJCSWI1.Pos.stVal", 0);
    read_status(conn, "MT1_IBCTRL/DISJXCBR1.Pos.stVal", 0);
    
    # 4. Write True (1)
    write_control(conn, "MT1_IBCTRL/DISJCSWI1.Pos", 1);
    Sleep(1000);
    
    # 5. Read status after True
    read_status(conn, "MT1_IBCTRL/DISJCSWI1.Pos.stVal", 0);
    read_status(conn, "MT1_IBCTRL/DISJXCBR1.Pos.stVal", 0);
    
    IedConnection_close(conn);
    IedConnection_destroy(conn);
    return 0;
}
