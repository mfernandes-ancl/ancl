# ============================================================================
# STRING & MATH UTILITIES
# ============================================================================

func str_equal(s1: i64, s2: i64) -> i64 {
    i = 0;
    while 1 {
        c1 = load8(s1 + i);
        c2 = load8(s2 + i);
        if c1 != c2 { return 0; }
        if c1 == 0 { return 1; }
        i = i + 1;
    }
    return 0;
}

func log_append(text: i64) -> i64 {
    hwnd_log = load64(g_log);
    if hwnd_log == 0 { return 0; }
    len = SendMessageA(hwnd_log, 14, 0, 0);
    SendMessageA(hwnd_log, 177, len, len);
    SendMessageA(hwnd_log, 194, 0, text);
    return 0;
}

func log_hex_dump(dir_prefix: i64, buf_ptr: i64, len: i64, suffix: i64) -> i64 {
    log_append(dir_prefix);
    
    # Format: "nnn: xx xx xx..."
    int_to_str(g_numbuf, len);
    
    # Zero-pad length to 3 digits
    p = g_hexbuf;
    if len < 100 { store8(p, 48); p = p + 1; }
    if len < 10 { store8(p, 48); p = p + 1; }
    str_copy(p, g_numbuf);
    log_append(g_hexbuf);
    log_append(": ");
    
    i = 0;
    while i < len {
        val = load8(buf_ptr + i);
        
        # byte to hex
        nib1 = band(shr(val, 4), 15);
        ch1 = 48 + nib1;
        if nib1 >= 10 { ch1 = 55 + nib1; }
        store8(g_hexbuf + 0, ch1);
        
        nib2 = band(val, 15);
        ch2 = 48 + nib2;
        if nib2 >= 10 { ch2 = 55 + nib2; }
        store8(g_hexbuf + 1, ch2);
        
        store8(g_hexbuf + 2, 32); # space
        store8(g_hexbuf + 3, 0);
        log_append(g_hexbuf);
        i = i + 1;
    }
    
    log_append(suffix);
    log_append(crlf);
    return 0;
}

# format 7-byte CP56Time2a timestamp
func format_cp56(p_time: ptr, dst: ptr) -> i64 {
    ms = load16(p_time + 0);
    sec = ms / 1000;
    ms_rem = ms % 1000;
    min = band(load8(p_time + 2), 63);
    hour = band(load8(p_time + 3), 31);
    day = band(load8(p_time + 4), 31);
    month = band(load8(p_time + 5), 15);
    year = 2000 + band(load8(p_time + 6), 127);
    
    p = dst;
    # YYYY/MM/DD 
    p = nf_4d(year, p);   store8(p, 47); p = p + 1;
    p = nf_2d(month, p);  store8(p, 47); p = p + 1;
    p = nf_2d(day, p);    store8(p, 32); p = p + 1;
    # HH:MM:SS.mmm
    p = nf_2d(hour, p);   store8(p, 58); p = p + 1;
    p = nf_2d(min, p);    store8(p, 58); p = p + 1;
    p = nf_2d(sec, p);    store8(p, 46); p = p + 1;
    
    # Millisecond digits
    store8(p + 0, 48 + (ms_rem / 100) % 10);
    store8(p + 1, 48 + (ms_rem / 10) % 10);
    store8(p + 2, 48 + ms_rem % 10);
    store8(p + 3, 0);
    return 0;
}

# ============================================================================
# POINT MAPPING DATABASE ENGINE (ListView auto-updates)
# ============================================================================

func find_listview_row(ioa_str: i64, ca_str: i64) -> i64 {
    hlv = load64(g_listview);
    count = SendMessageA(hlv, 4100, 0, 0); # LVM_GETITEMCOUNT = 4100
    
    i = 0;
    while i < count {
        # Query Col 0 (Address / IOA)
        memset(g_lvitem, 0, 96);
        store32(g_lvitem + 0, 1); # mask = LVIF_TEXT
        store32(g_lvitem + 4, i); # iItem
        store32(g_lvitem + 8, 0); # iSubItem
        store64(g_lvitem + 24, g_temp_ioa);
        store32(g_lvitem + 32, 64);
        SendMessageA(hlv, 4141, i, g_lvitem); # LVM_GETITEMTEXTA = 4141
        
        # Query Col 1 (CA)
        memset(g_lvitem, 0, 96);
        store32(g_lvitem + 0, 1);
        store32(g_lvitem + 4, i);
        store32(g_lvitem + 8, 1);
        store64(g_lvitem + 24, g_temp_ca);
        store32(g_lvitem + 32, 64);
        SendMessageA(hlv, 4141, i, g_lvitem);
        
        if str_equal(g_temp_ioa, ioa_str) != 0 {
            if str_equal(g_temp_ca, ca_str) != 0 {
                return i; # Match!
            }
        }
        i = i + 1;
    }
    return 0 - 1;
}

func update_or_insert_point(ioa_str: i64, ca_str: i64, val_str: i64, type_str: i64, cause_str: i64, flags_str: i64, time_str: i64) -> i64 {
    row = find_listview_row(ioa_str, ca_str);
    hlv = load64(g_listview);
    
    if row == 0 - 1 {
        # Insert new row
        count = SendMessageA(hlv, 4100, 0, 0);
        
        # Col 0: Address (IOA)
        memset(g_lvitem, 0, 96);
        store32(g_lvitem + 0, 1); # mask = LVIF_TEXT
        store32(g_lvitem + 4, count);
        store32(g_lvitem + 8, 0);
        store64(g_lvitem + 24, ioa_str);
        SendMessageA(hlv, 4103, 0, g_lvitem); # LVM_INSERTITEMA = 4103
        
        # Col 1: CA
        memset(g_lvitem, 0, 96);
        store32(g_lvitem + 8, 1);
        store64(g_lvitem + 24, ca_str);
        SendMessageA(hlv, 4142, count, g_lvitem); # LVM_SETITEMA = 4142
        
        # Col 2: Value
        store32(g_lvitem + 8, 2);
        store64(g_lvitem + 24, val_str);
        SendMessageA(hlv, 4142, count, g_lvitem);
        
        # Col 3: Type
        store32(g_lvitem + 8, 3);
        store64(g_lvitem + 24, type_str);
        SendMessageA(hlv, 4142, count, g_lvitem);
        
        # Col 4: Cause
        store32(g_lvitem + 8, 4);
        store64(g_lvitem + 24, cause_str);
        SendMessageA(hlv, 4142, count, g_lvitem);
        
        # Col 5: Flags
        store32(g_lvitem + 8, 5);
        store64(g_lvitem + 24, flags_str);
        SendMessageA(hlv, 4142, count, g_lvitem);
        
        # Col 6: Count = 1
        store32(g_lvitem + 8, 6);
        store64(g_lvitem + 24, "1");
        SendMessageA(hlv, 4142, count, g_lvitem);
        
        # Col 7: TimeTag
        store32(g_lvitem + 8, 7);
        store64(g_lvitem + 24, time_str);
        SendMessageA(hlv, 4142, count, g_lvitem);
    } else {
        # Update existing row
        # Col 2: Value
        memset(g_lvitem, 0, 96);
        store32(g_lvitem + 8, 2);
        store64(g_lvitem + 24, val_str);
        SendMessageA(hlv, 4142, row, g_lvitem);
        
        # Col 3: Type
        store32(g_lvitem + 8, 3);
        store64(g_lvitem + 24, type_str);
        SendMessageA(hlv, 4142, row, g_lvitem);
        
        # Col 4: Cause
        store32(g_lvitem + 8, 4);
        store64(g_lvitem + 24, cause_str);
        SendMessageA(hlv, 4142, row, g_lvitem);
        
        # Col 5: Flags
        store32(g_lvitem + 8, 5);
        store64(g_lvitem + 24, flags_str);
        SendMessageA(hlv, 4142, row, g_lvitem);
        
        # Col 6: Get current count, increment it
        memset(g_lvitem, 0, 96);
        store32(g_lvitem + 0, 1);
        store32(g_lvitem + 4, row);
        store32(g_lvitem + 8, 6);
        store64(g_lvitem + 24, g_count_buf);
        store32(g_lvitem + 32, 16);
        SendMessageA(hlv, 4141, row, g_lvitem);
        cur_count = str_to_int(g_count_buf);
        int_to_str(g_count_buf, cur_count + 1);
        
        memset(g_lvitem, 0, 96);
        store32(g_lvitem + 8, 6);
        store64(g_lvitem + 24, g_count_buf);
        SendMessageA(hlv, 4142, row, g_lvitem);
        
        # Col 7: TimeTag
        store32(g_lvitem + 8, 7);
        store64(g_lvitem + 24, time_str);
        SendMessageA(hlv, 4142, row, g_lvitem);
    }
    return 0;
}

# ============================================================================
# IEC 60870-5-104 PROTOCOL & NETWORKING
# ============================================================================

func send_s_frame(rx_seq: i64) -> i64 {
    sock = load64(g_sock);
    if sock == 0 { return 0; }
    
    # S-frame: 68 04 01 00 Rx_low Rx_high
    store8(g_txbuf + 0, 0x68);
    store8(g_txbuf + 1, 0x04);
    store8(g_txbuf + 2, 0x01);
    store8(g_txbuf + 3, 0x00);
    
    # Rx sequence num shifted left by 1
    rx_val = band(shl(rx_seq, 1), 0xFFFF);
    store8(g_txbuf + 4, band(rx_val, 0xFF));
    store8(g_txbuf + 5, band(shr(rx_val, 8), 0xFF));
    
    send(sock, g_txbuf, 6, 0);
    log_hex_dump(m_dir_s, g_txbuf, 6, m_superv);
    return 0;
}

func get_cause_str(cot: i64) -> i64 {
    c = band(cot, 0x3F);
    if c == 3 { return m_spont; }
    if c == 20 { return m_int; }
    if c == 6 { return m_act; }
    if c == 7 { return m_actcon; }
    if c == 10 { return m_actterm; }
    
    # Fallback to COT number representation
    int_to_str(g_numbuf, c);
    return g_numbuf;
}

# Parse an incoming packet frame in iec_ptr
func parse_iec104_packet(iec_ptr: i64, total_len: i64) -> i64 {
    apdu_len = load8(iec_ptr + 1);
    ctrl0 = load8(iec_ptr + 2);
    ctrl1 = load8(iec_ptr + 3);
    ctrl2 = load8(iec_ptr + 4);
    ctrl3 = load8(iec_ptr + 5);
    
    # Check frame format
    if band(ctrl0, 1) == 0 {
        # I-Frame (Information Transfer)
        tx_seq = shr(ctrl0 + shl(ctrl1, 8), 1);
        rx_seq = shr(ctrl2 + shl(ctrl3, 8), 1);
        
        # Update our received Rx count
        store64(g_rx_seq, band(tx_seq + 1, 0x7FFF));
        
        # Format suffix for dump
        str_copy(g_logbuf, " (I-FRAME TX=");
        p = g_logbuf + strlen(g_logbuf);
        int_to_str(p, tx_seq); p = p + strlen(p);
        str_copy(p, " RX="); p = p + strlen(p);
        int_to_str(p, rx_seq); p = p + strlen(p);
        str_copy(p, ")");
        
        log_hex_dump(m_dir_r, iec_ptr, total_len, g_logbuf);
        
        # Automatically send S-frame acknowledgment back
        send_s_frame(load64(g_rx_seq));
        
        # Parse ASDU (starts at offset 6, if present)
        if total_len > 6 {
            ti = load8(iec_ptr + 6);
            vsq = load8(iec_ptr + 7);
            cot = load8(iec_ptr + 8);
            oa = load8(iec_ptr + 9);
            ca = load8(iec_ptr + 10) + shl(load8(iec_ptr + 11), 8);
            
            # Format ASDU summary log
            str_copy(g_logbuf, "    OA ");
            p = g_logbuf + strlen(g_logbuf);
            int_to_str(p, oa); p = p + strlen(p);
            str_copy(p, " CA "); p = p + strlen(p);
            int_to_str(p, ca); p = p + strlen(p);
            str_copy(p, " TI TYPE "); p = p + strlen(p);
            int_to_str(p, ti); p = p + strlen(p);
            str_copy(p, " CAUSE "); p = p + strlen(p);
            str_copy(p, get_cause_str(cot)); p = p + strlen(p);
            str_copy(p, " ITEMS "); p = p + strlen(p);
            num_items = band(vsq, 0x7F);
            int_to_str(p, num_items); p = p + strlen(p);
            str_copy(p, " POSITIVE");
            log_append(g_logbuf);
            log_append(crlf);
            
            # Parse individual items
            sq = shr(band(vsq, 0x80), 7);
            
            type_name_str = "Unknown";
            if ti == 1 { type_name_str = "1:M_SP_NA_1"; }
            if ti == 3 { type_name_str = "3:M_DP_NA_1"; }
            if ti == 9 { type_name_str = "9:M_ME_NA_1"; }
            if ti == 11 { type_name_str = "11:M_ME_NB_1"; }
            if ti == 13 { type_name_str = "13:M_ME_NC_1"; }
            if ti == 30 { type_name_str = "30:M_SP_TB_1"; }
            if ti == 35 { type_name_str = "35:M_ME_TE_1"; }
            if ti == 36 { type_name_str = "36:M_ME_TF_1"; }
            if ti == 38 { type_name_str = "38:M_ME_PE_1"; }
            if ti == 45 { type_name_str = "45:C_SC_NA_1"; }
            if ti == 46 { type_name_str = "46:C_DC_NA_1"; }
            if ti == 48 { type_name_str = "48:C_SE_NA_1"; }
            if ti == 49 { type_name_str = "49:C_SE_NB_1"; }
            if ti == 50 { type_name_str = "50:C_SE_NC_1"; }
            if ti == 58 { type_name_str = "58:C_SC_TA_1"; }
            if ti == 59 { type_name_str = "59:C_DC_TA_1"; }
            if ti == 60 { type_name_str = "60:C_SE_TA_1"; }
            if ti == 61 { type_name_str = "61:C_SE_TB_1"; }
            if ti == 62 { type_name_str = "62:C_SE_TC_1"; }
            if ti == 100 { type_name_str = "100:C_IC_NA_1"; }
            
            # Setup command feedback check (SBO handshake)
            sbo_active = load64(g_sbo_active);
            
            # Offset tracking
            offset = 12;
            starting_ioa = 0;
            if sq == 1 {
                # Load sequential base IOA (3 bytes)
                starting_ioa = load8(iec_ptr + 12) + shl(load8(iec_ptr + 13), 8) + shl(load8(iec_ptr + 14), 16);
                offset = 15;
            }
            
            # Log decoded value list
            str_copy(g_logbuf, "    ");
            log_p = g_logbuf + strlen(g_logbuf);
            
            i = 0;
            while i < num_items {
                # Determine IOA
                item_ioa = starting_ioa + i;
                if sq == 0 {
                    # Load item-specific IOA (3 bytes)
                    item_ioa = load8(iec_ptr + offset) + shl(load8(iec_ptr + offset + 1), 8) + shl(load8(iec_ptr + offset + 2), 16);
                    offset = offset + 3;
                }
                
                # Setup string representations
                str_copy(g_search_ioa, "");
                int_to_str(g_search_ioa, item_ioa);
                
                str_copy(g_search_ca, "");
                int_to_str(g_search_ca, ca);
                
                val_str = "0";
                flag_str = "0x00";
                time_str = "local: (none)";
                
                val_size = 0;
                
                # Single Point (TI=1)
                if ti == 1 {
                    val_size = 1;
                    b_val = load8(iec_ptr + offset);
                    val = band(b_val, 1);
                    if val == 1 { val_str = "ON"; } else { val_str = "OFF"; }
                    
                    # quality flags
                    q_flags = band(b_val, 0xF0);
                    int_to_str(g_numbuf, q_flags);
                    flag_str = g_numbuf;
                }
                
                # Double Point (TI=3)
                if ti == 3 {
                    val_size = 1;
                    b_val = load8(iec_ptr + offset);
                    val = band(b_val, 3);
                    if val == 1 { val_str = "OFF"; }
                    if val == 2 { val_str = "ON"; }
                    if val == 0 { val_str = "INDETERMINATE (0)"; }
                    if val == 3 { val_str = "INDETERMINATE (3)"; }
                    
                    q_flags = band(b_val, 0xF0);
                    int_to_str(g_numbuf, q_flags);
                    flag_str = g_numbuf;
                }
                
                # Normalized Value (TI=9)
                if ti == 9 {
                    val_size = 3;
                    raw_val = load16(iec_ptr + offset);
                    if band(raw_val, 0x8000) != 0 {
                        raw_val = raw_val - 65536;
                    }
                    int_to_str(g_valbuf, raw_val);
                    val_str = g_valbuf;
                    
                    q_flags = load8(iec_ptr + offset + 2);
                    int_to_str(g_numbuf, q_flags);
                    flag_str = g_numbuf;
                }
                
                # Scaled Value (TI=11)
                if ti == 11 {
                    val_size = 3;
                    raw_val = load16(iec_ptr + offset);
                    if band(raw_val, 0x8000) != 0 {
                        raw_val = raw_val - 65536;
                    }
                    int_to_str(g_valbuf, raw_val);
                    val_str = g_valbuf;
                    
                    q_flags = load8(iec_ptr + offset + 2);
                    int_to_str(g_numbuf, q_flags);
                    flag_str = g_numbuf;
                }
                
                # Short Float (TI=13)
                if ti == 13 {
                    val_size = 5;
                    f_bits = load32(iec_ptr + offset);
                    nf_ftoa(f_bits, g_valbuf);
                    val_str = g_valbuf;
                    
                    q_flags = load8(iec_ptr + offset + 4);
                    int_to_str(g_numbuf, q_flags);
                    flag_str = g_numbuf;
                }
                
                # Normalized with Time (TI=35)
                if ti == 35 {
                    val_size = 10;
                    raw_val = load16(iec_ptr + offset);
                    if band(raw_val, 0x8000) != 0 {
                        raw_val = raw_val - 65536;
                    }
                    int_to_str(g_valbuf, raw_val);
                    val_str = g_valbuf;
                    
                    q_flags = load8(iec_ptr + offset + 2);
                    int_to_str(g_numbuf, q_flags);
                    flag_str = g_numbuf;
                    
                    format_cp56(iec_ptr + offset + 3, g_savebuf);
                    str_copy(g_numbuf, "local: ");
                    str_copy(g_numbuf + 7, g_savebuf);
                    time_str = g_numbuf;
                }
                
                # Scaled with Time (TI=38)
                if ti == 38 {
                    val_size = 10;
                    raw_val = load16(iec_ptr + offset);
                    if band(raw_val, 0x8000) != 0 {
                        raw_val = raw_val - 65536;
                    }
                    int_to_str(g_valbuf, raw_val);
                    val_str = g_valbuf;
                    
                    q_flags = load8(iec_ptr + offset + 2);
                    int_to_str(g_numbuf, q_flags);
                    flag_str = g_numbuf;
                    
                    format_cp56(iec_ptr + offset + 3, g_savebuf);
                    str_copy(g_numbuf, "local: ");
                    str_copy(g_numbuf + 7, g_savebuf);
                    time_str = g_numbuf;
                }
                
                # Single Point with Time (TI=30)
                if ti == 30 {
                    val_size = 8;
                    b_val = load8(iec_ptr + offset);
                    val = band(b_val, 1);
                    if val == 1 { val_str = "ON"; } else { val_str = "OFF"; }
                    
                    q_flags = band(b_val, 0xF0);
                    int_to_str(g_numbuf, q_flags);
                    flag_str = g_numbuf;
                    
                    format_cp56(iec_ptr + offset + 1, g_savebuf);
                    str_copy(g_numbuf, "local: ");
                    str_copy(g_numbuf + 7, g_savebuf);
                    time_str = g_numbuf;
                }
                
                # Float with Time (TI=36)
                if ti == 36 {
                    val_size = 12;
                    f_bits = load32(iec_ptr + offset);
                    nf_ftoa(f_bits, g_valbuf);
                    val_str = g_valbuf;
                    
                    q_flags = load8(iec_ptr + offset + 4);
                    int_to_str(g_numbuf, q_flags);
                    flag_str = g_numbuf;
                    
                    format_cp56(iec_ptr + offset + 5, g_savebuf);
                    str_copy(g_numbuf, "local: ");
                    str_copy(g_numbuf + 7, g_savebuf);
                    time_str = g_numbuf;
                }
                # General Interrogation (TI=100)
                if ti == 100 {
                    val_size = 1;
                    qoi = load8(iec_ptr + offset);
                    if qoi == 20 { val_str = "Station GI"; }
                    else {
                        int_to_str(g_valbuf, qoi);
                        val_str = g_valbuf;
                    }
                }
                # Single Command (TI=45)
                if ti == 45 {
                    val_size = 1;
                    b_val = load8(iec_ptr + offset);
                    se = band(b_val, 0x80);
                    state = band(b_val, 1);
                    if se != 0 {
                        if state == 1 { val_str = "SELECT ON"; } else { val_str = "SELECT OFF"; }
                    } else {
                        if state == 1 { val_str = "ON"; } else { val_str = "OFF"; }
                    }
                    q_flags = band(b_val, 0x7C);
                    int_to_str(g_count_buf, q_flags);
                    flag_str = g_count_buf;
                }
                # Double Command (TI=46)
                if ti == 46 {
                    val_size = 1;
                    b_val = load8(iec_ptr + offset);
                    se = band(b_val, 0x80);
                    state = band(b_val, 3);
                    if se != 0 {
                        if state == 1 { val_str = "SELECT OFF"; }
                        if state == 2 { val_str = "SELECT ON"; }
                        if state == 0 { val_str = "SELECT INDET (0)"; }
                        if state == 3 { val_str = "SELECT INDET (3)"; }
                    } else {
                        if state == 1 { val_str = "OFF"; }
                        if state == 2 { val_str = "ON"; }
                        if state == 0 { val_str = "INDETERMINATE (0)"; }
                        if state == 3 { val_str = "INDETERMINATE (3)"; }
                    }
                    q_flags = band(b_val, 0x7C);
                    int_to_str(g_count_buf, q_flags);
                    flag_str = g_count_buf;
                }
                # Normalized Setpoint Command (TI=48)
                if ti == 48 {
                    val_size = 3;
                    raw_val = load16(iec_ptr + offset);
                    if band(raw_val, 0x8000) != 0 { raw_val = raw_val - 65536; }
                    int_to_str(g_valbuf, raw_val);
                    val_str = g_valbuf;
                    
                    qos = load8(iec_ptr + offset + 2);
                    se = band(qos, 0x80);
                    if se != 0 {
                        str_copy(g_savebuf, "SELECT (QL=");
                        p = g_savebuf + 11;
                        int_to_str(p, band(qos, 0x7F));
                        str_copy(p + strlen(p), ")");
                        flag_str = g_savebuf;
                    } else {
                        int_to_str(g_count_buf, qos);
                        flag_str = g_count_buf;
                    }
                }
                # Scaled Setpoint Command (TI=49)
                if ti == 49 {
                    val_size = 3;
                    raw_val = load16(iec_ptr + offset);
                    if band(raw_val, 0x8000) != 0 { raw_val = raw_val - 65536; }
                    int_to_str(g_valbuf, raw_val);
                    val_str = g_valbuf;
                    
                    qos = load8(iec_ptr + offset + 2);
                    se = band(qos, 0x80);
                    if se != 0 {
                        str_copy(g_savebuf, "SELECT (QL=");
                        p = g_savebuf + 11;
                        int_to_str(p, band(qos, 0x7F));
                        str_copy(p + strlen(p), ")");
                        flag_str = g_savebuf;
                    } else {
                        int_to_str(g_count_buf, qos);
                        flag_str = g_count_buf;
                    }
                }
                # Short Float Setpoint Command (TI=50)
                if ti == 50 {
                    val_size = 5;
                    f_bits = load32(iec_ptr + offset);
                    nf_ftoa(f_bits, g_valbuf);
                    val_str = g_valbuf;
                    
                    qos = load8(iec_ptr + offset + 4);
                    se = band(qos, 0x80);
                    if se != 0 {
                        str_copy(g_savebuf, "SELECT (QL=");
                        p = g_savebuf + 11;
                        int_to_str(p, band(qos, 0x7F));
                        str_copy(p + strlen(p), ")");
                        flag_str = g_savebuf;
                    } else {
                        int_to_str(g_count_buf, qos);
                        flag_str = g_count_buf;
                    }
                }
                # Single Command with Time (TI=58)
                if ti == 58 {
                    val_size = 8;
                    b_val = load8(iec_ptr + offset);
                    se = band(b_val, 0x80);
                    state = band(b_val, 1);
                    if se != 0 {
                        if state == 1 { val_str = "SELECT ON"; } else { val_str = "SELECT OFF"; }
                    } else {
                        if state == 1 { val_str = "ON"; } else { val_str = "OFF"; }
                    }
                    q_flags = band(b_val, 0x7C);
                    int_to_str(g_count_buf, q_flags);
                    flag_str = g_count_buf;
                    
                    format_cp56(iec_ptr + offset + 1, g_savebuf);
                    str_copy(g_numbuf, "local: ");
                    str_copy(g_numbuf + 7, g_savebuf);
                    time_str = g_numbuf;
                }
                # Double Command with Time (TI=59)
                if ti == 59 {
                    val_size = 8;
                    b_val = load8(iec_ptr + offset);
                    se = band(b_val, 0x80);
                    state = band(b_val, 3);
                    if se != 0 {
                        if state == 1 { val_str = "SELECT OFF"; }
                        if state == 2 { val_str = "SELECT ON"; }
                        if state == 0 { val_str = "SELECT INDET (0)"; }
                        if state == 3 { val_str = "SELECT INDET (3)"; }
                    } else {
                        if state == 1 { val_str = "OFF"; }
                        if state == 2 { val_str = "ON"; }
                        if state == 0 { val_str = "INDETERMINATE (0)"; }
                        if state == 3 { val_str = "INDETERMINATE (3)"; }
                    }
                    q_flags = band(b_val, 0x7C);
                    int_to_str(g_count_buf, q_flags);
                    flag_str = g_count_buf;
                    
                    format_cp56(iec_ptr + offset + 1, g_savebuf);
                    str_copy(g_numbuf, "local: ");
                    str_copy(g_numbuf + 7, g_savebuf);
                    time_str = g_numbuf;
                }
                # Normalized Setpoint Command with Time (TI=60)
                if ti == 60 {
                    val_size = 10;
                    raw_val = load16(iec_ptr + offset);
                    if band(raw_val, 0x8000) != 0 { raw_val = raw_val - 65536; }
                    int_to_str(g_valbuf, raw_val);
                    val_str = g_valbuf;
                    
                    qos = load8(iec_ptr + offset + 2);
                    se = band(qos, 0x80);
                    if se != 0 {
                        str_copy(g_savebuf, "SELECT (QL=");
                        p = g_savebuf + 11;
                        int_to_str(p, band(qos, 0x7F));
                        str_copy(p + strlen(p), ")");
                        flag_str = g_savebuf;
                    } else {
                        int_to_str(g_count_buf, qos);
                        flag_str = g_count_buf;
                    }
                    
                    format_cp56(iec_ptr + offset + 3, g_savebuf);
                    str_copy(g_numbuf, "local: ");
                    str_copy(g_numbuf + 7, g_savebuf);
                    time_str = g_numbuf;
                }
                # Scaled Setpoint Command with Time (TI=61)
                if ti == 61 {
                    val_size = 10;
                    raw_val = load16(iec_ptr + offset);
                    if band(raw_val, 0x8000) != 0 { raw_val = raw_val - 65536; }
                    int_to_str(g_valbuf, raw_val);
                    val_str = g_valbuf;
                    
                    qos = load8(iec_ptr + offset + 2);
                    se = band(qos, 0x80);
                    if se != 0 {
                        str_copy(g_savebuf, "SELECT (QL=");
                        p = g_savebuf + 11;
                        int_to_str(p, band(qos, 0x7F));
                        str_copy(p + strlen(p), ")");
                        flag_str = g_savebuf;
                    } else {
                        int_to_str(g_count_buf, qos);
                        flag_str = g_count_buf;
                    }
                    
                    format_cp56(iec_ptr + offset + 3, g_savebuf);
                    str_copy(g_numbuf, "local: ");
                    str_copy(g_numbuf + 7, g_savebuf);
                    time_str = g_numbuf;
                }
                # Short Float Setpoint Command with Time (TI=62)
                if ti == 62 {
                    val_size = 12;
                    f_bits = load32(iec_ptr + offset);
                    nf_ftoa(f_bits, g_valbuf);
                    val_str = g_valbuf;
                    
                    qos = load8(iec_ptr + offset + 4);
                    se = band(qos, 0x80);
                    if se != 0 {
                        str_copy(g_savebuf, "SELECT (QL=");
                        p = g_savebuf + 11;
                        int_to_str(p, band(qos, 0x7F));
                        str_copy(p + strlen(p), ")");
                        flag_str = g_savebuf;
                    } else {
                        int_to_str(g_count_buf, qos);
                        flag_str = g_count_buf;
                    }
                    
                    format_cp56(iec_ptr + offset + 5, g_savebuf);
                    str_copy(g_numbuf, "local: ");
                    str_copy(g_numbuf + 7, g_savebuf);
                    time_str = g_numbuf;
                }
                
                # Command feedback check (SBO Activation Confirmation)
                # If we are waiting on select activation confirmation (COT = 7)
                if sbo_active == 1 {
                    if band(cot, 0x3F) == 7 {
                        # Match command parameters
                        if item_ioa == load64(g_sbo_ioa) {
                            # Log confirmation match
                            log_append("    [iec104] SBO: Select Confirmed! Executing command now...\r\n");
                            store64(g_sbo_active, 0); # handshake done
                            
                            # Send corresponding EXECUTE command frame (S/E bit set to 0)
                            # Re-use properties
                            sc_val = load64(g_sbo_val);
                            sc_qu = load64(g_sbo_qu);
                            sc_type = load64(g_sbo_type);
                            
                            # SCO / DCO layout
                            cmd_byte = sc_val;
                            cmd_byte = cmd_byte + shl(sc_qu, 2);
                            # S/E bit = 0 (Execute)
                            
                            # Construct I-Frame
                            store8(g_txbuf + 0, 0x68);
                            store8(g_txbuf + 1, 14); # remainder size (4 bytes APCI + 10 bytes ASDU)
                            
                            # Increment Tx sequence
                            tx = load64(g_tx_seq);
                            tx_val = band(shl(tx, 1), 0xFFFF);
                            store8(g_txbuf + 2, band(tx_val, 0xFF));
                            store8(g_txbuf + 3, band(shr(tx_val, 8), 0xFF));
                            store64(g_tx_seq, band(tx + 1, 0x7FFF));
                            
                            # Rx acknowledge
                            rx = load64(g_rx_seq);
                            rx_val = band(shl(rx, 1), 0xFFFF);
                            store8(g_txbuf + 4, band(rx_val, 0xFF));
                            store8(g_txbuf + 5, band(shr(rx_val, 8), 0xFF));
                            
                            # ASDU
                            store8(g_txbuf + 6, sc_type);
                            store8(g_txbuf + 7, 1);
                            store8(g_txbuf + 8, 6); # Activation
                            store8(g_txbuf + 9, str_to_int(g_oabuf));
                            
                            ca_val = str_to_int(g_cabuf);
                            store8(g_txbuf + 10, band(ca_val, 0xFF));
                            store8(g_txbuf + 11, band(shr(ca_val, 8), 0xFF));
                            
                            store8(g_txbuf + 12, band(item_ioa, 0xFF));
                            store8(g_txbuf + 13, band(shr(item_ioa, 8), 0xFF));
                            store8(g_txbuf + 14, band(shr(item_ioa, 16), 0xFF));
                            store8(g_txbuf + 15, cmd_byte);
                            
                            sock = load64(g_sock);
                            send(sock, g_txbuf, 16, 0);
                            
                            log_hex_dump(m_dir_s, g_txbuf, 16, " (EXECUTE COMMAND)");
                        }
                    }
                }
                
                # Append point detail to log
                if val_size > 0 {
                    # Format: "[ioa val_str] "
                    str_copy(log_p, "["); log_p = log_p + 1;
                    int_to_str(log_p, item_ioa); log_p = log_p + strlen(log_p);
                    str_copy(log_p, " "); log_p = log_p + 1;
                    str_copy(log_p, val_str); log_p = log_p + strlen(log_p);
                    str_copy(log_p, "] "); log_p = log_p + 2;
                    
                    # Add to Point Database Grid
                    update_or_insert_point(g_search_ioa, g_search_ca, val_str, type_name_str, get_cause_str(cot), flag_str, time_str);
                    offset = offset + val_size;
                }
                
                if val_size == 0 {
                    # Safety check: Unhandled Type ID. Log it and skip further parsing of this packet.
                    str_copy(g_logbuf, "    [iec104] Unhandled Type ID ");
                    p = g_logbuf + strlen(g_logbuf);
                    int_to_str(p, ti);
                    str_copy(p + strlen(p), " - skipping ASDU items\r\n");
                    log_append(g_logbuf);
                    i = num_items; # terminate loop
                }
                
                i = i + 1;
            }
            
            # Print value summary log if values were parsed
            if log_p > g_logbuf + 4 {
                # Null-terminate and log
                store8(log_p, 0);
                log_append(g_logbuf);
                log_append(crlf);
            }
        }
        return 0;
    }
    
    # S-Frame (Supervisory)
    if band(ctrl0, 3) == 1 {
        rx_seq = shr(ctrl2 + shl(ctrl3, 8), 1);
        log_hex_dump(m_dir_r, iec_ptr, total_len, m_superv);
        return 0;
    }
    
    # U-Frame (Unnumbered Control)
    if band(ctrl0, 3) == 3 {
        if ctrl0 == 0x07 {
            log_hex_dump(m_dir_r, iec_ptr, total_len, m_start_act);
            # Send STARTDT con activation confirmation: 68 04 0B 00 00 00
            store8(g_txbuf + 0, 0x68);
            store8(g_txbuf + 1, 0x04);
            store8(g_txbuf + 2, 0x0B);
            store8(g_txbuf + 3, 0x00);
            store8(g_txbuf + 4, 0x00);
            store8(g_txbuf + 5, 0x00);
            sock = load64(g_sock);
            if sock != 0 {
                send(sock, g_txbuf, 6, 0);
                log_hex_dump(m_dir_s, g_txbuf, 6, m_start_con);
            }
            return 0;
        }
        if ctrl0 == 0x0B {
            log_hex_dump(m_dir_r, iec_ptr, total_len, m_start_con);
            
            # Connection negotiation successful!
            e = str_copy(g_statbuf, m_st_conn);
            e = str_copy(e, g_hostbuf);
            e = str_copy(e, m_colon);
            str_copy(e, g_portbuf);
            SetWindowTextA(load64(g_status), g_statbuf);
            InvalidateRect(load64(g_hwnd), 0, 1);
            return 0;
        }
        if ctrl0 == 0x13 {
            log_hex_dump(m_dir_r, iec_ptr, total_len, m_stop_act);
            # Send STOPDT con confirmation: 68 04 17 00 00 00
            store8(g_txbuf + 0, 0x68);
            store8(g_txbuf + 1, 0x04);
            store8(g_txbuf + 2, 0x17);
            store8(g_txbuf + 3, 0x00);
            store8(g_txbuf + 4, 0x00);
            store8(g_txbuf + 5, 0x00);
            sock = load64(g_sock);
            if sock != 0 {
                send(sock, g_txbuf, 6, 0);
                log_hex_dump(m_dir_s, g_txbuf, 6, m_stop_con);
            }
            return 0;
        }
        if ctrl0 == 0x17 {
            log_hex_dump(m_dir_r, iec_ptr, total_len, m_stop_con);
            return 0;
        }
        if ctrl0 == 0x43 {
            log_hex_dump(m_dir_r, iec_ptr, total_len, m_testfr_act);
            # Send TESTFR con confirmation: 68 04 83 00 00 00
            store8(g_txbuf + 0, 0x68);
            store8(g_txbuf + 1, 0x04);
            store8(g_txbuf + 2, 0x83);
            store8(g_txbuf + 3, 0x00);
            store8(g_txbuf + 4, 0x00);
            store8(g_txbuf + 5, 0x00);
            sock = load64(g_sock);
            if sock != 0 {
                send(sock, g_txbuf, 6, 0);
                log_hex_dump(m_dir_s, g_txbuf, 6, m_testfr_con);
            }
            return 0;
        }
        if ctrl0 == 0x83 {
            log_hex_dump(m_dir_r, iec_ptr, total_len, m_testfr_con);
            return 0;
        }
        log_hex_dump(m_dir_r, iec_ptr, total_len, m_unk_apci);
        return 0;
    }
    
    return 0;
}

# ============================================================================
# GUI ACTIONS
# ============================================================================

func do_connect() -> i64 {
    sock = load64(g_sock);
    if sock != 0 { return 0; }
    
    # Read settings
    GetWindowTextA(load64(g_host_ed), g_hostbuf, 256);
    GetWindowTextA(load64(g_port_ed), g_portbuf, 32);
    GetWindowTextA(load64(g_ca_ed), g_cabuf, 32);
    GetWindowTextA(load64(g_oa_ed), g_oabuf, 32);
    
    port = str_to_int(g_portbuf);
    if port < 1 { port = 2404; }
    
    # Log connection attempt
    log_append(m_conn);
    log_append(g_hostbuf);
    log_append(m_colon);
    log_append(g_portbuf);
    log_append(m_dots);
    
    # Parse Host IP
    memset(g_addr, 0, 16);
    store16(g_addr + 0, 2); # AF_INET
    store16(g_addr + 2, htons(port));
    
    ip = 0; shift = 0; octet = 0; p = g_hostbuf;
    while load8(p) != 0 {
        c = load8(p);
        if c == 46 { # '.'
            ip = ip + shl(octet, shift);
            shift = shift + 8;
            octet = 0;
        } else {
            octet = octet * 10 + c - 48;
        }
        p = p + 1;
    }
    ip = ip + shl(octet, shift);
    store32(g_addr + 4, ip);
    
    # Create Socket
    s = socket(2, 1, 6); # AF_INET, SOCK_STREAM, TCP
    if s == 0 - 1 {
        log_append(m_conn_err);
        return 0;
    }
    
    # Connect
    rc = connect(s, g_addr, 16);
    if rc != 0 {
        closesocket(s);
        log_append(m_conn_err);
        return 0;
    }
    
    # Initialize sequence counters
    store64(g_tx_seq, 0);
    store64(g_rx_seq, 0);
    store64(g_recv_len, 0);
    store64(g_sbo_active, 0);
    
    store64(g_sock, s);
    log_append(m_conn_ok);
    
    # Enable non-blocking mode on socket (FIONBIO = 0x8004667E)
    store32(g_nonblock, 1);
    ioctlsocket(s, 0x8004667E, g_nonblock);
    
    # Send STARTDT act activation frame: 68 04 07 00 00 00
    store8(g_txbuf + 0, 0x68);
    store8(g_txbuf + 1, 0x04);
    store8(g_txbuf + 2, 0x07);
    store8(g_txbuf + 3, 0x00);
    store8(g_txbuf + 4, 0x00);
    store8(g_txbuf + 5, 0x00);
    
    send(s, g_txbuf, 6, 0);
    log_hex_dump(m_dir_s, g_txbuf, 6, m_start_act);
    
    SetTimer(load64(g_hwnd), ID_TIMER_RECV, 50, 0);
    InvalidateRect(load64(g_hwnd), 0, 1);
    return 0;
}

func do_disconnect() -> i64 {
    sock = load64(g_sock);
    if sock == 0 { return 0; }
    
    KillTimer(load64(g_hwnd), ID_TIMER_RECV);
    closesocket(sock);
    store64(g_sock, 0);
    
    log_append(m_disc);
    SetWindowTextA(load64(g_status), m_st_disc);
    InvalidateRect(load64(g_hwnd), 0, 1);
    
    return 0;
}

func do_recv_tick() -> i64 {
    sock = load64(g_sock);
    if sock == 0 { return 0; }
    
    # Read as much as possible
    recv_idx = load64(g_recv_len);
    n = recv(sock, g_rxbuf + recv_idx, 2048 - recv_idx, 0);
    
    # Check error
    if n < 0 {
        err = WSAGetLastError();
        if err != 10035 { # WOULDBLOCK = 10035
            do_disconnect();
            return 0;
        }
        return 0; # just would block
    }
    if n == 0 {
        # connection closed
        do_disconnect();
        return 0;
    }
    
    # Update buffer size
    recv_idx = recv_idx + n;
    store64(g_recv_len, recv_idx);
    
    # Parse frames
    while recv_idx >= 2 {
        # Every frame starts with 0x68
        if load8(g_rxbuf + 0) != 0x68 {
            # Desynchronized! Shift buffer by 1 and continue searching
            memcpy(g_rxbuf, g_rxbuf + 1, recv_idx - 1);
            recv_idx = recv_idx - 1;
            store64(g_recv_len, recv_idx);
        } else {
            apdu_len = load8(g_rxbuf + 1);
            total_len = apdu_len + 2;
            
            if recv_idx < total_len {
                # Frame is incomplete
                return 0;
            }
            
            # We have a full packet frame!
            parse_iec104_packet(g_rxbuf, total_len);
            
            # Shift buffer left by total_len
            if recv_idx > total_len {
                memcpy(g_rxbuf, g_rxbuf + total_len, recv_idx - total_len);
            }
            recv_idx = recv_idx - total_len;
            store64(g_recv_len, recv_idx);
        }
    }
    return 0;
}

func do_send_gi() -> i64 {
    sock = load64(g_sock);
    if sock == 0 { return 0; }
    
    GetWindowTextA(load64(g_ca_ed), g_cabuf, 32);
    GetWindowTextA(load64(g_oa_ed), g_oabuf, 32);
    
    ca_val = str_to_int(g_cabuf);
    oa_val = str_to_int(g_oabuf);
    
    # GI Command: ASDU TI = 100
    store8(g_txbuf + 0, 0x68);
    store8(g_txbuf + 1, 14); # remainder size (4 bytes APCI + 10 bytes ASDU)
    
    # Tx sequence num
    tx = load64(g_tx_seq);
    tx_val = band(shl(tx, 1), 0xFFFF);
    store8(g_txbuf + 2, band(tx_val, 0xFF));
    store8(g_txbuf + 3, band(shr(tx_val, 8), 0xFF));
    store64(g_tx_seq, band(tx + 1, 0x7FFF));
    
    # Rx sequence num
    rx = load64(g_rx_seq);
    rx_val = band(shl(rx, 1), 0xFFFF);
    store8(g_txbuf + 4, band(rx_val, 0xFF));
    store8(g_txbuf + 5, band(shr(rx_val, 8), 0xFF));
    
    # ASDU payload
    store8(g_txbuf + 6, 100); # TI = 100 (Station Interrogation)
    store8(g_txbuf + 7, 1);   # VSQ = 1 item
    store8(g_txbuf + 8, 6);   # COT = 6 (Activation)
    store8(g_txbuf + 9, oa_val);
    store8(g_txbuf + 10, band(ca_val, 0xFF));
    store8(g_txbuf + 11, band(shr(ca_val, 8), 0xFF));
    
    # IOA = 0
    store8(g_txbuf + 12, 0);
    store8(g_txbuf + 13, 0);
    store8(g_txbuf + 14, 0);
    
    # QOI = 20 (Station Interrogation)
    store8(g_txbuf + 15, 20);
    
    send(sock, g_txbuf, 16, 0);
    log_hex_dump(m_dir_s, g_txbuf, 16, m_gi_act);
    return 0;
}

func parse_float_string_to_f32_bits(s: i64) -> i64 {
    p = s;
    while load8(p) == 32 || load8(p) == 9 { p = p + 1; }
    sign = 1.0;
    if load8(p) == 45 { # '-'
        sign = 0.0 - 1.0;
        p = p + 1;
    } else if load8(p) == 43 {
        p = p + 1;
    }
    val = 0.0;
    while load8(p) >= 48 && load8(p) <= 57 {
        val = val * 10.0 + itof(load8(p) - 48);
        p = p + 1;
    }
    if load8(p) == 46 { # '.'
        p = p + 1;
        divisor = 10.0;
        while load8(p) >= 48 && load8(p) <= 57 {
            val = val + itof(load8(p) - 48) / divisor;
            divisor = divisor * 10.0;
            p = p + 1;
        }
    }
    fval = val * sign;
    bits = fbits(fval);
    sgn  = band(shr(bits, 63), 1);
    exp  = band(shr(bits, 52), 2047);
    mant = band(bits, 4503599627370495);
    if exp == 0 { return shl(sgn, 31); }
    if exp == 2047 { return shl(sgn, 31) + shl(255, 23) + shr(mant, 29); }
    new_exp = exp - 1023 + 127;
    if new_exp <= 0 { return shl(sgn, 31); }
    if new_exp >= 255 { return shl(sgn, 31) + shl(255, 23); }
    new_mant = shr(mant, 29);
    return shl(sgn, 31) + shl(new_exp, 23) + new_mant;
}

func populate_cp56(p_time: ptr) -> i64 {
    GetLocalTime(g_systime);
    
    year = load16(g_systime + 0);
    month = load16(g_systime + 2);
    wday = load16(g_systime + 4);
    day = load16(g_systime + 6);
    hour = load16(g_systime + 8);
    minute = load16(g_systime + 10);
    second = load16(g_systime + 12);
    msec = load16(g_systime + 14);
    
    ms_val = second * 1000 + msec;
    store16(p_time + 0, ms_val);
    store8(p_time + 2, band(minute, 63));
    store8(p_time + 3, band(hour, 31));
    
    if wday == 0 { wday = 7; }
    day_val = band(day, 31) + shl(band(wday, 7), 5);
    store8(p_time + 4, day_val);
    store8(p_time + 5, band(month, 15));
    store8(p_time + 6, band(year % 100, 127));
    return 0;
}

func send_iec104_cmd_packet(ti: i64, ioa_val: i64, val_val: i64, dur_idx: i64, sbo_idx: i64) -> i64 {
    sock = load64(g_sock);
    if sock == 0 { return 0; }
    
    GetWindowTextA(load64(g_ca_ed), g_cabuf, 32);
    GetWindowTextA(load64(g_oa_ed), g_oabuf, 32);
    ca_val = str_to_int(g_cabuf);
    oa_val = str_to_int(g_oabuf);
    
    store8(g_txbuf + 0, 0x68);
    
    tx = load64(g_tx_seq);
    tx_val = band(shl(tx, 1), 0xFFFF);
    store8(g_txbuf + 2, band(tx_val, 0xFF));
    store8(g_txbuf + 3, band(shr(tx_val, 8), 0xFF));
    store64(g_tx_seq, band(tx + 1, 0x7FFF));
    
    rx = load64(g_rx_seq);
    rx_val = band(shl(rx, 1), 0xFFFF);
    store8(g_txbuf + 4, band(rx_val, 0xFF));
    store8(g_txbuf + 5, band(shr(rx_val, 8), 0xFF));
    
    store8(g_txbuf + 6, ti);
    store8(g_txbuf + 7, 1);   # VSQ = 1 item
    store8(g_txbuf + 8, 6);   # COT = 6 (Activation)
    store8(g_txbuf + 9, oa_val);
    store8(g_txbuf + 10, band(ca_val, 0xFF));
    store8(g_txbuf + 11, band(shr(ca_val, 8), 0xFF));
    
    ioa_to_pack = ioa_val;
    if ti == 103 || ti == 105 || ti == 107 {
        ioa_to_pack = 0;
    }
    store8(g_txbuf + 12, band(ioa_to_pack, 0xFF));
    store8(g_txbuf + 13, band(shr(ioa_to_pack, 8), 0xFF));
    store8(g_txbuf + 14, band(shr(ioa_to_pack, 16), 0xFF));
    
    pkt_len = 16;
    
    if ti == 45 || ti == 46 || ti == 47 || ti == 58 || ti == 59 || ti == 60 {
        cmd_byte = 0;
        if ti == 45 || ti == 58 {
            cmd_byte = band(val_val, 1);
        } else {
            cmd_byte = band(val_val, 3);
        }
        cmd_byte = cmd_byte + shl(dur_idx, 2);
        
        if sbo_idx == 1 {
            cmd_byte = cmd_byte + 0x80;
            store64(g_sbo_active, 1);
            store64(g_sbo_type, ti);
            store64(g_sbo_ioa, ioa_val);
            store64(g_sbo_val, val_val);
            store64(g_sbo_qu, dur_idx);
            log_append("    [iec104] SBO: Sending Select activation...\r\n");
        }
        store8(g_txbuf + 15, cmd_byte);
        
        if ti == 58 || ti == 59 || ti == 60 {
            pkt_len = 23;
            populate_cp56(g_txbuf + 16);
        }
    }
    
    if ti == 48 || ti == 49 || ti == 61 || ti == 62 {
        store16(g_txbuf + 15, band(val_val, 0xFFFF));
        qos = dur_idx;
        if sbo_idx == 1 {
            qos = qos + 128;
            store64(g_sbo_active, 1);
            store64(g_sbo_type, ti);
            store64(g_sbo_ioa, ioa_val);
            store64(g_sbo_val, val_val);
            store64(g_sbo_qu, dur_idx);
            log_append("    [iec104] SBO: Sending Select activation...\r\n");
        }
        store8(g_txbuf + 17, qos);
        
        if ti == 48 || ti == 49 {
            pkt_len = 18;
        } else {
            pkt_len = 25;
            populate_cp56(g_txbuf + 18);
        }
    }
    
    if ti == 50 || ti == 63 {
        store32(g_txbuf + 15, val_val);
        qos = dur_idx;
        if sbo_idx == 1 {
            qos = qos + 128;
            store64(g_sbo_active, 1);
            store64(g_sbo_type, ti);
            store64(g_sbo_ioa, ioa_val);
            store64(g_sbo_val, val_val);
            store64(g_sbo_qu, dur_idx);
            log_append("    [iec104] SBO: Sending Select activation...\r\n");
        }
        store8(g_txbuf + 19, qos);
        
        if ti == 50 {
            pkt_len = 20;
        } else {
            pkt_len = 27;
            populate_cp56(g_txbuf + 20);
        }
    }
    
    if ti == 101 {
        frz_rqt = band(val_val, 63) + shl(band(dur_idx, 3), 6);
        store8(g_txbuf + 15, frz_rqt);
        pkt_len = 16;
    }
    
    if ti == 102 {
        pkt_len = 15;
    }
    
    if ti == 103 {
        populate_cp56(g_txbuf + 15);
        pkt_len = 22;
    }
    
    if ti == 105 {
        store8(g_txbuf + 15, band(val_val, 0xFF));
        pkt_len = 16;
    }
    
    if ti == 107 {
        tsc_val = load64(g_tsc);
        store16(g_txbuf + 15, band(tsc_val, 0xFFFF));
        store64(g_tsc, tsc_val + 1);
        populate_cp56(g_txbuf + 17);
        pkt_len = 24;
    }
    
    if ti == 110 || ti == 111 {
        store16(g_txbuf + 15, band(val_val, 0xFFFF));
        desc = dur_idx;
        if sbo_idx == 1 {
            desc = desc + 128;
            store64(g_sbo_active, 1);
            store64(g_sbo_type, ti);
            store64(g_sbo_ioa, ioa_val);
            store64(g_sbo_val, val_val);
            store64(g_sbo_qu, dur_idx);
            log_append("    [iec104] SBO: Sending Select activation...\r\n");
        }
        store8(g_txbuf + 17, desc);
        pkt_len = 18;
    }
    
    if ti == 112 {
        store32(g_txbuf + 15, val_val);
        desc = dur_idx;
        if sbo_idx == 1 {
            desc = desc + 128;
            store64(g_sbo_active, 1);
            store64(g_sbo_type, ti);
            store64(g_sbo_ioa, ioa_val);
            store64(g_sbo_val, val_val);
            store64(g_sbo_qu, dur_idx);
            log_append("    [iec104] SBO: Sending Select activation...\r\n");
        }
        store8(g_txbuf + 19, desc);
        pkt_len = 20;
    }
    
    if ti == 113 {
        store8(g_txbuf + 15, band(val_val, 0xFF));
        pkt_len = 16;
    }
    
    store8(g_txbuf + 1, pkt_len - 2); # remainder size
    
    send(sock, g_txbuf, pkt_len, 0);
    
    if sbo_idx == 1 {
        log_hex_dump(m_dir_s, g_txbuf, pkt_len, " (SELECT COMMAND)");
    } else {
        log_hex_dump(m_dir_s, g_txbuf, pkt_len, " (DIRECT COMMAND)");
    }
    return 0;
}

func do_send_command() -> i64 {
    sock = load64(g_sock);
    if sock == 0 { return 0; }
    
    # Get parameters
    GetWindowTextA(load64(g_ca_ed), g_cabuf, 32);
    GetWindowTextA(load64(g_oa_ed), g_oabuf, 32);
    GetWindowTextA(load64(g_ioa_ed), g_ioabuf, 32);
    GetWindowTextA(load64(g_val_ed), g_valbuf, 32);
    
    ca_val = str_to_int(g_cabuf);
    oa_val = str_to_int(g_oabuf);
    ioa_val = str_to_int(g_ioabuf);
    
    type_idx = SendMessageA(load64(g_type_combo), 327, 0, 0); # CB_GETCURSEL = 327
    
    ti = 45; # Single
    if type_idx == 1  { ti = 46; }
    if type_idx == 2  { ti = 47; }
    if type_idx == 3  { ti = 48; } # Setpoint Norm
    if type_idx == 4  { ti = 49; } # Setpoint Scaled
    if type_idx == 5  { ti = 50; } # Setpoint Float
    if type_idx == 6  { ti = 58; } # Single w/Time
    if type_idx == 7  { ti = 59; } # Double w/Time
    if type_idx == 8  { ti = 60; } # Reg Step w/Time
    if type_idx == 9  { ti = 61; } # Setpoint Norm w/Time
    if type_idx == 10 { ti = 62; } # Setpoint Scaled w/Time
    if type_idx == 11 { ti = 63; } # Setpoint Float w/Time
    if type_idx == 12 { ti = 101; } # Counter Interrog
    if type_idx == 13 { ti = 102; } # Read Command
    if type_idx == 14 { ti = 103; } # Clock Sync
    if type_idx == 15 { ti = 105; } # Reset Process
    if type_idx == 16 { ti = 107; } # Test Cmd w/Time
    if type_idx == 17 { ti = 110; } # Param Norm
    if type_idx == 18 { ti = 111; } # Param Scaled
    if type_idx == 19 { ti = 112; } # Param Float
    if type_idx == 20 { ti = 113; } # Param Activation
    
    dur_idx = SendMessageA(load64(g_dur_combo), 327, 0, 0);
    sbo_idx = SendMessageA(load64(g_sbo_combo), 327, 0, 0);
    
    val_val = 0;
    if ti == 50 || ti == 63 || ti == 112 {
        val_val = parse_float_string_to_f32_bits(g_valbuf);
    } else {
        val_val = str_to_int(g_valbuf);
    }
    
    send_iec104_cmd_packet(ti, ioa_val, val_val, dur_idx, sbo_idx);
    return 0;
}

func do_clear_log() -> i64 {
    SetWindowTextA(load64(g_log), gui_empty);
    return 0;
}

func do_save_log() -> i64 {
    hwnd_log = load64(g_log);
    len = SendMessageA(hwnd_log, 14, 0, 0);
    if len < 1 { return 0; }
    if len > 4094 { len = 4094; }
    SendMessageA(hwnd_log, 13, 4095, g_savebuf);
    hf = CreateFileA(g_logpath, 0x40000000, 0, 0, 2, 128, 0);
    if hf == 0 - 1 {
        log_append(m_save_err);
        return 0;
    }
    WriteFile(hf, g_savebuf, len, g_numbuf, 0);
    CloseHandle(hf);
    log_append(m_save_ok);
    return 0;
}

# ============================================================================
# DARK MODE HELPERS & SUBCLASS PROCEDURES
# ============================================================================

func a2w(dst: i64, src: i64) -> i64 {
    i = 0;
    while 1 {
        c = load8(src + i);
        store8(dst + i + i, c);
        store8(dst + i + i + 1, 0);
        if c == 0 { return 0; }
        i = i + 1;
    }
    return 0;
}

func enable_dark_mode() -> i64 {
    a2w(thm_dm_exp_w, thm_dm_exp_a);
    a2w(thm_dm_cfd_w, thm_dm_cfd_a);
    hm = LoadLibraryA(thm_uxtheme);
    if hm != 0 {
        fn = GetProcAddress(hm, 135);
        if fn != 0 { callp(fn, 2); }
        store64(g_allowdark, GetProcAddress(hm, 133));
    }
    return 0;
}

func dark_scroll(hwnd: i64) -> i64 {
    ad = load64(g_allowdark);
    if ad != 0 { callp(ad, hwnd, 1); }
    SetWindowTheme(hwnd, thm_dm_exp_w, 0);
    return 0;
}

func dark_combo(hwnd: i64) -> i64 {
    ad = load64(g_allowdark);
    if ad != 0 { callp(ad, hwnd, 1); }
    SetWindowTheme(hwnd, thm_dm_cfd_w, 0);
    SendMessageA(hwnd, 0x031A, 0, 0);
    return 0;
}

func ComboBoxWndProc(hwnd: i64, msg: i64, wp: i64, lp: i64) -> i64 {
    if msg == 15 { # WM_PAINT
        hdc = BeginPaint(hwnd, g_combo_ps);
        GetClientRect(hwnd, g_combo_rect);
        l = load32(g_combo_rect + 0);
        t = load32(g_combo_rect + 4);
        r = load32(g_combo_rect + 8);
        b = load32(g_combo_rect + 12);
        
        # Background
        FillRect(hdc, g_combo_rect, load64(g_edit_brush));
        
        # Flat border
        old_brush = SelectObject(hdc, GetStockObject(5));
        SelectObject(hdc, load64(g_pen_border));
        Rectangle(hdc, l, t, r, b);
        SelectObject(hdc, old_brush);
        
        # Draw selected text
        old_font = SelectObject(hdc, load64(g_font));
        SetTextColor(hdc, COLOR_TEXT_PRIMARY);
        SetBkMode(hdc, 1);
        
        sel = SendMessageA(hwnd, 327, 0, 0);
        if sel >= 0 {
            SendMessageA(hwnd, 328, sel, g_temp_text);
            store32(g_combo_rect + 0, l + 6);
            store32(g_combo_rect + 4, t + 2);
            store32(g_combo_rect + 8, r - 24);
            store32(g_combo_rect + 12, b - 2);
            DrawTextA(hdc, g_temp_text, 0 - 1, g_combo_rect, 36);
        }
        
        # Draw Arrow
        x_mid = r - 12;
        y_mid = shr(t + b, 1);
        
        old_pen = SelectObject(hdc, load64(g_pen_arrow));
        MoveToEx(hdc, x_mid - 4, y_mid - 2, 0); LineTo(hdc, x_mid + 5, y_mid - 2);
        MoveToEx(hdc, x_mid - 3, y_mid - 1, 0); LineTo(hdc, x_mid + 4, y_mid - 1);
        MoveToEx(hdc, x_mid - 2, y_mid, 0);     LineTo(hdc, x_mid + 3, y_mid);
        MoveToEx(hdc, x_mid - 1, y_mid + 1, 0); LineTo(hdc, x_mid + 2, y_mid + 1);
        MoveToEx(hdc, x_mid, y_mid + 2, 0);     LineTo(hdc, x_mid + 1, y_mid + 2);
        
        SelectObject(hdc, old_pen);
        SelectObject(hdc, old_font);
        
        EndPaint(hwnd, g_combo_ps);
        return 0;
    }
    
    if msg == 20 { return 1; }
    
    if msg == 7 {
        res = CallWindowProcA(load64(g_old_combo_proc), hwnd, msg, wp, lp);
        InvalidateRect(hwnd, 0, 1);
        return res;
    }
    if msg == 8 {
        res = CallWindowProcA(load64(g_old_combo_proc), hwnd, msg, wp, lp);
        InvalidateRect(hwnd, 0, 1);
        return res;
    }
    
    return CallWindowProcA(load64(g_old_combo_proc), hwnd, msg, wp, lp);
}

func register_class(wndclass: ptr, clsname_arg: str, wndproc_fn: ptr, hinst: i64, cursor: i64, brush: i64) -> i64 {
    store32(wndclass + 0,  80);
    store32(wndclass + 4,  3);
    store64(wndclass + 8,  wndproc_fn);
    store32(wndclass + 16, 0);
    store32(wndclass + 20, 0);
    store64(wndclass + 24, hinst);
    store64(wndclass + 32, 0);
    store64(wndclass + 40, cursor);
    store64(wndclass + 48, brush);
    store64(wndclass + 56, 0);
    store64(wndclass + 64, clsname_arg);
    store64(wndclass + 72, 0);
    return RegisterClassExA(wndclass);
}

func GlowButtonWndProc(hwnd: i64, msg: i64, wParam: i64, lParam: i64) -> i64 {
    if msg == 1 {
        SetWindowLongA(hwnd, 0 - 21, 0);
        return 0;
    }
    if msg == 512 {
        state = GetWindowLongA(hwnd, 0 - 21);
        hover = band(state, 1);
        if hover == 0 {
            pressed = band(state, 2);
            SetWindowLongA(hwnd, 0 - 21, bor(pressed, 1));
            InvalidateRect(hwnd, 0, 1);
            
            store32(g_track_mouse + 0, 24);
            store32(g_track_mouse + 4, 2);
            store64(g_track_mouse + 8, hwnd);
            store64(g_track_mouse + 16, 0);
            TrackMouseEvent(g_track_mouse);
        }
        return 0;
    }
    if msg == 675 {
        state = GetWindowLongA(hwnd, 0 - 21);
        pressed = band(state, 2);
        SetWindowLongA(hwnd, 0 - 21, pressed);
        InvalidateRect(hwnd, 0, 1);
        return 0;
    }
    if msg == 513 {
        state = GetWindowLongA(hwnd, 0 - 21);
        hover = band(state, 1);
        SetWindowLongA(hwnd, 0 - 21, bor(hover, 2));
        SetCapture(hwnd);
        InvalidateRect(hwnd, 0, 1);
        return 0;
    }
    if msg == 514 {
        state = GetWindowLongA(hwnd, 0 - 21);
        pressed = band(state, 2);
        if pressed == 2 {
            ReleaseCapture();
            hover = band(state, 1);
            SetWindowLongA(hwnd, 0 - 21, hover);
            InvalidateRect(hwnd, 0, 1);
            if hover == 1 {
                parent = GetParent(hwnd);
                id = GetWindowLongA(hwnd, 0 - 12);
                SendMessageA(parent, 273, id, hwnd);
            }
        }
        return 0;
    }
    if msg == 15 {
        hdc = BeginPaint(hwnd, g_ps);
        GetClientRect(hwnd, g_rect);
        l = load32(g_rect + 0);
        t = load32(g_rect + 4);
        r = load32(g_rect + 8);
        b = load32(g_rect + 12);
        
        state = GetWindowLongA(hwnd, 0 - 21);
        hover = band(state, 1);
        pressed = band(state, 2);
        
        br = load64(g_brush_card);
        if pressed == 2 { br = load64(g_brush_input); }
        else if hover == 1 { br = load64(g_brush_hover); }
        
        old_brush = SelectObject(hdc, br);
        pen = load64(g_pen_border);
        if pressed == 2 { pen = load64(g_pen_neon); }
        else if hover == 1 { pen = load64(g_pen_neon); }
        
        old_pen = SelectObject(hdc, pen);
        RoundRect(hdc, l, t, r, b, 8, 8);
        
        if hover == 1 {
            SelectObject(hdc, load64(g_pen_neon));
            RoundRect(hdc, l + 1, t + 1, r - 1, b - 1, 8, 8);
        }
        
        SetBkMode(hdc, 1);
        if hover == 1 { SetTextColor(hdc, COLOR_TEXT_BRIGHT); }
        else if pressed == 2 { SetTextColor(hdc, COLOR_TEXT_BRIGHT); }
        else { SetTextColor(hdc, COLOR_TEXT_PRIMARY); }
        
        SelectObject(hdc, load64(g_font));
        GetWindowTextA(hwnd, g_temp_text, 128);
        DrawTextA(hdc, g_temp_text, 0 - 1, g_rect, 37);
        
        SelectObject(hdc, old_brush);
        SelectObject(hdc, old_pen);
        EndPaint(hwnd, g_ps);
        return 0;
    }
    return DefWindowProcA(hwnd, msg, wParam, lParam);
}

# ============================================================================
# MAIN WINDOW PROCEDURE
# ============================================================================

func wndproc(hwnd: i64, msg: i64, wp: i64, lp: i64) -> i64 {
    # WM_CREATE
    if msg == 1 {
        store64(g_hwnd, hwnd);
        hinst = load64(g_hinst);
        
        # Create Font
        store64(g_font, CreateFontA(0 - 14, 0, 0, 0, 400, 0, 0, 0, 0, 0, 0, 0, 49, face_mono));
        
        # Custom title bar buttons
        CreateWindowExA(0, cls_glow_btn, btn_min, 0x50000000, 1330, 8, 26, 26, hwnd, ID_BTN_MIN, hinst, 0);
        CreateWindowExA(0, cls_glow_btn, btn_close, 0x50000000, 1358, 8, 26, 26, hwnd, ID_BTN_CLOSE, hinst, 0);
        
        # ---- Row 1: Connection & Link (Y=52) ----
        CreateWindowExA(0, cls_stat, lbl_host, 0x50000000, 12, 54, 40, 20, hwnd, 0, hinst, 0);
        h = CreateWindowExA(0, cls_edit, def_host, 0x50000080, 55, 52, 130, 24, hwnd, ID_HOST_EDIT, hinst, 0);
        store64(g_host_ed, h); SendMessageA(h, 48, load64(g_font), 1); dark_scroll(h);
        
        CreateWindowExA(0, cls_stat, lbl_port, 0x50000000, 195, 54, 35, 20, hwnd, 0, hinst, 0);
        h = CreateWindowExA(0, cls_edit, def_port, 0x50000080, 232, 52, 50, 24, hwnd, ID_PORT_EDIT, hinst, 0);
        store64(g_port_ed, h); SendMessageA(h, 48, load64(g_font), 1); dark_scroll(h);
        
        CreateWindowExA(0, cls_stat, lbl_ca, 0x50000000, 295, 54, 25, 20, hwnd, 0, hinst, 0);
        h = CreateWindowExA(0, cls_edit, def_ca, 0x50000080, 320, 52, 45, 24, hwnd, ID_CA_EDIT, hinst, 0);
        store64(g_ca_ed, h); SendMessageA(h, 48, load64(g_font), 1); dark_scroll(h);
        
        CreateWindowExA(0, cls_stat, lbl_oa, 0x50000000, 375, 54, 25, 20, hwnd, 0, hinst, 0);
        h = CreateWindowExA(0, cls_edit, def_oa, 0x50000080, 400, 52, 45, 24, hwnd, ID_OA_EDIT, hinst, 0);
        store64(g_oa_ed, h); SendMessageA(h, 48, load64(g_font), 1); dark_scroll(h);
        
        CreateWindowExA(0, cls_glow_btn, btn_conn, 0x50000000, 455, 50, 65, 28, hwnd, ID_BTN_CONN, hinst, 0);
        CreateWindowExA(0, cls_glow_btn, btn_disc, 0x50000000, 525, 50, 95, 28, hwnd, ID_BTN_DISC, hinst, 0);
        CreateWindowExA(0, cls_glow_btn, btn_gi, 0x50000000, 625, 50, 80, 28, hwnd, ID_BTN_GI, hinst, 0);
        
        # ---- Row 2: Command Options & Values (Y=86) ----
        CreateWindowExA(0, cls_stat, lbl_ioa, 0x50000000, 12, 90, 75, 20, hwnd, 0, hinst, 0);
        h = CreateWindowExA(0, cls_edit, def_ioa, 0x50000080, 90, 88, 50, 24, hwnd, ID_IOA_EDIT, hinst, 0);
        store64(g_ioa_ed, h); SendMessageA(h, 48, load64(g_font), 1); dark_scroll(h);
        
        CreateWindowExA(0, cls_stat, lbl_val, 0x50000000, 150, 90, 75, 20, hwnd, 0, hinst, 0);
        h = CreateWindowExA(0, cls_edit, def_val, 0x50000080, 230, 88, 50, 24, hwnd, ID_VAL_EDIT, hinst, 0);
        store64(g_val_ed, h); SendMessageA(h, 48, load64(g_font), 1); dark_scroll(h);
        
        CreateWindowExA(0, cls_stat, lbl_cmd, 0x50000000, 295, 90, 40, 20, hwnd, 0, hinst, 0);
        h = CreateWindowExA(0, cls_combo, gui_empty, 0x50200003, 340, 86, 130, 100, hwnd, ID_TYPE_COMBO, hinst, 0);
        store64(g_type_combo, h); SendMessageA(h, 48, load64(g_font), 1); dark_combo(h);
        old = SetWindowLongPtrA(h, 0 - 4, &ComboBoxWndProc); store64(g_old_combo_proc, old);
        SendMessageA(h, 323, 0, cmd_item_sc); SendMessageA(h, 323, 0, cmd_item_dc);
        SendMessageA(h, 323, 0, iec_type_47); SendMessageA(h, 323, 0, iec_type_48);
        SendMessageA(h, 323, 0, iec_type_49); SendMessageA(h, 323, 0, iec_type_50);
        SendMessageA(h, 323, 0, iec_type_58); SendMessageA(h, 323, 0, iec_type_59);
        SendMessageA(h, 323, 0, iec_type_60); SendMessageA(h, 323, 0, iec_type_61);
        SendMessageA(h, 323, 0, iec_type_62); SendMessageA(h, 323, 0, iec_type_63);
        SendMessageA(h, 323, 0, iec_type_101); SendMessageA(h, 323, 0, iec_type_102);
        SendMessageA(h, 323, 0, iec_type_103); SendMessageA(h, 323, 0, iec_type_105);
        SendMessageA(h, 323, 0, iec_type_107); SendMessageA(h, 323, 0, iec_type_110);
        SendMessageA(h, 323, 0, iec_type_111); SendMessageA(h, 323, 0, iec_type_112);
        SendMessageA(h, 323, 0, iec_type_113);
        SendMessageA(h, 334, 0, 0);
        
        CreateWindowExA(0, cls_stat, lbl_dur, 0x50000000, 485, 90, 120, 20, hwnd, 0, hinst, 0);
        h = CreateWindowExA(0, cls_combo, gui_empty, 0x50200003, 610, 86, 150, 100, hwnd, ID_DUR_COMBO, hinst, 0);
        store64(g_dur_combo, h); SendMessageA(h, 48, load64(g_font), 1); dark_combo(h);
        SetWindowLongPtrA(h, 0 - 4, &ComboBoxWndProc);
        SendMessageA(h, 323, 0, dur_item_0); SendMessageA(h, 323, 0, dur_item_1); SendMessageA(h, 323, 0, dur_item_2); SendMessageA(h, 334, 0, 0);
        
        CreateWindowExA(0, cls_stat, lbl_sbo, 0x50000000, 775, 90, 35, 20, hwnd, 0, hinst, 0);
        h = CreateWindowExA(0, cls_combo, gui_empty, 0x50200003, 815, 86, 100, 100, hwnd, ID_SBO_COMBO, hinst, 0);
        store64(g_sbo_combo, h); SendMessageA(h, 48, load64(g_font), 1); dark_combo(h);
        SetWindowLongPtrA(h, 0 - 4, &ComboBoxWndProc);
        SendMessageA(h, 323, 0, sbo_item_no); SendMessageA(h, 323, 0, sbo_item_yes); SendMessageA(h, 334, 0, 0);
        
        CreateWindowExA(0, cls_glow_btn, btn_send, 0x50000000, 930, 84, 110, 28, hwnd, ID_BTN_SEND, hinst, 0);
        
        # ---- Log View & Buttons (Y=118) ----
        CreateWindowExA(0, cls_stat, lbl_log, 0x50000000, 12, 118, 100, 20, hwnd, 0, hinst, 0);
        h = CreateWindowExA(0, cls_edit, gui_empty, 0x50200044, 12, 142, 490, 395, hwnd, ID_LOG, hinst, 0);
        store64(g_log, h); SendMessageA(h, 48, load64(g_font), 1); dark_scroll(h);
        
        CreateWindowExA(0, cls_glow_btn, btn_clear, 0x50000000, 370, 544, 55, 26, hwnd, ID_BTN_CLEAR, hinst, 0);
        CreateWindowExA(0, cls_glow_btn, btn_save, 0x50000000, 435, 544, 55, 26, hwnd, ID_BTN_SAVE, hinst, 0);
        
        # ---- ListView (right side, Y=142) ----
        h = CreateWindowExA(0, cls_lv, gui_empty, 0x5000C04D, 520, 142, 840, 395, hwnd, ID_LISTVIEW, hinst, 0);
        store64(g_listview, h); SendMessageA(h, 48, load64(g_font), 1);
        SendMessageA(h, 4150, 0x20, 0x20); # LVS_EX_FULLROWSELECT
        
        # Dark theme colors for ListView
        SendMessageA(h, 4097, 0, COLOR_BG_CARD);
        SendMessageA(h, 4132, 0, COLOR_TEXT_PRIMARY);
        SendMessageA(h, 4134, 0, COLOR_BG_CARD);
        dark_scroll(h);
        
        # Columns
        memset(g_lvcol, 0, 64);
        store32(g_lvcol + 0, 15); # LVCF_FMT|LVCF_WIDTH|LVCF_TEXT|LVCF_SUBITEM
        store32(g_lvcol + 4, 0);
        store32(g_lvcol + 8, 100); store64(g_lvcol + 16, col_area);
        SendMessageA(h, 4123, 0, g_lvcol);
        
        store32(g_lvcol + 8, 60); store64(g_lvcol + 16, col_addr); store32(g_lvcol + 24, 1);
        SendMessageA(h, 4123, 1, g_lvcol);
        
        store32(g_lvcol + 8, 120); store64(g_lvcol + 16, col_val); store32(g_lvcol + 24, 2);
        SendMessageA(h, 4123, 2, g_lvcol);
        
        store32(g_lvcol + 8, 120); store64(g_lvcol + 16, col_type); store32(g_lvcol + 24, 3);
        SendMessageA(h, 4123, 3, g_lvcol);
        
        store32(g_lvcol + 8, 80); store64(g_lvcol + 16, col_cause); store32(g_lvcol + 24, 4);
        SendMessageA(h, 4123, 4, g_lvcol);
        
        store32(g_lvcol + 8, 80); store64(g_lvcol + 16, col_flags); store32(g_lvcol + 24, 5);
        SendMessageA(h, 4123, 5, g_lvcol);
        
        store32(g_lvcol + 8, 60); store64(g_lvcol + 16, col_count); store32(g_lvcol + 24, 6);
        SendMessageA(h, 4123, 6, g_lvcol);
        
        store32(g_lvcol + 8, 220); store64(g_lvcol + 16, col_timetag); store32(g_lvcol + 24, 7);
        SendMessageA(h, 4123, 7, g_lvcol);
        
        # ---- Status bar ----
        h = CreateWindowExA(0, cls_stat, lbl_status, 0x50000000, 12, 580, 1340, 20, hwnd, ID_STATUS, hinst, 0);
        store64(g_status, h);
        
        return 0;
    }
    
    # WM_PAINT
    if msg == 15 {
        hdc = BeginPaint(hwnd, g_ps);
        GetClientRect(hwnd, g_rect);
        r = load32(g_rect + 8);
        b2 = load32(g_rect + 12);
        
        # Title bar background
        store32(g_rect + 0, 0);
        store32(g_rect + 4, 0);
        store32(g_rect + 8, r);
        store32(g_rect + 12, 42);
        FillRect(hdc, g_rect, load64(g_brush_panel));
        
        # Neon accent divider
        old_pen = SelectObject(hdc, load64(g_pen_neon));
        MoveToEx(hdc, 0, 42, 0); LineTo(hdc, r, 42);
        SelectObject(hdc, old_pen);
        
        # Title text
        SetBkMode(hdc, 1);
        SetTextColor(hdc, COLOR_NEON_ORANGE);
        SelectObject(hdc, load64(g_font_header));
        TextOutA(hdc, 15, 12, title_draw, 27);
        
        # Connection status dot
        sock = load64(g_sock);
        if sock != 0 {
            SetTextColor(hdc, COL_GREEN);
            TextOutA(hdc, 315, 12, st_conn_ind, 11);
        } else {
            SetTextColor(hdc, COL_RED);
            TextOutA(hdc, 315, 12, st_disc_ind, 14);
        }
        
        # Flat borders
        old_brush = SelectObject(hdc, GetStockObject(5));
        SelectObject(hdc, load64(g_pen_border));
        
        Rectangle(hdc, 54, 51, 185, 76);     # Host
        Rectangle(hdc, 231, 51, 282, 76);    # Port
        Rectangle(hdc, 319, 51, 365, 76);    # CA
        Rectangle(hdc, 399, 51, 445, 76);    # OA
        Rectangle(hdc, 89, 87, 140, 112);     # Cmd Address (IOA)
        Rectangle(hdc, 229, 87, 280, 112);   # Cmd Value
        Rectangle(hdc, 11, 141, 503, 538);    # Log
        
        # Draw custom flat headers for ListView Point Grid
        # Column 0: Address
        store32(g_rect + 0, 520); store32(g_rect + 4, 118); store32(g_rect + 8, 620); store32(g_rect + 12, 142);
        FillRect(hdc, g_rect, load64(g_edit_brush)); Rectangle(hdc, 520, 118, 620, 142);
        
        # Column 1: CA
        store32(g_rect + 0, 620); store32(g_rect + 4, 118); store32(g_rect + 8, 680); store32(g_rect + 12, 142);
        FillRect(hdc, g_rect, load64(g_edit_brush)); Rectangle(hdc, 620, 118, 680, 142);
        
        # Column 2: Value
        store32(g_rect + 0, 680); store32(g_rect + 4, 118); store32(g_rect + 8, 800); store32(g_rect + 12, 142);
        FillRect(hdc, g_rect, load64(g_edit_brush)); Rectangle(hdc, 680, 118, 800, 142);
        
        # Column 3: Type
        store32(g_rect + 0, 800); store32(g_rect + 4, 118); store32(g_rect + 8, 920); store32(g_rect + 12, 142);
        FillRect(hdc, g_rect, load64(g_edit_brush)); Rectangle(hdc, 800, 118, 920, 142);
        
        # Column 4: Cause
        store32(g_rect + 0, 920); store32(g_rect + 4, 118); store32(g_rect + 8, 1000); store32(g_rect + 12, 142);
        FillRect(hdc, g_rect, load64(g_edit_brush)); Rectangle(hdc, 920, 118, 1000, 142);
        
        # Column 5: Flags
        store32(g_rect + 0, 1000); store32(g_rect + 4, 118); store32(g_rect + 8, 1080); store32(g_rect + 12, 142);
        FillRect(hdc, g_rect, load64(g_edit_brush)); Rectangle(hdc, 1000, 118, 1080, 142);
        
        # Column 6: Count
        store32(g_rect + 0, 1080); store32(g_rect + 4, 118); store32(g_rect + 8, 1140); store32(g_rect + 12, 142);
        FillRect(hdc, g_rect, load64(g_edit_brush)); Rectangle(hdc, 1080, 118, 1140, 142);
        
        # Column 7: TimeTag
        store32(g_rect + 0, 1140); store32(g_rect + 4, 118); store32(g_rect + 8, 1360); store32(g_rect + 12, 142);
        FillRect(hdc, g_rect, load64(g_edit_brush)); Rectangle(hdc, 1140, 118, 1360, 142);
        
        # Draw header text labels
        SetBkMode(hdc, 1);
        SetTextColor(hdc, COLOR_TEXT_PRIMARY);
        old_font = SelectObject(hdc, load64(g_font));
        TextOutA(hdc, 528, 122, col_area, 7);
        TextOutA(hdc, 628, 122, col_addr, 2);
        TextOutA(hdc, 688, 122, col_val, 5);
        TextOutA(hdc, 808, 122, col_type, 4);
        TextOutA(hdc, 928, 122, col_cause, 5);
        TextOutA(hdc, 1008, 122, col_flags, 5);
        TextOutA(hdc, 1088, 122, col_count, 5);
        TextOutA(hdc, 1148, 122, col_timetag, 7);
        SelectObject(hdc, old_font);
        
        SelectObject(hdc, old_brush);
        EndPaint(hwnd, g_ps);
        return 0;
    }
    
    # WM_NOTIFY
    if msg == 78 {
        hdr_ptr = lp;
        code = load32(hdr_ptr + 16);
        hwndFrom = load64(hdr_ptr + 0);
        row_idx = load32(hdr_ptr + 24);
        
        is_click = band(code, 4294967295) == 4294967294;
        is_dblclk = band(code, 4294967295) == 4294967293;
        
        if bor(is_click, is_dblclk) != 0 {
            hlv = load64(g_listview);
            if hwndFrom == hlv {
                if row_idx != 0 - 1 {
                    # Read Address/IOA (col 0)
                    memset(g_lvitem, 0, 96);
                    store32(g_lvitem + 0, 1); # mask = LVIF_TEXT
                    store32(g_lvitem + 4, row_idx);
                    store32(g_lvitem + 8, 0); # Column 0 has the IOA
                    store64(g_lvitem + 24, g_temp_ioa);
                    store32(g_lvitem + 32, 64);
                    SendMessageA(hlv, 4141, row_idx, g_lvitem); # LVM_GETITEMTEXTA = 4141
                    
                    # Read Value (col 2)
                    memset(g_lvitem, 0, 96);
                    store32(g_lvitem + 0, 1); # mask = LVIF_TEXT
                    store32(g_lvitem + 4, row_idx);
                    store32(g_lvitem + 8, 2); # Column 2 has the Value
                    store64(g_lvitem + 24, g_valbuf);
                    store32(g_lvitem + 32, 32);
                    SendMessageA(hlv, 4141, row_idx, g_lvitem); # LVM_GETITEMTEXTA = 4141
                    
                    SetWindowTextA(load64(g_ioa_ed), g_temp_ioa);
                    SetWindowTextA(load64(g_val_ed), g_valbuf);
                }
            }
        }
        return 0;
    }
    
    # WM_COMMAND
    if msg == 273 {
        cmd_id = band(wp, 0xFFFF);
        if cmd_id == ID_BTN_MIN   { ShowWindow(hwnd, 6); return 0; }
        if cmd_id == ID_BTN_CLOSE { DestroyWindow(hwnd); return 0; }
        if cmd_id == ID_BTN_CONN  { do_connect(); }
        if cmd_id == ID_BTN_DISC  { do_disconnect(); }
        if cmd_id == ID_BTN_GI    { do_send_gi(); }
        if cmd_id == ID_BTN_SEND  { do_send_command(); }
        if cmd_id == ID_BTN_CLEAR { do_clear_log(); }
        if cmd_id == ID_BTN_SAVE  { do_save_log(); }
        return 0;
    }
    
    # WM_TIMER (receive non-blocking stream)
    if msg == 275 {
        if band(wp, 0xFFFF) == ID_TIMER_RECV { do_recv_tick(); }
        return 0;
    }
    
    # WM_CTLCOLORSTATIC
    if msg == 312 {
        SetTextColor(wp, COL_TEXT);
        SetBkColor(wp, COL_BG);
        return load64(g_bg_brush);
    }
    
    # WM_CTLCOLOREDIT
    if msg == 307 {
        SetTextColor(wp, COL_TEXT);
        SetBkColor(wp, COL_PANEL);
        return load64(g_edit_brush);
    }
    
    # WM_CTLCOLORLISTBOX
    if msg == 308 {
        SetTextColor(wp, COL_TEXT);
        SetBkColor(wp, COL_PANEL);
        return load64(g_edit_brush);
    }
    
    # WM_NCHITTEST (draggable title bar)
    if msg == 132 {
        GetWindowRect(hwnd, g_rect);
        wl = load32(g_rect + 0);
        wt = load32(g_rect + 4);
        mx = band(lp, 65535);
        my = shr(lp, 16);
        cx = mx - wl;
        cy = my - wt;
        
        if cy < 42 {
            if cx >= 1330 {
                if cx < 1356 {
                    if cy >= 8 {
                        if cy < 34 { return 1; }
                    }
                }
            }
            if cx >= 1358 {
                if cx < 1384 {
                    if cy >= 8 {
                        if cy < 34 { return 1; }
                    }
                }
            }
            return 2; # HTCAPTION
        }
        return 1; # HTCLIENT
    }
    
    # WM_ERASEBKGND
    if msg == 20 {
        GetClientRect(hwnd, g_rect);
        FillRect(wp, g_rect, load64(g_bg_brush));
        return 1;
    }
    
    # WM_DESTROY
    if msg == 2 {
        do_disconnect();
        PostQuitMessage(0);
        return 0;
    }
    
    return DefWindowProcA(hwnd, msg, wp, lp);
}

# ============================================================================
# ENTRY POINT
# ============================================================================

func main() -> i32 {
    # Init Winsock
    rc = WSAStartup(514, g_wsa);
    if rc != 0 { return 1; }
    
    store64(g_sock, 0);
    store64(g_tx_seq, 0);
    store64(g_rx_seq, 0);
    store64(g_recv_len, 0);
    store64(g_sbo_active, 0);
    
    hinst = GetModuleHandleA(0);
    store64(g_hinst, hinst);
    cursor = LoadCursorA(0, 32512);
    
    enable_dark_mode();
    
    # Create GDI Brushes/Pens/Fonts
    store64(g_bg_brush, CreateSolidBrush(COL_BG));
    store64(g_edit_brush, CreateSolidBrush(COL_PANEL));
    store64(g_brush_deep,  CreateSolidBrush(COLOR_BG_DEEP));
    store64(g_brush_panel, CreateSolidBrush(COLOR_BG_PANEL));
    store64(g_brush_card,  CreateSolidBrush(COLOR_BG_CARD));
    store64(g_brush_input, CreateSolidBrush(COLOR_BG_INPUT));
    store64(g_brush_hover, CreateSolidBrush(COLOR_BG_HOVER));
    store64(g_brush_neon,  CreateSolidBrush(COLOR_NEON_ORANGE));
    store64(g_pen_border,  CreatePen(0, 1, COLOR_BORDER));
    store64(g_pen_neon,    CreatePen(0, 2, COLOR_NEON_ORANGE));
    store64(g_pen_arrow,   CreatePen(0, 1, COLOR_TEXT_PRIMARY));
    
    store64(g_font_header, CreateFontA(16, 0, 0, 0, 700, 0, 0, 0, 0, 0, 0, 0, 0, face_mono));
    
    # Init ListView controls
    store32(g_wsa + 0, 8);
    store32(g_wsa + 4, 1);
    InitCommonControlsEx(g_wsa);
    
    # Register Custom Button Class
    register_class(g_wndclass_btn, cls_glow_btn, &GlowButtonWndProc, hinst, cursor, load64(g_brush_card));
    
    # Register Main Window
    memset(g_wndcls, 0, 96);
    store32(g_wndcls + 0, 80);
    store32(g_wndcls + 4, 0);
    store64(g_wndcls + 8, &wndproc);
    store64(g_wndcls + 24, hinst);
    store64(g_wndcls + 40, cursor);
    store64(g_wndcls + 48, load64(g_bg_brush));
    store64(g_wndcls + 64, clsname);
    RegisterClassExA(g_wndcls);
    
    # Create Window
    hwnd = CreateWindowExA(0, clsname, title, 0x90000000, 100, 100, WIN_W, WIN_H, 0, 0, hinst, 0);
    
    ShowWindow(hwnd, 1);
    UpdateWindow(hwnd);
    
    while GetMessageA(g_msg, 0, 0, 0) != 0 {
        TranslateMessage(g_msg);
        DispatchMessageA(g_msg);
    }
    return 0;
}
