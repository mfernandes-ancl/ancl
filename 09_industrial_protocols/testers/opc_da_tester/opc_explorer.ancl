# ============================================================================
#  opc_explorer.ancl  -  ANCL OPC DA Explorer  (Phase 6.11, native Win32 GUI)
#
#  A "normal" Windows OPC DA test client, written entirely in ANCL:
#    * Browses OPC DA servers (OpcEnum: IOPCServerList -> IEnumGUID), LOCAL or
#      on a remote box via the Host/IP field (DCOM CoCreateInstanceEx).
#    * Connect / Disconnect (CoCreateInstanceEx(IOPCServer) + AddGroup).
#    * Browse Tags -> IOPCBrowseServerAddressSpace flat browse -> AddItems
#      every tag -> a comctl32 ListView grid (Item ID | Value | Type | Quality).
#    * Start/Stop Poll (poll-rate + WM_TIMER) -> IOPCSyncIO::Read of ALL tag
#      handles each tick -> live cells. Values typed via core_lib/numfmt.ancl
#      (signed ints, BOOL, IEEE-754 R4/R8 floats, OLE DATE) -- integer-only.
#    * (also a single Item-ID box + Read.)
#
#  100% CRT-free PE32+, GUI subsystem. Imports kernel32 + user32 + comctl32 +
#  ole32. Built on the Phase 6.11 `callp` primitive + win32_com + numfmt.
# ============================================================================

# ============================================================================
# 1. TOP-LEVEL IMPORTS
# ============================================================================
import "../../core_lib/win32_api.ancl";
import "../../core_lib/win32_com.ancl";
import "../../core_lib/numfmt.ancl";
extern "comctl32.dll" InitCommonControlsEx;
extern "gdi32.dll" GetStockObject -> ptr;
extern "gdi32.dll" CreatePen -> ptr;
extern "gdi32.dll" SelectObject -> ptr;
extern "gdi32.dll" Rectangle -> i32;
extern "gdi32.dll" SetBkMode -> i32;
extern "user32.dll" DrawTextA -> i32;
extern "gdi32.dll" CreateFontA -> ptr;
extern "gdi32.dll" RoundRect -> i32;
extern "user32.dll" DestroyWindow -> i32;
extern "user32.dll" GetWindowRect -> i32;
extern "uxtheme.dll" SetWindowTheme -> i32;
extern "user32.dll" SetWindowLongPtrA -> ptr;
extern "user32.dll" CallWindowProcA -> i64;

# ============================================================================
# 2. GLOBAL SYSTEM MEMORY SEGMENT
# ============================================================================
