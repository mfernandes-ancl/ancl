extern "ole32.dll"    CoInitializeEx;
extern "ole32.dll"    CoRegisterClassObject;
extern "ole32.dll"    CoResumeClassObjects;
extern "ole32.dll"    CoTaskMemAlloc -> ptr;
extern "ole32.dll"    CoCreateInstance;
extern "kernel32.dll" VirtualAlloc -> ptr;
extern "kernel32.dll" GetSystemTimeAsFileTime;
extern "kernel32.dll" GetModuleFileNameA;
extern "kernel32.dll" GetCommandLineA -> ptr;
extern "advapi32.dll" RegCreateKeyExA;
extern "advapi32.dll" RegSetValueExA;
extern "advapi32.dll" RegCloseKey;
extern "advapi32.dll" RegDeleteTreeA;
extern "kernel32.dll" CreateFileA -> ptr;
extern "kernel32.dll" WriteFile;
extern "kernel32.dll" CloseHandle;
extern "kernel32.dll" SetFilePointer;
extern "ole32.dll"    CoRevokeClassObject;
extern "ole32.dll"    CoUninitialize;
extern "user32.dll"   PostMessageA;

@CODE
# =====================================================================
# COM helpers + interfaces (validated cross-process in Stage A)
# =====================================================================
func compare_guid(a: ptr, b: ptr) -> i64 {
    if load64(a) != load64(b) { return 1; }
    if load64(a + 8) != load64(b + 8) { return 1; }
    return 0;
}
# method pointer for vtable slot idx of a COM object (for calling the client's IOPCDataCallback)
func vmeth(obj: i64, idx: i64) -> i64 { return load64(load64(obj) + idx * 8); }
# append a string to the debug log (open/seek-end/write/close per call)
func dbg(s: i64) -> i64 {
    h = CreateFileA(logpath, 0x40000000, 1, 0, 4, 0x80, 0);   # GENERIC_WRITE, SHARE_READ, OPEN_ALWAYS
    if h == 0 - 1 { return 0; }
    SetFilePointer(h, 0, 0, 2);                                # FILE_END (append)
    WriteFile(h, s, strlen(s), g_nio, 0);
    CloseHandle(h);
    return 0;
}
func dbgn(v: i64) -> i64 { int_to_str(g_logbuf, v); dbg(g_logbuf); return 0; }
# COM-launched instance: when the last client releases the server, close the window (-> clean exit).
# User-launched instance (g_embedding==0): no-op, stays open until the user closes it.
func check_exit() -> i64 {
    if load64(g_embedding) == 1 { dbg(d_exit); PostMessageA(load64(g_hwnd), 16, 0, 0); }   # WM_CLOSE = 0x10
    return 0;
}
func init_iids() -> i64 {
    store64(iid_unk + 0, 0x0000000000000000); store64(iid_unk + 8, 0x46000000000000C0);
    store64(iid_server + 0,  0x11D0011E39C13A4D); store64(iid_server + 8,  0xB3ADD8AF20007596);
    store64(iid_itemmgt + 0, 0x11D0011E39C13A54); store64(iid_itemmgt + 8, 0xB3ADD8AF20007596);
    store64(iid_syncio + 0,  0x11D0011E39C13A52); store64(iid_syncio + 8,  0xB3ADD8AF20007596);
    store64(iid_groupst + 0, 0x11D0011E39C13A50); store64(iid_groupst + 8, 0xB3ADD8AF20007596);
    store64(iid_cf + 0, 0x0000000000000001); store64(iid_cf + 8, 0x46000000000000C0);
    store64(iid_browse + 0, 0x11D0011E39C13A4F); store64(iid_browse + 8, 0xB3ADD8AF20007596);
    store64(iid_enumstr + 0, 0x0000000000000101); store64(iid_enumstr + 8, 0x46000000000000C0);
    store64(iid_props + 0, 0x11D0011E39C13A72); store64(iid_props + 8, 0xB3ADD8AF20007596);
    store64(iid_cpc + 0, 0x101ABAB4B196B284); store64(iid_cpc + 8, 0x071D3400AA009CB6);
    store64(iid_cp + 0,  0x101ABAB4B196B286); store64(iid_cp + 8,  0x071D3400AA009CB6);
    store64(iid_async + 0, 0x11D0011E39C13A71); store64(iid_async + 8, 0xB3ADD8AF20007596);
    store64(iid_datacb + 0, 0x11D0011E39C13A70); store64(iid_datacb + 8, 0xB3ADD8AF20007596);
    return 0;
}
func widen_taskmem(a: i64) -> i64 {
    n = strlen(a);
    w = CoTaskMemAlloc((n + 1) * 2);
    if w == 0 { return 0; }
    i = 0;
    while i <= n { store16(w + i * 2, load8(a + i)); i = i + 1; }
    return w;
}
func weq_a(w: i64, a: i64) -> i64 {
    i = 0;
    while 1 {
        ca = load8(a + i);
        cw = load16(w + i * 2);
        if cw != ca { return 0; }
        if ca == 0 { return 1; }
        i = i + 1;
    }
    return 0;
}
func tag_match(w: i64) -> i64 {
    if weq_a(w, t_status) == 1 { return 0; }
    if weq_a(w, t_freq) == 1 { return 1; }
    if weq_a(w, t_volt) == 1 { return 2; }
    if weq_a(w, t_breaker) == 1 { return 3; }
    if weq_a(w, t_setpoint) == 1 { return 4; }
    return 0 - 1;
}
func tag_vt(idx: i64) -> i64 {
    if idx == 0 { return 3; }       # VT_I4
    if idx == 3 { return 11; }      # VT_BOOL
    return 5;                       # VT_R8 (freq, volt, setpoint)
}
func tag_access(idx: i64) -> i64 {
    if idx < 3 { return 1; }        # OPC_READABLE (live simulated values)
    return 3;                       # OPC_READABLE | OPC_WRITEABLE (breaker, setpoint)
}
func tag_id(idx: i64) -> i64 {
    if idx == 0 { return t_status; }
    if idx == 1 { return t_freq; }
    if idx == 2 { return t_volt; }
    if idx == 3 { return t_breaker; }
    return t_setpoint;
}
# Fill a 24-byte VARIANT (vt@0, data@8) with tag idx's current value + canonical type.
func fill_variant(v: ptr, idx: i64) -> i64 {
    store64(v + 0, 0); store64(v + 8, 0); store64(v + 16, 0);   # clear full 24-byte VARIANT
    vt = tag_vt(idx);
    store16(v + 0, vt);
    if vt == 3 { store32(v + 8, load64(tag_data + idx * 8)); }                  # VT_I4
    else { if vt == 11 {                                                        # VT_BOOL (TRUE = 0xFFFF)
        if load64(tag_data + idx * 8) != 0 { store16(v + 8, 0xFFFF); }
    } else { store64(v + 8, load64(tag_data + idx * 8)); } }                    # VT_R8 (raw f64 bits)
    return 0;
}
# Apply a client-written VARIANT v into tag idx's storage (with light type coercion).
func write_tag(idx: i64, v: ptr) -> i64 {
    vt = load16(v + 0);
    tvt = tag_vt(idx);
    if tvt == 11 {                                                             # BOOL tag
        b = 0;
        if vt == 11 { if load16(v + 8) != 0 { b = 1; } }
        else { if load64(v + 8) != 0 { b = 1; } }
        store64(tag_data + idx * 8, b);
    } else { if tvt == 5 {                                                     # R8 tag
        if vt == 3 { store64(tag_data + idx * 8, fbits(itof(load32(v + 8)))); }  # VT_I4 -> double
        else { store64(tag_data + idx * 8, load64(v + 8)); }                     # VT_R8 (or copy bits)
    } else {                                                                   # I4 tag
        store64(tag_data + idx * 8, load32(v + 8));
    } }
    return 0;
}
# copy a wide (UTF-16) string into a fresh CoTaskMemAlloc'd buffer (client frees it)
func wcopy_taskmem(w: i64) -> i64 {
    n = 0;
    while load16(w + n * 2) != 0 { n = n + 1; }
    out = CoTaskMemAlloc((n + 1) * 2);
    if out == 0 { return 0; }
    i = 0;
    while i <= n { store16(out + i * 2, load16(w + i * 2)); i = i + 1; }
    return out;
}

# ---- IClassFactory ----
func CF_QI(this: ptr, riid: ptr, ppv: ptr) -> i64 {
    if ppv == 0 { return 0x80004003; }
    store64(ppv, 0);
    if compare_guid(riid, iid_unk) == 0 { store64(ppv, this); store64(this + 8, load64(this + 8) + 1); return 0; }
    if compare_guid(riid, iid_cf) == 0  { store64(ppv, this); store64(this + 8, load64(this + 8) + 1); return 0; }
    return 0x80004002;
}
func CF_AddRef(this: ptr) -> i64 { store64(this + 8, load64(this + 8) + 1); return load64(this + 8); }
func CF_Release(this: ptr) -> i64 { store64(this + 8, load64(this + 8) - 1); return load64(this + 8); }
func CF_CreateInstance(this: ptr, outer: ptr, riid: ptr, ppv: ptr) -> i64 {
    if ppv == 0 { return 0x80004003; }
    store64(ppv, 0);
    if outer != 0 { return 0x80040110; }
    dbg(d_cfci); dbgn(load64(riid)); dbg(d_ok);
    store64(g_conns, load64(g_conns) + 1);          # show client connections on the panel
    return Srv_QI(srv_obj, riid, ppv);
}
func CF_LockServer(this: ptr, flock: i64) -> i64 { return 0; }

# ---- IOPCServer ----
func Srv_QI(this: ptr, riid: ptr, ppv: ptr) -> i64 {
    if ppv == 0 { return 0x80004003; }
    store64(ppv, 0);
    dbg(d_srvqi); dbgn(load64(riid));
    if compare_guid(riid, iid_unk) == 0    { dbg(d_ok); store64(ppv, this); Srv_AddRef(this); return 0; }
    if compare_guid(riid, iid_server) == 0 { dbg(d_ok); store64(ppv, this); Srv_AddRef(this); return 0; }
    if compare_guid(riid, iid_browse) == 0 { dbg(d_ok); store64(ppv, this + 8); Srv_AddRef(this); return 0; }   # IOPCBrowseServerAddressSpace
    if compare_guid(riid, iid_props) == 0  { dbg(d_ok); store64(ppv, this + 16); Srv_AddRef(this); return 0; }  # IOPCItemProperties
    dbg(d_no);
    return 0x80004002;
}
func Srv_AddRef(this: ptr) -> i64 { store64(this + 24, load64(this + 24) + 1); return load64(this + 24); }
func Srv_Release(this: ptr) -> i64 { n = load64(this + 24) - 1; store64(this + 24, n); if n == 0 { check_exit(); } return n; }
func Srv_AddGroup(this: ptr, szName: ptr, bActive: i64, dwReqRate: i64, hClientGroup: i64,
                  pTimeBias: ptr, pPctDeadband: ptr, dwLCID: i64,
                  phServerGroup: ptr, pRevisedRate: ptr, riid: ptr, ppUnk: ptr) -> i64 {
    dbg(d_addgrp); dbgn(bActive); dbg(d_agrate); dbgn(dwReqRate);
    dbg(d_agriid); dbgn(load64(riid)); dbg(d_agdb); dbgn(pPctDeadband); dbg(d_agtb); dbgn(pTimeBias); dbg(d_nl);
    g = VirtualAlloc(0, 2048, 0x3000, 4);
    if g == 0 { return 0x8007000E; }
    store64(g + 0, grp_im_vt);
    store64(g + 8, grp_sio_vt);
    store64(g + 16, grp_gs_vt);
    store64(g + 24, cpc_vt);
    store64(g + 32, cp_vt);
    store64(g + 40, async_vt);
    store64(g + 48, 0);                # refcnt (Grp_QI brings it to 1)
    store64(g + 56, hClientGroup);
    store64(g + 64, 0);                # callback (IOPCDataCallback*)
    store64(g + 72, 0);                # enable
    store64(g + 80, 0);                # itemCount
    # group state lives high (above the item array at g+88..; items capped in im_AddItems)
    store64(g + 1024, dwReqRate);      # dwUpdateRate (revised == requested)
    store64(g + 1032, bActive);        # group active flag
    h = load64(g_grphandle) + 1;
    store64(g_grphandle, h);
    store64(g + 1040, h);              # server group handle (for gs_GetState)
    if phServerGroup != 0 { store32(phServerGroup, h); }
    if pRevisedRate != 0 { store32(pRevisedRate, dwReqRate); }
    Srv_AddRef(srv_obj);                  # the group keeps the server alive (released in Grp_Release at refcount 0)
    ret = Grp_QI(g, riid, ppUnk);
    dbg(d_agret); dbgn(ret); dbg(d_nl);
    return ret;
}
func Srv_GetErrorString(this: ptr, hr: i64, lcid: i64, ppString: ptr) -> i64 {
    dbg(d_geterr);
    if ppString == 0 { return 0x80004003; }
    store64(ppString, widen_taskmem(d_errmsg));   # any HRESULT -> a real message (not the generic "Unspecified error")
    return 0;
}
func Srv_GetGroupByName(this: ptr, szName: ptr, riid: ptr, ppUnk: ptr) -> i64 { dbg(d_getgrp); return 0x80004001; }
func Srv_GetStatus(this: ptr, ppStatus: ptr) -> i64 {
    dbg(d_status);
    if ppStatus == 0 { return 0x80004003; }
    s = CoTaskMemAlloc(56);
    if s == 0 { return 0x8007000E; }
    GetSystemTimeAsFileTime(ft_buf);
    store64(s + 0, load64(ft_buf));
    store64(s + 8, load64(ft_buf));
    store64(s + 16, load64(ft_buf));
    store32(s + 24, 1);
    store32(s + 28, 0);
    store32(s + 32, 0);
    store16(s + 36, 2);
    store16(s + 38, 5);
    store16(s + 40, 1);
    store16(s + 42, 0);
    store64(s + 48, widen_taskmem(vendor));
    store64(ppStatus, s);
    return 0;
}
func Srv_RemoveGroup(this: ptr, hServerGroup: i64, bForce: i64) -> i64 { return 0; }
func Srv_CreateGroupEnumerator(this: ptr, dwScope: i64, riid: ptr, ppUnk: ptr) -> i64 { dbg(d_crenum); return 0x80004001; }

# ---- group object (multi-interface) ----
func Grp_QI(base: ptr, riid: ptr, ppv: ptr) -> i64 {
    if ppv == 0 { return 0x80004003; }
    store64(ppv, 0);
    dbg(d_grpqi); dbgn(load64(riid));
    if compare_guid(riid, iid_unk) == 0     { dbg(d_ok); store64(ppv, base + 0);  store64(base + 48, load64(base + 48) + 1); return 0; }
    if compare_guid(riid, iid_itemmgt) == 0 { dbg(d_ok); store64(ppv, base + 0);  store64(base + 48, load64(base + 48) + 1); return 0; }
    if compare_guid(riid, iid_syncio) == 0  { dbg(d_ok); store64(ppv, base + 8);  store64(base + 48, load64(base + 48) + 1); return 0; }
    if compare_guid(riid, iid_groupst) == 0 { dbg(d_ok); store64(ppv, base + 16); store64(base + 48, load64(base + 48) + 1); return 0; }
    if compare_guid(riid, iid_cpc) == 0     { dbg(d_ok); store64(ppv, base + 24); store64(base + 48, load64(base + 48) + 1); return 0; }   # IConnectionPointContainer
    if compare_guid(riid, iid_cp) == 0      { dbg(d_ok); store64(ppv, base + 32); store64(base + 48, load64(base + 48) + 1); return 0; }   # IConnectionPoint
    if compare_guid(riid, iid_async) == 0   { dbg(d_ok); store64(ppv, base + 40); store64(base + 48, load64(base + 48) + 1); return 0; }   # IOPCAsyncIO2
    dbg(d_no);
    return 0x80004002;
}
func Grp_AddRef(base: ptr) -> i64 { store64(base + 48, load64(base + 48) + 1); return load64(base + 48); }
func Grp_Release(base: ptr) -> i64 {
    n = load64(base + 48) - 1;
    store64(base + 48, n);
    if n == 0 { Srv_Release(srv_obj); }     # group destroyed -> drop the server ref it took in AddGroup
    return n;
}

func im_QI(this: ptr, riid: ptr, ppv: ptr) -> i64 { return Grp_QI(this, riid, ppv); }
func im_AddRef(this: ptr) -> i64 { return Grp_AddRef(this); }
func im_Release(this: ptr) -> i64 { return Grp_Release(this); }
func im_AddItems(this: ptr, dwCount: i64, pItemArray: ptr, ppResults: ptr, ppErrors: ptr) -> i64 {
    dbg(d_addit);
    g = this;
    results = CoTaskMemAlloc(dwCount * 24);
    errors = CoTaskMemAlloc(dwCount * 4);
    if results == 0 { return 0x8007000E; }
    if errors == 0 { return 0x8007000E; }
    anyfail = 0;
    i = 0;
    while i < dwCount {
        def = pItemArray + i * 48;
        wItem = load64(def + 8);
        hClient = load32(def + 20);
        idx = tag_match(wItem);
        res = results + i * 24;
        err = errors + i * 4;
        if idx < 0 {
            store32(res + 0, 0); store16(res + 4, 0); store16(res + 6, 0);
            store32(res + 8, 0); store32(res + 12, 0); store64(res + 16, 0);
            store32(err, 0xC0040007);
            anyfail = 1;
        } else {
            ic = load64(g + 80);
            if ic >= 58 {                                       # protect group-state fields at g+1024
                store32(res + 0, 0); store16(res + 4, 0); store16(res + 6, 0);
                store32(res + 8, 0); store32(res + 12, 0); store64(res + 16, 0);
                store32(err, 0x8007000E); anyfail = 1;
            } else {
                slot = g + 88 + ic * 16;
                store64(slot, idx);
                store64(slot + 8, hClient);
                store64(g + 80, ic + 1);
                store32(res + 0, ic + 1);
                store16(res + 4, tag_vt(idx));
                store16(res + 6, 0);
                store32(res + 8, tag_access(idx));
                store32(res + 12, 0);
                store64(res + 16, 0);
                store32(err, 0);
            }
        }
        i = i + 1;
    }
    store64(ppResults, results);
    store64(ppErrors, errors);
    if anyfail == 1 { return 1; }
    return 0;
}
# Validate item IDs WITHOUT adding them (hServer=0). dOPC calls this before AddItems.
func im_ValidateItems(this: ptr, dwCount: i64, pItemArray: ptr, bBlobUpdate: i64, ppResults: ptr, ppErrors: ptr) -> i64 {
    dbg(d_valid);
    results = CoTaskMemAlloc(dwCount * 24);
    errors = CoTaskMemAlloc(dwCount * 4);
    if results == 0 { return 0x8007000E; }
    if errors == 0 { return 0x8007000E; }
    anyfail = 0;
    i = 0;
    while i < dwCount {
        def = pItemArray + i * 48;
        wItem = load64(def + 8);
        idx = tag_match(wItem);
        res = results + i * 24;
        err = errors + i * 4;
        store32(res + 0, 0); store16(res + 6, 0); store32(res + 12, 0); store64(res + 16, 0);
        if idx < 0 {
            store16(res + 4, 0); store32(res + 8, 0);
            store32(err, 0xC0040007); anyfail = 1;
        } else {
            store16(res + 4, tag_vt(idx)); store32(res + 8, tag_access(idx)); store32(err, 0);
        }
        i = i + 1;
    }
    store64(ppResults, results);
    store64(ppErrors, errors);
    if anyfail == 1 { return 1; }
    return 0;
}
func im_RemoveItems(this: ptr, dwCount: i64, phServer: ptr, ppErrors: ptr) -> i64 {
    errors = CoTaskMemAlloc(dwCount * 4);
    if errors == 0 { return 0x8007000E; }
    i = 0; while i < dwCount { store32(errors + i * 4, 0); i = i + 1; }   # accept (group is freed on disconnect)
    store64(ppErrors, errors);
    return 0;
}
# Activate items for monitoring. The sim pushes ALL items, so accept all as S_OK.
func im_SetActiveState(this: ptr, dwCount: i64, phServer: ptr, bActive: i64, ppErrors: ptr) -> i64 {
    dbg(d_setact); dbgn(bActive); dbg(d_nl);
    errors = CoTaskMemAlloc(dwCount * 4);
    if errors == 0 { return 0x8007000E; }
    i = 0; while i < dwCount { store32(errors + i * 4, 0); i = i + 1; }
    store64(ppErrors, errors);
    return 0;
}
# Update each item's client handle (used in the OnDataChange push as phClientItems).
func im_SetClientHandles(this: ptr, dwCount: i64, phServer: ptr, phClient: ptr, ppErrors: ptr) -> i64 {
    dbg(d_setch);
    g = this;
    ic = load64(g + 80);
    errors = CoTaskMemAlloc(dwCount * 4);
    if errors == 0 { return 0x8007000E; }
    i = 0;
    while i < dwCount {
        h = load32(phServer + i * 4);
        if h >= 1 { if h <= ic { store64(g + 88 + (h - 1) * 16 + 8, load32(phClient + i * 4)); } }
        store32(errors + i * 4, 0);
        i = i + 1;
    }
    store64(ppErrors, errors);
    return 0;
}
func im_SetDatatypes(this: ptr, c: i64, p: ptr, pv: ptr, pe: ptr) -> i64 { return 0x80004001; }
func im_CreateEnumerator(this: ptr, riid: ptr, ppUnk: ptr) -> i64 { return 0x80004001; }

func sio_QI(this: ptr, riid: ptr, ppv: ptr) -> i64 { return Grp_QI(this - 8, riid, ppv); }
func sio_AddRef(this: ptr) -> i64 { return Grp_AddRef(this - 8); }
func sio_Release(this: ptr) -> i64 { return Grp_Release(this - 8); }
func sio_Read(this: ptr, dwSource: i64, dwCount: i64, phServer: ptr, ppValues: ptr, ppErrors: ptr) -> i64 {
    dbg(d_read);
    g = this - 8;
    values = CoTaskMemAlloc(dwCount * 40);    # OPCITEMSTATE is 40 bytes on x64 (embeds a 24-byte VARIANT @ +16), NOT 32
    errors = CoTaskMemAlloc(dwCount * 4);
    if values == 0 { return 0x8007000E; }
    if errors == 0 { return 0x8007000E; }
    GetSystemTimeAsFileTime(ft_buf);
    ftlo = load32(ft_buf + 0);
    fthi = load32(ft_buf + 4);
    ic = load64(g + 80);
    i = 0;
    while i < dwCount {
        h = load32(phServer + i * 4);
        st = values + i * 40;
        err = errors + i * 4;
        store16(st + 18, 0); store16(st + 20, 0); store16(st + 22, 0);
        if h < 1 {
            store32(st + 0, 0); store32(st + 4, 0); store32(st + 8, 0);
            store16(st + 12, 0); store16(st + 14, 0); store16(st + 16, 0); store64(st + 24, 0);
            store32(err, 0xC0040007);
        } else {
            if h > ic {
                store32(st + 0, 0); store32(st + 4, 0); store32(st + 8, 0);
                store16(st + 12, 0); store16(st + 14, 0); store16(st + 16, 0); store64(st + 24, 0);
                store32(err, 0xC0040007);
            } else {
                slot = g + 88 + (h - 1) * 16;
                idx = load64(slot);
                hClient = load64(slot + 8);
                store32(st + 0, hClient);
                store32(st + 4, ftlo); store32(st + 8, fthi);
                store16(st + 12, 192);
                store16(st + 14, 0);
                fill_variant(st + 16, idx);          # VARIANT @ st+16 (vt + value, any tag type)
                store32(err, 0);
            }
        }
        i = i + 1;
    }
    store64(ppValues, values);
    store64(ppErrors, errors);
    return 0;
}
func sio_Write(this: ptr, dwCount: i64, phServer: ptr, pItemValues: ptr, ppErrors: ptr) -> i64 {
    g = this - 8;
    ic = load64(g + 80);
    errors = CoTaskMemAlloc(dwCount * 4);
    if errors == 0 { return 0x8007000E; }
    anyfail = 0;
    i = 0;
    while i < dwCount {
        h = load32(phServer + i * 4);
        v = pItemValues + i * 24;                  # VARIANT array (24 bytes each on x64)
        err = errors + i * 4;
        dbg(d_write); dbgn(h);
        if h < 1 { store32(err, 0xC0040007); anyfail = 1; dbg(d_nl); }       # OPC_E_INVALIDHANDLE
        else { if h > ic { store32(err, 0xC0040007); anyfail = 1; dbg(d_nl); }
        else {
            slot = g + 88 + (h - 1) * 16;
            idx = load64(slot);
            dbg(d_wval); dbgn(idx); dbg(d_nl);
            if band(tag_access(idx), 2) == 0 { store32(err, 0xC0040004); anyfail = 1; }   # OPC_E_BADRIGHTS (read-only)
            else { write_tag(idx, v); store32(err, 0); }
        } }
        i = i + 1;
    }
    store64(ppErrors, errors);
    if anyfail == 1 { return 1; }                  # S_FALSE (one or more failed)
    return 0;
}

func gs_QI(this: ptr, riid: ptr, ppv: ptr) -> i64 { return Grp_QI(this - 16, riid, ppv); }
func gs_AddRef(this: ptr) -> i64 { return Grp_AddRef(this - 16); }
func gs_Release(this: ptr) -> i64 { return Grp_Release(this - 16); }
# IOPCGroupStateMgt::GetState — 8 [out] params. Report the group's stored rate/active/handles.
func gs_GetState(this: ptr, pUpdateRate: ptr, pActive: ptr, ppName: ptr, pTimeBias: ptr, pDeadband: ptr, pLCID: ptr, phClientGroup: ptr, phServerGroup: ptr) -> i64 {
    dbg(d_gsget);
    g = this - 16;
    if pUpdateRate != 0 { store32(pUpdateRate, load64(g + 1024)); }
    if pActive != 0 { store32(pActive, load64(g + 1032)); }
    if ppName != 0 { store64(ppName, widen_taskmem(s_grpname)); }
    if pTimeBias != 0 { store32(pTimeBias, 0); }
    if pDeadband != 0 { store32(pDeadband, 0); }                    # FLOAT 0.0
    if pLCID != 0 { store32(pLCID, 0); }
    if phClientGroup != 0 { store32(phClientGroup, load64(g + 56)); }
    if phServerGroup != 0 { store32(phServerGroup, load64(g + 1040)); }
    return 0;
}
# IOPCGroupStateMgt::SetState — 7 params. Honor the requested update rate + active flag.
func gs_SetState(this: ptr, pReqRate: ptr, pRevRate: ptr, pActive: ptr, pTimeBias: ptr, pDeadband: ptr, pLCID: ptr, phClientGroup: ptr) -> i64 {
    g = this - 16;
    rate = load64(g + 1024);
    if pReqRate != 0 { rate = load32(pReqRate); store64(g + 1024, rate); }
    if pActive != 0 { store64(g + 1032, load32(pActive)); }
    if phClientGroup != 0 { store64(g + 56, load32(phClientGroup)); }
    if pRevRate != 0 { store32(pRevRate, rate); }                   # revised == requested (we honor it)
    dbg(d_gsset); dbgn(rate); dbg(d_nl);
    return 0;
}
func gs_SetName(this: ptr, sz: ptr) -> i64 { return 0x80004001; }
func gs_CloneGroup(this: ptr, sz: ptr, riid: ptr, ppUnk: ptr) -> i64 { return 0x80004001; }

# ---- IOPCBrowseServerAddressSpace (2nd interface on the server object: this = srv_obj+8) ----
func brw_QI(this: ptr, riid: ptr, ppv: ptr) -> i64 { return Srv_QI(this - 8, riid, ppv); }
func brw_AddRef(this: ptr) -> i64 { return Srv_AddRef(this - 8); }
func brw_Release(this: ptr) -> i64 { return Srv_Release(this - 8); }
func brw_QueryOrganization(this: ptr, pType: ptr) -> i64 { dbg(d_qorg); if pType != 0 { store32(pType, 2); } return 0; }  # OPC_NS_FLAT
func brw_ChangeBrowsePosition(this: ptr, dir: i64, sz: ptr) -> i64 { return 0; }
func brw_BrowseOPCItemIDs(this: ptr, filterType: i64, szFilter: ptr, vtFilter: i64, accessFilter: i64, ppEnum: ptr) -> i64 {
    dbg(d_bids); dbgn(filterType); dbg(d_nl);
    if ppEnum == 0 { return 0x80004003; }
    store64(ppEnum, 0);
    e = VirtualAlloc(0, 64, 0x3000, 4);
    if e == 0 { return 0x8007000E; }
    store64(e + 0, enum_vt);
    store64(e + 8, 1);                  # refcnt (client owns this ref)
    store64(e + 16, 0);                 # position
    if filterType == 1 { store64(e + 24, 0); } else { store64(e + 24, 5); }   # OPC_BRANCH -> none; LEAF/FLAT -> 5 tags
    store64(ppEnum, e);
    return 0;
}
func brw_GetItemID(this: ptr, szItemDataID: ptr, ppItemID: ptr) -> i64 {
    dbg(d_gid);
    if ppItemID == 0 { return 0x80004003; }
    store64(ppItemID, wcopy_taskmem(szItemDataID));   # flat namespace: fully-qualified id == the browse name
    return 0;
}
func brw_BrowseAccessPaths(this: ptr, szItemID: ptr, ppEnum: ptr) -> i64 { dbg(d_bap); return 0x80004001; }

# ---- IEnumString (item-id enumerator); layout [vt][refcnt][pos][count] ----
func es_QI(this: ptr, riid: ptr, ppv: ptr) -> i64 {
    if ppv == 0 { return 0x80004003; }
    store64(ppv, 0);
    if compare_guid(riid, iid_unk) == 0     { store64(ppv, this); store64(this + 8, load64(this + 8) + 1); return 0; }
    if compare_guid(riid, iid_enumstr) == 0 { store64(ppv, this); store64(this + 8, load64(this + 8) + 1); return 0; }
    return 0x80004002;
}
func es_AddRef(this: ptr) -> i64 { store64(this + 8, load64(this + 8) + 1); return load64(this + 8); }
func es_Release(this: ptr) -> i64 { store64(this + 8, load64(this + 8) - 1); return load64(this + 8); }
func es_Next(this: ptr, celt: i64, rgelt: ptr, pceltFetched: ptr) -> i64 {
    pos = load64(this + 16);
    cnt = load64(this + 24);
    fetched = 0;
    while fetched < celt {
        if pos >= cnt { break; }
        store64(rgelt + fetched * 8, widen_taskmem(tag_id(pos)));   # client frees each LPOLESTR
        pos = pos + 1;
        fetched = fetched + 1;
    }
    store64(this + 16, pos);
    dbg(d_next); dbgn(celt); dbg(d_fetch); dbgn(fetched); dbg(d_nl);
    if pceltFetched != 0 { store32(pceltFetched, fetched); }
    if fetched == celt { return 0; }
    return 1;                          # S_FALSE (fewer than requested)
}
func es_Skip(this: ptr, celt: i64) -> i64 {
    pos = load64(this + 16) + celt;
    cnt = load64(this + 24);
    if pos > cnt { store64(this + 16, cnt); return 1; }
    store64(this + 16, pos);
    return 0;
}
func es_Reset(this: ptr) -> i64 { store64(this + 16, 0); return 0; }
func es_Clone(this: ptr, ppenum: ptr) -> i64 {
    if ppenum == 0 { return 0x80004003; }
    e = VirtualAlloc(0, 64, 0x3000, 4);
    if e == 0 { return 0x8007000E; }
    store64(e + 0, enum_vt);
    store64(e + 8, 1);
    store64(e + 16, load64(this + 16));
    store64(e + 24, load64(this + 24));
    store64(ppenum, e);
    return 0;
}

# ---- IOPCItemProperties (3rd interface on the server object: this = srv_obj+16) ----
func prop_QI(this: ptr, riid: ptr, ppv: ptr) -> i64 { return Srv_QI(this - 16, riid, ppv); }
func prop_AddRef(this: ptr) -> i64 { return Srv_AddRef(this - 16); }
func prop_Release(this: ptr) -> i64 { return Srv_Release(this - 16); }
func prop_QueryAvailableProperties(this: ptr, szItemID: ptr, pdwCount: ptr, ppPropIDs: ptr, ppDescs: ptr, ppvtTypes: ptr) -> i64 {
    dbg(d_qap);
    idx = tag_match(szItemID);
    if idx < 0 { return 0xC0040007; }                 # OPC_E_UNKNOWNITEMID
    ids = CoTaskMemAlloc(4 * 4);
    descs = CoTaskMemAlloc(4 * 8);
    vts = CoTaskMemAlloc(4 * 2);
    if ids == 0 { return 0x8007000E; }
    store32(ids + 0, 1); store32(ids + 4, 2); store32(ids + 8, 3); store32(ids + 12, 5);   # DataType, Value, Quality, AccessRights
    store64(descs + 0,  widen_taskmem(pd_dt));
    store64(descs + 8,  widen_taskmem(pd_val));
    store64(descs + 16, widen_taskmem(pd_q));
    store64(descs + 24, widen_taskmem(pd_ar));
    store16(vts + 0, 2);                # prop1 DataType -> VT_I2
    store16(vts + 2, tag_vt(idx));      # prop2 Value -> tag canonical type
    store16(vts + 4, 2);               # prop3 Quality -> VT_I2
    store16(vts + 6, 3);               # prop5 AccessRights -> VT_I4
    store32(pdwCount, 4);
    store64(ppPropIDs, ids);
    store64(ppDescs, descs);
    store64(ppvtTypes, vts);
    return 0;
}
func prop_GetItemProperties(this: ptr, szItemID: ptr, dwCount: i64, pdwPropIDs: ptr, ppvData: ptr, ppErrors: ptr) -> i64 {
    dbg(d_gip);
    idx = tag_match(szItemID);
    vdata = CoTaskMemAlloc(dwCount * 24);          # VARIANT is 24 bytes on x64 (vt@0, data@8), NOT 16
    errs = CoTaskMemAlloc(dwCount * 4);
    if vdata == 0 { return 0x8007000E; }
    if errs == 0 { return 0x8007000E; }
    i = 0;
    while i < dwCount {
        pid = load32(pdwPropIDs + i * 4);
        v = vdata + i * 24;
        store64(v + 0, 0); store64(v + 8, 0); store64(v + 16, 0);   # clear the full 24-byte VARIANT
        e = errs + i * 4;
        if idx < 0 {
            store32(e, 0xC0040007);
        } else {
            if pid == 1 { store16(v + 0, 2); store16(v + 8, tag_vt(idx)); store32(e, 0); }            # canonical datatype (VT_I2)
            else { if pid == 2 {
                       fill_variant(v, idx);                                                            # value (canonical type, any tag)
                       store32(e, 0);
                   } else { if pid == 3 { store16(v + 0, 2); store16(v + 8, 192); store32(e, 0); }      # quality VT_I2 = GOOD
                   else { if pid == 5 { store16(v + 0, 3); store32(v + 8, tag_access(idx)); store32(e, 0); }   # access rights VT_I4
                   else { store32(e, 0xC0040004); } } }                                                 # OPC_E_INVALIDPID
            }
        }
        i = i + 1;
    }
    store64(ppvData, vdata);
    store64(ppErrors, errs);
    return 0;
}
func prop_LookupItemIDs(this: ptr, szItemID: ptr, dwCount: i64, pdwPropIDs: ptr, ppNewIDs: ptr, ppErrors: ptr) -> i64 { return 0x80004001; }

# ---- IConnectionPointContainer (group +24) ----
func cpc_QI(this: ptr, riid: ptr, ppv: ptr) -> i64 { return Grp_QI(this - 24, riid, ppv); }
func cpc_AddRef(this: ptr) -> i64 { return Grp_AddRef(this - 24); }
func cpc_Release(this: ptr) -> i64 { return Grp_Release(this - 24); }
func cpc_EnumConnectionPoints(this: ptr, ppEnum: ptr) -> i64 { return 0x80004001; }
func cpc_FindConnectionPoint(this: ptr, riid: ptr, ppCP: ptr) -> i64 {
    dbg(d_fcp);
    base = this - 24;
    if ppCP == 0 { return 0x80004003; }
    store64(ppCP, 0);
    if compare_guid(riid, iid_datacb) == 0 { store64(ppCP, base + 32); Grp_AddRef(base); return 0; }   # the group's IConnectionPoint
    return 0x80040200;   # CONNECT_E_NOCONNECTION
}

# ---- IConnectionPoint (group +32); sink = client's IOPCDataCallback ----
func cp_QI(this: ptr, riid: ptr, ppv: ptr) -> i64 { return Grp_QI(this - 32, riid, ppv); }
func cp_AddRef(this: ptr) -> i64 { return Grp_AddRef(this - 32); }
func cp_Release(this: ptr) -> i64 { return Grp_Release(this - 32); }
func cp_GetConnectionInterface(this: ptr, pIID: ptr) -> i64 {
    store64(pIID + 0, load64(iid_datacb + 0)); store64(pIID + 8, load64(iid_datacb + 8));
    return 0;
}
func cp_GetConnectionPointContainer(this: ptr, ppCPC: ptr) -> i64 {
    base = this - 32;
    store64(ppCPC, base + 24); Grp_AddRef(base);
    return 0;
}
func cp_Advise(this: ptr, pUnkSink: ptr, pdwCookie: ptr) -> i64 {
    dbg(d_adv);
    base = this - 32;
    store64(g_qitmp, 0);
    callp(vmeth(pUnkSink, 0), pUnkSink, iid_datacb, g_qitmp);   # pUnkSink->QueryInterface(IID_IOPCDataCallback)
    cb = load64(g_qitmp);
    if cb == 0 { return 0x80040202; }                          # CONNECT_E_CANNOTCONNECT
    # Register in the GIT: the client's sink lives in ITS apartment (dOPC = STA). The pump thread
    # must get a thread-valid proxy per call; a raw cross-apartment pointer call never delivers.
    git = load64(g_git);
    store64(g_cookietmp, 0);
    hr = callp(vmeth(git, 3), git, cb, iid_datacb, g_cookietmp);   # IGlobalInterfaceTable::RegisterInterfaceInGlobal
    callp(vmeth(cb, 2), cb);                                    # release our QI ref (GIT keeps its own)
    if hr != 0 { return 0x80040202; }
    store64(base + 64, load64(g_cookietmp));                    # store the GIT cookie (NOT the raw pointer)
    store64(base + 72, 1);                                      # enabled
    store64(g_sub_group, base);                                 # pump pushes OnDataChange to this group
    if pdwCookie != 0 { store32(pdwCookie, 1); }
    return 0;
}
func cp_Unadvise(this: ptr, dwCookie: i64) -> i64 {
    base = this - 32;
    cookie = load64(base + 64);
    if cookie != 0 {
        git = load64(g_git);
        callp(vmeth(git, 4), git, cookie);                     # IGlobalInterfaceTable::RevokeInterfaceFromGlobal
    }
    store64(base + 64, 0);
    store64(base + 72, 0);
    store64(g_sub_group, 0);
    return 0;
}
func cp_EnumConnections(this: ptr, ppEnum: ptr) -> i64 { return 0x80004001; }

# ---- push current values to the subscribed client. Called from the PUMP (our timer
#      thread), never synchronously inside a client call -> no STA reentrancy/deadlock. ----
func push_datachange(group: i64, transid: i64) -> i64 {
    cookie = load64(group + 64);
    if cookie == 0 { return 0; }
    if load64(group + 72) == 0 { return 0; }                   # not enabled
    ic = load64(group + 80);
    if ic == 0 { return 0; }
    if ic > 16 { ic = 16; }
    # get a proxy valid on THIS (pump) thread from the GIT
    git = load64(g_git);
    store64(g_cbtmp, 0);
    callp(vmeth(git, 5), git, cookie, iid_datacb, g_cbtmp);    # IGlobalInterfaceTable::GetInterfaceFromGlobal
    cb = load64(g_cbtmp);
    if cb == 0 { return 0; }
    GetSystemTimeAsFileTime(ft_buf);
    ftlo = load32(ft_buf + 0);
    fthi = load32(ft_buf + 4);
    i = 0;
    while i < ic {
        slot = group + 88 + i * 16;
        idx = load64(slot);
        hc = load64(slot + 8);
        store32(g_cb_h + i * 4, hc);                            # phClientItems
        fill_variant(g_cb_v + i * 24, idx);                     # pvValues (VARIANT, 24B on x64, any tag type)
        store16(g_cb_q + i * 2, 192);                           # pwQualities = GOOD
        store32(g_cb_t + i * 8, ftlo); store32(g_cb_t + i * 8 + 4, fthi);   # pftTimeStamps
        store32(g_cb_e + i * 4, 0);                             # pErrors = S_OK
        i = i + 1;
    }
    hr = callp(vmeth(cb, 3), cb, transid, load64(group + 56), 0, 0, ic, g_cb_h, g_cb_v, g_cb_q, g_cb_t, g_cb_e);   # OnDataChange
    callp(vmeth(cb, 2), cb);                                   # release the per-call GIT proxy
    dbg(d_push); dbgn(ic); dbg(d_pushhr); dbgn(hr); dbg(d_nl);
    return 0;
}

# ---- IOPCAsyncIO2 (group +40) ----
func async_QI(this: ptr, riid: ptr, ppv: ptr) -> i64 { return Grp_QI(this - 40, riid, ppv); }
func async_AddRef(this: ptr) -> i64 { return Grp_AddRef(this - 40); }
func async_Release(this: ptr) -> i64 { return Grp_Release(this - 40); }
func async_Read(this: ptr, dwCount: i64, phServer: ptr, transid: i64, pdwCancelID: ptr, ppErrors: ptr) -> i64 {
    errs = CoTaskMemAlloc(dwCount * 4);
    if errs == 0 { return 0x8007000E; }
    i = 0; while i < dwCount { store32(errs + i * 4, 0); i = i + 1; }
    store64(ppErrors, errs);
    if pdwCancelID != 0 { store32(pdwCancelID, 1); }
    return 0;                                                   # data arrives via the periodic OnDataChange push
}
func async_Write(this: ptr, dwCount: i64, phServer: ptr, pItemValues: ptr, transid: i64, pdwCancelID: ptr, ppErrors: ptr) -> i64 { return 0x80004001; }
func async_Refresh2(this: ptr, dwSource: i64, transid: i64, pdwCancelID: ptr) -> i64 {
    if pdwCancelID != 0 { store32(pdwCancelID, 1); }
    return 0;                                                   # initial values arrive on the next pump tick (avoids STA reentrancy)
}
func async_Cancel2(this: ptr, dwCancelID: i64) -> i64 { return 0; }
func async_SetEnable(this: ptr, bEnable: i64) -> i64 { dbg(d_sete); base = this - 40; store64(base + 72, bEnable); return 0; }
func async_GetEnable(this: ptr, pbEnable: ptr) -> i64 { base = this - 40; store32(pbEnable, load64(base + 72)); return 0; }

