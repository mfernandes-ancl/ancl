# =====================================================================
#  opc_da_server.ancl  -  REAL OPC DA 2.05 COM server + Win32 control GUI
#
#  ONE program that is BOTH:
#    * a genuine OPC DA server (IClassFactory -> IOPCServer ->
#      IOPCItemMgt::AddItems + IOPCSyncIO::Read, QI-able to
#      IOPCGroupStateMgt) an OPC client tester can CoCreateInstance + read, AND
#    * a control panel: Start/Stop the auto data-pump, hand-edit each tag,
#      watch values live + a "clients connected" counter.
#
#  Tags (served from tag_data):
#    "Substation.Status"     VT_I4   "Substation.Frequency"  VT_R8
#    "Substation.Voltage"    VT_R8
#  CLSID {00112233-4455-6677-8899-AABBCCDDEEFF}  ProgID ANCL.OPCDASim.1
#
#  COM runs in the MTA (client calls serviced on COM RPC threads); the main
#  thread runs the GUI message loop; a WM_TIMER tick drives the pump. Register
#  with opc_da_register.reg (admin) so OpcEnum lists it + clients bind by ProgID.
#  Build: bin\anclc.exe showcase\opc_da_simulator\opc_da_server.ancl showcase\opc_da_simulator\opc_da_server.exe
# =====================================================================

@DATA
# ---- GUIDs ----
clsid:        buf = 16;
iid_unk:      buf = 16;
iid_server:   buf = 16;   # IID_IOPCServer        {39C13A4D-...}
iid_itemmgt:  buf = 16;   # IID_IOPCItemMgt       {39C13A54-...}
iid_syncio:   buf = 16;   # IID_IOPCSyncIO        {39C13A52-...}
iid_groupst:  buf = 16;   # IID_IOPCGroupStateMgt {39C13A50-...}
iid_cf:       buf = 16;   # IID_IClassFactory     {00000001-...}
iid_browse:   buf = 16;   # IID_IOPCBrowseServerAddressSpace {39C13A4F-...}
iid_enumstr:  buf = 16;   # IID_IEnumString {00000101-...}
iid_props:    buf = 16;   # IID_IOPCItemProperties {39C13A72-...}
iid_cpc:      buf = 16;   # IID_IConnectionPointContainer {B196B284-...}
iid_cp:       buf = 16;   # IID_IConnectionPoint {B196B286-...}
iid_async:    buf = 16;   # IID_IOPCAsyncIO2 {39C13A71-...}
iid_datacb:   buf = 16;   # IID_IOPCDataCallback {39C13A70-...}  (client implements; we call it)

# ---- COM vtables (shared) + singletons ----
cf_vt:     buf = 40;
srv_vt:    buf = 72;
grp_im_vt: buf = 80;
grp_sio_vt:buf = 40;
grp_gs_vt: buf = 56;
brw_vt:    buf = 64;       # IOPCBrowseServerAddressSpace (8)
enum_vt:   buf = 56;       # IEnumString (7)
prop_vt:   buf = 48;       # IOPCItemProperties (6)
cpc_vt:    buf = 40;       # IConnectionPointContainer (5)
cp_vt:     buf = 56;       # IConnectionPoint (7)
async_vt:  buf = 72;       # IOPCAsyncIO2 (9)
cf_obj:    buf = 16;
srv_obj:   buf = 32;       # [vtbl_server][vtbl_browse][vtbl_props][refcnt]
cookie:    buf = 8;
g_grphandle: buf = 8;

# ---- live tag data: +0 status(i64) +8 freq(f64 bits) +16 volt(f64 bits) ----
tag_data:  buf = 40;       # +0 status(i64,I4) +8 freq(f64) +16 volt(f64) +24 breaker(i64,BOOL) +32 setpoint(f64) -- last 2 are WRITABLE
ft_buf:    buf = 16;

# ---- async subscription state (one subscribed group; pump pushes OnDataChange) ----
g_sub_group: buf = 8;      # group ptr with an active data subscription (0 = none)
g_qitmp:     buf = 8;      # scratch for QI out-param
g_cb_h: buf = 128;         # OnDataChange [in] arrays, sized for <=16 items
g_cb_v: buf = 384;         # 16 VARIANTs * 24 bytes (x64)
g_cb_q: buf = 64;
g_cb_t: buf = 256;
g_cb_e: buf = 128;
# ---- Global Interface Table: marshal the client's STA callback so the MTA pump thread can call it ----
git_clsid:  buf = 16;      # CLSID_StdGlobalInterfaceTable
git_iid:    buf = 16;      # IID_IGlobalInterfaceTable
g_git:      buf = 8;       # IGlobalInterfaceTable*
g_cbtmp:    buf = 8;       # scratch: GetInterfaceFromGlobal out
g_cookietmp:buf = 8;       # scratch: RegisterInterfaceInGlobal cookie out

# ---- tag ids + vendor ----
t_status: str = "Substation.Status";
t_freq:   str = "Substation.Frequency";
t_volt:   str = "Substation.Voltage";
t_breaker: str = "Substation.Breaker";      # VT_BOOL, writable
t_setpoint:str = "Substation.Setpoint";     # VT_R8, writable
vendor:   str = "ANCL OPC DA Simulator";

# ---- GUI strings ----
clsname:  str = "ANCLOPCDAWND";
title:    str = "ANCL OPC DA Simulator - live COM server + control panel";
cls_stat: str = "STATIC";
cls_btn:  str = "BUTTON";
cls_edit: str = "EDIT";
txt_hdr:  str = "OPC DA COM Server LIVE  -  ProgID ANCL.OPCDASim.1   CLSID {00112233-...-AABBCCDDEEFF}";
txt_sub:  str = "A client can CoCreateInstance + AddGroup + AddItems(Substation.Status/Frequency/Voltage) + Read.";
lbl_st:   str = "Substation_Status:";
lbl_fr:   str = "Frequency_Hz (e.g. 50.00):";
lbl_vl:   str = "Voltage_kV (e.g. 220.00):";
txt_set:  str = "Set";
txt_start:str = "Start Auto";
txt_stop: str = "Stop Auto";
dash:     str = "----";
s_opc:    str = "OPC server: registered     Auto: ";
s_run:    str = "RUNNING";
s_stop:   str = "STOPPED";
s_conns:  str = "     Clients connected: ";
s_cyc:    str = "Cycle: ";

# ---- GUI handles / structs ----
g_hinst:    buf = 8;
g_hwnd:     buf = 8;
g_wndclass: buf = 96;
g_msg:      buf = 64;
g_lbl_st:   buf = 8;
g_lbl_fr:   buf = 8;
g_lbl_vl:   buf = 8;
g_lbl_cyc:  buf = 8;
g_hstatus:  buf = 8;
g_ed_st:    buf = 8;
g_ed_fr:    buf = 8;
g_ed_vl:    buf = 8;

# ---- simulator state ----
g_running: buf = 8;
g_counter: buf = 8;
g_cycle:   buf = 8;
g_st:      buf = 8;     # status bitmask
g_fi:      buf = 8;     # frequency centi-Hz
g_vi:      buf = 8;     # voltage centi-kV
g_conns:   buf = 8;     # client CreateInstance count

# ---- scratch ----
g_buf:       buf = 64;
g_inbuf:     buf = 64;
g_statusbuf: buf = 192;
g_cyclebuf:  buf = 48;

# ---- self-registration (Register/Unregister buttons + /regserver CLI) ----
g_phk:     buf = 8;        # HKEY out from RegCreateKeyExA
g_exepath: buf = 528;      # this exe's own path -> LocalServer32
g_lbl_reg: buf = 8;        # reg-status label HWND
txt_reg:   str = "Register";
txt_unreg: str = "Unregister";
rs_idle:   str = "(not registered yet - click Register)";
rs_hklm:   str = "Registered: machine-wide (HKLM) - discoverable via OpcEnum";
rs_hkcu:   str = "Registered: per-user (HKCU) - run elevated for the OpcEnum list";
rs_fail:   str = "Register FAILED";
rs_unreg:  str = "Unregistered";
s_reg_arg:   str = "regserver";
s_unreg_arg: str = "unregserver";
s_embed_arg: str = "Embedding";    # COM passes /Embedding when it launches us for a client
g_embedding: buf = 8;              # 1 = COM-launched (auto-close when client done); 0 = user-launched (persistent)
# value data
v_friendly: str = "ANCL OPC DA Simulator";
v_clsidstr: str = "{00112233-4455-6677-8899-AABBCCDDEEFF}";
v_progidstr:str = "ANCL.OPCDASim.1";
# subkey paths (under HKLM or HKCU); "\\" -> one backslash (verified)
rk_progid:       str = "Software\\Classes\\ANCL.OPCDASim.1";
rk_progid_clsid: str = "Software\\Classes\\ANCL.OPCDASim.1\\CLSID";
rk_clsid:        str = "Software\\Classes\\CLSID\\{00112233-4455-6677-8899-AABBCCDDEEFF}";
rk_clsid_progid: str = "Software\\Classes\\CLSID\\{00112233-4455-6677-8899-AABBCCDDEEFF}\\ProgID";
rk_clsid_ls32:   str = "Software\\Classes\\CLSID\\{00112233-4455-6677-8899-AABBCCDDEEFF}\\LocalServer32";
rk_clsid_cat:    str = "Software\\Classes\\CLSID\\{00112233-4455-6677-8899-AABBCCDDEEFF}\\Implemented Categories\\{63D5F432-CFE4-11D1-B2C8-0060083BA1FB}";

# ---- debug log (diagnose client connect sequence) ----
logpath:  str = "opc_da_server.log";
g_nio:    buf = 8;
g_logbuf: buf = 32;
d_boot:   str = "=== server boot ===\n";
d_cfci:   str = "CF_CreateInstance riid0=";
d_srvqi:  str = "Srv_QI iid0=";
d_ok:     str = "  OK\n";
d_no:     str = "  E_NOINTERFACE\n";
d_status: str = "Srv_GetStatus\n";
d_addgrp: str = "Srv_AddGroup active=";
d_agrate: str = " rate=";
d_agriid: str = " riid=";
d_agdb:   str = " dbPtr=";
d_agtb:   str = " tbPtr=";
d_agret:  str = "  AddGroup ret=";
d_exit:   str = "check_exit -> WM_CLOSE (server refcount hit 0)\n";
d_geterr: str = "Srv_GetErrorString\n";
d_getgrp: str = "Srv_GetGroupByName [STUB E_NOTIMPL]\n";
d_crenum: str = "Srv_CreateGroupEnumerator [STUB E_NOTIMPL]\n";
d_qorg:   str = "brw_QueryOrganization\n";
d_bids:   str = "brw_BrowseOPCItemIDs filter=";
d_gid:    str = "brw_GetItemID\n";
d_nl:     str = "\n";
d_fetch:  str = " fetched=";
d_qap:    str = "  prop_QueryAvailableProperties\n";
d_gip:    str = "  prop_GetItemProperties\n";
d_fcp:    str = "  cpc_FindConnectionPoint\n";
d_adv:    str = "  cp_Advise (callback stored)\n";
d_sete:   str = "  async_SetEnable\n";
pd_dt:    str = "Item Canonical DataType";
pd_val:   str = "Item Value";
pd_q:     str = "Item Quality";
pd_ar:    str = "Item Access Rights";
d_bap:    str = "brw_BrowseAccessPaths [STUB E_NOTIMPL]\n";
d_grpqi:  str = "  Grp_QI iid0=";
d_addit:  str = "  im_AddItems\n";
d_read:   str = "  sio_Read\n";
d_write:  str = "  sio_Write h=";
d_wval:   str = " idx=";
d_next:   str = "  es_Next celt=";
d_gsget:  str = "  gs_GetState\n";
d_gsset:  str = "  gs_SetState rate=";
d_valid:  str = "  im_ValidateItems\n";
d_setact: str = "  im_SetActiveState active=";
d_setch:  str = "  im_SetClientHandles\n";
d_errmsg: str = "ANCL OPC DA Simulator error";
