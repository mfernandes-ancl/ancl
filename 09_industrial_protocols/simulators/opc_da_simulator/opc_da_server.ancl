    return 0;
}

# =====================================================================
# GUI control panel
# =====================================================================
func fmt_centi(buf: ptr, v: i64) -> i64 {
    whole = v / 100;
    frac = v - whole * 100;
    int_to_str(buf, whole);
    e = buf + strlen(buf);
    store8(e, 46);
    e = e + 1;
    if frac < 10 { store8(e, 48); e = e + 1; }
    int_to_str(e, frac);
    return 0;
}
func parse_centi(s: ptr) -> i64 {
    i = 0; whole = 0;
    while 1 {
        c = load8(s + i);
        if c < 48 { break; }
        if c > 57 { break; }
        whole = whole * 10 + (c - 48);
        i = i + 1;
    }
    frac = 0; digits = 0;
    if load8(s + i) == 46 {
        i = i + 1;
        while digits < 2 {
            c = load8(s + i);
            if c < 48 { break; }
            if c > 57 { break; }
            frac = frac * 10 + (c - 48);
            digits = digits + 1;
            i = i + 1;
        }
    }
    if digits == 1 { frac = frac * 10; }
    if digits == 0 { frac = 0; }
    return whole * 100 + frac;
}
func apply_tags() -> i64 {
    store64(tag_data + 0, load64(g_st));
    store64(tag_data + 8, fbits(itof(load64(g_fi)) / itof(100)));
    store64(tag_data + 16, fbits(itof(load64(g_vi)) / itof(100)));
    return 0;
}
func refresh_labels() -> i64 {
    int_to_str(g_buf, load64(g_st));
    SetWindowTextA(load64(g_lbl_st), g_buf);
    fmt_centi(g_buf, load64(g_fi));
    SetWindowTextA(load64(g_lbl_fr), g_buf);
    fmt_centi(g_buf, load64(g_vi));
    SetWindowTextA(load64(g_lbl_vl), g_buf);
    e = str_copy(g_cyclebuf, s_cyc);
    int_to_str(e, load64(g_cycle));
    SetWindowTextA(load64(g_lbl_cyc), g_cyclebuf);
    e = str_copy(g_statusbuf, s_opc);
    if load64(g_running) == 1 { e = str_copy(e, s_run); } else { e = str_copy(e, s_stop); }
    e = str_copy(e, s_conns);
    int_to_str(e, load64(g_conns));
    SetWindowTextA(load64(g_hstatus), g_statusbuf);
    return 0;
}
func pump_tick() -> i64 {
    if load64(g_running) == 0 { return 0; }
    counter = load64(g_counter);
    cycle = load64(g_cycle);
    if counter <= 100 { fi = 4900 + counter * 2; } else { t = counter - 100; fi = 5100 - t * 2; }
    if counter <= 100 { vi = 21500 + counter * 10; } else { t = counter - 100; vi = 22500 - t * 10; }
    m = cycle % 4;
    if m == 0 { st = 1; } else { if m == 1 { st = 3; } else { if m == 2 { st = 5; } else { st = 7; } } }
    store64(g_fi, fi); store64(g_vi, vi); store64(g_st, st);
    counter = counter + 1;
    if counter > 200 { counter = 0; }
    store64(g_counter, counter);
    store64(g_cycle, cycle + 1);
    apply_tags();
    return 0;
}
func set_status() -> i64 {
    GetWindowTextA(load64(g_ed_st), g_inbuf, 32);
    store64(g_st, str_to_int(g_inbuf));
    apply_tags(); refresh_labels();
    return 0;
}
func set_freq() -> i64 {
    GetWindowTextA(load64(g_ed_fr), g_inbuf, 32);
    store64(g_fi, parse_centi(g_inbuf));
    apply_tags(); refresh_labels();
    return 0;
}
func set_volt() -> i64 {
    GetWindowTextA(load64(g_ed_vl), g_inbuf, 32);
    store64(g_vi, parse_centi(g_inbuf));
    apply_tags(); refresh_labels();
    return 0;
}
func create_controls(hwnd: i64) -> i64 {
    hinst = load64(g_hinst);
    CreateWindowExA(0, cls_stat, txt_hdr, 1342177280, 20, 12, 640, 20, hwnd, 0, hinst, 0);
    CreateWindowExA(0, cls_stat, txt_sub, 1342177280, 20, 36, 640, 20, hwnd, 0, hinst, 0);
    CreateWindowExA(0, cls_stat, lbl_st, 1342177280, 20, 80, 230, 20, hwnd, 0, hinst, 0);
    h = CreateWindowExA(0, cls_stat, dash, 1342177280, 260, 80, 90, 20, hwnd, 0, hinst, 0); store64(g_lbl_st, h);
    h = CreateWindowExA(0, cls_edit, dash, 1350565888, 360, 78, 100, 24, hwnd, 2103, hinst, 0); store64(g_ed_st, h);
    CreateWindowExA(0, cls_btn, txt_set, 1342177280, 470, 77, 60, 26, hwnd, 2003, hinst, 0);
    CreateWindowExA(0, cls_stat, lbl_fr, 1342177280, 20, 114, 230, 20, hwnd, 0, hinst, 0);
    h = CreateWindowExA(0, cls_stat, dash, 1342177280, 260, 114, 90, 20, hwnd, 0, hinst, 0); store64(g_lbl_fr, h);
    h = CreateWindowExA(0, cls_edit, dash, 1350565888, 360, 112, 100, 24, hwnd, 2104, hinst, 0); store64(g_ed_fr, h);
    CreateWindowExA(0, cls_btn, txt_set, 1342177280, 470, 111, 60, 26, hwnd, 2004, hinst, 0);
    CreateWindowExA(0, cls_stat, lbl_vl, 1342177280, 20, 148, 230, 20, hwnd, 0, hinst, 0);
    h = CreateWindowExA(0, cls_stat, dash, 1342177280, 260, 148, 90, 20, hwnd, 0, hinst, 0); store64(g_lbl_vl, h);
    h = CreateWindowExA(0, cls_edit, dash, 1350565888, 360, 146, 100, 24, hwnd, 2105, hinst, 0); store64(g_ed_vl, h);
    CreateWindowExA(0, cls_btn, txt_set, 1342177280, 470, 145, 60, 26, hwnd, 2005, hinst, 0);
    CreateWindowExA(0, cls_btn, txt_start, 1342177280, 20, 188, 120, 28, hwnd, 2001, hinst, 0);
    CreateWindowExA(0, cls_btn, txt_stop,  1342177280, 150, 188, 120, 28, hwnd, 2002, hinst, 0);
    h = CreateWindowExA(0, cls_stat, s_cyc, 1342177280, 290, 194, 240, 20, hwnd, 0, hinst, 0); store64(g_lbl_cyc, h);
    CreateWindowExA(0, cls_btn, txt_reg,   1342177280, 20, 224, 120, 28, hwnd, 2006, hinst, 0);
    CreateWindowExA(0, cls_btn, txt_unreg, 1342177280, 150, 224, 120, 28, hwnd, 2007, hinst, 0);
    h = CreateWindowExA(0, cls_stat, rs_idle, 1342177280, 290, 230, 400, 20, hwnd, 0, hinst, 0); store64(g_lbl_reg, h);
    h = CreateWindowExA(0, cls_stat, dash, 1342177280, 20, 262, 660, 20, hwnd, 0, hinst, 0); store64(g_hstatus, h);
    int_to_str(g_buf, load64(g_st)); SetWindowTextA(load64(g_ed_st), g_buf);
    fmt_centi(g_buf, load64(g_fi)); SetWindowTextA(load64(g_ed_fr), g_buf);
    fmt_centi(g_buf, load64(g_vi)); SetWindowTextA(load64(g_ed_vl), g_buf);
    refresh_labels();
    return 0;
}
func WndProc(hwnd: i64, msg: i64, wParam: i64, lParam: i64) -> i64 {
    if msg == 1 { create_controls(hwnd); return 0; }
    if msg == 273 {
        id = band(wParam, 65535);
        if id == 2001 { store64(g_running, 1); refresh_labels(); }
        if id == 2002 { store64(g_running, 0); refresh_labels(); }
        if id == 2003 { set_status(); }
        if id == 2004 { set_freq(); }
        if id == 2005 { set_volt(); }
        if id == 2006 { show_reg_status(reg_register()); }
        if id == 2007 { reg_unregister(); SetWindowTextA(load64(g_lbl_reg), rs_unreg); }
        return 0;
    }
    if msg == 275 { pump_tick(); refresh_labels(); g = load64(g_sub_group); if g != 0 { push_datachange(g, 0); } return 0; }   # WM_TIMER + push subscription
    if msg == 2 { PostQuitMessage(0); return 0; }
    return DefWindowProcA(hwnd, msg, wParam, lParam);
}

# =====================================================================
# Self-registration (used by the GUI buttons AND /regserver /unregserver CLI)
# =====================================================================
func str_contains(h: i64, n: i64) -> i64 {
    i = 0;
    while load8(h + i) != 0 {
        j = 0;
        while 1 {
            cn = load8(n + j);
            if cn == 0 { return 1; }
            if load8(h + i + j) != cn { break; }
            j = j + 1;
        }
        i = i + 1;
    }
    return 0;
}
# create subkey under root and set its DEFAULT value = data (REG_SZ). 0 = ok.
func reg_set_default(root: i64, subkey: i64, data: i64) -> i64 {
    rc = RegCreateKeyExA(root, subkey, 0, 0, 0, 0x20006, 0, g_phk, 0);   # KEY_WRITE
    if rc != 0 { return rc; }
    hk = load64(g_phk);
    RegSetValueExA(hk, 0, 0, 1, data, strlen(data) + 1);                 # default value, REG_SZ, +NUL
    RegCloseKey(hk);
    return 0;
}
func reg_create(root: i64, subkey: i64) -> i64 {
    rc = RegCreateKeyExA(root, subkey, 0, 0, 0, 0x20006, 0, g_phk, 0);
    if rc != 0 { return rc; }
    RegCloseKey(load64(g_phk));
    return 0;
}
# Returns 2 = registered HKLM (machine), 1 = HKCU (per-user), 0 = failed.
func reg_register() -> i64 {
    GetModuleFileNameA(0, g_exepath, 512);            # exe path -> LocalServer32 (path-correct anywhere)
    root = 0x80000002;                                 # HKEY_LOCAL_MACHINE
    rc = reg_set_default(root, rk_progid, v_friendly);
    if rc != 0 {
        root = 0x80000001;                             # HKEY_CURRENT_USER (no admin needed)
        rc = reg_set_default(root, rk_progid, v_friendly);
        if rc != 0 { return 0; }
    }
    reg_set_default(root, rk_progid_clsid, v_clsidstr);
    reg_set_default(root, rk_clsid, v_friendly);
    reg_set_default(root, rk_clsid_progid, v_progidstr);
    reg_set_default(root, rk_clsid_ls32, g_exepath);
    reg_create(root, rk_clsid_cat);
    if root == 0x80000002 { return 2; }
    return 1;
}
func reg_unregister() -> i64 {
    RegDeleteTreeA(0x80000002, rk_clsid);
    RegDeleteTreeA(0x80000002, rk_progid);
    RegDeleteTreeA(0x80000001, rk_clsid);
    RegDeleteTreeA(0x80000001, rk_progid);
    return 0;
}
func show_reg_status(code: i64) -> i64 {
    if code == 2 { SetWindowTextA(load64(g_lbl_reg), rs_hklm); }
    else { if code == 1 { SetWindowTextA(load64(g_lbl_reg), rs_hkcu); } else { SetWindowTextA(load64(g_lbl_reg), rs_fail); } }
    return 0;
}

func main() -> i32 {
    # ---- CLI: /regserver and /unregserver (standard COM self-registration) ----
    cl = GetCommandLineA();
    if str_contains(cl, s_unreg_arg) == 1 { reg_unregister(); return 0; }   # check unreg first (substring of regserver)
    if str_contains(cl, s_reg_arg) == 1 { reg_register(); return 0; }

    dbg(d_boot);
    store64(g_embedding, str_contains(cl, s_embed_arg));   # COM-launched? -> auto-close when client disconnects
    # ---- COM server bring-up (MTA) ----
    CoInitializeEx(0, 0);
    init_iids();
    build_vtables();
    # Global Interface Table for cross-apartment callback delivery (dOPC's sink is STA)
    store64(git_clsid + 0, 0x0000000000000323); store64(git_clsid + 8, 0x46000000000000C0);   # CLSID_StdGlobalInterfaceTable
    store64(git_iid + 0,   0x0000000000000146); store64(git_iid + 8,   0x46000000000000C0);   # IID_IGlobalInterfaceTable
    store64(g_git, 0);
    githr = CoCreateInstance(git_clsid, 0, 1, git_iid, g_git);   # CLSCTX_INPROC_SERVER
    dbg(d_git); dbgn(githr); dbg(d_nl);
    store64(g_grphandle, 0);
    store64(clsid + 0, 0x6677445500112233);
    store64(clsid + 8, 0xFFEEDDCCBBAA9988);
    store64(srv_obj + 0, srv_vt); store64(srv_obj + 8, brw_vt); store64(srv_obj + 16, prop_vt); store64(srv_obj + 24, 0);  # 0 client refs at start
    store64(cf_obj + 0, cf_vt);   store64(cf_obj + 8, 1);

    # ---- initial simulator state ----
    store64(g_running, 1);
    store64(g_counter, 0);
    store64(g_cycle, 0);
    store64(g_st, 5);
    store64(g_fi, 5000);
    store64(g_vi, 22000);
    store64(g_conns, 0);
    apply_tags();
    store64(tag_data + 24, 0);                  # Substation.Breaker = FALSE (writable, pump never touches it)
    store64(tag_data + 32, fbits(itof(100)));   # Substation.Setpoint = 100.0 (writable)

    CoRegisterClassObject(clsid, cf_obj, 4, 1, cookie);
    CoResumeClassObjects();

    # ---- window ----
    hinst = GetModuleHandleA(0);
    store64(g_hinst, hinst);
    cursor = LoadCursorA(0, 32512);
    store32(g_wndclass + 0,  80);
    store32(g_wndclass + 4,  3);
    store64(g_wndclass + 8,  &WndProc);
    store32(g_wndclass + 16, 0);
    store32(g_wndclass + 20, 0);
    store64(g_wndclass + 24, hinst);
    store64(g_wndclass + 32, 0);
    store64(g_wndclass + 40, cursor);
    store64(g_wndclass + 48, 6);
    store64(g_wndclass + 56, 0);
    store64(g_wndclass + 64, clsname);
    store64(g_wndclass + 72, 0);
    RegisterClassExA(g_wndclass);
    hwnd = CreateWindowExA(0, clsname, title, 282001408, 120, 120, 700, 345, 0, 0, hinst, 0);
    store64(g_hwnd, hwnd);
    ShowWindow(hwnd, 1);
    UpdateWindow(hwnd);
    SetTimer(hwnd, 1, 500, 0);

    while 1 {
        r = GetMessageA(g_msg, 0, 0, 0);
        if r == 0 { break; }
        TranslateMessage(g_msg);
        DispatchMessageA(g_msg);
    }
    CoRevokeClassObject(load32(cookie));   # clean COM teardown on window close
    CoUninitialize();
    return 0;
}
