    store64(srv_vt + 40, &Srv_GetGroupByName);
    store64(srv_vt + 48, &Srv_GetStatus);
    store64(srv_vt + 56, &Srv_RemoveGroup);
    store64(srv_vt + 64, &Srv_CreateGroupEnumerator);
    store64(grp_im_vt + 0,  &im_QI);
    store64(grp_im_vt + 8,  &im_AddRef);
    store64(grp_im_vt + 16, &im_Release);
    store64(grp_im_vt + 24, &im_AddItems);
    store64(grp_im_vt + 32, &im_ValidateItems);
    store64(grp_im_vt + 40, &im_RemoveItems);
    store64(grp_im_vt + 48, &im_SetActiveState);
    store64(grp_im_vt + 56, &im_SetClientHandles);
    store64(grp_im_vt + 64, &im_SetDatatypes);
    store64(grp_im_vt + 72, &im_CreateEnumerator);
    store64(grp_sio_vt + 0,  &sio_QI);
    store64(grp_sio_vt + 8,  &sio_AddRef);
    store64(grp_sio_vt + 16, &sio_Release);
    store64(grp_sio_vt + 24, &sio_Read);
    store64(grp_sio_vt + 32, &sio_Write);
    store64(grp_gs_vt + 0,  &gs_QI);
    store64(grp_gs_vt + 8,  &gs_AddRef);
    store64(grp_gs_vt + 16, &gs_Release);
    store64(grp_gs_vt + 24, &gs_GetState);
    store64(grp_gs_vt + 32, &gs_SetState);
    store64(grp_gs_vt + 40, &gs_SetName);
    store64(grp_gs_vt + 48, &gs_CloneGroup);
    store64(brw_vt + 0,  &brw_QI);
    store64(brw_vt + 8,  &brw_AddRef);
    store64(brw_vt + 16, &brw_Release);
    store64(brw_vt + 24, &brw_QueryOrganization);
    store64(brw_vt + 32, &brw_ChangeBrowsePosition);
    store64(brw_vt + 40, &brw_BrowseOPCItemIDs);
    store64(brw_vt + 48, &brw_GetItemID);
    store64(brw_vt + 56, &brw_BrowseAccessPaths);
    store64(enum_vt + 0,  &es_QI);
    store64(enum_vt + 8,  &es_AddRef);
    store64(enum_vt + 16, &es_Release);
    store64(enum_vt + 24, &es_Next);
    store64(enum_vt + 32, &es_Skip);
    store64(enum_vt + 40, &es_Reset);
    store64(enum_vt + 48, &es_Clone);
    store64(prop_vt + 0,  &prop_QI);
    store64(prop_vt + 8,  &prop_AddRef);
    store64(prop_vt + 16, &prop_Release);
    store64(prop_vt + 24, &prop_QueryAvailableProperties);
    store64(prop_vt + 32, &prop_GetItemProperties);
    store64(prop_vt + 40, &prop_LookupItemIDs);
    store64(cpc_vt + 0,  &cpc_QI);
    store64(cpc_vt + 8,  &cpc_AddRef);
    store64(cpc_vt + 16, &cpc_Release);
    store64(cpc_vt + 24, &cpc_EnumConnectionPoints);
    store64(cpc_vt + 32, &cpc_FindConnectionPoint);
    store64(cp_vt + 0,  &cp_QI);
    store64(cp_vt + 8,  &cp_AddRef);
    store64(cp_vt + 16, &cp_Release);
    store64(cp_vt + 24, &cp_GetConnectionInterface);
    store64(cp_vt + 32, &cp_GetConnectionPointContainer);
    store64(cp_vt + 40, &cp_Advise);
    store64(cp_vt + 48, &cp_Unadvise);
    store64(cp_vt + 56, &cp_EnumConnections);
    store64(async_vt + 0,  &async_QI);
    store64(async_vt + 8,  &async_AddRef);
    store64(async_vt + 16, &async_Release);
    store64(async_vt + 24, &async_Read);
    store64(async_vt + 32, &async_Write);
    store64(async_vt + 40, &async_Refresh2);
