# ANCL Native COM OPC DA Server
#
# A bare-bones COM server implemented entirely in ANCL using raw Win32 memory
# manipulation and manual VTable construction. Registers an IClassFactory via
# CoRegisterClassObject, exposes an object with IUnknown + ReadTag(), and runs
# a data-pump loop that oscillates 3 industrial tags in real-time.
#
# Compile: bin\anclc.exe opc_da_com_server.ancl opc_da_com_server.exe
# Run:     opc_da_com_server.exe
# (leave running; a COM client calls CoCreateInstance with the CLSID below)

@DATA
# ===========================================================================
# GUID buffers (populated at runtime via store64)
# ===========================================================================
clsid:  buf = 16;    # {00112233-4455-6677-8899-AABBCCDDEEFF}
iid_unk: buf = 16;   # IID_IUnknown       {00000000-0000-0000-C000-000000000046}
iid_cf:  buf = 16;   # IID_IClassFactory  {00000001-0000-0000-C000-000000000046}

# ===========================================================================
# Class Factory VTable (5 entries) + object
# ===========================================================================
cf_vt:   buf = 40;   # [QI:8] [AddRef:8] [Release:8] [CreateInstance:8] [LockServer:8]
cf_obj:  buf = 16;   # [vt_ptr:8] [refcnt:8]

# ===========================================================================
# Server object VTable (4 entries)
#   Layout known to clients:
#     +0  QueryInterface  (IUnknown)
#     +8  AddRef          (IUnknown)
#     +16 Release         (IUnknown)
#     +24 ReadTag         (custom)
# ===========================================================================
srv_vt:  buf = 32;

# ===========================================================================
# Global tag data (shared across all server instances, updated by data pump)
# ===========================================================================
tag_data: buf = 24;  # +0: Substation_Status (i64), +8: Frequency_Hz (f64 bits), +16: Voltage_kV (f64 bits)

# Registration cookie written by CoRegisterClassObject
cookie: buf = 8;

# ===========================================================================
# String constants
# ===========================================================================
s_start:  str = "OPC DA COM Server starting...\n";
s_reg:    str = "Class factory registered with COM.\n  CLSID: {00112233-4455-6677-8899-AABBCCDDEEFF}\n";
s_pump:   str = "Data pump running.  Use CoCreateInstance to connect.\n";
s_cycle:  str = "Cycle:";
s_tags:   str = "  Tags:[";
s_stat:   str = " st=";
s_freq:   str = " fr=";
s_volt:   str = " vl=";
s_close:  str = "]";
s_nl:     str = "\n";
s_connect: str = "Client connected (CreateInstance called)\n";
s_err_oom: str = "VirtualAlloc failed\n";
s_err:    str = "COM error\n";
s_sep:    str = "--------------------------------\n";

# ===========================================================================
# Win32 / COM imports
# ===========================================================================
extern "ole32.dll" CoInitializeEx -> ptr;
extern "ole32.dll" CoRegisterClassObject -> ptr;
extern "ole32.dll" CoResumeClassObjects -> ptr;
extern "kernel32.dll" VirtualAlloc -> ptr;
extern "kernel32.dll" Sleep;

@CODE
# ===========================================================================
# Utility: compare two 16-byte GUIDs.  Returns 0 if equal, non-zero if not.
# ===========================================================================
func compare_guid(a: ptr, b: ptr) -> i64 {
    lo_a = load64(a);
    lo_b = load64(b);
    if lo_a != lo_b { return 1; }
    hi_a = load64(a + 8);
    hi_b = load64(b + 8);
    if hi_a != hi_b { return 1; }
    return 0;
}

# ===========================================================================
# CLASS FACTORY — IClassFactory implementation
# ===========================================================================
# IUnknown::QueryInterface
#   this+0 == vtbl; this+8 == refcount
func CF_QueryInterface(this: ptr, riid: ptr, ppv: ptr) -> i64 {
    if riid == 0 { return 0x80004003; }
    if ppv == 0  { return 0x80004003; }
    store64(ppv, 0);

    if compare_guid(riid, iid_unk) == 0 {
        store64(ppv, this);
        ref = load64(this + 8);
        ref = ref + 1;
        store64(this + 8, ref);
        return 0;
    }
    if compare_guid(riid, iid_cf) == 0 {
        store64(ppv, this);
        ref = load64(this + 8);
        ref = ref + 1;
        store64(this + 8, ref);
        return 0;
    }
    return 0x80004002;  # E_NOINTERFACE
}

# IUnknown::AddRef
func CF_AddRef(this: ptr) -> i64 {
    ref = load64(this + 8);
    ref = ref + 1;
    store64(this + 8, ref);
    return ref;
}

# IUnknown::Release
func CF_Release(this: ptr) -> i64 {
    ref = load64(this + 8);
    ref = ref - 1;
    store64(this + 8, ref);
    if ref == 0 {
        # In a full implementation we would destroy the object here.
        # For this demo we keep the class factory alive for the process lifetime.
    }
    return ref;
}

# IClassFactory::CreateInstance
func CF_CreateInstance(this: ptr, outer: ptr, riid: ptr, ppv: ptr) -> i64 {
    if ppv == 0 { return 0x80004003; }
    store64(ppv, 0);
    if outer != 0 { return 0x80040110; }   # CLASS_E_NOAGGREGATION

    syscall 1, s_connect;

    obj = VirtualAlloc(0, 16, 0x3000, 4);  # 16 bytes: [vt_ptr:8] [refcnt:8]
    if obj == 0 { return 0x8007000E; }     # E_OUTOFMEMORY

    store64(obj, srv_vt);
    store64(obj + 8, 1);                   # initial refcount = 1

    store64(ppv, obj);
    return 0;  # S_OK
}

# IClassFactory::LockServer
func CF_LockServer(this: ptr, flock: i64) -> i64 {
    return 0;  # S_OK
}

# ===========================================================================
# SERVER OBJECT — IUnknown + custom ReadTag
# ===========================================================================
func Srv_QueryInterface(this: ptr, riid: ptr, ppv: ptr) -> i64 {
    if riid == 0 { return 0x80004003; }
    if ppv == 0  { return 0x80004003; }
    store64(ppv, 0);

    if compare_guid(riid, iid_unk) == 0 {
        store64(ppv, this);
        ref = load64(this + 8);
        ref = ref + 1;
        store64(this + 8, ref);
        return 0;
    }
    return 0x80004002;  # E_NOINTERFACE
}

func Srv_AddRef(this: ptr) -> i64 {
    ref = load64(this + 8);
    ref = ref + 1;
    store64(this + 8, ref);
    return ref;
}

func Srv_Release(this: ptr) -> i64 {
    ref = load64(this + 8);
    ref = ref - 1;
    store64(this + 8, ref);
    return ref;
}

# ReadTag(tagIndex, pValue) -> HRESULT
#   tagIndex 0 = Substation_Status (i64)
#   tagIndex 1 = Frequency_Hz      (f64 stored as raw i64 bits)
#   tagIndex 2 = Voltage_kV        (f64 stored as raw i64 bits)
func Srv_ReadTag(this: ptr, tag_idx: i64, pval: ptr) -> i64 {
    if pval == 0 { return 0x80004003; }
    if tag_idx == 0 {
        store64(pval, load64(tag_data));
        return 0;
    }
    if tag_idx == 1 {
        store64(pval, load64(tag_data + 8));
        return 0;
    }
    if tag_idx == 2 {
        store64(pval, load64(tag_data + 16));
        return 0;
    }
    return 0x80070057;  # E_INVALIDARG
}

# ===========================================================================
# VTable initialisation (store function addresses into vtable buffers)
#
# NOTE: ANCL takes a function's code address with the `&` prefix (e.g. &CF_QueryInterface),
#       exactly like the threadpool's CreateThread(0, 0, &tp_worker, ...). A BARE function
#       name is parsed as a variable -> compile error "undefined variable '<fn>'".
# ===========================================================================
func init_vtables() -> i64 {
    # --- Class Factory vtable (5 methods) ---
    store64(cf_vt,       &CF_QueryInterface);    # +0  QI
    store64(cf_vt + 8,   &CF_AddRef);            # +8  AddRef
    store64(cf_vt + 16,  &CF_Release);           # +16 Release
    store64(cf_vt + 24,  &CF_CreateInstance);    # +24 CreateInstance
    store64(cf_vt + 32,  &CF_LockServer);        # +32 LockServer

    # --- Server object vtable (4 methods) ---
    store64(srv_vt,       &Srv_QueryInterface);   # +0  QI
    store64(srv_vt + 8,   &Srv_AddRef);           # +8  AddRef
    store64(srv_vt + 16,  &Srv_Release);           # +16 Release
    store64(srv_vt + 24,  &Srv_ReadTag);           # +24 ReadTag

    return 0;
}

# ===========================================================================
# COM server entry point
# ===========================================================================
func main() -> i32 {
    syscall 1, s_start;

    # ---- 1. Initialise COM ----
    hr = CoInitializeEx(0, 0);
    if hr != 0 { syscall 1, s_err; return 1; }

    # ---- 2. Populate GUID buffers ----
    # CLSID = {00112233-4455-6677-8899-AABBCCDDEEFF}
    store64(clsid,      0x6677445500112233);
    store64(clsid + 8,  0xFFEEDDCCBBAA9988);

    # IID_IUnknown = {00000000-0000-0000-C000-000000000046}
    store64(iid_unk,     0x0000000000000000);
    store64(iid_unk + 8, 0x46000000000000C0);

    # IID_IClassFactory = {00000001-0000-0000-C000-000000000046}
    store64(iid_cf,      0x0000000000000001);
    store64(iid_cf + 8,  0x46000000000000C0);

    # ---- 3. Build VTables ----
    init_vtables();

    # ---- 4. Initialise class factory object ----
    store64(cf_obj,      cf_vt);    # vtable pointer
    store64(cf_obj + 8,  1);         # initial refcount

    # ---- 5. Initialise tag data ----
    store64(tag_data,      1);                              # status = Running (bit 0)
    store64(tag_data + 8,  fbits(itof(5000) / itof(100)));  # freq  = 50.00 Hz
    store64(tag_data + 16, fbits(itof(22000) / itof(100))); # volt  = 220.00 kV

    # ---- 6. Register class factory with COM ----
    hr = CoRegisterClassObject(clsid, cf_obj, 4, 1, cookie);
    if hr != 0 { syscall 1, s_err; return 1; }

    hr = CoResumeClassObjects();
    if hr != 0 { syscall 1, s_err; return 1; }

    syscall 1, s_reg;
    syscall 1, s_pump;

    # ---- 7. Data pump loop (infinite) ----
    counter: i64 = 0;
    cycle: i64 = 0;
    fi: i64 = 5000;
    vi: i64 = 22000;
    st: i64 = 1;
    t: i64 = 0;

    while 1 {
        # --- Triangle-wave frequency: 4900..5100 hundredths (49.00..51.00 Hz) ---
        if counter <= 100 {
            fi = 4900 + counter * 2;
        } else {
            t = counter - 100;
            fi = 5100 - t * 2;
        }

        # --- Triangle-wave voltage: 21500..22500 hundredths (215.00..225.00 kV) ---
        if counter <= 100 {
            vi = 21500 + counter * 10;
        } else {
            t = counter - 100;
            vi = 22500 - t * 10;
        }

        # --- Status bitmask rotation (4 states, no `else if`) ---
        if cycle % 4 == 0 {
            st = 1;    # Running (bit 0)
        } else {
            if cycle % 4 == 1 {
                st = 3;    # Running | Alarm (bits 0,1)
            } else {
                if cycle % 4 == 2 {
                    st = 5;    # Running | Maintenance (bits 0,2)
                } else {
                    st = 7;    # Running | Alarm | Maintenance (bits 0,1,2)
                }
            }
        }

        # --- Write updated values into global tag buffer ---
        store64(tag_data, st);
        store64(tag_data + 8, fbits(itof(fi) / itof(100)));
        store64(tag_data + 16, fbits(itof(vi) / itof(100)));

        # --- Print live cache snapshot — also demonstrates read-back ---
        syscall 1, s_cycle, cycle, s_tags, s_stat, st, s_freq, fi, s_volt, vi, s_close, s_nl;

        # --- Advance state ---
        counter = counter + 1;
        if counter > 200 {
            counter = 0;
        }
        cycle = cycle + 1;
        Sleep(500);
    }

    return 0;
}
