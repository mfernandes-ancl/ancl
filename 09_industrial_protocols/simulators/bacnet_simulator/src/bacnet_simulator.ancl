# ============================================================================
#  bacnet_simulator.ancl  -  ANCL Native BACnet/IP Server Simulator
#
#  A native Win32 dark-themed BACnet/IP simulator, written in ANCL.
#  Binds to UDP port 47808 and responds to:
#   - Who-Is (Unconfirmed Service 8) with I-Am (Unconfirmed Service 0)
#   - ReadProperty (Confirmed Service 12) for Present_Value (Property 85)
#   - WriteProperty (Confirmed Service 15) for Present_Value (Property 85)
# ============================================================================

import "../../../core_lib/std.ancl";
import "../../../core_lib/win32_api.ancl";
import "../../../core_lib/numfmt.ancl";

# ---- Additional Win32 FFI ----
extern "user32.dll" PostMessageA;
extern "user32.dll" PeekMessageA -> i32;
