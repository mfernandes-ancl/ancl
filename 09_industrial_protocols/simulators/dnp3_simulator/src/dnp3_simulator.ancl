# ---- Virtual Point Database ----
# 8 Binary Inputs (Group 1, Var 2) + 4 Binary Outputs (Group 10, Var 2)
# + 4 Analog Inputs (Group 30, Var 1) + 2 Counters (Group 20, Var 1)
# + 1 Analog Output (Group 40, Var 1)
# = 19 points total, stored in flat arrays
PT_COUNT:   i64 = 19;
pt_values:  buf = 256;   # 19 * 8 bytes (i64 each, with extra padding)
pt_flags:   buf = 256;   # 19 * 8 bytes (quality flags each, with extra padding)

# Point type codes: 1=BI, 10=BO, 30=AI, 20=Counter, 40=AO
pt_groups:  buf = 256;   # group number for each point
pt_vars:    buf = 256;   # variation for each point
pt_names:   buf = 256;   # pointer to name string for each point

# ---- GUI handles ----
g_hinst:    buf = 8;
g_hwnd:     buf = 8;
g_port_ed:  buf = 8;
g_oaddr_ed: buf = 8;
g_idx_ed:   buf = 8;
g_val_ed:   buf = 8;
g_log:      buf = 8;
g_status:   buf = 8;
g_clients:  buf = 8;
g_font:     buf = 8;
g_listview: buf = 8;

# ---- Win32 structs ----
g_wndcls:   buf = 96;
g_msg:      buf = 64;
g_rect:     buf = 16;
g_ps:       buf = 72;

# ---- Winsock state ----
g_wsa:      buf = 512;
g_listen_s: buf = 8;
g_client_s: buf = 8;
g_nonblock: buf = 8;
g_addr:     buf = 16;
g_running:  buf = 8;

# ---- Protocol Buffers ----
g_rxbuf:    buf = 2048;
g_txbuf:    buf = 2048;
g_numbuf:   buf = 32;
g_portbuf:  buf = 32;
g_logbuf:   buf = 1024;
g_savebuf:  buf = 4096;
g_hexbuf:   buf = 256;

# ---- GDI setup ----
g_bg_brush: buf = 8;
g_edit_brush: buf = 8;
g_lv_brush:  buf = 8;

COL_BG:      i64 = 0x140A08;
