# Tag database buffers
g_tag_refs:   buf = 80;  # 10 pointers * 8 bytes
g_tag_attrs:  buf = 80;  # 10 pointers * 8 bytes
g_tag_types:  buf = 80;  # 10 integers * 8 bytes
g_prev_vals:  buf = 2560; # 10 strings * 256 bytes

# Caching/Format Buffers
g_temp_text:  buf = 256;
g_port_str:   buf = 32;
g_temp_val:   buf = 256;
g_logbuf:     buf = 1024;
g_savebuf:    buf = 4096;
g_numbuf:     buf = 32;

@CODE

# ============================================================================
# PROTOCOL METADATA & DATA MODEL SETUP
# ============================================================================

func init_tag_metadata() -> i64 {
    # Types: 0 = Float32, 1 = Quality, 2 = Boolean
    store64(g_tag_types + 0 * 8, 0); # AnIn1.mag.f
    store64(g_tag_types + 1 * 8, 1); # AnIn1.q
    store64(g_tag_types + 2 * 8, 0); # AnIn2.mag.f
    store64(g_tag_types + 3 * 8, 1); # AnIn2.q
    store64(g_tag_types + 4 * 8, 2); # SPCSO1.stVal
    store64(g_tag_types + 5 * 8, 2); # SPCSO1.ctlVal
    store64(g_tag_types + 6 * 8, 2); # SPCSO2.stVal
    store64(g_tag_types + 7 * 8, 2); # SPCSO2.ctlVal
    store64(g_tag_types + 8 * 8, 2); # Ind1.stVal
    store64(g_tag_types + 9 * 8, 1); # Ind1.q
    
    # Store references
    store64(g_tag_refs + 0 * 8, tag_ref_0);
    store64(g_tag_refs + 1 * 8, tag_ref_1);
    store64(g_tag_refs + 2 * 8, tag_ref_2);
    store64(g_tag_refs + 3 * 8, tag_ref_3);
    store64(g_tag_refs + 4 * 8, tag_ref_4);
    store64(g_tag_refs + 5 * 8, tag_ref_5);
    store64(g_tag_refs + 6 * 8, tag_ref_6);
    store64(g_tag_refs + 7 * 8, tag_ref_7);
    store64(g_tag_refs + 8 * 8, tag_ref_8);
    store64(g_tag_refs + 9 * 8, tag_ref_9);
    
    # Zero out the previous values cache
    memset(g_prev_vals, 0, 2560);
    return 0;
}

func cache_tag_pointers() -> i64 {
    model = load64(g_mms_model);
    if model == 0 { return 0; }
    
    i = 0;
    while i < 10 {
        ref = load64(g_tag_refs + i * 8);
        attr = IedModel_getModelNodeByObjectReference(model, ref);
        store64(g_tag_attrs + i * 8, attr);
        
        # Log resolution
        p = g_logbuf;
        p = str_copy(p, "[Server] Cache: ");
        p = str_copy(p, ref);
        p = str_copy(p, " -> ");
        end = nf_u64dec(attr, g_temp_text);
        store8(end, 0);
        p = str_copy(p, g_temp_text);
        str_copy(p, "\r\n");
        log_append(g_logbuf);
        
        i = i + 1;
    }
    return 0;
}

func setup_data_model() -> i64 {
    # 1. Create model container
    model = IedModel_create("ICCP_Sim");
    if model == 0 { return 0; }
    store64(g_mms_model, model);
    
    # 2. Create Logical Device
    ld = LogicalDevice_create("BilateralTable1", model);
    
    # 3. Create Logical Node
    ln = LogicalNode_create("GGIO1", ld);
    
    # 4. Create Measured Values (Analogs)
    CDC_MV_create("AnIn1", ln, 0, 0); # Measured Value (FLOAT32)
    CDC_MV_create("AnIn2", ln, 0, 0); # Measured Value (FLOAT32)
    
    # 5. Create Single Point Status (SPS)
    CDC_SPS_create("Ind1", ln, 0); # Binary Status (SPS)
    
    # 6. Create Single Point Controls (SPC)
    CDC_SPC_create("SPCSO1", ln, 0, 1); # Binary Control (Direct Normal, ctlModel=1)
    CDC_SPC_create("SPCSO2", ln, 0, 4); # Binary Control (SBO Enhanced,  ctlModel=4) - select-with-value path
    
    return model;
}

func init_default_values() -> i64 {
    server = load64(g_mms_server);
    if server == 0 { return 0; }
    
    # Initialize AnIn1 to 100.0, Quality Good (0)
    update_float_tag(server, load64(g_tag_attrs + 0 * 8), "100.0");
    IedServer_updateQuality(server, load64(g_tag_attrs + 1 * 8), 0);
    
    # Initialize AnIn2 to 25.5, Quality Good (0)
    update_float_tag(server, load64(g_tag_attrs + 2 * 8), "25.5");
    IedServer_updateQuality(server, load64(g_tag_attrs + 3 * 8), 0);
    
    # Initialize Ind1 to False, Quality Good
    IedServer_updateBooleanAttributeValue(server, load64(g_tag_attrs + 8 * 8), 0);
    IedServer_updateQuality(server, load64(g_tag_attrs + 9 * 8), 0);
    
    # Initialize SPCSO1 to False
    IedServer_updateBooleanAttributeValue(server, load64(g_tag_attrs + 4 * 8), 0);
    IedServer_updateBooleanAttributeValue(server, load64(g_tag_attrs + 5 * 8), 0);
    
    # Initialize SPCSO2 to False
    IedServer_updateBooleanAttributeValue(server, load64(g_tag_attrs + 6 * 8), 0);
    IedServer_updateBooleanAttributeValue(server, load64(g_tag_attrs + 7 * 8), 0);
    
    return 0;
}

# ============================================================================
# MEMORY ALIGNMENT & FLOAT32 HACK
# ============================================================================

func detect_mms_alignment() -> i64 {
    val1 = MmsValue_newBoolean(1);
    val0 = MmsValue_newBoolean(0);
    offset = 8;
    
    if load8(val1 + 5) == 1 {
        if load8(val0 + 5) == 0 {
            offset = 5;
        }
    }
    
    MmsValue_delete(val1);
    MmsValue_delete(val0);
    
    store64(g_mms_val_offset, offset);
    return offset;
}

func update_float_tag(server: i64, attr: i64, val_str: i64) -> i64 {
    if attr == 0 { return 0; }
    
    # Parse float to bits
    f_bits = parse_float_string_to_f32_bits(val_str);
    
    # Create dummy integer MmsValue (allocates sufficient memory space)
    mmsVal = MmsValue_newInteger(0);
    if mmsVal == 0 { return 0; }
    
    # Overwrite type to MMS_FLOAT (6)
    store32(mmsVal, 6);
    
    # Write metadata and value
    offset = load64(g_mms_val_offset);
    store8(mmsVal + offset + 0, 4);          # size = 4 bytes
    store8(mmsVal + offset + 1, 32);         # format width = 32 bits
    store32(mmsVal + offset + 2, f_bits);    # raw float bits
    
    # Update on server
    IedServer_updateAttributeValue(server, attr, mmsVal);
    
    # Clean up
    MmsValue_delete(mmsVal);
    return 1;
}

# ============================================================================
# UTILITY FUNCTIONS
# ============================================================================

func str_equal(s1: i64, s2: i64) -> i64 {
    i = 0;
    while 1 {
        c1 = load8(s1 + i);
        c2 = load8(s2 + i);
        if c1 != c2 { return 0; }
        if c1 == 0 { return 1; }
        i = i + 1;
    }
    return 0;
}

func str_copy(dst: i64, src: i64) -> i64 {
    d = dst; s = src;
    while load8(s) != 0 {
        store8(d, load8(s));
        d = d + 1; s = s + 1;
    }
    store8(d, 0);
    return d;
}

func str_to_int(s: i64) -> i64 {
    v = 0; p = s;
    while load8(p) == 32 || load8(p) == 9 { p = p + 1; }
    while load8(p) >= 48 && load8(p) <= 57 {
        v = v * 10;
        v = v + load8(p) - 48;
        p = p + 1;
    }
    return v;
}

func log_append(text: i64) -> i64 {
    hwnd_log = load64(g_log);
    if hwnd_log == 0 { return 0; }
    len = SendMessageA(hwnd_log, 14, 0, 0);
    SendMessageA(hwnd_log, 177, len, len);
    SendMessageA(hwnd_log, 194, 0, text);
    return 0;
}

func parse_float_string_to_f32_bits(s: i64) -> i64 {
    p = s;
    while load8(p) == 32 || load8(p) == 9 { p = p + 1; }
    sign = 1.0;
    if load8(p) == 45 {
        sign = 0.0 - 1.0;
        p = p + 1;
    } else if load8(p) == 43 {
        p = p + 1;
    }
    val = 0.0;
    while load8(p) >= 48 && load8(p) <= 57 {
        val = val * 10.0 + itof(load8(p) - 48);
        p = p + 1;
    }
    if load8(p) == 46 {
        p = p + 1;
        divisor = 10.0;
        while load8(p) >= 48 && load8(p) <= 57 {
            val = val + itof(load8(p) - 48) / divisor;
            divisor = divisor * 10.0;
            p = p + 1;
        }
    }
    fval = val * sign;
    bits = fbits(fval);
    sgn  = band(shr(bits, 63), 1);
    exp  = band(shr(bits, 52), 2047);
    mant = band(bits, 4503599627370495);
    if exp == 0 { return shl(sgn, 31); }
    if exp == 2047 { return shl(sgn, 31) + shl(255, 23) + shr(mant, 29); }
    new_exp = exp - 1023 + 127;
    if new_exp <= 0 { return shl(sgn, 31); }
    if new_exp >= 255 { return shl(sgn, 31) + shl(255, 23); }
    new_mant = shr(mant, 29);
    return shl(sgn, 31) + shl(new_exp, 23) + new_mant;
}

# ============================================================================
# SERVER CONTROL & BACKGROUND THREAD LOGGING
# ============================================================================

func control_handler_spc1(object: i64, parameter: i64, value: i64, test: i64) -> i64 {
    b_val = MmsValue_getBoolean(value);
    PostMessageA(load64(g_hwnd), 0x400 + 2, 1, b_val);
    return 1; # CONTROL_RESULT_OK
}

func control_handler_spc2(object: i64, parameter: i64, value: i64, test: i64) -> i64 {
    b_val = MmsValue_getBoolean(value);
    PostMessageA(load64(g_hwnd), 0x400 + 2, 2, b_val);
    return 1; # CONTROL_RESULT_OK
}

func connection_handler(server: i64, connection: i64, connected: i64, parameter: i64) -> i64 {
    PostMessageA(load64(g_hwnd), 0x400 + 1, connected, connection);
    return 0;
}

func do_start_server() -> i64 {
    server = load64(g_mms_server);
    if server != 0 { return 0; }
    
    GetWindowTextA(load64(g_port_ed), g_port_str, 32);
    port = str_to_int(g_port_str);
    if port == 0 { port = 10102; }
    
    # 1. Setup the data model (if not already set up)
    model = load64(g_mms_model);
    if model == 0 {
        model = setup_data_model();
        cache_tag_pointers();
    }
    
    # 2. Start server
    log_append(m_start_try);
    end = nf_u64dec(port, g_temp_text);
    store8(end, 0);
    log_append(g_temp_text);
    log_append(m_dots);
    
    server = IedServer_create(model);
    if server == 0 {
        log_append(m_start_err);
        return 0;
    }
    store64(g_mms_server, server);
    
    # 3. Setup client connection handler
    IedServer_setConnectionIndicationHandler(server, &connection_handler, 0);
    
    spc1 = IedModel_getModelNodeByObjectReference(model, "ICCP_SimBilateralTable1/GGIO1.SPCSO1");
    if spc1 != 0 {
        IedServer_setControlHandler(server, spc1, &control_handler_spc1, 0);
    }
    spc2 = IedModel_getModelNodeByObjectReference(model, "ICCP_SimBilateralTable1/GGIO1.SPCSO2");
    if spc2 != 0 {
        IedServer_setControlHandler(server, spc2, &control_handler_spc2, 0);
    }
    
    # 4. Initialize tags to default simulated values
    init_default_values();
    
    # 5. Listen
    IedServer_start(server, port);
    
    # 6. Verify server started
    if IedServer_isRunning(server) != 0 {
        log_append(m_start_ok);
        SetWindowTextA(load64(g_status), "Status: Running");
        
        # Populate UI Grid with initial values
        populate_listview();
        
        # Enable polling timer (ID 1, 250ms interval)
        SetTimer(load64(g_hwnd), 1, 250, 0);
    } else {
        log_append(m_start_err);
        IedServer_destroy(server);
        store64(g_mms_server, 0);
    }
    
    InvalidateRect(load64(g_hwnd), 0, 1);
    return 0;
}

func do_stop_server() -> i64 {
    server = load64(g_mms_server);
    if server == 0 { return 0; }
    
    # Reset Auto Simulation if active
    if load64(g_auto_rand) != 0 {
        store64(g_auto_rand, 0);
        h = load64(g_btn_autorand);
        if h != 0 { SetWindowTextA(h, btn_auto_rand); }
        KillTimer(load64(g_hwnd), ID_TIMER_RAND);
    }
    
    # Disable polling timer
    KillTimer(load64(g_hwnd), 1);
    
    # Stop Server
    IedServer_stop(server);
    IedServer_destroy(server);
    store64(g_mms_server, 0);
    store64(g_client_count, 0);
    
    log_append(m_stop_msg);
    SetWindowTextA(load64(g_status), "Status: Stopped");
    SetWindowTextA(load64(g_clients), "Clients: 0");
    
    InvalidateRect(load64(g_hwnd), 0, 1);
    return 0;
}

func do_clear_log() -> i64 {
    SetWindowTextA(load64(g_log), gui_empty);
    return 0;
}

func do_save_log() -> i64 {
    hwnd_log = load64(g_log);
    len = SendMessageA(hwnd_log, 14, 0, 0);
    if len < 1 { return 0; }
    if len > 4094 { len = 4094; }
    SendMessageA(hwnd_log, 13, 4095, g_savebuf);
    
    hf = CreateFileA(g_logpath, 0x40000000, 0, 0, 2, 128, 0);
    if hf == 0 - 1 {
        log_append(m_save_err);
        return 0;
    }
    WriteFile(hf, g_savebuf, len, g_numbuf, 0);
    CloseHandle(hf);
    log_append(m_save_ok);
    return 0;
}

func update_listview_row_value(row: i64) -> i64 {
    hlv = load64(g_listview);
    if hlv == 0 { return 0; }
    
    server = load64(g_mms_server);
    if server == 0 { return 0; }
    
    attr = load64(g_tag_attrs + row * 8);
    if attr == 0 { return 0; }
    
    type_code = load64(g_tag_types + row * 8);
    mmsVal = IedServer_getAttributeValue(server, attr);
    if mmsVal == 0 {
        memset(g_lvitem, 0, 96);
        store32(g_lvitem + 0, 1);
        store32(g_lvitem + 4, row);
        store32(g_lvitem + 8, 2);
        store64(g_lvitem + 24, "N/A");
        SendMessageA(hlv, 4142, row, g_lvitem);
        return 0;
    }
    
    offset = load64(g_mms_val_offset);
    val_str = "Error";
    
    if type_code == 0 { # Float32
        raw_bits = load32(mmsVal + offset + 2);
        nf_ftoa(raw_bits, g_temp_text);
        val_str = g_temp_text;
    }
    if type_code == 1 { # Quality
        q_val = MmsValue_getBitStringAsInteger(mmsVal);
        end = nf_u64dec(q_val, g_temp_text);
        store8(end, 0);
        val_str = g_temp_text;
    }
    if type_code == 2 { # Boolean
        b_val = load8(mmsVal + offset);
        if b_val != 0 { val_str = "True"; }
        else { val_str = "False"; }
    }
    
    memset(g_lvitem, 0, 96);
    store32(g_lvitem + 0, 1);
    store32(g_lvitem + 4, row);
    store32(g_lvitem + 8, 2);
    store64(g_lvitem + 24, val_str);
    SendMessageA(hlv, 4142, row, g_lvitem);
    
    return 0;
}

func populate_listview() -> i64 {
    hlv = load64(g_listview);
    if hlv == 0 { return 0; }
    
    SendMessageA(hlv, 4105, 0, 0); # LVM_DELETEALLITEMS
    
    i = 0;
    while i < 10 {
        ref = load64(g_tag_refs + i * 8);
        type_code = load64(g_tag_types + i * 8);
        
        type_str = "Unknown";
        if type_code == 0 { type_str = "Float32"; }
        if type_code == 1 { type_str = "Quality"; }
        if type_code == 2 { type_str = "Boolean"; }
        
        # Col 0: Reference
        memset(g_lvitem, 0, 96);
        store32(g_lvitem + 0, 1);
        store32(g_lvitem + 4, i);
        store32(g_lvitem + 8, 0);
        store64(g_lvitem + 24, ref);
        SendMessageA(hlv, 4103, 0, g_lvitem);
        
        # Col 1: Type
        memset(g_lvitem, 0, 96);
        store32(g_lvitem + 0, 1);
        store32(g_lvitem + 4, i);
        store32(g_lvitem + 8, 1);
        store64(g_lvitem + 24, type_str);
        SendMessageA(hlv, 4142, i, g_lvitem);
        
        # Col 2: Value
        update_listview_row_value(i);
        
        # Col 3: Status
        memset(g_lvitem, 0, 96);
        store32(g_lvitem + 0, 1);
        store32(g_lvitem + 4, i);
        store32(g_lvitem + 8, 3);
        store64(g_lvitem + 24, "OK");
        SendMessageA(hlv, 4142, i, g_lvitem);
        
        i = i + 1;
    }
    return 0;
}

func poll_and_update_values() -> i64 {
    server = load64(g_mms_server);
    if server == 0 { return 0; }

    # Propagate SPCSO1 control to status
    offset = load64(g_mms_val_offset);
    attr_ctl1 = load64(g_tag_attrs + 5 * 8);
    if attr_ctl1 != 0 {
        val1_ptr = IedServer_getAttributeValue(server, attr_ctl1);
        if val1_ptr != 0 {
            b_val = load8(val1_ptr + offset);
            IedServer_updateBooleanAttributeValue(server, load64(g_tag_attrs + 4 * 8), b_val);
        }
    }
    # Propagate SPCSO2 control to status
    attr_ctl2 = load64(g_tag_attrs + 7 * 8);
    if attr_ctl2 != 0 {
        val2_ptr = IedServer_getAttributeValue(server, attr_ctl2);
        if val2_ptr != 0 {
            b_val = load8(val2_ptr + offset);
            IedServer_updateBooleanAttributeValue(server, load64(g_tag_attrs + 6 * 8), b_val);
        }
    }

    i = 0;
    while i < 10 {
        attr = load64(g_tag_attrs + i * 8);
        if attr != 0 {
            mmsVal = IedServer_getAttributeValue(server, attr);
            if mmsVal != 0 {
                offset = load64(g_mms_val_offset);
                type_code = load64(g_tag_types + i * 8);
                
                new_str = "Error";
                if type_code == 0 {
                    raw_bits = load32(mmsVal + offset + 2);
                    nf_ftoa(raw_bits, g_temp_val);
                    new_str = g_temp_val;
                }
                if type_code == 1 {
                    q_val = MmsValue_getBitStringAsInteger(mmsVal);
                    end = nf_u64dec(q_val, g_temp_val);
                    store8(end, 0);
                    new_str = g_temp_val;
                }
                if type_code == 2 {
                    b_val = load8(mmsVal + offset);
                    if b_val != 0 { new_str = "True"; }
                    else { new_str = "False"; }
                }
                
                # Check for change
                prev_str = g_prev_vals + i * 256;
                if str_equal(prev_str, new_str) == 0 {
                    if load8(prev_str) != 0 {
                        ref = load64(g_tag_refs + i * 8);
                        
                        p = g_logbuf;
                        p = str_copy(p, "[Server] ");
                        p = str_copy(p, ref);
                        p = str_copy(p, " changed to ");
                        p = str_copy(p, new_str);
                        str_copy(p, "\r\n");
                        log_append(g_logbuf);
                        
                        # Set cell status to Modified
                        memset(g_lvitem, 0, 96);
                        store32(g_lvitem + 0, 1);
                        store32(g_lvitem + 4, i);
                        store32(g_lvitem + 8, 3);
                        store64(g_lvitem + 24, "Modified");
                        SendMessageA(load64(g_listview), 4142, i, g_lvitem);
                    }
                    
                    str_copy(prev_str, new_str);
                    update_listview_row_value(i);
                }
            }
        }
        i = i + 1;
    }
    return 0;
}

func handle_update_tag() -> i64 {
    server = load64(g_mms_server);
    if server == 0 {
        log_append("[Server] Error: Server must be running to update tags.\r\n");
        return 0;
    }
    
    GetWindowTextA(load64(g_reg_ed), g_temp_text, 256);
    GetWindowTextA(load64(g_val_ed), g_numbuf, 32);
    
    # Search for tag reference
    row = 0 - 1;
    i = 0;
    while i < 10 {
        if str_equal(load64(g_tag_refs + i * 8), g_temp_text) != 0 {
            row = i;
        }
        i = i + 1;
    }
    
    if row == 0 - 1 {
        log_append("[Server] Error: Unknown tag reference.\r\n");
        return 0;
    }
    
    attr = load64(g_tag_attrs + row * 8);
    type_code = load64(g_tag_types + row * 8);
    
    if type_code == 0 { # Float32
        update_float_tag(server, attr, g_numbuf);
    }
    if type_code == 1 { # Quality
        val = str_to_int(g_numbuf);
        IedServer_updateQuality(server, attr, val);
    }
    if type_code == 2 { # Boolean
        val = 0;
        if str_equal(g_numbuf, "True") != 0 { val = 1; }
        if str_equal(g_numbuf, "true") != 0 { val = 1; }
        if str_equal(g_numbuf, "1") != 0 { val = 1; }
        IedServer_updateBooleanAttributeValue(server, attr, val);
    }
    
    # Update local values & cache immediately
    update_listview_row_value(row);
    
    mmsVal = IedServer_getAttributeValue(server, attr);
    if mmsVal != 0 {
        offset = load64(g_mms_val_offset);
        prev_str = g_prev_vals + row * 256;
        if type_code == 0 {
            nf_ftoa(load32(mmsVal + offset + 2), prev_str);
        }
        if type_code == 1 {
            end = nf_u64dec(MmsValue_getBitStringAsInteger(mmsVal), prev_str);
            store8(end, 0);
        }
        if type_code == 2 {
            b_val = load8(mmsVal + offset);
            if b_val != 0 { str_copy(prev_str, "True"); }
            else { str_copy(prev_str, "False"); }
        }
    }
    
    # Set status cell to Updated
    memset(g_lvitem, 0, 96);
    store32(g_lvitem + 0, 1);
    store32(g_lvitem + 4, row);
    store32(g_lvitem + 8, 3);
    store64(g_lvitem + 24, "Updated");
    SendMessageA(load64(g_listview), 4142, row, g_lvitem);
    
    log_append("[Server] Tag ");
    log_append(g_temp_text);
    log_append(" updated manually to ");
    log_append(g_numbuf);
    log_append(crlf);
    
    return 0;
}

func handle_listview_click() -> i64 {
    hlv = load64(g_listview);
    sel_row = SendMessageA(hlv, 4108, 0 - 1, 2); # LVM_GETNEXTITEM, LVNI_SELECTED
    if sel_row < 0 { return 0; }
    
    # Tag Ref
    memset(g_lvitem, 0, 96);
    store32(g_lvitem + 0, 1);
    store32(g_lvitem + 4, sel_row);
    store32(g_lvitem + 8, 0);
    store64(g_lvitem + 24, g_temp_text);
    store32(g_lvitem + 32, 256);
    SendMessageA(hlv, 4141, sel_row, g_lvitem);
    
    # Value
    memset(g_lvitem, 0, 96);
    store32(g_lvitem + 0, 1);
    store32(g_lvitem + 4, sel_row);
    store32(g_lvitem + 8, 2);
    store64(g_lvitem + 24, g_temp_val);
    store32(g_lvitem + 32, 256);
    SendMessageA(hlv, 4141, sel_row, g_lvitem);
    
    SetWindowTextA(load64(g_reg_ed), g_temp_text);
    SetWindowTextA(load64(g_val_ed), g_temp_val);
    return 0;
}

func format_scaled_int(val: i64, scale: i64, dst: i64) -> i64 {
    if val < 0 {
        store8(dst, 45); # '-'
        dst = dst + 1;
        val = 0 - val;
    }
    whole = val / scale;
    frac = val % scale;
    
    p = dst;
    end = nf_u64dec(whole, p);
    store8(end, 46); # '.'
    p = end + 1;
    
    if scale == 100 {
        if frac < 10 {
            store8(p, 48);
            p = p + 1;
        }
    }
    end = nf_u64dec(frac, p);
    store8(end, 0);
    return dst;
}

# ============================================================================
# AUTO-RANDOMIZATION & SIMULATION LOOP
# ============================================================================

func randomize_values() -> i64 {
    server = load64(g_mms_server);
    if server == 0 { return 0; }
    
    r = GetTickCount();
    
    # 1. Fluctuating Float Tag 1: AnIn1.mag.f (index 0)
    val1 = load64(g_sim_val1);
    diff = band(r, 7) - 3; # -0.3 to +0.4
    val1 = val1 + diff;
    if val1 < 100 { val1 = 100; }     # min 10.0
    if val1 > 2000 { val1 = 2000; }   # max 200.0
    store64(g_sim_val1, val1);
    format_scaled_int(val1, 10, g_temp_text);
    update_float_tag(server, load64(g_tag_attrs + 0 * 8), g_temp_text);
    
    # 2. Fluctuating Float Tag 2: AnIn2.mag.f (index 2)
    val2 = load64(g_sim_val2);
    diff = band(r, 3) - 1; # -0.1 to +0.2
    val2 = val2 + diff;
    if val2 < 50 { val2 = 50; }       # min 5.0
    if val2 > 500 { val2 = 500; }     # max 50.0
    store64(g_sim_val2, val2);
    format_scaled_int(val2, 10, g_temp_text);
    update_float_tag(server, load64(g_tag_attrs + 2 * 8), g_temp_text);
    
    # 3. Fluctuate Quality tags occasionally: AnIn1.q (index 1), AnIn2.q (index 3), Ind1.q (index 9)
    q_val = 0;
    if band(r, 63) == 0 {
        q_val = 1; # temporary quality alert
    }
    IedServer_updateQuality(server, load64(g_tag_attrs + 1 * 8), q_val);
    IedServer_updateQuality(server, load64(g_tag_attrs + 3 * 8), q_val);
    IedServer_updateQuality(server, load64(g_tag_attrs + 9 * 8), q_val);
    
    # 4. Fluctuate Boolean status values occasionally
    if band(r, 15) == 0 {
        b_val = band(shr(r, 4), 1);
        IedServer_updateBooleanAttributeValue(server, load64(g_tag_attrs + 4 * 8), b_val);
        IedServer_updateBooleanAttributeValue(server, load64(g_tag_attrs + 6 * 8), b_val);
        IedServer_updateBooleanAttributeValue(server, load64(g_tag_attrs + 8 * 8), b_val);
    }
    
    return 1;
}

func handle_auto_rand_toggle() -> i64 {
    server = load64(g_mms_server);
    if server == 0 { return 0; }
    
    h = load64(g_btn_autorand);
    if h == 0 { return 0; }
    
    state = load64(g_auto_rand);
    if state == 0 {
        # Parse timer rate from input field
        GetWindowTextA(load64(g_rate_ed), g_temp_text, 32);
        rate = str_to_int(g_temp_text);
        if rate < 100 { rate = 250; }
        if rate > 300000 { rate = 300000; } # 5 min max
        
        store64(g_auto_rand, 1);
        SetWindowTextA(h, btn_stop_rand);
        SetTimer(load64(g_hwnd), ID_TIMER_RAND, rate, 0);
        log_append("[Server] Auto-Simulation started.\r\n");
    } else {
        store64(g_auto_rand, 0);
        SetWindowTextA(h, btn_auto_rand);
        KillTimer(load64(g_hwnd), ID_TIMER_RAND);
        log_append("[Server] Auto-Simulation stopped.\r\n");
    }
    return 0;
}

# ============================================================================
# DARK MODE & GLOW BUTTON WndProc
# ============================================================================

func a2w(dst: i64, src: i64) -> i64 {
    i = 0;
    while 1 {
        c = load8(src + i);
        store8(dst + i + i, c);
        store8(dst + i + i + 1, 0);
        if c == 0 { return 0; }
        i = i + 1;
    }
    return 0;
}

func enable_dark_mode() -> i64 {
    a2w(thm_dm_exp_w, thm_dm_exp_a);
    a2w(thm_dm_cfd_w, thm_dm_cfd_a);
    a2w(thm_items_w, thm_items_a);
    hm = LoadLibraryA(thm_uxtheme);
    if hm != 0 {
        fn = GetProcAddress(hm, 135);
        if fn != 0 { callp(fn, 2); }
        store64(g_allowdark, GetProcAddress(hm, 133));
    }
    return 0;
}

func dark_scroll(hwnd: i64) -> i64 {
    ad = load64(g_allowdark);
    if ad != 0 { callp(ad, hwnd, 1); }
    SetWindowTheme(hwnd, thm_dm_exp_w, 0);
    return 0;
}

func dark_header(hwnd: i64) -> i64 {
    ad = load64(g_allowdark);
    if ad != 0 { callp(ad, hwnd, 1); }
    SetWindowTheme(hwnd, thm_items_w, 0);
    return 0;
}

func register_class(wndclass: ptr, clsname_arg: str, wndproc_fn: ptr, hinst: i64, cursor: i64, brush: i64) -> i64 {
    store32(wndclass + 0,  80);
    store32(wndclass + 4,  3);
    store64(wndclass + 8,  wndproc_fn);
    store32(wndclass + 16, 0);
    store32(wndclass + 20, 0);
    store64(wndclass + 24, hinst);
    store64(wndclass + 32, 0);
    store64(wndclass + 40, cursor);
    store64(wndclass + 48, brush);
    store64(wndclass + 56, 0);
    store64(wndclass + 64, clsname_arg);
    store64(wndclass + 72, 0);
    return RegisterClassExA(wndclass);
}

func GlowButtonWndProc(hwnd: i64, msg: i64, wParam: i64, lParam: i64) -> i64 {
    if msg == 1 {
        SetWindowLongA(hwnd, 0 - 21, 0);
        return 0;
    }
    if msg == 512 {
        state = GetWindowLongA(hwnd, 0 - 21);
        hover = band(state, 1);
        if hover == 0 {
            pressed = band(state, 2);
            SetWindowLongA(hwnd, 0 - 21, bor(pressed, 1));
            InvalidateRect(hwnd, 0, 1);
            
            store32(g_track_mouse + 0, 24);
            store32(g_track_mouse + 4, 2);
            store64(g_track_mouse + 8, hwnd);
            store64(g_track_mouse + 16, 0);
            TrackMouseEvent(g_track_mouse);
        }
        return 0;
    }
    if msg == 675 {
        state = GetWindowLongA(hwnd, 0 - 21);
        pressed = band(state, 2);
        SetWindowLongA(hwnd, 0 - 21, pressed);
        InvalidateRect(hwnd, 0, 1);
        return 0;
    }
    if msg == 513 {
        state = GetWindowLongA(hwnd, 0 - 21);
        hover = band(state, 1);
        SetWindowLongA(hwnd, 0 - 21, bor(hover, 2));
        SetCapture(hwnd);
        InvalidateRect(hwnd, 0, 1);
        return 0;
    }
    if msg == 514 {
        state = GetWindowLongA(hwnd, 0 - 21);
        pressed = band(state, 2);
        if pressed != 0 {
            ReleaseCapture();
            GetClientRect(hwnd, g_rect);
            x = band(lParam, 0xFFFF);
            y = band(shr(lParam, 16), 0xFFFF);
            if x >= 0 {
                if x <= load32(g_rect + 8) {
                    if y >= 0 {
                        if y <= load32(g_rect + 12) {
                            # Trigger Parent command
                            id = GetWindowLongA(hwnd, 0 - 12);
                            parent = GetParent(hwnd);
                            PostMessageA(parent, 273, id, hwnd); # WM_COMMAND
                        }
                    }
                }
            }
            SetWindowLongA(hwnd, 0 - 21, band(state, 1));
            InvalidateRect(hwnd, 0, 1);
        }
        return 0;
    }
    if msg == 15 {
        BeginPaint(hwnd, g_ps);
        hdc = load64(g_ps + 0);
        GetClientRect(hwnd, g_rect);
        
        w = load32(g_rect + 8);
        h = load32(g_rect + 12);
        
        state = GetWindowLongA(hwnd, 0 - 21);
        hover = band(state, 1);
        pressed = band(state, 2);
        
        bg_col = COL_PANEL;
        if hover != 0 { bg_col = 0x221815; } # Subtle highlight
        if pressed != 0 { bg_col = 0x120D0A; }
        
        brush = CreateSolidBrush(bg_col);
        FillRect(hdc, g_rect, brush);
        DeleteObject(brush);
        
        # Border
        b_col = 0x332822; # Soft grey-blue border BGR
        if hover != 0 { b_col = COL_ACCENT; }
        pen = CreatePen(0, 1, b_col);
        SelectObject(hdc, pen);
        SelectObject(hdc, GetStockObject(5)); # NULL_BRUSH
        RoundRect(hdc, 0, 0, w, h, 6, 6);
        DeleteObject(pen);
        
        # Text
        SetBkMode(hdc, 1);
        SetTextColor(hdc, COL_TEXT);
        SelectObject(hdc, load64(g_font));
        
        # Get button text
        GetWindowTextA(hwnd, g_temp_text, 256);
        
        # Center text
        DrawTextA(hdc, g_temp_text, 0 - 1, g_rect, 0x25); # DT_CENTER | DT_VCENTER | DT_SINGLELINE
        
        EndPaint(hwnd, g_ps);
        return 0;
    }
    return DefWindowProcA(hwnd, msg, wParam, lParam);
}

# ============================================================================
# MAIN WINDOW WndProc
# ============================================================================

func WndProc(hwnd: i64, msg: i64, wp: i64, lp: i64) -> i64 {
    if msg == 1 { # WM_CREATE
        hinst = load64(g_hinst);
        
        # Custom button classes setup
        store64(g_brush_deep, CreateSolidBrush(COL_BG));
        store64(g_brush_panel, CreateSolidBrush(COL_PANEL));
        store64(g_brush_card, CreateSolidBrush(0x18100D)); # Card highlight BGR
        store64(g_brush_input, CreateSolidBrush(0x0C0806)); # Input fields BGR
        store64(g_pen_border, CreatePen(0, 1, 0x352820));
        store64(g_font, CreateFontA(16, 0, 0, 0, 400, 0, 0, 0, 0, 3, 2, 1, 49, face_mono));
        store64(g_font_header, CreateFontA(20, 0, 0, 0, 700, 0, 0, 0, 0, 3, 2, 1, 49, face_mono));
        
        # GUI elements creation
        # Title Bar Buttons
        CreateWindowExA(0, cls_glow_btn, btn_min, 0x50000000, 1040, 10, 24, 24, hwnd, ID_BTN_MIN, hinst, 0);
        CreateWindowExA(0, cls_glow_btn, btn_close, 0x50000000, 1068, 10, 24, 24, hwnd, ID_BTN_CLOSE, hinst, 0);
        
        # Server Port Edit Panel
        CreateWindowExA(0, cls_stat, lbl_port, 0x50000000, 20, 55, 60, 20, hwnd, 0, hinst, 0);
        hport = CreateWindowExA(0, cls_edit, def_port, 0x50000080, 80, 52, 80, 24, hwnd, 100, hinst, 0);
        store64(g_port_ed, hport);
        
        # Glow Buttons
        hstart = CreateWindowExA(0, cls_glow_btn, btn_start, 0x50000000, 180, 52, 90, 24, hwnd, 101, hinst, 0);
        hstop  = CreateWindowExA(0, cls_glow_btn, btn_stop,  0x50000000, 280, 52, 90, 24, hwnd, 102, hinst, 0);
        
        # Auto Rand button
        g_btn_autorand_h = CreateWindowExA(0, cls_glow_btn, btn_auto_rand, 0x50000000, 380, 52, 90, 24, hwnd, ID_BTN_AUTORAND, hinst, 0);
        store64(g_btn_autorand, g_btn_autorand_h);
        
        # Rate label & input
        h = CreateWindowExA(0, cls_stat, lbl_rate, 0x50000000, 480, 55, 45, 20, hwnd, 0, hinst, 0);
        SendMessageA(h, 48, load64(g_font), 1);
        grate = CreateWindowExA(0, cls_edit, "250", 0x50010080, 530, 52, 60, 24, hwnd, 116, hinst, 0);
        store64(g_rate_ed, grate);
        SendMessageA(grate, 48, load64(g_font), 1);
        dark_scroll(grate);
        
        # Server status indicators (shifted to make room for Auto Rand & Rate)
        hstat  = CreateWindowExA(0, cls_stat, lbl_status, 0x50000000, 605, 55, 160, 20, hwnd, 104, hinst, 0);
        hclients = CreateWindowExA(0, cls_stat, lbl_client, 0x50000000, 660, 12, 120, 20, hwnd, 114, hinst, 0);
        store64(g_status, hstat);
        store64(g_clients, hclients);
        
        # Tag ListView Grid
        hlv = CreateWindowExA(0, cls_lv, gui_empty, 0x5000C009, 20, 120, 750, 255, hwnd, 105, hinst, 0);
        store64(g_listview, hlv);
        SendMessageA(hlv, 4150, 0, 0x00000020); # LVS_EX_FULLROWSELECT
        SendMessageA(hlv, 4097, 0, COL_PANEL);
        SendMessageA(hlv, 4132, 0, COL_TEXT);
        SendMessageA(hlv, 4134, 0, COL_PANEL);
        
        # Columns setup
        memset(g_lvcol, 0, 64);
        store32(g_lvcol + 0, 15); # LVCF_FMT | LVCF_WIDTH | LVCF_TEXT | LVCF_SUBITEM
        store32(g_lvcol + 4, 0); # FMT_LEFT
        store32(g_lvcol + 8, 300); # Width
        store64(g_lvcol + 16, col_ref);
        SendMessageA(hlv, 4123, 0, g_lvcol);
        
        store32(g_lvcol + 8, 120); # Type column
        store64(g_lvcol + 16, col_type);
        SendMessageA(hlv, 4123, 1, g_lvcol);
        
        store32(g_lvcol + 8, 180); # Value column
        store64(g_lvcol + 16, col_val);
        SendMessageA(hlv, 4123, 2, g_lvcol);
        
        store32(g_lvcol + 8, 130); # Status column
        store64(g_lvcol + 16, col_status);
        SendMessageA(hlv, 4123, 3, g_lvcol);
        
        # Edit / Update Panel
        CreateWindowExA(0, cls_stat, lbl_reg, 0x50000000, 790, 110, 60, 20, hwnd, 0, hinst, 0);
        hreg = CreateWindowExA(0, cls_edit, gui_empty, 0x50000880, 840, 107, 240, 24, hwnd, 110, hinst, 0);
        store64(g_reg_ed, hreg);
        
        CreateWindowExA(0, cls_stat, lbl_val, 0x50000000, 790, 150, 60, 20, hwnd, 0, hinst, 0);
        hval = CreateWindowExA(0, cls_edit, gui_empty, 0x50000080, 840, 147, 240, 24, hwnd, 111, hinst, 0);
        store64(g_val_ed, hval);
        
        CreateWindowExA(0, cls_glow_btn, btn_update, 0x50000000, 840, 190, 100, 30, hwnd, 112, hinst, 0);
        
        # Traffic Log Section
        CreateWindowExA(0, cls_stat, lbl_log, 0x50000000, 20, 395, 120, 20, hwnd, 0, hinst, 0);
        hlog = CreateWindowExA(0, cls_edit, gui_empty, 0x50A00804, 20, 420, 750, 170, hwnd, 103, hinst, 0);
        store64(g_log, hlog);
        
        # Log Actions
        CreateWindowExA(0, cls_glow_btn, btn_clear, 0x50000000, 790, 420, 100, 24, hwnd, 106, hinst, 0);
        CreateWindowExA(0, cls_glow_btn, btn_save,  0x50000000, 790, 455, 100, 24, hwnd, 107, hinst, 0);
        
        # Theme all generated controls
        c = GetWindow(hwnd, 5); # GW_CHILD
        while c != 0 {
            SendMessageA(c, 48, load64(g_font), 1); # WM_SETFONT
            dark_scroll(c);
            c = GetWindow(c, 2); # GW_HWNDNEXT
        }
        
        # Specific headers / indicators styling overrides
        SendMessageA(hstat, 48, load64(g_font), 1);
        SendMessageA(hclients, 48, load64(g_font), 1);
        
        # Initialize internal tag metadata lists
        init_tag_metadata();
        
        # Populate initially empty Grid
        populate_listview();
        
        # Write welcome log entry
        log_append("ANCL TASE.2 / MMS Mock Simulator ready.\r\n");
        log_append("Click 'Start' to listen on Port 10102.\r\n");
        
        return 0;
    }
    
    if msg == 275 { # WM_TIMER
        if wp == 1 {
            poll_and_update_values();
        }
        if wp == ID_TIMER_RAND {
            randomize_values();
        }
        return 0;
    }
    
    if msg == 0x400 + 1 { # WM_CLIENT_CONN
        connected = wp;
        conn = lp;
        clients = load64(g_client_count);
        
        if connected != 0 {
            clients = clients + 1;
            store64(g_client_count, clients);
            
            p = g_logbuf;
            p = str_copy(p, "[Server] Client connected. Socket: ");
            end = nf_u64dec(conn, g_temp_text);
            store8(end, 0);
            p = str_copy(p, g_temp_text);
            str_copy(p, "\r\n");
            log_append(g_logbuf);
        } else {
            if clients > 0 { clients = clients - 1; }
            store64(g_client_count, clients);
            
            p = g_logbuf;
            p = str_copy(p, "[Server] Client disconnected. Socket: ");
            end = nf_u64dec(conn, g_temp_text);
            store8(end, 0);
            p = str_copy(p, g_temp_text);
            str_copy(p, "\r\n");
            log_append(g_logbuf);
        }
        
        # Update connection count label
        p = g_temp_text;
        p = str_copy(p, "Clients: ");
        end = nf_u64dec(clients, p);
        store8(end, 0);
        SetWindowTextA(load64(g_clients), g_temp_text);
        
        InvalidateRect(hwnd, 0, 1);
        return 0;
    }
    
    if msg == 0x400 + 2 { # WM_CONTROL_OP
        spc_idx = wp;
        b_val = lp;
        
        server = load64(g_mms_server);
        if server != 0 {
            if spc_idx == 1 {
                IedServer_updateBooleanAttributeValue(server, load64(g_tag_attrs + 4 * 8), b_val);
                IedServer_updateBooleanAttributeValue(server, load64(g_tag_attrs + 5 * 8), b_val);
                
                p = g_logbuf;
                p = str_copy(p, "[Server] Control command SPCSO1 -> ");
                if b_val != 0 { p = str_copy(p, "True"); } else { p = str_copy(p, "False"); }
                str_copy(p, "\r\n");
                log_append(g_logbuf);
            }
            if spc_idx == 2 {
                IedServer_updateBooleanAttributeValue(server, load64(g_tag_attrs + 6 * 8), b_val);
                IedServer_updateBooleanAttributeValue(server, load64(g_tag_attrs + 7 * 8), b_val);
                
                p = g_logbuf;
                p = str_copy(p, "[Server] Control command SPCSO2 -> ");
                if b_val != 0 { p = str_copy(p, "True"); } else { p = str_copy(p, "False"); }
                str_copy(p, "\r\n");
                log_append(g_logbuf);
            }
            
            # Force UI update
            populate_listview();
        }
        return 0;
    }
    
    if msg == 273 { # WM_COMMAND
        id = wp;
        if id == ID_BTN_MIN   { ShowWindow(hwnd, 6); return 0; }
        if id == ID_BTN_CLOSE { DestroyWindow(hwnd); return 0; }
        if id == 101 { do_start_server(); return 0; }
        if id == 102 { do_stop_server(); return 0; }
        if id == 106 { do_clear_log(); return 0; }
        if id == 107 { do_save_log(); return 0; }
        if id == 112 { handle_update_tag(); return 0; }
        if id == ID_BTN_AUTORAND { handle_auto_rand_toggle(); return 0; }
        return 0;
    }
    
    if msg == 78 { # WM_NOTIFY
        hdr = lp;
        code = load32(hdr + 16);
        hwndFrom = load64(hdr + 0);
        
        # Check if notification is from the ListView header control
        hhdr = SendMessageA(load64(g_listview), 4127, 0, 0); # LVM_GETHEADER = 4127
        if hhdr != 0 {
            if hwndFrom == hhdr {
                if band(code, 4294967295) == 4294967284 { # NM_CUSTOMDRAW = -12 = 4294967284
                    dwDrawStage = load32(hdr + 24);
                    if dwDrawStage == 1 { # CDDS_PREPAINT = 1
                        return 0x00000020; # CDRF_NOTIFYITEMDRAW = 0x20
                    }
                    if dwDrawStage == 0x00010001 { # CDDS_ITEMPREPAINT = 0x00010001
                        hdc = load64(hdr + 32);
                        item_idx = load64(hdr + 56);
                        item_rect = hdr + 40; # rc (RECT struct starts at offset 40)
                        
                        # Retrieve column title text
                        memset(g_hditem, 0, 80);
                        store32(g_hditem + 0, 2); # mask = HDI_TEXT (2)
                        store64(g_hditem + 8, g_temp_text);
                        store32(g_hditem + 24, 256);
                        SendMessageA(hhdr, 4619, item_idx, g_hditem); # HDM_GETITEMA = 4619
                        
                        # Draw dark column background
                        FillRect(hdc, item_rect, load64(g_brush_panel));
                        
                        # Draw thin separator line on the right edge
                        old_pen = SelectObject(hdc, load64(g_pen_border));
                        r_edge = load32(item_rect + 8) - 1;
                        MoveToEx(hdc, r_edge, load32(item_rect + 4), 0);
                        LineTo(hdc, r_edge, load32(item_rect + 12));
                        SelectObject(hdc, old_pen);
                        
                        # Draw column label text
                        SetTextColor(hdc, COL_TEXT);
                        SetBkMode(hdc, 1);
                        SelectObject(hdc, load64(g_font));
                        
                        # Apply margin offset to prevent text pressing against the left border
                        store32(item_rect + 0, load32(item_rect + 0) + 6);
                        DrawTextA(hdc, g_temp_text, 0 - 1, item_rect, 0x24); # DT_LEFT | DT_VCENTER | DT_SINGLELINE = 0x24
                        
                        return 0x00000004; # CDRF_SKIPDEFAULT = 4
                    }
                }
            }
        }
        
        is_click = band(code, 4294967295) == 4294967294; # -2 (NM_CLICK)
        is_dblclk = band(code, 4294967295) == 4294967293; # -3 (NM_DBLCLK)
        is_changed = band(code, 4294967295) == 4294967193; # -103 (LVN_ITEMCHANGED)
        
        if bor(is_click, bor(is_dblclk, is_changed)) != 0 {
            if hwndFrom == load64(g_listview) {
                handle_listview_click();
            }
        }
        return 0;
    }
    
    if msg == 312 { # WM_CTLCOLORSTATIC
        if lp == load64(g_clients) {
            SetTextColor(wp, COL_TEXT);
            SetBkColor(wp, COL_PANEL);
            return load64(g_brush_panel);
        }
        SetTextColor(wp, COL_TEXT);
        SetBkColor(wp, COL_BG);
        return load64(g_brush_deep);
    }
    
    if msg == 307 || msg == 308 || msg == 309 { # WM_CTLCOLOREDIT / LISTBOX / BTN
        SetTextColor(wp, COL_TEXT);
        SetBkColor(wp, 0x0C0806); # Input deep background
        return load64(g_brush_input);
    }
    
    if msg == 20 { # WM_ERASEBKGND
        return 1;
    }
    
    if msg == 15 { # WM_PAINT
        BeginPaint(hwnd, g_ps);
        hdc = load64(g_ps + 0);
        GetClientRect(hwnd, g_rect);
        
        # Background
        FillRect(hdc, g_rect, load64(g_brush_deep));
        
        # Header strip panel
        store32(g_rect + 12, 45); # height = 45
        FillRect(hdc, g_rect, load64(g_brush_panel));
        
        # Bottom accent border on header
        pen = CreatePen(0, 1, COL_ACCENT);
        SelectObject(hdc, pen);
        MoveToEx(hdc, 0, 45, 0);
        LineTo(hdc, load32(g_rect + 8), 45);
        DeleteObject(pen);
        
        # Header text
        SetBkMode(hdc, 1);
        SetTextColor(hdc, COL_TEXT);
        SelectObject(hdc, load64(g_font_header));
        store32(g_rect + 0, 20);
        store32(g_rect + 4, 12);
        DrawTextA(hdc, title_draw, 0 - 1, g_rect, 0);
        
        # Server Active Indicator
        is_running = 0;
        server = load64(g_mms_server);
        if server != 0 {
            if IedServer_isRunning(server) != 0 {
                is_running = 1;
            }
        }
        
        SelectObject(hdc, load64(g_font));
        if is_running != 0 {
            SetTextColor(hdc, COL_GREEN);
            store32(g_rect + 0, load32(g_rect + 8) - 200);
            DrawTextA(hdc, st_run_ind, 0 - 1, g_rect, 0);
        } else {
            SetTextColor(hdc, COL_RED);
            store32(g_rect + 0, load32(g_rect + 8) - 200);
            DrawTextA(hdc, st_stop_ind, 0 - 1, g_rect, 0);
        }
        
        # Paint card borders around controls
        # ListView panel border
        SelectObject(hdc, load64(g_pen_border));
        SelectObject(hdc, GetStockObject(5)); # NULL_BRUSH
        RoundRect(hdc, 15, 90, 775, 380, 4, 4);
        
        # Update Tag Panel card
        RoundRect(hdc, 785, 90, 1090, 240, 4, 4);
        
        # Traffic Log card
        RoundRect(hdc, 15, 415, 775, 595, 4, 4);
        
        # Draw custom flat headers for ListView Tag Grid
        SelectObject(hdc, load64(g_pen_border));
        SelectObject(hdc, load64(g_brush_panel));
        
        # Column 0: Tag Reference
        Rectangle(hdc, 20, 95, 320, 120);
        # Column 1: Type
        Rectangle(hdc, 320, 95, 440, 120);
        # Column 2: Value
        Rectangle(hdc, 440, 95, 620, 120);
        # Column 3: Status
        Rectangle(hdc, 620, 95, 770, 120);
        
        # Draw header text labels
        SetBkMode(hdc, 1);
        SetTextColor(hdc, COL_TEXT);
        old_font = SelectObject(hdc, load64(g_font));
        TextOutA(hdc, 26, 99, col_ref, 13);
        TextOutA(hdc, 326, 99, col_type, 4);
        TextOutA(hdc, 446, 99, col_val, 5);
        TextOutA(hdc, 626, 99, col_status, 6);
        SelectObject(hdc, old_font);
        
        EndPaint(hwnd, g_ps);
        return 0;
    }
    
    if msg == 132 { # WM_NCHITTEST
        GetWindowRect(hwnd, g_rect);
        wl = load32(g_rect + 0);
        wt = load32(g_rect + 4);
        mx = band(lp, 65535);
        if mx >= 32768 { mx = mx - 65536; }
        my = band(shr(lp, 16), 65535);
        if my >= 32768 { my = my - 65536; }
        cx = mx - wl;
        cy = my - wt;

        if cy < 45 {
            if cx >= 1040 {
                if cx < 1064 {
                    if cy >= 10 { if cy < 34 { return 1; } }
                }
            }
            if cx >= 1068 {
                if cx < 1092 {
                    if cy >= 10 { if cy < 34 { return 1; } }
                }
            }
            return 2; # HTCAPTION
        }
    }
    
    if msg == 2 { # WM_DESTROY
        do_stop_server();
        
        # Clean up GDI objects
        DeleteObject(load64(g_brush_deep));
        DeleteObject(load64(g_brush_panel));
        DeleteObject(load64(g_brush_card));
        DeleteObject(load64(g_brush_input));
        DeleteObject(load64(g_pen_border));
        DeleteObject(load64(g_font));
        DeleteObject(load64(g_font_header));
        
        # Clean up dynamic data model
        model = load64(g_mms_model);
        if model != 0 {
            IedModel_destroy(model);
            store64(g_mms_model, 0);
        }
        
        PostQuitMessage(0);
        return 0;
    }
    
    return DefWindowProcA(hwnd, msg, wp, lp);
}

# ============================================================================
# ENTRY POINT
# ============================================================================

func main() -> i32 {
    InitCommonControlsEx();
    
    hinst = GetModuleHandleA(0);
    store64(g_hinst, hinst);
    
    # 1. Detect DLL structure alignment
    detect_mms_alignment();
    
    # 2. Setup theme settings
    enable_dark_mode();
    
    # 3. Register custom glow button class
    cursor = LoadCursorA(0, 32512); # IDC_ARROW
    res = register_class(g_wndcls, cls_glow_btn, &GlowButtonWndProc, hinst, cursor, 0);
    
    # 4. Register main window class
    bg_brush = CreateSolidBrush(COL_BG);
    res = register_class(g_wndcls, clsname, &WndProc, hinst, cursor, bg_brush);
    
    # 5. Create main window
    hwnd = CreateWindowExA(0, clsname, title, 0x92000000, 100, 100, WIN_W, WIN_H, 0, 0, hinst, 0);
    store64(g_hwnd, hwnd);
    
    if hwnd == 0 { return 1; }
    
    ShowWindow(hwnd, 5); # SW_SHOW = 5
    UpdateWindow(hwnd);
    
    # Init dynamic values default
    store64(g_auto_rand, 0);
    store64(g_sim_val1, 1000);
    store64(g_sim_val2, 250);
    
    # Message Loop
    while GetMessageA(g_msg, 0, 0, 0) > 0 {
        TranslateMessage(g_msg);
        DispatchMessageA(g_msg);
    }
    
    return 0;
}
