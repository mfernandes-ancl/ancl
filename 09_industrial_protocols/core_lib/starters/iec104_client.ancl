# iec104_client.ancl - IEC 60870-5-104 interrogation/command/poll STARTER. CRT-free, zero-dep.
# A complete, compilable client: edit the CONFIG block, COMPILE, RUN. Then extend it -
# Ctrl+Space (the op-brain) knows the ANCL idioms. Defaults to READ (CFG_OP=0, general
# interrogation); set CFG_OP=1 to send a command. Loaded by Aether Studio for IEC-104 intent.
extern "ws2_32.dll" connect;
extern "ws2_32.dll" setsockopt;
extern "kernel32.dll" Sleep;

@DATA
mInfo: str = "[iec104] IEC-104 client (ANCL starter)";
mErr:  str = "[iec104] connect failed - check IP / port / cable.";
mNoS:  str = "[iec104] no STARTDT confirm - not an IEC-104 endpoint?";
mStart:str = "[iec104] STARTDT confirmed - link active.";
mActc: str = "[iec104] interrogation activation confirmed.";
mActt: str = "[iec104] interrogation complete (ACTTERM).";
mIoa:  str = "[iec104] IOA ";
mEq:   str = " = ";
mTyp:  str = "   (type ";
mPar:  str = ")";
mOth:  str = "[iec104] ASDU type ";
mOth2: str = " received (not decoded).";
mCok:  str = "[iec104] command CONFIRMED by the RTU.";
mCneg: str = "[iec104] command REJECTED (negative confirm).";
mLost: str = "[iec104] link lost.";
nl:    str = "\r\n";
# ==== CONFIG - edit these ====
CFG_IP0:  i64 = 127;    # target IP, octet 1
CFG_IP1:  i64 = 0;      #   octet 2
CFG_IP2:  i64 = 0;      #   octet 3
CFG_IP3:  i64 = 1;      #   octet 4   (127.0.0.1 = localhost)
CFG_PORT: i64 = 2404;   # IEC-104 port (standard 2404)
CFG_OP:   i64 = 0;      # 0 = read (general interrogation), 1 = send command
CFG_CA:   i64 = 1;      # common address of ASDU
CFG_IOA:  i64 = 2000;   # information object address (command target, when CFG_OP=1)
CFG_TID:  i64 = 45;     # cmd type: 45=C_SC single, 46=C_DC double, 48=C_SE_NA norm setpoint, 49=C_SE_NB scaled setpoint
CFG_VAL:  i64 = 1;      # command value (when CFG_OP=1)
CFG_MS:   i64 = 0;      # poll interval ms (0 = one-shot)
# =============================
g_wsa: buf = 512;
g_addr: buf = 16;
g_tmo: buf = 8;
g_req: buf = 32;
g_buf: buf = 300;
g_vs: buf = 8;
g_vr: buf = 8;

@CODE
func recv_n(s: i64, dst: i64, n: i64) -> i64 {
    got = 0;
    while got < n {
        r = recv(s, dst + got, n - got, 0);
        if r <= 0 { return 0 - 1; }
        got = got + r;
    }
    return n;
}
func send_u(s: i64, ctl: i64) -> i64 {
    store8(g_req+0,0x68); store8(g_req+1,4); store8(g_req+2,ctl);
    store8(g_req+3,0); store8(g_req+4,0); store8(g_req+5,0);
    return send(s, g_req, 6, 0);
}
func send_s(s: i64) -> i64 {
    vr = load64(g_vr) * 2;
    store8(g_req+0,0x68); store8(g_req+1,4); store8(g_req+2,1); store8(g_req+3,0);
    store8(g_req+4, band(vr,255)); store8(g_req+5, band(shr(vr,8),255));
    return send(s, g_req, 6, 0);
}
func send_asdu(s: i64) -> i64 {
    vs = load64(g_vs) * 2; vr = load64(g_vr) * 2;
    ln = 14;
    if CFG_OP == 1 {
        if CFG_TID == 48 { ln = 16; }        # C_SE_NA normalized setpoint (2-byte value + QOS)
        if CFG_TID == 49 { ln = 16; }        # C_SE_NB scaled setpoint (2-byte value + QOS)
    }
    store8(g_req+0,0x68); store8(g_req+1, ln);
    store8(g_req+2, band(vs,255)); store8(g_req+3, band(shr(vs,8),255));
    store8(g_req+4, band(vr,255)); store8(g_req+5, band(shr(vr,8),255));
    store64(g_vs, load64(g_vs) + 1);
    tid = 100;
    if CFG_OP == 1 { tid = CFG_TID; }
    store8(g_req+6, tid); store8(g_req+7, 1);
    store8(g_req+8, 6); store8(g_req+9, 0);
    store8(g_req+10, band(CFG_CA,255)); store8(g_req+11, band(shr(CFG_CA,8),255));
    ioa = 0;
    if CFG_OP == 1 { ioa = CFG_IOA; }
    store8(g_req+12, band(ioa,255)); store8(g_req+13, band(shr(ioa,8),255)); store8(g_req+14, band(shr(ioa,16),255));
    if CFG_OP == 0 { store8(g_req+15, 0x14); return send(s, g_req, 16, 0); }
    if CFG_TID == 45 {
        sco = 0;
        if CFG_VAL != 0 { sco = 1; }
        store8(g_req+15, sco);
        return send(s, g_req, 16, 0);
    }
    if CFG_TID == 46 {
        dco = 1;                             # DCS: 1 = OFF
        if CFG_VAL != 0 { dco = 2; }         #      2 = ON
        store8(g_req+15, dco);
        return send(s, g_req, 16, 0);
    }
    # C_SE_NA (48, normalized) / C_SE_NB (49, scaled): 16-bit value + QOS (S/E=0 -> direct execute)
    store8(g_req+15, band(CFG_VAL,255)); store8(g_req+16, band(shr(CFG_VAL,8),255)); store8(g_req+17, 0);
    return send(s, g_req, 18, 0);
}
func pump_one(s: i64) -> i64 {
    if recv_n(s, g_buf, 2) < 0 { return 0 - 1; }
    if load8(g_buf + 0) != 0x68 { return 0 - 1; }
    al = load8(g_buf + 1);
    if al < 4 { return 0 - 1; }
    if recv_n(s, g_buf + 2, al) < 0 { return 0 - 1; }
    return al + 2;
}
func handle(s: i64, fl: i64) -> i64 {
    c1 = load8(g_buf + 2);
    if band(c1, 1) == 1 { return 0; }
    store64(g_vr, load64(g_vr) + 1);
    send_s(s);
    tid = load8(g_buf + 6);
    vsq = load8(g_buf + 7);
    n = band(vsq, 127);
    sq = band(vsq, 128);
    cot = band(load8(g_buf + 8), 63);
    pn = band(load8(g_buf + 8), 64);
    if tid == 100 {
        if cot == 7 { syscall 1, mActc, nl; }
        if cot == 10 { syscall 1, mActt, nl; return 1; }
        return 0;
    }
    if CFG_OP == 1 {
        if tid == CFG_TID {
            if cot == 7 {
                if pn == 0 { syscall 1, mCok, nl; } else { syscall 1, mCneg, nl; }
                return 1;
            }
            if cot == 10 { return 1; }
        }
        return 0;
    }
    esz = 0;
    if tid == 1 { esz = 1; }
    if tid == 3 { esz = 1; }
    if tid == 9 { esz = 3; }
    if tid == 11 { esz = 3; }
    if tid == 13 { esz = 5; }
    if esz == 0 { syscall 1, mOth, tid, mOth2, nl; return 0; }
    p = 12;
    ioa = 0;
    i = 0;
    while i < n {
        fresh = 0;
        if sq == 0 { fresh = 1; }
        if i == 0 { fresh = 1; }
        if fresh == 1 {
            ioa = load8(g_buf+p) + load8(g_buf+p+1)*256 + load8(g_buf+p+2)*65536;
            p = p + 3;
        } else { ioa = ioa + 1; }
        if p + esz > fl { break; }
        v = 0;
        if esz == 1 { v = band(load8(g_buf+p), 1); }
        if esz == 3 {
            v = load8(g_buf+p) + load8(g_buf+p+1)*256;
            if v >= 32768 { v = v - 65536; }
        }
        if esz == 5 { v = load8(g_buf+p) + load8(g_buf+p+1)*256 + load8(g_buf+p+2)*65536 + load8(g_buf+p+3)*16777216; }
        syscall 1, mIoa, ioa, mEq, v, mTyp, tid, mPar, nl;
        p = p + esz;
        i = i + 1;
    }
    return 0;
}
func main() -> i32 {
    syscall 1, mInfo, nl;
    WSAStartup(514, g_wsa);
    s = socket(2, 1, 6);
    store16(g_addr + 0, 2);
    store16(g_addr + 2, htons(CFG_PORT));
    store32(g_addr + 4, CFG_IP0 + shl(CFG_IP1,8) + shl(CFG_IP2,16) + shl(CFG_IP3,24));
    store64(g_addr + 8, 0);
    if connect(s, g_addr, 16) != 0 { syscall 1, mErr, nl; closesocket(s); return 1; }
    store32(g_tmo, 3000);
    setsockopt(s, 65535, 4102, g_tmo, 4);
    store64(g_vs, 0); store64(g_vr, 0);
    if send_u(s, 0x07) <= 0 { syscall 1, mErr, nl; closesocket(s); return 1; }
    ok = 0; tries = 0;
    while tries < 4 {
        fl = pump_one(s);
        if fl < 0 { break; }
        c1 = load8(g_buf + 2);
        if band(c1, 3) == 3 { if c1 == 0x0B { ok = 1; break; } }
        if band(c1, 1) == 0 { store64(g_vr, load64(g_vr) + 1); send_s(s); }
        tries = tries + 1;
    }
    if ok == 0 { syscall 1, mNoS, nl; closesocket(s); return 1; }
    syscall 1, mStart, nl;
    while 1 {
        if send_asdu(s) <= 0 { syscall 1, mLost, nl; break; }
        done = 0;
        while done == 0 {
            fl = pump_one(s);
            if fl < 0 { done = 1; }
            else { if handle(s, fl) == 1 { done = 1; } }
        }
        if CFG_MS == 0 { break; }
        Sleep(CFG_MS);
    }
    closesocket(s);
    return 0;
}
