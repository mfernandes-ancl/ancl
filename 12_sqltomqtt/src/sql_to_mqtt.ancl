# ==============================================================================
# ANCL Configurable Cyberpunk SQL-to-MQTT Edge Console
# Zero-Dependency Win32 Native UI Dashboard with Live Dynamic Inputs
# ==============================================================================

struct WNDCLASSEXA {
    cbSize:        i32;
    style:         i32;
    lpfnWndProc:   ptr;
    cbClsExtra:    i32;
    cbWndExtra:    i32;
    hInstance:     ptr;
    hIcon:         ptr;
    hCursor:       ptr;
    hbrBackground: ptr;
    lpszMenuName:  str;
    lpszClassName: str;
    hIconSm:       ptr;
}

struct RECT {
    left:   i32;
    top:    i32;
    right:  i32;
    bottom: i32;
}

struct POINT {
    x: i32;
    y: i32;
}

struct MSG {
    hwnd:    ptr;
    message: i32;
    wParam:  i64;
    lParam:  i64;
    time:    i32;
    pt:      POINT;
}

import "sqlite.ancl";
import "mqtt.ancl";

# --- Win32 GUI & GDI Imports ---
extern "user32.dll" RegisterClassExA -> i16;
extern "user32.dll" CreateWindowExA -> ptr;
extern "user32.dll" ShowWindow -> i32;
extern "user32.dll" UpdateWindow -> i32;
extern "user32.dll" GetMessageA -> i32;
extern "user32.dll" TranslateMessage -> i32;
extern "user32.dll" DispatchMessageA -> i32;
extern "user32.dll" PostQuitMessage;
extern "user32.dll" DestroyWindow -> i32;
extern "user32.dll" DefWindowProcA -> i64;
extern "user32.dll" BeginPaint -> ptr;
extern "user32.dll" EndPaint;
extern "user32.dll" GetClientRect -> i32;
extern "user32.dll" GetWindowRect -> i32;
extern "user32.dll" DrawTextA -> i32;
extern "user32.dll" InvalidateRect -> i32;
extern "user32.dll" GetWindowTextA -> i32;
extern "user32.dll" SetWindowTextA -> i32;
extern "user32.dll" SendMessageA -> i64;
extern "user32.dll" FillRect -> i32;
extern "gdi32.dll"  CreateSolidBrush -> ptr;
extern "gdi32.dll"  CreatePen -> ptr;
extern "gdi32.dll"  Rectangle -> i32;
extern "gdi32.dll"  SetTextColor -> i32;
extern "gdi32.dll"  SetBkMode -> i32;
extern "gdi32.dll"  SetBkColor -> i32;
extern "gdi32.dll"  SelectObject -> ptr;
extern "gdi32.dll"  CreateFontA -> ptr;

# --- Window subclassing / owner-draw button + module bootstrap (were missing) ---
extern "user32.dll"   SetWindowLongA -> i64;
extern "user32.dll"   GetWindowLongA -> i64;
extern "user32.dll"   TrackMouseEvent;
extern "user32.dll"   SetCapture;
extern "user32.dll"   ReleaseCapture;
extern "user32.dll"   GetParent -> ptr;
extern "user32.dll"   LoadCursorA -> ptr;
extern "gdi32.dll"    RoundRect -> i32;
extern "gdi32.dll"    MoveToEx -> i32;
extern "gdi32.dll"    LineTo -> i32;
extern "gdi32.dll"    Polygon;
extern "gdi32.dll"    GetStockObject -> ptr;
extern "kernel32.dll" GetModuleHandleA -> ptr;
extern "kernel32.dll" CreateFileA -> ptr;
extern "kernel32.dll" WriteFile -> i32;
extern "kernel32.dll" CloseHandle -> i32;

@DATA
